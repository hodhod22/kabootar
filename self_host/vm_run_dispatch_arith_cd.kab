// P6b: 2-way dispatch chain (≤10s self-host compile).
import "self_host/vm_ops_arith_c"
import "self_host/vm_ops_arith_d"

pub fn runOpArithCd(S, name, arg, op, pool, globals, functions) {
    let st = runOpArithC(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpArithD(S, name, arg, op, pool, globals, functions)
}
