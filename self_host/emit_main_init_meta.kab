import "self_host/emit_defs"

pub fn emitMainInitMeta(E) {
    E["eGenericTemplates"] = []
    E["eGenericClassTemplates"] = []
    E["eGenericEnumTemplates"] = []
    E["eGenericMethodTemplates"] = []
    E["eClasses"] = []
    E["eClassesN"] = 0
    E["eEnums"] = []
    E["eArrows"] = []
    E["eTryRegions"] = []
    E["eFnTryRegions"] = []
    E["eForCounter"] = 0
    E["eSpecMangled"] = []
    E["eBindingSyms"] = []
    E["eBindingTypes"] = []
    E["eExports"] = []
    E["eImports"] = []
    E["eProg"] = 0
    if E["eProgram"]["imports"] != undefined {
        E["eImports"] = E["eProgram"]["imports"]
    }
}
