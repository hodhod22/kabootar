// P6b: parser session stmt fields.
pub fn pSessionInit_stmt(sess) {
    sess["pBody"] = []
    sess["pBodyStack"] = []
    sess["pStmts"] = []
    sess["pParams"] = []
    sess["pCond"] = null
    sess["pCondStack"] = []
    sess["pThen"] = null
    sess["pElse"] = null
    sess["pLoopBody"] = []
    sess["pFnSym"] = ""
    sess["pLetSym"] = ""
    sess["pBodyDepth"] = 0
    sess["pCondDepth"] = 0
    return 0
}
