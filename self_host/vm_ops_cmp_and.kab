import "self_host/vm_s_push"
import "self_host/vm_s_pop"
import "self_host/vm_s_ip"
import "self_host/vm_s_truthy"

pub fn runOpCmpAnd(S, name, arg, op, pool, globals, functions) {
    if name == "and" {
        let b = vPopS(S)
        let a = vPopS(S)
        if vTruthy(a) {
            vPushS(S, b)
        } else {
            vPushS(S, a)
        }
        vBumpIpS(S)
        return 1
    }
    return 0
}
