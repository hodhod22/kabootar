// Minimal affine ownership checker for @manual modules (O5 subset).
// Tracks Owned from owned_alloc and moves via let-assign / drop / owned_move / move.
// O5 deepen: exclusive/shared borrow counts (double &mut, move-while-borrowed).

let oPlaces = {}
let oMutBorrows = {}
let oSharedBorrows = {}
let oErrors = []
let oToks = []
let oI = 0

fn oErr(msg) {
    oErrors = push(oErrors, msg)
}

fn oCode(ch) {
    return char_code_at(ch, 0)
}

fn oIsIdentStart(ch) {
    let cd = oCode(ch)
    if cd >= 97 && cd <= 122 {
        return 1
    }
    if cd >= 65 && cd <= 90 {
        return 1
    }
    if ch == "_" {
        return 1
    }
    return 0
}

fn oIsIdentChar(ch) {
    if oIsIdentStart(ch) == 1 {
        return 1
    }
    let cd = oCode(ch)
    if cd >= 48 && cd <= 57 {
        return 1
    }
    return 0
}

fn oIsDigit(ch) {
    let cd = oCode(ch)
    if cd >= 48 && cd <= 57 {
        return 1
    }
    return 0
}

fn oTokenize(source) {
    let toks = []
    let s = "" + source
    let i = 0
    while i < len(s) {
        let ch = char_at(s, i)
        if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
            i = i + 1
        } else {
            if ch == "\"" {
                i = i + 1
                while i < len(s) && char_at(s, i) != "\"" {
                    if char_at(s, i) == "\\" {
                        i = i + 1
                    }
                    i = i + 1
                }
                if i < len(s) {
                    i = i + 1
                }
                toks = push(toks, { "k": "str", "v": "" })
            } else {
                    if oIsIdentStart(ch) == 1 || ch == "@" {
                    let start = i
                    i = i + 1
                    while i < len(s) && oIsIdentChar(char_at(s, i)) == 1 {
                        i = i + 1
                    }
                    toks = push(toks, { "k": "id", "v": substring(s, start, i) })
                } else {
                    if oIsDigit(ch) == 1 {
                        while i < len(s) && oIsDigit(char_at(s, i)) == 1 {
                            i = i + 1
                        }
                        toks = push(toks, { "k": "num", "v": "0" })
                    } else {
                        toks = push(toks, { "k": "op", "v": ch })
                        i = i + 1
                    }
                }
            }
        }
    }
    return toks
}

fn oPeek() {
    if oI >= len(oToks) {
        return { "k": "eof", "v": "" }
    }
    return oToks[oI]
}

fn oBump() {
    let t = oPeek()
    if oI < len(oToks) {
        oI = oI + 1
    }
    return t
}

fn oAtId(name) {
    let t = oPeek()
    if t.k == "id" && t.v == name {
        return 1
    }
    return 0
}

fn oMutCount(name) {
    if object_has_own(oMutBorrows, name) {
        return oMutBorrows[name]
    }
    return 0
}

fn oSharedCount(name) {
    if object_has_own(oSharedBorrows, name) {
        return oSharedBorrows[name]
    }
    return 0
}

fn oMutAdd(name, delta) {
    // Mutate module maps directly (Kab CoW: map args do not write back)
    let n = oMutCount(name) + delta
    if n <= 0 {
        oMutBorrows[name] = 0
    } else {
        oMutBorrows[name] = n
    }
}

fn oSharedAdd(name, delta) {
    let n = oSharedCount(name) + delta
    if n <= 0 {
        oSharedBorrows[name] = 0
    } else {
        oSharedBorrows[name] = n
    }
}

fn oIsBorrowed(name) {
    if oMutCount(name) > 0 {
        return 1
    }
    if oSharedCount(name) > 0 {
        return 1
    }
    return 0
}

fn oUse(name, doMove) {
    let st = oPlaces[name]
    if st == "moved" {
        oErr("ownership: use after move of `" + name + "`")
        return 0
    }
    if st == "owned" {
        if doMove == 1 {
            if oIsBorrowed(name) == 1 {
                oErr("ownership: cannot move `" + name + "` while borrowed")
                return 0
            }
            oPlaces[name] = "moved"
            return 1
        }
        return 0
    }
    return 0
}

fn oBorrow(name, isMut) {
    let st = oPlaces[name]
    if st == "moved" {
        oErr("ownership: use after move of `" + name + "`")
        return
    }
    if st != "owned" {
        return
    }
    if isMut == 1 {
        if oMutCount(name) > 0 {
            oErr("ownership: exclusive &mut borrow of `" + name + "` already active")
            return
        }
        if oSharedCount(name) > 0 {
            oErr("ownership: cannot &mut `" + name + "` while shared-borrowed")
            return
        }
        oMutAdd(name, 1)
    } else {
        if oMutCount(name) > 0 {
            oErr("ownership: cannot shared-borrow `" + name + "` while &mut active")
            return
        }
        oSharedAdd(name, 1)
    }
}

fn oClearCallBorrows(names) {
    let i = 0
    while i < len(names) {
        let n = names[i]
        if oMutCount(n) > 0 {
            oMutAdd(n, -1)
        }
        if oSharedCount(n) > 0 {
            oSharedAdd(n, -1)
        }
        i = i + 1
    }
}

fn oSkipCallArgs(doMove) {
    if oPeek().v != "(" {
        return
    }
    oBump()
    let depth = 1
    let callBorrows = []
    while oI < len(oToks) && depth > 0 {
        let t = oPeek()
        if t.v == "(" {
            oBump()
            depth = depth + 1
        } else {
            if t.v == ")" {
                oBump()
                depth = depth - 1
            } else {
                if depth == 1 && t.k == "op" && t.v == "&" {
                    // & / &mut borrow — peek, do not move; track for exclusivity
                    oBump()
                    let isMut = 0
                    if oAtId("mut") == 1 {
                        oBump()
                        isMut = 1
                    }
                    if oPeek().k == "id" {
                        let n = oPeek().v
                        oBump()
                        oBorrow(n, isMut)
                        callBorrows = push(callBorrows, n)
                    }
                } else {
                    if t.k == "id" && depth == 1 {
                        oBump()
                        oUse(t.v, doMove)
                    } else {
                        oBump()
                    }
                }
            }
        }
    }
    // Borrow scope = call expression
    oClearCallBorrows(callBorrows)
}

/// Parse a primary/call expression. Returns 1 if it produces Owned.
fn oExpr(doMove) {
    let t = oPeek()
    // O5 deepen: bare &x / &mut x — peek (no move). Call-arg borrows tracked in oSkipCallArgs.
    if t.k == "op" && t.v == "&" {
        oBump()
        if oAtId("mut") == 1 {
            oBump()
        }
        let nameTok = oPeek()
        if nameTok.k == "id" {
            oBump()
            oUse(nameTok.v, 0)
        }
        return 0
    }
    if t.k != "id" {
        if t.k != "eof" {
            oBump()
        }
        return 0
    }
    let name = t.v
    oBump()
    if name == "owned_alloc" || name == "alloc" {
        if oPeek().v == "(" {
            oSkipCallArgs(0)
        }
        return 1
    }
    if name == "drop" || name == "owned_move" || name == "move" || name == "free" {
        if oPeek().v == "(" {
            oBump()
            if oPeek().k == "op" && oPeek().v == "&" {
                oBump()
                if oAtId("mut") == 1 {
                    oBump()
                }
            }
            let arg = oPeek()
            if arg.k == "id" {
                oBump()
                oUse(arg.v, 1)
            }
            if oPeek().v == ")" {
                oBump()
            }
        }
        return 1
    }
    if name == "owned_read" || name == "owned_write" || name == "read" || name == "write" {
        if oPeek().v == "(" {
            oSkipCallArgs(0)
        }
        return 0
    }
    if oPeek().v == "(" {
        // O2: bare Owned call-arg moves unless & / &mut
        oSkipCallArgs(1)
        return 0
    }
    return oUse(name, doMove)
}

fn oStmt() {
    if oAtId("@manual") == 1 {
        oBump()
        return
    }
    if oAtId("let") == 1 {
        oBump()
        let nameTok = oPeek()
        if nameTok.k != "id" {
            return
        }
        let name = nameTok.v
        oBump()
        if oPeek().v == "=" {
            oBump()
            let produced = oExpr(1)
            if produced == 1 {
                oPlaces[name] = "owned"
            }
        }
        return
    }
    let t = oPeek()
    if t.k == "id" {
        let name = t.v
        let save = oI
        oBump()
        if oPeek().v == "=" {
            oBump()
            let produced = oExpr(1)
            if produced == 1 {
                oPlaces[name] = "owned"
            }
            return
        }
        oI = save
    }
    oExpr(0)
}

pub fn checkOwnership(source) {
    oPlaces = {}
    oMutBorrows = {}
    oSharedBorrows = {}
    oErrors = []
    oToks = oTokenize(source)
    oI = 0
    while oI < len(oToks) {
        let before = oI
        oStmt()
        if oI == before {
            oBump()
        }
    }
    let keys = object_keys(oPlaces)
    let i = 0
    while i < len(keys) {
        let k = keys[i]
        if oPlaces[k] == "owned" {
            oErr("ownership: Owned '" + k + "' dropped out of scope without move/drop (leak-lint)")
        }
        i = i + 1
    }
    if len(oErrors) == 0 {
        return null
    }
    let msg = oErrors[0]
    i = 1
    while i < len(oErrors) {
        msg = msg + "\n" + oErrors[i]
        i = i + 1
    }
    return msg
}

pub fn checkSource(source) {
    return checkOwnership(source)
}
