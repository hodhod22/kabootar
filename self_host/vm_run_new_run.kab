import "self_host/vm_s_stack"
import "self_host/vm_run_session"
import "self_host/vm_run_call"
import "kab/gc"
import "kab/gc/gc_alloc"

// --- vm_run_new_init ---
/// Resolve init/constructor on classDef.
pub fn vResolveInit(classDef) {
    let init = vFindMethod(classDef, "init")
    if init == null {
        init = vFindMethod(classDef, "constructor")
    }
    return init
}

// --- vm_run_new_run_init_present ---
/// Run class init via hook when present.
pub fn vRunNewInitPresentS(S, info, pool, globals, functions) {
    let inst = info["inst"]
    vHeapPut(S, inst)
    S["lastThis"] = inst
    vCallRunMeth(S, info["init"], pool, globals, functions, inst, info["ordered"])
    let hid = vInstId(inst)
    let fresh = vHeapGet(S, hid)
    if fresh != undefined {
        inst = fresh
    } else {
        if S["lastThis"] != null {
            inst = S["lastThis"]
        }
    }
    return inst
}

/// Charge nursery bump for one instance; collect is promote-account (host heap still skuld).
pub fn vNurseryCharge(S, n) {
    let cap = S["gcCap"]
    if cap == null {
        cap = gcNurseryCap()
        S["gcCap"] = cap
    }
    let used = S["gcUsed"]
    if used == null {
        used = 0
    }
    let next = gcAllocOrCollect(used, n, cap)
    if next < used {
        let c = S["gcCollects"]
        if c == null {
            c = 0
        }
        S["gcCollects"] = c + 1
        vGcRootsAuditS(S)
    }
    S["gcUsed"] = next
}

// --- vm_run_gc_audit ---
/// Deduped inst ids (vmI/__kab_oid) found in one value array.
pub fn vGcScanArrS(roots, arr) {
    if typeof(arr) != "array" {
        return roots
    }
    let i = 0
    while i < len(arr) {
        let id = vInstId(arr[i])
        if id != undefined {
            let seen = false
            let j = 0
            while j < len(roots) {
                if roots[j] == id {
                    seen = true
                }
                j = j + 1
            }
            if seen == false {
                roots = push(roots, id)
            }
        }
        i = i + 1
    }
    return roots
}

/// Audit-only collect: scan stack/locals/globals/thisStack for the root set,
/// then count live (rooted) vs dead insts in the heap. Nothing is swept —
/// host heap remains skuld until gcHostDeleteOk.
pub fn vGcRootsAuditS(S) {
    let roots = []
    roots = vGcScanArrS(roots, S["stack"])
    roots = vGcScanArrS(roots, S["locals"])
    roots = vGcScanArrS(roots, S["globals"])
    roots = vGcScanArrS(roots, S["thisStack"])
    S["gcRootsN"] = len(roots)
    let heap = S["insts"]
    if typeof(heap) != "array" {
        S["gcLiveN"] = 0
        S["gcDeadN"] = 0
        return
    }
    let live = 0
    let dead = 0
    let i = 0
    while i < len(heap) {
        let id = vInstId(heap[i])
        if id != undefined {
            let rooted = false
            let j = 0
            while j < len(roots) {
                if roots[j] == id {
                    rooted = true
                }
                j = j + 1
            }
            if rooted {
                live = live + 1
            } else {
                dead = dead + 1
            }
        }
        i = i + 1
    }
    S["gcLiveN"] = live
    S["gcDeadN"] = dead
    return
}

// --- vm_run_new_shell ---
/// Pop ctor args and allocate instance shell.
pub fn vAllocInstShell(S, classIdx, argc) {
    if classIdx < 0 || classIdx >= len(S["classes"]) {
        throw "vm bad class index"
    }
    let classDef = S["classes"][classIdx]
    let ordered = vPopOrderedArgs(S, argc)
    let id = S["nextInstId"]
    S["nextInstId"] = S["nextInstId"] + 1
    let inst = { "vmC": classIdx, "vmI": id, "__kab_oid": id }
    vNurseryCharge(S, gcInstShellBytes())
    vHeapPut(S, inst)
    return {
        "inst": inst,
        "ordered": ordered,
        "classDef": classDef
    }
}

// --- vm_run_new_run_init ---
/// Run init on shell if present; update lastThis. Returns inst.
pub fn vRunNewInitS(S, info, argc, pool, globals, functions) {
    if info["init"] != null {
        return vRunNewInitPresentS(S, info, pool, globals, functions)
    }
    if argc > 0 {
        throw "vm class has no init: " + info["sym"]
    }
    return info["inst"]
}

// --- vm_run_new_inst ---
/// Allocate instance shell + resolve init method (no runMethodBody).
pub fn vAllocInstance(S, classIdx, argc) {
    let sh = vAllocInstShell(S, classIdx, argc)
    let init = vResolveInit(sh["classDef"])
    return {
        "inst": sh["inst"],
        "init": init,
        "ordered": sh["ordered"],
        "sym": sh["classDef"]["sym"]
    }
}

// --- vm_run_new_run ---
pub fn vNewInstanceS(S, classIdx, argc, pool, globals, functions) {
    let info = vAllocInstance(S, classIdx, argc)
    return vRunNewInitS(S, info, argc, pool, globals, functions)
}

// --- vm_run_new_from_array ---
/// Pop args array (spread ctor) and run the same init path as `new_instance`.
pub fn vNewInstanceFromArrayS(S, classIdx, pool, globals, functions) {
    let ordered = vArrayToOrdered(vPopS(S))
    if classIdx < 0 || classIdx >= len(S["classes"]) {
        throw "vm bad class index"
    }
    let classDef = S["classes"][classIdx]
    let id = S["nextInstId"]
    S["nextInstId"] = id + 1
    let inst = { "vmC": classIdx, "vmI": id, "__kab_oid": id }
    vNurseryCharge(S, gcInstShellBytes())
    vHeapPut(S, inst)
    let info = {
        "inst": inst,
        "init": vResolveInit(classDef),
        "ordered": ordered,
        "sym": classDef["sym"]
    }
    return vRunNewInitS(S, info, len(ordered), pool, globals, functions)
}
