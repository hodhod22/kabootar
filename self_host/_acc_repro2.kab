fn emitOp(E, op, arg) {
    E["eOps"] = push(E["eOps"], { "op": op, "arg": arg })
    E["eOpsN"] = E["eOpsN"] + 1
}
fn run(E) {
    touchAll(E)
    let _ = nameProbe("k0")
    E["eConsts"] = push(E["eConsts"], 1)
    println("after push c="+len(E["eConsts"]))
    E["eIdx"] = 0
    println("after eIdx c="+len(E["eConsts"]))
    emitOp(E, "const", E["eIdx"])
    println("after op c="+len(E["eConsts"])+" o="+len(E["eOps"]))
    E["eGlobals"] = push(E["eGlobals"], "x")
    println("after g g="+len(E["eGlobals"]))
    E["eIdx"] = 0
    emitOp(E, "store_global", E["eIdx"])
    println("end c="+len(E["eConsts"])+" g="+len(E["eGlobals"])+" o="+len(E["eOps"]))
}
let E = makeE()
run(E)
