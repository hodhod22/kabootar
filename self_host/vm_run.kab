// H6e: Kabootar bytecode VM subset run entry — thin facade (body in vm_run_body.kab).
// import "self_host/vm_run" (used internally by self_host/vm_impl.kab)
//
// Re-export by alias (not a wrapping fn): a wrapping `fn runModuleImplCore` adds an
// extra host `call_value` frame. Under KABOOTAR_VM=kab-only that breaks reentrancy of
// module `vGlobals` when the outer probe is self-host-compiled (lets → globals) and a
// nested guest has imports — see self_host/vm.kab header for the full explanation.
//
// vm_run_body.kab stays skip-listed (~27KB of shared-state interpreter code that is
// far too slow to self-host-compile in CI). This facade's own source is a two-line
// import + alias, so `compile self_host/vm_run.kab --self-host` is CI-fast and the
// file no longer needs to be on the skip list itself.

import "self_host/vm_run_body"

pub let runModuleImplCore = runModuleImplBody
