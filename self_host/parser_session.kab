// SH5: session init in one module (was four P6b shards).
fn pSessionInit_core(sess) {
    sess["pPos"] = 0
    sess["pToks"] = []
    sess["pToksLen"] = 0
    sess["pCur"] = null
    sess["pEofTok"] = { "type": "EOF", "value": null, "line": 1, "column": 1 }
    sess["pTok"] = null
    sess["pNextTok"] = null
    sess["pDone"] = 0
    sess["pSymPool"] = []
    sess["pSymN"] = 0
    sess["pSymOut"] = ""
    sess["pSymSrc"] = ""
    sess["pSymI"] = 0
    sess["pPopI"] = 0
    sess["pPopNew"] = []
    sess["pImports"] = []
    sess["pIsPub"] = 0
    sess["pFnPub"] = 0
    sess["pInAddSub"] = 0
    sess["pNoBit"] = 0
    return 0
}

fn pSessionInit_expr(sess) {
    sess["pLeft"] = null
    sess["pRight"] = null
    sess["pArgs"] = []
    sess["pIdent"] = null
    sess["pInit"] = null
    sess["pVal"] = null
    sess["pCallee"] = null
    sess["pObjFields"] = []
    sess["pSave"] = null
    sess["pAssignLhs"] = null
    sess["pBinOp"] = ""
    sess["pSaveSym"] = ""
    sess["pBindSym"] = ""
    sess["pExprLeft"] = null
    sess["pAddLeft"] = null
    sess["pAddLeftStack"] = []
    sess["pTypeArgs"] = []
    sess["pSnapTypeArgs"] = []
    sess["pIsGenericCallee"] = 0
    sess["pAngleI"] = 0
    sess["pAngleTok"] = null
    sess["pAngleOut"] = []
    sess["pMemberName"] = ""
    return 0
}

fn pSessionInit_stmt(sess) {
    sess["pBody"] = []
    sess["pBodyStack"] = []
    sess["pStmts"] = []
    sess["pParams"] = []
    sess["pCond"] = null
    sess["pCondStack"] = []
    sess["pThen"] = null
    sess["pElse"] = null
    sess["pLoopBody"] = []
    sess["pFnSym"] = ""
    sess["pLetSym"] = ""
    sess["pBodyDepth"] = 0
    sess["pCondDepth"] = 0
    return 0
}

fn pSessionInit_type(sess) {
    sess["pTypeParams"] = []
    sess["pParamTypes"] = []
    sess["pReturnType"] = ""
    sess["pVariants"] = []
    sess["pClassFields"] = []
    sess["pClassMethods"] = []
    sess["pFieldType"] = ""
    sess["pFieldDefault"] = null
    sess["pVariantFields"] = []
    sess["pMethTypeParams"] = []
    sess["pMethParams"] = []
    sess["pMethParamTypes"] = []
    sess["pVariantName"] = ""
    sess["pVariantSym"] = ""
    sess["pEnumSym"] = ""
    sess["pClassSym"] = ""
    sess["pIsStruct"] = 0
    sess["pIfaceSym"] = ""
    sess["pIfaceMethods"] = []
    sess["pAssocTypes"] = []
    sess["pWhereClause"] = []
    sess["pWhereParam"] = ""
    sess["pWhereTrait"] = ""
    sess["pParamType"] = ""
    return 0
}

pub fn pMakeSession() {
    let sess = {}
    pSessionInit_core(sess)
    pSessionInit_expr(sess)
    pSessionInit_stmt(sess)
    pSessionInit_type(sess)
    return sess
}

pub fn pResetSession(sess) {
    pSessionInit_core(sess)
    pSessionInit_expr(sess)
    pSessionInit_stmt(sess)
    pSessionInit_type(sess)
    return 0
}
