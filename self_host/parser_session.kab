// P6b: parser session — thread sess into all shards.
pub fn pMakeSession() {
    let sess = {}
    sess["pPos"] = 0
    sess["pToks"] = []
    sess["pToksLen"] = 0
    sess["pCur"] = null
    sess["pEofTok"] = { "type": "EOF", "value": null, "line": 1, "column": 1 }
    sess["pLeft"] = null
    sess["pRight"] = null
    sess["pArgs"] = []
    sess["pTok"] = null
    sess["pIdent"] = null
    sess["pInit"] = null
    sess["pVal"] = null
    sess["pBody"] = []
    sess["pBodyStack"] = []
    sess["pStmts"] = []
    sess["pParams"] = []
    sess["pCond"] = null
    sess["pCondStack"] = []
    sess["pThen"] = null
    sess["pElse"] = null
    sess["pLoopBody"] = []
    sess["pCallee"] = null
    sess["pObjFields"] = []
    sess["pSave"] = null
    sess["pAssignLhs"] = null
    sess["pBinOp"] = ""
    sess["pSaveSym"] = ""
    sess["pBindSym"] = ""
    sess["pExprLeft"] = null
    sess["pFnSym"] = ""
    sess["pFnPub"] = 0
    sess["pIsPub"] = 0
    sess["pLetSym"] = ""
    sess["pSymPool"] = []
    sess["pSymN"] = 0
    sess["pBodyDepth"] = 0
    sess["pCondDepth"] = 0
    sess["pImports"] = []
    sess["pPopI"] = 0
    sess["pPopNew"] = []
    sess["pSymOut"] = ""
    sess["pSymSrc"] = ""
    sess["pSymI"] = 0
    sess["pInAddSub"] = 0
    sess["pNoBit"] = 0
    sess["pAddLeft"] = null
    sess["pAddLeftStack"] = []
    sess["pNextTok"] = null
    sess["pDone"] = 0
    sess["pTypeParams"] = []
    sess["pParamTypes"] = []
    sess["pReturnType"] = ""
    sess["pTypeArgs"] = []
    sess["pVariants"] = []
    sess["pClassFields"] = []
    sess["pClassMethods"] = []
    sess["pFieldType"] = ""
    sess["pFieldDefault"] = null
    sess["pVariantFields"] = []
    sess["pMethTypeParams"] = []
    sess["pMethParams"] = []
    sess["pMethParamTypes"] = []
    sess["pIsGenericCallee"] = 0
    sess["pAngleI"] = 0
    sess["pAngleTok"] = null
    sess["pAngleOut"] = []
    sess["pMemberName"] = ""
    sess["pVariantName"] = ""
    sess["pVariantSym"] = ""
    sess["pEnumSym"] = ""
    sess["pClassSym"] = ""
    sess["pIsStruct"] = 0
    sess["pIfaceSym"] = ""
    sess["pIfaceMethods"] = []
    sess["pAssocTypes"] = []
    sess["pWhereClause"] = []
    sess["pWhereParam"] = ""
    sess["pWhereTrait"] = ""
    sess["pSnapTypeArgs"] = []
    sess["pParamType"] = ""
    return sess
}

