import "self_host/vm_s_push"
import "self_host/vm_s_pop"
import "self_host/vm_s_ip"

pub fn runOpDataOptionSome(S, name, arg, op, pool, globals, functions) {
    if name == "make_some" {
        vPushS(S, { "vmOption": "some", "v": vPopS(S) })
        vBumpIpS(S)
        return 1
    }
    if name == "make_none" {
        vPushS(S, { "vmOption": "none" })
        vBumpIpS(S)
        return 1
    }
    return 0
}
