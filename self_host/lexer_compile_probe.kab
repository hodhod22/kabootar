// Self-hosted compile of lexer-like loop -> .kbc text for Rust run_module.
import "self_host/compile"
import "self_host/lexer_defs"

compile("let pos = 0" + CHAR_NL + "let src = " + QUOTE + "ab" + QUOTE + CHAR_NL + "while pos < len(src) {" + CHAR_NL + "  pos = pos + 1" + CHAR_NL + "}" + CHAR_NL + "return pos")
