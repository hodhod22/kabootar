import "self_host/vm_s_push"
import "self_host/vm_s_pop"
import "self_host/vm_s_ip"
import "self_host/vm_s_truthy"

pub fn runOpCmpNot(S, name, arg, op, pool, globals, functions) {
    if name == "not" {
        let v = vPopS(S)
        vPushS(S, !vTruthy(v))
        vBumpIpS(S)
        return 1
    }
    return 0
}
