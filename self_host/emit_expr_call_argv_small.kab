import "self_host/emit_defs"
import "self_host/emit_hooks"
import "self_host/emit_op"
import "self_host/emit_call_callee"
import "self_host/emit_call_arg_fast"

pub fn emitExpr_callArgvSmall(E) {
    if E["eArgN"] == 0 {
        emitCallCallee(E)
        emitOp(E, OP_CALL, 0)
        E["_callDone"] = 1
        return 0
    }
    if E["eArgN"] == 1 {
        emitCallArgFast(E, E["eArgs"][0])
        emitCallCallee(E)
        emitOp(E, OP_CALL, 1)
        E["_callDone"] = 1
        return 0
    }
    if E["eArgN"] == 2 {
        emitCallArgFast(E, E["eArgs"][0])
        emitCallArgFast(E, E["eArgs"][1])
        emitCallCallee(E)
        emitOp(E, OP_CALL, 2)
        E["_callDone"] = 1
        return 0
    }
    return 1
}
