import "self_host/vm_s_pop"

pub fn vPopOrderedArgs(S, argc) {
    let rawArgs = []
    let ai = 0
    while ai < argc {
        rawArgs = push(rawArgs, vPopS(S))
        ai = ai + 1
    }
    let ordered = []
    let oi = argc - 1
    while oi >= 0 {
        ordered = push(ordered, rawArgs[oi])
        oi = oi - 1
    }
    return ordered
}
