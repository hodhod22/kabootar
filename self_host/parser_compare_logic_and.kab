import "self_host/lexer_defs"
import "self_host/ast_defs"
import "self_host/parser_hooks"
import "self_host/parser_util"

pub fn parseCompare_logic_and(sess) {
    while sess["pCur"].type == "&&" {
        bump(sess)
        let left = sess["pLeft"]
        let right = pCallRelExpr(sess)
        if sess["pNoBit"] == 0 {
            while sess["pCur"].type == "&" || sess["pCur"].type == "^" || sess["pCur"].type == "|" {
                let op = sess["pCur"].type
                bump(sess)
                right = { "kind": AST_BINARY, "op": op, "left": right, "right": pCallRelExpr(sess) }
            }
        }
        sess["pLeft"] = { "kind": AST_BINARY, "op": "&&", "left": left, "right": right }
    }
    return 0
}
