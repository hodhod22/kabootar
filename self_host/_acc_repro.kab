        "eList": [],
        "eBodyStmts": [],
        "eBlockStmts": [],
        "eBlockN": 0,
        "eBlockI": 0,
        "eBlockNStack": [],
        "eBlockIStack": [],
        "eBlockStmtsStack": [],
        "eBlockDepth": 0,
        "eCalleeDepth": 0,
        "eCallArgDepth": 0,
        "eObjDepth": 0,
