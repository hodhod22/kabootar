fn emitOp(E, op, arg) {
    E["eOps"] = push(E["eOps"], { "op": op, "arg": arg })
    E["eOpsN"] = E["eOpsN"] + 1
}
fn symC(E, arg) {
    E["eConsts"] = push(E["eConsts"], arg)
    let cIdx = E["eConstN"]
    E["eConstN"] = E["eConstN"] + 1
    return cIdx
}
fn symG(E, arg) {
    E["eGlobals"] = push(E["eGlobals"], arg)
    let gIdx = E["eGlobalN"]
    E["eGlobalN"] = E["eGlobalN"] + 1
    return gIdx
}
let E = makeE()
let ci = symC(E, 1)
println("after symC c="+len(E["eConsts"])+" ci="+ci)
E["eIdx"] = ci
println("after eIdx c="+len(E["eConsts"]))
emitOp(E, "const", E["eIdx"])
println("after emitOp const c="+len(E["eConsts"])+" g="+len(E["eGlobals"])+" o="+len(E["eOps"]))
let gi = symG(E, "x")
println("after symG g="+len(E["eGlobals"])+" gi="+gi)
E["eIdx"] = gi
emitOp(E, "store_global", E["eIdx"])
println("after store c="+len(E["eConsts"])+" g="+len(E["eGlobals"])+" o="+len(E["eOps"]))
