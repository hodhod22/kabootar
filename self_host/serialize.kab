// Serialize self-hosted opcode IR to kabootar-bytecode/1 text (.kbc subset).
import "self_host/serialize_defs"
import "self_host/emit_defs"

let sOut = ""
let sI = 0
let sOp = null
let sLine = ""
let sFn = null
let sParams = ""
let sJ = 0
let sEscOut = ""
let sEscI = 0
let sEscCh = ""

// ----- HELPER FUNCTIONS -----

fn escStr(s) {
    sEscOut = ""
    sEscI = 0
    while sEscI < len(s) {
        sEscCh = char_at(s, sEscI)
        if sEscCh == "\\" {
            sEscOut = sEscOut + "\\\\"
        } else {
            if sEscCh == " " {
                sEscOut = sEscOut + "\\s"
            } else {
                sEscOut = sEscOut + sEscCh
            }
        }
        sEscI = sEscI + 1
    }
    return sEscOut
}

fn constLine(idx, val) {
    if val == KAB_UNDEF_CONST {
        return "const " + ("" + idx) + " undefined"
    }
    if val == null {
        return "const " + ("" + idx) + " null"
    }
    if val == true {
        return "const " + ("" + idx) + " bool true"
    }
    if val == false {
        return "const " + ("" + idx) + " bool false"
    }
    if typeof(val) == "string" {
        return "const " + ("" + idx) + " string " + escStr(val)
    }
    return "const " + ("" + idx) + " number " + ("" + val)
}

fn irOpLine(op) {
    if op == null {
        throw "serialize: null op in IR"
    }
    sOp = op.op
    if sOp == OP_CONST {
        return "const " + ("" + op.arg)
    }
    if sOp == OP_LOAD_GLOBAL {
        return "load_global " + ("" + op.arg)
    }
    if sOp == OP_STORE_GLOBAL {
        return "store_global " + ("" + op.arg)
    }
    if sOp == OP_LOAD_LOCAL {
        return "load_local " + ("" + op.arg)
    }
    if sOp == OP_STORE_LOCAL {
        return "store_local " + ("" + op.arg)
    }
    if sOp == OP_POP {
        return "pop"
    }
    if sOp == OP_ADD {
        return "add"
    }
    if sOp == OP_SUB {
        return "sub"
    }
    if sOp == OP_MUL {
        return "mul"
    }
    if sOp == OP_DIV {
        return "div"
    }
    if sOp == OP_MOD {
        return "mod"
    }
    if sOp == OP_POW {
        return "pow"
    }
    if sOp == OP_NEG {
        return "neg"
    }
    if sOp == OP_NOT {
        return "not"
    }
    if sOp == OP_EQ {
        return "eq"
    }
    if sOp == OP_NE {
        return "ne"
    }
    if sOp == OP_LT {
        return "lt"
    }
    if sOp == OP_GT {
        return "gt"
    }
    if sOp == OP_GE {
        return "ge"
    }
    if sOp == OP_LE {
        return "le"
    }
    if sOp == OP_AND {
        return "and"
    }
    if sOp == OP_OR {
        return "or"
    }
    if sOp == OP_MAKE_OBJECT {
        return "make_object " + ("" + op.arg)
    }
    if sOp == OP_MAKE_ARRAY {
        return "make_array " + ("" + op.arg)
    }
    if sOp == OP_INDEX_GET {
        return "index_get"
    }
    if sOp == OP_INDEX_SET {
        return "index_set"
    }
    if sOp == OP_GET_MEMBER {
        return "get_member " + ("" + op.arg)
    }
    if sOp == OP_SET_MEMBER {
        return "set_member " + ("" + op.arg)
    }
    if sOp == OP_JUMP {
        return "jump " + ("" + op.arg)
    }
    if sOp == OP_JUMP_IF_FALSE {
        return "jump_if_false " + ("" + op.arg)
    }
    if sOp == OP_JUMP_IF_TRUE {
        return "jump_if_true " + ("" + op.arg)
    }
    if sOp == OP_CALL {
        return "call " + ("" + op.arg)
    }
    if sOp == OP_RETURN {
        return "return"
    }
    if sOp == OP_THROW {
        return "throw"
    }
    if sOp == OP_HALT {
        return "halt"
    }
    throw "Unsupported IR op: " + sOp
}

fn appendOps(ops) {
    sI = 0
    while sI < len(ops) {
        sOut = sOut + "\n" + irOpLine(ops[sI])
        sI = sI + 1
    }
}

// ----- MAIN SERIALIZE FUNCTION -----

pub fn serialize_bc(bc) {
    sOut = KBC_HEADER
    sOut = sOut + "\n" + ("constants=" + ("" + len(bc.constants)))
    sI = 0
    while sI < len(bc.constants) {
        sOut = sOut + "\n" + constLine(sI, bc.constants[sI])
        sI = sI + 1
    }
    sI = 0
    while sI < len(bc.globals) {
        sOut = sOut + "\n" + ("global " + ("" + sI) + " " + bc.globals[sI])
        sI = sI + 1
    }
    sOut = sOut + "\n" + ("functions=" + ("" + len(bc.functions)))
    sI = 0
    while sI < len(bc.functions) {
        sFn = bc.functions[sI]
        sOut = sOut + "\n" + ("fn " + ("" + sI) + " " + sFn.sym)
        // Params
        sParams = ""
        sJ = 0
        while sJ < len(sFn.params) {
            if sParams == "" {
                sParams = sFn.params[sJ]
            } else {
                sParams = sParams + "," + sFn.params[sJ]
            }
            sJ = sJ + 1
        }
        sOut = sOut + "\n" + ("fn_params " + ("" + sI) + " " + sParams)
        // Locals
        sParams = ""
        sJ = 0
        while sJ < len(sFn.locals) {
            if sParams == "" {
                sParams = sFn.locals[sJ]
            } else {
                sParams = sParams + "," + sFn.locals[sJ]
            }
            sJ = sJ + 1
        }
        sOut = sOut + "\n" + ("fn_locals " + ("" + sI) + " " + sParams)
        // Function ops
        sJ = 0
        while sJ < len(sFn.ops) {
            sOut = sOut + "\n" + ("fn_op " + ("" + sI) + " " + irOpLine(sFn.ops[sJ]))
            sJ = sJ + 1
        }
        sI = sI + 1
    }
    // Exports
    if bc.exports == undefined {
        sOut = sOut + "\n" + "exports=0"
    } else {
        sOut = sOut + "\n" + ("exports=" + ("" + len(bc.exports)))
        sI = 0
        while sI < len(bc.exports) {
            sOut = sOut + "\n" + ("export " + ("" + sI) + " " + bc.exports[sI])
            sI = sI + 1
        }
    }
    // Imports
    if bc.imports == undefined {
        sOut = sOut + "\n" + "imports=0"
    } else {
        sOut = sOut + "\n" + ("imports=" + ("" + len(bc.imports)))
        sI = 0
        while sI < len(bc.imports) {
            sOut = sOut + "\n" + ("import " + ("" + sI) + " " + bc.imports[sI])
            sI = sI + 1
        }
    }
    // Main code
    sOut = sOut + "\n" + "code"
    appendOps(bc.ops)
    return sOut
}