// H6e: self-hosted .kbc serializer — thin facade (impl in serialize_impl.kab).
// import "self_host/serialize"
//
// Re-export by alias (not a wrapping fn): a wrapping `fn serialize_bc` adds an extra
// host `call_value` frame. Under KABOOTAR_VM=kab-only that breaks reentrancy the same
// way a wrapped `runModule` does in self_host/vm.kab — see that file's header.
//
// serialize_impl.kab stays skip-listed: self-host-compiling its ~13KB body already
// takes multiple minutes (self-hosting cost scales with the AST size of the source
// being compiled, not file size alone), so it must never be attempted directly.
// This facade is the only file fed through the self-hosted compiler; its own source
// is a two-line import + alias, so `compile self_host/serialize.kab --self-host` is
// CI-fast regardless of how heavy serialize_impl.kab is.

import "self_host/serialize_impl"

pub let serialize_bc = serializeBcImpl
