// H6e: self-hosted .kbc serializer — thin facade (impl in serialize_impl.kab).
// import "self_host/serialize"
//
// Re-export by alias (not a wrapping fn): a wrapping `fn serialize_bc` adds an extra
// host `call_value` frame. Under KABOOTAR_VM=kab-only that breaks reentrancy the same
// way a wrapped `runModule` does in self_host/vm.kab — see that file's header.
//
// serialize_impl.kab is itself a thin facade now; the heavy body lives in
// serialize_body.kab, which is the only file on the skip list. Self-host-compiling
// that ~13KB body takes multiple minutes (self-hosting cost scales with the AST size
// of the source being compiled, not file size alone), so it must never be attempted
// directly. Both facades above it are two-line import + alias files, so `compile
// self_host/serialize.kab --self-host` is CI-fast regardless of serialize_body.kab.

import "self_host/serialize_impl"

pub let serialize_bc = serializeBcImpl
