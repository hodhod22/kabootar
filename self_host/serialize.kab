// Serialize self-hosted opcode IR to kabootar-bytecode/1 text (.kbc subset).
import "self_host/serialize_defs"
import "self_host/emit_defs"

let sOut = ""
let sI = 0
let sOp = null
let sLine = ""
let sFn = null
let sParams = ""
let sJ = 0

fn constLine(idx, val) {
    if val == null {
        return "const " + ("" + idx) + " null"
    }
    if val == true {
        return "const " + ("" + idx) + " bool true"
    }
    if val == false {
        return "const " + ("" + idx) + " bool false"
    }
    if typeof(val) == "string" {
        return "const " + ("" + idx) + " string " + val
    }
    return "const " + ("" + idx) + " number " + ("" + val)
}

fn irOpLine(op) {
    sOp = op.op
    if sOp == OP_CONST {
        return "const " + ("" + op.arg)
    }
    if sOp == OP_LOAD_GLOBAL {
        return "load_global " + ("" + op.arg)
    }
    if sOp == OP_STORE_GLOBAL {
        return "store_global " + ("" + op.arg)
    }
    if sOp == OP_LOAD_LOCAL {
        return "load_local " + ("" + op.arg)
    }
    if sOp == OP_STORE_LOCAL {
        return "store_local " + ("" + op.arg)
    }
    if sOp == OP_POP {
        return "pop"
    }
    if sOp == OP_ADD {
        return "add"
    }
    if sOp == OP_SUB {
        return "sub"
    }
    if sOp == OP_EQ {
        return "eq"
    }
    if sOp == OP_NE {
        return "ne"
    }
    if sOp == OP_LT {
        return "lt"
    }
    if sOp == OP_GT {
        return "gt"
    }
    if sOp == OP_GE {
        return "ge"
    }
    if sOp == OP_LE {
        return "le"
    }
    if sOp == OP_AND {
        return "and"
    }
    if sOp == OP_MAKE_OBJECT {
        return "make_object " + ("" + op.arg)
    }
    if sOp == OP_MAKE_ARRAY {
        return "make_array " + ("" + op.arg)
    }
    if sOp == OP_INDEX_GET {
        return "index_get"
    }
    if sOp == OP_GET_MEMBER {
        return "get_member " + ("" + op.arg)
    }
    if sOp == OP_JUMP {
        return "jump " + ("" + op.arg)
    }
    if sOp == OP_JUMP_IF_FALSE {
        return "jump_if_false " + ("" + op.arg)
    }
    if sOp == OP_CALL {
        return "call " + ("" + op.arg)
    }
    if sOp == OP_RETURN {
        return "return"
    }
    if sOp == OP_THROW {
        return "throw"
    }
    if sOp == OP_HALT {
        return "halt"
    }
    throw "Unsupported IR op: " + sOp
}

fn appendOps(ops) {
    sI = 0
    while sI < len(ops) {
        sOut = sOut + CHAR_NL + irOpLine(ops[sI])
        sI = sI + 1
    }
}

pub fn serialize_bc(bc) {
    sOut = KBC_HEADER
    sOut = sOut + CHAR_NL + ("constants=" + ("" + len(bc.constants)))
    sI = 0
    while sI < len(bc.constants) {
        sOut = sOut + CHAR_NL + constLine(sI, bc.constants[sI])
        sI = sI + 1
    }
    sI = 0
    while sI < len(bc.globals) {
        sOut = sOut + CHAR_NL + ("global " + ("" + sI) + " " + bc.globals[sI])
        sI = sI + 1
    }
    sOut = sOut + CHAR_NL + ("functions=" + ("" + len(bc.functions)))
    sI = 0
    while sI < len(bc.functions) {
        sFn = bc.functions[sI]
        sOut = sOut + CHAR_NL + ("fn " + ("" + sI) + " " + sFn.sym)
        sParams = ""
        sJ = 0
        while sJ < len(sFn.params) {
            if sParams == "" {
                sParams = sFn.params[sJ]
            } else {
                sParams = sParams + "," + sFn.params[sJ]
            }
            sJ = sJ + 1
        }
        sOut = sOut + CHAR_NL + ("fn_params " + ("" + sI) + " " + sParams)
        sParams = ""
        sJ = 0
        while sJ < len(sFn.locals) {
            if sParams == "" {
                sParams = sFn.locals[sJ]
            } else {
                sParams = sParams + "," + sFn.locals[sJ]
            }
            sJ = sJ + 1
        }
        sOut = sOut + CHAR_NL + ("fn_locals " + ("" + sI) + " " + sParams)
        sJ = 0
        while sJ < len(sFn.ops) {
            sOut = sOut + CHAR_NL + ("fn_op " + ("" + sI) + " " + irOpLine(sFn.ops[sJ]))
            sJ = sJ + 1
        }
        sI = sI + 1
    }
    sOut = sOut + CHAR_NL + "code"
    appendOps(bc.ops)
    return sOut
}
