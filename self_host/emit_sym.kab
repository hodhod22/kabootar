import "self_host/ast_defs"

// P6b: trampoline hooks for emitExpr/emitStmt across shards (no circular imports).
// SH5: emitOp / arrUtil / SH9 helpers (was emit_hooks / emit_arr_util).
pub fn eCallExpr(E, node) {
    let prevH = E["_hook"]
    let prevN = E["_node"]
    E["_hook"] = 0
    E["_node"] = node
    E["tramp"](E)
    E["_hook"] = prevH
    E["_node"] = prevN
}

pub fn eCallStmt(E, node) {
    let prevH = E["_hook"]
    let prevN = E["_node"]
    E["_hook"] = 1
    E["_node"] = node
    E["tramp"](E)
    E["_hook"] = prevH
    E["_node"] = prevN
}

pub fn emitOp(E, op, arg) {
    let rec = { "op": op, "arg": arg }
    if E["eInFn"] == 1 {
        E["eFnOps"] = push(E["eFnOps"], rec)
        E["eFnOpsN"] = E["eFnOpsN"] + 1
    } else {
        E["eOps"] = push(E["eOps"], rec)
        E["eOpsN"] = E["eOpsN"] + 1
    }
}

pub fn emitOp2(E, op, arg, arg2) {
    let rec = { "op": op, "arg": arg, "arg2": arg2 }
    if E["eInFn"] == 1 {
        E["eFnOps"] = push(E["eFnOps"], rec)
        E["eFnOpsN"] = E["eFnOpsN"] + 1
    } else {
        E["eOps"] = push(E["eOps"], rec)
        E["eOpsN"] = E["eOpsN"] + 1
    }
}

pub fn opsLen(E) {
    if E["eInFn"] == 1 {
        return E["eFnOpsN"]
    }
    return E["eOpsN"]
}

pub fn patchJumpAt(E, idx) {
    patchJumpTo(E, idx, opsLen(E))
}

pub fn patchJumpTo(E, idx, target) {
    let rec = null
    if E["eInFn"] == 1 {
        rec = E["eFnOps"][idx]
    } else {
        rec = E["eOps"][idx]
    }
    let off = target - idx - 1
    let patched = { "op": rec.op, "arg": rec.arg }
    if rec.arg2 != undefined {
        patched = { "op": rec.op, "arg": rec.arg, "arg2": off }
    } else {
        patched = { "op": rec.op, "arg": off }
    }
    if E["eInFn"] == 1 {
        E["eFnOps"][idx] = patched
    } else {
        E["eOps"][idx] = patched
    }
}

pub fn arrUtil(E, mode, stack, arr) {
    if mode == "snap" {
        // Single O(n) clone via native slice (not O(n²) push loop).
        return slice(stack, 0)
    }
    E["eLenScratch"] = len(arr)
    if mode == "pushLenKey" {
        object_array_push(E, stack, E["eLenScratch"])
        return 0
    }
    return push(stack, E["eLenScratch"])
}

/// Typed i64 AccAdd-loop (SH9): host Cranelift can compile this helper.
pub fn accCount(n) {
    let i = 0
    let s = 0
    while i < n {
        s = s + 1
        i = i + 1
    }
    return s
}

/// Typed i64 index-loop (SH9): `s += i` so Cranelift sees AccAdd with the loop index.
pub fn idxSum(n) {
    let i = 0
    let s = 0
    while i < n {
        s = s + i
        i = i + 1
    }
    return s
}

/// SH9 IndexGet-loop: `s += xs[i]` — host JIT flattens i64 arrays then Cranelift-loads.
pub fn idxSumArr(xs) {
    let i = 0
    let n = len(xs)
    let s = 0
    while i < n {
        s = s + xs[i]
        i = i + 1
    }
    return s
}

/// SH9: LenLocal over a string (or any `len()` container) — JIT passes length, no IndexGet.
pub fn strCount(s) {
    let i = 0
    let n = len(s)
    let t = 0
    while i < n {
        t = t + 1
        i = i + 1
    }
    return t
}

/// SH9: `s[i]` is a 1-char string Value (VM semantics, not i64 codepoint).
pub fn strAt(s, i) {
    return s[i]
}

/// SH9: AccAdd of `s[i]` 1-char strings (same as VM `t = t + s[i]`).
pub fn strJoinIdx(s) {
    let i = 0
    let n = len(s)
    let t = ""
    while i < n {
        t = t + s[i]
        i = i + 1
    }
    return t
}

// SH5: const/sym maps (was emit_sym_index).
pub fn constKey(E, arg) {
    if arg == KAB_UNDEF_CONST {
        return "U"
    }
    if arg == null {
        return "N"
    }
    if arg == true {
        return "T"
    }
    if arg == false {
        return "F"
    }
    let t = typeof(arg)
    if t == "string" {
        return "S" + ("" + len(arg)) + ":" + arg
    }
    if t == "number" {
        return "D" + ("" + arg)
    }
    return "X" + ("" + arg)
}

pub fn symIndex(E, mode, arg) {
    if mode == "local" {
        let lHit = E["eLocalMap"][arg]
        if lHit != undefined {
            return lHit
        }
        E["eFnLocals"] = push(E["eFnLocals"], arg)
        let lIdx = E["eLocalN"]
        E["eLocalN"] = E["eLocalN"] + 1
        E["eLocalMap"][arg] = lIdx
        return lIdx
    }
    if mode == "global" {
        let gHit = E["eGlobalMap"][arg]
        if gHit != undefined {
            return gHit
        }
        E["eGlobals"] = push(E["eGlobals"], arg)
        let gIdx = E["eGlobalN"]
        E["eGlobalN"] = E["eGlobalN"] + 1
        E["eGlobalMap"][arg] = gIdx
        return gIdx
    }
    if mode == "const" {
        let cKey = constKey(E, arg)
        let cHit = E["eConstMap"][cKey]
        if cHit != undefined {
            return cHit
        }
        E["eConsts"] = push(E["eConsts"], arg)
        let cIdx = E["eConstN"]
        E["eConstN"] = E["eConstN"] + 1
        E["eConstMap"][cKey] = cIdx
        return cIdx
    }
    if mode == "constLit" {
        if arg["lit"] == LIT_UNDEF {
            return symIndex(E, "const", KAB_UNDEF_CONST)
        }
        return symIndex(E, "const", arg["value"])
    }
    if mode == "class" {
        E["eClassIdx"] = 0
        while E["eClassIdx"] < E["eClassesN"] {
            if E["eClasses"][E["eClassIdx"]]["sym"] == arg {
                return E["eClassIdx"]
            }
            E["eClassIdx"] = E["eClassIdx"] + 1
        }
        let miss = 0
        miss = miss - 1
        return miss
    }
    throw "symIndex: bad mode"
}

pub fn localSymIndex(E, sym) {
    if E["eInFn"] != 1 {
        return -1
    }
    let li = E["eLocalMap"][sym]
    if li != undefined {
        return li
    }
    return -1
}

pub fn resetLocalMap(E) {
    E["eLocalMap"] = {}
    E["eLocalN"] = 0
}

pub fn rebuildLocalMap(E) {
    E["eLocalMap"] = {}
    E["eLocalN"] = 0
    let i = 0
    let n = len(E["eFnLocals"])
    while i < n {
        E["eLocalMap"][E["eFnLocals"][i]] = i
        E["eLocalN"] = E["eLocalN"] + 1
        i = i + 1
    }
}

let eCallRet = 0

pub fn emitSym(E, store, sym) {
    // P6b: map lookup only — no len(E["eFnLocals"])/E["eGlobals"] LoadGlobal clone scans.
    if store == 0 {
        if E["eInFn"] == 0 {
            eCallRet = symIndex(E, "global", sym)
            E["eIdx"] = eCallRet
            emitOp(E, OP_LOAD_GLOBAL, eCallRet)
            return
        }
        let li = E["eLocalMap"][sym]
        if li != undefined {
            emitOp(E, OP_LOAD_LOCAL, li)
            return
        }
        let gi = E["eGlobalMap"][sym]
        if gi != undefined {
            emitOp(E, OP_LOAD_GLOBAL, gi)
            return
        }
        eCallRet = symIndex(E, "global", sym)
        E["eIdx"] = eCallRet
        emitOp(E, OP_LOAD_GLOBAL, eCallRet)
        return
    }
    if E["eInFn"] == 0 {
        eCallRet = symIndex(E, "global", sym)
        E["eIdx"] = eCallRet
        emitOp(E, OP_STORE_GLOBAL, eCallRet)
        return
    }
    let sli = E["eLocalMap"][sym]
    if sli != undefined {
        emitOp(E, OP_STORE_LOCAL, sli)
        return
    }
    let sgi = E["eGlobalMap"][sym]
    if sgi != undefined {
        emitOp(E, OP_STORE_GLOBAL, sgi)
        return
    }
    eCallRet = symIndex(E, "local", sym)
    E["eIdx"] = eCallRet
    emitOp(E, OP_STORE_LOCAL, eCallRet)
}

// SH5: fn scope / nested named fn / generic class meth (was emit_fn_scope).
pub fn emitFnScopeSave(E) {
    E["eSaveInFn"] = E["eInFn"]
    E["eSaveFnOps"] = arrUtil(E, "snap", E["eFnOps"])
    E["eSaveFnOpsN"] = E["eFnOpsN"]
    E["eSaveFnLocals"] = arrUtil(E, "snap", E["eFnLocals"])
    E["eSaveFnGlobals"] = arrUtil(E, "snap", E["eFnGlobals"])
}

pub fn emitFnScopeRestore(E) {
    E["eInFn"] = E["eSaveInFn"]
    E["eFnOps"] = E["eSaveFnOps"]
    E["eFnOpsN"] = E["eSaveFnOpsN"]
    E["eFnLocals"] = E["eSaveFnLocals"]
    rebuildLocalMap(E)
    E["eFnGlobals"] = E["eSaveFnGlobals"]
}

/// SH2: nested `fn name()` inside a function — save outer eFnOps (locals, not eSave*).
pub fn emitNestedNamedFn(E) {
    let aParams = E["eNode"]["params"]
    let aBody = E["eNode"]["body"]
    let aName = "" + E["eNode"]["sym"]
    let saveIn = E["eInFn"]
    let saveOps = arrUtil(E, "snap", E["eFnOps"])
    let saveFnOpsN = E["eFnOpsN"]
    let saveLocals = arrUtil(E, "snap", E["eFnLocals"])
    let saveGlobals = arrUtil(E, "snap", E["eFnGlobals"])
    let saveTry = arrUtil(E, "snap", E["eFnTryRegions"])
    E["eInFn"] = 1
    E["eFnOps"] = []
    E["eFnOpsN"] = 0
    E["eFnLocals"] = []
    resetLocalMap(E)
    E["eFnGlobals"] = []
    E["eFnTryRegions"] = []
    let api = 0
    while api < len(aParams) {
        symIndex(E, "local", aParams[api])
        api = api + 1
    }
    if aBody.kind == AST_BLOCK {
        eCallStmt(E, aBody)
    } else {
        eCallExpr(E, aBody)
        emitOp(E, OP_RETURN, 0)
    }
    let ai = len(E["eArrows"])
    let arrowSym = "__arrow_" + ai
    E["eArrows"] = push(E["eArrows"], {
        "sym": arrowSym,
        "params": arrUtil(E, "snap", aParams),
        "locals": arrUtil(E, "snap", E["eFnLocals"]),
        "ops": arrUtil(E, "snap", E["eFnOps"]),
        "tryRegions": arrUtil(E, "snap", E["eFnTryRegions"])
    })
    E["eInFn"] = saveIn
    E["eFnOps"] = saveOps
    E["eFnOpsN"] = saveFnOpsN
    E["eFnLocals"] = saveLocals
    rebuildLocalMap(E)
    E["eFnGlobals"] = saveGlobals
    E["eFnTryRegions"] = saveTry
    emitOp(E, OP_MAKE_ARROW, ai)
    emitSym(E, 1, aName)
}

pub fn emitInferVarBinding(E, varNode) {
    if varNode.kind != AST_VAR {
        return
    }
    E["eBi"] = 0
    while E["eBi"] < len(E["eBindingSyms"]) {
        if E["eBindingSyms"][E["eBi"]] == varNode["sym"] {
            E["eInferType"] = E["eBindingTypes"][E["eBi"]]
        }
        E["eBi"] = E["eBi"] + 1
    }
}

pub fn emitInferLitBasic(E, litNode) {
    E["eInferType"] = ""
    if litNode.kind != AST_LITERAL {
        return
    }
    if litNode.lit == LIT_NUMBER {
        E["eInferType"] = "Number"
        return
    }
    if litNode.lit == LIT_STRING {
        E["eInferType"] = "String"
        return
    }
}

pub fn emitInferLitFull(E, litNode) {
    emitInferLitBasic(E, litNode)
    if E["eInferType"] != "" {
        return
    }
    if litNode.kind != AST_LITERAL {
        return
    }
    if litNode.lit == LIT_BOOL {
        E["eInferType"] = "Bool"
        return
    }
    if litNode.lit == LIT_NULL {
        E["eInferType"] = "Null"
        return
    }
    if litNode.lit == LIT_UNDEF {
        E["eInferType"] = "Undefined"
        return
    }
}

let eMangleRet = 0

pub fn emitMangleWithTypeArgs(E, nameKey) {
    if len(E["eTypeArgs"]) == 0 {
        return
    }
    eMangleRet = E[nameKey] + "$"
    E[nameKey] = eMangleRet + E["eTypeArgs"][0]
    E["eResolveI"] = 1
    while E["eResolveI"] < len(E["eTypeArgs"]) {
        eMangleRet = E[nameKey] + "_"
        E[nameKey] = eMangleRet + E["eTypeArgs"][E["eResolveI"]]
        E["eResolveI"] = E["eResolveI"] + 1
    }
}

pub fn emitInferTypeArgsFrom(E, argsKey, errSym, litFull) {
    object_array_clear(E, "eTypeArgs")
    E["eResolveI"] = 0
    while E["eResolveI"] < len(E[argsKey]) {
        E["eInferArg"] = E[argsKey][E["eResolveI"]]
        E["eInferType"] = ""
        if litFull == 1 {
            emitInferLitFull(E, E["eInferArg"])
        } else {
            emitInferLitBasic(E, E["eInferArg"])
        }
        if E["eInferType"] == "" {
            emitInferVarBinding(E, E["eInferArg"])
        }
        if E["eInferType"] == "" {
            if errSym != "" {
                throw "Cannot infer type for " + errSym
            }
        } else {
            object_array_push(E, "eTypeArgs", E["eInferType"])
        }
        E["eResolveI"] = E["eResolveI"] + 1
    }
}

pub fn emitLoadExplicitTypeArgs(E) {
    E["eExplicit"] = E["eNode"]["typeArgs"]
    if E["eExplicit"] == undefined {
        E["eExplicit"] = []
    }
    if len(E["eExplicit"]) > 0 {
        E["eTypeArgs"] = arrUtil(E, "snap", E["eExplicit"])
    }
}

pub fn emitResolveTypeArgs(E, argsKey, errSym, litFull) {
    emitLoadExplicitTypeArgs(E)
    if len(E["eExplicit"]) == 0 {
        emitInferTypeArgsFrom(E, argsKey, errSym, litFull)
    }
}

pub fn emitResolveTypeArgsMem(E, argsKey, errSym, litFull) {
    emitLoadExplicitTypeArgs(E)
    if len(E["eExplicit"]) > 0 {
        return
    }
    if len(E["eMemTypeArgs"]) > 0 {
        E["eTypeArgs"] = arrUtil(E, "snap", E["eMemTypeArgs"])
        return
    }
    emitInferTypeArgsFrom(E, argsKey, errSym, litFull)
}

pub fn emitFnCompileBody(E) {
    E["eInFn"] = 1
    object_array_clear(E, "eFnOps")
    E["eFnOpsN"] = 0
    object_array_clear(E, "eFnGlobals")
    object_array_clear(E, "eFnLocals")
    resetLocalMap(E)
    E["eParamI"] = 0
    while E["eParamI"] < len(E["eParams"]) {
        E["eLoopSave"] = E["eParamI"]
        symIndex(E, "local", E["eParams"][E["eParamI"]])
        E["eParamI"] = E["eLoopSave"] + 1
    }
    eCallStmt(E, E["eFnBody"])
}

pub fn emitGenClassMeth(E) {
    E["eMethTypeParams"] = E["eMeth"]["typeParams"]
    if E["eMethTypeParams"] == undefined {
        E["eMethTypeParams"] = []
    }
    if len(E["eMethTypeParams"]) == 0 {
        E["eParams"] = E["eMeth"]["params"]
        E["eFnBody"] = E["eMeth"]["body"]
        emitFnCompileBody(E)
        object_array_push(E, "eClassMethods", {
            "sym": E["eMeth"]["sym"],
            "params": arrUtil(E, "snap", E["eParams"]),
            "locals": arrUtil(E, "snap", E["eFnLocals"]),
            "globals": arrUtil(E, "snap", E["eFnGlobals"]),
            "ops": arrUtil(E, "snap", E["eFnOps"])
        })
        E["eInFn"] = 0
        return 0
    }
    object_array_push(E, "eGenericMethodTemplates", {
        "classSym": E["eMangled"],
        "methodSym": E["eMeth"]["sym"],
        "typeParams": arrUtil(E, "snap", E["eMethTypeParams"]),
        "params": arrUtil(E, "snap", E["eMeth"]["params"]),
        "body": E["eMeth"]["body"]
    })
    return 0
}
