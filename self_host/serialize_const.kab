// P6b: const-line helper (skip-listed until ≤10s).
import "self_host/emit_defs"
import "self_host/serialize_esc"

pub fn serConstLine(idx, val) {
    let line = "const "
    line = line + ("" + idx)
    line = line + " "
    if val == KAB_UNDEF_CONST {
        line = line + "undefined"
        return line
    }
    if val == null {
        line = line + "null"
        return line
    }
    if val == true {
        line = line + "bool true"
        return line
    }
    if val == false {
        line = line + "bool false"
        return line
    }
    if typeof(val) == "string" {
        line = line + "string "
        line = line + serEscStr(val)
        return line
    }
    line = line + "number "
    line = line + ("" + val)
    return line
}
