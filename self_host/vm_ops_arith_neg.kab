// P6b: VM arith shard (neg) — mutates session S (arg AccAdd).
import "self_host/vm_s_push"
import "self_host/vm_s_pop"
import "self_host/vm_s_ip"

pub fn runOpArithNeg(S, name, arg, op, pool, globals, functions) {
    if name == "neg" {
        let v = vPopS(S)
        vPushS(S, 0 - v)
        vBumpIpS(S)
        return 1
    }
    return 0
}
