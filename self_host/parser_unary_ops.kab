import "self_host/lexer_defs"
import "self_host/ast_defs"
import "self_host/parser_hooks"
import "self_host/parser_util"

pub fn parseUnary_bang(sess) {
    if sess["pCur"].type != "!" {
        return 0
    }
    bump(sess)
    sess["pLeft"] = { "kind": AST_UNARY, "op": "!", "expr": pCallUnary(sess) }
    return 1
}

pub fn parseUnary_neg(sess) {
    if sess["pCur"].type != "-" {
        return 0
    }
    bump(sess)
    sess["pLeft"] = { "kind": AST_UNARY, "op": "-", "expr": pCallUnary(sess) }
    return 1
}

pub fn parseUnary_bitnot(sess) {
    if sess["pCur"].type != "~" {
        return 0
    }
    bump(sess)
    sess["pLeft"] = { "kind": AST_UNARY, "op": "~", "expr": pCallUnary(sess) }
    return 1
}
