// H6e: self-hosted .kbc serializer impl — thin facade (body in serialize_body.kab).
// import "self_host/serialize_impl" (used internally by self_host/serialize.kab)
//
// Re-export by alias (not a wrapping fn): a wrapping `fn serializeBcImpl` adds an
// extra host `call_value` frame, which breaks Kab VM reentrancy under
// KABOOTAR_VM=kab-only — see self_host/vm.kab header for the full explanation.
//
// serialize_body is a CI-fast re-export of serSerializeBc; AccAdd AST lives in
// skip-listed serialize_pure.kab + serialize_acc.kab (seed-loaded under kab-only).

import "self_host/serialize_body"

pub let serializeBcImpl = serializeBcImplCore
