// SH17 deepen: PIC in the real dispatch path. import "self_host/vm_run_jit"
// The `call` op site caches vClassifyCallee per callee shape in
// S["jitSites"][" "+ip] — V8 model: mono stub → PIC ≤4 → megamorphic
// fallback (jit_pic.kab). Per-call fields (recv/caps/arrowDef) live on the
// callee wrapper, not the cached record — hits refresh them. A callee
// carrying {vmJit:1, jitOps:[...]} (or jitSlots+jitSlotOps for polymorphic
// jit fns) executes its fused lowering via jitPicExecOk instead of a frame.
// Hot sites compile: jitPicPlan gates on hits/pct; a rec whose fn body is a
// fusible chain (vJitOpsOf) gets a jit callee; exec-domain rejects deopt to
// the cached frame record (c["fb"]) rather than failing the call.

import "self_host/vm_s_stack"
import "kab/jit/jit_pic"
import "kab/jit/jit_pic_exec"
import "kab/jit/jit_from_ops_any"
import "kab/jit/jit_from_ops_any_val"
import "kab/jit/jit_from_ops_bits"
import "kab/jit/jit_fuse_cmp"
import "kab/jit/jit_f64"
import "kab/jit/jit_bits"
import "kab/jit/jit_arith3"
import "kab/jit/jit_arith4"
import "kab/jit/jit_osr"

/// Per-ip site table key.
pub fn vJitSiteKeyS(S) {
    return " " + S["ip"]
}

pub fn vJitSitesS(S) {
    let sites = S["jitSites"]
    if typeof(sites) != "object" || sites == null {
        sites = {}
        S["jitSites"] = sites
    }
    return sites
}

/// Identity key for a jit callee: explicit jitId wins; else the namespaced
/// inst/host key (vmI or __kab_oid) — never aliases another identity space.
pub fn vJitObjKey(v) {
    let jid = vObjGet(v, "jitId")
    if jid != undefined {
        return "" + jid
    }
    let k = vInstKeyS(v)
    if k != undefined {
        return "k" + k
    }
    return "x" + vGcObjIdS(v)
}

/// Callee shape for the site PIC. Fn/arrow/jit identity keys are stable
/// across calls; receiver-bound wrappers shape on kind + receiver class so
/// different receivers of the same class hit one slot (recv is refreshed
/// per call — it is instance state, not shape state). Host callees get no
/// shape: their records would pin a per-call callee object.
pub fn vJitCalleeShape(callee) {
    if callee == null || callee == undefined {
        return undefined
    }
    if typeof(callee) != "object" {
        return undefined
    }
    let vmFn = vObjGet(callee, "vmFn")
    if vmFn != undefined {
        return "f" + vmFn
    }
    let vmArrow = vObjGet(callee, "vmArrow")
    if vmArrow != undefined {
        return "a" + vmArrow
    }
    if vObjGet(callee, "vmJit") == 1 {
        return "j" + vJitObjKey(callee)
    }
    let r = vObjGet(callee, "vmR")
    if r == undefined || r == null || typeof(r) != "object" {
        return undefined
    }
    let rc = vObjGet(r, "vmC")
    if rc == undefined {
        return undefined
    }
    let vmM = vObjGet(callee, "vmM")
    if vmM != undefined {
        return "m" + rc + "." + vmM
    }
    if vObjGet(callee, "vmGenNext") != undefined {
        return "gn" + rc
    }
    if vObjGet(callee, "vmGenReturn") != undefined {
        return "gr" + rc
    }
    if vObjGet(callee, "vmGenThrow") != undefined {
        return "gt" + rc
    }
    return undefined
}

/// Refresh per-call fields on a cached classify record — recv/caps/arrowDef
/// are instance state carried by the callee wrapper of THIS call.
pub fn vJitRefreshC(c, callee) {
    let k = c["kind"]
    if k == "method" || k == "hostMethod" || k == "genNext" || k == "genReturn" || k == "genThrow" {
        c["recv"] = vObjGet(callee, "vmR")
    }
    if k == "arrow" {
        c["caps"] = vObjGet(callee, "caps")
        c["arrowDef"] = vObjGet(callee, "arrowDef")
    }
    return c
}

/// Jit-native callee kind: {vmJit:1} objects bypass the frame path.
pub fn vJitClassifyJit(callee) {
    if callee == null || callee == undefined {
        return null
    }
    if typeof(callee) != "object" {
        return null
    }
    if vObjGet(callee, "vmJit") != 1 {
        return null
    }
    return { "kind": "jit", "callee": callee }
}

/// Hit-rate percent for jitPicPlan's icHitOk gate (>=90).
pub fn vJitSitePct(site) {
    if site["calls"] <= 0 {
        return 0
    }
    return (site["hits"] * 100) / site["calls"]
}

/// Operand for a template const-slot: `load_local i` takes call arg i (must
/// be the next param in order — locals[i] names params[i]), `const c` bakes
/// a number pool value as a jitBind immediate. Returns {"arg":1} for an arg
/// slot, {"bind": v} for a baked immediate, else null (stays cold).
fn vJitSlotOf(ops, oi, pool, params, locals, argIdx) {
    let op = ops[oi]
    let name = op["op"]
    if name == "load_local" {
        let i = op["arg"]
        if i == argIdx && i < len(params) && i < len(locals) && locals[i] == params[i] {
            return { "arg": 1 }
        }
        return null
    }
    if name == "const" {
        let ci = op["arg"]
        if ci >= 0 && ci < len(pool) {
            let v = pool[ci]
            if typeof(v) == "number" {
                return { "bind": v }
            }
        }
        return null
    }
    return null
}

/// Assemble the extraction record: descriptor + unbound-arg arity + a
/// jitBind array parallel to the descriptor's const positions (undefined =
/// consume call arg). bind is omitted when no immediate was baked.
fn vJitDescOf(desc, slots) {
    let bind = []
    let arity = 0
    let anyBind = false
    let i = 0
    while i < len(slots) {
        let bv = vObjGet(slots[i], "bind")
        if bv == undefined {
            arity = arity + 1
            bind = push(bind, undefined)
        } else {
            anyBind = true
            bind = push(bind, bv)
        }
        i = i + 1
    }
    let out = { "ops": desc, "arity": arity }
    if anyBind {
        out["bind"] = bind
    }
    return out
}

/// Extraction: fn body ops → {ops, arity, bind?} for a fused template.
/// Every template const-slot is one operand: a `load_local i` call arg
/// (params must bind to locals 0..N in order) or a `const c` baked immediate
/// — `return a < 5`, `a + 5`, `a ** 2`, `5 - a`, `a * 2 + 7` all fuse now,
/// where only all-load_local operands matched before. null = frame path.
///   U  unary   — operand; bit_not|neg; ret              → ["const",u,"ret"]
///   C  cmp     — operand; operand; cmp; [not;] ret      → [c,c,cmp,jcc,ret]
///   A2 arith   — operand; operand; op; ret (f64/bits/mod/pow) → [c,c,op,ret]
///   A3 arith3  — operand; operand; o1; operand; o2; ret → [c,c,c,o1,o2,ret]
///   A4 arith4  — operand×4 interleaved o1,o2,o3; ret    → [c,c,c,c,o1,o2,o3,ret]
///   A6 arith   — operand×6 interleaved add,sub,mul,div,mod → fixed L-desc
pub fn vJitOpsOfFn(f, pool) {
    if f == null || f == undefined || typeof(f) != "object" {
        return null
    }
    let ops = f["ops"]
    let params = f["params"]
    let locals = f["locals"]
    if typeof(ops) != "array" || typeof(params) != "array" || typeof(locals) != "array" {
        return null
    }
    if typeof(pool) != "array" {
        pool = []
    }
    let nOps = len(ops)
    // U chain: `return -a` / `return ~a` / `return -5` — unary template
    // (83 bit_not / 84 neg); a bound operand gives arity 0.
    if nOps == 3 {
        let s0 = vJitSlotOf(ops, 0, pool, params, locals, 0)
        if s0 == null {
            return null
        }
        let um = jitBitsMagic(ops[1]["op"])
        if um == 0 || jitBitsUnary(um) == false {
            return null
        }
        let rop2 = ops[2]["op"]
        if rop2 != "return" && rop2 != "ret" {
            return null
        }
        return vJitDescOf(["const", ops[1]["op"], "ret"], [s0])
    }
    // C/A2 chains: operand; operand; X; [not;] ret.
    if nOps == 4 || nOps == 5 {
        let s0 = vJitSlotOf(ops, 0, pool, params, locals, 0)
        if s0 == null {
            return null
        }
        let ai = 0
        if vObjGet(s0, "arg") != undefined {
            ai = 1
        }
        let s1 = vJitSlotOf(ops, 1, pool, params, locals, ai)
        if s1 == null {
            return null
        }
        let cm = ops[2]["op"]
        if jitCmpMagic(cm) != 0 {
            let jcc = "jump_if_true"
            let ri = 3
            if nOps == 5 {
                if ops[3]["op"] != "not" {
                    return null
                }
                jcc = "jump_if_false"
                ri = 4
            }
            let rop = ops[ri]["op"]
            if rop != "return" && rop != "ret" {
                return null
            }
            return vJitDescOf(["const", "const", cm, jcc, "ret"], [s0, s1])
        }
        if nOps != 4 {
            return null
        }
        // A2: `return a OP b` — f64 template for add/sub/mul/div (exact in
        // the 1..=64 domain), bits for bit ops, dedicated mod/pow chains.
        let emit = undefined
        if jitF64Magic("f" + cm) != 0 {
            emit = "f" + cm
        }
        if emit == undefined {
            let bm = jitBitsMagic(cm)
            if bm != 0 && jitBitsUnary(bm) == false {
                emit = cm
            }
        }
        if emit == undefined && (cm == "mod" || cm == "pow") {
            emit = cm
        }
        if emit == undefined {
            return null
        }
        let rop4 = ops[3]["op"]
        if rop4 != "return" && rop4 != "ret" {
            return null
        }
        return vJitDescOf(["const", "const", emit, "ret"], [s0, s1])
    }
    // A3 chain: `return a OP1 b OP2 c` left-assoc (6 ops) — kind 6.
    if nOps == 6 {
        let s0 = vJitSlotOf(ops, 0, pool, params, locals, 0)
        if s0 == null {
            return null
        }
        let ai = 0
        if vObjGet(s0, "arg") != undefined {
            ai = 1
        }
        let s1 = vJitSlotOf(ops, 1, pool, params, locals, ai)
        if s1 == null {
            return null
        }
        if vObjGet(s1, "arg") != undefined {
            ai = ai + 1
        }
        let s2 = vJitSlotOf(ops, 3, pool, params, locals, ai)
        if s2 == null {
            return null
        }
        let o1 = ops[2]["op"]
        let o2 = ops[4]["op"]
        if jitArith3Code(o1) == 0 || jitArith3Code(o2) == 0 {
            return null
        }
        let rop3 = ops[5]["op"]
        if rop3 != "return" && rop3 != "ret" {
            return null
        }
        return vJitDescOf(["const", "const", "const", o1, o2, "ret"], [s0, s1, s2])
    }
    // A4 chain: `return a OP1 b OP2 c OP3 d` left-assoc (8 ops) — kind 7.
    if nOps == 8 {
        let sls = []
        let ai = 0
        let posL = [0, 1, 3, 5]
        let li = 0
        while li < 4 {
            let sl = vJitSlotOf(ops, posL[li], pool, params, locals, ai)
            if sl == null {
                return null
            }
            if vObjGet(sl, "arg") != undefined {
                ai = ai + 1
            }
            sls = push(sls, sl)
            li = li + 1
        }
        if jitArith4Code(ops[2]["op"]) == 0 || jitArith4Code(ops[4]["op"]) == 0 || jitArith4Code(ops[6]["op"]) == 0 {
            return null
        }
        let rop4 = ops[7]["op"]
        if rop4 != "return" && rop4 != "ret" {
            return null
        }
        return vJitDescOf(["const", "const", "const", "const", ops[2]["op"], ops[4]["op"], ops[6]["op"], "ret"], sls)
    }
    // A6 chain: the 6-operand L-template — any mix of args and binds.
    if nOps == 12 {
        let sls = []
        let ai = 0
        let posL = [0, 1, 3, 5, 7, 9]
        let li = 0
        while li < 6 {
            let sl = vJitSlotOf(ops, posL[li], pool, params, locals, ai)
            if sl == null {
                return null
            }
            if vObjGet(sl, "arg") != undefined {
                ai = ai + 1
            }
            sls = push(sls, sl)
            li = li + 1
        }
        let posA = [2, 4, 6, 8, 10]
        let names = ["add", "sub", "mul", "div", "mod"]
        let ai2 = 0
        while ai2 < 5 {
            if ops[posA[ai2]]["op"] != names[ai2] {
                return null
            }
            ai2 = ai2 + 1
        }
        let rop = ops[11]["op"]
        if rop != "return" && rop != "ret" {
            return null
        }
        return vJitDescOf(["const", "add", "sub", "mul", "div", "mod", "ret"], sls)
    }
    return null
}

/// Numeric-arg requirement of a site-compiled callee — the fused template
/// immediates are typed per shape (arith 6, cmp/f64 2, SIMD 4). 0 = cold.
pub fn vJitOpsArity(jitOps) {
    let kind = jitFuseKind(jitOps)
    if kind == 1 {
        return 6
    }
    if kind == 2 {
        return 2
    }
    if kind == 3 {
        return 2
    }
    if kind == 4 {
        return 4
    }
    if kind == 5 {
        if len(jitOps) == 3 {
            return 1
        }
        return 2
    }
    if kind == 6 {
        return 3
    }
    if kind == 7 {
        return 4
    }
    if kind == 8 {
        return 2
    }
    if kind == 9 {
        return 2
    }
    return 0
}

/// Resolve a cached classify rec's fn ops to an extraction {ops,arity,bind?}
/// — fn recs read functions[idx], arrows read their arrowDef (or
/// S["arrows"][idx]). Method/host/generator kinds return null: their bodies
/// are not fusible. S["bcPool"] feeds const-operand binds.
pub fn vJitOpsOfRec(S, rec, functions) {
    let pool = S["bcPool"]
    let k = rec["kind"]
    if k == "fn" {
        if typeof(functions) == "array" {
            return vJitOpsOfFn(functions[rec["idx"]], pool)
        }
        return null
    }
    if k == "arrow" {
        let ad = rec["arrowDef"]
        if ad == undefined {
            let arrs = S["arrows"]
            if typeof(arrs) == "array" {
                ad = arrs[rec["idx"]]
            }
        }
        return vJitOpsOfFn(ad, pool)
    }
    return null
}

/// Compile trigger: on a PIC hit, when jitPicPlan says the site compiles
/// (1 mono / 2 PIC), extract the rec's ops once. A fusible chain installs a
/// jit callee on the rec — subsequent hits return kind jit with fb = the
/// frame record for deopt on exec-domain rejects.
pub fn vJitMaybeCompileS(S, site, key, rec, i, functions) {
    if rec["jitChecked"] == 1 {
        return null
    }
    let plan = jitPicPlan(len(site["slots"]), vJitSitePct(site), site["hits"])
    if plan != 1 && plan != 2 {
        return null
    }
    rec["jitChecked"] = 1
    let d = vJitOpsOfRec(S, rec, functions)
    if d == null {
        return null
    }
    rec["jitCallee"] = { "vmJit": 1, "jitId": "c" + key + "." + i, "jitOps": d["ops"], "jitArity": d["arity"] }
    // jitBind: baked immediates parallel to the descriptor's const slots —
    // undefined entries consume call args in order (vJitExecOk merges).
    let bind = vObjGet(d, "bind")
    if typeof(bind) == "array" {
        rec["jitCallee"]["jitBind"] = bind
    }
    let comp = S["jitCompiled"]
    if typeof(comp) != "number" {
        comp = 0
    }
    S["jitCompiled"] = comp + 1
    return rec["jitCallee"]
}

/// PIC-cached classify: `classify` is the caller's classify fn (passed in —
/// vm_run_call owns vClassifyCallee; a direct import would cycle). Shape hit
/// returns the cached record (with per-call fields refreshed); a miss
/// classifies and learns the shape into the site PIC — a full PIC goes
/// megamorphic and stops caching. Site counters (calls/hits/misses) feed
/// jitPicPlan compile decisions; a hot fusible rec installs a jit callee.
pub fn vJitClassifyS(S, callee, classify, functions) {
    let jc = vJitClassifyJit(callee)
    if jc != null {
        return jc
    }
    let shape = vJitCalleeShape(callee)
    if shape == undefined {
        return classify(callee)
    }
    let sites = vJitSitesS(S)
    let key = vJitSiteKeyS(S)
    let site = sites[key]
    if typeof(site) != "object" || site == null {
        site = { "slots": [], "recs": [], "calls": 0, "hits": 0, "misses": 0, "mega": false }
        sites[key] = site
    }
    site["calls"] = site["calls"] + 1
    if site["mega"] == true {
        return classify(callee)
    }
    let i = jitPicFind(site["slots"], shape)
    if i >= 0 && i < len(site["recs"]) {
        site["hits"] = site["hits"] + 1
        let rec = site["recs"][i]
        let jitCallee = rec["jitCallee"]
        if jitCallee == undefined {
            jitCallee = vJitMaybeCompileS(S, site, key, rec, i, functions)
        }
        if jitCallee != null && jitCallee != undefined {
            return { "kind": "jit", "callee": jitCallee, "fb": vJitRefreshC(rec, callee) }
        }
        return vJitRefreshC(rec, callee)
    }
    let c = classify(callee)
    site["misses"] = site["misses"] + 1
    if jitPicMega(site["slots"], shape) {
        site["mega"] = true
    } else {
        site["slots"] = jitPicLearn(site["slots"], shape)
        site["recs"] = push(site["recs"], c)
    }
    return c
}

/// Exec a jit callee through the fused lowering. jitOps is a single
/// specialized op list; jitSlots+jitSlotOps is a polymorphic jit fn — the
/// arg0 class shape picks the slot via jitPicExecOk. Numeric args feed the
/// template immediates (n,k,s,m,d,r). {ok:0} means the domain rejected the
/// call — the caller falls back per its contract (deopt to c["fb"] when set).
/// jitArity marks a site-compiled callee: it needs exactly-typed numeric args
/// (an object/non-number arg would feed the template garbage), so a typed
/// callee rejects before exec when args are missing or non-numeric.
pub fn vJitExecOk(S, c, ordered) {
    let callee = c["callee"]
    let arity = vObjGet(callee, "jitArity")
    if arity != undefined {
        if len(ordered) < arity {
            return { "ok": 0 }
        }
        let ti = 0
        while ti < arity {
            if typeof(ordered[ti]) != "number" {
                return { "ok": 0 }
            }
            ti = ti + 1
        }
    }
    let n = 0
    let k = 0
    let s = 0
    let m = 0
    let d = 0
    let r = 0
    if len(ordered) > 0 { n = ordered[0] }
    if len(ordered) > 1 { k = ordered[1] }
    if len(ordered) > 2 { s = ordered[2] }
    if len(ordered) > 3 { m = ordered[3] }
    if len(ordered) > 4 { d = ordered[4] }
    if len(ordered) > 5 { r = ordered[5] }
    let slotOps = vObjGet(callee, "jitSlotOps")
    if typeof(slotOps) == "array" {
        let slots = vObjGet(callee, "jitSlots")
        if typeof(slots) != "array" {
            return { "ok": 0 }
        }
        let shape = "t" + typeof(n)
        if n != null && n != undefined && typeof(n) == "object" {
            let nc = vObjGet(n, "vmC")
            if nc != undefined {
                shape = "c" + nc
            }
        }
        if jitPicExecOk(slotOps, slots, shape, n, k, s, m, d, r) == false {
            return { "ok": 0 }
        }
        let outSlot = jitPicFind(slots, shape)
        let e0 = S["jitExecs"]
        if typeof(e0) != "number" {
            e0 = 0
        }
        S["jitExecs"] = e0 + 1
        return { "ok": 1, "out": jitFromOpsAnyVal(slotOps[outSlot], n, k, s, m, d, r) }
    }
    let ops = vObjGet(callee, "jitOps")
    if typeof(ops) != "array" {
        return { "ok": 0 }
    }
    // jitBind: const slots marked undefined consume call args in order;
    // defined slots are baked immediates — `return a < 5` execs as a<5
    // without a second arg. Absent = all slots consume args (old path).
    let bind = vObjGet(callee, "jitBind")
    if typeof(bind) == "array" {
        let imm = []
        let ai = 0
        let oi = 0
        while oi < len(ops) {
            if ops[oi] == "const" {
                let bv = undefined
                if len(imm) < len(bind) {
                    bv = bind[len(imm)]
                }
                if bv == undefined {
                    if ai >= len(ordered) {
                        return { "ok": 0 }
                    }
                    bv = ordered[ai]
                    ai = ai + 1
                }
                imm = push(imm, bv)
            }
            oi = oi + 1
        }
        n = 0
        k = 0
        s = 0
        m = 0
        d = 0
        r = 0
        if len(imm) > 0 { n = imm[0] }
        if len(imm) > 1 { k = imm[1] }
        if len(imm) > 2 { s = imm[2] }
        if len(imm) > 3 { m = imm[3] }
        if len(imm) > 4 { d = imm[4] }
        if len(imm) > 5 { r = imm[5] }
    }
    if jitFromOpsAnyExecOk(ops, n, k, s, m, d, r) == false {
        return { "ok": 0 }
    }
    let e1 = S["jitExecs"]
    if typeof(e1) != "number" {
        e1 = 0
    }
    S["jitExecs"] = e1 + 1
    return { "ok": 1, "out": jitFromOpsAnyVal(ops, n, k, s, m, d, r) }
}

// --- vm_jit_osr ---
/// Back-edge landing on a loop header (ip moved backwards): count the hit in
/// S["jitLoopHits"][" "+ip]; once jitOsrOk says the header is hot, mark it
/// armed in S["jitOsrArmIps"] so vJitOsrStepS may run the fused header.
pub fn vJitBackEdgeS(S, ip) {
    let be = S["jitBackEdges"]
    if typeof(be) != "number" {
        be = 0
    }
    S["jitBackEdges"] = be + 1
    let hits = S["jitLoopHits"]
    if hits == undefined {
        hits = {}
        S["jitLoopHits"] = hits
    }
    let key = " " + ip
    let h = vObjGet(hits, key)
    if h == undefined {
        h = 0
    }
    h = h + 1
    hits[key] = h
    if jitOsrOk(ip, h) == true {
        // Observable armed map — written once per header (cheap); tests and
        // diagnostics read S["jitOsrArmed"][" "+ip].
        let armed = S["jitOsrArmed"]
        if armed == undefined {
            armed = {}
            S["jitOsrArmed"] = armed
        }
        armed[key] = true
        // Hot-path mirror: a number array vJitOsrStepS scans per op —
        // armed sets are tiny (a few loop headers), so a linear scan beats
        // a " "+ip concat + map hash on EVERY op once anything is armed.
        let armIps = S["jitOsrArmIps"]
        if armIps == undefined {
            armIps = []
        }
        let ai = 0
        let dup = false
        while ai < len(armIps) {
            if armIps[ai] == ip {
                dup = true
                break
            }
            ai = ai + 1
        }
        if dup == false {
            armIps = push(armIps, ip)
            S["jitOsrArmIps"] = armIps
        }
    }
}

/// Operand value for a fused header operand op; only load_local/const
/// resolve — anything else returns undefined and the header stays
/// interpreted.
fn vOsrOperandVal(S, op, pool) {
    let name = op["op"]
    if name == "load_local" {
        let i = op["arg"]
        if i >= 0 && i < len(S["locals"]) {
            return S["locals"][i]
        }
        return undefined
    }
    if name == "const" {
        let i = op["arg"]
        if i >= 0 && i < len(pool) {
            return pool[i]
        }
        return undefined
    }
    // `while i < len(a)` headers — the dominant DAG loop shape (59 of 248
    // seed loops vs 4 for `const` bounds): len_local resolves to the local's
    // element count; anything else stays interpreted.
    if name == "len_local" {
        let i = op["arg"]
        if i >= 0 && i < len(S["locals"]) {
            let v = S["locals"][i]
            if typeof(v) == "array" || typeof(v) == "string" {
                return len(v)
            }
        }
        return undefined
    }
    // Global operands — `while i < gN` / `while gI < gN` / `while i < len(gArr)`:
    // module-level lets are globals (~114+ DAG headers compare a local or
    // global against a global number, e.g. `pI < pToksLen` in the parser).
    if name == "load_global" {
        let i = op["arg"]
        if i >= 0 && i < len(S["globals"]) {
            return S["globals"][i]
        }
        return undefined
    }
    if name == "len_global" {
        let i = op["arg"]
        if i >= 0 && i < len(S["globals"]) {
            let v = S["globals"][i]
            if typeof(v) == "array" || typeof(v) == "string" {
                return len(v)
            }
        }
        return undefined
    }
    return undefined
}

/// Counted loop the compiler emits for `while slot < bound { x = x + k }`.
/// The whole trip count runs as arithmetic on the locals/globals, then ip
/// moves to the exit. No mmap and no per-iteration dispatch. Returns 1 when
/// applied. Counter is `load_local`/`load_global`; bound resolves from
/// `const`, a numeric `load_local`/`load_global`, or `len_local`/`len_global`
/// of an array/string — `while i < n`, `while i < len(a)` and the global
/// forms dominate the DAG seed loops. The bound must stay invariant across
/// trips: its source slot may not be an acc_add target in the same space.
pub fn vJitCountLoopS(S, ops, pool) {
    let ip = S["ip"]
    if ip + 4 >= len(ops) {
        return 0
    }
    let h0 = ops[ip]
    let h1 = ops[ip + 1]
    let h2 = ops[ip + 2]
    let h3 = ops[ip + 3]
    let bop = h1["op"]
    let cSpace = ""
    if h0["op"] == "load_local" {
        cSpace = "locals"
    }
    if h0["op"] == "load_global" {
        cSpace = "globals"
    }
    let bSpace = ""
    if bop == "load_local" || bop == "len_local" {
        bSpace = "locals"
    }
    if bop == "load_global" || bop == "len_global" {
        bSpace = "globals"
    }
    if cSpace == "" || (bop != "const" && bSpace == "") || h2["op"] != "lt" || h3["op"] != "jump_if_false" {
        return 0
    }
    let counter = h0["arg"]
    let boundSlot = -1
    let bound = undefined
    if bop == "const" {
        let bi = h1["arg"]
        if bi < 0 || bi >= len(pool) {
            return 0
        }
        bound = pool[bi]
    }
    if bSpace != "" {
        boundSlot = h1["arg"]
        if boundSlot >= 0 && boundSlot < len(S[bSpace]) {
            let bv = S[bSpace][boundSlot]
            if bop == "len_local" || bop == "len_global" {
                if typeof(bv) == "array" || typeof(bv) == "string" {
                    bound = len(bv)
                }
            } else {
                bound = bv
            }
        }
    }
    if typeof(bound) != "number" {
        return 0
    }
    if counter < 0 || counter >= len(S[cSpace]) {
        return 0
    }
    let cur = S[cSpace][counter]
    if typeof(cur) != "number" || cur >= bound {
        return 0
    }
    let cursor = ip + 4
    let spaces = []
    let slots = []
    let steps = []
    let counterStep = 0
    while cursor + 1 < len(ops) {
        let constOp = ops[cursor]
        let addOp = ops[cursor + 1]
        let aSpace = ""
        if addOp["op"] == "acc_add_local" {
            aSpace = "locals"
        }
        if addOp["op"] == "acc_add_global" {
            aSpace = "globals"
        }
        if constOp["op"] != "const" || aSpace == "" {
            break
        }
        let ci = constOp["arg"]
        if ci < 0 || ci >= len(pool) {
            return 0
        }
        let step = pool[ci]
        if typeof(step) != "number" || step == 0 {
            return 0
        }
        let slot = addOp["arg"]
        if slot < 0 || slot >= len(S[aSpace]) {
            return 0
        }
        if typeof(S[aSpace][slot]) != "number" {
            return 0
        }
        // Bound invariance: a load/len bound must not drift — an acc_add
        // target in the SAME space at the bound's source slot would change
        // it mid-loop, so the closed form no longer matches interpretation.
        if aSpace == bSpace && slot == boundSlot {
            return 0
        }
        if aSpace == cSpace && slot == counter {
            counterStep = step
        }
        spaces = push(spaces, aSpace)
        slots = push(slots, slot)
        steps = push(steps, step)
        cursor = cursor + 2
    }
    if counterStep <= 0 || len(slots) == 0 || cursor >= len(ops) {
        return 0
    }
    let jumpOp = ops[cursor]
    if jumpOp["op"] != "jump" || cursor + 1 + jumpOp["arg"] != ip {
        return 0
    }
    let span = bound - cur
    if span % counterStep != 0 {
        return 0
    }
    let trips = span / counterStep
    if trips <= 0 || trips > 1000000 {
        return 0
    }
    let i = 0
    while i < len(slots) {
        let slot = slots[i]
        S[spaces[i]][slot] = S[spaces[i]][slot] + steps[i] * trips
        i = i + 1
    }
    S["ip"] = ip + 4 + h3["arg"]
    let cl = S["jitCountLoops"]
    if cl == undefined {
        cl = 0
    }
    S["jitCountLoops"] = cl + 1
    return 1
}

/// Armed fall-through body the compiler actually emits for `x = x + k`:
/// one or more `const k; acc_add_local i` groups, then `jump` back to this
/// header. Returns 1 when that body ran.
fn vJitOsrAccBodyS(S, ops, pool, ip, bodyIp) {
    let cursor = bodyIp
    let slots = []
    let steps = []
    while cursor + 1 < len(ops) {
        let constOp = ops[cursor]
        let addOp = ops[cursor + 1]
        if constOp["op"] != "const" || addOp["op"] != "acc_add_local" {
            break
        }
        let ci = constOp["arg"]
        if ci < 0 || ci >= len(pool) {
            return 0
        }
        let step = pool[ci]
        if typeof(step) != "number" {
            return 0
        }
        slots = push(slots, addOp["arg"])
        steps = push(steps, step)
        cursor = cursor + 2
    }
    if len(slots) == 0 || cursor >= len(ops) {
        return 0
    }
    let jumpOp = ops[cursor]
    if jumpOp["op"] != "jump" || cursor + 1 + jumpOp["arg"] != ip {
        return 0
    }
    let i = 0
    while i < len(slots) {
        let slot = slots[i]
        if slot < 0 || slot >= len(S["locals"]) {
            return 0
        }
        if typeof(S["locals"][slot]) != "number" {
            return 0
        }
        i = i + 1
    }
    i = 0
    while i < len(slots) {
        let slot = slots[i]
        S["locals"][slot] = S["locals"][slot] + steps[i]
        i = i + 1
    }
    S["ip"] = ip
    vJitBackEdgeS(S, ip)
    return 1
}

/// Armed fall-through body: one or more `load_local i; const k; add;
/// store_local i` groups, then `jump` back to this header. One step
/// replaces the whole body. The back-edge is counted here because the
/// jump opcode itself does not run. Returns 1 when the body ran; 0 leaves
/// the caller to interpret from ip+4.
fn vJitOsrIncBodyS(S, ops, pool, ip, bodyIp) {
    let cursor = bodyIp
    let slots = []
    let steps = []
    while cursor + 3 < len(ops) {
        let loadOp = ops[cursor]
        let constOp = ops[cursor + 1]
        let addOp = ops[cursor + 2]
        let storeOp = ops[cursor + 3]
        if loadOp["op"] != "load_local" || constOp["op"] != "const" || addOp["op"] != "add" || storeOp["op"] != "store_local" {
            break
        }
        if loadOp["arg"] != storeOp["arg"] {
            return 0
        }
        let ci = constOp["arg"]
        if ci < 0 || ci >= len(pool) {
            return 0
        }
        let step = pool[ci]
        if typeof(step) != "number" {
            return 0
        }
        slots = push(slots, loadOp["arg"])
        steps = push(steps, step)
        cursor = cursor + 4
    }
    if len(slots) == 0 || cursor >= len(ops) {
        return 0
    }
    let jumpOp = ops[cursor]
    if jumpOp["op"] != "jump" || cursor + 1 + jumpOp["arg"] != ip {
        return 0
    }
    let i = 0
    while i < len(slots) {
        let slot = slots[i]
        if slot < 0 || slot >= len(S["locals"]) {
            return 0
        }
        if typeof(S["locals"][slot]) != "number" {
            return 0
        }
        i = i + 1
    }
    i = 0
    while i < len(slots) {
        let slot = slots[i]
        S["locals"][slot] = S["locals"][slot] + steps[i]
        i = i + 1
    }
    S["ip"] = ip
    vJitBackEdgeS(S, ip)
    let be = S["jitOsrIncExecs"]
    if be == undefined {
        be = 0
    }
    S["jitOsrIncExecs"] = be + 1
    return 1
}

/// OSR step: an armed loop header of shape [operand, operand, cmp,
/// jump_if_*] executes its branch decision through the fused cmp template —
/// operand values are baked as the const,const immediates of a kind-2 chain
/// (jump_if_false folds the negated predicate, so a fused 1 means "take").
/// Returns 0 when unarmed/shape-mismatched/domain-rejected → interpreted.
/// Count one armed-header rejection — the header was hot enough to arm but
/// its shape/operands fell outside the fused form, so the step interprets.
/// When S["jitOsrMissTrace"] is set (diagnostics only — key concat is not
/// free on a hot miss path), the 4-op header shape feeds a histogram map.
fn vJitOsrMissS(S, key) {
    let ms = S["jitOsrMisses"]
    if typeof(ms) != "number" {
        ms = 0
    }
    S["jitOsrMisses"] = ms + 1
    if S["jitOsrMissTrace"] == true {
        let shapes = S["jitOsrMissShapes"]
        if shapes == undefined {
            shapes = {}
            S["jitOsrMissShapes"] = shapes
        }
        let c = vObjGet(shapes, key)
        if typeof(c) != "number" {
            c = 0
        }
        shapes[key] = c + 1
    }
    return 0
}

/// Compound-expression header eval — armed headers can start with a pure
/// stack expression (`while xs[i] + k < n` emits pushes/arith before the
/// cmp), and the jump target can even land mid-expression (the first ops
/// then consume values pushed before the header). Simulate pure ops on a
/// small overlay stack: pops read the real S["stack"] top-down when the
/// overlay is empty. `sim` = {st: leftover pushes, base: stack depth at
/// entry, used: pre-header values consumed}. Impure ops (call/store/jump),
/// non-number arith operands, out-of-range index reads and budget
/// exhaustion keep the header interpreted. Returns {a,b,cmp,jcc,jip,jarg,
/// used,tail} or undefined — the caller syncs the real stack before fusing.
fn vJitOsrSimHas(S, sim) {
    if len(sim["st"]) > 0 {
        return true
    }
    return sim["used"] < sim["base"]
}

fn vJitOsrSimPop(S, sim) {
    if len(sim["st"]) > 0 {
        let v = sim["st"][len(sim["st"]) - 1]
        sim["st"] = pop(sim["st"])
        return v
    }
    let v = S["stack"][sim["base"] - 1 - sim["used"]]
    sim["used"] = sim["used"] + 1
    return v
}

fn vJitOsrHeaderVals(S, ops, pool, ip) {
    let sim = { "st": [], "base": len(S["stack"]), "used": 0 }
    let j = ip
    let budget = 16
    while j < len(ops) && budget > 0 {
        budget = budget - 1
        let op = ops[j]
        let name = op["op"]
        if name == "eq" || name == "ne" || name == "lt" || name == "le" || name == "gt" || name == "ge" {
            if j + 1 >= len(ops) {
                return { "failOp": name, "failIp": j }
            }
            let jn = ops[j + 1]["op"]
            if jn != "jump_if_false" && jn != "jump_if_true" {
                return { "failOp": name, "failIp": j }
            }
            if vJitOsrSimHas(S, sim) == false {
                return { "failOp": name, "failIp": j }
            }
            let b = vJitOsrSimPop(S, sim)
            if vJitOsrSimHas(S, sim) == false {
                return { "failOp": name, "failIp": j }
            }
            let a = vJitOsrSimPop(S, sim)
            if typeof(a) != "number" || typeof(b) != "number" {
                return { "failOp": name, "failIp": j }
            }
            return { "a": a, "b": b, "cmp": name, "jcc": jn, "jip": j + 1, "jarg": ops[j + 1]["arg"], "used": sim["used"], "tail": sim["st"] }
        }
        let arg = op["arg"]
        let bad = false
        if name == "const" {
            if arg < 0 || arg >= len(pool) {
                return { "failOp": name, "failIp": j }
            }
            sim["st"] = push(sim["st"], pool[arg])
        } else {
            if name == "load_local" || name == "load_global" {
                let arr = S["locals"]
                if name == "load_global" {
                    arr = S["globals"]
                }
                if arg < 0 || arg >= len(arr) {
                    return { "failOp": name, "failIp": j }
                }
                sim["st"] = push(sim["st"], arr[arg])
            } else {
                if name == "len_local" || name == "len_global" {
                    let arr = S["locals"]
                    if name == "len_global" {
                        arr = S["globals"]
                    }
                    if arg < 0 || arg >= len(arr) {
                        return { "failOp": name, "failIp": j }
                    }
                    let v = arr[arg]
                    if typeof(v) != "array" && typeof(v) != "string" {
                        return { "failOp": name, "failIp": j }
                    }
                    sim["st"] = push(sim["st"], len(v))
                } else {
                    if name == "index_get_local" || name == "index_get_global" {
                        if vJitOsrSimHas(S, sim) == false {
                            return { "failOp": name, "failIp": j }
                        }
                        let idx = vJitOsrSimPop(S, sim)
                        let arr = undefined
                        if name == "index_get_local" {
                            if arg < 0 || arg >= len(S["locals"]) {
                                return { "failOp": name, "failIp": j }
                            }
                            arr = S["locals"][arg]
                        } else {
                            arr = vResolveGlobalS(S, S["globalNames"], arg)
                        }
                        if typeof(arr) != "array" || typeof(idx) != "number" || idx < 0 || idx >= len(arr) {
                            return { "failOp": name, "failIp": j }
                        }
                        sim["st"] = push(sim["st"], arr[idx])
                    } else {
                        if name == "add" || name == "sub" || name == "mul" || name == "bit_and" || name == "bit_or" || name == "bit_xor" || name == "shl" || name == "shr" || name == "ushr" {
                            if vJitOsrSimHas(S, sim) == false {
                                return { "failOp": name, "failIp": j }
                            }
                            let rb = vJitOsrSimPop(S, sim)
                            if vJitOsrSimHas(S, sim) == false {
                                return { "failOp": name, "failIp": j }
                            }
                            let ra = vJitOsrSimPop(S, sim)
                            if typeof(ra) != "number" || typeof(rb) != "number" {
                                return { "failOp": name, "failIp": j }
                            }
                            if name == "add" {
                                sim["st"] = push(sim["st"], ra + rb)
                            } else {
                                if name == "sub" {
                                    sim["st"] = push(sim["st"], ra - rb)
                                } else {
                                    if name == "mul" {
                                        sim["st"] = push(sim["st"], ra * rb)
                                    } else {
                                        if name == "bit_and" {
                                            sim["st"] = push(sim["st"], ra & rb)
                                        } else {
                                            if name == "bit_or" {
                                                sim["st"] = push(sim["st"], ra | rb)
                                            } else {
                                                if name == "bit_xor" {
                                                    sim["st"] = push(sim["st"], ra ^ rb)
                                                } else {
                                                    if name == "shl" {
                                                        sim["st"] = push(sim["st"], ra << rb)
                                                    } else {
                                                        if name == "shr" {
                                                            sim["st"] = push(sim["st"], ra >> rb)
                                                        } else {
                                                            sim["st"] = push(sim["st"], ra >>> rb)
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        } else {
                            if name == "neg" {
                                if vJitOsrSimHas(S, sim) == false {
                                    return { "failOp": name, "failIp": j }
                                }
                                let rv = vJitOsrSimPop(S, sim)
                                if typeof(rv) != "number" {
                                    return { "failOp": name, "failIp": j }
                                }
                                sim["st"] = push(sim["st"], 0 - rv)
                            } else {
                                return { "failOp": name, "failIp": j }
                            }
                        }
                    }
                }
            }
        }
        j = j + 1
    }
    return { "failOp": "budget", "failIp": ip }
}

/// Miss with a lazily-built header key — the op-name concat only runs when
/// S["jitOsrMissTrace"] is on, so the production miss path stays a counter.
fn vJitOsrMissKeyS(S, ops, ip, suffix) {
    let key = ""
    if S["jitOsrMissTrace"] == true {
        key = ops[ip]["op"] + "|" + ops[ip + 1]["op"] + "|" + ops[ip + 2]["op"] + "|" + ops[ip + 3]["op"] + suffix
    }
    return vJitOsrMissS(S, key)
}

pub fn vJitOsrStepS(S, ops, pool) {
    let ip = S["ip"]
    if ip <= 0 {
        return 0
    }
    let armed = S["jitOsrArmIps"]
    if armed == undefined {
        return 0
    }
    let ai = 0
    let hit = false
    let an = len(armed)
    while ai < an {
        if armed[ai] == ip {
            hit = true
            break
        }
        ai = ai + 1
    }
    if hit == false {
        return 0
    }
    // Armed-but-rejected outcomes feed S["jitOsrMisses"] — the honest
    // fused-vs-interpreted share on hot headers (vJitSessionStats reads it).
    if ip + 3 >= len(ops) {
        return vJitOsrMissS(S, "short")
    }
    let hv = vJitOsrHeaderVals(S, ops, pool, ip)
    if hv["a"] == undefined {
        if S["jitOsrMissTrace"] == true {
            S["jitOsrMissLastFail"] = hv["failOp"] + "@" + hv["failIp"]
        }
        return vJitOsrMissKeyS(S, ops, ip, ">header")
    }
    let a = hv["a"]
    let b = hv["b"]
    let chain = ["const", "const", hv["cmp"], hv["jcc"], "ret"]
    if jitFromOpsAnyExecOk(chain, a, b, 0, 0, 0, 0) == false {
        return vJitOsrMissKeyS(S, ops, ip, ">exec")
    }
    let r = jitFromOpsAnyVal(chain, a, b, 0, 0, 0, 0)
    // Sync the real stack: the fused header consumed `used` pre-header
    // values and left `tail` pushed values — mirror that before jumping.
    let used = hv["used"]
    let tail = hv["tail"]
    if used > 0 || len(tail) > 0 {
        let s2 = S["stack"]
        let ui = 0
        while ui < used {
            s2 = pop(s2)
            ui = ui + 1
        }
        let ti = 0
        while ti < len(tail) {
            s2 = push(s2, tail[ti])
            ti = ti + 1
        }
        S["stack"] = s2
    }
    // The jcc target is relative to the jump op itself (hv["jip"]), not the
    // header start — taken = jip + 1 + arg, fallthrough/body start = jip + 1.
    let jip = hv["jip"]
    if r == 1 {
        S["ip"] = jip + 1 + hv["jarg"]
    } else {
        if vJitOsrAccBodyS(S, ops, pool, ip, jip + 1) == 0 {
            if vJitOsrIncBodyS(S, ops, pool, ip, jip + 1) == 0 {
                S["ip"] = jip + 1
            }
        }
    }
    let e = S["jitOsrExecs"]
    if e == undefined {
        e = 0
    }
    S["jitOsrExecs"] = e + 1
    return 1
}
