// SH17 deepen: PIC in the real dispatch path. import "self_host/vm_run_jit"
// The `call` op site caches vClassifyCallee per callee shape in
// S["jitSites"][" "+ip] — V8 model: mono stub → PIC ≤4 → megamorphic
// fallback (jit_pic.kab). Per-call fields (recv/caps/arrowDef) live on the
// callee wrapper, not the cached record — hits refresh them. A callee
// carrying {vmJit:1, jitOps:[...]} (or jitSlots+jitSlotOps for polymorphic
// jit fns) executes its fused lowering via jitPicExecOk instead of a frame.
// Hot sites compile: jitPicPlan gates on hits/pct; a rec whose fn body is a
// fusible chain (vJitOpsOf) gets a jit callee; exec-domain rejects deopt to
// the cached frame record (c["fb"]) rather than failing the call.

import "self_host/vm_s_stack"
import "kab/jit/jit_pic"
import "kab/jit/jit_pic_exec"
import "kab/jit/jit_from_ops_any"
import "kab/jit/jit_from_ops_any_val"
import "kab/jit/jit_from_ops_bits"
import "kab/jit/jit_fuse_cmp"
import "kab/jit/jit_f64"
import "kab/jit/jit_bits"
import "kab/jit/jit_osr"

/// Per-ip site table key.
pub fn vJitSiteKeyS(S) {
    return " " + S["ip"]
}

pub fn vJitSitesS(S) {
    let sites = S["jitSites"]
    if typeof(sites) != "object" || sites == null {
        sites = {}
        S["jitSites"] = sites
    }
    return sites
}

/// Identity key for a jit callee: explicit jitId wins; else the namespaced
/// inst/host key (vmI or __kab_oid) — never aliases another identity space.
pub fn vJitObjKey(v) {
    let jid = vObjGet(v, "jitId")
    if jid != undefined {
        return "" + jid
    }
    let k = vInstKeyS(v)
    if k != undefined {
        return "k" + k
    }
    return "x" + vGcObjIdS(v)
}

/// Callee shape for the site PIC. Fn/arrow/jit identity keys are stable
/// across calls; receiver-bound wrappers shape on kind + receiver class so
/// different receivers of the same class hit one slot (recv is refreshed
/// per call — it is instance state, not shape state). Host callees get no
/// shape: their records would pin a per-call callee object.
pub fn vJitCalleeShape(callee) {
    if callee == null || callee == undefined {
        return undefined
    }
    if typeof(callee) != "object" {
        return undefined
    }
    let vmFn = vObjGet(callee, "vmFn")
    if vmFn != undefined {
        return "f" + vmFn
    }
    let vmArrow = vObjGet(callee, "vmArrow")
    if vmArrow != undefined {
        return "a" + vmArrow
    }
    if vObjGet(callee, "vmJit") == 1 {
        return "j" + vJitObjKey(callee)
    }
    let r = vObjGet(callee, "vmR")
    if r == undefined || r == null || typeof(r) != "object" {
        return undefined
    }
    let rc = vObjGet(r, "vmC")
    if rc == undefined {
        return undefined
    }
    let vmM = vObjGet(callee, "vmM")
    if vmM != undefined {
        return "m" + rc + "." + vmM
    }
    if vObjGet(callee, "vmGenNext") != undefined {
        return "gn" + rc
    }
    if vObjGet(callee, "vmGenReturn") != undefined {
        return "gr" + rc
    }
    if vObjGet(callee, "vmGenThrow") != undefined {
        return "gt" + rc
    }
    return undefined
}

/// Refresh per-call fields on a cached classify record — recv/caps/arrowDef
/// are instance state carried by the callee wrapper of THIS call.
pub fn vJitRefreshC(c, callee) {
    let k = c["kind"]
    if k == "method" || k == "hostMethod" || k == "genNext" || k == "genReturn" || k == "genThrow" {
        c["recv"] = vObjGet(callee, "vmR")
    }
    if k == "arrow" {
        c["caps"] = vObjGet(callee, "caps")
        c["arrowDef"] = vObjGet(callee, "arrowDef")
    }
    return c
}

/// Jit-native callee kind: {vmJit:1} objects bypass the frame path.
pub fn vJitClassifyJit(callee) {
    if callee == null || callee == undefined {
        return null
    }
    if typeof(callee) != "object" {
        return null
    }
    if vObjGet(callee, "vmJit") != 1 {
        return null
    }
    return { "kind": "jit", "callee": callee }
}

/// Hit-rate percent for jitPicPlan's icHitOk gate (>=90).
pub fn vJitSitePct(site) {
    if site["calls"] <= 0 {
        return 0
    }
    return (site["hits"] * 100) / site["calls"]
}

/// Extraction: fn body ops → jitOps descriptor for a fused template.
/// Shapes (params must bind to locals 0..N in order so load_local i is
/// call arg i; anything else → null, the site stays on the frame path):
///   A arith    — `return ((p0 + p1 - p2) * p3 / p4) % p5`:
///                load_local 0..5 + add,sub,mul,div,mod + return (12 ops)
///                → ["const","add","sub","mul","div","mod","ret"] arity 6
///   B cmp      — `return p0 <cmp> p1`:
///                load_local 0,1 + eq/ne/lt/gt/le/ge/test + return (4 ops)
///                → ["const","const",cmp,"jump_if_true","ret"] arity 2
///   C cmp+not  — `return not (p0 <cmp> p1)`:
///                same + a `not` op before return (5 ops)
///                → ["const","const",cmp,"jump_if_false","ret"] arity 2
///                (jump_if_false folds the negation into the predicate)
pub fn vJitOpsOfFn(f) {
    if f == null || f == undefined || typeof(f) != "object" {
        return null
    }
    let ops = f["ops"]
    let params = f["params"]
    let locals = f["locals"]
    if typeof(ops) != "array" || typeof(params) != "array" || typeof(locals) != "array" {
        return null
    }
    let nOps = len(ops)
    // Unary chain: `return -a` / `return ~a` — one param, three ops — lowers
    // to the guest unary template (83 bit_not / 84 neg).
    if nOps == 3 && len(params) >= 1 && len(locals) >= 1 {
        if locals[0] == params[0] {
            if ops[0]["op"] == "load_local" && ops[0]["arg"] == 0 {
                let um = jitBitsMagic(ops[1]["op"])
                if um != 0 {
                    if jitBitsUnary(um) == true {
                        let rop2 = ops[2]["op"]
                        if rop2 == "return" || rop2 == "ret" {
                            return ["const", ops[1]["op"], "ret"]
                        }
                    }
                }
            }
        }
    }
    if (nOps == 4 || nOps == 5) && len(params) >= 2 && len(locals) >= 2 {
        if locals[0] != params[0] || locals[1] != params[1] {
            return null
        }
        if ops[0]["op"] != "load_local" || ops[0]["arg"] != 0 {
            return null
        }
        if ops[1]["op"] != "load_local" || ops[1]["arg"] != 1 {
            return null
        }
        let cm = ops[2]["op"]
        if jitCmpMagic(cm) == 0 {
            // f64 chain: `return a OP b` (add/sub/mul/div) lowers to the
            // guest f64 template — exact for the 1..=64 operand domain
            // (fdiv truncates = integer div). `mod` has no f64 template;
            // anything else stays cold.
            if nOps == 4 {
                if jitF64Magic("f" + cm) != 0 {
                    let rop4 = ops[3]["op"]
                    if rop4 == "return" || rop4 == "ret" {
                        return ["const", "const", "f" + cm, "ret"]
                    }
                }
                // bits chain: `return a OP b` for bit_and/bit_or/bit_xor/
                // shl/shr/ushr lowers to the guest bits template (77-82).
                let bm = jitBitsMagic(cm)
                if bm != 0 {
                    if jitBitsUnary(bm) == false {
                        let rop4b = ops[3]["op"]
                        if rop4b == "return" || rop4b == "ret" {
                            return ["const", "const", cm, "ret"]
                        }
                    }
                }
            }
            return null
        }
        let neg = false
        let ri = 3
        if nOps == 5 {
            if ops[3]["op"] != "not" {
                return null
            }
            neg = true
            ri = 4
        }
        let rop = ops[ri]["op"]
        if rop != "return" && rop != "ret" {
            return null
        }
        if neg {
            return ["const", "const", cm, "jump_if_false", "ret"]
        }
        return ["const", "const", cm, "jump_if_true", "ret"]
    }
    if nOps != 12 || len(params) < 6 || len(locals) < 6 {
        return null
    }
    let pi = 0
    while pi < 6 {
        if locals[pi] != params[pi] {
            return null
        }
        pi = pi + 1
    }
    let posL = [0, 1, 3, 5, 7, 9]
    let li = 0
    while li < 6 {
        let op = ops[posL[li]]
        if op["op"] != "load_local" || op["arg"] != li {
            return null
        }
        li = li + 1
    }
    let posA = [2, 4, 6, 8, 10]
    let names = ["add", "sub", "mul", "div", "mod"]
    let ai = 0
    while ai < 5 {
        if ops[posA[ai]]["op"] != names[ai] {
            return null
        }
        ai = ai + 1
    }
    let rop = ops[11]["op"]
    if rop != "return" && rop != "ret" {
        return null
    }
    return ["const", "add", "sub", "mul", "div", "mod", "ret"]
}

/// Numeric-arg requirement of a site-compiled callee — the fused template
/// immediates are typed per shape (arith 6, cmp/f64 2, SIMD 4). 0 = cold.
pub fn vJitOpsArity(jitOps) {
    let kind = jitFuseKind(jitOps)
    if kind == 1 {
        return 6
    }
    if kind == 2 {
        return 2
    }
    if kind == 3 {
        return 2
    }
    if kind == 4 {
        return 4
    }
    if kind == 5 {
        if len(jitOps) == 3 {
            return 1
        }
        return 2
    }
    return 0
}

/// Resolve a cached classify rec's fn ops to a jitOps descriptor — fn recs
/// read functions[idx], arrows read their arrowDef (or S["arrows"][idx]).
/// Method/host/generator kinds return null: their bodies are not fusible.
pub fn vJitOpsOfRec(S, rec, functions) {
    let k = rec["kind"]
    if k == "fn" {
        if typeof(functions) == "array" {
            return vJitOpsOfFn(functions[rec["idx"]])
        }
        return null
    }
    if k == "arrow" {
        let ad = rec["arrowDef"]
        if ad == undefined {
            let arrs = S["arrows"]
            if typeof(arrs) == "array" {
                ad = arrs[rec["idx"]]
            }
        }
        return vJitOpsOfFn(ad)
    }
    return null
}

/// Compile trigger: on a PIC hit, when jitPicPlan says the site compiles
/// (1 mono / 2 PIC), extract the rec's ops once. A fusible chain installs a
/// jit callee on the rec — subsequent hits return kind jit with fb = the
/// frame record for deopt on exec-domain rejects.
pub fn vJitMaybeCompileS(S, site, key, rec, i, functions) {
    if rec["jitChecked"] == 1 {
        return null
    }
    let plan = jitPicPlan(len(site["slots"]), vJitSitePct(site), site["hits"])
    if plan != 1 && plan != 2 {
        return null
    }
    rec["jitChecked"] = 1
    let jitOps = vJitOpsOfRec(S, rec, functions)
    if jitOps == null {
        return null
    }
    rec["jitCallee"] = { "vmJit": 1, "jitId": "c" + key + "." + i, "jitOps": jitOps, "jitArity": vJitOpsArity(jitOps) }
    return rec["jitCallee"]
}

/// PIC-cached classify: `classify` is the caller's classify fn (passed in —
/// vm_run_call owns vClassifyCallee; a direct import would cycle). Shape hit
/// returns the cached record (with per-call fields refreshed); a miss
/// classifies and learns the shape into the site PIC — a full PIC goes
/// megamorphic and stops caching. Site counters (calls/hits/misses) feed
/// jitPicPlan compile decisions; a hot fusible rec installs a jit callee.
pub fn vJitClassifyS(S, callee, classify, functions) {
    let jc = vJitClassifyJit(callee)
    if jc != null {
        return jc
    }
    let shape = vJitCalleeShape(callee)
    if shape == undefined {
        return classify(callee)
    }
    let sites = vJitSitesS(S)
    let key = vJitSiteKeyS(S)
    let site = sites[key]
    if typeof(site) != "object" || site == null {
        site = { "slots": [], "recs": [], "calls": 0, "hits": 0, "misses": 0, "mega": false }
        sites[key] = site
    }
    site["calls"] = site["calls"] + 1
    if site["mega"] == true {
        return classify(callee)
    }
    let i = jitPicFind(site["slots"], shape)
    if i >= 0 && i < len(site["recs"]) {
        site["hits"] = site["hits"] + 1
        let rec = site["recs"][i]
        let jitCallee = rec["jitCallee"]
        if jitCallee == undefined {
            jitCallee = vJitMaybeCompileS(S, site, key, rec, i, functions)
        }
        if jitCallee != null && jitCallee != undefined {
            return { "kind": "jit", "callee": jitCallee, "fb": vJitRefreshC(rec, callee) }
        }
        return vJitRefreshC(rec, callee)
    }
    let c = classify(callee)
    site["misses"] = site["misses"] + 1
    if jitPicMega(site["slots"], shape) {
        site["mega"] = true
    } else {
        site["slots"] = jitPicLearn(site["slots"], shape)
        site["recs"] = push(site["recs"], c)
    }
    return c
}

/// Exec a jit callee through the fused lowering. jitOps is a single
/// specialized op list; jitSlots+jitSlotOps is a polymorphic jit fn — the
/// arg0 class shape picks the slot via jitPicExecOk. Numeric args feed the
/// template immediates (n,k,s,m,d,r). {ok:0} means the domain rejected the
/// call — the caller falls back per its contract (deopt to c["fb"] when set).
/// jitArity marks a site-compiled callee: it needs exactly-typed numeric args
/// (an object/non-number arg would feed the template garbage), so a typed
/// callee rejects before exec when args are missing or non-numeric.
pub fn vJitExecOk(S, c, ordered) {
    let callee = c["callee"]
    let arity = vObjGet(callee, "jitArity")
    if arity != undefined {
        if len(ordered) < arity {
            return { "ok": 0 }
        }
        let ti = 0
        while ti < arity {
            if typeof(ordered[ti]) != "number" {
                return { "ok": 0 }
            }
            ti = ti + 1
        }
    }
    let n = 0
    let k = 0
    let s = 0
    let m = 0
    let d = 0
    let r = 0
    if len(ordered) > 0 { n = ordered[0] }
    if len(ordered) > 1 { k = ordered[1] }
    if len(ordered) > 2 { s = ordered[2] }
    if len(ordered) > 3 { m = ordered[3] }
    if len(ordered) > 4 { d = ordered[4] }
    if len(ordered) > 5 { r = ordered[5] }
    let slotOps = vObjGet(callee, "jitSlotOps")
    if typeof(slotOps) == "array" {
        let slots = vObjGet(callee, "jitSlots")
        if typeof(slots) != "array" {
            return { "ok": 0 }
        }
        let shape = "t" + typeof(n)
        if n != null && n != undefined && typeof(n) == "object" {
            let nc = vObjGet(n, "vmC")
            if nc != undefined {
                shape = "c" + nc
            }
        }
        if jitPicExecOk(slotOps, slots, shape, n, k, s, m, d, r) == false {
            return { "ok": 0 }
        }
        let outSlot = jitPicFind(slots, shape)
        return { "ok": 1, "out": jitFromOpsAnyVal(slotOps[outSlot], n, k, s, m, d, r) }
    }
    let ops = vObjGet(callee, "jitOps")
    if typeof(ops) != "array" {
        return { "ok": 0 }
    }
    if jitFromOpsAnyExecOk(ops, n, k, s, m, d, r) == false {
        return { "ok": 0 }
    }
    return { "ok": 1, "out": jitFromOpsAnyVal(ops, n, k, s, m, d, r) }
}

// --- vm_jit_osr ---
/// Back-edge landing on a loop header (ip moved backwards): count the hit in
/// S["jitLoopHits"][" "+ip]; once jitOsrOk says the header is hot, mark it
/// armed in S["jitOsrArmed"] so vJitOsrStepS may run the fused header.
pub fn vJitBackEdgeS(S, ip) {
    let hits = S["jitLoopHits"]
    if hits == undefined {
        hits = {}
        S["jitLoopHits"] = hits
    }
    let key = " " + ip
    let h = vObjGet(hits, key)
    if h == undefined {
        h = 0
    }
    h = h + 1
    hits[key] = h
    if jitOsrOk(ip, h) == true {
        let armed = S["jitOsrArmed"]
        if armed == undefined {
            armed = {}
            S["jitOsrArmed"] = armed
        }
        armed[key] = true
    }
}

/// Operand value for a fused header operand op; only load_local/const
/// resolve — anything else returns undefined and the header stays
/// interpreted.
fn vOsrOperandVal(S, op, pool) {
    let name = op["op"]
    if name == "load_local" {
        let i = op["arg"]
        if i >= 0 && i < len(S["locals"]) {
            return S["locals"][i]
        }
        return undefined
    }
    if name == "const" {
        let i = op["arg"]
        if i >= 0 && i < len(pool) {
            return pool[i]
        }
        return undefined
    }
    return undefined
}

/// OSR step: an armed loop header of shape [operand, operand, cmp,
/// jump_if_*] executes its branch decision through the fused cmp template —
/// operand values are baked as the const,const immediates of a kind-2 chain
/// (jump_if_false folds the negated predicate, so a fused 1 means "take").
/// Returns 0 when unarmed/shape-mismatched/domain-rejected → interpreted.
pub fn vJitOsrStepS(S, ops, pool) {
    let ip = S["ip"]
    if ip <= 0 {
        return 0
    }
    let armed = S["jitOsrArmed"]
    if armed == undefined {
        return 0
    }
    if vObjGet(armed, " " + ip) != true {
        return 0
    }
    if ip + 3 >= len(ops) {
        return 0
    }
    let a = vOsrOperandVal(S, ops[ip], pool)
    let b = vOsrOperandVal(S, ops[ip + 1], pool)
    if a == undefined || b == undefined {
        return 0
    }
    if typeof(a) != "number" || typeof(b) != "number" {
        return 0
    }
    let chain = ["const", "const", ops[ip + 2]["op"], ops[ip + 3]["op"], "ret"]
    if jitFromOpsAnyExecOk(chain, a, b, 0, 0, 0, 0) == false {
        return 0
    }
    let r = jitFromOpsAnyVal(chain, a, b, 0, 0, 0, 0)
    // The jcc target is relative to the jump op itself (ip + 3), not the
    // header start — taken = (ip + 3) + 1 + arg, fallthrough = ip + 4.
    if r == 1 {
        S["ip"] = ip + 4 + ops[ip + 3]["arg"]
    } else {
        S["ip"] = ip + 4
    }
    let e = S["jitOsrExecs"]
    if e == undefined {
        e = 0
    }
    S["jitOsrExecs"] = e + 1
    return 1
}
