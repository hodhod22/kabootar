// P6b: class-method appender (skip-listed until ≤10s).
import "self_host/serialize_class_method_one"

pub fn serAppendClassMethods(out, ci, methods) {
    let j = 0
    let n = len(methods)
    while j < n {
        out = serAppendOneClassMethod(out, ci, j, methods[j])
        j = j + 1
    }
    return out
}
