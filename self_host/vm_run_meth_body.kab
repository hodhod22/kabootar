import "self_host/vm_run_this_frame"
import "self_host/vm_run_hook_fn"

pub fn runMethodBodyS(S, meth, pool, globals, functions, recv, callArgs) {
    vPushThis(S, recv)
    let out = null
    let err = null
    try {
        out = vCallRunFn(S, meth, pool, globals, functions, callArgs, null)
    } catch (e) {
        err = e
    }
    vPopThis(S)
    if err != null {
        throw err
    }
    return out
}
