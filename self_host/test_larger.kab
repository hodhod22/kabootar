// Smoke: self-hosted compile of lexer-like mini module.
import "self_host/compile"
import "self_host/lexer_defs"

let kbc = compile("fn isDigit(ch) {" + CHAR_NL + "  if ch == " + QUOTE + "5" + QUOTE + " {" + CHAR_NL + "    return true" + CHAR_NL + "  }" + CHAR_NL + "  return false" + CHAR_NL + "}" + CHAR_NL + "return isDigit(" + QUOTE + "5" + QUOTE + ")")
if char_at(kbc, 0) != "k" {
    throw "larger: bad header"
}
println("larger smoke ok")
