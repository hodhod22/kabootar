import "self_host/vm_s_push"
import "self_host/vm_s_pop"
import "self_host/vm_s_ip"

pub fn runOpCmpNe(S, name, arg, op, pool, globals, functions) {
    if name == "ne" {
        let b = vPopS(S)
        let a = vPopS(S)
        vPushS(S, a != b)
        vBumpIpS(S)
        return 1
    }
    return 0
}
