// H6e/P6b: session + thin local trampoline (CI-fast self-host ≤10s).
// Heavy tramp body lives in vm_run_tramp_*; hooks pack S["_args"]/_hook.
import "self_host/vm_run_session"
import "self_host/vm_run_tramp"
import "self_host/vm_run_mod_run"
import "self_host/vm_run_call"
import "self_host/vm_run_jit"
// SH6: yield* throw delegate.

let S = vMakeSession()

fn tramp() {
    return vTramp(S)
}

S["runOps"] = tramp
S["runFnBody"] = tramp
S["runMethodBody"] = tramp

// SH17: S-resident import binding — opt-in via KAB_VM_SIMPORT=1. When on,
// vBindImports resolves module files itself and binds exports as {vmModFn}
// values that run the imported module's ops on this session (JIT-visible).
S["simportFn"] = vTryBindImportSK
S["simports"] = 0
if env_get("KAB_VM_SIMPORT") == "1" {
    S["simports"] = 1
}
S["simportMatch"] = ""
let smatch = env_get("KAB_VM_SIMPORT_MATCH")
if smatch != undefined && smatch != null {
    S["simportMatch"] = "" + smatch
}
S["vmMods"] = {}
S["modLoading"] = {}

pub fn runModuleImplBodyCore(bc) {
    return vModRun(S, bc)
}

/// SH18: read-only diagnostics for the production-workload delete evidence —
/// the singleton session's consecutive internally-consistent collect count
/// and total collects (gc_host `gcHostReadyStreakOk` consults the streak).
pub fn vGcSessionReadyStreak() {
    let s = S["gcHostReadyStreak"]
    if typeof(s) != "number" {
        return 0
    }
    return s
}

pub fn vGcSessionCollects() {
    let c = S["gcCollects"]
    if typeof(c) != "number" {
        return 0
    }
    return c
}

/// SH17: read-only JIT diagnostics — counters the singleton session collected
/// during module runs. `headers` = distinct loop-header ips with back-edges,
/// `armed` = OSR-armed headers, `osrExecs`/`osrMisses` = fused vs rejected
/// OSR steps, `countLoops` = closed-form applications, `compiled` = jit
/// callees installed, `execs` = fused template execs via vJitExecOk.
pub fn vJitSessionStats() {
    let armIps = S["jitOsrArmIps"]
    let armed = 0
    if typeof(armIps) == "array" {
        armed = len(armIps)
    }
    let hitMap = S["jitLoopHits"]
    let headers = 0
    if hitMap != undefined {
        headers = len(object_keys(hitMap))
    }
    return {
        "headers": headers,
        "armed": armed,
        "backEdges": vJitSessionNum(S["jitBackEdges"]),
        "steps": vJitSessionNum(S["jitSteps"]),
        "osrExecs": vJitSessionNum(S["jitOsrExecs"]),
        "osrMisses": vJitSessionNum(S["jitOsrMisses"]),
        "countLoops": vJitSessionNum(S["jitCountLoops"]),
        "compiled": vJitSessionNum(S["jitCompiled"]),
        "execs": vJitSessionNum(S["jitExecs"])
    }
}

fn vJitSessionNum(v) {
    if typeof(v) != "number" {
        return 0
    }
    return v
}

/// SH17 diagnostics: enable/disable the armed-header miss-shape histogram
/// (key concat on every hot miss — measurement only, not production).
pub fn vJitSessionMissTrace(on) {
    S["jitOsrMissTrace"] = on == true
    return
}

/// The miss-shape histogram: {"op|op|op|op>cause": count}. Empty when the
/// trace flag is off or no armed header has missed.
pub fn vJitSessionMissShapes() {
    let shapes = S["jitOsrMissShapes"]
    if shapes == undefined {
        return {}
    }
    return shapes
}

/// The op name + ip of the last header-eval rejection — which whitelist
/// boundary a missed header hit ("" when none recorded this session).
pub fn vJitSessionLastFail() {
    let v = S["jitOsrMissLastFail"]
    if v == undefined {
        return ""
    }
    return v
}

/// Zero every JIT counter + arming state — lets one session measure distinct
/// workloads without double-counting the previous run.
pub fn vJitSessionReset() {
    S["jitExecs"] = 0
    S["jitCompiled"] = 0
    S["jitBackEdges"] = 0
    S["jitSteps"] = 0
    S["jitCountLoops"] = 0
    S["jitOsrExecs"] = 0
    S["jitOsrMisses"] = 0
    S["jitOsrMissShapes"] = {}
    S["jitOsrArmIps"] = []
    S["jitOsrArmed"] = {}
    S["jitLoopHits"] = {}
    return
}

/// Diagnostics/stress hook: override the nursery cap. Same machinery, denser
/// cadence — the way a VM stress test runs many cycles against a small
/// nursery instead of waiting minutes of interpreter time per collect.
pub fn vGcSessionSetCap(n) {
    if typeof(n) == "number" && n >= 64 {
        S["gcCap"] = n
    }
    return
}

// SH27: host→session callback bridge. Host `call_value` routes {vmFn}/
// {vmArrow}/… sentinel objects here so module-side callbacks re-enter this
// session's own function tables (bcFns/bcPool/bcGlobals stash per module run).
pub fn vHostCallVmValue(callee, ordered) {
    let c = vJitClassifyS(S, callee, vClassifyCallee, S["bcFns"])
    if c["kind"] == "bad" {
        return undefined
    }
    return vApplyCalleeS(S, c, ordered, S["bcPool"], S["bcGlobals"], S["bcFns"])
}
