// H6e/P6b: session + thin local trampoline (CI-fast self-host ≤10s).
// Heavy tramp body lives in vm_run_tramp_*; hooks pack S["_args"]/_hook.
import "self_host/vm_run_session"
import "self_host/vm_run_tramp"
import "self_host/vm_run_mod_run"
import "self_host/vm_run_call"
// SH6: yield* throw delegate.

let S = vMakeSession()

fn tramp() {
    return vTramp(S)
}

S["runOps"] = tramp
S["runFnBody"] = tramp
S["runMethodBody"] = tramp

pub fn runModuleImplBodyCore(bc) {
    return vModRun(S, bc)
}

// SH27: host→session callback bridge. Host `call_value` routes {vmFn}/
// {vmArrow}/… sentinel objects here so module-side callbacks re-enter this
// session's own function tables (bcFns/bcPool/bcGlobals stash per module run).
pub fn vHostCallVmValue(callee, ordered) {
    let c = vClassifyCallee(callee)
    if c["kind"] == "bad" {
        return undefined
    }
    return vApplyCalleeS(S, c, ordered, S["bcPool"], S["bcGlobals"], S["bcFns"])
}
