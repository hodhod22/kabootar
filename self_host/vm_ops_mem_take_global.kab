import "self_host/vm_s_push"
import "self_host/vm_s_ip"
import "self_host/vm_s_resolve"

pub fn runOpMemTakeGlobal(S, name, arg, op, pool, globals, functions) {
    if name == "take_global" {
        let arr = vResolveGlobalS(S, globals, arg)
        S["globals"][arg] = undefined
        vPushS(S, arr)
        vBumpIpS(S)
        return 1
    }
    return 0
}
