import "self_host/vm_s_stack"

// --- vm_ops_arith_add ---
pub fn runOpArithAdd(S, name, arg, op, pool, globals, functions) {
    if name == "add" {
        let b = vPopS(S)
        let a = vPopS(S)
        vPushS(S, a + b)
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_arith_bit_and ---
pub fn runOpArithBitAnd(S, name, arg, op, pool, globals, functions) {
    if name == "bit_and" {
        let b = vPopS(S)
        let a = vPopS(S)
        vPushS(S, a & b)
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_arith_bit_not ---
pub fn runOpArithBitNot(S, name, arg, op, pool, globals, functions) {
    if name == "bit_not" {
        let v = vPopS(S)
        vPushS(S, ~v)
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_arith_bit_or ---
pub fn runOpArithBitOr(S, name, arg, op, pool, globals, functions) {
    if name == "bit_or" {
        let b = vPopS(S)
        let a = vPopS(S)
        vPushS(S, a | b)
        vBumpIpS(S)
        return 1
    }
    return 0
}

