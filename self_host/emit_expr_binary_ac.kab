import "self_host/emit_defs"
import "self_host/emit_hooks"
import "self_host/emit_op"

pub fn emitExpr_binaryArith(E, binOp) {
    if binOp == "+" {
        emitOp(E, OP_ADD, 0)
        return 1
    }
    if binOp == "-" {
        emitOp(E, OP_SUB, 0)
        return 1
    }
    if binOp == "*" {
        emitOp(E, OP_MUL, 0)
        return 1
    }
    if binOp == "/" {
        emitOp(E, OP_DIV, 0)
        return 1
    }
    if binOp == "%" {
        emitOp(E, OP_MOD, 0)
        return 1
    }
    if binOp == "**" {
        emitOp(E, OP_POW, 0)
        return 1
    }
    return 0
}

pub fn emitExpr_binaryCmp(E, binOp) {
    if binOp == "==" {
        emitOp(E, OP_EQ, 0)
        return 1
    }
    if binOp == "!=" {
        emitOp(E, OP_NE, 0)
        return 1
    }
    if binOp == "<" {
        emitOp(E, OP_LT, 0)
        return 1
    }
    if binOp == ">" {
        emitOp(E, OP_GT, 0)
        return 1
    }
    if binOp == ">=" {
        emitOp(E, OP_GE, 0)
        return 1
    }
    if binOp == "<=" {
        emitOp(E, OP_LE, 0)
        return 1
    }
    return 0
}
