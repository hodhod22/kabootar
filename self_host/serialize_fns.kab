import "self_host/serialize_out"
import "self_host/serialize_ir_line"
import "self_host/serialize_ops"
import "self_host/serialize_arrows"

// --- serialize_fn_tries ---
// P6b: fn try-region appender (skip-listed until ≤10s).

pub fn serAppendFnTries(out, i, regions) {
    let j = 0
    let nTr = len(regions)
    while j < nTr {
        out = serOutTry5(out, "fn_try_region", i, j, regions[j])
        j = j + 1
    }
    return out
}

// --- serialize_fn_one ---
// P6b: one function header appender (skip-listed until ≤10s).

pub fn serAppendOneFn(out, i, f) {
    out = serOutTagged(out, "fn", i, f.sym)
    out = serOutTagged(out, "fn_params", i, serJoinComma(f.params))
    out = serOutTagged(out, "fn_locals", i, serJoinComma(f.locals))
    if f["tryRegions"] != undefined {
        out = serAppendFnTries(out, i, f["tryRegions"])
    }
    out = serAppendFnArrows(out, i, f["arrows"])
    return out
}

// --- serialize_fns ---
// P6b: function-section appender (skip-listed until ≤10s).

pub fn serAppendFunctions(out, fns) {
    out = serOutTagEq(out, "functions=", len(fns))
    let i = 0
    let n = len(fns)
    while i < n {
        out = serAppendOneFn(out, i, fns[i])
        out = serAppendTaggedOps(out, "fn_op", i, fns[i].ops)
        i = i + 1
    }
    return out
}
