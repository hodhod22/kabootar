import "self_host/lexer_defs"
import "self_host/ast_defs"
import "self_host/parser_hooks"
import "self_host/parser_util"

pub fn parseMul_step(sess) {
    if !(sess["pCur"].type == "*" || sess["pCur"].type == "/" || sess["pCur"].type == "%" || sess["pCur"].type == "**") {
        return 0
    }
    let op = sess["pCur"].type
    bump(sess)
    let left = sess["pLeft"]
    let right = pCallUnary(sess)
    sess["pLeft"] = { "kind": AST_BINARY, "op": op, "left": left, "right": right }
    return 1
}
