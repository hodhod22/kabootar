// P6b: 2-way dispatch chain (≤10s self-host compile).
import "self_host/vm_ops_cmp_a"
import "self_host/vm_ops_cmp_b"

pub fn runOpCmpAb(S, name, arg, op, pool, globals, functions) {
    let st = runOpCmpA(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpCmpB(S, name, arg, op, pool, globals, functions)
}
