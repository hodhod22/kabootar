// H6e: self-hosted Kabootar parser body — heavy impl (skip-listed; see self_host/parser.kab).
// Subset mirroring src/parser.rs.
// Session cursors (pPos, pToks, …) stay module-global; recursion temps use fn-locals (L1/S1).
import "self_host/lexer_defs"
import "self_host/ast_defs"

let pPos = 0
let pToks = []
let pToksLen = 0
let pCur = null
let pEofTok = { "type": "EOF", "value": null, "line": 1, "column": 1 }
let pLeft = null
let pRight = null
let pArgs = []
let pTok = null
let pIdent = null
let pInit = null
let pVal = null
let pBody = []
let pBodyStack = []
let pStmts = []
let pParams = []
let pCond = null
let pCondStack = []
let pThen = null
let pElse = null
let pLoopBody = []
let pCallee = null
let pObjFields = []
let pSave = null
let pAssignLhs = null
let pBinOp = ""
let pSaveSym = ""
let pBindSym = ""
let pExprLeft = null
let pFnSym = ""
let pFnPub = 0
let pIsPub = 0
let pLetSym = ""
let pSymPool = []
let pSymN = 0
let pBodyDepth = 0
let pCondDepth = 0
let pImports = []
let pPopI = 0
let pPopNew = []
let pSymOut = ""
let pSymSrc = ""
let pSymI = 0
let pInAddSub = 0
let pNoBit = 0
let pAddLeft = null
let pAddLeftStack = []
let pNextTok = null
let pDone = 0
let pTypeParams = []
let pParamTypes = []
let pReturnType = ""
let pTypeArgs = []
let pVariants = []
let pClassFields = []
let pClassMethods = []
let pFieldType = ""
let pFieldDefault = null
let pVariantFields = []
let pMethTypeParams = []
let pMethParams = []
let pMethParamTypes = []
let pIsGenericCallee = 0
let pAngleI = 0
let pAngleTok = null
let pAngleOut = []
let pMemberName = ""
let pVariantName = ""
let pVariantSym = ""
let pEnumSym = ""
let pClassSym = ""
let pIsStruct = 0
let pIfaceSym = ""
let pIfaceMethods = []
let pAssocTypes = []
let pWhereClause = []
let pWhereParam = ""
let pWhereTrait = ""
let pSnapTypeArgs = []
let pParamType = ""

fn peek() {
    return pCur
}

fn bump() {
    pTok = pCur
    if pPos < pToksLen {
        pPos = pPos + 1
        if pPos < pToksLen {
            pCur = pToks[pPos]
        } else {
            pCur = pEofTok
        }
    }
    return pTok
}

// P6b: poolPush avoids len(pSymPool) LoadGlobal clone after every push.
fn poolPush(v) {
    pSymPool = push(pSymPool, v)
    pSymN = pSymN + 1
    return v
}

fn parseTypeArgs() {
    if pCur.type != "<" {
        return []
    }
    // P6b: type-arg scan uses cached pToksLen (hot len() elimination).
    pAngleI = pPos + 1
    if pAngleI >= pToksLen {
        return []
    }
    pAngleTok = pToks[pAngleI]
    if pAngleTok.type != TOKEN_IDENT {
        return []
    }
    pAngleI = pAngleI + 1
    while pAngleI < pToksLen {
        pAngleTok = pToks[pAngleI]
        if pAngleTok.type == ">" {
            break
        }
        if pAngleTok.type == "<" {
            return []
        }
        if pAngleTok.type == "," {
            pAngleI = pAngleI + 1
        } else {
            if pAngleTok.type == TOKEN_IDENT {
                pAngleI = pAngleI + 1
            } else {
                return []
            }
        }
    }
    if pAngleI >= pToksLen {
        return []
    }
    if pToks[pAngleI].type != ">" {
        return []
    }
    bump()
    pAngleOut = []
    while pCur.type != ">" {
        pTok = pCur
        if pTok.type != TOKEN_IDENT {
            throw "Expected type name"
        }
        bump()
        pAngleOut = push(pAngleOut, poolPush(pTok.value))
        if pCur.type == "," {
            bump()
        }
    }
    if pCur.type != ">" {
        throw "Expected >"
    }
    bump()
    return pAngleOut
}

fn parsePostfix() {
    if pCur.type == "EOF" {
        throw "parsePostfix EOF"
    }
    pLeft = null
    pTypeArgs = []
    pTok = pCur
    if pTok.type == TOKEN_NUMBER {
        bump()
        pLeft = { "kind": AST_LITERAL, "lit": LIT_NUMBER, "value": pTok.value }
    }
    if pLeft == null {
        pTok = pCur
        if pTok.type == TOKEN_STRING {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_STRING, "value": pTok.value }
        }
    }
    if pLeft == null {
        pTok = pCur
        if pTok.type == TOKEN_TRUE {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_BOOL, "value": true }
        }
    }
    if pLeft == null {
        pTok = pCur
        if pTok.type == TOKEN_FALSE {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_BOOL, "value": false }
        }
    }
    if pLeft == null {
        pTok = pCur
        if pTok.type == TOKEN_NULL {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_NULL, "value": null }
        }
    }
    if pLeft == null {
        pTok = pCur
        if pTok.type == TOKEN_UNDEFINED {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_UNDEF, "value": undefined }
        }
    }
    if pLeft == null {
        pTok = pCur
        if pTok.type == TOKEN_NONE {
            bump()
            pLeft = { "kind": AST_VAR, "sym": "None" }
        }
    }
    if pLeft == null {
        pTok = pCur
        if pTok.type == TOKEN_OK || pTok.type == TOKEN_ERR || pTok.type == TOKEN_SOME {
            bump()
            let wrapName = pTok.type
            if pCur.type != "(" {
                throw "Expected ( at " + ("" + pCur.line) + ":" + ("" + pCur.column) + " tok=" + pCur.type
            }
            bump()
            let wrapInner = parseCompare()
            if pCur.type != ")" {
                throw "Expected )"
            }
            bump()
            pLeft = {
                "kind": AST_CALL,
                "callee": { "kind": AST_VAR, "sym": wrapName },
                "args": [wrapInner]
            }
        }
    }
    if pLeft == null {
        pTok = pCur
        if pTok.type == TOKEN_IDENT {
            bump()
            pLeft = { "kind": AST_VAR, "sym": poolPush(pTok.value) }
        }
    }
    if pLeft == null {
        pTok = pCur
        if pTok.type == TOKEN_SELF {
            bump()
            pLeft = { "kind": AST_VAR, "sym": "self" }
        }
    }
    if pLeft == null {
        pTok = pCur
        if pTok.type == TOKEN_THIS {
            bump()
            pLeft = { "kind": AST_VAR, "sym": "this" }
        }
    }
    if pLeft == null {
        pTok = pCur
        if pTok.type == "(" {
            let savePos = pPos
            bump()
            // Arrow: (a, b) => body
            let arrowParams = []
            let arrowOk = 1
            if pCur.type == ")" {
                bump()
            } else {
                while pCur.type != ")" {
                    if pCur.type != TOKEN_IDENT {
                        arrowOk = 0
                        break
                    }
                    pTok = pCur
                    bump()
                    arrowParams = push(arrowParams, pTok.value)
                    if pCur.type == "," {
                        bump()
                    } else {
                        if pCur.type != ")" {
                            arrowOk = 0
                            break
                        }
                    }
                }
                if arrowOk == 1 {
                    if pCur.type != ")" {
                        arrowOk = 0
                    } else {
                        bump()
                    }
                }
            }
            if arrowOk == 1 && pCur.type == "=>" {
                bump()
                let arrowBody = null
                if pCur.type == "{" {
                    bump()
                    pBodyStack = push(pBodyStack, pBody)
                    pBodyDepth = pBodyDepth + 1
                    pBody = []
                    while pCur.type != "}" {
                        if pCur.type == "EOF" {
                            throw "Unclosed arrow block"
                        }
                        pBody = push(pBody, parseStmt())
                        if pCur.type == ";" {
                            bump()
                        }
                    }
                    bump()
                    let ab = pBody
                    pBody = pBodyStack[pBodyDepth - 1]
                    pBodyStack = pop(pBodyStack)
                    pBodyDepth = pBodyDepth - 1
                    arrowBody = { "kind": AST_BLOCK, "body": ab }
                } else {
                    arrowBody = parseCompare()
                }
                pLeft = { "kind": AST_ARROW, "params": arrowParams, "body": arrowBody }
            } else {
                // Backtrack to `(` — keep pCur in sync with pPos (peek cache).
                pPos = savePos
                if pPos < pToksLen {
                    pCur = pToks[pPos]
                } else {
                    pCur = pEofTok
                }
                bump()
                pLeft = parseCompare()
                if pCur.type != ")" {
                    throw "Expected )"
                }
                bump()
            }
        }
    }
    if pLeft == null {
        pTok = pCur
        if pTok.type == "{" {
            bump()
            pObjFields = []
            while pCur.type != "}" {
                pTok = pCur
                if pTok.type == TOKEN_IDENT {
                    bump()
                    pSaveSym = poolPush(pTok.value)
                } else {
                    if pTok.type == TOKEN_STRING {
                        bump()
                        pSaveSym = poolPush(pTok.value)
                    } else {
                        throw "Expected object key"
                    }
                }
                if pCur.type != ":" {
                    throw "Expected :"
                }
                bump()
                pVal = parseCompare()
                pObjFields = push(pObjFields, { "key": pSaveSym, "value": pVal })
                if pCur.type == "," {
                    bump()
                }
            }
            bump()
            pLeft = { "kind": AST_OBJECT, "fields": pObjFields }
        }
    }
    if pLeft == null {
        pTok = pCur
        if pTok.type == "[" {
            bump()
            pArgs = []
            while pCur.type != "]" {
                pArgs = push(pArgs, parseCompare())
                if pCur.type == "," {
                    bump()
                }
            }
            bump()
            pLeft = { "kind": AST_ARRAY, "elems": pArgs }
        }
    }
    if pLeft == null {
        throw json_stringify(pCur)
    }
    // Bare arrow: a => body
    if pLeft.kind == AST_VAR && pCur.type == "=>" {
        bump()
        let bareParams = [pLeft["sym"]]
        let bareBody = null
        if pCur.type == "{" {
            bump()
            pBodyStack = push(pBodyStack, pBody)
            pBodyDepth = pBodyDepth + 1
            pBody = []
            while pCur.type != "}" {
                if pCur.type == "EOF" {
                    throw "Unclosed arrow block"
                }
                pBody = push(pBody, parseStmt())
                if pCur.type == ";" {
                    bump()
                }
            }
            bump()
            let bb = pBody
            pBody = pBodyStack[pBodyDepth - 1]
            pBodyStack = pop(pBodyStack)
            pBodyDepth = pBodyDepth - 1
            bareBody = { "kind": AST_BLOCK, "body": bb }
        } else {
            bareBody = parseCompare()
        }
        pLeft = { "kind": AST_ARROW, "params": bareParams, "body": bareBody }
    }
    while true {
        if pCur.type == "<" {
            pIsGenericCallee = 0
            if pLeft.kind == AST_VAR {
                pIsGenericCallee = 1
            }
            if pLeft.kind == AST_MEMBER {
                pIsGenericCallee = 1
            }
            if pIsGenericCallee == 1 {
                pSnapTypeArgs = parseTypeArgs()
                if len(pSnapTypeArgs) > 0 {
                    pTypeArgs = pSnapTypeArgs
                } else {
                    break
                }
            } else {
                break
            }
        } else {
            if pCur.type == "(" {
                pCallee = pLeft
                if pCallee.kind == AST_VAR {
                    pCallee = { "kind": AST_VAR, "sym": pCallee["sym"] }
                }
                let savedCallee = pCallee
                let savedTypeArgs = pTypeArgs
                bump()
                pArgs = []
                if pCur.type != ")" {
                    while true {
                        pArgs = push(pArgs, parseCompare())
                        if pCur.type == "," {
                            bump()
                        } else {
                            break
                        }
                    }
                }
                if pCur.type != ")" {
                    throw "Expected )"
                }
                bump()
                pLeft = { "kind": AST_CALL, "callee": savedCallee, "args": pArgs, "typeArgs": savedTypeArgs }
                pTypeArgs = []
            } else {
                if pCur.type == "." {
                    bump()
                    pTok = pCur
                    pMemberName = ""
                    if pTok.type == TOKEN_IDENT {
                        bump()
                        pMemberName = pTok.value
                    } else {
                        if pTok.type == TOKEN_NONE {
                            bump()
                            pMemberName = "None"
                        } else {
                            if pTok.type == TOKEN_SOME {
                                bump()
                                pMemberName = "Some"
                            } else {
                                if pTok.type == TOKEN_OK {
                                    bump()
                                    pMemberName = "Ok"
                                } else {
                                    if pTok.type == TOKEN_ERR {
                                        bump()
                                        pMemberName = "Err"
                                    } else {
                                        throw "Expected member name"
                                    }
                                }
                            }
                        }
                    }
                    pMemberName = poolPush(pMemberName)
                    pLeft = {
                        "kind": AST_MEMBER,
                        "object": pLeft,
                        "field": pMemberName,
                        "typeArgs": pTypeArgs
                    }
                    pTypeArgs = []
                } else {
                    if pCur.type == "[" {
                        bump()
                        let indexObj = pLeft
                        pRight = parseCompare()
                        if pCur.type != "]" {
                            throw "Expected ]"
                        }
                        bump()
                        pLeft = { "kind": AST_INDEX, "object": indexObj, "index": pRight }
                    } else {
                        break
                    }
                }
            }
        }
    }
    return pLeft
}

fn parseUnary() {
    if pCur.type == "!" {
        bump()
        let uInner = parseUnary()
        return { "kind": AST_UNARY, "op": "!", "expr": uInner }
    }
    if pCur.type == "-" {
        bump()
        let uInner = parseUnary()
        return { "kind": AST_UNARY, "op": "-", "expr": uInner }
    }
    if pCur.type == "~" {
        bump()
        let uInner = parseUnary()
        return { "kind": AST_UNARY, "op": "~", "expr": uInner }
    }
    return parsePostfix()
}

fn parseMul() {
    pLeft = parseUnary()
    while pCur.type == "*" || pCur.type == "/" || pCur.type == "%" || pCur.type == "**" {
        pBinOp = pCur.type
        bump()
        pSave = pLeft
        pRight = parseUnary()
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    return pLeft
}

// P6b: mul + iterative +/- + shifts (no compare/bit/&&). Used as RHS of compares.
fn parseAddShift() {
    pLeft = parseMul()
    // P6b: one loop for +/- so `a - b + c` does not leave `+ c` unparsed.
    while pCur.type == "+" || pCur.type == "-" {
        pBinOp = pCur.type
        bump()
        pSave = pLeft
        pRight = parseMul()
        while pCur.type == "<<" || pCur.type == ">>" || pCur.type == ">>>" {
            let shOp = pCur.type
            bump()
            pRight = { "kind": AST_BINARY, "op": shOp, "left": pRight, "right": parseMul() }
        }
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    while pCur.type == "<<" || pCur.type == ">>" || pCur.type == ">>>" {
        pBinOp = pCur.type
        bump()
        pSave = pLeft
        // JS: + binds tighter than << — allow +/- on shift RHS.
        pRight = parseMul()
        while pCur.type == "+" || pCur.type == "-" {
            let addOp = pCur.type
            bump()
            pRight = { "kind": AST_BINARY, "op": addOp, "left": pRight, "right": parseMul() }
        }
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    return pLeft
}

// P6b: compares only (no bit/&&). Used as RHS of &/^/| when pNoBit.
fn parseRelExpr() {
    pLeft = parseAddShift()
    while pCur.type == "==" || pCur.type == "!=" || pCur.type == "<" || pCur.type == ">" || pCur.type == ">=" || pCur.type == "<=" {
        pBinOp = pCur.type
        bump()
        pSave = pLeft
        pRight = parseAddShift()
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    return pLeft
}

fn parseCompare() {
    if pCur.type == "EOF" {
        throw "parseCompare EOF"
    }
    // P6b: fully iterative precedence climb (no right-recursive parseCompare).
    pLeft = parseAddShift()
    if pInAddSub == 1 {
        return pLeft
    }
    while pCur.type == "==" || pCur.type == "!=" || pCur.type == "<" || pCur.type == ">" || pCur.type == ">=" || pCur.type == "<=" {
        pBinOp = pCur.type
        bump()
        pSave = pLeft
        pRight = parseAddShift()
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    if pNoBit == 0 {
        while pCur.type == "&" {
            bump()
            pSave = pLeft
            pRight = parseRelExpr()
            pLeft = { "kind": AST_BINARY, "op": "&", "left": pSave, "right": pRight }
        }
        while pCur.type == "^" {
            bump()
            pSave = pLeft
            pRight = parseRelExpr()
            pLeft = { "kind": AST_BINARY, "op": "^", "left": pSave, "right": pRight }
        }
        while pCur.type == "|" {
            bump()
            pSave = pLeft
            pRight = parseRelExpr()
            pLeft = { "kind": AST_BINARY, "op": "|", "left": pSave, "right": pRight }
        }
    }
    if pNoBit == 1 {
        return pLeft
    }
    while pCur.type == "&&" {
        bump()
        pExprLeft = pLeft
        pRight = parseRelExpr()
        // bit binds tighter — allow &/^/| on && RHS
        if pNoBit == 0 {
            while pCur.type == "&" || pCur.type == "^" || pCur.type == "|" {
                pBinOp = pCur.type
                bump()
                pRight = { "kind": AST_BINARY, "op": pBinOp, "left": pRight, "right": parseRelExpr() }
            }
        }
        pLeft = { "kind": AST_BINARY, "op": "&&", "left": pExprLeft, "right": pRight }
    }
    while pCur.type == "||" {
        bump()
        pExprLeft = pLeft
        // || RHS: &&-chain of rel/bit
        pRight = parseRelExpr()
        if pNoBit == 0 {
            while pCur.type == "&" || pCur.type == "^" || pCur.type == "|" {
                pBinOp = pCur.type
                bump()
                pRight = { "kind": AST_BINARY, "op": pBinOp, "left": pRight, "right": parseRelExpr() }
            }
        }
        while pCur.type == "&&" {
            bump()
            let andLeft = pRight
            let andRight = parseRelExpr()
            if pNoBit == 0 {
                while pCur.type == "&" || pCur.type == "^" || pCur.type == "|" {
                    pBinOp = pCur.type
                    bump()
                    andRight = { "kind": AST_BINARY, "op": pBinOp, "left": andRight, "right": parseRelExpr() }
                }
            }
            pRight = { "kind": AST_BINARY, "op": "&&", "left": andLeft, "right": andRight }
        }
        pLeft = { "kind": AST_BINARY, "op": "||", "left": pExprLeft, "right": pRight }
    }
    return pLeft
}

fn parseStmt() {
    if pCur.type == "EOF" {
        return null
    }
    pIsPub = 0
    if pCur.type == TOKEN_PUB {
        bump()
        pIsPub = 1
    }
    if pCur.type == TOKEN_LET {
        bump()
        pTok = pCur
        if pTok.type != TOKEN_IDENT {
            throw "Expected identifier after let"
        }
        pLetSym = pTok.value
        bump()
        pBindSym = poolPush(pLetSym)
        if pCur.type != "=" {
            throw "Expected ="
        }
        bump()
        pInit = parseCompare()
        return { "kind": AST_LET, "sym": pBindSym, "init": pInit, "isPub": pIsPub }
    }
    // P6b: early IDENT= assign (AccAdd-dense leaves) — before enum/class/fn dispatch.
    if pCur.type == TOKEN_IDENT {
        if pPos + 1 < pToksLen {
            pNextTok = pToks[pPos + 1]
        } else {
            pNextTok = { "type": "EOF", "value": null, "line": 1, "column": 1 }
        }
        if pNextTok.type == "=" {
            pTok = pCur
            pBindSym = poolPush(pTok.value)
            bump()
            bump()
            pVal = parseCompare()
            return { "kind": AST_ASSIGN, "sym": pBindSym, "rhs": pVal }
        }
    }
    if pCur.type == TOKEN_ENUM {
        bump()
        pTok = pCur
        if pTok.type != TOKEN_IDENT {
            throw "Expected enum name"
        }
        bump()
        pEnumSym = pTok.value
        pTypeParams = parseTypeArgs()
        if pCur.type != "{" {
            throw "Expected {"
        }
        bump()
        pVariants = []
        while pCur.type != "}" {
            if pCur.type == "," {
                bump()
            } else {
                pTok = pCur
                pVariantName = ""
                if pTok.type == TOKEN_IDENT {
                    bump()
                    pVariantName = pTok.value
                } else {
                    if pTok.type == TOKEN_NONE {
                        bump()
                        pVariantName = "None"
                    } else {
                        if pTok.type == TOKEN_SOME {
                            bump()
                            pVariantName = "Some"
                        } else {
                            if pTok.type == TOKEN_OK {
                                bump()
                                pVariantName = "Ok"
                            } else {
                                if pTok.type == TOKEN_ERR {
                                    bump()
                                    pVariantName = "Err"
                                } else {
                                    if pTok.type == TOKEN_TRUE {
                                        bump()
                                        pVariantName = "True"
                                    } else {
                                        if pTok.type == TOKEN_FALSE {
                                            bump()
                                            pVariantName = "False"
                                        } else {
                                            throw "Expected variant name"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                pVariantSym = poolPush(pVariantName)
                pVariantFields = []
                if pCur.type == "(" {
                    bump()
                    while pCur.type != ")" {
                        pTok = pCur
                        if pTok.type != TOKEN_IDENT {
                            throw "Expected variant field type"
                        }
                        bump()
                        pVariantFields = push(pVariantFields, poolPush(pTok.value))
                        if pCur.type == "," {
                            bump()
                        }
                    }
                    bump()
                }
                pVariants = push(pVariants, {
                    "name": pVariantSym,
                    "fields": pVariantFields
                })
                if pCur.type == "," {
                    bump()
                }
            }
        }
        bump()
        return { "kind": AST_ENUM, "sym": pEnumSym, "typeParams": pTypeParams, "variants": pVariants }
    }
    if pCur.type == TOKEN_CLASS || pCur.type == TOKEN_STRUCT {
        pIsStruct = 0
        if pCur.type == TOKEN_STRUCT {
            pIsStruct = 1
        }
        bump()
        pTok = pCur
        if pTok.type != TOKEN_IDENT {
            if pIsStruct == 1 {
                throw "Expected struct name"
            }
            throw "Expected class name"
        }
        bump()
        pClassSym = pTok.value
        pTypeParams = parseTypeArgs()
        if pCur.type != "{" {
            throw "Expected {"
        }
        bump()
        pClassFields = []
        pClassMethods = []
        while pCur.type != "}" {
            if pCur.type == TOKEN_FN {
                bump()
                pTok = pCur
                if pTok.type != TOKEN_IDENT {
                    throw "Expected method name"
                }
                bump()
                pFnSym = pTok.value
                pMethTypeParams = parseTypeArgs()
                if pCur.type != "(" {
                    throw "Expected ( at " + ("" + pCur.line) + ":" + ("" + pCur.column) + " tok=" + pCur.type
                }
                bump()
                pMethParams = []
                pMethParamTypes = []
                if pCur.type != ")" {
                    while true {
                        pTok = pCur
                        if pTok.type == TOKEN_SELF {
                            bump()
                            pMethParams = push(pMethParams, poolPush("self"))
                            pMethParamTypes = push(pMethParamTypes, "")
                        } else {
                            if pTok.type != TOKEN_IDENT {
                                throw "Expected parameter name"
                            }
                            bump()
                            pMethParams = push(pMethParams, poolPush(pTok.value))
                            pParamType = ""
                            if pCur.type == ":" {
                                bump()
                                pTok = pCur
                                if pTok.type != TOKEN_IDENT {
                                    throw "Expected parameter type"
                                }
                                bump()
                                pParamType = pTok.value
                            }
                            pMethParamTypes = push(pMethParamTypes, pParamType)
                        }
                        if pCur.type == "," {
                            bump()
                        } else {
                            break
                        }
                    }
                }
                if pCur.type != ")" {
                    throw "Expected )"
                }
                bump()
                if pCur.type != "{" {
                    throw "Expected {"
                }
                bump()
                pBodyStack = push(pBodyStack, pBody)
                pBodyDepth = pBodyDepth + 1
                pBody = []
                while pCur.type != "}" {
                    if pCur.type == "EOF" {
                        throw "Unclosed block"
                    }
                    pBody = push(pBody, parseStmt())
                    if pCur.type == ";" {
                        bump()
                    }
                }
                bump()
                let methBody = pBody
                pBody = pBodyStack[pBodyDepth - 1]
                pBodyStack = pop(pBodyStack)
                pBodyDepth = pBodyDepth - 1
                pVal = {
                    "sym": pFnSym,
                    "typeParams": pMethTypeParams,
                    "params": pMethParams,
                    "paramTypes": pMethParamTypes,
                    "returnType": "",
                    "body": { "kind": AST_BLOCK, "body": methBody }
                }
                pClassMethods = push(pClassMethods, pVal)
            } else {
                pTok = pCur
                if pTok.type != TOKEN_IDENT {
                    throw "Expected field name"
                }
                bump()
                pSaveSym = poolPush(pTok.value)
                pFieldType = ""
                if pCur.type == ":" {
                    bump()
                    pTok = pCur
                    if pTok.type != TOKEN_IDENT {
                        throw "Expected field type"
                    }
                    bump()
                    pFieldType = pTok.value
                }
                pFieldDefault = null
                if pCur.type == "=" {
                    bump()
                    pFieldDefault = parseCompare()
                }
                if pCur.type == ";" {
                    bump()
                }
                pVal = { "name": pSaveSym, "type": pFieldType, "default": pFieldDefault }
                pClassFields = push(pClassFields, pVal)
            }
        }
        bump()
        return {
            "kind": AST_CLASS,
            "sym": pClassSym,
            "typeParams": pTypeParams,
            "fields": pClassFields,
            "methods": pClassMethods,
            "isStruct": pIsStruct
        }
    }
    if pCur.type == TOKEN_INTERFACE || pCur.type == TOKEN_TRAIT {
        bump()
        pTok = pCur
        if pTok.type != TOKEN_IDENT {
            throw "Expected interface/trait name"
        }
        bump()
        pIfaceSym = pTok.value
        pTypeParams = parseTypeArgs()
        if pCur.type != "{" {
            throw "Expected {"
        }
        bump()
        pIfaceMethods = []
        pAssocTypes = []
        while pCur.type != "}" {
            // T5 deepen: `type Item;` associated type
            if pCur.type == TOKEN_IDENT && pCur.value == "type" {
                bump()
                pTok = pCur
                if pTok.type != TOKEN_IDENT {
                    throw "Expected associated type name"
                }
                bump()
                pAssocTypes = push(pAssocTypes, pTok.value)
                if pCur.type != ";" {
                    throw "Expected ; after associated type"
                }
                bump()
            } else {
                if pCur.type != TOKEN_FN {
                    throw "Expected fn in interface"
                }
                bump()
                pTok = pCur
                if pTok.type != TOKEN_IDENT {
                    throw "Expected method name"
                }
                bump()
                pFnSym = pTok.value
                if pCur.type != "(" {
                    throw "Expected ( at " + ("" + pCur.line) + ":" + ("" + pCur.column) + " tok=" + pCur.type
                }
                bump()
                pMethParams = []
                if pCur.type != ")" {
                    while true {
                        pTok = pCur
                        if pTok.type != TOKEN_IDENT {
                            throw "Expected parameter name"
                        }
                        bump()
                        pMethParams = push(pMethParams, poolPush(pTok.value))
                        if pCur.type == "," {
                            bump()
                        } else {
                            break
                        }
                    }
                }
                if pCur.type != ")" {
                    throw "Expected )"
                }
                bump()
                // T5 deepen: default method body `{ ... }` or declaration `;`
                // Snapshot params before body — parseStmt/call reuse module locals.
                let ifaceMethParams = pMethParams
                let ifaceMethSym = pFnSym
                if pCur.type == "{" {
                    bump()
                    pBodyStack = push(pBodyStack, pBody)
                    pBodyDepth = pBodyDepth + 1
                    pBody = []
                    while pCur.type != "}" {
                        if pCur.type == "EOF" {
                            throw "Unclosed default method body"
                        }
                        pBody = push(pBody, parseStmt())
                        if pCur.type == ";" {
                            bump()
                        }
                    }
                    bump()
                    let defBody = pBody
                    pBody = pBodyStack[pBodyDepth - 1]
                    pBodyStack = pop(pBodyStack)
                    pBodyDepth = pBodyDepth - 1
                    pIfaceMethods = push(pIfaceMethods, {
                        "sym": ifaceMethSym,
                        "params": ifaceMethParams,
                        "body": { "kind": AST_BLOCK, "body": defBody }
                    })
                } else {
                    if pCur.type != ";" {
                        throw "Expected ; or default method body"
                    }
                    bump()
                    pIfaceMethods = push(pIfaceMethods, { "sym": ifaceMethSym, "params": ifaceMethParams })
                }
            }
        }
        bump()
        return {
            "kind": AST_INTERFACE,
            "sym": pIfaceSym,
            "typeParams": pTypeParams,
            "methods": pIfaceMethods,
            "associatedTypes": pAssocTypes
        }
    }
    if pCur.type == TOKEN_FN {
        bump()
        pTok = pCur
        if pTok.type != TOKEN_IDENT {
            throw "Expected function name"
        }
        bump()
        pFnSym = pTok.value
        pFnPub = pIsPub
        pTypeParams = parseTypeArgs()
        if pCur.type != "(" {
            throw "Expected ( at " + ("" + pCur.line) + ":" + ("" + pCur.column) + " tok=" + pCur.type
        }
        bump()
        pParams = []
        pParamTypes = []
        if pCur.type != ")" {
            while true {
                pTok = pCur
                if pTok.type != TOKEN_IDENT {
                    throw "Expected parameter name"
                }
                bump()
                pParams = push(pParams, poolPush(pTok.value))
                pParamType = ""
                if pCur.type == ":" {
                    bump()
                    pTok = pCur
                    if pTok.type != TOKEN_IDENT {
                        throw "Expected parameter type"
                    }
                    bump()
                    pParamType = pTok.value
                }
                pParamTypes = push(pParamTypes, pParamType)
                if pCur.type == "," {
                    bump()
                } else {
                    break
                }
            }
        }
        if pCur.type != ")" {
            throw "Expected )"
        }
        bump()
        pReturnType = ""
        if pCur.type == "->" {
            bump()
            pTok = pCur
            if pTok.type != TOKEN_IDENT {
                throw "Expected return type"
            }
            bump()
            pReturnType = pTok.value
        }
        pWhereClause = []
        if pCur.type == TOKEN_WHERE {
            bump()
            while true {
                pTok = pCur
                if pTok.type != TOKEN_IDENT {
                    throw "Expected type parameter in where"
                }
                bump()
                pWhereParam = pTok.value
                if pCur.type != ":" {
                    throw "Expected : in where"
                }
                bump()
                pTok = pCur
                if pTok.type != TOKEN_IDENT {
                    throw "Expected trait name in where"
                }
                bump()
                pWhereTrait = pTok.value
                pWhereClause = push(pWhereClause, {
                    "typeParam": pWhereParam,
                    "traitName": pWhereTrait
                })
                if pCur.type == "," {
                    bump()
                } else {
                    break
                }
            }
        }
        if pCur.type != "{" {
            throw "Expected {"
        }
        bump()
        pBodyStack = push(pBodyStack, pBody)
        pBodyDepth = pBodyDepth + 1
        pBody = []
        while pCur.type != "}" {
            if pCur.type == "EOF" {
                throw "Unclosed block"
            }
            pBody = push(pBody, parseStmt())
            if pCur.type == ";" {
                bump()
            }
        }
        bump()
        let fnBody = pBody
        pBody = pBodyStack[pBodyDepth - 1]
        pBodyStack = pop(pBodyStack)
        pBodyDepth = pBodyDepth - 1
        return {
            "kind": AST_FN,
            "sym": pFnSym,
            "isPub": pFnPub,
            "typeParams": pTypeParams,
            "params": pParams,
            "paramTypes": pParamTypes,
            "returnType": pReturnType,
            "whereClause": pWhereClause,
            "body": { "kind": AST_BLOCK, "body": fnBody }
        }
    }
    if pCur.type == TOKEN_IF {
        bump()
        // Iterative else-if: avoid deep parseStmt recursion (hangs on long chains).
        let chainConds = []
        let chainThens = []
        let finalElse = null
        while true {
            let armCond = parseCompare()
            if pCur.type != "{" {
                throw "Expected {"
            }
            bump()
            pBodyStack = push(pBodyStack, pBody)
            pBodyDepth = pBodyDepth + 1
            pBody = []
            while pCur.type != "}" {
                pBody = push(pBody, parseStmt())
                if pCur.type == ";" {
                    bump()
                }
            }
            bump()
            let armThen = { "kind": AST_BLOCK, "body": pBody }
            pBody = pBodyStack[pBodyDepth - 1]
            pBodyStack = pop(pBodyStack)
            pBodyDepth = pBodyDepth - 1
            chainConds = push(chainConds, armCond)
            chainThens = push(chainThens, armThen)
            if pCur.type != TOKEN_ELSE {
                break
            }
            bump()
            if pCur.type == TOKEN_IF {
                bump()
                continue
            }
            if pCur.type != "{" {
                throw "Expected {"
            }
            bump()
            pBodyStack = push(pBodyStack, pBody)
            pBodyDepth = pBodyDepth + 1
            pBody = []
            while pCur.type != "}" {
                pBody = push(pBody, parseStmt())
                if pCur.type == ";" {
                    bump()
                }
            }
            bump()
            finalElse = { "kind": AST_BLOCK, "body": pBody }
            pBody = pBodyStack[pBodyDepth - 1]
            pBodyStack = pop(pBodyStack)
            pBodyDepth = pBodyDepth - 1
            break
        }
        let i = len(chainConds) - 1
        let ifNode = { "kind": AST_IF, "cond": chainConds[i], "then": chainThens[i], "elseBranch": finalElse }
        i = i - 1
        while i >= 0 {
            ifNode = { "kind": AST_IF, "cond": chainConds[i], "then": chainThens[i], "elseBranch": ifNode }
            i = i - 1
        }
        return ifNode
    }
    if pCur.type == TOKEN_TRY {
        bump()
        if pCur.type != "{" {
            throw "Expected {"
        }
        bump()
        pBodyStack = push(pBodyStack, pBody)
        pBodyDepth = pBodyDepth + 1
        pBody = []
        while pCur.type != "}" {
            if pCur.type == "EOF" {
                throw "Unclosed try"
            }
            pBody = push(pBody, parseStmt())
            if pCur.type == ";" {
                bump()
            }
        }
        bump()
        let tryBody = pBody
        pBody = pBodyStack[pBodyDepth - 1]
        pBodyStack = pop(pBodyStack)
        pBodyDepth = pBodyDepth - 1
        if pCur.type != TOKEN_CATCH {
            throw "Expected catch"
        }
        bump()
        if pCur.type != "(" {
            throw "Expected ( at " + ("" + pCur.line) + ":" + ("" + pCur.column) + " tok=" + pCur.type
        }
        bump()
        pTok = pCur
        if pTok.type != TOKEN_IDENT {
            throw "Expected catch binding"
        }
        bump()
        let errSym = pTok.value
        if pCur.type != ")" {
            throw "Expected )"
        }
        bump()
        if pCur.type != "{" {
            throw "Expected {"
        }
        bump()
        pBodyStack = push(pBodyStack, pBody)
        pBodyDepth = pBodyDepth + 1
        pBody = []
        while pCur.type != "}" {
            if pCur.type == "EOF" {
                throw "Unclosed catch"
            }
            pBody = push(pBody, parseStmt())
            if pCur.type == ";" {
                bump()
            }
        }
        bump()
        let catchBody = pBody
        pBody = pBodyStack[pBodyDepth - 1]
        pBodyStack = pop(pBodyStack)
        pBodyDepth = pBodyDepth - 1
        return {
            "kind": AST_TRY,
            "body": { "kind": AST_BLOCK, "body": tryBody },
            "errName": errSym,
            "handler": { "kind": AST_BLOCK, "body": catchBody }
        }
    }
    if pCur.type == TOKEN_FOR {
        bump()
        pTok = pCur
        if pTok.type != TOKEN_IDENT {
            throw "Expected for-of binding"
        }
        bump()
        let forSym = pTok.value
        if pCur.type != TOKEN_OF {
            throw "Expected of"
        }
        bump()
        let forIter = parseCompare()
        if pCur.type != "{" {
            throw "Expected {"
        }
        bump()
        pBodyStack = push(pBodyStack, pLoopBody)
        pBodyDepth = pBodyDepth + 1
        pLoopBody = []
        while pCur.type != "}" {
            pLoopBody = push(pLoopBody, parseStmt())
            if pCur.type == ";" {
                bump()
            }
        }
        bump()
        let forBody = pLoopBody
        pLoopBody = pBodyStack[pBodyDepth - 1]
        pBodyStack = pop(pBodyStack)
        pBodyDepth = pBodyDepth - 1
        return {
            "kind": AST_FOR_OF,
            "sym": forSym,
            "iterable": forIter,
            "body": { "kind": AST_BLOCK, "body": forBody }
        }
    }
    if pCur.type == TOKEN_WHILE {
        bump()
        pCond = parseCompare()
        pCondStack = push(pCondStack, pCond)
        pCondDepth = pCondDepth + 1
        if pCur.type != "{" {
            throw "Expected {"
        }
        bump()
        pBodyStack = push(pBodyStack, pLoopBody)
        pBodyDepth = pBodyDepth + 1
        pLoopBody = []
        while pCur.type != "}" {
            pLoopBody = push(pLoopBody, parseStmt())
            if pCur.type == ";" {
                bump()
            }
        }
        bump()
        let whileBody = pLoopBody
        pLoopBody = pBodyStack[pBodyDepth - 1]
        pBodyStack = pop(pBodyStack)
        pBodyDepth = pBodyDepth - 1
        pSave = pCondStack[pCondDepth - 1]
        pCondStack = pop(pCondStack)
        pCondDepth = pCondDepth - 1
        return { "kind": AST_WHILE, "cond": pSave, "body": { "kind": AST_BLOCK, "body": whileBody } }
    }
    if pCur.type == TOKEN_CONTINUE {
        bump()
        return { "kind": AST_CONTINUE }
    }
    if pCur.type == TOKEN_BREAK {
        bump()
        return { "kind": AST_BREAK }
    }
    if pCur.type == TOKEN_THROW {
        bump()
        pVal = parseCompare()
        return { "kind": AST_THROW, "expr": pVal }
    }
    if pCur.type == TOKEN_RETURN {
        bump()
        if pCur.type == ";" {
            return { "kind": AST_RETURN, "value": null }
        }
        if pCur.type == "}" {
            return { "kind": AST_RETURN, "value": null }
        }
        if pCur.type == "EOF" {
            return { "kind": AST_RETURN, "value": null }
        }
        pVal = parseCompare()
        return { "kind": AST_RETURN, "value": pVal }
    }
    if pCur.type == "{" {
        bump()
        pBodyStack = push(pBodyStack, pStmts)
        pBodyDepth = pBodyDepth + 1
        pStmts = []
        while pCur.type != "}" {
            if pCur.type == "EOF" {
                throw "Unclosed block"
            }
            pStmts = push(pStmts, parseStmt())
            if pCur.type == ";" {
                bump()
            }
        }
        bump()
        let blockStmts = pStmts
        pStmts = pBodyStack[pBodyDepth - 1]
        pBodyStack = pop(pBodyStack)
        pBodyDepth = pBodyDepth - 1
        return { "kind": AST_BLOCK, "body": blockStmts }
    }
    if pCur.type == TOKEN_IDENT {
        if pPos + 1 < pToksLen {
            pNextTok = pToks[pPos + 1]
        } else {
            pNextTok = { "type": "EOF", "value": null, "line": 1, "column": 1 }
        }
        if pNextTok.type == "=" {
            pTok = pCur
            pBindSym = poolPush(pTok.value)
            bump()
            bump()
            pVal = parseCompare()
            return { "kind": AST_ASSIGN, "sym": pBindSym, "rhs": pVal }
        }
    }
    pAssignLhs = parseCompare()
    if pCur.type == "=" {
        bump()
        // P6b: do not reuse pSave — parseAddShift clobbers pSave while parsing RHS
        // (e.g. `E["a"] = { "x": 1 + 2 }` → false "invalid assign lhs").
        pInit = parseCompare()
        if pAssignLhs.kind == AST_VAR {
            return { "kind": AST_ASSIGN, "sym": pAssignLhs["sym"], "rhs": pInit }
        }
        if pAssignLhs.kind == AST_INDEX {
            return { "kind": AST_INDEX_ASSIGN, "object": pAssignLhs["object"], "index": pAssignLhs["index"], "rhs": pInit }
        }
        if pAssignLhs.kind == AST_MEMBER {
            return { "kind": AST_MEMBER_ASSIGN, "object": pAssignLhs["object"], "field": pAssignLhs["field"], "rhs": pInit }
        }
        throw "invalid assign lhs"
    }
    pVal = pAssignLhs
    return { "kind": AST_EXPR, "expr": pVal }
}

pub fn parseTokensImpl(tokens) {
    // P6b progress: cache token length once per parse (pToksLen hot path).
    pToks = tokens
    pToksLen = len(tokens)
    pPos = 0
    if pToksLen > 0 {
        pCur = pToks[0]
    } else {
        pCur = pEofTok
    }
    pSymPool = []
    pSymN = 0
    pImports = []
    pCondStack = []
    pCondDepth = 0
    pAddLeftStack = []
    pBodyStack = []
    pBodyDepth = 0
    pBodyStack = push(pBodyStack, pBody)
    pBodyDepth = 1
    pBody = []
    pDone = 0
    while pDone == 0 {
        if pPos >= pToksLen {
            pDone = 1
        }
        if pDone == 0 {
            pTok = pCur
            if pTok.type == "EOF" {
                pDone = 1
            }
        }
        if pDone == 0 {
            if pTok.type == TOKEN_IMPORT {
                bump()
                pTok = pCur
                if pTok.type == TOKEN_STRING {
                    bump()
                    pImports = push(pImports, pTok.value)
                }
                if pCur.type == ";" {
                    bump()
                }
            } else {
                pVal = parseStmt()
                if pVal != null {
                    pBody = push(pBody, pVal)
                }
            }
            if pCur.type == ";" {
                bump()
            }
        }
    }
    let programBody = pBody
    pBody = pBodyStack[pBodyDepth - 1]
    pBodyStack = pop(pBodyStack)
    pBodyDepth = pBodyDepth - 1
    return { "kind": AST_PROGRAM, "body": programBody, "imports": pImports }
}
