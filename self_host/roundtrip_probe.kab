// Kabootar-side roundtrip smoke (Rust CI runs deserialize on probe output).
import "self_host/compile"
import "self_host/serialize_defs"

let tText = compile("let x = 1; return x")
if char_at(tText, 0) != "k" {
    throw "roundtrip: bad header"
}
if len(tText) < 30 {
    throw "roundtrip: output too short"
}
println("roundtrip smoke ok")
