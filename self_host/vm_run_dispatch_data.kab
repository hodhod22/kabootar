// P6b: 2-way dispatch chain (≤10s self-host compile).
import "self_host/vm_run_dispatch_data_ab"
import "self_host/vm_run_dispatch_data_cd"

pub fn runOpDataS(S, name, arg, op, pool, globals, functions) {
    let st = runOpDataAb(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpDataCd(S, name, arg, op, pool, globals, functions)
}
