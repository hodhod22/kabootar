// Test suite for the self-hosted bytecode emitter

import "self_host/lexer"
import "self_host/parser"
import "self_host/emit"
import "self_host/emit_defs"
import "self_host/ast_defs"

let passed = 0
let fail = 0
let tI = 0
let tHas = 0

fn assert_eq(a, b, msg) {
    if a == b {
        passed = passed + 1
    } else {
        fail = fail + 1
        println("FAIL: " + msg + " -- expected " + json_stringify(b) + ", got " + json_stringify(a))
    }
}

fn assert_true(v, msg) {
    if v {
        passed = passed + 1
    } else {
        fail = fail + 1
        println("FAIL: " + msg)
    }
}

// -- let + return --------------------------------------------------
{
    let ast = parseTokens(tokenize("let x = 1; return x"))
    let bc = emit(ast)
    assert_eq(len(bc.globals), 1, "one global")
    assert_eq(bc.globals[0], "x", "global name")
    assert_true(emit_op_count(bc) >= 4, "let+return op count")
    assert_eq(bc.ops[len(bc.ops) - 1].op, OP_HALT, "ends with halt")
}

// -- add expression ------------------------------------------------
{
    let ast = parseTokens(tokenize("1 + 2"))
    let bc = emit(ast)
    assert_true(emit_op_count(bc) >= 3, "add emits ops")
    assert_eq(bc.ops[2].op, OP_ADD, "third op is add")
}

// -- if statement --------------------------------------------------
{
    let ast = parseTokens(tokenize("if x == 1 { return 0 }"))
    let bc = emit(ast)
    tHas = 0
    tI = 0
    while tI < len(bc.ops) {
        if bc.ops[tI].op == OP_JUMP_IF_FALSE {
            tHas = 1
        }
        tI = tI + 1
    }
    assert_eq(tHas, 1, "if emits jump_if_false")
}

// -- while loop ----------------------------------------------------
{
    let ast = parseTokens(tokenize("while x == 0 { x = 1 }"))
    let bc = emit(ast)
    tHas = 0
    tI = 0
    while tI < len(bc.ops) {
        if bc.ops[tI].op == OP_JUMP {
            tHas = 1
        }
        tI = tI + 1
    }
    assert_eq(tHas, 1, "while emits jump back")
}

// -- fn body -------------------------------------------------------
{
    let ast = parseTokens(tokenize("fn add(a, b) { return a + b }"))
    let bc = emit(ast)
    assert_eq(len(bc.functions), 1, "one function")
    assert_eq(bc.functions[0].sym, "add", "fn sym")
    assert_true(len(bc.functions[0].ops) >= 3, "fn body op count")
    assert_eq(bc.functions[0].ops[len(bc.functions[0].ops) - 1].op, OP_RETURN, "fn ends with return")
}

// -- fn call -------------------------------------------------------
{
    let ast = parseTokens(tokenize("fn add(a, b) { return a + b }; add(1, 2)"))
    let bc = emit(ast)
    assert_eq(len(bc.functions), 1, "fn call: one function")
    tHas = 0
    tI = 0
    while tI < len(bc.ops) {
        if bc.ops[tI].op == OP_CALL {
            if bc.ops[tI].arg == 2 {
                tHas = 1
            }
        }
        tI = tI + 1
    }
    assert_eq(tHas, 1, "main emits call 2")
}

// -- Report --------------------------------------------------------
println("")
println("Self-hosted emit tests: " + ("" + passed) + " passed, " + ("" + fail) + " failed")
if fail > 0 {
    throw "EMIT TESTS FAILED"
}
