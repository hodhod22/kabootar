// P6b: out-line helpers — pure string threading (skip-listed until ≤10s).
// No module-local serOut: cross-module AccAdd session is unreliable under seed load.
import "self_host/lexer_defs"

pub fn serOutTag(out, tag) {
    let s = out + CHAR_NL
    return s + tag
}

pub fn serOutSpNum(out, x) {
    let s = out + " "
    return s + ("" + x)
}

pub fn serOutSp(out, s) {
    let t = out + " "
    return t + s
}

pub fn serOutTagEq(out, tag, n) {
    let s = serOutTag(out, tag)
    return s + ("" + n)
}

pub fn serOutTagged(out, tag, i, rest) {
    let s = serOutTag(out, tag)
    s = serOutSpNum(s, i)
    return serOutSp(s, rest)
}

pub fn serOutTagged2(out, tag, a, b, rest) {
    let s = serOutTag(out, tag)
    s = serOutSpNum(s, a)
    s = serOutSpNum(s, b)
    return serOutSp(s, rest)
}

pub fn serOutTry5(out, tag, a, b, tr) {
    let s = serOutTag(out, tag)
    s = serOutSpNum(s, a)
    s = serOutSpNum(s, b)
    s = serOutSpNum(s, tr["bodyStart"])
    s = serOutSpNum(s, tr["bodyEnd"])
    s = serOutSpNum(s, tr["catchStart"])
    return serOutSpNum(s, tr["errLocal"])
}

pub fn serOutTry4(out, tag, a, tr) {
    let s = serOutTag(out, tag)
    s = serOutSpNum(s, a)
    s = serOutSpNum(s, tr["bodyStart"])
    s = serOutSpNum(s, tr["bodyEnd"])
    s = serOutSpNum(s, tr["catchStart"])
    return serOutSpNum(s, tr["errLocal"])
}
