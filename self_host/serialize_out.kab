import "self_host/lexer_defs"

// --- serialize_out_base ---
// P6b: base out helpers (skip-listed until ≤10s).

pub fn serOutTag(out, tag) {
    return out + CHAR_NL + tag
}

pub fn serOutSpNum(out, x) {
    return out + " " + ("" + x)
}

pub fn serOutSp(out, s) {
    return out + " " + s
}

pub fn serOutTagEq(out, tag, n) {
    return out + CHAR_NL + tag + ("" + n)
}

// --- serialize_out_tagged ---
// P6b: tagged out helpers (skip-listed until ≤10s).

pub fn serOutTagged(out, tag, i, rest) {
    let s = serOutTag(out, tag)
    s = serOutSpNum(s, i)
    return serOutSp(s, rest)
}

pub fn serOutTagged2(out, tag, a, b, rest) {
    s = serOutSpNum(s, a)
    s = serOutSpNum(s, b)
    return serOutSp(s, rest)
}

// --- serialize_out_try4 ---
// P6b: serOutTry4 (skip-listed until ≤10s).

pub fn serOutTry4(out, tag, a, tr) {
    s = serOutSpNum(s, a)
    s = serOutSpNum(s, tr["bodyStart"])
    s = serOutSpNum(s, tr["bodyEnd"])
    s = serOutSpNum(s, tr["catchStart"])
    return serOutSpNum(s, tr["errLocal"])
}

// --- serialize_out_try5 ---
// P6b: serOutTry5 (skip-listed until ≤10s).

pub fn serOutTry5(out, tag, a, b, tr) {
    s = serOutSpNum(s, a)
    s = serOutSpNum(s, b)
    s = serOutSpNum(s, tr["bodyStart"])
    s = serOutSpNum(s, tr["bodyEnd"])
    s = serOutSpNum(s, tr["catchStart"])
    return serOutSpNum(s, tr["errLocal"])
}

// --- serialize_out_try ---
// P6b: try out-helpers aggregator (attemptable).

pub fn serAppendNamedList(out, zeroTag, eqTag, itemTag, items) {
    if items == undefined {
        return serOutTag(out, zeroTag)
    }
    out = serOutTagEq(out, eqTag, len(items))
    let i = 0
    let n = len(items)
    while i < n {
        out = serOutTagged(out, itemTag, i, items[i])
        i = i + 1
    }
    return out
}
