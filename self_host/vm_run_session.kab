import "self_host/vm_run_restore_mod"
import "self_host/vm_run_prep_fn"
import "self_host/vm_s_stack"

// --- vm_run_alloc_globals ---
pub fn vAllocGlobals(S, n) {
    S["globals"] = []
    let gi = 0
    while gi < n {
        S["globals"] = push(S["globals"], undefined)
        gi = gi + 1
    }
}

// --- vm_run_alloc_locals ---
pub fn vAllocLocals(S, n) {
    S["locals"] = []
    let li = 0
    while li < n {
        S["locals"] = push(S["locals"], undefined)
        li = li + 1
    }
}

// --- vm_run_bind_fns ---
// P6b: bind bytecode fns into S.globals as {vmFn:i}.
pub fn vBindFns(S, globals, functions) {
    let fi = 0
    while fi < len(functions) {
        let sym = functions[fi]["sym"]
        let gi2 = 0
        while gi2 < len(globals) {
            if globals[gi2] == sym {
                S["globals"][gi2] = { "vmFn": fi }
            }
            gi2 = gi2 + 1
        }
        fi = fi + 1
    }
}

// --- vm_run_bind_pairs ---
pub fn vBindImportPairs(S, globals, pairs) {
    let pi = 0
    while pi < len(pairs) {
        let pair = pairs[pi]
        let en = pair[0]
        let host = pair[1]
        let gi3 = 0
        while gi3 < len(globals) {
            if globals[gi3] == en {
                S["globals"][gi3] = host
            }
            gi3 = gi3 + 1
        }
        pi = pi + 1
    }
}

// --- vm_run_fill_hosts ---
// P6b: fill remaining undefined globals from host registry.
pub fn vFillHostGlobals(S, globals) {
    let fillI = 0
    while fillI < len(globals) {
        if globals[fillI] == "iterator_close" {
            S["globals"][fillI] = { "vmIterClose": 1 }
        } else {
            if S["globals"][fillI] == undefined {
            if globals[fillI] == "instanceof" {
                S["globals"][fillI] = { "vmInstof": 1 }
            } else {
                if globals[fillI] == "iterator_begin" {
                    S["globals"][fillI] = { "vmIterBegin": 1 }
                } else {
                    let fillH = bytecode_host_get("" + globals[fillI])
                    if fillH != undefined {
                        S["globals"][fillI] = fillH
                    }
                }
            }
            }
        }
        fillI = fillI + 1
    }
}

pub fn vBindEnums(S, globals, enums) {
    if enums == null || enums == undefined {
        return
    }
    let ei = 0
    while ei < len(enums) {
        let en = enums[ei]
        let name = en["sym"]
        let gi = 0
        while gi < len(globals) {
            if globals[gi] == name {
                S["globals"][gi] = { "vmEnumNs": 1, "typeName": name, "variants": en["variants"] }
            }
            gi = gi + 1
        }
        ei = ei + 1
    }
}

// --- vm_run_hook_fn ---
pub fn vCallRunFn(S, fnDef, pool, globals, functions, callArgs, caps) {
    let prevA = S["_args"]
    let prevK = S["_hook"]
    S["_hook"] = 1
    S["_args"] = [fnDef, pool, globals, functions, callArgs, caps]
    let out = S["runFnBody"]()
    S["_args"] = prevA
    S["_hook"] = prevK
    return out
}

// --- vm_run_hook_meth ---
pub fn vCallRunMeth(S, meth, pool, globals, functions, recv, callArgs) {
    let prevA = S["_args"]
    let prevK = S["_hook"]
    S["_hook"] = 2
    S["_args"] = [meth, pool, globals, functions, recv, callArgs]
    let out = S["runMethodBody"]()
    S["_args"] = prevA
    S["_hook"] = prevK
    return out
}

// --- vm_run_hook_ops ---
pub fn vCallRunOps(S, ops, pool, globals, functions) {
    let prevA = S["_args"]
    let prevK = S["_hook"]
    S["_hook"] = 0
    S["_args"] = [ops, pool, globals, functions]
    S["runOps"]()
    S["_args"] = prevA
    S["_hook"] = prevK
}

pub fn vCallThrowCatchFin(S, ops, pool, globals, functions) {
    let prevA = S["_args"]
    let prevK = S["_hook"]
    S["_hook"] = 3
    S["_args"] = [ops, pool, globals, functions]
    S["runOps"]()
    S["_args"] = prevA
    S["_hook"] = prevK
}

// --- vm_run_reset ---
// P6b: reset main-loop control fields on S.
pub fn vResetExec(S) {
    S["stack"] = []
    S["thisStack"] = []
    S["lastThis"] = null
    S["insts"] = []
    S["ip"] = 0
    S["done"] = false
    S["result"] = null
    S["unsupported"] = false
    S["ipEnd"] = -1
    S["yielded"] = 0
}

// --- vm_run_session ---
pub fn vMakeSession() {
    return {
        "stack": [],
        "locals": [],
        "globals": [],
        "classes": [],
        "arrows": [],
        "tryRegions": [],
        "localNames": [],
        "globalNames": [],
        "thisStack": [],
        "lastThis": null,
        "insts": [],
        "nextInstId": 1,
        "gcUsed": 0,
        "gcCap": 65536,
        "gcCollects": 0,
        "ip": 0,
        "done": false,
        "result": null,
        "unsupported": false
    }
}

// --- vm_run_take_result ---
// P6b: read fn/module result from S after ops.
pub fn vTakeResult(S) {
    let out = S["result"]
    if S["done"] == false {
        if len(S["stack"]) > 0 {
            out = S["stack"][len(S["stack"]) - 1]
        }
    }
    return out
}

// --- vm_run_this_frame ---
/// Push/pop thisStack around a method call (caller supplies runFnBody via return path).
pub fn vPushThis(S, recv) {
    S["thisStack"] = push(S["thisStack"], recv)
}

pub fn vPopThis(S) {
    if len(S["thisStack"]) == 0 {
        S["lastThis"] = undefined
        return undefined
    }
    let topThis = S["thisStack"][len(S["thisStack"]) - 1]
    S["lastThis"] = topThis
    S["thisStack"] = pop(S["thisStack"])
}

// --- vm_run_wire ---
pub fn vWireExec(S, runOps, runFnBody, runMethodBody) {
    S["runOps"] = runOps
    S["runFnBody"] = runFnBody
    S["runMethodBody"] = runMethodBody
}

// --- vm_run_bind_imports ---
pub fn vBindImports(S, globals, imports) {
    let ii = 0
    while ii < len(imports) {
        let pairs = bytecode_host_import("" + imports[ii])
        if pairs != null && pairs != undefined {
            vBindImportPairs(S, globals, pairs)
        }
        ii = ii + 1
    }
}

pub fn vMakeGeneratorS(S, fnDef, idx, callArgs) {
    let old = vSaveFnFrame(S)
    vPrepareFnLocals(S, fnDef, callArgs, null)
    let g = {
        "vmGen": 1,
        "idx": idx,
        "ip": 0,
        "locals": S["locals"],
        "stack": [],
        "done": 0,
        "started": 0
    }
    g["next"] = { "vmGenNext": 1, "vmR": g }
    g["return"] = { "vmGenReturn": 1, "vmR": g }
    g["throw"] = { "vmGenThrow": 1, "vmR": g }
    vRestoreFnFrame(S, old)
    vPublishGenS(S, g)
    return g
}

pub fn vSyncGenRecvS(g) {
    if g == undefined || g == null {
        return
    }
    let nx = g["next"]
    if nx != undefined {
        let rg = nx["vmR"]
        if rg != undefined {
            if rg != g {
                rg["ip"] = g["ip"]
                rg["locals"] = g["locals"]
                rg["stack"] = g["stack"]
                rg["ysdel"] = g["ysdel"]
                rg["done"] = g["done"]
                rg["started"] = g["started"]
                rg["closing"] = g["closing"]
                rg["closeRet"] = g["closeRet"]
            }
        }
    }
    let gr = g["return"]
    if gr != undefined {
        let rr = gr["vmR"]
        if rr != undefined {
            if rr != g {
                rr["ip"] = g["ip"]
                rr["locals"] = g["locals"]
                rr["stack"] = g["stack"]
                rr["ysdel"] = g["ysdel"]
                rr["done"] = g["done"]
                rr["started"] = g["started"]
                rr["closing"] = g["closing"]
                rr["closeRet"] = g["closeRet"]
            }
        }
    }
    let gt = g["throw"]
    if gt != undefined {
        let tr = gt["vmR"]
        if tr != undefined {
            if tr != g {
                tr["ip"] = g["ip"]
                tr["locals"] = g["locals"]
                tr["stack"] = g["stack"]
                tr["ysdel"] = g["ysdel"]
                tr["done"] = g["done"]
                tr["started"] = g["started"]
                tr["closing"] = g["closing"]
                tr["closeRet"] = g["closeRet"]
            }
        }
    }
    return
}

pub fn vLiveGenS(g) {
    if g == undefined || g == null {
        return g
    }
    let nx = g["next"]
    if nx != undefined {
        let rg = nx["vmR"]
        if rg != undefined {
            if rg["ip"] > g["ip"] {
                return rg
            }
            if g["ip"] == 0 {
                if rg["started"] == 1 {
                    return rg
                }
                if rg["ip"] > 0 {
                    return rg
                }
            }
        }
    }
    return g
}

pub fn vRetargetGenMethodsS(oldg, g) {
    if oldg == undefined {
        return
    }
    if oldg == null {
        return
    }
    let nx = oldg["next"]
    if nx != undefined {
        nx["vmR"] = g
    }
    let gr = oldg["return"]
    if gr != undefined {
        gr["vmR"] = g
    }
    let gt = oldg["throw"]
    if gt != undefined {
        gt["vmR"] = g
    }
    return
}

pub fn vPublishGenS(S, g) {
    let nid = vInstId(g)
    if nid == undefined {
        nid = S["nextInstId"]
        if nid == undefined {
            nid = 1
        }
        S["nextInstId"] = nid + 1
        g["vmI"] = nid
    }
    vHeapPut(S, g)
    vRetargetGenMethodsS(g, g)
    return
}

pub fn vMarkGenClosingS(S, g, retV) {
    let nid = vInstId(g)
    if nid == undefined {
        vPublishGenS(S, g)
        nid = vInstId(g)
    }
    let m = S["genClose"]
    if m == undefined {
        m = {}
    }
    m["" + nid] = { "c": 1, "v": retV }
    S["genClose"] = m
    g["closing"] = 1
    g["closeRet"] = retV
    return
}

pub fn vApplyGenClosingS(S, g) {
    let nid = vInstId(g)
    let m = S["genClose"]
    if m == undefined {
        return g
    }
    if nid == undefined {
        return g
    }
    let e = m["" + nid]
    if e == undefined {
        return g
    }
    if e["c"] == 1 {
        g["closing"] = 1
        g["closeRet"] = e["v"]
    }
    return g
}

/// Copy generator frame into S. Do not assign tryRegions here — that breaks yield pause on .next().
pub fn vPrepGeneratorResumeS(S, g, fnDef) {
    S["stack"] = g["stack"]
    S["locals"] = g["locals"]
    S["localNames"] = fnDef["locals"]
    S["ip"] = g["ip"]
    S["done"] = false
    S["yielded"] = 0
    S["result"] = null
    S["unsupported"] = false
    S["ipEnd"] = -1
    S["ysdel"] = g["ysdel"]
    if S["ysdel"] == undefined {
        S["ysdel"] = null
    }
    let gfa = fnDef["arrows"]
    if gfa != undefined {
        if len(gfa) > 0 {
            S["arrows"] = gfa
        }
    }
}

pub fn vFinishGeneratorStepS(S, g, old) {
    if S["unsupported"] == true {
        vRestoreFnFrame(S, old)
        throw "vm unsupported opcode in generator"
    }
    if S["yielded"] == 1 {
        g["ip"] = S["ip"]
        g["locals"] = S["locals"]
        g["stack"] = S["stack"]
        g["ysdel"] = S["ysdel"]
        vSyncGenRecvS(g)
        let v = S["yieldVal"]
        vRestoreFnFrame(S, old)
        vPublishGenS(S, g)
        return { "value": v, "done": false }
    }
    g["done"] = 1
    let out = vTakeResult(S)
    vSyncGenRecvS(g)
    vRestoreFnFrame(S, old)
    vPublishGenS(S, g)
    return { "value": out, "done": true }
}

/// Call iterator next/return/throw with `this` = iterator and writeback.
pub fn vCallBoundIterFnS(S, it, fnObj, args, pool, globals, functions) {
    vPushThis(S, it)
    let out = null
    let err = null
    try {
        if vObjGet(fnObj, "vmFn") != undefined {
            out = runFnBodyS(S, functions[fnObj["vmFn"]], pool, globals, functions, args, null)
        } else {
            let adef = vObjGet(fnObj, "arrowDef")
            if adef == undefined {
                adef = S["arrows"][fnObj["vmArrow"]]
            }
            out = runFnBodyS(S, adef, pool, globals, functions, args, vObjGet(fnObj, "caps"))
        }
    } catch (e) {
        err = e
    }
    let updated = vPopThis(S)
    vWritebackAfterMethodS(S, it, updated)
    if err != null {
        throw err
    }
    return out
}

pub fn vCallIterReturnS(S, it, pool, globals, functions, retArgs) {
    let wrapDel = vObjGet(it, "__kab_iter_delegate")
    if wrapDel != undefined {
        it = wrapDel
    }
    if retArgs == undefined {
        retArgs = []
    }
    let retf = vObjGet(it, "return")
    if retf == undefined {
        retf = vIndexGet(it, "return")
    }
    if vObjGet(retf, "vmFn") != undefined {
        return vCallBoundIterFnS(S, it, retf, retArgs, pool, globals, functions)
    }
    if vObjGet(retf, "vmArrow") != undefined {
        return vCallBoundIterFnS(S, it, retf, retArgs, pool, globals, functions)
    }
    return vCallHost(bytecode_host_get("iterator_close"), [it])
}

pub fn vFindFinallyForReturn(fnDef, ip) {
    let tr = fnDef["tryRegions"]
    if tr == undefined {
        return null
    }
    let best = vPickFinallyRegion(tr, ip)
    if best != null {
        return best
    }
    let k = 1
    while k < 4 {
        let ipk = ip - k
        if ipk < 0 {
            ipk = 0
        }
        let cand = vPickFinallyRegion(tr, ipk)
        if cand != null {
            if ip < cand["catchStart"] {
                return cand
            }
        }
        k = k + 1
    }
    return null
}

pub fn vPickFinallyRegion(tr, ip) {
    let best = null
    let i = 0
    while i < len(tr) {
        let r = tr[i]
        if ip >= r["bodyStart"] {
            if ip < r["catchStart"] {
                if best == null || r["bodyStart"] >= best["bodyStart"] {
                    best = r
                }
            }
        }
        i = i + 1
    }
    return best
}

pub fn vRunFinallyThenCloseS(S, g, finR, retV, pool, globals, functions) {
    let fnDef = functions[g["idx"]]
    let old = vSaveFnFrame(S)
    S["curGen"] = g
    vPrepGeneratorResumeS(S, g, fnDef)
    S["ysdel"] = null
    S["ipEnd"] = -1
    S["done"] = false
    let opsF = fnDef["ops"]
    let bi = finR["bodyEnd"]
    if bi < len(opsF) {
        if ("" + opsF[bi]["op"]) == "jump" {
            let ja = opsF[bi]["arg"]
            if ja >= 0 {
                S["ip"] = bi + 1 + ja
            }
        }
    }
    vCallRunOps(S, fnDef["ops"], pool, globals, functions)
    S["ipEnd"] = -1
    if S["unsupported"] == true {
        vRestoreFnFrame(S, old)
        S["curGen"] = null
        throw "vm unsupported opcode in generator"
    }
    if S["yielded"] == 1 {
        g["ip"] = S["ip"]
        g["locals"] = S["locals"]
        g["stack"] = S["stack"]
        if g["closing"] == 1 {
            g["closeRet"] = retV
            vMarkGenClosingS(S, g, retV)
        }
        vSyncGenRecvS(g)
        vPublishGenS(S, g)
        let v = S["yieldVal"]
        vRestoreFnFrame(S, old)
        S["curGen"] = null
        return { "value": v, "done": false }
    }
    g["ysdel"] = null
    g["done"] = 1
    vRestoreFnFrame(S, old)
    S["curGen"] = null
    return { "value": retV, "done": true }
}

/// Close a yield* delegate without vLiveGenS (must not alias the parent generator).
pub fn vCloseDelegateGenS(S, g, ordered, pool, globals, functions) {
    if g["done"] == 1 {
        return { "value": null, "done": true }
    }
    if g["done"] == true {
        return { "value": null, "done": true }
    }
    let retV = null
    if len(ordered) > 0 {
        retV = ordered[0]
    }
    let fnDefC = functions[g["idx"]]
    let finR = vFindFinallyForReturn(fnDefC, g["ip"])
    if finR != null {
        g["closing"] = 1
        g["closeRet"] = retV
        return vRunFinallyThenCloseS(S, g, finR, retV, pool, globals, functions)
    }
    g["done"] = 1
    return { "value": retV, "done": true }
}

pub fn vCloseGeneratorS(S, g, ordered, pool, globals, functions) {
    let given = g
    g = vLiveGenS(g)
    if g["idx"] != given["idx"] {
        g = given
    }
    if g["done"] == 1 {
        return { "value": null, "done": true }
    }
    if g["done"] == true {
        return { "value": null, "done": true }
    }
    if g["closing"] == 1 {
        let early = null
        if len(ordered) > 0 {
            early = ordered[0]
        }
        g["done"] = 1
        return { "value": early, "done": true }
    }
    g["closing"] = 1
    let retV = null
    if len(ordered) > 0 {
        retV = ordered[0]
    }
    g["closeRet"] = retV
    vMarkGenClosingS(S, g, retV)
    let del = g["ysdel"]
    if del == undefined {
        del = S["ysdel"]
    }
    S["curGen"] = g
    let fnDefC = functions[g["idx"]]
    let faC = fnDefC["arrows"]
    if faC != undefined {
        if len(faC) > 0 {
            S["arrows"] = faC
        }
    }
    if del != g {
        if vObjGet(del, "vmGen") == 1 {
            let keepC = g["closing"]
            let keepR = g["closeRet"]
            let rDel = vCloseDelegateGenS(S, del, ordered, pool, globals, functions)
            g["closing"] = keepC
            g["closeRet"] = keepR
            vMarkGenClosingS(S, g, keepR)
            if rDel["done"] != true {
                if rDel["done"] != 1 {
                    return rDel
                }
            }
            g["ysdel"] = null
        } else {
            if vObjGet(del, "vmGen") == true {
                let keepC2 = g["closing"]
                let keepR2 = g["closeRet"]
                let rDel2 = vCloseDelegateGenS(S, del, ordered, pool, globals, functions)
                g["closing"] = keepC2
                g["closeRet"] = keepR2
                vMarkGenClosingS(S, g, keepR2)
                if rDel2["done"] != true {
                    if rDel2["done"] != 1 {
                        return rDel2
                    }
                }
                g["ysdel"] = null
            } else {
                if del != null {
                    if del != undefined {
                        let rRet = null
                        let retErr = null
                        try {
                            rRet = vCallIterReturnS(S, del, pool, globals, functions, ordered)
                        } catch (eRet) {
                            retErr = eRet
                        }
                        if retErr != null {
                            g["ysdel"] = null
                            g["closing"] = 0
                            return vThrowGeneratorS(S, g, [retErr], pool, globals, functions)
                        }
                        let wrapR = vObjGet(del, "__kab_iter_delegate")
                        let delR = del
                        if wrapR != undefined {
                            delR = wrapR
                        }
                        let retf = vObjGet(delR, "return")
                        if retf == undefined {
                            retf = vIndexGet(delR, "return")
                        }
                        if vObjGet(retf, "vmFn") != undefined {
                            return vFinishIterThrowS(S, g, rRet, pool, globals, functions)
                        }
                        if vObjGet(retf, "vmArrow") != undefined {
                            return vFinishIterThrowS(S, g, rRet, pool, globals, functions)
                        }
                    }
                }
            }
        }
    }
    g["ysdel"] = null
    let finR = vFindFinallyForReturn(fnDefC, g["ip"])
    if finR != null {
        return vRunFinallyThenCloseS(S, g, finR, retV, pool, globals, functions)
    }
    g["done"] = 1
    return { "value": retV, "done": true }
}

pub fn vNoteYsDelS(S, it) {
    S["ysdel"] = it
    let cg = S["curGen"]
    if cg != undefined {
        if cg != null {
            cg["ysdel"] = it
            let gn = cg["next"]
            if gn != undefined {
                gn["vmR"] = cg
            }
            let gr = cg["return"]
            if gr != undefined {
                gr["vmR"] = cg
            }
            let gt = cg["throw"]
            if gt != undefined {
                gt["vmR"] = cg
            }
        }
    }
}

pub fn vResumeGeneratorS(S, g, ordered, pool, globals, functions) {
    g = vLiveGenS(g)
    g = vApplyGenClosingS(S, g)
    if g["done"] == 1 {
        return { "value": null, "done": true }
    }
    if g["done"] == true {
        return { "value": null, "done": true }
    }
    if g["closing"] == 1 {
        let delR = g["ysdel"]
        if vObjGet(delR, "vmGen") == 1 {
            if delR["done"] != 1 {
                if delR["done"] != true {
                    let rInner = vResumeGeneratorS(S, delR, ordered, pool, globals, functions)
                    if rInner["done"] != true {
                        if rInner["done"] != 1 {
                            return rInner
                        }
                    }
                    g["ysdel"] = null
                }
            }
        } else {
            if vObjGet(delR, "vmGen") == true {
                if delR["done"] != 1 {
                    if delR["done"] != true {
                        let rInner2 = vResumeGeneratorS(S, delR, ordered, pool, globals, functions)
                        if rInner2["done"] != true {
                            if rInner2["done"] != 1 {
                                return rInner2
                            }
                        }
                        g["ysdel"] = null
                    }
                }
            }
        }
        let fnDefC = functions[g["idx"]]
        let finR = vFindFinallyForReturn(fnDefC, g["ip"])
        if finR != null {
            if g["ip"] < finR["catchStart"] {
                return vRunFinallyThenCloseS(S, g, finR, g["closeRet"], pool, globals, functions)
            }
        }
        g["done"] = 1
        let doneV = g["closeRet"]
        return { "value": doneV, "done": true }
    }
    let fnDef = functions[g["idx"]]
    let oldCg = S["curGen"]
    let old = vSaveFnFrame(S)
    S["curGen"] = g
    vPrepGeneratorResumeS(S, g, fnDef)
    S["ysdel"] = g["ysdel"]
    let gn = g["next"]
    if gn != undefined {
        gn["vmR"] = g
    }
    if g["ip"] > 0 {
        let send = undefined
        if ordered != undefined {
            if len(ordered) > 0 {
                send = ordered[0]
            }
        }
        vPushS(S, send)
    }
    g["started"] = 1
    let err = null
    try {
        vCallRunOps(S, fnDef["ops"], pool, globals, functions)
    } catch (e) {
        err = e
    }
    if err != null {
        g["done"] = 1
        vRestoreFnFrame(S, old)
        S["curGen"] = oldCg
        throw err
    }
    if S["unsupported"] == true {
        vRestoreFnFrame(S, old)
        S["curGen"] = oldCg
        throw "vm unsupported opcode in generator"
    }
    if S["yielded"] == 1 {
        g["ip"] = S["ip"]
        g["locals"] = S["locals"]
        g["stack"] = S["stack"]
        g["ysdel"] = S["ysdel"]
        vSyncGenRecvS(g)
        vPublishGenS(S, g)
        let v = S["yieldVal"]
        vRestoreFnFrame(S, old)
        S["curGen"] = oldCg
        S["done"] = false
        return { "value": v, "done": false }
    }
    if g["closing"] != 1 {
        g["ip"] = S["ip"]
        g["locals"] = S["locals"]
        g["stack"] = S["stack"]
        let finMore = vFindFinallyForReturn(fnDef, S["ip"])
        if finMore != null {
            let moreV = vTakeResult(S)
            if moreV != undefined {
                g["closeRet"] = moreV
                g["closing"] = 1
            }
            vRestoreFnFrame(S, old)
            S["curGen"] = oldCg
            return vRunFinallyThenCloseS(S, g, finMore, moreV, pool, globals, functions)
        }
    }
    g["done"] = 1
    let out = vTakeResult(S)
    if g["closing"] == 1 {
        out = g["closeRet"]
    }
    vRestoreFnFrame(S, old)
    S["curGen"] = oldCg
    S["done"] = false
    return { "value": out, "done": true }
}

pub fn vResumeYsThrowDoneS(S, g, rTh, pool, globals, functions) {
    let fnDef = functions[g["idx"]]
    g["ysdel"] = null
    let old = vSaveFnFrame(S)
    S["curGen"] = g
    vPrepGeneratorResumeS(S, g, fnDef)
    S["ysdel"] = null
    let ops = fnDef["ops"]
    let ip0 = S["ip"]
    let i = ip0
    let found = 0
    while i < len(ops) {
        if found == 0 {
            let on = "" + ops[i]["op"]
            if on == "jump" {
                let ja = ops[i]["arg"]
                if ja > 0 {
                    let loopEnd = i + 1 + ja
                    if loopEnd < len(ops) {
                        let resIdx = ops[loopEnd]["arg"]
                        S["locals"][resIdx] = rTh
                    }
                    S["ip"] = loopEnd
                    found = 1
                }
            }
        }
        i = i + 1
    }
    S["stack"] = []
    g["locals"] = S["locals"]
    vCallRunOps(S, fnDef["ops"], pool, globals, functions)
    if S["unsupported"] == true {
        vRestoreFnFrame(S, old)
        throw "vm unsupported opcode in generator"
    }
    if S["yielded"] == 1 {
        g["ip"] = S["ip"]
        g["locals"] = S["locals"]
        g["stack"] = S["stack"]
        g["ysdel"] = S["ysdel"]
        let v = S["yieldVal"]
        vRestoreFnFrame(S, old)
        return { "value": v, "done": false }
    }
    g["done"] = 1
    let out = vTakeResult(S)
    vRestoreFnFrame(S, old)
    return { "value": out, "done": true }
}

pub fn vFinishIterThrowS(S, g, rTh, pool, globals, functions) {
    if rTh == undefined {
        return rTh
    }
    let d = rTh["done"]
    if d == undefined {
        d = vIndexGet(rTh, "done")
    }
    if d == true {
        return vResumeYsThrowDoneS(S, g, rTh, pool, globals, functions)
    }
    if d == 1 {
        return vResumeYsThrowDoneS(S, g, rTh, pool, globals, functions)
    }
    return rTh
}

pub fn vThrowGeneratorS(S, g, ordered, pool, globals, functions) {
    let given = g
    g = vLiveGenS(g)
    if g["idx"] != given["idx"] {
        g = given
    }
    if g["done"] == 1 {
        return { "value": null, "done": true }
    }
    if g["done"] == true {
        return { "value": null, "done": true }
    }
    let del = g["ysdel"]
    let oldCg = S["curGen"]
    S["curGen"] = g
    let fnDefT = functions[g["idx"]]
    let faT = fnDefT["arrows"]
    if faT != undefined {
        if len(faT) > 0 {
            S["arrows"] = faT
        }
    }
    let delErr = null
    if del != g {
        if vObjGet(del, "vmGen") == 1 {
            let rDel = null
            try {
                rDel = vThrowGeneratorS(S, del, ordered, pool, globals, functions)
            } catch (eDel) {
                delErr = eDel
            }
            if delErr == null {
                if rDel["done"] != true {
                    if rDel["done"] != 1 {
                        S["curGen"] = oldCg
                        return rDel
                    }
                }
            }
            g["ysdel"] = null
        } else {
            if vObjGet(del, "vmGen") == true {
                let rDel2 = null
                try {
                    rDel2 = vThrowGeneratorS(S, del, ordered, pool, globals, functions)
                } catch (eDel2) {
                    delErr = eDel2
                }
                if delErr == null {
                    if rDel2["done"] != true {
                        if rDel2["done"] != 1 {
                            S["curGen"] = oldCg
                            return rDel2
                        }
                    }
                }
                g["ysdel"] = null
            } else {
                if del != null {
                    if del != undefined {
                        let wrapDel = vObjGet(del, "__kab_iter_delegate")
                        if wrapDel != undefined {
                            del = wrapDel
                        }
                        let th = vObjGet(del, "throw")
                        if th == undefined {
                            th = vIndexGet(del, "throw")
                        }
                        let reason0 = null
                        if len(ordered) > 0 {
                            reason0 = ordered[0]
                        }
                        if vObjGet(th, "vmFn") != undefined {
                            let rThFn = null
                            try {
                                rThFn = vFinishIterThrowS(S, g, vCallBoundIterFnS(S, del, th, [reason0], pool, globals, functions), pool, globals, functions)
                            } catch (eThFn) {
                                delErr = eThFn
                            }
                            if delErr == null {
                                S["curGen"] = oldCg
                                return rThFn
                            }
                            g["ysdel"] = null
                        } else {
                            if vObjGet(th, "vmArrow") != undefined {
                                let rThAr = null
                                try {
                                    rThAr = vFinishIterThrowS(S, g, vCallBoundIterFnS(S, del, th, [reason0], pool, globals, functions), pool, globals, functions)
                                } catch (eThAr) {
                                    delErr = eThAr
                                }
                                if delErr == null {
                                    S["curGen"] = oldCg
                                    return rThAr
                                }
                                g["ysdel"] = null
                            }
                        }
                    }
                }
            }
        }
    }
    let reason = null
    if delErr != null {
        reason = delErr
    } else {
        if len(ordered) > 0 {
            reason = ordered[0]
        }
    }
    let fnDef = functions[g["idx"]]
    let old = vSaveFnFrame(S)
    vPrepGeneratorResumeS(S, g, fnDef)
    S["ipEnd"] = -1
    S["done"] = false
    let tr = fnDef["tryRegions"]
    if tr == undefined {
        tr = []
    }
    S["tryRegions"] = tr
    let saveIp = S["ip"]
    let best = null
    let d = 0
    while d <= 3 {
        if saveIp >= d {
            let r = vFindTry(tr, saveIp - d)
            if r != null {
                if best == null || r["bodyStart"] >= best["bodyStart"] {
                    best = r
                }
            }
        }
        d = d + 1
    }
    let caught = 0
    if best != null {
        let el = best["errLocal"]
        vPadLocalsTo(S, el)
        S["locals"][el] = reason
        vPushS(S, reason)
        S["ip"] = best["catchStart"]
        caught = 1
    }
    if caught != 1 {
        g["done"] = 1
        vRestoreFnFrame(S, old)
        S["curGen"] = oldCg
        throw reason
    }
    let opsT = fnDef["ops"]
    let runErr = null
    try {
        vCallThrowCatchFin(S, opsT, pool, globals, functions)
    } catch (e) {
        runErr = e
    }
    if runErr != null {
        g["done"] = 1
        vRestoreFnFrame(S, old)
        S["curGen"] = oldCg
        throw runErr
    }
    let step = vFinishGeneratorStepS(S, g, old)
    S["curGen"] = oldCg
    return step
}

// --- vm_run_fn_body ---
pub fn runFnBodyS(S, fnDef, pool, globals, functions, callArgs, caps) {
    let old = vSaveFnFrame(S)
    vPrepareFnLocals(S, fnDef, callArgs, caps)
    let bodyArrows = fnDef["arrows"]
    if bodyArrows != undefined {
        if len(bodyArrows) > 0 {
            S["arrows"] = bodyArrows
        }
    }
    vCallRunOps(S, fnDef["ops"], pool, globals, functions)
    let out = vTakeResult(S)
    let bad = S["unsupported"]
    vRestoreFnFrame(S, old)
    if bad {
        throw "vm unsupported opcode in fn"
    }
    return out
}

// --- vm_run_meth_body ---
pub fn runMethodBodyS(S, meth, pool, globals, functions, recv, callArgs) {
    vPushThis(S, recv)
    let out = null
    let err = null
    try {
        let mpool = meth["constants"]
        if mpool == undefined {
            mpool = pool
        }
        if len(mpool) == 0 {
            mpool = pool
        }
        out = vCallRunFn(S, meth, mpool, globals, functions, callArgs, null)
    } catch (e) {
        err = e
    }
    vPopThis(S)
    if err != null {
        throw err
    }
    return out
}
