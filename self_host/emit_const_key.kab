import "self_host/ast_defs"
import "self_host/emit_defs"

pub fn constKey(E, arg) {
    if arg == KAB_UNDEF_CONST {
        return "U"
    }
    if arg == null {
        return "N"
    }
    if arg == true {
        return "T"
    }
    if arg == false {
        return "F"
    }
    let t = typeof(arg)
    if t == "string" {
        return "S" + ("" + len(arg)) + ":" + arg
    }
    if t == "number" {
        return "D" + ("" + arg)
    }
    return "X" + ("" + arg)
}

