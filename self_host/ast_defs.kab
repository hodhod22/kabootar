// P6b: parser trampoline hooks (shared AccAdd path; was parser_hooks).
pub fn pCallHook(sess, n) {
    let prevH = sess["_hook"]
    sess["_hook"] = n
    let r = sess["tramp"](sess)
    sess["_hook"] = prevH
    return r
}

pub fn pCallPostfix(sess) {
    return pCallHook(sess, 0)
}

pub fn pCallTypeArgs(sess) {
    return pCallHook(sess, 1)
}

pub fn pCallUnary(sess) {
    return pCallHook(sess, 2)
}

pub fn pCallMul(sess) {
    return pCallHook(sess, 3)
}

pub fn pCallAddShift(sess) {
    return pCallHook(sess, 4)
}

pub fn pCallRelExpr(sess) {
    return pCallHook(sess, 5)
}

pub fn pCallCompare(sess) {
    return pCallHook(sess, 6)
}

pub fn pCallStmt(sess) {
    return pCallHook(sess, 7)
}

pub fn pCallMatchPat(sess) {
    return pCallHook(sess, 8)
}

pub fn peek(sess) {
    return sess["pCur"]
}

pub fn bump(sess) {
    sess["pTok"] = sess["pCur"]
    let pos = sess["pPos"]
    let n = sess["pToksLen"]
    if pos < n {
        pos = pos + 1
        sess["pPos"] = pos
        if pos < n {
            sess["pCur"] = sess["pToks"][pos]
        } else {
            sess["pCur"] = sess["pEofTok"]
        }
    }
    return sess["pTok"]
}

pub fn poolPush(sess, v) {
    sess["pSymPool"] = push(sess["pSymPool"], v)
    sess["pSymN"] = sess["pSymN"] + 1
    return v
}

pub fn pEnterBody(sess) {
    // Assign-back (not object_array_push): sess is Rc-shared across tramp calls.
    sess["pBodyStack"] = push(sess["pBodyStack"], sess["pBody"])
    sess["pBodyDepth"] = sess["pBodyDepth"] + 1
    sess["pBody"] = []
    return 0
}

pub fn pLeaveBody(sess) {
    let body = sess["pBody"]
    let st = sess["pBodyStack"]
    let n = len(st)
    sess["pBody"] = st[n - 1]
    sess["pBodyStack"] = slice(st, 0, n - 1)
    sess["pBodyDepth"] = sess["pBodyDepth"] - 1
    return body
}

pub fn pParseBodyUntilRBrace(sess, eofMsg) {
    while sess["pCur"].type != "}" {
        if sess["pCur"].type == "EOF" {
            throw eofMsg
        }
        let stmt = pCallStmt(sess)
        sess["pBody"] = push(sess["pBody"], stmt)
        if sess["pCur"].type == ";" {
            bump(sess)
        }
    }
    bump(sess)
    return 0
}

pub fn pEnterLoopBody(sess) {
    sess["pBodyStack"] = push(sess["pBodyStack"], sess["pLoopBody"])
    sess["pBodyDepth"] = sess["pBodyDepth"] + 1
    sess["pLoopBody"] = []
    return 0
}

pub fn pLeaveLoopBody(sess) {
    let body = sess["pLoopBody"]
    let st = sess["pBodyStack"]
    let n = len(st)
    sess["pLoopBody"] = st[n - 1]
    sess["pBodyStack"] = slice(st, 0, n - 1)
    sess["pBodyDepth"] = sess["pBodyDepth"] - 1
    return body
}

pub fn pParseLoopUntilRBrace(sess) {
    while sess["pCur"].type != "}" {
        let stmt = pCallStmt(sess)
        sess["pLoopBody"] = push(sess["pLoopBody"], stmt)
        if sess["pCur"].type == ";" {
            bump(sess)
        }
    }
    bump(sess)
    return 0
}
