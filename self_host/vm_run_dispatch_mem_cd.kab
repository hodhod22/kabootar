// P6b: 2-way dispatch chain (≤10s self-host compile).
import "self_host/vm_ops_mem_c"
import "self_host/vm_ops_mem_d"

pub fn runOpMemCd(S, name, arg, op, pool, globals, functions) {
    let st = runOpMemC(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpMemD(S, name, arg, op, pool, globals, functions)
}
