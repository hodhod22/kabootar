// Self-hosted bytecode emitter - produces opcode IR from AST.
// Emitter scratch slots are module-level (Kabootar fn locals are not re-entrant).
import "self_host/ast_defs"
import "self_host/emit_defs"

let eConsts = []
let eOps = []
let eGlobals = []
let eFnOps = []
let eFnGlobals = []
let eFnLocals = []
let eInFn = 0
let eIdx = 0
let eSym = null
let eJmp = 0
let eEnd = 0
let eNode = null
let eProg = 0
let eLeft = null
let eRight = null
let eOp = ""
let eBinOp = ""
let eBinOpStack = []
let eBinRStack = []
let eBinaryL = null
let eBinaryR = null
let eCond = null
let eThen = null
let eElse = null
let eCondStack = []
let eThenStack = []
let eElseStack = []
let eProgram = null
let eFunctions = []
let eParams = []
let eFnBody = null
let eFnName = ""
let eBxL = null
let eBxR = null
let eBxRhs = null
let eArgs = []
let eCallee = null
let eCallI = 0
let eArgN = 0
let eLocalI = 0
let eGlobI = 0
let eConstI = 0
let eStmtI = 0
let eObjI = 0
let eParamI = 0
let eFound = 0
let eWhileHead = 0
let eJumpOff = 0
let eWhileHeads = []
let eBreakIdxs = []
let eBreakFromStack = []
let eBi = 0
let eBf = 0
let eWh = 0
let eWhNew = []
let eWhI = 0
let eList = []
let eBodyStmts = []
let eBlockStmts = []
let eBlockN = 0
let eBlockI = 0
let eBlockNStack = []
let eBlockIStack = []
let eBlockStmtsStack = []
let eLenScratch = 0
let eFld = null
let eIfJmpStack = []
let eIfSkipStack = []
let eExports = []
let eImports = []
let eFnSave = ""
let eFnPub = 0
let eStoreSym = ""
let eAssignSym = ""
let eExprStmt = null
let eMemberFld = ""
let eMemberFldStack = []
let eSnapI = 0
let eSnapOut = []
let eLoopSave = 0
let eStmtKind = ""
let eStmtNode = null
let eObjIStack = []
let eObjNStack = []
let eArrIStack = []
let eArrNStack = []
let eCallArgIStack = []
let eCallArgNStack = []
let eIndexStack = []

fn popStack(stack) {
    return pop(stack)
}

// Self-host compile breaks push(stack, len(x)); inner len becomes outer callee.
fn pushLen(stack, arr) {
    eLenScratch = len(arr)
    return push(stack, eLenScratch)
}

fn snapArr(arr) {
    eSnapOut = []
    eSnapI = 0
    while eSnapI < len(arr) {
        eSnapOut = push(eSnapOut, arr[eSnapI])
        eSnapI = eSnapI + 1
    }
    return eSnapOut
}

fn localIndex(name) {
    eLocalI = 0
    while eLocalI < len(eFnLocals) {
        if eFnLocals[eLocalI] == name {
            return eLocalI
        }
        eLocalI = eLocalI + 1
    }
    eFnLocals = push(eFnLocals, name)
    return len(eFnLocals) - 1
}

fn globalIndex(name) {
    eGlobI = 0
    while eGlobI < len(eGlobals) {
        if eGlobals[eGlobI] == name {
            return eGlobI
        }
        eGlobI = eGlobI + 1
    }
    eGlobals = push(eGlobals, name)
    return len(eGlobals) - 1
}

fn constIndex(value) {
    eConstI = 0
    while eConstI < len(eConsts) {
        if eConsts[eConstI] == value {
            return eConstI
        }
        eConstI = eConstI + 1
    }
    eConsts = push(eConsts, value)
    return len(eConsts) - 1
}

fn constIndexLit(node) {
    if node["lit"] == LIT_UNDEF {
        eConstI = 0
        while eConstI < len(eConsts) {
            if eConsts[eConstI] == KAB_UNDEF_CONST {
                return eConstI
            }
            eConstI = eConstI + 1
        }
        eConsts = push(eConsts, KAB_UNDEF_CONST)
        return len(eConsts) - 1
    }
    return constIndex(node["value"])
}

fn emitOp(op, arg) {
    if eInFn == 1 {
        eFnOps = push(eFnOps, { "op": op, "arg": arg })
    } else {
        eOps = push(eOps, { "op": op, "arg": arg })
    }
}

fn emitLoadSym(sym) {
    if eInFn == 0 {
        eIdx = globalIndex(sym)
        emitOp(OP_LOAD_GLOBAL, eIdx)
        return
    }
    eLocalI = 0
    while eLocalI < len(eFnLocals) {
        if eFnLocals[eLocalI] == sym {
            emitOp(OP_LOAD_LOCAL, eLocalI)
            return
        }
        eLocalI = eLocalI + 1
    }
    eGlobI = 0
    while eGlobI < len(eGlobals) {
        if eGlobals[eGlobI] == sym {
            emitOp(OP_LOAD_GLOBAL, eGlobI)
            return
        }
        eGlobI = eGlobI + 1
    }
    eIdx = globalIndex(sym)
    emitOp(OP_LOAD_GLOBAL, eIdx)
}

fn emitStoreSym(sym) {
    if eInFn == 0 {
        eIdx = globalIndex(sym)
        emitOp(OP_STORE_GLOBAL, eIdx)
        return
    }
    eLocalI = 0
    while eLocalI < len(eFnLocals) {
        if eFnLocals[eLocalI] == sym {
            emitOp(OP_STORE_LOCAL, eLocalI)
            return
        }
        eLocalI = eLocalI + 1
    }
    eGlobI = 0
    while eGlobI < len(eGlobals) {
        if eGlobals[eGlobI] == sym {
            emitOp(OP_STORE_GLOBAL, eGlobI)
            return
        }
        eGlobI = eGlobI + 1
    }
    eIdx = localIndex(sym)
    emitOp(OP_STORE_LOCAL, eIdx)
}

fn emitExpr(node) {
    eNode = node
    if eNode == null {
        throw "emitExpr: null node"
    }
    if eNode.kind == AST_LITERAL {
        eIdx = constIndexLit(eNode)
        emitOp(OP_CONST, eIdx)
        return
    }
    if eNode.kind == AST_VAR {
        eSym = eNode["sym"]
        emitLoadSym(eSym)
        return
    }
    if eNode.kind == AST_BINARY {
        eBinOpStack = push(eBinOpStack, eNode["op"])
        eBinRStack = push(eBinRStack, eNode["right"])
        emitExpr(eNode["left"])
        emitExpr(eBinRStack[len(eBinRStack) - 1])
        eBinOp = eBinOpStack[len(eBinOpStack) - 1]
        eBinOpStack = popStack(eBinOpStack)
        eBinRStack = popStack(eBinRStack)
        if eBinOp == "+" {
            emitOp(OP_ADD, 0)
            return
        }
        if eBinOp == "-" {
            emitOp(OP_SUB, 0)
            return
        }
        if eBinOp == "==" {
            emitOp(OP_EQ, 0)
            return
        }
        if eBinOp == "!=" {
            emitOp(OP_NE, 0)
            return
        }
        if eBinOp == "<" {
            emitOp(OP_LT, 0)
            return
        }
        if eBinOp == ">" {
            emitOp(OP_GT, 0)
            return
        }
        if eBinOp == ">=" {
            emitOp(OP_GE, 0)
            return
        }
        if eBinOp == "<=" {
            emitOp(OP_LE, 0)
            return
        }
        if eBinOp == "&&" {
            emitOp(OP_AND, 0)
            return
        }
        throw "Unsupported binary op: " + eBinOp
    }
    if eNode.kind == AST_OBJECT {
        eList = eNode["fields"]
        eObjIStack = push(eObjIStack, 0)
        eObjNStack = pushLen(eObjNStack, eList)
        while eObjIStack[len(eObjIStack) - 1] < eObjNStack[len(eObjNStack) - 1] {
            eObjI = eObjIStack[len(eObjIStack) - 1]
            eFld = eList[eObjI]
            emitExpr(eFld["value"])
            eIdx = constIndex(eFld["key"])
            emitOp(OP_CONST, eIdx)
            eObjI = eObjIStack[len(eObjIStack) - 1] + 1
            eObjIStack = pop(eObjIStack)
            eObjIStack = push(eObjIStack, eObjI)
        }
        eObjIStack = pop(eObjIStack)
        eObjNStack = pop(eObjNStack)
        emitOp(OP_MAKE_OBJECT, len(eList))
        return
    }
    if eNode.kind == AST_ARRAY {
        eList = eNode["elems"]
        eArrIStack = push(eArrIStack, 0)
        eArrNStack = pushLen(eArrNStack, eList)
        while eArrIStack[len(eArrIStack) - 1] < eArrNStack[len(eArrNStack) - 1] {
            eObjI = eArrIStack[len(eArrIStack) - 1]
            emitExpr(eList[eObjI])
            eObjI = eArrIStack[len(eArrIStack) - 1] + 1
            eArrIStack = pop(eArrIStack)
            eArrIStack = push(eArrIStack, eObjI)
        }
        eArrIStack = pop(eArrIStack)
        eArrNStack = pop(eArrNStack)
        emitOp(OP_MAKE_ARRAY, len(eList))
        return
    }
    if eNode.kind == AST_MEMBER {
        eBxL = eNode["object"]
        eMemberFldStack = push(eMemberFldStack, eNode["field"])
        emitExpr(eBxL)
        eMemberFld = eMemberFldStack[len(eMemberFldStack) - 1]
        eMemberFldStack = popStack(eMemberFldStack)
        eIdx = constIndex(eMemberFld)
        emitOp(OP_GET_MEMBER, eIdx)
        return
    }
    if eNode.kind == AST_INDEX {
        eIndexStack = push(eIndexStack, eNode["index"])
        emitExpr(eNode["object"])
        emitExpr(eIndexStack[len(eIndexStack) - 1])
        eIndexStack = popStack(eIndexStack)
        emitOp(OP_INDEX_GET, 0)
        return
    }
    if eNode.kind == AST_CALL {
        eArgs = eNode["args"]
        eCallee = eNode["callee"]
        eArgN = len(eArgs)
        if eArgN == 0 {
            emitExpr(eCallee)
            emitOp(OP_CALL, 0)
            return
        }
        if eArgN == 1 {
            eBxL = eArgs[0]
            if eBxL.kind == AST_LITERAL {
                eIdx = constIndexLit(eBxL)
                emitOp(OP_CONST, eIdx)
            } else {
                if eBxL.kind == AST_VAR {
                    eSym = eBxL["sym"]
                    emitLoadSym(eSym)
                } else {
                    emitExpr(eBxL)
                }
            }
            emitExpr(eCallee)
            emitOp(OP_CALL, 1)
            return
        }
        if eArgN == 2 {
            eBxL = eArgs[0]
            eBxR = eArgs[1]
            if eBxL.kind == AST_LITERAL {
                eIdx = constIndexLit(eBxL)
                emitOp(OP_CONST, eIdx)
            } else {
                if eBxL.kind == AST_VAR {
                    eSym = eBxL["sym"]
                    emitLoadSym(eSym)
                } else {
                    emitExpr(eBxL)
                }
            }
            if eBxR.kind == AST_LITERAL {
                eIdx = constIndexLit(eBxR)
                emitOp(OP_CONST, eIdx)
            } else {
                if eBxR.kind == AST_VAR {
                    eSym = eBxR["sym"]
                    emitLoadSym(eSym)
                } else {
                    emitExpr(eBxR)
                }
            }
            emitExpr(eCallee)
            emitOp(OP_CALL, 2)
            return
        }
        eCallArgIStack = push(eCallArgIStack, 0)
        eCallArgNStack = push(eCallArgNStack, eArgN)
        while eCallArgIStack[len(eCallArgIStack) - 1] < eCallArgNStack[len(eCallArgNStack) - 1] {
            eCallI = eCallArgIStack[len(eCallArgIStack) - 1]
            eBxL = eArgs[eCallI]
            if eBxL.kind == AST_LITERAL {
                eIdx = constIndexLit(eBxL)
                emitOp(OP_CONST, eIdx)
            } else {
                if eBxL.kind == AST_VAR {
                    eSym = eBxL["sym"]
                    emitLoadSym(eSym)
                } else {
                    emitExpr(eBxL)
                }
            }
            eCallI = eCallArgIStack[len(eCallArgIStack) - 1] + 1
            eCallArgIStack = pop(eCallArgIStack)
            eCallArgIStack = push(eCallArgIStack, eCallI)
        }
        eCallArgIStack = pop(eCallArgIStack)
        eCallArgNStack = pop(eCallArgNStack)
        emitExpr(eCallee)
        emitOp(OP_CALL, eArgN)
        return
    }
    throw "Unsupported expr: " + eNode.kind
}

fn emitStmt(node) {
    eStmtNode = node
    eNode = node
    eStmtKind = eStmtNode.kind
    if eNode.kind == AST_LET {
        eAssignSym = eNode["sym"]
        emitExpr(eNode["init"])
        if eInFn == 1 {
            eIdx = localIndex(eAssignSym)
            emitOp(OP_STORE_LOCAL, eIdx)
        } else {
            eIdx = globalIndex(eAssignSym)
            emitOp(OP_STORE_GLOBAL, eIdx)
        }
        return
    }
    if eNode.kind == AST_ASSIGN {
        eAssignSym = eNode["sym"]
        emitExpr(eNode["rhs"])
        emitStoreSym(eAssignSym)
        return
    }
    if eNode.kind == AST_INDEX_ASSIGN {
        eBxL = eNode["object"]
        eBxR = eNode["index"]
        eBxRhs = eNode["rhs"]
        emitExpr(eBxL)
        emitExpr(eBxR)
        emitExpr(eBxRhs)
        emitOp(OP_INDEX_SET, 0)
        emitOp(OP_POP, 0)
        emitOp(OP_POP, 0)
        return
    }
    if eNode.kind == AST_EXPR {
        eExprStmt = eNode["expr"]
        emitExpr(eExprStmt)
        if eExprStmt.kind != AST_THROW {
            emitOp(OP_POP, 0)
        }
        return
    }
    if eNode.kind == AST_THROW {
        emitExpr(eNode["expr"])
        emitOp(OP_THROW, 0)
        return
    }
    if eNode.kind == AST_RETURN {
        if eNode["value"] == null {
            emitOp(OP_CONST, constIndex(null))
        } else {
            emitExpr(eNode["value"])
        }
        emitOp(OP_RETURN, 0)
        return
    }
    if eNode.kind == AST_BLOCK {
        eBlockStmtsStack = push(eBlockStmtsStack, eNode["body"])
        eBlockNStack = pushLen(eBlockNStack, eNode["body"])
        eBlockIStack = push(eBlockIStack, 0)
        while eBlockIStack[len(eBlockIStack) - 1] < eBlockNStack[len(eBlockNStack) - 1] {
            eBlockStmts = eBlockStmtsStack[len(eBlockStmtsStack) - 1]
            eBlockI = eBlockIStack[len(eBlockIStack) - 1]
            eStmtNode = eBlockStmts[eBlockI]
            if eStmtNode == null {
                throw "emit block null stmt at " + ("" + eBlockI)
            }
            emitStmt(eStmtNode)
            eBlockI = eBlockIStack[len(eBlockIStack) - 1] + 1
            eBlockIStack = pop(eBlockIStack)
            eBlockIStack = push(eBlockIStack, eBlockI)
        }
        eBlockStmtsStack = pop(eBlockStmtsStack)
        eBlockNStack = pop(eBlockNStack)
        eBlockIStack = pop(eBlockIStack)
        return
    }
    if eNode.kind == AST_IF {
        eCondStack = push(eCondStack, eCond)
        eThenStack = push(eThenStack, eThen)
        eElseStack = push(eElseStack, eElse)
        eCond = eNode["cond"]
        eThen = eNode["then"]
        eElse = eNode["elseBranch"]
        emitExpr(eCond)
        if eInFn == 1 {
            eIfJmpStack = pushLen(eIfJmpStack, eFnOps)
        } else {
            eIfJmpStack = pushLen(eIfJmpStack, eOps)
        }
        emitOp(OP_JUMP_IF_FALSE, 0)
        emitStmt(eThen)
        if eElse != null {
            if eInFn == 1 {
                eIfSkipStack = pushLen(eIfSkipStack, eFnOps)
            } else {
                eIfSkipStack = pushLen(eIfSkipStack, eOps)
            }
            emitOp(OP_JUMP, 0)
            if eInFn == 1 {
                eEnd = len(eFnOps)
                eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
                eJumpOff = eEnd - eJmp - 1
                eFnOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eJumpOff }
            } else {
                eEnd = len(eOps)
                eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
                eJumpOff = eEnd - eJmp - 1
                eOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eJumpOff }
            }
            eIfJmpStack = pop(eIfJmpStack)
            emitStmt(eElse)
            if eInFn == 1 {
                eEnd = len(eFnOps)
                eIdx = eIfSkipStack[len(eIfSkipStack) - 1]
                eJumpOff = eEnd - eIdx - 1
                eFnOps[eIdx] = { "op": OP_JUMP, "arg": eJumpOff }
            } else {
                eEnd = len(eOps)
                eIdx = eIfSkipStack[len(eIfSkipStack) - 1]
                eJumpOff = eEnd - eIdx - 1
                eOps[eIdx] = { "op": OP_JUMP, "arg": eJumpOff }
            }
            eIfSkipStack = pop(eIfSkipStack)
        } else {
            if eInFn == 1 {
                eEnd = len(eFnOps)
                eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
                eJumpOff = eEnd - eJmp - 1
                eFnOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eJumpOff }
            } else {
                eEnd = len(eOps)
                eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
                eJumpOff = eEnd - eJmp - 1
                eOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eJumpOff }
            }
            eIfJmpStack = pop(eIfJmpStack)
        }
        eCond = eCondStack[len(eCondStack) - 1]
        eThen = eThenStack[len(eThenStack) - 1]
        eElse = eElseStack[len(eElseStack) - 1]
        eCondStack = popStack(eCondStack)
        eThenStack = popStack(eThenStack)
        eElseStack = popStack(eElseStack)
        return
    }
    if eNode.kind == AST_CONTINUE {
        if len(eWhileHeads) == 0 {
            throw "continue outside loop"
        }
        eWh = eWhileHeads[len(eWhileHeads) - 1]
        if eInFn == 1 {
            eJumpOff = eWh - len(eFnOps) - 1
        } else {
            eJumpOff = eWh - len(eOps) - 1
        }
        emitOp(OP_JUMP, eJumpOff)
        return
    }
    if eNode.kind == AST_BREAK {
        if len(eBreakFromStack) == 0 {
            throw "break outside loop"
        }
        if eInFn == 1 {
            eBreakIdxs = pushLen(eBreakIdxs, eFnOps)
        } else {
            eBreakIdxs = pushLen(eBreakIdxs, eOps)
        }
        emitOp(OP_JUMP, 0)
        return
    }
    if eNode.kind == AST_WHILE {
        eCond = eNode["cond"]
        eThen = eNode["body"]
        eBreakFromStack = pushLen(eBreakFromStack, eBreakIdxs)
        if eInFn == 1 {
            eWhileHead = len(eFnOps)
        } else {
            eWhileHead = len(eOps)
        }
        eWhileHeads = push(eWhileHeads, eWhileHead)
        emitExpr(eCond)
        if eInFn == 1 {
            eIfJmpStack = pushLen(eIfJmpStack, eFnOps)
        } else {
            eIfJmpStack = pushLen(eIfJmpStack, eOps)
        }
        emitOp(OP_JUMP_IF_FALSE, 0)
        emitStmt(eThen)
        if eInFn == 1 {
            eJumpOff = eWhileHead - len(eFnOps) - 1
        } else {
            eJumpOff = eWhileHead - len(eOps) - 1
        }
        emitOp(OP_JUMP, eJumpOff)
        if eInFn == 1 {
            eEnd = len(eFnOps)
            eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
            eJumpOff = eEnd - eJmp - 1
            eFnOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eJumpOff }
        } else {
            eEnd = len(eOps)
            eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
            eJumpOff = eEnd - eJmp - 1
            eOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eJumpOff }
        }
        eIfJmpStack = pop(eIfJmpStack)
        eBf = eBreakFromStack[len(eBreakFromStack) - 1]
        eBi = eBf
        while eBi < len(eBreakIdxs) {
            if eInFn == 1 {
                eJumpOff = eEnd - eBreakIdxs[eBi] - 1
                eFnOps[eBreakIdxs[eBi]] = { "op": OP_JUMP, "arg": eJumpOff }
            } else {
                eJumpOff = eEnd - eBreakIdxs[eBi] - 1
                eOps[eBreakIdxs[eBi]] = { "op": OP_JUMP, "arg": eJumpOff }
            }
            eBi = eBi + 1
        }
        if eBf > 0 {
            eWhNew = []
            eWhI = 0
            while eWhI < eBf {
                eWhNew = push(eWhNew, eBreakIdxs[eWhI])
                eWhI = eWhI + 1
            }
            eBreakIdxs = eWhNew
        } else {
            eBreakIdxs = []
        }
        if len(eWhileHeads) > 0 {
            eWhileHeads = pop(eWhileHeads)
        } else {
            eWhileHeads = []
        }
        if len(eBreakFromStack) > 0 {
            eBreakFromStack = pop(eBreakFromStack)
        } else {
            eBreakFromStack = []
        }
        return
    }
    if eNode.kind == AST_FN {
        eFnSave = "" + eNode["sym"]
        eFnPub = eNode["isPub"]
        eParams = eNode["params"]
        eFnBody = eNode["body"]
        eInFn = 1
        eFnOps = []
        eFnGlobals = []
        eFnLocals = []
        eParamI = 0
        while eParamI < len(eParams) {
            eLoopSave = eParamI
            localIndex(eParams[eParamI])
            eParamI = eLoopSave + 1
        }
        emitStmt(eFnBody)
        eFunctions = push(eFunctions, {
            "sym": eFnSave,
            "params": snapArr(eParams),
            "locals": snapArr(eFnLocals),
            "globals": snapArr(eFnGlobals),
            "ops": snapArr(eFnOps)
        })
        eInFn = 0
        globalIndex(eFnSave)
        if eFnPub == 1 {
            eExports = push(eExports, ("" + eFnSave) + "")
        }
        return
    }
    if eNode == null {
        throw "emitStmt: null node"
    }
    if eNode.kind == undefined {
        throw "emitStmt: missing kind"
    }
    throw "Unsupported stmt: " + eStmtKind
}

pub fn emit(program) {
    eProgram = program
    eConsts = []
    eOps = []
    eGlobals = []
    eFunctions = []
    eFnOps = []
    eFnGlobals = []
    eFnLocals = []
    eInFn = 0
    eWhileHeads = []
    eBreakIdxs = []
    eBreakFromStack = []
    eIfJmpStack = []
    eIfSkipStack = []
    eBinOpStack = []
    eBinRStack = []
    eMemberFldStack = []
    eBlockStmtsStack = []
    eBlockNStack = []
    eBlockIStack = []
    eObjIStack = []
    eObjNStack = []
    eArrIStack = []
    eArrNStack = []
    eCallArgIStack = []
    eCallArgNStack = []
    eExports = []
    eImports = []
    eProg = 0
    if eProgram["imports"] != undefined {
        eImports = eProgram["imports"]
    }
    eBlockStmtsStack = push(eBlockStmtsStack, eProgram["body"])
    eBlockNStack = pushLen(eBlockNStack, eProgram["body"])
    eBlockIStack = push(eBlockIStack, 0)
    while eBlockIStack[len(eBlockIStack) - 1] < eBlockNStack[len(eBlockNStack) - 1] {
        eBlockStmts = eBlockStmtsStack[len(eBlockStmtsStack) - 1]
        eBlockI = eBlockIStack[len(eBlockIStack) - 1]
        eStmtNode = eBlockStmts[eBlockI]
        if eStmtNode == null {
            throw "emit program null stmt at " + ("" + eBlockI)
        }
        emitStmt(eStmtNode)
        eBlockI = eBlockIStack[len(eBlockIStack) - 1] + 1
        eBlockIStack = pop(eBlockIStack)
        eBlockIStack = push(eBlockIStack, eBlockI)
    }
    emitOp(OP_HALT, 0)
    return { "constants": eConsts, "globals": eGlobals, "ops": eOps, "functions": eFunctions, "exports": eExports, "imports": eImports }
}
