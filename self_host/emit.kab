// Self-hosted bytecode emitter - produces opcode IR from AST.
// Emitter scratch slots are module-level (Kabootar fn locals are not re-entrant).
import "self_host/ast_defs"
import "self_host/emit_defs"

let eConsts = []
let eOps = []
let eGlobals = []
let eFnOps = []
let eFnGlobals = []
let eFnLocals = []
let eInFn = 0
let eIdx = 0
let eSym = null
let eJmp = 0
let eEnd = 0
let eNode = null
let eProg = 0
let eLeft = null
let eRight = null
let eOp = ""
let eCond = null
let eThen = null
let eElse = null
let eCondStack = []
let eThenStack = []
let eElseStack = []
let eProgram = null
let eFunctions = []
let eParams = []
let eFnBody = null
let eFnName = ""
let eBxL = null
let eBxR = null
let eArgs = []
let eCallee = null
let eCallI = 0
let eArgN = 0
let eLocalI = 0
let eGlobI = 0
let eConstI = 0
let eStmtI = 0
let eObjI = 0
let eParamI = 0
let eFound = 0
let eWhileHead = 0
let eJumpOff = 0
let eWhileHeads = []
let eBreakIdxs = []
let eBreakFromStack = []
let eBi = 0
let eBf = 0
let eWh = 0
let eWhNew = []
let eWhI = 0
let eList = []
let eBodyStmts = []
let eBlockStmts = []
let eBlockN = 0
let eBlockI = 0
let eBlockNStack = []
let eBlockIStack = []
let eBlockStmtsStack = []
let eFld = null
let eIfJmpStack = []
let eIfSkipStack = []
let eExports = []
let eImports = []
let eFnSave = ""
let eFnPub = 0
let eStoreSym = ""
let eMemberFld = ""
let eSnapI = 0
let eSnapOut = []
let eLoopSave = 0
let eStmtKind = ""
let eStmtNode = null
let eObjIStack = []
let eObjNStack = []
let eArrIStack = []
let eArrNStack = []
let eCallArgIStack = []
let eCallArgNStack = []

fn popStack(stack) {
    eWhNew = []
    eWhI = 0
    while eWhI < len(stack) - 1 {
        eWhNew = push(eWhNew, stack[eWhI])
        eWhI = eWhI + 1
    }
    return eWhNew
}

fn snapArr(arr) {
    eSnapOut = []
    eSnapI = 0
    while eSnapI < len(arr) {
        eSnapOut = push(eSnapOut, arr[eSnapI])
        eSnapI = eSnapI + 1
    }
    return eSnapOut
}

fn localIndex(name) {
    eLocalI = 0
    while eLocalI < len(eFnLocals) {
        if eFnLocals[eLocalI] == name {
            return eLocalI
        }
        eLocalI = eLocalI + 1
    }
    eFnLocals = push(eFnLocals, name)
    return len(eFnLocals) - 1
}

fn globalIndex(name) {
    eGlobI = 0
    while eGlobI < len(eGlobals) {
        if eGlobals[eGlobI] == name {
            return eGlobI
        }
        eGlobI = eGlobI + 1
    }
    eGlobals = push(eGlobals, name)
    return len(eGlobals) - 1
}

fn constIndex(value) {
    eConstI = 0
    while eConstI < len(eConsts) {
        if eConsts[eConstI] == value {
            return eConstI
        }
        eConstI = eConstI + 1
    }
    eConsts = push(eConsts, value)
    return len(eConsts) - 1
}

fn emitOp(op, arg) {
    if eInFn == 1 {
        eFnOps = push(eFnOps, { "op": op, "arg": arg })
    } else {
        eOps = push(eOps, { "op": op, "arg": arg })
    }
}

fn emitExpr(node) {
    eNode = node
    if eNode.kind == AST_LITERAL {
        eIdx = constIndex(eNode["value"])
        emitOp(OP_CONST, eIdx)
        return
    }
    if eNode.kind == AST_VAR {
        eSym = eNode["sym"]
        if eInFn == 1 {
            eFound = 0
            eLocalI = 0
            while eLocalI < len(eFnLocals) {
                if eFnLocals[eLocalI] == eSym {
                    eIdx = eLocalI
                    eFound = 1
                    eLocalI = len(eFnLocals)
                } else {
                    eLocalI = eLocalI + 1
                }
            }
            if eFound == 1 {
                emitOp(OP_LOAD_LOCAL, eIdx)
            } else {
                eIdx = globalIndex(eSym)
                emitOp(OP_LOAD_GLOBAL, eIdx)
            }
        } else {
            eIdx = globalIndex(eSym)
            emitOp(OP_LOAD_GLOBAL, eIdx)
        }
        return
    }
    if eNode.kind == AST_BINARY {
        eBxL = eNode["left"]
        eBxR = eNode["right"]
        eOp = eNode["op"]
        if eInFn == 1 {
            eNode = eBxL
            if eNode.kind == AST_LITERAL {
                eIdx = constIndex(eNode["value"])
                emitOp(OP_CONST, eIdx)
            } else {
                if eNode.kind == AST_VAR {
                    eSym = eNode["sym"]
                    eFound = 0
                    eLocalI = 0
                    while eLocalI < len(eFnLocals) {
                        if eFnLocals[eLocalI] == eSym {
                            eIdx = eLocalI
                            eFound = 1
                            eLocalI = len(eFnLocals)
                        } else {
                            eLocalI = eLocalI + 1
                        }
                    }
                    if eFound == 1 {
                        emitOp(OP_LOAD_LOCAL, eIdx)
                    } else {
                        eIdx = globalIndex(eSym)
                        emitOp(OP_LOAD_GLOBAL, eIdx)
                    }
                } else {
                    emitExpr(eBxL)
                }
            }
            eNode = eBxR
            if eNode.kind == AST_LITERAL {
                eIdx = constIndex(eNode["value"])
                emitOp(OP_CONST, eIdx)
            } else {
                if eNode.kind == AST_VAR {
                    eSym = eNode["sym"]
                    eFound = 0
                    eLocalI = 0
                    while eLocalI < len(eFnLocals) {
                        if eFnLocals[eLocalI] == eSym {
                            eIdx = eLocalI
                            eFound = 1
                            eLocalI = len(eFnLocals)
                        } else {
                            eLocalI = eLocalI + 1
                        }
                    }
                    if eFound == 1 {
                        emitOp(OP_LOAD_LOCAL, eIdx)
                    } else {
                        eIdx = globalIndex(eSym)
                        emitOp(OP_LOAD_GLOBAL, eIdx)
                    }
                } else {
                    emitExpr(eBxR)
                }
            }
        } else {
            emitExpr(eBxL)
            emitExpr(eBxR)
        }
        if eOp == "+" {
            emitOp(OP_ADD, 0)
            return
        }
        if eOp == "-" {
            emitOp(OP_SUB, 0)
            return
        }
        if eOp == "==" {
            emitOp(OP_EQ, 0)
            return
        }
        if eOp == "!=" {
            emitOp(OP_NE, 0)
            return
        }
        if eOp == "<" {
            emitOp(OP_LT, 0)
            return
        }
        if eOp == ">" {
            emitOp(OP_GT, 0)
            return
        }
        if eOp == ">=" {
            emitOp(OP_GE, 0)
            return
        }
        if eOp == "<=" {
            emitOp(OP_LE, 0)
            return
        }
        if eOp == "&&" {
            emitOp(OP_AND, 0)
            return
        }
        throw "Unsupported binary op: " + eOp
    }
    if eNode.kind == AST_OBJECT {
        eList = eNode["fields"]
        eObjIStack = push(eObjIStack, 0)
        eObjNStack = push(eObjNStack, len(eList))
        while eObjIStack[len(eObjIStack) - 1] < eObjNStack[len(eObjNStack) - 1] {
            eObjI = eObjIStack[len(eObjIStack) - 1]
            eFld = eList[eObjI]
            emitExpr(eFld["value"])
            eIdx = constIndex(eFld["key"])
            emitOp(OP_CONST, eIdx)
            eObjI = eObjIStack[len(eObjIStack) - 1] + 1
            eWhNew = []
            eWhI = 0
            while eWhI < len(eObjIStack) - 1 {
                eWhNew = push(eWhNew, eObjIStack[eWhI])
                eWhI = eWhI + 1
            }
            eObjIStack = eWhNew
            eObjIStack = push(eObjIStack, eObjI)
        }
        eWhNew = []
        eWhI = 0
        while eWhI < len(eObjIStack) - 1 {
            eWhNew = push(eWhNew, eObjIStack[eWhI])
            eWhI = eWhI + 1
        }
        eObjIStack = eWhNew
        eWhNew = []
        eWhI = 0
        while eWhI < len(eObjNStack) - 1 {
            eWhNew = push(eWhNew, eObjNStack[eWhI])
            eWhI = eWhI + 1
        }
        eObjNStack = eWhNew
        emitOp(OP_MAKE_OBJECT, len(eList))
        return
    }
    if eNode.kind == AST_ARRAY {
        eList = eNode["elems"]
        eArrIStack = push(eArrIStack, 0)
        eArrNStack = push(eArrNStack, len(eList))
        while eArrIStack[len(eArrIStack) - 1] < eArrNStack[len(eArrNStack) - 1] {
            eObjI = eArrIStack[len(eArrIStack) - 1]
            emitExpr(eList[eObjI])
            eObjI = eArrIStack[len(eArrIStack) - 1] + 1
            eWhNew = []
            eWhI = 0
            while eWhI < len(eArrIStack) - 1 {
                eWhNew = push(eWhNew, eArrIStack[eWhI])
                eWhI = eWhI + 1
            }
            eArrIStack = eWhNew
            eArrIStack = push(eArrIStack, eObjI)
        }
        eWhNew = []
        eWhI = 0
        while eWhI < len(eArrIStack) - 1 {
            eWhNew = push(eWhNew, eArrIStack[eWhI])
            eWhI = eWhI + 1
        }
        eArrIStack = eWhNew
        eWhNew = []
        eWhI = 0
        while eWhI < len(eArrNStack) - 1 {
            eWhNew = push(eWhNew, eArrNStack[eWhI])
            eWhI = eWhI + 1
        }
        eArrNStack = eWhNew
        emitOp(OP_MAKE_ARRAY, len(eList))
        return
    }
    if eNode.kind == AST_MEMBER {
        eBxL = eNode["object"]
        eMemberFld = eNode["field"]
        emitExpr(eBxL)
        eIdx = constIndex(eMemberFld)
        emitOp(OP_GET_MEMBER, eIdx)
        return
    }
    if eNode.kind == AST_INDEX {
        eBxL = eNode["object"]
        eBxR = eNode["index"]
        emitExpr(eBxL)
        emitExpr(eBxR)
        emitOp(OP_INDEX_GET, 0)
        return
    }
    if eNode.kind == AST_CALL {
        eArgs = eNode["args"]
        eCallee = eNode["callee"]
        eArgN = len(eArgs)
        if eArgN == 0 {
            emitExpr(eCallee)
            emitOp(OP_CALL, 0)
            return
        }
        if eArgN == 1 {
            eBxL = eArgs[0]
            if eBxL.kind == AST_LITERAL {
                eIdx = constIndex(eBxL["value"])
                emitOp(OP_CONST, eIdx)
            } else {
                if eBxL.kind == AST_VAR {
                    eSym = eBxL["sym"]
                    if eInFn == 1 {
                        eFound = 0
                        eLocalI = 0
                        while eLocalI < len(eFnLocals) {
                            if eFnLocals[eLocalI] == eSym {
                                eIdx = eLocalI
                                eFound = 1
                                eLocalI = len(eFnLocals)
                            } else {
                                eLocalI = eLocalI + 1
                            }
                        }
                        if eFound == 1 {
                            emitOp(OP_LOAD_LOCAL, eIdx)
                        } else {
                            eIdx = globalIndex(eSym)
                            emitOp(OP_LOAD_GLOBAL, eIdx)
                        }
                    } else {
                        eIdx = globalIndex(eSym)
                        emitOp(OP_LOAD_GLOBAL, eIdx)
                    }
                } else {
                    emitExpr(eBxL)
                }
            }
            emitExpr(eCallee)
            emitOp(OP_CALL, 1)
            return
        }
        if eArgN == 2 {
            eBxL = eArgs[0]
            eBxR = eArgs[1]
            if eBxL.kind == AST_LITERAL {
                eIdx = constIndex(eBxL["value"])
                emitOp(OP_CONST, eIdx)
            } else {
                if eBxL.kind == AST_VAR {
                    eSym = eBxL["sym"]
                    if eInFn == 1 {
                        eFound = 0
                        eLocalI = 0
                        while eLocalI < len(eFnLocals) {
                            if eFnLocals[eLocalI] == eSym {
                                eIdx = eLocalI
                                eFound = 1
                                eLocalI = len(eFnLocals)
                            } else {
                                eLocalI = eLocalI + 1
                            }
                        }
                        if eFound == 1 {
                            emitOp(OP_LOAD_LOCAL, eIdx)
                        } else {
                            eIdx = globalIndex(eSym)
                            emitOp(OP_LOAD_GLOBAL, eIdx)
                        }
                    } else {
                        eIdx = globalIndex(eSym)
                        emitOp(OP_LOAD_GLOBAL, eIdx)
                    }
                } else {
                    emitExpr(eBxL)
                }
            }
            if eBxR.kind == AST_LITERAL {
                eIdx = constIndex(eBxR["value"])
                emitOp(OP_CONST, eIdx)
            } else {
                if eBxR.kind == AST_VAR {
                    eSym = eBxR["sym"]
                    if eInFn == 1 {
                        eFound = 0
                        eLocalI = 0
                        while eLocalI < len(eFnLocals) {
                            if eFnLocals[eLocalI] == eSym {
                                eIdx = eLocalI
                                eFound = 1
                                eLocalI = len(eFnLocals)
                            } else {
                                eLocalI = eLocalI + 1
                            }
                        }
                        if eFound == 1 {
                            emitOp(OP_LOAD_LOCAL, eIdx)
                        } else {
                            eIdx = globalIndex(eSym)
                            emitOp(OP_LOAD_GLOBAL, eIdx)
                        }
                    } else {
                        eIdx = globalIndex(eSym)
                        emitOp(OP_LOAD_GLOBAL, eIdx)
                    }
                } else {
                    emitExpr(eBxR)
                }
            }
            emitExpr(eCallee)
            emitOp(OP_CALL, 2)
            return
        }
        eCallArgIStack = push(eCallArgIStack, 0)
        eCallArgNStack = push(eCallArgNStack, eArgN)
        while eCallArgIStack[len(eCallArgIStack) - 1] < eCallArgNStack[len(eCallArgNStack) - 1] {
            eCallI = eCallArgIStack[len(eCallArgIStack) - 1]
            eBxL = eArgs[eCallI]
            if eBxL.kind == AST_LITERAL {
                eIdx = constIndex(eBxL["value"])
                emitOp(OP_CONST, eIdx)
            } else {
                if eBxL.kind == AST_VAR {
                    eSym = eBxL["sym"]
                    if eInFn == 1 {
                        eFound = 0
                        eLocalI = 0
                        while eLocalI < len(eFnLocals) {
                            if eFnLocals[eLocalI] == eSym {
                                eIdx = eLocalI
                                eFound = 1
                                eLocalI = len(eFnLocals)
                            } else {
                                eLocalI = eLocalI + 1
                            }
                        }
                        if eFound == 1 {
                            emitOp(OP_LOAD_LOCAL, eIdx)
                        } else {
                            eIdx = globalIndex(eSym)
                            emitOp(OP_LOAD_GLOBAL, eIdx)
                        }
                    } else {
                        eIdx = globalIndex(eSym)
                        emitOp(OP_LOAD_GLOBAL, eIdx)
                    }
                } else {
                    emitExpr(eBxL)
                }
            }
            eCallI = eCallArgIStack[len(eCallArgIStack) - 1] + 1
            eWhNew = []
            eWhI = 0
            while eWhI < len(eCallArgIStack) - 1 {
                eWhNew = push(eWhNew, eCallArgIStack[eWhI])
                eWhI = eWhI + 1
            }
            eCallArgIStack = eWhNew
            eCallArgIStack = push(eCallArgIStack, eCallI)
        }
        eWhNew = []
        eWhI = 0
        while eWhI < len(eCallArgIStack) - 1 {
            eWhNew = push(eWhNew, eCallArgIStack[eWhI])
            eWhI = eWhI + 1
        }
        eCallArgIStack = eWhNew
        eWhNew = []
        eWhI = 0
        while eWhI < len(eCallArgNStack) - 1 {
            eWhNew = push(eWhNew, eCallArgNStack[eWhI])
            eWhI = eWhI + 1
        }
        eCallArgNStack = eWhNew
        emitExpr(eCallee)
        emitOp(OP_CALL, eArgN)
        return
    }
    throw "Unsupported expr: " + eNode.kind
}

fn emitStmt(node) {
    eStmtNode = node
    eNode = node
    eStmtKind = eStmtNode.kind
    if eNode.kind == AST_LET {
        eStoreSym = eNode["sym"]
        emitExpr(eNode["init"])
        if eInFn == 1 {
            eIdx = localIndex(eStoreSym)
            emitOp(OP_STORE_LOCAL, eIdx)
        } else {
            eIdx = globalIndex(eStoreSym)
            emitOp(OP_STORE_GLOBAL, eIdx)
        }
        return
    }
    if eNode.kind == AST_ASSIGN {
        eStoreSym = eNode["sym"]
        emitExpr(eNode["rhs"])
        if eInFn == 1 {
            eIdx = localIndex(eStoreSym)
            emitOp(OP_STORE_LOCAL, eIdx)
        } else {
            eIdx = globalIndex(eStoreSym)
            emitOp(OP_STORE_GLOBAL, eIdx)
        }
        return
    }
    if eNode.kind == AST_EXPR {
        eCond = eNode["expr"]
        emitExpr(eCond)
        if eCond.kind != AST_THROW {
            emitOp(OP_POP, 0)
        }
        return
    }
    if eNode.kind == AST_THROW {
        emitExpr(eNode["expr"])
        emitOp(OP_THROW, 0)
        return
    }
    if eNode.kind == AST_RETURN {
        if eNode["value"] == null {
            emitOp(OP_CONST, constIndex(null))
        } else {
            emitExpr(eNode["value"])
        }
        emitOp(OP_RETURN, 0)
        return
    }
    if eNode.kind == AST_BLOCK {
        eBlockStmtsStack = push(eBlockStmtsStack, eNode["body"])
        eBlockNStack = push(eBlockNStack, len(eNode["body"]))
        eBlockIStack = push(eBlockIStack, 0)
        while eBlockIStack[len(eBlockIStack) - 1] < eBlockNStack[len(eBlockNStack) - 1] {
            eBlockStmts = eBlockStmtsStack[len(eBlockStmtsStack) - 1]
            eBlockI = eBlockIStack[len(eBlockIStack) - 1]
            eStmtNode = eBlockStmts[eBlockI]
            if eStmtNode == null {
                throw "emit block null stmt at " + ("" + eBlockI)
            }
            emitStmt(eStmtNode)
            eBlockI = eBlockIStack[len(eBlockIStack) - 1] + 1
            eWhNew = []
            eWhI = 0
            while eWhI < len(eBlockIStack) - 1 {
                eWhNew = push(eWhNew, eBlockIStack[eWhI])
                eWhI = eWhI + 1
            }
            eBlockIStack = eWhNew
            eBlockIStack = push(eBlockIStack, eBlockI)
        }
        eWhNew = []
        eWhI = 0
        while eWhI < len(eBlockStmtsStack) - 1 {
            eWhNew = push(eWhNew, eBlockStmtsStack[eWhI])
            eWhI = eWhI + 1
        }
        eBlockStmtsStack = eWhNew
        eWhNew = []
        eWhI = 0
        while eWhI < len(eBlockNStack) - 1 {
            eWhNew = push(eWhNew, eBlockNStack[eWhI])
            eWhI = eWhI + 1
        }
        eBlockNStack = eWhNew
        eWhNew = []
        eWhI = 0
        while eWhI < len(eBlockIStack) - 1 {
            eWhNew = push(eWhNew, eBlockIStack[eWhI])
            eWhI = eWhI + 1
        }
        eBlockIStack = eWhNew
        return
    }
    if eNode.kind == AST_IF {
        eCondStack = push(eCondStack, eCond)
        eThenStack = push(eThenStack, eThen)
        eElseStack = push(eElseStack, eElse)
        eCond = eNode["cond"]
        eThen = eNode["then"]
        eElse = eNode["elseBranch"]
        emitExpr(eCond)
        if eInFn == 1 {
            eIfJmpStack = push(eIfJmpStack, len(eFnOps))
        } else {
            eIfJmpStack = push(eIfJmpStack, len(eOps))
        }
        emitOp(OP_JUMP_IF_FALSE, 0)
        emitStmt(eThen)
        if eElse != null {
            if eInFn == 1 {
                eIfSkipStack = push(eIfSkipStack, len(eFnOps))
            } else {
                eIfSkipStack = push(eIfSkipStack, len(eOps))
            }
            emitOp(OP_JUMP, 0)
            if eInFn == 1 {
                eEnd = len(eFnOps)
                eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
                eJumpOff = eEnd - eJmp - 1
                eFnOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eJumpOff }
            } else {
                eEnd = len(eOps)
                eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
                eJumpOff = eEnd - eJmp - 1
                eOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eJumpOff }
            }
            eWhNew = []
            eWhI = 0
            while eWhI < len(eIfJmpStack) - 1 {
                eWhNew = push(eWhNew, eIfJmpStack[eWhI])
                eWhI = eWhI + 1
            }
            eIfJmpStack = eWhNew
            emitStmt(eElse)
            if eInFn == 1 {
                eEnd = len(eFnOps)
                eIdx = eIfSkipStack[len(eIfSkipStack) - 1]
                eJumpOff = eEnd - eIdx - 1
                eFnOps[eIdx] = { "op": OP_JUMP, "arg": eJumpOff }
            } else {
                eEnd = len(eOps)
                eIdx = eIfSkipStack[len(eIfSkipStack) - 1]
                eJumpOff = eEnd - eIdx - 1
                eOps[eIdx] = { "op": OP_JUMP, "arg": eJumpOff }
            }
            eWhNew = []
            eWhI = 0
            while eWhI < len(eIfSkipStack) - 1 {
                eWhNew = push(eWhNew, eIfSkipStack[eWhI])
                eWhI = eWhI + 1
            }
            eIfSkipStack = eWhNew
        } else {
            if eInFn == 1 {
                eEnd = len(eFnOps)
                eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
                eJumpOff = eEnd - eJmp - 1
                eFnOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eJumpOff }
            } else {
                eEnd = len(eOps)
                eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
                eJumpOff = eEnd - eJmp - 1
                eOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eJumpOff }
            }
            eWhNew = []
            eWhI = 0
            while eWhI < len(eIfJmpStack) - 1 {
                eWhNew = push(eWhNew, eIfJmpStack[eWhI])
                eWhI = eWhI + 1
            }
            eIfJmpStack = eWhNew
        }
        eCond = eCondStack[len(eCondStack) - 1]
        eThen = eThenStack[len(eThenStack) - 1]
        eElse = eElseStack[len(eElseStack) - 1]
        eCondStack = popStack(eCondStack)
        eThenStack = popStack(eThenStack)
        eElseStack = popStack(eElseStack)
        return
    }
    if eNode.kind == AST_CONTINUE {
        if len(eWhileHeads) == 0 {
            throw "continue outside loop"
        }
        eWh = eWhileHeads[len(eWhileHeads) - 1]
        if eInFn == 1 {
            eJumpOff = eWh - len(eFnOps) - 1
        } else {
            eJumpOff = eWh - len(eOps) - 1
        }
        emitOp(OP_JUMP, eJumpOff)
        return
    }
    if eNode.kind == AST_BREAK {
        if len(eBreakFromStack) == 0 {
            throw "break outside loop"
        }
        if eInFn == 1 {
            eBreakIdxs = push(eBreakIdxs, len(eFnOps))
        } else {
            eBreakIdxs = push(eBreakIdxs, len(eOps))
        }
        emitOp(OP_JUMP, 0)
        return
    }
    if eNode.kind == AST_WHILE {
        eCond = eNode["cond"]
        eThen = eNode["body"]
        eBreakFromStack = push(eBreakFromStack, len(eBreakIdxs))
        if eInFn == 1 {
            eWhileHead = len(eFnOps)
        } else {
            eWhileHead = len(eOps)
        }
        eWhileHeads = push(eWhileHeads, eWhileHead)
        emitExpr(eCond)
        if eInFn == 1 {
            eIfJmpStack = push(eIfJmpStack, len(eFnOps))
        } else {
            eIfJmpStack = push(eIfJmpStack, len(eOps))
        }
        emitOp(OP_JUMP_IF_FALSE, 0)
        emitStmt(eThen)
        if eInFn == 1 {
            eJumpOff = eWhileHead - len(eFnOps) - 1
        } else {
            eJumpOff = eWhileHead - len(eOps) - 1
        }
        emitOp(OP_JUMP, eJumpOff)
        if eInFn == 1 {
            eEnd = len(eFnOps)
            eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
            eJumpOff = eEnd - eJmp - 1
            eFnOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eJumpOff }
        } else {
            eEnd = len(eOps)
            eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
            eJumpOff = eEnd - eJmp - 1
            eOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eJumpOff }
        }
        eWhNew = []
        eWhI = 0
        while eWhI < len(eIfJmpStack) - 1 {
            eWhNew = push(eWhNew, eIfJmpStack[eWhI])
            eWhI = eWhI + 1
        }
        eIfJmpStack = eWhNew
        eBf = eBreakFromStack[len(eBreakFromStack) - 1]
        eBi = eBf
        while eBi < len(eBreakIdxs) {
            if eInFn == 1 {
                eJumpOff = eEnd - eBreakIdxs[eBi] - 1
                eFnOps[eBreakIdxs[eBi]] = { "op": OP_JUMP, "arg": eJumpOff }
            } else {
                eJumpOff = eEnd - eBreakIdxs[eBi] - 1
                eOps[eBreakIdxs[eBi]] = { "op": OP_JUMP, "arg": eJumpOff }
            }
            eBi = eBi + 1
        }
        eWhNew = []
        eWhI = 0
        while eWhI < len(eWhileHeads) - 1 {
            eWhNew = push(eWhNew, eWhileHeads[eWhI])
            eWhI = eWhI + 1
        }
        eWhileHeads = eWhNew
        eWhNew = []
        eWhI = 0
        while eWhI < len(eBreakFromStack) - 1 {
            eWhNew = push(eWhNew, eBreakFromStack[eWhI])
            eWhI = eWhI + 1
        }
        eBreakFromStack = eWhNew
        return
    }
    if eNode.kind == AST_FN {
        eFnSave = "" + eNode["sym"]
        eFnPub = eNode["isPub"]
        eParams = eNode["params"]
        eFnBody = eNode["body"]
        eInFn = 1
        eFnOps = []
        eFnGlobals = []
        eFnLocals = []
        eParamI = 0
        while eParamI < len(eParams) {
            eLoopSave = eParamI
            localIndex(eParams[eParamI])
            eParamI = eLoopSave + 1
        }
        emitStmt(eFnBody)
        eFunctions = push(eFunctions, {
            "sym": eFnSave,
            "params": snapArr(eParams),
            "locals": snapArr(eFnLocals),
            "globals": snapArr(eFnGlobals),
            "ops": snapArr(eFnOps)
        })
        eInFn = 0
        globalIndex(eFnSave)
        if eFnPub == 1 {
            eExports = push(eExports, ("" + eFnSave) + "")
        }
        return
    }
    if eNode == null {
        throw "emitStmt: null node"
    }
    if eNode.kind == undefined {
        throw "emitStmt: missing kind"
    }
    throw "Unsupported stmt: " + eStmtKind
}

pub fn emit(program) {
    eProgram = program
    eConsts = []
    eOps = []
    eGlobals = []
    eFunctions = []
    eFnOps = []
    eFnGlobals = []
    eFnLocals = []
    eInFn = 0
    eWhileHeads = []
    eBreakIdxs = []
    eBreakFromStack = []
    eIfJmpStack = []
    eIfSkipStack = []
    eBlockStmtsStack = []
    eBlockNStack = []
    eBlockIStack = []
    eObjIStack = []
    eObjNStack = []
    eArrIStack = []
    eArrNStack = []
    eCallArgIStack = []
    eCallArgNStack = []
    eExports = []
    eImports = []
    eProg = 0
    if eProgram["imports"] != undefined {
        eImports = eProgram["imports"]
    }
    eBlockStmtsStack = push(eBlockStmtsStack, eProgram["body"])
    eBlockNStack = push(eBlockNStack, len(eProgram["body"]))
    eBlockIStack = push(eBlockIStack, 0)
    while eBlockIStack[len(eBlockIStack) - 1] < eBlockNStack[len(eBlockNStack) - 1] {
        eBlockStmts = eBlockStmtsStack[len(eBlockStmtsStack) - 1]
        eBlockI = eBlockIStack[len(eBlockIStack) - 1]
        eStmtNode = eBlockStmts[eBlockI]
        if eStmtNode == null {
            throw "emit program null stmt at " + ("" + eBlockI)
        }
        emitStmt(eStmtNode)
        eBlockI = eBlockIStack[len(eBlockIStack) - 1] + 1
        eWhNew = []
        eWhI = 0
        while eWhI < len(eBlockIStack) - 1 {
            eWhNew = push(eWhNew, eBlockIStack[eWhI])
            eWhI = eWhI + 1
        }
        eBlockIStack = eWhNew
        eBlockIStack = push(eBlockIStack, eBlockI)
    }
    emitOp(OP_HALT, 0)
    return { "constants": eConsts, "globals": eGlobals, "ops": eOps, "functions": eFunctions, "exports": eExports, "imports": eImports }
}
