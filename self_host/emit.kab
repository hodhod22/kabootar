// Self-hosted bytecode emitter - produces opcode IR from AST.
// Emitter scratch slots are module-level (Kabootar fn locals are not re-entrant).
import "self_host/ast_defs"
import "self_host/emit_defs"

let eConsts = []
let eOps = []
let eGlobals = []
let eFnOps = []
let eFnGlobals = []
let eFnLocals = []
let eInFn = 0
let eIdx = 0
let eSym = null
let eJmp = 0
let eEnd = 0
let eNode = null
let eProg = 0
let eLeft = null
let eRight = null
let eOp = ""
let eCond = null
let eThen = null
let eElse = null
let eProgram = null
let eFunctions = []
let eParams = []
let eFnBody = null
let eFnName = ""
let eBxL = null
let eBxR = null
let eArgs = []
let eCallee = null
let eCallI = 0
let eArgN = 0
let eLocalI = 0
let eGlobI = 0
let eConstI = 0
let eStmtI = 0
let eObjI = 0
let eParamI = 0
let eFound = 0

fn localIndex(name) {
    eLocalI = 0
    while eLocalI < len(eFnLocals) {
        if eFnLocals[eLocalI] == name {
            return eLocalI
        }
        eLocalI = eLocalI + 1
    }
    eFnLocals = push(eFnLocals, name)
    return len(eFnLocals) - 1
}

fn globalIndex(name) {
    if eInFn == 1 {
        eGlobI = 0
        while eGlobI < len(eFnGlobals) {
            if eFnGlobals[eGlobI] == name {
                return eGlobI
            }
            eGlobI = eGlobI + 1
        }
        eFnGlobals = push(eFnGlobals, name)
        return len(eFnGlobals) - 1
    }
    eGlobI = 0
    while eGlobI < len(eGlobals) {
        if eGlobals[eGlobI] == name {
            return eGlobI
        }
        eGlobI = eGlobI + 1
    }
    eGlobals = push(eGlobals, name)
    return len(eGlobals) - 1
}

fn constIndex(value) {
    eConstI = 0
    while eConstI < len(eConsts) {
        if eConsts[eConstI] == value {
            return eConstI
        }
        eConstI = eConstI + 1
    }
    eConsts = push(eConsts, value)
    return len(eConsts) - 1
}

fn emitOp(op, arg) {
    if eInFn == 1 {
        eFnOps = push(eFnOps, { "op": op, "arg": arg })
    } else {
        eOps = push(eOps, { "op": op, "arg": arg })
    }
}

fn emitExpr(node) {
    eNode = node
    if eNode.kind == AST_LITERAL {
        eIdx = constIndex(eNode["value"])
        emitOp(OP_CONST, eIdx)
        return
    }
    if eNode.kind == AST_VAR {
        eSym = eNode["sym"]
        if eInFn == 1 {
            eFound = 0
            eLocalI = 0
            while eLocalI < len(eFnLocals) {
                if eFnLocals[eLocalI] == eSym {
                    eIdx = eLocalI
                    eFound = 1
                    eLocalI = len(eFnLocals)
                } else {
                    eLocalI = eLocalI + 1
                }
            }
            if eFound == 1 {
                emitOp(OP_LOAD_LOCAL, eIdx)
            } else {
                eIdx = globalIndex(eSym)
                emitOp(OP_LOAD_GLOBAL, eIdx)
            }
        } else {
            eIdx = globalIndex(eSym)
            emitOp(OP_LOAD_GLOBAL, eIdx)
        }
        return
    }
    if eNode.kind == AST_BINARY {
        eBxL = eNode["left"]
        eBxR = eNode["right"]
        eOp = eNode["op"]
        if eInFn == 1 {
            eNode = eBxL
            if eNode.kind == AST_LITERAL {
                eIdx = constIndex(eNode["value"])
                emitOp(OP_CONST, eIdx)
            } else {
                if eNode.kind == AST_VAR {
                    eSym = eNode["sym"]
                    eFound = 0
                    eLocalI = 0
                    while eLocalI < len(eFnLocals) {
                        if eFnLocals[eLocalI] == eSym {
                            eIdx = eLocalI
                            eFound = 1
                            eLocalI = len(eFnLocals)
                        } else {
                            eLocalI = eLocalI + 1
                        }
                    }
                    if eFound == 1 {
                        emitOp(OP_LOAD_LOCAL, eIdx)
                    } else {
                        eIdx = globalIndex(eSym)
                        emitOp(OP_LOAD_GLOBAL, eIdx)
                    }
                } else {
                    emitExpr(eBxL)
                }
            }
            eNode = eBxR
            if eNode.kind == AST_LITERAL {
                eIdx = constIndex(eNode["value"])
                emitOp(OP_CONST, eIdx)
            } else {
                if eNode.kind == AST_VAR {
                    eSym = eNode["sym"]
                    eFound = 0
                    eLocalI = 0
                    while eLocalI < len(eFnLocals) {
                        if eFnLocals[eLocalI] == eSym {
                            eIdx = eLocalI
                            eFound = 1
                            eLocalI = len(eFnLocals)
                        } else {
                            eLocalI = eLocalI + 1
                        }
                    }
                    if eFound == 1 {
                        emitOp(OP_LOAD_LOCAL, eIdx)
                    } else {
                        eIdx = globalIndex(eSym)
                        emitOp(OP_LOAD_GLOBAL, eIdx)
                    }
                } else {
                    emitExpr(eBxR)
                }
            }
        } else {
            emitExpr(eBxL)
            emitExpr(eBxR)
        }
        if eOp == "+" {
            emitOp(OP_ADD, 0)
            return
        }
        if eOp == "==" {
            emitOp(OP_EQ, 0)
            return
        }
        if eOp == "!=" {
            emitOp(OP_NE, 0)
            return
        }
        if eOp == "<" {
            emitOp(OP_LT, 0)
            return
        }
        if eOp == ">=" {
            emitOp(OP_GE, 0)
            return
        }
        if eOp == "<=" {
            emitOp(OP_LE, 0)
            return
        }
        if eOp == "&&" {
            emitOp(OP_AND, 0)
            return
        }
        throw "Unsupported binary op: " + eOp
    }
    if eNode.kind == AST_OBJECT {
        eLeft = eNode["fields"]
        eObjI = 0
        while eObjI < len(eLeft) {
            eFld = eLeft[eObjI]
            emitExpr(eFld["value"])
            eIdx = constIndex(eFld["key"])
            emitOp(OP_CONST, eIdx)
            eObjI = eObjI + 1
        }
        emitOp(OP_MAKE_OBJECT, len(eLeft))
        return
    }
    if eNode.kind == AST_MEMBER {
        emitExpr(eNode["object"])
        eIdx = constIndex(eNode["field"])
        emitOp(OP_GET_MEMBER, eIdx)
        return
    }
    if eNode.kind == AST_INDEX {
        emitExpr(eNode["object"])
        emitExpr(eNode["index"])
        emitOp(OP_INDEX_GET, 0)
        return
    }
    if eNode.kind == AST_CALL {
        eArgs = eNode["args"]
        eCallee = eNode["callee"]
        eArgN = len(eArgs)
        if eArgN == 0 {
            emitExpr(eCallee)
            emitOp(OP_CALL, 0)
            return
        }
        if eArgN == 1 {
            eNode = eArgs[0]
            if eNode.kind == AST_LITERAL {
                eIdx = constIndex(eNode["value"])
                emitOp(OP_CONST, eIdx)
            } else {
                if eNode.kind == AST_VAR {
                    eSym = eNode["sym"]
                    if eInFn == 1 {
                        eFound = 0
                        eLocalI = 0
                        while eLocalI < len(eFnLocals) {
                            if eFnLocals[eLocalI] == eSym {
                                eIdx = eLocalI
                                eFound = 1
                                eLocalI = len(eFnLocals)
                            } else {
                                eLocalI = eLocalI + 1
                            }
                        }
                        if eFound == 1 {
                            emitOp(OP_LOAD_LOCAL, eIdx)
                        } else {
                            eIdx = globalIndex(eSym)
                            emitOp(OP_LOAD_GLOBAL, eIdx)
                        }
                    } else {
                        eIdx = globalIndex(eSym)
                        emitOp(OP_LOAD_GLOBAL, eIdx)
                    }
                } else {
                    emitExpr(eArgs[0])
                }
            }
            emitExpr(eCallee)
            emitOp(OP_CALL, 1)
            return
        }
        if eArgN == 2 {
            eLeft = eArgs[0]
            eRight = eArgs[1]
            eNode = eLeft
            if eNode.kind == AST_LITERAL {
                eIdx = constIndex(eNode["value"])
                emitOp(OP_CONST, eIdx)
            } else {
                if eNode.kind == AST_VAR {
                    eSym = eNode["sym"]
                    if eInFn == 1 {
                        eFound = 0
                        eLocalI = 0
                        while eLocalI < len(eFnLocals) {
                            if eFnLocals[eLocalI] == eSym {
                                eIdx = eLocalI
                                eFound = 1
                                eLocalI = len(eFnLocals)
                            } else {
                                eLocalI = eLocalI + 1
                            }
                        }
                        if eFound == 1 {
                            emitOp(OP_LOAD_LOCAL, eIdx)
                        } else {
                            eIdx = globalIndex(eSym)
                            emitOp(OP_LOAD_GLOBAL, eIdx)
                        }
                    } else {
                        eIdx = globalIndex(eSym)
                        emitOp(OP_LOAD_GLOBAL, eIdx)
                    }
                } else {
                    emitExpr(eLeft)
                }
            }
            eNode = eRight
            if eNode.kind == AST_LITERAL {
                eIdx = constIndex(eNode["value"])
                emitOp(OP_CONST, eIdx)
            } else {
                if eNode.kind == AST_VAR {
                    eSym = eNode["sym"]
                    if eInFn == 1 {
                        eFound = 0
                        eLocalI = 0
                        while eLocalI < len(eFnLocals) {
                            if eFnLocals[eLocalI] == eSym {
                                eIdx = eLocalI
                                eFound = 1
                                eLocalI = len(eFnLocals)
                            } else {
                                eLocalI = eLocalI + 1
                            }
                        }
                        if eFound == 1 {
                            emitOp(OP_LOAD_LOCAL, eIdx)
                        } else {
                            eIdx = globalIndex(eSym)
                            emitOp(OP_LOAD_GLOBAL, eIdx)
                        }
                    } else {
                        eIdx = globalIndex(eSym)
                        emitOp(OP_LOAD_GLOBAL, eIdx)
                    }
                } else {
                    emitExpr(eRight)
                }
            }
            emitExpr(eCallee)
            emitOp(OP_CALL, 2)
            return
        }
        eCallI = 0
        while eCallI < eArgN {
            eNode = eArgs[eCallI]
            if eNode.kind == AST_LITERAL {
                eIdx = constIndex(eNode["value"])
                emitOp(OP_CONST, eIdx)
            } else {
                if eNode.kind == AST_VAR {
                    eSym = eNode["sym"]
                    if eInFn == 1 {
                        eFound = 0
                        eLocalI = 0
                        while eLocalI < len(eFnLocals) {
                            if eFnLocals[eLocalI] == eSym {
                                eIdx = eLocalI
                                eFound = 1
                                eLocalI = len(eFnLocals)
                            } else {
                                eLocalI = eLocalI + 1
                            }
                        }
                        if eFound == 1 {
                            emitOp(OP_LOAD_LOCAL, eIdx)
                        } else {
                            eIdx = globalIndex(eSym)
                            emitOp(OP_LOAD_GLOBAL, eIdx)
                        }
                    } else {
                        eIdx = globalIndex(eSym)
                        emitOp(OP_LOAD_GLOBAL, eIdx)
                    }
                } else {
                    emitExpr(eNode)
                }
            }
            eCallI = eCallI + 1
        }
        emitExpr(eCallee)
        emitOp(OP_CALL, eArgN)
        return
    }
    throw "Unsupported expr: " + eNode.kind
}

fn emitStmt(node) {
    eNode = node
    if eNode.kind == AST_LET {
        eSym = eNode["sym"]
        emitExpr(eNode["init"])
        if eInFn == 1 {
            eIdx = localIndex(eSym)
            emitOp(OP_STORE_LOCAL, eIdx)
        } else {
            eIdx = globalIndex(eSym)
            emitOp(OP_STORE_GLOBAL, eIdx)
        }
        return
    }
    if eNode.kind == AST_ASSIGN {
        eSym = eNode["sym"]
        emitExpr(eNode["rhs"])
        if eInFn == 1 {
            eIdx = localIndex(eSym)
            emitOp(OP_STORE_LOCAL, eIdx)
        } else {
            eIdx = globalIndex(eSym)
            emitOp(OP_STORE_GLOBAL, eIdx)
        }
        return
    }
    if eNode.kind == AST_EXPR {
        emitExpr(eNode["expr"])
        emitOp(OP_POP, 0)
        return
    }
    if eNode.kind == AST_RETURN {
        if eNode["value"] == null {
            emitOp(OP_CONST, constIndex(null))
        } else {
            emitExpr(eNode["value"])
        }
        emitOp(OP_RETURN, 0)
        return
    }
    if eNode.kind == AST_BLOCK {
        eLeft = eNode["body"]
        eStmtI = 0
        while eStmtI < len(eLeft) {
            emitStmt(eLeft[eStmtI])
            eStmtI = eStmtI + 1
        }
        return
    }
    if eNode.kind == AST_IF {
        eCond = eNode["cond"]
        eThen = eNode["then"]
        eElse = eNode["elseBranch"]
        emitExpr(eCond)
        if eInFn == 1 {
            eJmp = len(eFnOps)
        } else {
            eJmp = len(eOps)
        }
        emitOp(OP_JUMP_IF_FALSE, 0)
        emitStmt(eThen)
        if eElse != null {
            if eInFn == 1 {
                eIdx = len(eFnOps)
            } else {
                eIdx = len(eOps)
            }
            emitOp(OP_JUMP, 0)
            if eInFn == 1 {
                eEnd = len(eFnOps)
                eFnOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eEnd }
            } else {
                eEnd = len(eOps)
                eOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eEnd }
            }
            emitStmt(eElse)
            if eInFn == 1 {
                eEnd = len(eFnOps)
                eFnOps[eIdx] = { "op": OP_JUMP, "arg": eEnd }
            } else {
                eEnd = len(eOps)
                eOps[eIdx] = { "op": OP_JUMP, "arg": eEnd }
            }
        } else {
            if eInFn == 1 {
                eEnd = len(eFnOps)
                eFnOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eEnd }
            } else {
                eEnd = len(eOps)
                eOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eEnd }
            }
        }
        return
    }
    if eNode.kind == AST_WHILE {
        eCond = eNode["cond"]
        eThen = eNode["body"]
        if eInFn == 1 {
            eIdx = len(eFnOps)
        } else {
            eIdx = len(eOps)
        }
        emitExpr(eCond)
        if eInFn == 1 {
            eJmp = len(eFnOps)
        } else {
            eJmp = len(eOps)
        }
        emitOp(OP_JUMP_IF_FALSE, 0)
        emitStmt(eThen)
        emitOp(OP_JUMP, eIdx)
        if eInFn == 1 {
            eEnd = len(eFnOps)
            eFnOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eEnd }
        } else {
            eEnd = len(eOps)
            eOps[eJmp] = { "op": OP_JUMP_IF_FALSE, "arg": eEnd }
        }
        return
    }
    if eNode.kind == AST_FN {
        eFnName = eNode["sym"]
        eParams = eNode["params"]
        eFnBody = eNode["body"]
        eInFn = 1
        eFnOps = []
        eFnGlobals = []
        eFnLocals = []
        eParamI = 0
        while eParamI < len(eParams) {
            localIndex(eParams[eParamI])
            eParamI = eParamI + 1
        }
        emitStmt(eFnBody)
        eFunctions = push(eFunctions, {
            "sym": eFnName,
            "params": eParams,
            "locals": eFnLocals,
            "globals": eFnGlobals,
            "ops": eFnOps
        })
        eInFn = 0
        globalIndex(eFnName)
        return
    }
    throw "Unsupported stmt: " + eNode.kind
}

pub fn emit(program) {
    eProgram = program
    eConsts = []
    eOps = []
    eGlobals = []
    eFunctions = []
    eFnOps = []
    eFnGlobals = []
    eFnLocals = []
    eInFn = 0
    eProg = 0
    while eProg < len(eProgram["body"]) {
        emitStmt(eProgram["body"][eProg])
        eProg = eProg + 1
    }
    emitOp(OP_HALT, 0)
    return { "constants": eConsts, "globals": eGlobals, "ops": eOps, "functions": eFunctions }
}
