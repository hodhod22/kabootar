// H6e: self-hosted bytecode emitter — thin facade (impl in emit_impl.kab).
// import "self_host/emit"
//
// Re-export by alias (not a wrapping fn) — see self_host/vm.kab header for why
// wrapping fns break Kab VM reentrancy under KABOOTAR_VM=kab-only.
//
// emit_impl.kab stays skip-listed (P6 seed-only). Body densified into session-
// threaded shards (emit_exec + emit_expr_* / emit_stmt_*); empty skip-list waits
// until every shard self-host-compiles ≤10s (P6b).

import "self_host/emit_impl"

pub let emit = emitImpl
