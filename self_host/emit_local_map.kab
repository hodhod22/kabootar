pub fn resetLocalMap(E) {
    E["eLocalMap"] = {}
    E["eLocalN"] = 0
}

pub fn rebuildLocalMap(E) {
    E["eLocalMap"] = {}
    E["eLocalN"] = 0
    let i = 0
    let n = len(E["eFnLocals"])
    while i < n {
        E["eLocalMap"][E["eFnLocals"][i]] = i
        E["eLocalN"] = E["eLocalN"] + 1
        i = i + 1
    }
}

