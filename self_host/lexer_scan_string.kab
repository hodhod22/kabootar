import "self_host/lexer_defs"
import "self_host/lexer_util"

pub fn lxScanHash(sess, c, line, col) {
    if c != "#" {
        return null
    }
    lxEat(sess)
    let start = sess["pos"]
    while sess["pos"] < sess["srcLen"] {
        let cd = char_code_at(sess["src"], sess["pos"])
        let ch = char_at(sess["src"], sess["pos"])
        let ok = 0
        if cd >= 65 && cd <= 90 { ok = 1 }
        if cd >= 97 && cd <= 122 { ok = 1 }
        if cd >= 48 && cd <= 57 { ok = 1 }
        if ch == "_" { ok = 1 }
        if ok == 0 { break }
        lxEat(sess)
    }
    if sess["pos"] == start {
        throw "Expected identifier after # at line " + ("" + line) + " col " + ("" + col)
    }
    return lxTok(TOKEN_PRIVATE, str_slice(sess["src"], start, sess["pos"]), line, col)
}

pub fn lxScanString(sess, c, line, col) {
    if c != "\"" {
        return null
    }
    lxEat(sess)
    let start = sess["pos"]
    let i = sess["pos"]
    let hasEsc = 0
    while i < sess["srcLen"] {
        let ch = char_at(sess["src"], i)
        if ch == "\\" {
            hasEsc = 1
            break
        }
        if ch == "\"" {
            break
        }
        i = i + 1
    }
    if hasEsc == 0 {
        if i >= sess["srcLen"] {
            throw "Unterminated string at line " + ("" + line) + " col " + ("" + col)
        }
        let s = str_slice(sess["src"], start, i)
        sess["col"] = sess["col"] + (i - start) + 1
        sess["pos"] = i + 1
        return lxTok(TOKEN_STRING, s, line, col)
    }
    let s = ""
    while sess["pos"] < sess["srcLen"] {
        let ch = char_at(sess["src"], sess["pos"])
        if ch == "\\" {
            lxEat(sess)
            if sess["pos"] >= sess["srcLen"] {
                throw "Unterminated string escape at line " + ("" + line) + " col " + ("" + col)
            }
            let e = char_at(sess["src"], sess["pos"])
            lxEat(sess)
            let piece = "\\" + e
            if e == "n" { piece = "\n" }
            if e == "r" { piece = "\r" }
            if e == "t" { piece = "\t" }
            if e == "\"" { piece = "\"" }
            if e == "\\" { piece = "\\" }
            s = s + piece
            continue
        }
        lxEat(sess)
        if ch == "\"" {
            break
        }
        s = s + ch
    }
    return lxTok(TOKEN_STRING, s, line, col)
}
