import "self_host/lexer_defs"
import "self_host/lexer_util"

pub fn lxScanPlusMinus(sess, c, line, col) {
    if c == "+" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("+=", null, line, col)
        }
        return lxTok("+", null, line, col)
    }
    if c == "-" {
        lxEat(sess)
        if lxStarts(sess, ">") == 1 {
            lxEat(sess)
            return lxTok("->", null, line, col)
        }
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("-=", null, line, col)
        }
        return lxTok("-", null, line, col)
    }
    return null
}

pub fn lxScanMulDiv(sess, c, line, col) {
    if c == "*" {
        lxEat(sess)
        if lxStarts(sess, "*") == 1 {
            lxEat(sess)
            return lxTok("**", null, line, col)
        }
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("*=", null, line, col)
        }
        return lxTok("*", null, line, col)
    }
    if c == "/" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("/=", null, line, col)
        }
        return lxTok("/", null, line, col)
    }
    if c == "%" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("%=", null, line, col)
        }
        return lxTok("%", null, line, col)
    }
    return null
}
