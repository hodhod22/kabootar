import "self_host/vm_s_stack"
import "self_host/vm_run_session"

// --- vm_ops_data_concat ---
pub fn runOpDataConcat(S, name, arg, op, pool, globals, functions) {
    if name == "concat_array" {
        let right = vPopS(S)
        let left = vPopS(S)
        let out = left
        let i = 0
        while i < len(right) {
            out = push(out, right[i])
            i = i + 1
        }
        vPushS(S, out)
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_data_dup ---
pub fn runOpDataDup(S, name, arg, op, pool, globals, functions) {
    if name == "dup" {
        if len(S["stack"]) == 0 {
            throw "vm stack underflow"
        }
        vPushS(S, S["stack"][len(S["stack"]) - 1])
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_data_err ---
pub fn runOpDataErr(S, name, arg, op, pool, globals, functions) {
    if name == "make_err" {
        vPushS(S, { "vmResult": "err", "v": vPopS(S) })
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_data_index_get ---
pub fn runOpDataIndexGet(S, name, arg, op, pool, globals, functions) {
    if name == "index_get" {
        let idx = vPopS(S)
        let container = vPopS(S)
        vPushS(S, vIndexGet(container, idx))
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_data_index_set ---
pub fn runOpDataIndexSet(S, name, arg, op, pool, globals, functions) {
    if name == "index_set" {
        let val = vPopS(S)
        let idx = vPopS(S)
        let container = vPopS(S)
        vIndexSetPush(S, container, idx, val)
        return 1
    }
    return 0
}

// --- vm_ops_data_len ---
pub fn runOpDataLen(S, name, arg, op, pool, globals, functions) {
    if name == "get_length" {
        let v = vPopS(S)
        vPushS(S, len(v))
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_data_make_array ---
pub fn runOpDataMakeArray(S, name, arg, op, pool, globals, functions) {
    if name == "make_array" {
        let n = arg
        let raw = vPopNRaw(S, n)
        let arr = vReverseArr(raw, n)
        vPushS(S, arr)
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_data_make_object ---
pub fn runOpDataMakeObject(S, name, arg, op, pool, globals, functions) {
    if name == "make_object" {
        let n = arg
        let map = {}
        let ci = 0
        while ci < n {
            let key = vPopS(S)
            let val = vPopS(S)
            map["" + key] = val
            ci = ci + 1
        }
        vPushS(S, map)
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_data_merge ---
pub fn runOpDataMerge(S, name, arg, op, pool, globals, functions) {
    if name == "merge_object" {
        let right = vPopS(S)
        let left = vPopS(S)
        let keys = object_keys(right)
        let ki = 0
        while ki < len(keys) {
            let k = keys[ki]
            left[k] = right[k]
            ki = ki + 1
        }
        vPushS(S, left)
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_data_ok ---
pub fn runOpDataOk(S, name, arg, op, pool, globals, functions) {
    if name == "make_ok" {
        vPushS(S, { "vmResult": "ok", "v": vPopS(S) })
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_data_option_arrow ---
pub fn runOpDataOptionArrow(S, name, arg, op, pool, globals, functions) {
    if name == "make_arrow_fn" {
        vPushS(S, { "vmArrow": arg, "caps": vSnapCapsS(S) })
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_data_option_iter ---
pub fn runOpDataOptionIter(S, name, arg, op, pool, globals, functions) {
    if name == "iterator_step_in_place" {
        let it = vPopS(S)
        if vObjGet(it, "vmGen") == 1 {
            let r = vResumeGeneratorS(S, it, pool, globals, functions)
            vPushS(S, it)
            vPushS(S, r)
            vBumpIpS(S)
            return 1
        }
        if vObjGet(it, "vmGen") == true {
            let r2 = vResumeGeneratorS(S, it, pool, globals, functions)
            vPushS(S, it)
            vPushS(S, r2)
            vBumpIpS(S)
            return 1
        }
        let pair = bytecode_iterator_step_in_place(it)
        vPushS(S, pair[0])
        vPushS(S, pair[1])
        vBumpIpS(S)
        return 1
    }
    if name == "async_iterator_step_in_place" {
        let it = vPopS(S)
        let del = vObjGet(it, "__kab_async_sync_delegate")
        if del != undefined {
            it = del
        }
        let pair = bytecode_iterator_step_in_place(it)
        vPushS(S, pair[0])
        vPushS(S, vCallHost(bytecode_host_get("promise_resolve"), [pair[1]]))
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_data_option_some ---
pub fn runOpDataOptionSome(S, name, arg, op, pool, globals, functions) {
    if name == "make_some" {
        vPushS(S, { "vmOption": "some", "v": vPopS(S) })
        vBumpIpS(S)
        return 1
    }
    if name == "make_none" {
        vPushS(S, { "vmOption": "none" })
        vBumpIpS(S)
        return 1
    }
    return 0
}

// --- vm_ops_data_set_member ---
pub fn runOpDataSetMember(S, name, arg, op, pool, globals, functions) {
    if name == "member_set" {
        let key = poolKey(pool, arg)
        let val = vPopS(S)
        let obj = vPopS(S)
        vMemberSetPush(S, obj, key, val)
        return 1
    }
    return 0
}

// --- vm_ops_data_swap ---
pub fn runOpDataSwap(S, name, arg, op, pool, globals, functions) {
    if name == "swap" {
        let a = vPopS(S)
        let b = vPopS(S)
        vPushS(S, a)
        vPushS(S, b)
        vBumpIpS(S)
        return 1
    }
    return 0
}

pub fn runOpDataIndexPeekFromEnd(S, name, arg, op, pool, globals, functions) {
    if name != "index_peek_from_end" {
        return 0
    }
    let arr = vPeekS(S)
    if typeof(arr) != "array" {
        throw "IndexPeekFromEnd requires an array"
    }
    let fromEnd = arg
    if fromEnd <= 0 || fromEnd > len(arr) {
        throw "IndexPeekFromEnd index out of range"
    }
    vPushS(S, arr[len(arr) - fromEnd])
    vBumpIpS(S)
    return 1
}

pub fn runOpDataArraySliceFrom(S, name, arg, op, pool, globals, functions) {
    if name != "array_slice_from" {
        return 0
    }
    let arr = vPopS(S)
    if typeof(arr) != "array" {
        throw "ArraySliceFrom requires an array"
    }
    let start = arg
    if start >= len(arr) {
        vPushS(S, [])
    } else {
        vPushS(S, slice(arr, start, len(arr)))
    }
    vBumpIpS(S)
    return 1
}

pub fn runOpDataArraySliceRest(S, name, arg, op, pool, globals, functions) {
    if name != "array_slice_rest" {
        return 0
    }
    let endTrim = op["arg2"]
    if endTrim == undefined {
        endTrim = 0
    }
    let arr = vPopS(S)
    if typeof(arr) != "array" {
        throw "ArraySliceRest requires an array"
    }
    let start = arg
    if start + endTrim > len(arr) {
        vPushS(S, [])
    } else {
        vPushS(S, slice(arr, start, len(arr) - endTrim))
    }
    vBumpIpS(S)
    return 1
}

pub fn runOpDataObjectRest(S, name, arg, op, pool, globals, functions) {
    if name != "object_rest" {
        return 0
    }
    let n = arg
    let exclude = {}
    let i = 0
    while i < n {
        exclude["" + vPopS(S)] = 1
        i = i + 1
    }
    let obj = vPopS(S)
    if typeof(obj) != "object" || obj == null {
        throw "ObjectRest requires an object"
    }
    let rest = {}
    let keys = object_keys(obj)
    i = 0
    while i < len(keys) {
        let k = keys[i]
        if exclude[k] != 1 {
            rest[k] = obj[k]
        }
        i = i + 1
    }
    vPushS(S, rest)
    vBumpIpS(S)
    return 1
}

// --- vm_ops_data_index ---
pub fn runOpDataIndex(S, name, arg, op, pool, globals, functions) {
    let st = runOpDataIndexGet(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpDataIndexSet(S, name, arg, op, pool, globals, functions)
}

// --- vm_ops_data_len_concat ---
pub fn runOpDataLenConcat(S, name, arg, op, pool, globals, functions) {
    let st = runOpDataLen(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpDataConcat(S, name, arg, op, pool, globals, functions)
}

// --- vm_ops_data_make ---
pub fn runOpDataMake(S, name, arg, op, pool, globals, functions) {
    let st = runOpDataMakeObject(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpDataMakeArray(S, name, arg, op, pool, globals, functions)
}

// --- vm_ops_data_result_question ---
// SH6: `?` on Result. Same contract as host Opcode::ResultQuestion:
// Ok → inner; Err → keep Err; else throw. Uses session stack S (no module globals).
pub fn runOpDataResultQuestion(S, name, arg, op, pool, globals, functions) {
    if name != "result_question" {
        return 0
    }
    let v = vPopS(S)
    let tag = vObjGet(v, "vmResult")
    if tag == "ok" {
        vPushS(S, vObjGet(v, "v"))
        vBumpIpS(S)
        return 1
    }
    if tag == "err" {
        vPushS(S, v)
        vBumpIpS(S)
        return 1
    }
    throw "? operator requires Result (Ok/Err)"
}

// --- vm_ops_data_result ---
pub fn runOpDataResult(S, name, arg, op, pool, globals, functions) {
    let st = runOpDataOk(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    st = runOpDataErr(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpDataResultQuestion(S, name, arg, op, pool, globals, functions)
}

// --- vm_ops_data_option ---
pub fn runOpDataOption(S, name, arg, op, pool, globals, functions) {
    let st = runOpDataOptionSome(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    st = runOpDataOptionArrow(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpDataOptionIter(S, name, arg, op, pool, globals, functions)
}

// --- vm_ops_data_stack ---
pub fn runOpDataStack(S, name, arg, op, pool, globals, functions) {
    let st = runOpDataDup(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    st = runOpDataSwap(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    st = runOpDataIndexPeekFromEnd(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    st = runOpDataArraySliceFrom(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    st = runOpDataArraySliceRest(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpDataObjectRest(S, name, arg, op, pool, globals, functions)
}

// --- vm_ops_data_c ---
pub fn runOpDataC(S, name, arg, op, pool, globals, functions) {
    let st = runOpDataLenConcat(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpDataMerge(S, name, arg, op, pool, globals, functions)
}

// --- vm_ops_data_a ---
pub fn runOpDataA(S, name, arg, op, pool, globals, functions) {
    let st = runOpDataMake(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpDataIndex(S, name, arg, op, pool, globals, functions)
}

// --- vm_ops_data_d ---
pub fn runOpDataD(S, name, arg, op, pool, globals, functions) {
    let st = runOpDataResult(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpDataOption(S, name, arg, op, pool, globals, functions)
}

// --- vm_ops_data_b ---
pub fn runOpDataB(S, name, arg, op, pool, globals, functions) {
    let st = runOpDataSetMember(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpDataStack(S, name, arg, op, pool, globals, functions)
}
