import "self_host/vm_s_push"
import "self_host/vm_s_pop"
import "self_host/vm_s_ip"

pub fn runOpDataConcat(S, name, arg, op, pool, globals, functions) {
    if name == "concat_array" {
        let right = vPopS(S)
        let left = vPopS(S)
        let out = left
        let i = 0
        while i < len(right) {
            out = push(out, right[i])
            i = i + 1
        }
        vPushS(S, out)
        vBumpIpS(S)
        return 1
    }
    return 0
}
