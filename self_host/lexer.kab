// SH5: lexer facade — tokenizeExec in lexer_tokenize (no lexer_impl hop).
// import "self_host/lexer"
// tokenize is an alias; type/value helpers are tiny field reads.

import "self_host/lexer_tokenize"

pub let tokenize = tokenizeExec

pub fn token_type_name(tok) {
    return tok.type
}

pub fn token_value(tok) {
    return tok.value
}
