// Self-hosted Kabootar lexer - mirrors src/lexer.rs.
// KEEP <=~4 top-level fn (lxScan, tokenize, token_type_name, token_value).
// More private fn causes stack overflow on module init (Windows); inline helpers in lxScan.
import "self_host/lexer_defs"

let lxPos = 0
let lxSrc = ""
let lxLine = 1
let lxCol = 1

// ----- HELPER FUNCTIONS -----
// char_code_at: use runtime builtin

fn parse_int(s) {
    let result = 0
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        let digit = char_code_at(c, 0) - 48
        if digit >= 0 && digit <= 9 {
            let tmp = 0
            let k = 0
            while k < 10 {
                tmp = tmp + result
                k = k + 1
            }
            result = tmp + digit
        }
        i = i + 1
    }
    return result
}

fn parse_float(s) {
    let parts = []
    let current = ""
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == "." {
            parts = push(parts, current)
            current = ""
        } else {
            current = current + c
        }
        i = i + 1
    }
    parts = push(parts, current)
    let intPart = parse_int(parts[0])
    let fracPart = parse_int(parts[1])
    let fracLen = len(parts[1])
    let divisor = 1
    let j = 0
    while j < fracLen {
        let tmp = 0
        let k = 0
        while k < 10 {
            tmp = tmp + divisor
            k = k + 1
        }
        divisor = tmp
        j = j + 1
    }
    let quot = 0
    let rem = fracPart
    while rem >= divisor {
        rem = rem - divisor
        quot = quot + 1
    }
    return intPart + quot
}

// ----- MAIN LEXER -----

fn lxScan() {
    if lxPos >= len(lxSrc) {
        return { "type": TOKEN_EOF, "value": null, "line": lxLine, "column": lxCol }
    }
    let c = char_at(lxSrc, lxPos)
    let line = lxLine
    let col = lxCol

    // Single-character tokens
    if c == "(" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        return { "type": "(", "value": null, "line": line, "column": col }
    }
    if c == ")" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        return { "type": ")", "value": null, "line": line, "column": col }
    }
    if c == "{" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        return { "type": "{", "value": null, "line": line, "column": col }
    }
    if c == "}" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        return { "type": "}", "value": null, "line": line, "column": col }
    }
    if c == "[" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        return { "type": "[", "value": null, "line": line, "column": col }
    }
    if c == "]" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        return { "type": "]", "value": null, "line": line, "column": col }
    }
    if c == ";" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        return { "type": ";", "value": null, "line": line, "column": col }
    }
    if c == "," {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        return { "type": ",", "value": null, "line": line, "column": col }
    }
    if c == ":" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        return { "type": ":", "value": null, "line": line, "column": col }
    }
    if c == "^" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        return { "type": "^", "value": null, "line": line, "column": col }
    }
    if c == "~" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        return { "type": "~", "value": null, "line": line, "column": col }
    }

    // Multi-character tokens
    if c == "+" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "=" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "+=", "value": null, "line": line, "column": col }
        }
        return { "type": "+", "value": null, "line": line, "column": col }
    }

    if c == "-" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == ">" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "->", "value": null, "line": line, "column": col }
        }
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "=" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "-=", "value": null, "line": line, "column": col }
        }
        return { "type": "-", "value": null, "line": line, "column": col }
    }

    if c == "*" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "*" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "**", "value": null, "line": line, "column": col }
        }
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "=" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "*=", "value": null, "line": line, "column": col }
        }
        return { "type": "*", "value": null, "line": line, "column": col }
    }

    if c == "/" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "=" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "/=", "value": null, "line": line, "column": col }
        }
        return { "type": "/", "value": null, "line": line, "column": col }
    }

    if c == "%" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "=" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "%=", "value": null, "line": line, "column": col }
        }
        return { "type": "%", "value": null, "line": line, "column": col }
    }

    if c == "?" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "?" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "??", "value": null, "line": line, "column": col }
        }
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "." {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "?.", "value": null, "line": line, "column": col }
        }
        return { "type": "?", "value": null, "line": line, "column": col }
    }

    if c == "=" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "=" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "==", "value": null, "line": line, "column": col }
        }
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == ">" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "=>", "value": null, "line": line, "column": col }
        }
        return { "type": "=", "value": null, "line": line, "column": col }
    }

    if c == "!" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "=" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "!=", "value": null, "line": line, "column": col }
        }
        return { "type": "!", "value": null, "line": line, "column": col }
    }

    if c == "&" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "&" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "&&", "value": null, "line": line, "column": col }
        }
        return { "type": "&", "value": null, "line": line, "column": col }
    }

    if c == "|" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "|" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "||", "value": null, "line": line, "column": col }
        }
        return { "type": "|", "value": null, "line": line, "column": col }
    }

    if c == "<" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "=" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "<=", "value": null, "line": line, "column": col }
        }
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "<" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": "<<", "value": null, "line": line, "column": col }
        }
        return { "type": "<", "value": null, "line": line, "column": col }
    }

    if c == ">" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "=" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": ">=", "value": null, "line": line, "column": col }
        }
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == ">" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == ">" {
                lxPos = lxPos + 1
                lxCol = lxCol + 1
                return { "type": ">>>", "value": null, "line": line, "column": col }
            }
            return { "type": ">>", "value": null, "line": line, "column": col }
        }
        return { "type": ">", "value": null, "line": line, "column": col }
    }

    if c == "." {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "." {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "." {
                lxPos = lxPos + 1
                lxCol = lxCol + 1
                return { "type": "...", "value": null, "line": line, "column": col }
            }
            throw "Expected ... at line " + ("" + line) + " col " + ("" + col)
        }
        return { "type": ".", "value": null, "line": line, "column": col }
    }

    // Private name: #identifier
    if c == "#" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        let name = ""
        while lxPos < len(lxSrc) {
            let ch = char_at(lxSrc, lxPos)
            let cd = char_code_at(ch, 0)
            let ok = 0
            if cd >= 65 && cd <= 90 { ok = 1 }
            if cd >= 97 && cd <= 122 { ok = 1 }
            if cd >= 48 && cd <= 57 { ok = 1 }
            if ch == "_" { ok = 1 }
            if ok == 0 { break }
            name = name + ch
            lxPos = lxPos + 1
            lxCol = lxCol + 1
        }
        if name == "" {
            throw "Expected identifier after # at line " + ("" + line) + " col " + ("" + col)
        }
        return { "type": TOKEN_PRIVATE, "value": name, "line": line, "column": col }
    }

    // String literal: " ... "
    if c == "\"" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        let s = ""
        while lxPos < len(lxSrc) {
            let ch = char_at(lxSrc, lxPos)
            if ch == "\\" {
                lxPos = lxPos + 1
                lxCol = lxCol + 1
                if lxPos >= len(lxSrc) {
                    throw "Unterminated string escape at line " + ("" + line) + " col " + ("" + col)
                }
                let e = char_at(lxSrc, lxPos)
                lxPos = lxPos + 1
                lxCol = lxCol + 1
                if e == "n" { s = s + "\n" }
                else {
                    if e == "r" { s = s + "\r" }
                    else {
                        if e == "t" { s = s + "\t" }
                        else {
                            if e == "\"" { s = s + "\"" }
                            else {
                                if e == "\\" { s = s + "\\" }
                                else { s = s + "\\" + e }
                            }
                        }
                    }
                }
                continue
            }
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            if ch == "\"" {
                break
            }
            s = s + ch
        }
        return { "type": TOKEN_STRING, "value": s, "line": line, "column": col }
    }

    // Template literal not supported in self-hosted lexer
    if c == BACKTICK {
        throw "Template literal not supported at line " + ("" + line) + " col " + ("" + col)
    }

    // Identifier starting with _
    if c == "_" {
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        let id = "_"
        while lxPos < len(lxSrc) {
            let ch = char_at(lxSrc, lxPos)
            let cd = char_code_at(ch, 0)
            let ok = 0
            if cd >= 65 && cd <= 90 { ok = 1 }
            if cd >= 97 && cd <= 122 { ok = 1 }
            if cd >= 48 && cd <= 57 { ok = 1 }
            if ch == "_" { ok = 1 }
            if ok == 0 { break }
            id = id + ch
            lxPos = lxPos + 1
            lxCol = lxCol + 1
        }
        return { "type": TOKEN_IDENT, "value": id, "line": line, "column": col }
    }

    // Number literal
    let code0 = char_code_at(c, 0)
    if code0 >= 48 && code0 <= 57 {
        let digits = c
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        while lxPos < len(lxSrc) {
            let ch = char_at(lxSrc, lxPos)
            let cd = char_code_at(ch, 0)
            if cd < 48 {
                break
            }
            if cd > 57 {
                break
            }
            digits = digits + ch
            lxPos = lxPos + 1
            lxCol = lxCol + 1
        }
        // BigInt: 123n
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "n" {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            return { "type": TOKEN_BIGINT, "value": digits, "line": line, "column": col }
        }
        // Float: 123.456
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "." {
            lxPos = lxPos + 1
            lxCol = lxCol + 1
            let frac = ""
            while lxPos < len(lxSrc) {
                let ch = char_at(lxSrc, lxPos)
                let cd = char_code_at(ch, 0)
                if cd < 48 {
                    break
                }
                if cd > 57 {
                    break
                }
                frac = frac + ch
                lxPos = lxPos + 1
                lxCol = lxCol + 1
            }
            return { "type": TOKEN_FLOAT, "value": parse_float(digits + "." + frac), "line": line, "column": col }
        }
        return { "type": TOKEN_NUMBER, "value": parse_int(digits), "line": line, "column": col }
    }

    // Identifier or keyword
    let isAlpha = 0
    if code0 >= 97 {
        if code0 <= 122 {
            isAlpha = 1
        }
    }
    if isAlpha == 0 {
        if code0 >= 65 {
            if code0 <= 90 {
                isAlpha = 1
            }
        }
    }
    if isAlpha {
        let id = c
        lxPos = lxPos + 1
        lxCol = lxCol + 1
        while lxPos < len(lxSrc) {
            let ch = char_at(lxSrc, lxPos)
            let cd = char_code_at(ch, 0)
            let ok = 0
            if cd >= 65 && cd <= 90 { ok = 1 }
            if cd >= 97 && cd <= 122 { ok = 1 }
            if cd >= 48 && cd <= 57 { ok = 1 }
            if ch == "_" { ok = 1 }
            if ok == 0 { break }
            id = id + ch
            lxPos = lxPos + 1
            lxCol = lxCol + 1
        }
        let kw = KEYWORDS[id]
        if kw == undefined {
            return { "type": TOKEN_IDENT, "value": id, "line": line, "column": col }
        }
        return { "type": kw, "value": null, "line": line, "column": col }
    }

    throw "Unknown character: " + c + " at line " + ("" + line) + " col " + ("" + col)
}

// ----- PUBLIC API -----

pub fn tokenize(source) {
    lxPos = 0
    lxSrc = source
    lxLine = 1
    lxCol = 1
    let tokens = []

    while true {
        // Skip whitespace
        while lxPos < len(lxSrc) {
            let ch = char_at(lxSrc, lxPos)
            if ch == " " {
                lxCol = lxCol + 1
                lxPos = lxPos + 1
            } else {
                if ch == "\t" {
                    lxCol = lxCol + 1
                    lxPos = lxPos + 1
                } else {
                    if ch == "\r" {
                        lxCol = lxCol + 1
                        lxPos = lxPos + 1
                    } else {
                        if ch == "\n" {
                            lxLine = lxLine + 1
                            lxCol = 1
                            lxPos = lxPos + 1
                        } else {
                            break
                        }
                    }
                }
            }
        }

        if lxPos >= len(lxSrc) {
            break
        }

        // Line comment: //
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "/" {
            if lxPos + 1 < len(lxSrc) && char_at(lxSrc, lxPos + 1) == "/" {
                lxPos = lxPos + 2
                while lxPos < len(lxSrc) {
                    let ch = char_at(lxSrc, lxPos)
                    if ch == "\n" {
                        lxLine = lxLine + 1
                        lxCol = 1
                        lxPos = lxPos + 1
                        break
                    }
                    lxCol = lxCol + 1
                    lxPos = lxPos + 1
                }
                continue
            }
        }

        // Block comment: /* */
        if lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "/" {
            if lxPos + 1 < len(lxSrc) && char_at(lxSrc, lxPos + 1) == "*" {
                lxPos = lxPos + 2
                while lxPos < len(lxSrc) {
                    let ch = char_at(lxSrc, lxPos)
                    lxPos = lxPos + 1
                    lxCol = lxCol + 1
                    if ch == "\n" {
                        lxLine = lxLine + 1
                        lxCol = 1
                    }
                    if ch == "*" && lxPos < len(lxSrc) && char_at(lxSrc, lxPos) == "/" {
                        lxPos = lxPos + 1
                        lxCol = lxCol + 1
                        break
                    }
                }
                continue
            }
        }

        let tok = lxScan()
        if tok.type == TOKEN_EOF {
            break
        }
        tokens = push(tokens, tok)
    }

    tokens = push(tokens, { "type": TOKEN_EOF, "value": null, "line": lxLine, "column": lxCol })
    return tokens
}

pub fn token_type_name(tok) {
    return tok.type
}

pub fn token_value(tok) {
    return tok.value
}