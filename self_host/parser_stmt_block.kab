import "self_host/lexer_defs"
import "self_host/ast_defs"
import "self_host/parser_hooks"
import "self_host/parser_util"

pub fn parseStmt_block(sess) {
    if !(sess["pCur"].type == "{") {
        return null
    }
        bump(sess)
        sess["pBodyStack"] = push(sess["pBodyStack"], sess["pStmts"])
        sess["pBodyDepth"] = sess["pBodyDepth"] + 1
        sess["pStmts"] = []
        while sess["pCur"].type != "}" {
            if sess["pCur"].type == "EOF" {
                throw "Unclosed block"
            }
            sess["pStmts"] = push(sess["pStmts"], pCallStmt(sess))
            if sess["pCur"].type == ";" {
                bump(sess)
            }
        }
        bump(sess)
        let blockStmts = sess["pStmts"]
        sess["pStmts"] = sess["pBodyStack"][sess["pBodyDepth"] - 1]
        sess["pBodyStack"] = pop(sess["pBodyStack"])
        sess["pBodyDepth"] = sess["pBodyDepth"] - 1
        return { "kind": AST_BLOCK, "body": blockStmts }
}

