// H6e: serialize IR body — heavy leaf shard (skip-listed for self-host).
// Reached via self_host/serialize.kab → serialize_impl.kab (both thin facades).
//
// Self-host-compiling this file directly takes minutes even though it is well under
// the 64KB self-host-attempt size threshold — self-hosting cost scales with AST size
// of the source being compiled, not with import-time cost of its dependents. Keep it
// skip-listed and only ever load it via the Rust module loader (fast, exact).
// P6b: densify — IR membership in serialize_defs; shallow AccAdd (outTag/outSpNum/sLine);
// outTagged/outTagEq helpers collapse repeated Call AST; measure with
// p6b_serialize_body_compile_budget before emptying SELF_HOST_SKIP_LISTED_LEAVES.
//
// Everything here shares the module-level `s*` accumulators (sOut, sI, sJ, …) via
// plain call/return. Kabootar modules do not share mutable globals across files —
// each import gets its own copy of the exported bindings — so these functions and
// their state must stay co-located in this one leaf.
import "self_host/lexer_defs"
import "self_host/serialize_defs"
import "self_host/emit_defs"

let sOut = ""
let sI = 0
let sOp = null
let sLine = ""
let sFn = null
let sParams = ""
let sJ = 0
let sK = 0
let sMeth = null
let sCls = null
let sEscOut = ""
let sEscI = 0
let sEscCh = ""
let sArr = null
let sTr = null

// ----- HELPER FUNCTIONS -----

// P6b: sequential escapes (fewer nested If AST nodes for self-host leaf compile).
fn escStr(s) {
    sEscOut = ""
    sEscI = 0
    let n = len(s)
    while sEscI < n {
        sEscCh = char_at(s, sEscI)
        let piece = sEscCh
        if sEscCh == "\\" {
            piece = "\\\\"
        }
        if sEscCh == " " {
            piece = "\\s"
        }
        if sEscCh == "\n" {
            piece = "\\n"
        }
        if sEscCh == "\r" {
            piece = "\\r"
        }
        if sEscCh == "\t" {
            piece = "\\t"
        }
        sEscOut = sEscOut + piece
        sEscI = sEscI + 1
    }
    return sEscOut
}

// P6b: AccAdd helpers — shallow emit vs Binary + trees.
fn outTag(tag) {
    sOut = sOut + CHAR_NL
    sOut = sOut + tag
}

fn outSpNum(x) {
    sOut = sOut + " "
    sOut = sOut + ("" + x)
}

fn outSp(s) {
    sOut = sOut + " "
    sOut = sOut + s
}

// P6b: collapse tag=N / tag i rest Call triples into one Call at each site.
fn outTagEq(tag, n) {
    outTag(tag)
    sOut = sOut + ("" + n)
}

fn outTagged(tag, i, rest) {
    outTag(tag)
    outSpNum(i)
    outSp(rest)
}

fn outTagged2(tag, a, b, rest) {
    outTag(tag)
    outSpNum(a)
    outSpNum(b)
    outSp(rest)
}

fn outTryRegion(tag, a, b, tr) {
    outTag(tag)
    outSpNum(a)
    outSpNum(b)
    outSpNum(tr["bodyStart"])
    outSpNum(tr["bodyEnd"])
    outSpNum(tr["catchStart"])
    outSpNum(tr["errLocal"])
}

fn constLine(idx, val) {
    sLine = "const "
    sLine = sLine + ("" + idx)
    sLine = sLine + " "
    if val == KAB_UNDEF_CONST {
        sLine = sLine + "undefined"
        return sLine
    }
    if val == null {
        sLine = sLine + "null"
        return sLine
    }
    if val == true {
        sLine = sLine + "bool true"
        return sLine
    }
    if val == false {
        sLine = sLine + "bool false"
        return sLine
    }
    if typeof(val) == "string" {
        sLine = sLine + "string "
        sLine = sLine + escStr(val)
        return sLine
    }
    sLine = sLine + "number "
    sLine = sLine + ("" + val)
    return sLine
}

fn irOpLine(op) {
    if op == null {
        throw "serialize: null op in IR"
    }
    sOp = op.op
    if sOp == OP_NEW_INSTANCE {
        sLine = OP_NEW_INSTANCE
        sLine = sLine + " "
        sLine = sLine + ("" + op.arg)
        sLine = sLine + " "
        if op.arg2 == undefined {
            sLine = sLine + "0"
        } else {
            sLine = sLine + ("" + op.arg2)
        }
        return sLine
    }
    if str_index_of(IR_WITH_ARG, "|" + sOp + "|") >= 0 {
        sLine = sOp
        sLine = sLine + " "
        sLine = sLine + ("" + op.arg)
        return sLine
    }
    if str_index_of(IR_ZERO_ARG, "|" + sOp + "|") >= 0 {
        return sOp
    }
    throw "Unsupported IR op: " + sOp
}

fn joinComma(arr) {
    sParams = ""
    sK = 0
    let n = len(arr)
    while sK < n {
        if sParams == "" {
            sParams = arr[sK]
        } else {
            sParams = sParams + ","
            sParams = sParams + arr[sK]
        }
        sK = sK + 1
    }
    return sParams
}

fn appendOps(ops) {
    sI = 0
    let n = len(ops)
    while sI < n {
        outTag(irOpLine(ops[sI]))
        sI = sI + 1
    }
}

fn appendEmbeddedMethodOps(ci, mi, ops) {
    sK = 0
    let n = len(ops)
    while sK < n {
        outTagged2("class_method_op", ci, mi, irOpLine(ops[sK]))
        sK = sK + 1
    }
}

fn appendClassMethods(ci, methods) {
    sJ = 0
    let n = len(methods)
    while sJ < n {
        sMeth = methods[sJ]
        outTagged2("class_method", ci, sJ, sMeth["sym"])
        outTagged2("class_method_params", ci, sJ, joinComma(sMeth["params"]))
        outTagged2("class_method_locals", ci, sJ, joinComma(sMeth["locals"]))
        outTagged2("class_method_globals", ci, sJ, joinComma(sMeth["globals"]))
        appendEmbeddedMethodOps(ci, sJ, sMeth["ops"])
        sJ = sJ + 1
    }
}

fn appendNamedList(zeroTag, eqTag, itemTag, items) {
    if items == undefined {
        outTag(zeroTag)
        return
    }
    outTagEq(eqTag, len(items))
    sI = 0
    let n = len(items)
    while sI < n {
        outTagged(itemTag, sI, items[sI])
        sI = sI + 1
    }
}

// ----- MAIN SERIALIZE FUNCTION -----

pub fn serializeBcImplCore(bc) {
    sOut = KBC_HEADER
    outTagEq("constants=", len(bc.constants))
    sI = 0
    let nConst = len(bc.constants)
    while sI < nConst {
        outTag(constLine(sI, bc.constants[sI]))
        sI = sI + 1
    }
    sI = 0
    let nGlob = len(bc.globals)
    while sI < nGlob {
        outTagged("global", sI, bc.globals[sI])
        sI = sI + 1
    }
    outTagEq("functions=", len(bc.functions))
    sI = 0
    let nFn = len(bc.functions)
    while sI < nFn {
        sFn = bc.functions[sI]
        outTagged("fn", sI, sFn.sym)
        outTagged("fn_params", sI, joinComma(sFn.params))
        outTagged("fn_locals", sI, joinComma(sFn.locals))
        if sFn["tryRegions"] != undefined {
            sJ = 0
            sArr = sFn["tryRegions"]
            let nTr = len(sArr)
            while sJ < nTr {
                outTryRegion("fn_try_region", sI, sJ, sArr[sJ])
                sJ = sJ + 1
            }
        }
        sJ = 0
        sArr = sFn.ops
        let nOps = len(sArr)
        while sJ < nOps {
            outTagged("fn_op", sI, irOpLine(sArr[sJ]))
            sJ = sJ + 1
        }
        sI = sI + 1
    }
    if bc.arrows == undefined {
        outTag("arrows=0")
    } else {
        outTagEq("arrows=", len(bc.arrows))
        sI = 0
        let nArr = len(bc.arrows)
        while sI < nArr {
            sArr = bc.arrows[sI]
            outTagged("arrow", sI, sArr["sym"])
            outTagged("arrow_params", sI, joinComma(sArr["params"]))
            outTagged("arrow_locals", sI, joinComma(sArr["locals"]))
            sJ = 0
            let nAop = len(sArr["ops"])
            while sJ < nAop {
                outTagged("arrow_op", sI, irOpLine(sArr["ops"][sJ]))
                sJ = sJ + 1
            }
            sI = sI + 1
        }
    }
    if bc.tryRegions != undefined {
        sI = 0
        let nMtr = len(bc.tryRegions)
        while sI < nMtr {
            sTr = bc.tryRegions[sI]
            outTag("main_try_region")
            outSpNum(sI)
            outSpNum(sTr["bodyStart"])
            outSpNum(sTr["bodyEnd"])
            outSpNum(sTr["catchStart"])
            outSpNum(sTr["errLocal"])
            sI = sI + 1
        }
    }
    appendNamedList("exports=0", "exports=", "export", bc.exports)
    appendNamedList("imports=0", "imports=", "import", bc.imports)
    if bc.classes == undefined {
        outTag("classes=0")
    } else {
        outTagEq("classes=", len(bc.classes))
        sI = 0
        let nCls = len(bc.classes)
        while sI < nCls {
            sCls = bc.classes[sI]
            outTagged("class", sI, sCls["sym"])
            if sCls["isStruct"] == 1 {
                outTag("class_is_struct")
                outSpNum(sI)
            }
            appendClassMethods(sI, sCls["methods"])
            sI = sI + 1
        }
    }
    outTag("code")
    appendOps(bc.ops)
    return sOut
}
