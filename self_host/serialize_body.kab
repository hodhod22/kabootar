// H6e: serialize IR body — heavy leaf shard (skip-listed for self-host).
// Reached via self_host/serialize.kab → serialize_impl.kab (both thin facades).
//
// Self-host-compiling this file directly takes minutes even though it is well under
// the 64KB self-host-attempt size threshold — self-hosting cost scales with AST size
// of the source being compiled, not with import-time cost of its dependents. Keep it
// skip-listed and only ever load it via the Rust module loader (fast, exact).
// P6b: densify — IR membership in serialize_defs; shallow AccAdd (outTag/outSpNum/sLine);
// measure with p6b_serialize_body_compile_budget before emptying SELF_HOST_SKIP_LISTED_LEAVES.
//
// Everything here shares the module-level `s*` accumulators (sOut, sI, sJ, …) via
// plain call/return. Kabootar modules do not share mutable globals across files —
// each import gets its own copy of the exported bindings — so these functions and
// their state must stay co-located in this one leaf.
import "self_host/lexer_defs"
import "self_host/serialize_defs"
import "self_host/emit_defs"

let sOut = ""
let sI = 0
let sOp = null
let sLine = ""
let sFn = null
let sParams = ""
let sJ = 0
let sK = 0
let sMeth = null
let sCls = null
let sEscOut = ""
let sEscI = 0
let sEscCh = ""

// ----- HELPER FUNCTIONS -----

// P6b: sequential escapes (fewer nested If AST nodes for self-host leaf compile).
fn escStr(s) {
    sEscOut = ""
    sEscI = 0
    while sEscI < len(s) {
        sEscCh = char_at(s, sEscI)
        let piece = sEscCh
        if sEscCh == "\\" {
            piece = "\\\\"
        }
        if sEscCh == " " {
            piece = "\\s"
        }
        if sEscCh == "\n" {
            piece = "\\n"
        }
        if sEscCh == "\r" {
            piece = "\\r"
        }
        if sEscCh == "\t" {
            piece = "\\t"
        }
        sEscOut = sEscOut + piece
        sEscI = sEscI + 1
    }
    return sEscOut
}

// P6b: two AccAdd helpers (avoid depth-16+ Binary + and many Call defs).
fn outTag(tag) {
    sOut = sOut + CHAR_NL
    sOut = sOut + tag
}

fn outSpNum(x) {
    sOut = sOut + " "
    sOut = sOut + ("" + x)
}

fn constLine(idx, val) {
    // AccAdd into sLine — shallow emit vs Binary return trees.
    sLine = "const "
    sLine = sLine + ("" + idx)
    sLine = sLine + " "
    if val == KAB_UNDEF_CONST {
        sLine = sLine + "undefined"
        return sLine
    }
    if val == null {
        sLine = sLine + "null"
        return sLine
    }
    if val == true {
        sLine = sLine + "bool true"
        return sLine
    }
    if val == false {
        sLine = sLine + "bool false"
        return sLine
    }
    if typeof(val) == "string" {
        sLine = sLine + "string "
        sLine = sLine + escStr(val)
        return sLine
    }
    sLine = sLine + "number "
    sLine = sLine + ("" + val)
    return sLine
}

fn irOpLine(op) {
    if op == null {
        throw "serialize: null op in IR"
    }
    sOp = op.op
    if sOp == OP_NEW_INSTANCE {
        sLine = OP_NEW_INSTANCE
        sLine = sLine + " "
        sLine = sLine + ("" + op.arg)
        sLine = sLine + " "
        if op.arg2 == undefined {
            sLine = sLine + "0"
        } else {
            sLine = sLine + ("" + op.arg2)
        }
        return sLine
    }
    if str_index_of(IR_WITH_ARG, "|" + sOp + "|") >= 0 {
        sLine = sOp
        sLine = sLine + " "
        sLine = sLine + ("" + op.arg)
        return sLine
    }
    if str_index_of(IR_ZERO_ARG, "|" + sOp + "|") >= 0 {
        return sOp
    }
    throw "Unsupported IR op: " + sOp
}

fn joinComma(arr) {
    sParams = ""
    sK = 0
    while sK < len(arr) {
        if sParams == "" {
            sParams = arr[sK]
        } else {
            sParams = sParams + ","
            sParams = sParams + arr[sK]
        }
        sK = sK + 1
    }
    return sParams
}

fn appendOps(ops) {
    sI = 0
    while sI < len(ops) {
        outTag(irOpLine(ops[sI]))
        sI = sI + 1
    }
}

fn appendClassMethHeader(tag, ci, mi, rest) {
    outTag(tag)
    outSpNum(ci)
    outSpNum(mi)
    sOut = sOut + " "
    sOut = sOut + rest
}

fn appendEmbeddedMethodOps(ci, mi, ops) {
    // Use sK — must not clobber appendClassMethods' sJ method index.
    sK = 0
    while sK < len(ops) {
        outTag("class_method_op")
        outSpNum(ci)
        outSpNum(mi)
        sOut = sOut + " "
        sOut = sOut + irOpLine(ops[sK])
        sK = sK + 1
    }
}

fn appendClassMethods(ci, methods) {
    sJ = 0
    while sJ < len(methods) {
        sMeth = methods[sJ]
        appendClassMethHeader("class_method", ci, sJ, sMeth["sym"])
        appendClassMethHeader("class_method_params", ci, sJ, joinComma(sMeth["params"]))
        appendClassMethHeader("class_method_locals", ci, sJ, joinComma(sMeth["locals"]))
        appendClassMethHeader("class_method_globals", ci, sJ, joinComma(sMeth["globals"]))
        appendEmbeddedMethodOps(ci, sJ, sMeth["ops"])
        sJ = sJ + 1
    }
}

// ----- MAIN SERIALIZE FUNCTION -----

pub fn serializeBcImplCore(bc) {
    sOut = KBC_HEADER
    outTag("constants=")
    sOut = sOut + ("" + len(bc.constants))
    sI = 0
    while sI < len(bc.constants) {
        outTag(constLine(sI, bc.constants[sI]))
        sI = sI + 1
    }
    sI = 0
    while sI < len(bc.globals) {
        outTag("global")
        outSpNum(sI)
        sOut = sOut + " "
        sOut = sOut + bc.globals[sI]
        sI = sI + 1
    }
    outTag("functions=")
    sOut = sOut + ("" + len(bc.functions))
    sI = 0
    while sI < len(bc.functions) {
        sFn = bc.functions[sI]
        outTag("fn")
        outSpNum(sI)
        sOut = sOut + " "
        sOut = sOut + sFn.sym
        outTag("fn_params")
        outSpNum(sI)
        sOut = sOut + " "
        sOut = sOut + joinComma(sFn.params)
        outTag("fn_locals")
        outSpNum(sI)
        sOut = sOut + " "
        sOut = sOut + joinComma(sFn.locals)
        if sFn["tryRegions"] != undefined {
            sJ = 0
            while sJ < len(sFn["tryRegions"]) {
                let tr = sFn["tryRegions"][sJ]
                outTag("fn_try_region")
                outSpNum(sI)
                outSpNum(sJ)
                outSpNum(tr["bodyStart"])
                outSpNum(tr["bodyEnd"])
                outSpNum(tr["catchStart"])
                outSpNum(tr["errLocal"])
                sJ = sJ + 1
            }
        }
        sJ = 0
        while sJ < len(sFn.ops) {
            outTag("fn_op")
            outSpNum(sI)
            sOut = sOut + " "
            sOut = sOut + irOpLine(sFn.ops[sJ])
            sJ = sJ + 1
        }
        sI = sI + 1
    }
    // Module-level arrows
    if bc.arrows == undefined {
        outTag("arrows=0")
    } else {
        outTag("arrows=")
        sOut = sOut + ("" + len(bc.arrows))
        sI = 0
        while sI < len(bc.arrows) {
            let arr = bc.arrows[sI]
            outTag("arrow")
            outSpNum(sI)
            sOut = sOut + " "
            sOut = sOut + arr["sym"]
            outTag("arrow_params")
            outSpNum(sI)
            sOut = sOut + " "
            sOut = sOut + joinComma(arr["params"])
            outTag("arrow_locals")
            outSpNum(sI)
            sOut = sOut + " "
            sOut = sOut + joinComma(arr["locals"])
            sJ = 0
            while sJ < len(arr["ops"]) {
                outTag("arrow_op")
                outSpNum(sI)
                sOut = sOut + " "
                sOut = sOut + irOpLine(arr["ops"][sJ])
                sJ = sJ + 1
            }
            sI = sI + 1
        }
    }
    // Main try regions
    if bc.tryRegions != undefined {
        sI = 0
        while sI < len(bc.tryRegions) {
            let mtr = bc.tryRegions[sI]
            outTag("main_try_region")
            outSpNum(sI)
            outSpNum(mtr["bodyStart"])
            outSpNum(mtr["bodyEnd"])
            outSpNum(mtr["catchStart"])
            outSpNum(mtr["errLocal"])
            sI = sI + 1
        }
    }
    // Exports
    if bc.exports == undefined {
        outTag("exports=0")
    } else {
        outTag("exports=")
        sOut = sOut + ("" + len(bc.exports))
        sI = 0
        while sI < len(bc.exports) {
            outTag("export")
            outSpNum(sI)
            sOut = sOut + " "
            sOut = sOut + bc.exports[sI]
            sI = sI + 1
        }
    }
    // Imports
    if bc.imports == undefined {
        outTag("imports=0")
    } else {
        outTag("imports=")
        sOut = sOut + ("" + len(bc.imports))
        sI = 0
        while sI < len(bc.imports) {
            outTag("import")
            outSpNum(sI)
            sOut = sOut + " "
            sOut = sOut + bc.imports[sI]
            sI = sI + 1
        }
    }
    // Classes
    if bc.classes == undefined {
        outTag("classes=0")
    } else {
        outTag("classes=")
        sOut = sOut + ("" + len(bc.classes))
        sI = 0
        while sI < len(bc.classes) {
            sCls = bc.classes[sI]
            outTag("class")
            outSpNum(sI)
            sOut = sOut + " "
            sOut = sOut + sCls["sym"]
            if sCls["isStruct"] == 1 {
                outTag("class_is_struct")
                outSpNum(sI)
            }
            appendClassMethods(sI, sCls["methods"])
            sI = sI + 1
        }
    }
    // Main code
    outTag("code")
    appendOps(bc.ops)
    return sOut
}
