// H6e: serialize IR body — heavy leaf shard (skip-listed for self-host).
// Reached via self_host/serialize.kab → serialize_impl.kab (both thin facades).
//
// Self-host-compiling this file directly takes minutes even though it is well under
// the 64KB self-host-attempt size threshold — self-hosting cost scales with AST size
// of the source being compiled, not with import-time cost of its dependents. Keep it
// skip-listed and only ever load it via the Rust module loader (fast, exact).
//
// Everything here shares the module-level `s*` accumulators (sOut, sI, sJ, …) via
// plain call/return. Kabootar modules do not share mutable globals across files —
// each import gets its own copy of the exported bindings — so these functions and
// their state must stay co-located in this one leaf.
import "self_host/lexer_defs"
import "self_host/serialize_defs"
import "self_host/emit_defs"

let sOut = ""
let sI = 0
let sOp = null
let sLine = ""
let sFn = null
let sParams = ""
let sJ = 0
let sK = 0
let sMeth = null
let sCls = null
let sEscOut = ""
let sEscI = 0
let sEscCh = ""

// ----- HELPER FUNCTIONS -----

fn escStr(s) {
    sEscOut = ""
    sEscI = 0
    while sEscI < len(s) {
        sEscCh = char_at(s, sEscI)
        if sEscCh == "\\" {
            sEscOut = sEscOut + "\\\\"
        } else {
            if sEscCh == " " {
                sEscOut = sEscOut + "\\s"
            } else {
                if sEscCh == "\n" {
                    sEscOut = sEscOut + "\\n"
                } else {
                    if sEscCh == "\r" {
                        sEscOut = sEscOut + "\\r"
                    } else {
                        if sEscCh == "\t" {
                            sEscOut = sEscOut + "\\t"
                        } else {
                            sEscOut = sEscOut + sEscCh
                        }
                    }
                }
            }
        }
        sEscI = sEscI + 1
    }
    return sEscOut
}

fn constLine(idx, val) {
    if val == KAB_UNDEF_CONST {
        return "const " + ("" + idx) + " undefined"
    }
    if val == null {
        return "const " + ("" + idx) + " null"
    }
    if val == true {
        return "const " + ("" + idx) + " bool true"
    }
    if val == false {
        return "const " + ("" + idx) + " bool false"
    }
    if typeof(val) == "string" {
        return "const " + ("" + idx) + " string " + escStr(val)
    }
    return "const " + ("" + idx) + " number " + ("" + val)
}

fn irOpLine(op) {
    if op == null {
        throw "serialize: null op in IR"
    }
    sOp = op.op
    if sOp == OP_CONST {
        return "const " + ("" + op.arg)
    }
    if sOp == OP_LOAD_GLOBAL {
        return "load_global " + ("" + op.arg)
    }
    if sOp == OP_STORE_GLOBAL {
        return "store_global " + ("" + op.arg)
    }
    if sOp == OP_LOAD_LOCAL {
        return "load_local " + ("" + op.arg)
    }
    if sOp == OP_STORE_LOCAL {
        return "store_local " + ("" + op.arg)
    }
    if sOp == OP_TAKE_LOCAL {
        return "take_local " + ("" + op.arg)
    }
    if sOp == OP_TAKE_GLOBAL {
        return "take_global " + ("" + op.arg)
    }
    if sOp == OP_ARRAY_PUSH_LOCAL {
        return "array_push_local " + ("" + op.arg)
    }
    if sOp == OP_ARRAY_PUSH_GLOBAL {
        return "array_push_global " + ("" + op.arg)
    }
    if sOp == OP_ARRAY_POP_LOCAL {
        return "array_pop_local " + ("" + op.arg)
    }
    if sOp == OP_ARRAY_POP_GLOBAL {
        return "array_pop_global " + ("" + op.arg)
    }
    if sOp == OP_ACC_ADD_LOCAL {
        return "acc_add_local " + ("" + op.arg)
    }
    if sOp == OP_ACC_ADD_GLOBAL {
        return "acc_add_global " + ("" + op.arg)
    }
    if sOp == OP_POP {
        return "pop"
    }
    if sOp == OP_ADD {
        return "add"
    }
    if sOp == OP_SUB {
        return "sub"
    }
    if sOp == OP_MUL {
        return "mul"
    }
    if sOp == OP_DIV {
        return "div"
    }
    if sOp == OP_MOD {
        return "mod"
    }
    if sOp == OP_POW {
        return "pow"
    }
    if sOp == OP_NEG {
        return "neg"
    }
    if sOp == OP_NOT {
        return "not"
    }
    if sOp == OP_EQ {
        return "eq"
    }
    if sOp == OP_NE {
        return "ne"
    }
    if sOp == OP_LT {
        return "lt"
    }
    if sOp == OP_GT {
        return "gt"
    }
    if sOp == OP_GE {
        return "ge"
    }
    if sOp == OP_LE {
        return "le"
    }
    if sOp == OP_AND {
        return "and"
    }
    if sOp == OP_OR {
        return "or"
    }
    if sOp == OP_BIT_AND {
        return "bit_and"
    }
    if sOp == OP_BIT_OR {
        return "bit_or"
    }
    if sOp == OP_BIT_XOR {
        return "bit_xor"
    }
    if sOp == OP_SHL {
        return "shl"
    }
    if sOp == OP_SHR {
        return "shr"
    }
    if sOp == OP_USHR {
        return "ushr"
    }
    if sOp == OP_BIT_NOT {
        return "bit_not"
    }
    if sOp == OP_MAKE_OBJECT {
        return "make_object " + ("" + op.arg)
    }
    if sOp == OP_MAKE_ARRAY {
        return "make_array " + ("" + op.arg)
    }
    if sOp == OP_INDEX_GET {
        return "index_get"
    }
    if sOp == OP_INDEX_SET {
        return "index_set"
    }
    if sOp == OP_GET_MEMBER {
        return "get_member " + ("" + op.arg)
    }
    if sOp == OP_SET_MEMBER {
        return "set_member " + ("" + op.arg)
    }
    if sOp == OP_JUMP {
        return "jump " + ("" + op.arg)
    }
    if sOp == OP_JUMP_IF_FALSE {
        return "jump_if_false " + ("" + op.arg)
    }
    if sOp == OP_JUMP_IF_TRUE {
        return "jump_if_true " + ("" + op.arg)
    }
    if sOp == OP_CALL {
        return "call " + ("" + op.arg)
    }
    if sOp == OP_NEW_INSTANCE {
        if op.arg2 == undefined {
            return "new_instance " + ("" + op.arg) + " 0"
        }
        return "new_instance " + ("" + op.arg) + " " + ("" + op.arg2)
    }
    if sOp == OP_RETURN {
        return "return"
    }
    if sOp == OP_THROW {
        return "throw"
    }
    if sOp == OP_JUMP_IF_RESULT_ERR {
        return "jump_if_result_err " + ("" + op.arg)
    }
    if sOp == OP_MAKE_ARROW {
        return "make_arrow_fn " + ("" + op.arg)
    }
    if sOp == OP_ITER_STEP {
        return "iterator_step_in_place"
    }
    if sOp == OP_MAKE_OK {
        return "make_ok"
    }
    if sOp == OP_MAKE_ERR {
        return "make_err"
    }
    if sOp == OP_MAKE_SOME {
        return "make_some"
    }
    if sOp == OP_MAKE_NONE {
        return "make_none"
    }
    if sOp == OP_HALT {
        return "halt"
    }
    throw "Unsupported IR op: " + sOp
}

fn appendOps(ops) {
    sI = 0
    while sI < len(ops) {
        sOut = sOut + CHAR_NL + irOpLine(ops[sI])
        sI = sI + 1
    }
}

fn appendEmbeddedMethodOps(ci, mi, ops) {
    sJ = 0
    while sJ < len(ops) {
        sOut = sOut + CHAR_NL + ("class_method_op " + ("" + ci) + " " + ("" + mi) + " " + irOpLine(ops[sJ]))
        sJ = sJ + 1
    }
}

fn appendClassMethods(ci, methods) {
    sJ = 0
    while sJ < len(methods) {
        sMeth = methods[sJ]
        sOut = sOut + CHAR_NL + ("class_method " + ("" + ci) + " " + ("" + sJ) + " " + sMeth["sym"])
        sParams = ""
        sK = 0
        while sK < len(sMeth["params"]) {
            if sParams == "" {
                sParams = sMeth["params"][sK]
            } else {
                sParams = sParams + "," + sMeth["params"][sK]
            }
            sK = sK + 1
        }
        sOut = sOut + CHAR_NL + ("class_method_params " + ("" + ci) + " " + ("" + sJ) + " " + sParams)
        sParams = ""
        sK = 0
        while sK < len(sMeth["locals"]) {
            if sParams == "" {
                sParams = sMeth["locals"][sK]
            } else {
                sParams = sParams + "," + sMeth["locals"][sK]
            }
            sK = sK + 1
        }
        sOut = sOut + CHAR_NL + ("class_method_locals " + ("" + ci) + " " + ("" + sJ) + " " + sParams)
        sParams = ""
        sK = 0
        while sK < len(sMeth["globals"]) {
            if sParams == "" {
                sParams = sMeth["globals"][sK]
            } else {
                sParams = sParams + "," + sMeth["globals"][sK]
            }
            sK = sK + 1
        }
        sOut = sOut + CHAR_NL + ("class_method_globals " + ("" + ci) + " " + ("" + sJ) + " " + sParams)
        appendEmbeddedMethodOps(ci, sJ, sMeth["ops"])
        sJ = sJ + 1
    }
}

// ----- MAIN SERIALIZE FUNCTION -----

pub fn serializeBcImplCore(bc) {
    sOut = KBC_HEADER
    sOut = sOut + CHAR_NL + ("constants=" + ("" + len(bc.constants)))
    sI = 0
    while sI < len(bc.constants) {
        sOut = sOut + CHAR_NL + constLine(sI, bc.constants[sI])
        sI = sI + 1
    }
    sI = 0
    while sI < len(bc.globals) {
        sOut = sOut + CHAR_NL + ("global " + ("" + sI) + " " + bc.globals[sI])
        sI = sI + 1
    }
    sOut = sOut + CHAR_NL + ("functions=" + ("" + len(bc.functions)))
    sI = 0
    while sI < len(bc.functions) {
        sFn = bc.functions[sI]
        sOut = sOut + CHAR_NL + ("fn " + ("" + sI) + " " + sFn.sym)
        // Params
        sParams = ""
        sJ = 0
        while sJ < len(sFn.params) {
            if sParams == "" {
                sParams = sFn.params[sJ]
            } else {
                sParams = sParams + "," + sFn.params[sJ]
            }
            sJ = sJ + 1
        }
        sOut = sOut + CHAR_NL + ("fn_params " + ("" + sI) + " " + sParams)
        // Locals
        sParams = ""
        sJ = 0
        while sJ < len(sFn.locals) {
            if sParams == "" {
                sParams = sFn.locals[sJ]
            } else {
                sParams = sParams + "," + sFn.locals[sJ]
            }
            sJ = sJ + 1
        }
        sOut = sOut + CHAR_NL + ("fn_locals " + ("" + sI) + " " + sParams)
        // Function try regions
        if sFn["tryRegions"] != undefined {
            sJ = 0
            while sJ < len(sFn["tryRegions"]) {
                let tr = sFn["tryRegions"][sJ]
                sOut = sOut + CHAR_NL + ("fn_try_region " + ("" + sI) + " " + ("" + sJ) + " " + ("" + tr["bodyStart"]) + " " + ("" + tr["bodyEnd"]) + " " + ("" + tr["catchStart"]) + " " + ("" + tr["errLocal"]))
                sJ = sJ + 1
            }
        }
        // Function ops
        sJ = 0
        while sJ < len(sFn.ops) {
            sOut = sOut + CHAR_NL + ("fn_op " + ("" + sI) + " " + irOpLine(sFn.ops[sJ]))
            sJ = sJ + 1
        }
        sI = sI + 1
    }
    // Module-level arrows
    if bc.arrows == undefined {
        sOut = sOut + CHAR_NL + "arrows=0"
    } else {
        sOut = sOut + CHAR_NL + ("arrows=" + ("" + len(bc.arrows)))
        sI = 0
        while sI < len(bc.arrows) {
            let arr = bc.arrows[sI]
            sOut = sOut + CHAR_NL + ("arrow " + ("" + sI) + " " + arr["sym"])
            sParams = ""
            sJ = 0
            while sJ < len(arr["params"]) {
                if sParams == "" {
                    sParams = arr["params"][sJ]
                } else {
                    sParams = sParams + "," + arr["params"][sJ]
                }
                sJ = sJ + 1
            }
            sOut = sOut + CHAR_NL + ("arrow_params " + ("" + sI) + " " + sParams)
            sParams = ""
            sJ = 0
            while sJ < len(arr["locals"]) {
                if sParams == "" {
                    sParams = arr["locals"][sJ]
                } else {
                    sParams = sParams + "," + arr["locals"][sJ]
                }
                sJ = sJ + 1
            }
            sOut = sOut + CHAR_NL + ("arrow_locals " + ("" + sI) + " " + sParams)
            sJ = 0
            while sJ < len(arr["ops"]) {
                sOut = sOut + CHAR_NL + ("arrow_op " + ("" + sI) + " " + irOpLine(arr["ops"][sJ]))
                sJ = sJ + 1
            }
            sI = sI + 1
        }
    }
    // Main try regions
    if bc.tryRegions != undefined {
        sI = 0
        while sI < len(bc.tryRegions) {
            let mtr = bc.tryRegions[sI]
            sOut = sOut + CHAR_NL + ("main_try_region " + ("" + sI) + " " + ("" + mtr["bodyStart"]) + " " + ("" + mtr["bodyEnd"]) + " " + ("" + mtr["catchStart"]) + " " + ("" + mtr["errLocal"]))
            sI = sI + 1
        }
    }
    // Exports
    if bc.exports == undefined {
        sOut = sOut + CHAR_NL + "exports=0"
    } else {
        sOut = sOut + CHAR_NL + ("exports=" + ("" + len(bc.exports)))
        sI = 0
        while sI < len(bc.exports) {
            sOut = sOut + CHAR_NL + ("export " + ("" + sI) + " " + bc.exports[sI])
            sI = sI + 1
        }
    }
    // Imports
    if bc.imports == undefined {
        sOut = sOut + CHAR_NL + "imports=0"
    } else {
        sOut = sOut + CHAR_NL + ("imports=" + ("" + len(bc.imports)))
        sI = 0
        while sI < len(bc.imports) {
            sOut = sOut + CHAR_NL + ("import " + ("" + sI) + " " + bc.imports[sI])
            sI = sI + 1
        }
    }
    // Classes
    if bc.classes == undefined {
        sOut = sOut + CHAR_NL + "classes=0"
    } else {
        sOut = sOut + CHAR_NL + ("classes=" + ("" + len(bc.classes)))
        sI = 0
        while sI < len(bc.classes) {
            sCls = bc.classes[sI]
            sOut = sOut + CHAR_NL + ("class " + ("" + sI) + " " + sCls["sym"])
            if sCls["isStruct"] == 1 {
                sOut = sOut + CHAR_NL + ("class_is_struct " + ("" + sI))
            }
            appendClassMethods(sI, sCls["methods"])
            sI = sI + 1
        }
    }
    // Main code
    sOut = sOut + CHAR_NL + "code"
    appendOps(bc.ops)
    return sOut
}
