// H6e: serialize IR body — heavy leaf shard (skip-listed for self-host).
// Reached via self_host/serialize.kab → serialize_impl.kab (both thin facades).
//
// Self-host cost scales with AST size of this source. Keep skip-listed until
// p6b_serialize_body_compile_budget is under P6_SELF_HOST_LEAF_CI_FAST_MS.
// P6b: pure helpers (serEscStr/serConstLine/serIrOpLine/serJoinComma) live in
// serialize_defs — bisect showed those fns dominate leaf compile; AccAdd out*
// + section helpers stay here (need mutable sOut).
import "self_host/lexer_defs"
import "self_host/serialize_defs"
import "self_host/emit_defs"

let sOut = ""
let sI = 0
let sJ = 0
let sK = 0
let sFn = null
let sMeth = null
let sCls = null
let sArr = null
let sTr = null

fn outTag(tag) {
    sOut = sOut + CHAR_NL
    sOut = sOut + tag
}

fn outSpNum(x) {
    sOut = sOut + " "
    sOut = sOut + ("" + x)
}

fn outSp(s) {
    sOut = sOut + " "
    sOut = sOut + s
}

fn outTagEq(tag, n) {
    outTag(tag)
    sOut = sOut + ("" + n)
}

fn outTagged(tag, i, rest) {
    outTag(tag)
    outSpNum(i)
    outSp(rest)
}

fn outTagged2(tag, a, b, rest) {
    outTag(tag)
    outSpNum(a)
    outSpNum(b)
    outSp(rest)
}

fn outTry5(tag, a, b, tr) {
    outTag(tag)
    outSpNum(a)
    outSpNum(b)
    outSpNum(tr["bodyStart"])
    outSpNum(tr["bodyEnd"])
    outSpNum(tr["catchStart"])
    outSpNum(tr["errLocal"])
}

fn outTry4(tag, a, tr) {
    outTag(tag)
    outSpNum(a)
    outSpNum(tr["bodyStart"])
    outSpNum(tr["bodyEnd"])
    outSpNum(tr["catchStart"])
    outSpNum(tr["errLocal"])
}

fn appendTaggedOps(tag, i, ops) {
    sJ = 0
    let n = len(ops)
    while sJ < n {
        outTagged(tag, i, serIrOpLine(ops[sJ]))
        sJ = sJ + 1
    }
}

fn appendNamedList(zeroTag, eqTag, itemTag, items) {
    if items == undefined {
        outTag(zeroTag)
        return
    }
    outTagEq(eqTag, len(items))
    sI = 0
    let n = len(items)
    while sI < n {
        outTagged(itemTag, sI, items[sI])
        sI = sI + 1
    }
}

fn appendOps(ops) {
    sI = 0
    let n = len(ops)
    while sI < n {
        outTag(serIrOpLine(ops[sI]))
        sI = sI + 1
    }
}

fn appendClassMethods(ci, methods) {
    sJ = 0
    let n = len(methods)
    while sJ < n {
        sMeth = methods[sJ]
        outTagged2("class_method", ci, sJ, sMeth["sym"])
        outTagged2("class_method_params", ci, sJ, serJoinComma(sMeth["params"]))
        outTagged2("class_method_locals", ci, sJ, serJoinComma(sMeth["locals"]))
        outTagged2("class_method_globals", ci, sJ, serJoinComma(sMeth["globals"]))
        sK = 0
        sArr = sMeth["ops"]
        let nOps = len(sArr)
        while sK < nOps {
            outTagged2("class_method_op", ci, sJ, serIrOpLine(sArr[sK]))
            sK = sK + 1
        }
        sJ = sJ + 1
    }
}

fn appendFunctions(fns) {
    outTagEq("functions=", len(fns))
    sI = 0
    let n = len(fns)
    while sI < n {
        sFn = fns[sI]
        outTagged("fn", sI, sFn.sym)
        outTagged("fn_params", sI, serJoinComma(sFn.params))
        outTagged("fn_locals", sI, serJoinComma(sFn.locals))
        if sFn["tryRegions"] != undefined {
            sJ = 0
            sArr = sFn["tryRegions"]
            let nTr = len(sArr)
            while sJ < nTr {
                outTry5("fn_try_region", sI, sJ, sArr[sJ])
                sJ = sJ + 1
            }
        }
        appendTaggedOps("fn_op", sI, sFn.ops)
        sI = sI + 1
    }
}

fn appendArrows(arrows) {
    if arrows == undefined {
        outTag("arrows=0")
        return
    }
    outTagEq("arrows=", len(arrows))
    sI = 0
    let n = len(arrows)
    while sI < n {
        sArr = arrows[sI]
        outTagged("arrow", sI, sArr["sym"])
        outTagged("arrow_params", sI, serJoinComma(sArr["params"]))
        outTagged("arrow_locals", sI, serJoinComma(sArr["locals"]))
        appendTaggedOps("arrow_op", sI, sArr["ops"])
        sI = sI + 1
    }
}

fn appendClasses(classes) {
    if classes == undefined {
        outTag("classes=0")
        return
    }
    outTagEq("classes=", len(classes))
    sI = 0
    let n = len(classes)
    while sI < n {
        sCls = classes[sI]
        outTagged("class", sI, sCls["sym"])
        if sCls["isStruct"] == 1 {
            outTag("class_is_struct")
            outSpNum(sI)
        }
        appendClassMethods(sI, sCls["methods"])
        sI = sI + 1
    }
}

pub fn serializeBcImplCore(bc) {
    sOut = KBC_HEADER
    outTagEq("constants=", len(bc.constants))
    sI = 0
    let nConst = len(bc.constants)
    while sI < nConst {
        outTag(serConstLine(sI, bc.constants[sI]))
        sI = sI + 1
    }
    sI = 0
    let nGlob = len(bc.globals)
    while sI < nGlob {
        outTagged("global", sI, bc.globals[sI])
        sI = sI + 1
    }
    appendFunctions(bc.functions)
    appendArrows(bc.arrows)
    if bc.tryRegions != undefined {
        sI = 0
        let nMtr = len(bc.tryRegions)
        while sI < nMtr {
            outTry4("main_try_region", sI, bc.tryRegions[sI])
            sI = sI + 1
        }
    }
    appendNamedList("exports=0", "exports=", "export", bc.exports)
    appendNamedList("imports=0", "imports=", "import", bc.imports)
    appendClasses(bc.classes)
    outTag("code")
    appendOps(bc.ops)
    return sOut
}
