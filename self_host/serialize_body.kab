// H6e: serialize IR body — heavy leaf shard (skip-listed for self-host).
// Reached via self_host/serialize.kab → serialize_impl.kab (both thin facades).
//
// Self-host-compiling this file directly takes minutes even though it is well under
// the 64KB self-host-attempt size threshold — self-hosting cost scales with AST size
// of the source being compiled, not with import-time cost of its dependents. Keep it
// skip-listed and only ever load it via the Rust module loader (fast, exact).
// P6b: densify (membership + shallow AccAdd appends) + emit AccAdd in emit_impl;
// measure with p6b_serialize_body_compile_budget before emptying SELF_HOST_SKIP_LISTED_LEAVES.
//
// Everything here shares the module-level `s*` accumulators (sOut, sI, sJ, …) via
// plain call/return. Kabootar modules do not share mutable globals across files —
// each import gets its own copy of the exported bindings — so these functions and
// their state must stay co-located in this one leaf.
import "self_host/lexer_defs"
import "self_host/serialize_defs"
import "self_host/emit_defs"

let sOut = ""
let sI = 0
let sOp = null
let sLine = ""
let sFn = null
let sParams = ""
let sJ = 0
let sK = 0
let sMeth = null
let sCls = null
let sEscOut = ""
let sEscI = 0
let sEscCh = ""

// ----- HELPER FUNCTIONS -----

// P6b: sequential escapes (fewer nested If AST nodes for self-host leaf compile).
fn escStr(s) {
    sEscOut = ""
    sEscI = 0
    while sEscI < len(s) {
        sEscCh = char_at(s, sEscI)
        let piece = sEscCh
        if sEscCh == "\\" {
            piece = "\\\\"
        }
        if sEscCh == " " {
            piece = "\\s"
        }
        if sEscCh == "\n" {
            piece = "\\n"
        }
        if sEscCh == "\r" {
            piece = "\\r"
        }
        if sEscCh == "\t" {
            piece = "\\t"
        }
        sEscOut = sEscOut + piece
        sEscI = sEscI + 1
    }
    return sEscOut
}

// P6b: shallow AccAdd appends (avoid depth-16+ Binary + trees in serializeBcImplCore).
fn appendNl(s) {
    sOut = sOut + CHAR_NL
    sOut = sOut + s
}

fn appendSp() {
    sOut = sOut + " "
}

fn appendNum(x) {
    sOut = sOut + ("" + x)
}

fn appendSpNum(x) {
    sOut = sOut + " "
    sOut = sOut + ("" + x)
}

fn beginTag(tag) {
    sOut = sOut + CHAR_NL
    sOut = sOut + tag
}

fn constLine(idx, val) {
    // Prefix once — fewer repeated "const "+idx Binary trees.
    let p = "const " + ("" + idx) + " "
    if val == KAB_UNDEF_CONST {
        return p + "undefined"
    }
    if val == null {
        return p + "null"
    }
    if val == true {
        return p + "bool true"
    }
    if val == false {
        return p + "bool false"
    }
    if typeof(val) == "string" {
        return p + "string " + escStr(val)
    }
    return p + "number " + ("" + val)
}

// P6b: OP_* wire names already match .kbc text. Membership tables avoid ~58 If arms
// so self-host leaf compile AST stays small (cost scales with source AST density).
let IR_WITH_ARG = "|const|load_global|store_global|load_local|store_local|take_local|take_global|array_push_local|array_push_global|array_pop_local|array_pop_global|acc_add_local|acc_add_global|make_object|make_array|get_member|set_member|jump|jump_if_false|jump_if_true|call|jump_if_result_err|make_arrow_fn|"
let IR_ZERO_ARG = "|pop|add|sub|mul|div|mod|pow|neg|not|eq|ne|lt|gt|ge|le|and|or|bit_and|bit_or|bit_xor|shl|shr|ushr|bit_not|index_get|index_set|return|throw|iterator_step_in_place|make_ok|make_err|make_some|make_none|halt|"

fn irOpLine(op) {
    if op == null {
        throw "serialize: null op in IR"
    }
    sOp = op.op
    if sOp == OP_NEW_INSTANCE {
        if op.arg2 == undefined {
            return OP_NEW_INSTANCE + " " + ("" + op.arg) + " 0"
        }
        return OP_NEW_INSTANCE + " " + ("" + op.arg) + " " + ("" + op.arg2)
    }
    if str_index_of(IR_WITH_ARG, "|" + sOp + "|") >= 0 {
        return sOp + " " + ("" + op.arg)
    }
    if str_index_of(IR_ZERO_ARG, "|" + sOp + "|") >= 0 {
        return sOp
    }
    throw "Unsupported IR op: " + sOp
}

fn joinComma(arr) {
    sParams = ""
    sK = 0
    while sK < len(arr) {
        if sParams == "" {
            sParams = arr[sK]
        } else {
            sParams = sParams + "," + arr[sK]
        }
        sK = sK + 1
    }
    return sParams
}

fn appendOps(ops) {
    sI = 0
    while sI < len(ops) {
        appendNl(irOpLine(ops[sI]))
        sI = sI + 1
    }
}

fn appendClassMethHeader(tag, ci, mi, rest) {
    beginTag(tag)
    appendSpNum(ci)
    appendSpNum(mi)
    appendSp()
    sOut = sOut + rest
}

fn appendEmbeddedMethodOps(ci, mi, ops) {
    // Use sK — must not clobber appendClassMethods' sJ method index.
    sK = 0
    while sK < len(ops) {
        beginTag("class_method_op")
        appendSpNum(ci)
        appendSpNum(mi)
        appendSp()
        sOut = sOut + irOpLine(ops[sK])
        sK = sK + 1
    }
}

fn appendClassMethods(ci, methods) {
    sJ = 0
    while sJ < len(methods) {
        sMeth = methods[sJ]
        appendClassMethHeader("class_method", ci, sJ, sMeth["sym"])
        appendClassMethHeader("class_method_params", ci, sJ, joinComma(sMeth["params"]))
        appendClassMethHeader("class_method_locals", ci, sJ, joinComma(sMeth["locals"]))
        appendClassMethHeader("class_method_globals", ci, sJ, joinComma(sMeth["globals"]))
        appendEmbeddedMethodOps(ci, sJ, sMeth["ops"])
        sJ = sJ + 1
    }
}

// ----- MAIN SERIALIZE FUNCTION -----

pub fn serializeBcImplCore(bc) {
    sOut = KBC_HEADER
    beginTag("constants=")
    appendNum(len(bc.constants))
    sI = 0
    while sI < len(bc.constants) {
        appendNl(constLine(sI, bc.constants[sI]))
        sI = sI + 1
    }
    sI = 0
    while sI < len(bc.globals) {
        beginTag("global")
        appendSpNum(sI)
        appendSp()
        sOut = sOut + bc.globals[sI]
        sI = sI + 1
    }
    beginTag("functions=")
    appendNum(len(bc.functions))
    sI = 0
    while sI < len(bc.functions) {
        sFn = bc.functions[sI]
        beginTag("fn")
        appendSpNum(sI)
        appendSp()
        sOut = sOut + sFn.sym
        beginTag("fn_params")
        appendSpNum(sI)
        appendSp()
        sOut = sOut + joinComma(sFn.params)
        beginTag("fn_locals")
        appendSpNum(sI)
        appendSp()
        sOut = sOut + joinComma(sFn.locals)
        if sFn["tryRegions"] != undefined {
            sJ = 0
            while sJ < len(sFn["tryRegions"]) {
                let tr = sFn["tryRegions"][sJ]
                beginTag("fn_try_region")
                appendSpNum(sI)
                appendSpNum(sJ)
                appendSpNum(tr["bodyStart"])
                appendSpNum(tr["bodyEnd"])
                appendSpNum(tr["catchStart"])
                appendSpNum(tr["errLocal"])
                sJ = sJ + 1
            }
        }
        sJ = 0
        while sJ < len(sFn.ops) {
            beginTag("fn_op")
            appendSpNum(sI)
            appendSp()
            sOut = sOut + irOpLine(sFn.ops[sJ])
            sJ = sJ + 1
        }
        sI = sI + 1
    }
    // Module-level arrows
    if bc.arrows == undefined {
        appendNl("arrows=0")
    } else {
        beginTag("arrows=")
        appendNum(len(bc.arrows))
        sI = 0
        while sI < len(bc.arrows) {
            let arr = bc.arrows[sI]
            beginTag("arrow")
            appendSpNum(sI)
            appendSp()
            sOut = sOut + arr["sym"]
            beginTag("arrow_params")
            appendSpNum(sI)
            appendSp()
            sOut = sOut + joinComma(arr["params"])
            beginTag("arrow_locals")
            appendSpNum(sI)
            appendSp()
            sOut = sOut + joinComma(arr["locals"])
            sJ = 0
            while sJ < len(arr["ops"]) {
                beginTag("arrow_op")
                appendSpNum(sI)
                appendSp()
                sOut = sOut + irOpLine(arr["ops"][sJ])
                sJ = sJ + 1
            }
            sI = sI + 1
        }
    }
    // Main try regions
    if bc.tryRegions != undefined {
        sI = 0
        while sI < len(bc.tryRegions) {
            let mtr = bc.tryRegions[sI]
            beginTag("main_try_region")
            appendSpNum(sI)
            appendSpNum(mtr["bodyStart"])
            appendSpNum(mtr["bodyEnd"])
            appendSpNum(mtr["catchStart"])
            appendSpNum(mtr["errLocal"])
            sI = sI + 1
        }
    }
    // Exports
    if bc.exports == undefined {
        appendNl("exports=0")
    } else {
        beginTag("exports=")
        appendNum(len(bc.exports))
        sI = 0
        while sI < len(bc.exports) {
            beginTag("export")
            appendSpNum(sI)
            appendSp()
            sOut = sOut + bc.exports[sI]
            sI = sI + 1
        }
    }
    // Imports
    if bc.imports == undefined {
        appendNl("imports=0")
    } else {
        beginTag("imports=")
        appendNum(len(bc.imports))
        sI = 0
        while sI < len(bc.imports) {
            beginTag("import")
            appendSpNum(sI)
            appendSp()
            sOut = sOut + bc.imports[sI]
            sI = sI + 1
        }
    }
    // Classes
    if bc.classes == undefined {
        appendNl("classes=0")
    } else {
        beginTag("classes=")
        appendNum(len(bc.classes))
        sI = 0
        while sI < len(bc.classes) {
            sCls = bc.classes[sI]
            beginTag("class")
            appendSpNum(sI)
            appendSp()
            sOut = sOut + sCls["sym"]
            if sCls["isStruct"] == 1 {
                beginTag("class_is_struct")
                appendSpNum(sI)
            }
            appendClassMethods(sI, sCls["methods"])
            sI = sI + 1
        }
    }
    // Main code
    appendNl("code")
    appendOps(bc.ops)
    return sOut
}
