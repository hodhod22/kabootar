// P6b: base out helpers (skip-listed until ≤10s).
import "self_host/lexer_defs"

pub fn serOutTag(out, tag) {
    out = out + CHAR_NL
    out = out + tag
    return out
}

pub fn serOutSpNum(out, x) {
    out = out + " "
    out = out + ("" + x)
    return out
}

pub fn serOutSp(out, s) {
    out = out + " "
    out = out + s
    return out
}

pub fn serOutTagEq(out, tag, n) {
    out = serOutTag(out, tag)
    out = out + ("" + n)
    return out
}
