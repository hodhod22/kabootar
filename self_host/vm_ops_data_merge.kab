import "self_host/vm_s_push"
import "self_host/vm_s_pop"
import "self_host/vm_s_ip"

pub fn runOpDataMerge(S, name, arg, op, pool, globals, functions) {
    if name == "merge_object" {
        let right = vPopS(S)
        let left = vPopS(S)
        let keys = object_keys(right)
        let ki = 0
        while ki < len(keys) {
            let k = keys[ki]
            left[k] = right[k]
            ki = ki + 1
        }
        vPushS(S, left)
        vBumpIpS(S)
        return 1
    }
    return 0
}
