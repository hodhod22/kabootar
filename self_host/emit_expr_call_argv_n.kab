import "self_host/emit_defs"
import "self_host/emit_hooks"
import "self_host/emit_op"
import "self_host/emit_call_callee"
import "self_host/emit_call_arg_fast"

pub fn emitExpr_callArgvN(E) {
    E["eCallArgIStack"] = push(E["eCallArgIStack"], 0)
    E["eCallArgNStack"] = push(E["eCallArgNStack"], E["eArgN"])
    E["eArgsStack"] = push(E["eArgsStack"], E["eArgs"])
    E["eCallArgDepth"] = E["eCallArgDepth"] + 1
    let cad = E["eCallArgDepth"]
    while E["eCallArgIStack"][cad - 1] < E["eCallArgNStack"][cad - 1] {
        E["eArgs"] = E["eArgsStack"][cad - 1]
        E["eCallI"] = E["eCallArgIStack"][cad - 1]
        emitCallArgFast(E, E["eArgs"][E["eCallI"]])
        E["eCallArgIStack"][cad - 1] = E["eCallArgIStack"][cad - 1] + 1
    }
    E["eArgsStack"] = pop(E["eArgsStack"])
    E["eArgN"] = E["eCallArgNStack"][cad - 1]
    E["eCallArgIStack"] = pop(E["eCallArgIStack"])
    E["eCallArgNStack"] = pop(E["eCallArgNStack"])
    E["eCallArgDepth"] = E["eCallArgDepth"] - 1
    emitCallCallee(E)
    emitOp(E, OP_CALL, E["eArgN"])
    E["_callDone"] = 1
    return 0
}
