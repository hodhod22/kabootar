// P6b: parser session type fields.
pub fn pSessionInit_type(sess) {
    sess["pTypeParams"] = []
    sess["pParamTypes"] = []
    sess["pReturnType"] = ""
    sess["pVariants"] = []
    sess["pClassFields"] = []
    sess["pClassMethods"] = []
    sess["pFieldType"] = ""
    sess["pFieldDefault"] = null
    sess["pVariantFields"] = []
    sess["pMethTypeParams"] = []
    sess["pMethParams"] = []
    sess["pMethParamTypes"] = []
    sess["pVariantName"] = ""
    sess["pVariantSym"] = ""
    sess["pEnumSym"] = ""
    sess["pClassSym"] = ""
    sess["pIsStruct"] = 0
    sess["pIfaceSym"] = ""
    sess["pIfaceMethods"] = []
    sess["pAssocTypes"] = []
    sess["pWhereClause"] = []
    sess["pWhereParam"] = ""
    sess["pWhereTrait"] = ""
    sess["pParamType"] = ""
    return 0
}
