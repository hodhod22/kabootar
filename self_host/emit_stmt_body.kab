import "self_host/ast_defs"
import "self_host/emit_defs"
import "self_host/emit_arr_util"
import "self_host/emit_hooks"
import "self_host/emit_sym"
import "self_host/emit_sym_index"
import "self_host/emit_fn_scope"

pub fn tryEmitArrayPushAssign(E, sym, rhs) {
    if rhs.kind != AST_CALL {
        return false
    }
    let cal = rhs["callee"]
    let args = rhs["args"]
    if cal.kind != AST_VAR {
        return false
    }
    if cal["sym"] != "push" {
        return false
    }
    if len(args) != 2 {
        return false
    }
    let a0 = args[0]
    if a0.kind != AST_VAR {
        return false
    }
    if a0["sym"] != sym {
        return false
    }
    let li = localSymIndex(E, sym)
    if li >= 0 {
        emitOp(E, OP_TAKE_LOCAL, li)
        eCallExpr(E, args[1])
        emitOp(E, OP_ARRAY_PUSH_LOCAL, li)
        emitOp(E, OP_POP, 0)
        return true
    }
    let gi = symIndex(E, "global", sym)
    emitOp(E, OP_TAKE_GLOBAL, gi)
    eCallExpr(E, args[1])
    emitOp(E, OP_ARRAY_PUSH_GLOBAL, gi)
    emitOp(E, OP_POP, 0)
    return true
}

pub fn tryEmitAccAddAssign(E, sym, rhs) {
    if rhs.kind != AST_BINARY {
        return false
    }
    if rhs["op"] != "+" {
        return false
    }
    let left = rhs["left"]
    let right = rhs["right"]
    if left.kind == AST_VAR {
        if left["sym"] != sym {
            return false
        }
        let li = localSymIndex(E, sym)
        if li >= 0 {
            eCallExpr(E, right)
            emitOp(E, OP_ACC_ADD_LOCAL, li)
            return true
        }
        let gi = symIndex(E, "global", sym)
        eCallExpr(E, right)
        emitOp(E, OP_ACC_ADD_GLOBAL, gi)
        return true
    }
    if left.kind == AST_BINARY {
        if left["op"] == "+" {
            if tryEmitAccAddAssign(E, sym, left) {
                let li = localSymIndex(E, sym)
                if li >= 0 {
                    eCallExpr(E, right)
                    emitOp(E, OP_ACC_ADD_LOCAL, li)
                    return true
                }
                let gi = symIndex(E, "global", sym)
                eCallExpr(E, right)
                emitOp(E, OP_ACC_ADD_GLOBAL, gi)
                return true
            }
        }
    }
    return false
}

// --- emit_if_stmt ---
let eCallRet = 0

pub fn patchRelJump(E, opName, idx) {
    if E["eInFn"] == 1 {
        eCallRet = E["eFnOpsN"] - idx
        E["eJumpOff"] = eCallRet - 1
        E["eFnOps"][idx] = { "op": opName, "arg": E["eJumpOff"] }
    } else {
        eCallRet = E["eOpsN"] - idx
        E["eJumpOff"] = eCallRet - 1
        E["eOps"][idx] = { "op": opName, "arg": E["eJumpOff"] }
    }
}

pub fn pushJmpAtLen(E, key) {
    if E["eInFn"] == 1 {
        object_array_push(E, key, E["eFnOpsN"])
    } else {
        object_array_push(E, key, E["eOpsN"])
    }
    return 0
}

pub fn emitIfStmt(E) {
    object_array_push(E, "eCondStack", E["eCond"])
    object_array_push(E, "eThenStack", E["eThen"])
    object_array_push(E, "eElseStack", E["eElse"])
    E["eIfDepth"] = E["eIfDepth"] + 1
    let id = E["eIfDepth"]
    E["eCond"] = E["eNode"]["cond"]
    E["eThen"] = E["eNode"]["then"]
    E["eElse"] = E["eNode"]["elseBranch"]
    eCallExpr(E, E["eCond"])
    eCallRet = pushJmpAtLen(E, "eIfJmpStack")
    emitOp(E, OP_JUMP_IF_FALSE, 0)
    eCallStmt(E, E["eThen"])
    if E["eElse"] != null {
        eCallRet = pushJmpAtLen(E, "eIfSkipStack")
        emitOp(E, OP_JUMP, 0)
        // Jmp/skip stacks: always top via len (jmp is popped before else; depth ≠ len).
        // P6b: len_* / index_get_* make this cheap (no LoadGlobal clone).
        eCallRet = len(E["eIfJmpStack"]) - 1
        E["eJmp"] = E["eIfJmpStack"][eCallRet]
        patchRelJump(E, OP_JUMP_IF_FALSE, E["eJmp"])
        object_array_pop(E, "eIfJmpStack")
        eCallStmt(E, E["eElse"])
        eCallRet = len(E["eIfSkipStack"]) - 1
        E["eIdx"] = E["eIfSkipStack"][eCallRet]
        patchRelJump(E, OP_JUMP, E["eIdx"])
        object_array_pop(E, "eIfSkipStack")
    } else {
        eCallRet = len(E["eIfJmpStack"]) - 1
        E["eJmp"] = E["eIfJmpStack"][eCallRet]
        patchRelJump(E, OP_JUMP_IF_FALSE, E["eJmp"])
        object_array_pop(E, "eIfJmpStack")
    }
    E["eCond"] = object_array_pop(E, "eCondStack")
    E["eThen"] = object_array_pop(E, "eThenStack")
    E["eElse"] = object_array_pop(E, "eElseStack")
    E["eIfDepth"] = E["eIfDepth"] - 1
}

// --- emit_stmt_assign ---
pub fn emitStmt_assign(E) {
    if E["eNode"].kind != AST_ASSIGN {
        return false
    }
        E["eAssignSym"] = E["eNode"]["sym"]
        if tryEmitArrayPushAssign(E, E["eAssignSym"], E["eNode"]["rhs"]) {
            return true
        }
        if tryEmitAccAddAssign(E, E["eAssignSym"], E["eNode"]["rhs"]) {
            return true
        }
        eCallExpr(E, E["eNode"]["rhs"])
        emitSym(E, 1,E["eAssignSym"])
        return true
    return true
}

// --- emit_stmt_block ---
pub fn emitStmt_block(E) {
    if E["eNode"].kind != AST_BLOCK {
        return false
    }
        let stmts = E["eNode"]["body"]
        let si = 0
        let n = len(stmts)
        while si < n {
            let stmt = stmts[si]
            if stmt == null {
                throw "emit block null stmt at " + ("" + si)
            }
            eCallStmt(E, stmt)
            si = si + 1
        }
        return true
    return true
}

// --- emit_stmt_break ---
let eCallRet2 = 0


pub fn emitStmt_break(E) {
    if E["eNode"].kind != AST_BREAK {
        return false
    }
        if len(E["eBreakFromStack"]) == 0 {
            throw "break outside loop"
        }
        eCallRet = pushJmpAtLen(E, "eBreakIdxs")
        emitOp(E, OP_JUMP, 0)
        return true
    return true
}

// --- emit_stmt_class ---
let eMi = 0
let eMeth = null
let eMethTypeParams = null

pub fn emitStmt_class(E) {
    if E["eNode"].kind != AST_CLASS {
        return false
    }
        E["eFnSave"] = "" + E["eNode"]["sym"]
        E["eTypeParams"] = E["eNode"]["typeParams"]
        if E["eTypeParams"] == undefined {
            E["eTypeParams"] = []
        }
        if len(E["eTypeParams"]) > 0 {
            object_array_push(E, "eGenericClassTemplates", {
                "sym": E["eFnSave"],
                "typeParams": arrUtil(E, "snap",E["eTypeParams"]),
                "methods": arrUtil(E, "snap",E["eNode"]["methods"])
            })
            return true
        }
        // Snap before emitStmt — emitStmt overwrites module-global E["eNode"].
        E["eClassMethodsSrc"] = E["eNode"]["methods"]
        E["eClassIsStruct"] = E["eNode"]["isStruct"]
        E["eClassMethods"] = []
        eMi = 0
        while eMi < len(E["eClassMethodsSrc"]) {
            eMeth = E["eClassMethodsSrc"][eMi]
            eMethTypeParams = eMeth["typeParams"]
            if eMethTypeParams == undefined {
                eMethTypeParams = []
            }
            if len(eMethTypeParams) > 0 {
                object_array_push(E, "eGenericMethodTemplates", {
                    "classSym": E["eFnSave"],
                    "methodSym": eMeth["sym"],
                    "typeParams": arrUtil(E, "snap",eMethTypeParams),
                    "params": arrUtil(E, "snap",eMeth["params"]),
                    "body": eMeth["body"]
                })
            } else {
                E["eInFn"] = 1
                object_array_clear(E, "eFnOps")
                E["eFnOpsN"] = 0
                object_array_clear(E, "eFnGlobals")
                object_array_clear(E, "eFnLocals")
                resetLocalMap(E)
                E["eParams"] = eMeth["params"]
                E["eParamI"] = 0
                while E["eParamI"] < len(E["eParams"]) {
                    E["eLoopSave"] = E["eParamI"]
                    symIndex(E, "local",E["eParams"][E["eParamI"]])
                    E["eParamI"] = E["eLoopSave"] + 1
                }
                eCallStmt(E, eMeth["body"])
                object_array_push(E, "eClassMethods", {
                    "sym": eMeth["sym"],
                    "params": arrUtil(E, "snap",E["eParams"]),
                    "locals": arrUtil(E, "snap",E["eFnLocals"]),
                    "globals": arrUtil(E, "snap",E["eFnGlobals"]),
                    "ops": arrUtil(E, "snap",E["eFnOps"])
                })
                E["eInFn"] = 0
            }
            eMi = eMi + 1
        }
        object_array_push(E, "eClasses", {
            "sym": E["eFnSave"],
            "methods": E["eClassMethods"],
            "isStruct": E["eClassIsStruct"]
        })
        E["eClassesN"] = E["eClassesN"] + 1
        return true
    return true
}

// --- emit_stmt_continue ---
pub fn emitStmt_continue(E) {
    if E["eNode"].kind != AST_CONTINUE {
        return false
    }
        if len(E["eWhileHeads"]) == 0 {
            throw "continue outside loop"
        }
        eCallRet = len(E["eWhileHeads"]) - 1
        E["eWh"] = E["eWhileHeads"][eCallRet]
        if E["eInFn"] == 1 {
            eCallRet = E["eWh"] - E["eFnOpsN"]
            E["eJumpOff"] = eCallRet - 1
        } else {
            eCallRet = E["eWh"] - E["eOpsN"]
            E["eJumpOff"] = eCallRet - 1
        }
        emitOp(E, OP_JUMP, E["eJumpOff"])
        return true
    return true
}

// --- emit_stmt_enum ---
pub fn emitStmt_enum(E) {
    if E["eNode"].kind != AST_ENUM {
        return false
    }
        E["eTypeParams"] = E["eNode"]["typeParams"]
        if E["eTypeParams"] == undefined {
            E["eTypeParams"] = []
        }
        if len(E["eTypeParams"]) > 0 {
            object_array_push(E, "eGenericEnumTemplates", {
                "sym": E["eNode"]["sym"],
                "typeParams": arrUtil(E, "snap",E["eTypeParams"]),
                "variants": arrUtil(E, "snap",E["eNode"]["variants"])
            })
        }
        return true
    return true
}

// --- emit_stmt_expr ---
pub fn emitStmt_expr(E) {
    if E["eNode"].kind != AST_EXPR {
        return false
    }
        E["eExprStmt"] = E["eNode"]["expr"]
        eCallExpr(E, E["eExprStmt"])
        if E["eExprStmt"].kind != AST_THROW {
            emitOp(E, OP_POP, 0)
        }
        return true
    return true
}

// --- emit_stmt_fn ---
pub fn emitStmt_fn(E) {
    if E["eNode"].kind != AST_FN {
        return false
    }
        if E["eInFn"] == 1 {
            emitNestedNamedFn(E)
            return true
        }
        E["eFnSave"] = "" + E["eNode"]["sym"]
        E["eFnPub"] = E["eNode"]["isPub"]
        E["eParams"] = E["eNode"]["params"]
        E["eFnBody"] = E["eNode"]["body"]
        E["eTypeParams"] = E["eNode"]["typeParams"]
        if E["eTypeParams"] == undefined {
            E["eTypeParams"] = []
        }
        if len(E["eTypeParams"]) > 0 {
            object_array_push(E, "eGenericTemplates", {
                "sym": E["eFnSave"],
                "typeParams": arrUtil(E, "snap",E["eTypeParams"]),
                "params": arrUtil(E, "snap",E["eParams"]),
                "body": E["eFnBody"],
                "isPub": E["eFnPub"]
            })
            if E["eFnPub"] == 1 {
                eCallRet = ("" + E["eFnSave"]) + ""
                object_array_push(E, "eExports", eCallRet)
            }
            return true
        }
        E["eInFn"] = 1
        E["eFnOps"] = []
        E["eFnOpsN"] = 0
        E["eFnGlobals"] = []
        E["eFnLocals"] = []
        resetLocalMap(E)
        E["eFnTryRegions"] = []
        E["eParamI"] = 0
        while E["eParamI"] < len(E["eParams"]) {
            E["eLoopSave"] = E["eParamI"]
            symIndex(E, "local",E["eParams"][E["eParamI"]])
            E["eParamI"] = E["eLoopSave"] + 1
        }
        eCallStmt(E, E["eFnBody"])
        E["eFunctions"] = push(E["eFunctions"], {
            "sym": E["eFnSave"],
            "params": arrUtil(E, "snap",E["eParams"]),
            "locals": arrUtil(E, "snap",E["eFnLocals"]),
            "globals": arrUtil(E, "snap",E["eFnGlobals"]),
            "ops": arrUtil(E, "snap",E["eFnOps"]),
            "tryRegions": arrUtil(E, "snap", E["eFnTryRegions"]),
            "arrows": arrUtil(E, "snap", E["eArrows"])
        })
        E["eArrows"] = []
        E["eInFn"] = 0
        E["eFnTryRegions"] = []
        symIndex(E, "global",E["eFnSave"])
        if E["eFnPub"] == 1 {
            eCallRet = ("" + E["eFnSave"]) + ""
            object_array_push(E, "eExports", eCallRet)
        }
        return true
    return true
}

// --- emit_stmt_for_of ---
pub fn emitStmt_for_of(E) {
    if E["eNode"].kind != AST_FOR_OF {
        return false
    }
        if E["eInFn"] != 1 {
            throw "for-of only supported inside fn (self-host emit)"
        }
        let forSym = E["eNode"]["sym"]
        let forIter = E["eNode"]["iterable"]
        let forBody = E["eNode"]["body"]
        let n = E["eForCounter"]
        E["eForCounter"] = n + 1
        let src = "__kab_f" + n + "_src"
        let res = "__kab_f" + n + "_r"
        let srcIdx = symIndex(E, "local", src)
        let resIdx = symIndex(E, "local", res)
        let varIdx = symIndex(E, "local", forSym)
        eCallExpr(E, forIter)
        emitOp(E, OP_STORE_LOCAL, srcIdx)
        emitOp(E, OP_LOAD_LOCAL, srcIdx)
        emitOp(E, OP_LOAD_GLOBAL, symIndex(E, "global", "iterator_begin"))
        emitOp(E, OP_CALL, 1)
        emitOp(E, OP_STORE_LOCAL, srcIdx)
        arrUtil(E, "pushLenKey", "eBreakFromStack", E["eBreakIdxs"])
        let loopStart = E["eFnOpsN"]
        object_array_push(E, "eWhileHeads", loopStart)
        emitOp(E, OP_LOAD_LOCAL, srcIdx)
        emitOp(E, OP_ITER_STEP, 0)
        emitOp(E, OP_STORE_LOCAL, resIdx)
        emitOp(E, OP_STORE_LOCAL, srcIdx)
        emitOp(E, OP_LOAD_LOCAL, resIdx)
        emitOp(E, OP_CONST, symIndex(E, "const", "done"))
        emitOp(E, OP_INDEX_GET, 0)
        let jmpDoneIdx = E["eFnOpsN"]
        emitOp(E, OP_JUMP_IF_FALSE, 0)
        let jmpExitIdx = E["eFnOpsN"]
        emitOp(E, OP_JUMP, 0)
        let bodyStart = E["eFnOpsN"]
        eCallRet = bodyStart - jmpDoneIdx - 1
        E["eFnOps"][jmpDoneIdx] = { "op": OP_JUMP_IF_FALSE, "arg": eCallRet }
        emitOp(E, OP_LOAD_LOCAL, resIdx)
        emitOp(E, OP_CONST, symIndex(E, "const", "value"))
        emitOp(E, OP_INDEX_GET, 0)
        emitOp(E, OP_STORE_LOCAL, varIdx)
        eCallStmt(E, forBody)
        emitOp(E, OP_JUMP, loopStart - E["eFnOpsN"] - 1)
        let loopEnd = E["eFnOpsN"]
        eCallRet = loopEnd - jmpExitIdx - 1
        E["eFnOps"][jmpExitIdx] = { "op": OP_JUMP, "arg": eCallRet }
        eCallRet = len(E["eBreakFromStack"]) - 1
        E["eBf"] = E["eBreakFromStack"][eCallRet]
        E["eBi"] = E["eBf"]
        while E["eBi"] < len(E["eBreakIdxs"]) {
            eCallRet = loopEnd - E["eBreakIdxs"][E["eBi"]]
            E["eJumpOff"] = eCallRet - 1
            E["eFnOps"][E["eBreakIdxs"][E["eBi"]]] = { "op": OP_JUMP, "arg": E["eJumpOff"] }
            E["eBi"] = E["eBi"] + 1
        }
        object_array_truncate(E, "eBreakIdxs", E["eBf"])
        if len(E["eWhileHeads"]) > 0 {
            object_array_pop(E, "eWhileHeads")
        }
        if len(E["eBreakFromStack"]) > 0 {
            object_array_pop(E, "eBreakFromStack")
        }
        return true
    return true
}

// --- emit_stmt_index_assign ---
pub fn emitStmt_index_assign(E) {
    if E["eNode"].kind != AST_INDEX_ASSIGN {
        return false
    }
        E["eBxL"] = E["eNode"]["object"]
        E["eBxR"] = E["eNode"]["index"]
        E["eBxRhs"] = E["eNode"]["rhs"]
        eCallExpr(E, E["eBxL"])
        eCallExpr(E, E["eBxR"])
        eCallExpr(E, E["eBxRhs"])
        emitOp(E, OP_INDEX_SET, 0)
        emitOp(E, OP_POP, 0)
        emitOp(E, OP_POP, 0)
        return true
    return true
}

// --- emit_stmt_interface ---
pub fn emitStmt_interface(E) {
    if E["eNode"].kind != AST_INTERFACE {
        return false
    }
        return true
    return true
}

// --- emit_stmt_let_ctor_generic ---
pub fn emitStmt_letCtorGeneric(E) {
    E["eGenTmpl"] = null
    E["eGenI"] = 0
    while E["eGenI"] < len(E["eGenericClassTemplates"]) {
        if E["eGenericClassTemplates"][E["eGenI"]]["sym"] == E["eCtorName"] {
            E["eGenTmpl"] = E["eGenericClassTemplates"][E["eGenI"]]
        }
        E["eGenI"] = E["eGenI"] + 1
    }
    if E["eGenTmpl"] == null {
        return 0
    }
    E["eCtorArgs"] = E["eLitNode"]["args"]
    emitInferTypeArgsFrom(E, "eCtorArgs", "", 0)
    E["eMangled"] = E["eCtorName"]
    emitMangleWithTypeArgs(E, "eMangled")
    object_array_push(E, "eBindingSyms", E["eAssignSym"])
    object_array_push(E, "eBindingTypes", E["eMangled"])
    return 0
}

// --- emit_stmt_let_ctor_lookup ---
pub fn emitStmt_letCtorLookup(E) {
    E["eCtorCallee"] = E["eLitNode"]["callee"]
    if E["eCtorCallee"].kind != AST_VAR {
        return 0
    }
    E["eCtorName"] = E["eCtorCallee"]["sym"]
    E["eFound"] = 0
    E["eGenI"] = 0
    while E["eGenI"] < E["eClassesN"] {
        if E["eClasses"][E["eGenI"]]["sym"] == E["eCtorName"] {
            object_array_push(E, "eBindingSyms", E["eAssignSym"])
            object_array_push(E, "eBindingTypes", E["eCtorName"])
            E["eFound"] = 1
        }
        E["eGenI"] = E["eGenI"] + 1
    }
    return E["eFound"]
}

// --- emit_stmt_member_assign ---
pub fn emitStmt_member_assign(E) {
    if E["eNode"].kind != AST_MEMBER_ASSIGN {
        return false
    }
        E["eBxL"] = E["eNode"]["object"]
        E["eMemberFld"] = E["eNode"]["field"]
        E["eBxRhs"] = E["eNode"]["rhs"]
        eCallExpr(E, E["eBxL"])
        eCallExpr(E, E["eBxRhs"])
        eCallRet = symIndex(E, "const", E["eMemberFld"])
        E["eIdx"] = eCallRet
        emitOp(E, OP_SET_MEMBER, eCallRet)
        emitOp(E, OP_POP, 0)
        emitOp(E, OP_POP, 0)
        return true
    return true
}

// --- emit_stmt_return ---
pub fn emitStmt_return(E) {
    if E["eNode"].kind != AST_RETURN {
        return false
    }
        if E["eNode"]["value"] == null {
            emitOp(E, OP_CONST, symIndex(E, "const",null))
        } else {
            eCallExpr(E, E["eNode"]["value"])
        }
        emitOp(E, OP_RETURN, 0)
        return true
    return true
}

// --- emit_stmt_throw ---
pub fn emitStmt_throw(E) {
    if E["eNode"].kind != AST_THROW {
        return false
    }
        eCallExpr(E, E["eNode"]["expr"])
        emitOp(E, OP_THROW, 0)
        return true
    return true
}

// --- emit_stmt_try ---
pub fn emitStmt_try(E) {
    if E["eNode"].kind != AST_TRY {
        return false
    }
        if E["eInFn"] != 1 {
            throw "try/catch only supported inside fn (self-host emit)"
        }
        let tryBody = E["eNode"]["body"]
        let tryHandler = E["eNode"]["handler"]
        let errName = E["eNode"]["errName"]
        eCallStmt(E, tryBody)
        let bodyEnd = E["eFnOpsN"]
        // Statement try: jump over catch on success (throw uses tryRegions).
        emitOp(E, OP_JUMP, 0)
        let jmpEndIdx = bodyEnd
        let catchStart = E["eFnOpsN"]
        let errLocal = symIndex(E, "local", errName)
        object_array_push(E, "eFnTryRegions", {
            "bodyStart": bodyStart,
            "bodyEnd": bodyEnd,
            "catchStart": catchStart,
            "errLocal": errLocal
        })
        emitOp(E, OP_STORE_LOCAL, errLocal)
        eCallStmt(E, tryHandler)
        let afterCatch = E["eFnOpsN"]
        eCallRet = afterCatch - jmpEndIdx - 1
        E["eFnOps"][jmpEndIdx] = { "op": OP_JUMP, "arg": eCallRet }
        return true
    return true
}

// --- emit_stmt_while ---
pub fn emitStmt_while(E) {
    if E["eNode"].kind != AST_WHILE {
        return false
    }
        E["eCond"] = E["eNode"]["cond"]
        E["eThen"] = E["eNode"]["body"]
        arrUtil(E, "pushLenKey", "eBreakFromStack", E["eBreakIdxs"])
        if E["eInFn"] == 1 {
            E["eWhileHead"] = E["eFnOpsN"]
        } else {
            E["eWhileHead"] = E["eOpsN"]
        }
        object_array_push(E, "eWhileHeads", E["eWhileHead"])
        eCallExpr(E, E["eCond"])
        eCallRet = pushJmpAtLen(E, "eIfJmpStack")
        emitOp(E, OP_JUMP_IF_FALSE, 0)
        eCallStmt(E, E["eThen"])
        if E["eInFn"] == 1 {
            eCallRet = E["eWhileHead"] - E["eFnOpsN"]
            E["eJumpOff"] = eCallRet - 1
        } else {
            eCallRet = E["eWhileHead"] - E["eOpsN"]
            E["eJumpOff"] = eCallRet - 1
        }
        emitOp(E, OP_JUMP, E["eJumpOff"])
        eCallRet = len(E["eIfJmpStack"]) - 1
        E["eJmp"] = E["eIfJmpStack"][eCallRet]
        patchRelJump(E, OP_JUMP_IF_FALSE, E["eJmp"])
        object_array_pop(E, "eIfJmpStack")
        if E["eInFn"] == 1 {
            E["eEnd"] = E["eFnOpsN"]
        } else {
            E["eEnd"] = E["eOpsN"]
        }
        eCallRet = len(E["eBreakFromStack"]) - 1
        E["eBf"] = E["eBreakFromStack"][eCallRet]
        E["eBi"] = E["eBf"]
        while E["eBi"] < len(E["eBreakIdxs"]) {
            eCallRet = E["eEnd"] - E["eBreakIdxs"][E["eBi"]]
            E["eJumpOff"] = eCallRet - 1
            if E["eInFn"] == 1 {
                E["eFnOps"][E["eBreakIdxs"][E["eBi"]]] = { "op": OP_JUMP, "arg": E["eJumpOff"] }
            } else {
                E["eOps"][E["eBreakIdxs"][E["eBi"]]] = { "op": OP_JUMP, "arg": E["eJumpOff"] }
            }
            E["eBi"] = E["eBi"] + 1
        }
        object_array_truncate(E, "eBreakIdxs", E["eBf"])
        if len(E["eWhileHeads"]) > 0 {
            object_array_pop(E, "eWhileHeads")
        }
        if len(E["eBreakFromStack"]) > 0 {
            object_array_pop(E, "eBreakFromStack")
        }
        return true
    return true
}

// --- emit_stmt_let_ctor_bind ---
pub fn emitStmt_letCtorBind(E) {
    if emitStmt_letCtorLookup(E) != 0 {
        return 0
    }
    emitStmt_letCtorGeneric(E)
    return 0
}

// --- emit_stmt_let_ctor ---
// Legacy alias module — implementation in emit_stmt_let_ctor_bind.kab

// --- emit_stmt_let_bind ---
pub fn emitStmt_letBind(E) {
    E["eLitNode"] = E["eNode"]["init"]
    if E["eLitNode"]["kind"] == AST_LITERAL {
        if E["eLitNode"]["lit"] == LIT_NUMBER {
            object_array_push(E, "eBindingSyms", E["eAssignSym"])
            object_array_push(E, "eBindingTypes", "Number")
        }
        if E["eLitNode"]["lit"] == LIT_STRING {
            object_array_push(E, "eBindingSyms", E["eAssignSym"])
            object_array_push(E, "eBindingTypes", "String")
        }
    }
    if E["eLitNode"]["kind"] == AST_CALL {
        emitStmt_letCtorBind(E)
    }
    return 0
}

// --- emit_stmt_let ---
pub fn emitStmt_let(E) {
    if E["eNode"].kind != AST_LET {
        return false
    }
    E["eAssignSym"] = E["eNode"]["sym"]
    emitStmt_letBind(E)
    eCallExpr(E, E["eNode"]["init"])
    if E["eInFn"] == 1 {
        eCallRet = symIndex(E, "local", E["eAssignSym"])
        E["eIdx"] = eCallRet
        emitOp(E, OP_STORE_LOCAL, eCallRet)
    } else {
        eCallRet = symIndex(E, "global", E["eAssignSym"])
        E["eIdx"] = eCallRet
        emitOp(E, OP_STORE_GLOBAL, eCallRet)
    }
    if E["eInFn"] != 1 {
        let eLetPub = E["eStmtNode"]["isPub"]
        if eLetPub {
            eCallRet = ("" + E["eAssignSym"]) + ""
            object_array_push(E, "eExports", eCallRet)
        }
    }
    return true
}

// --- emit_stmt_body ---
pub fn emitStmtBody(E, node) {
    E["eStmtNode"] = node
    E["eNode"] = node
    if E["eStmtNode"] == null {
        throw "emitStmt: null node"
    }
    E["eStmtKind"] = E["eStmtNode"].kind
    let kind = E["eStmtKind"]
    if kind == undefined {
        throw "emitStmt: missing kind"
    }
    if kind == AST_IF {
        emitIfStmt(E)
        return
    }
    if kind == AST_LET {
        emitStmt_let(E)
        return
    }
    if kind == AST_ASSIGN {
        emitStmt_assign(E)
        return
    }
    if kind == AST_INDEX_ASSIGN {
        emitStmt_index_assign(E)
        return
    }
    if kind == AST_MEMBER_ASSIGN {
        emitStmt_member_assign(E)
        return
    }
    if kind == AST_EXPR {
        emitStmt_expr(E)
        return
    }
    if kind == AST_THROW {
        emitStmt_throw(E)
        return
    }
    if kind == AST_TRY {
        emitStmt_try(E)
        return
    }
    if kind == AST_FOR_OF {
        emitStmt_for_of(E)
        return
    }
    if kind == AST_RETURN {
        emitStmt_return(E)
        return
    }
    if kind == AST_BLOCK {
        emitStmt_block(E)
        return
    }
    if kind == AST_CONTINUE {
        emitStmt_continue(E)
        return
    }
    if kind == AST_BREAK {
        emitStmt_break(E)
        return
    }
    if kind == AST_WHILE {
        emitStmt_while(E)
        return
    }
    if kind == AST_ENUM {
        emitStmt_enum(E)
        return
    }
    if kind == AST_CLASS {
        emitStmt_class(E)
        return
    }
    if kind == AST_INTERFACE {
        emitStmt_interface(E)
        return
    }
    if kind == AST_FN {
        emitStmt_fn(E)
        return
    }
    throw "Unsupported stmt: " + kind
}
