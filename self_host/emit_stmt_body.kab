import "self_host/ast_defs"
import "self_host/emit_defs"
import "self_host/emit_if_stmt"
import "self_host/emit_stmt_let"
import "self_host/emit_stmt_assign"
import "self_host/emit_stmt_index_assign"
import "self_host/emit_stmt_member_assign"
import "self_host/emit_stmt_expr"
import "self_host/emit_stmt_throw"
import "self_host/emit_stmt_try"
import "self_host/emit_stmt_for_of"
import "self_host/emit_stmt_return"
import "self_host/emit_stmt_block"
import "self_host/emit_stmt_continue"
import "self_host/emit_stmt_break"
import "self_host/emit_stmt_while"
import "self_host/emit_stmt_enum"
import "self_host/emit_stmt_class"
import "self_host/emit_stmt_interface"
import "self_host/emit_stmt_fn"

pub fn emitStmtBody(E, node) {
    E["eStmtNode"] = node
    E["eNode"] = node
    if E["eStmtNode"] == null {
        throw "emitStmt: null node"
    }
    E["eStmtKind"] = E["eStmtNode"].kind
    let kind = E["eStmtKind"]
    if kind == undefined {
        throw "emitStmt: missing kind"
    }
    if kind == AST_IF {
        emitIfStmt(E)
        return
    }
    if kind == AST_LET {
        emitStmt_let(E)
        return
    }
    if kind == AST_ASSIGN {
        emitStmt_assign(E)
        return
    }
    if kind == AST_INDEX_ASSIGN {
        emitStmt_index_assign(E)
        return
    }
    if kind == AST_MEMBER_ASSIGN {
        emitStmt_member_assign(E)
        return
    }
    if kind == AST_EXPR {
        emitStmt_expr(E)
        return
    }
    if kind == AST_THROW {
        emitStmt_throw(E)
        return
    }
    if kind == AST_TRY {
        emitStmt_try(E)
        return
    }
    if kind == AST_FOR_OF {
        emitStmt_for_of(E)
        return
    }
    if kind == AST_RETURN {
        emitStmt_return(E)
        return
    }
    if kind == AST_BLOCK {
        emitStmt_block(E)
        return
    }
    if kind == AST_CONTINUE {
        emitStmt_continue(E)
        return
    }
    if kind == AST_BREAK {
        emitStmt_break(E)
        return
    }
    if kind == AST_WHILE {
        emitStmt_while(E)
        return
    }
    if kind == AST_ENUM {
        emitStmt_enum(E)
        return
    }
    if kind == AST_CLASS {
        emitStmt_class(E)
        return
    }
    if kind == AST_INTERFACE {
        emitStmt_interface(E)
        return
    }
    if kind == AST_FN {
        emitStmt_fn(E)
        return
    }
    throw "Unsupported stmt: " + kind
}
