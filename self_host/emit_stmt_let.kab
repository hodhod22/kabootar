import "self_host/ast_defs"
import "self_host/emit_defs"
import "self_host/emit_hooks"
import "self_host/emit_sym_index"
import "self_host/emit_op"
import "self_host/emit_stmt_let_bind"

let eCallRet = 0
let eCallRet2 = 0

pub fn emitStmt_let(E) {
    if E["eNode"].kind != AST_LET {
        return false
    }
    E["eAssignSym"] = E["eNode"]["sym"]
    emitStmt_letBind(E)
    eCallExpr(E, E["eNode"]["init"])
    if E["eInFn"] == 1 {
        eCallRet = symIndex(E, "local", E["eAssignSym"])
        E["eIdx"] = eCallRet
        emitOp(E, OP_STORE_LOCAL, eCallRet)
    } else {
        eCallRet = symIndex(E, "global", E["eAssignSym"])
        E["eIdx"] = eCallRet
        emitOp(E, OP_STORE_GLOBAL, eCallRet)
    }
    if E["eInFn"] != 1 {
        let eLetPub = E["eStmtNode"]["isPub"]
        if eLetPub {
            eCallRet = ("" + E["eAssignSym"]) + ""
            E["eExports"] = push(E["eExports"], eCallRet)
        }
    }
    return true
}
