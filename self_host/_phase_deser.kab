import "self_host/parse"
import "self_host/emit"
import "self_host/serialize"
os_mount("/proj", ".")

fn profileFile(path) {
    let src = read_text_file(path)
    println("FILE " + path + " src_len " + ("" + len(src)))
    let t0 = date_now_ms()
    let ast = parse(src)
    let t1 = date_now_ms()
    println("PROFILE parse_ms " + path + " " + ("" + (t1 - t0)) + " body " + ("" + len(ast["body"])))
    let ir = emit(ast)
    let t2 = date_now_ms()
    println("PROFILE emit_ms " + path + " " + ("" + (t2 - t1)))
    let text = serialize_bc(ir)
    let t3 = date_now_ms()
    println("PROFILE serialize_ms " + path + " " + ("" + (t3 - t2)) + " out_len " + ("" + len(text)))
    println("PROFILE file_total_ms " + path + " " + ("" + (t3 - t0)))
    return t3 - t0
}

let tAll = date_now_ms()
let sum = 0
sum = sum + profileFile("/proj/self_host/deserialize_ops.kab")
sum = sum + profileFile("/proj/self_host/deserialize_h_code_misc.kab")
sum = sum + profileFile("/proj/self_host/deserialize_h_fn.kab")
sum = sum + profileFile("/proj/self_host/deserialize_h_arrow.kab")
sum = sum + profileFile("/proj/self_host/deserialize_h_class.kab")
sum = sum + profileFile("/proj/self_host/deserialize_handlers.kab")
sum = sum + profileFile("/proj/self_host/deserialize.kab")
println("PROFILE sum_ms " + ("" + sum))
println("PROFILE wall_ms " + ("" + (date_now_ms() - tAll)))
return true
