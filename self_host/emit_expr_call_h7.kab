import "self_host/ast_defs"
import "self_host/emit_defs"
import "self_host/emit_hooks"
import "self_host/emit_sym_index"
import "self_host/emit_arr_util"
import "self_host/emit_op"
import "self_host/emit_sym"
import "self_host/emit_local_map"
import "self_host/emit_call_callee"
import "self_host/emit_drop_callee"
import "self_host/emit_call_args"
import "self_host/emit_try_len"
import "self_host/emit_type_infer_resolve"
import "self_host/emit_type_infer_mangle"

let eCallRet = 0
let eCallRet2 = 0

pub fn emitExpr_call_h7(E) {
    emitResolveTypeArgsMem(E, "eArgs", E["eGenSym"], 0)
    E["eMangled"] = E["eGenSym"]
    emitMangleWithTypeArgs(E, "eMangled")
    E["eFound"] = 0
    E["eGenI"] = 0
    while E["eGenI"] < len(E["eEnums"]) {
        if E["eEnums"][E["eGenI"]]["sym"] == E["eMangled"] {
            E["eFound"] = 1
            break
        }
        E["eGenI"] = E["eGenI"] + 1
    }
    if E["eFound"] == 0 {
        E["eEnums"] = push(E["eEnums"], {
            "sym": E["eMangled"],
            "variants": arrUtil(E, "snap", E["eGenTmpl"]["variants"])
        })
        symIndex(E, "global", E["eMangled"])
    }
    E["eCallArgIStack"] = push(E["eCallArgIStack"], 0)
    E["eCallArgNStack"] = push(E["eCallArgNStack"], E["eArgN"])
    E["eArgsStack"] = push(E["eArgsStack"], E["eArgs"])
    emitCallArgExprs(E)
    while E["eArgN"] > 0 {
        emitOp(E, OP_POP, 0)
        E["eArgN"] = E["eArgN"] - 1
    }
    dropCallCallee(E)
    E["_callDone"] = 1
    return 0
}
