import "self_host/ast_defs"
import "self_host/emit_defs"
import "self_host/emit_op"
import "self_host/emit_hooks"
import "self_host/emit_patch_jump"

let eCallRet = 0

pub fn emitIfStmt(E) {
    E["eCondStack"] = push(E["eCondStack"], E["eCond"])
    E["eThenStack"] = push(E["eThenStack"], E["eThen"])
    E["eElseStack"] = push(E["eElseStack"], E["eElse"])
    E["eIfDepth"] = E["eIfDepth"] + 1
    let id = E["eIfDepth"]
    E["eCond"] = E["eNode"]["cond"]
    E["eThen"] = E["eNode"]["then"]
    E["eElse"] = E["eNode"]["elseBranch"]
    eCallExpr(E, E["eCond"])
    eCallRet = pushJmpAtLen(E, E["eIfJmpStack"])
    E["eIfJmpStack"] = eCallRet
    emitOp(E, OP_JUMP_IF_FALSE, 0)
    eCallStmt(E, E["eThen"])
    if E["eElse"] != null {
        eCallRet = pushJmpAtLen(E, E["eIfSkipStack"])
        E["eIfSkipStack"] = eCallRet
        emitOp(E, OP_JUMP, 0)
        // Jmp/skip stacks: always top via len (jmp is popped before else; depth ≠ len).
        // P6b: len_* / index_get_* make this cheap (no LoadGlobal clone).
        eCallRet = len(E["eIfJmpStack"]) - 1
        E["eJmp"] = E["eIfJmpStack"][eCallRet]
        patchRelJump(E, OP_JUMP_IF_FALSE, E["eJmp"])
        E["eIfJmpStack"] = pop(E["eIfJmpStack"])
        eCallStmt(E, E["eElse"])
        eCallRet = len(E["eIfSkipStack"]) - 1
        E["eIdx"] = E["eIfSkipStack"][eCallRet]
        patchRelJump(E, OP_JUMP, E["eIdx"])
        E["eIfSkipStack"] = pop(E["eIfSkipStack"])
    } else {
        eCallRet = len(E["eIfJmpStack"]) - 1
        E["eJmp"] = E["eIfJmpStack"][eCallRet]
        patchRelJump(E, OP_JUMP_IF_FALSE, E["eJmp"])
        E["eIfJmpStack"] = pop(E["eIfJmpStack"])
    }
    E["eCond"] = E["eCondStack"][id - 1]
    E["eThen"] = E["eThenStack"][id - 1]
    E["eElse"] = E["eElseStack"][id - 1]
    E["eCondStack"] = pop(E["eCondStack"])
    E["eThenStack"] = pop(E["eThenStack"])
    E["eElseStack"] = pop(E["eElseStack"])
    E["eIfDepth"] = E["eIfDepth"] - 1
}

