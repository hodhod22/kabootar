import "self_host/lexer_defs"
import "self_host/ast_defs"
import "self_host/parser_hooks"
import "self_host/parser_util"

pub fn parseMain_init(sess, tokens) {
    sess["pToks"] = tokens
    sess["pToksLen"] = len(tokens)
    sess["pPos"] = 0
    if sess["pToksLen"] > 0 {
        sess["pCur"] = sess["pToks"][0]
    } else {
        sess["pCur"] = sess["pEofTok"]
    }
    sess["pSymPool"] = []
    sess["pSymN"] = 0
    sess["pImports"] = []
    sess["pCondStack"] = []
    sess["pCondDepth"] = 0
    sess["pAddLeftStack"] = []
    sess["pBodyStack"] = []
    sess["pBodyDepth"] = 0
    sess["pBodyStack"] = push(sess["pBodyStack"], sess["pBody"])
    sess["pBodyDepth"] = 1
    sess["pBody"] = []
    sess["pDone"] = 0
    return 0
}
