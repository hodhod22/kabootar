// P6b: snap local caps from session S.
pub fn vSnapCapsS(S) {
    let caps = {}
    let i = 0
    let names = S["localNames"]
    let locals = S["locals"]
    while i < len(names) {
        if i < len(locals) {
            caps[names[i]] = locals[i]
        }
        i = i + 1
    }
    return caps
}
