// P6b: parser session expr fields.
pub fn pSessionInit_expr(sess) {
    sess["pLeft"] = null
    sess["pRight"] = null
    sess["pArgs"] = []
    sess["pIdent"] = null
    sess["pInit"] = null
    sess["pVal"] = null
    sess["pCallee"] = null
    sess["pObjFields"] = []
    sess["pSave"] = null
    sess["pAssignLhs"] = null
    sess["pBinOp"] = ""
    sess["pSaveSym"] = ""
    sess["pBindSym"] = ""
    sess["pExprLeft"] = null
    sess["pAddLeft"] = null
    sess["pAddLeftStack"] = []
    sess["pTypeArgs"] = []
    sess["pSnapTypeArgs"] = []
    sess["pIsGenericCallee"] = 0
    sess["pAngleI"] = 0
    sess["pAngleTok"] = null
    sess["pAngleOut"] = []
    sess["pMemberName"] = ""
    return 0
}
