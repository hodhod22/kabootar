// Opcode names for self-hosted bytecode IR (mirrors src/bytecode/types.rs).

// ----- STACK MANIPULATION -----
pub let OP_CONST = "const"
pub let OP_POP = "pop"

// ----- MEMORY ACCESS -----
pub let OP_LOAD_GLOBAL = "load_global"
pub let OP_STORE_GLOBAL = "store_global"
pub let OP_LOAD_LOCAL = "load_local"
pub let OP_STORE_LOCAL = "store_local"
pub let OP_TAKE_LOCAL = "take_local"
pub let OP_TAKE_GLOBAL = "take_global"
pub let OP_ARRAY_PUSH_LOCAL = "array_push_local"
pub let OP_ARRAY_PUSH_GLOBAL = "array_push_global"
pub let OP_ARRAY_POP_LOCAL = "array_pop_local"
pub let OP_ARRAY_POP_GLOBAL = "array_pop_global"
pub let OP_ACC_ADD_LOCAL = "acc_add_local"
pub let OP_ACC_ADD_GLOBAL = "acc_add_global"
pub let OP_LEN_LOCAL = "len_local"
pub let OP_LEN_GLOBAL = "len_global"
pub let OP_INDEX_GET_LOCAL = "index_get_local"
pub let OP_INDEX_GET_GLOBAL = "index_get_global"

// ----- ARITHMETIC -----
pub let OP_ADD = "add"
pub let OP_SUB = "sub"
pub let OP_MUL = "mul"
pub let OP_DIV = "div"
pub let OP_MOD = "mod"
pub let OP_POW = "pow"
pub let OP_NEG = "neg"
pub let OP_BIT_AND = "bit_and"
pub let OP_BIT_OR = "bit_or"
pub let OP_BIT_XOR = "bit_xor"
pub let OP_SHL = "shl"
pub let OP_SHR = "shr"
pub let OP_USHR = "ushr"
pub let OP_BIT_NOT = "bit_not"

// ----- LOGICAL -----
pub let OP_NOT = "not"
pub let OP_AND = "and"
pub let OP_OR = "or"

// ----- COMPARISON -----
pub let OP_EQ = "eq"
pub let OP_NE = "ne"
pub let OP_LT = "lt"
pub let OP_GT = "gt"
pub let OP_LE = "le"
pub let OP_GE = "ge"

// ----- DATA STRUCTURES -----
pub let OP_MAKE_OBJECT = "make_object"
pub let OP_MAKE_ARRAY = "make_array"
pub let OP_INDEX_GET = "index_get"
pub let OP_INDEX_SET = "index_set"
pub let OP_GET_MEMBER = "get_member"
pub let OP_SET_MEMBER = "set_member"

// ----- CONTROL FLOW -----
pub let OP_JUMP = "jump"
pub let OP_JUMP_IF_FALSE = "jump_if_false"
pub let OP_JUMP_IF_TRUE = "jump_if_true"

// ----- FUNCTIONS -----
pub let OP_CALL = "call"
pub let OP_NEW_INSTANCE = "new_instance"
pub let OP_RETURN = "return"

// ----- EXCEPTIONS -----
pub let OP_THROW = "throw"
pub let OP_JUMP_IF_RESULT_ERR = "jump_if_result_err"
pub let OP_MAKE_ARROW = "make_arrow_fn"
pub let OP_ITER_STEP = "iterator_step_in_place"
pub let OP_MAKE_OK = "make_ok"
pub let OP_MAKE_ERR = "make_err"
pub let OP_MAKE_SOME = "make_some"
pub let OP_MAKE_NONE = "make_none"

// ----- PROGRAM TERMINATION -----
pub let OP_HALT = "halt"

// Sentinel in emitter const pool; serialize maps to `const N undefined`.
pub let KAB_UNDEF_CONST = "__kab_const_undefined__"