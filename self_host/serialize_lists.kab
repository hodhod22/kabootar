// P6b: named-list append helper (skip-listed until ≤10s).
import "self_host/serialize_out"

pub fn serAppendNamedList(out, zeroTag, eqTag, itemTag, items) {
    if items == undefined {
        return serOutTag(out, zeroTag)
    }
    out = serOutTagEq(out, eqTag, len(items))
    let i = 0
    let n = len(items)
    while i < n {
        out = serOutTagged(out, itemTag, i, items[i])
        i = i + 1
    }
    return out
}
