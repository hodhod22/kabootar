import "self_host/vm_s_stack"

// --- vm_ops_ctrl_return_halt ---
pub fn runOpCtrlReturnHalt(S, name, arg, op, pool, globals, functions) {
    if name == "halt" {
        if len(S["stack"]) > 0 {
            let top = S["stack"][len(S["stack"]) - 1]
            S["result"] = top
        }
        S["done"] = true
        return 2
    }
    return 0
}

// --- vm_ops_ctrl_return_ret ---
pub fn runOpCtrlReturnRet(S, name, arg, op, pool, globals, functions) {
    if name == "return" {
        if len(S["stack"]) > 0 {
            let top = S["stack"][len(S["stack"]) - 1]
            S["result"] = top
        } else {
            S["result"] = null
        }
        S["done"] = true
        return 2
    }
    return 0
}

// --- vm_ops_ctrl_throw ---
pub fn runOpCtrlThrow(S, name, arg, op, pool, globals, functions) {
    if name == "throw" {
        let reason = null
        if len(S["stack"]) > 0 {
            reason = vPopS(S)
        }
        if vCatchThrow(S, reason) == 1 {
            return 1
        }
        throw reason
    }
    return 0
}

// --- vm_ops_ctrl_return ---
pub fn runOpCtrlReturn(S, name, arg, op, pool, globals, functions) {
    let st = runOpCtrlReturnRet(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpCtrlReturnHalt(S, name, arg, op, pool, globals, functions)
}

// --- vm_ops_ctrl_a ---
pub fn runOpCtrlA(S, name, arg, op, pool, globals, functions) {
    let st = runOpCtrlThrow(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpCtrlReturn(S, name, arg, op, pool, globals, functions)
}
