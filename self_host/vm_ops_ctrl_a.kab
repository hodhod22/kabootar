import "self_host/vm_s_stack"

// --- vm_ops_ctrl_return_halt ---
pub fn runOpCtrlReturnHalt(S, name, arg, op, pool, globals, functions) {
    if name == "halt" {
        if len(S["stack"]) > 0 {
            let top = S["stack"][len(S["stack"]) - 1]
            S["result"] = top
        }
        S["done"] = true
        return 2
    }
    return 0
}

// --- vm_ops_ctrl_return_ret ---
pub fn runOpCtrlReturnRet(S, name, arg, op, pool, globals, functions) {
    if name == "return" {
        if len(S["stack"]) > 0 {
            let top = S["stack"][len(S["stack"]) - 1]
            S["result"] = top
        } else {
            S["result"] = null
        }
        S["done"] = true
        return 2
    }
    return 0
}

// SH6: `await` — same contract as host Opcode::Await (identity or drain via await_all).
pub fn runOpCtrlAwait(S, name, arg, op, pool, globals, functions) {
    if name != "await" {
        return 0
    }
    let v = vPopS(S)
    let arr = await_all([v])
    vPushS(S, arr[0])
    vBumpIpS(S)
    return 1
}

pub fn runOpCtrlYield(S, name, arg, op, pool, globals, functions) {
    if name != "yield" {
        return 0
    }
    S["yieldVal"] = vPopS(S)
    S["yielded"] = 1
    S["done"] = true
    vBumpIpS(S)
    return 2
}

// --- vm_ops_ctrl_throw ---
pub fn runOpCtrlThrow(S, name, arg, op, pool, globals, functions) {
    if name == "throw" {
        let reason = null
        if len(S["stack"]) > 0 {
            reason = vPopS(S)
        }
        if vCatchThrow(S, reason) == 1 {
            return 1
        }
        throw reason
    }
    return 0
}

// --- vm_ops_ctrl_return ---
pub fn runOpCtrlReturn(S, name, arg, op, pool, globals, functions) {
    let st = runOpCtrlReturnRet(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpCtrlReturnHalt(S, name, arg, op, pool, globals, functions)
}

// --- vm_ops_ctrl_a ---
pub fn runOpCtrlA(S, name, arg, op, pool, globals, functions) {
    let st = runOpCtrlYield(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    st = runOpCtrlAwait(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    st = runOpCtrlThrow(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpCtrlReturn(S, name, arg, op, pool, globals, functions)
}
