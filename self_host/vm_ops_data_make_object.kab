import "self_host/vm_s_push"
import "self_host/vm_s_pop"
import "self_host/vm_s_ip"

pub fn runOpDataMakeObject(S, name, arg, op, pool, globals, functions) {
    if name == "make_object" {
        let n = arg
        let map = {}
        let ci = 0
        while ci < n {
            let key = vPopS(S)
            let val = vPopS(S)
            map["" + key] = val
            ci = ci + 1
        }
        vPushS(S, map)
        vBumpIpS(S)
        return 1
    }
    return 0
}
