import "self_host/ast_defs"

// --- parser_stmt_block ---
pub fn parseStmt_block(sess) {
    if !(sess["pCur"].type == "{") {
        return null
    }
    bump(sess)
    pEnterBody(sess)
    pParseBodyUntilRBrace(sess, "Unclosed block")
    let blockStmts = pLeaveBody(sess)
    return { "kind": AST_BLOCK, "body": blockStmts }
}

// --- parser_stmt_break ---
pub fn parseStmt_break(sess) {
    if !(sess["pCur"].type == TOKEN_BREAK) {
        return null
    }
        bump(sess)
        return { "kind": AST_BREAK }
}

pub fn parseStmt_fallthrough(sess) {
    if !(sess["pCur"].type == TOKEN_FALLTHROUGH) {
        return null
    }
    bump(sess)
    return { "kind": AST_FALLTHROUGH }
}

// --- parser_stmt_class_field ---
pub fn parseStmt_class_field(sess) {
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != TOKEN_IDENT {
        throw "Expected field name"
    }
    bump(sess)
    sess["pSaveSym"] = poolPush(sess, sess["pTok"].value)
    sess["pFieldType"] = ""
    if sess["pCur"].type == ":" {
        bump(sess)
        sess["pTok"] = sess["pCur"]
        if sess["pTok"].type != TOKEN_IDENT {
            throw "Expected field type"
        }
        bump(sess)
        sess["pFieldType"] = sess["pTok"].value
    }
    sess["pFieldDefault"] = null
    if sess["pCur"].type == "=" {
        bump(sess)
        sess["pFieldDefault"] = pCallCompare(sess)
    }
    if sess["pCur"].type == ";" {
        bump(sess)
    }
    sess["pVal"] = { "name": sess["pSaveSym"], "type": sess["pFieldType"], "default": sess["pFieldDefault"] }
    sess["pClassFields"] = push(sess["pClassFields"], sess["pVal"])
    return 0
}

// --- parser_stmt_class_assoc ---
pub fn parseStmt_class_assoc(sess) {
    bump(sess)
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != TOKEN_IDENT {
        throw "Expected associated type name"
    }
    bump(sess)
    sess["pSaveSym"] = sess["pTok"].value
    if sess["pCur"].type != "=" {
        throw "Expected = after associated type name"
    }
    bump(sess)
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != TOKEN_IDENT {
        throw "Expected associated type value"
    }
    bump(sess)
    sess["pClassAssoc"] = push(sess["pClassAssoc"], { "name": sess["pSaveSym"], "type": sess["pTok"].value })
    if sess["pCur"].type == ";" {
        bump(sess)
    }
    return 0
}

// --- parser_stmt_class_method_body ---
pub fn parseStmt_class_method_body(sess) {
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    let methParams = []
    let mpi = 0
    if sess["pMethParams"] != undefined && sess["pMethParams"] != null {
        while mpi < len(sess["pMethParams"]) {
            methParams = push(methParams, sess["pMethParams"][mpi])
            mpi = mpi + 1
        }
    }
    let methParamTypes = []
    mpi = 0
    if sess["pMethParamTypes"] != undefined && sess["pMethParamTypes"] != null {
        while mpi < len(sess["pMethParamTypes"]) {
            methParamTypes = push(methParamTypes, sess["pMethParamTypes"][mpi])
            mpi = mpi + 1
        }
    }
    let methParamDefaults = []
    mpi = 0
    if sess["pMethParamDefaults"] != undefined && sess["pMethParamDefaults"] != null {
        while mpi < len(sess["pMethParamDefaults"]) {
            methParamDefaults = push(methParamDefaults, sess["pMethParamDefaults"][mpi])
            mpi = mpi + 1
        }
    }
    let methRest = ""
    if sess["pMethRest"] != undefined && sess["pMethRest"] != null {
        methRest = "" + sess["pMethRest"]
    }
    pEnterBody(sess)
    pParseBodyUntilRBrace(sess, "Unclosed block")
    let methBody = pLeaveBody(sess)
    sess["pVal"] = {
        "sym": sess["pFnSym"],
        "typeParams": sess["pMethTypeParams"],
        "params": methParams,
        "paramTypes": methParamTypes,
        "paramDefaults": methParamDefaults,
        "rest": methRest,
        "returnType": "",
        "whereClause": sess["pMethWhere"],
        "body": { "kind": AST_BLOCK, "body": methBody }
    }
    sess["pClassMethods"] = push(sess["pClassMethods"], sess["pVal"])
    return 0
}

// --- parser_stmt_class_method_params ---
pub fn parseStmt_class_method_params(sess) {
    sess["pMethParams"] = []
    sess["pMethParamTypes"] = []
    sess["pMethParamDefaults"] = []
    sess["pMethRest"] = ""
    let sawDefault = 0
    if sess["pCur"].type == ")" {
        return 0
    }
    while true {
        sess["pTok"] = sess["pCur"]
        if sess["pTok"].type == "&" {
            bump(sess)
            if sess["pCur"].type == TOKEN_IDENT {
                if sess["pCur"].value == "mut" {
                    bump(sess)
                }
            }
            if sess["pCur"].type != TOKEN_SELF {
                throw "Expected self after &"
            }
            bump(sess)
        } else {
            if sess["pTok"].type == TOKEN_SELF {
                bump(sess)
            } else {
                if sess["pTok"].type == "..." {
                    bump(sess)
                    sess["pTok"] = sess["pCur"]
                    if sess["pTok"].type != TOKEN_IDENT {
                        throw "Expected rest parameter name"
                    }
                    bump(sess)
                    let restName = poolPush(sess, sess["pTok"].value)
                    sess["pMethRest"] = restName
                    sess["pMethParams"] = push(sess["pMethParams"], restName)
                    sess["pMethParamTypes"] = push(sess["pMethParamTypes"], "")
                    sess["pMethParamDefaults"] = push(sess["pMethParamDefaults"], null)
                    if sess["pCur"].type == "," {
                        throw "Rest parameter must be last"
                    }
                    break
                }
                if sess["pTok"].type != TOKEN_IDENT {
                    throw "Expected parameter name"
                }
                bump(sess)
                sess["pMethParams"] = push(sess["pMethParams"], poolPush(sess, sess["pTok"].value))
                sess["pParamType"] = ""
                if sess["pCur"].type == ":" {
                    bump(sess)
                    sess["pTok"] = sess["pCur"]
                    if sess["pTok"].type != TOKEN_IDENT {
                        throw "Expected parameter type"
                    }
                    bump(sess)
                    sess["pParamType"] = sess["pTok"].value
                }
                sess["pMethParamTypes"] = push(sess["pMethParamTypes"], sess["pParamType"])
                let def = null
                if sess["pCur"].type == "=" {
                    bump(sess)
                    sawDefault = 1
                    def = pCallCompare(sess)
                } else {
                    if sawDefault == 1 {
                        throw "Non-default parameter after default parameter"
                    }
                }
                sess["pMethParamDefaults"] = push(sess["pMethParamDefaults"], def)
            }
        }
        if sess["pCur"].type == "," {
            bump(sess)
        } else {
            break
        }
    }
    return 0
}

// --- parser_stmt_continue ---
pub fn parseStmt_continue(sess) {
    if !(sess["pCur"].type == TOKEN_CONTINUE) {
        return null
    }
        bump(sess)
        return { "kind": AST_CONTINUE }
}

// --- parser_stmt_earlyAssign ---
pub fn parseStmt_earlyAssign(sess) {
    if !(sess["pCur"].type == TOKEN_IDENT) {
        return null
    }
        if sess["pPos"] + 1 < sess["pToksLen"] {
            sess["pNextTok"] = sess["pToks"][sess["pPos"] + 1]
        } else {
            sess["pNextTok"] = { "type": "EOF", "value": null, "line": 1, "column": 1 }
        }
        if sess["pNextTok"].type == "=" {
            sess["pTok"] = sess["pCur"]
            sess["pBindSym"] = poolPush(sess, sess["pTok"].value)
            bump(sess)
            bump(sess)
            sess["pVal"] = pCallCompare(sess)
            return { "kind": AST_ASSIGN, "sym": sess["pBindSym"], "rhs": sess["pVal"] }
        }
        return null
}

// --- parser_stmt_enum_name ---
pub fn parseStmt_enum_name(sess) {
    sess["pTok"] = sess["pCur"]
    sess["pVariantName"] = ""
    if sess["pTok"].type == TOKEN_IDENT {
        bump(sess)
        sess["pVariantName"] = sess["pTok"].value
        return 0
    }
    if sess["pTok"].type == TOKEN_NONE {
        bump(sess)
        sess["pVariantName"] = "None"
        return 0
    }
    if sess["pTok"].type == TOKEN_SOME {
        bump(sess)
        sess["pVariantName"] = "Some"
        return 0
    }
    if sess["pTok"].type == TOKEN_OK {
        bump(sess)
        sess["pVariantName"] = "Ok"
        return 0
    }
    if sess["pTok"].type == TOKEN_ERR {
        bump(sess)
        sess["pVariantName"] = "Err"
        return 0
    }
    if sess["pTok"].type == TOKEN_TRUE {
        bump(sess)
        sess["pVariantName"] = "True"
        return 0
    }
    if sess["pTok"].type == TOKEN_FALSE {
        bump(sess)
        sess["pVariantName"] = "False"
        return 0
    }
    throw "Expected variant name"
}

// --- parser_stmt_expr ---
pub fn compoundAssignBinOp(tok) {
    if tok == "+=" {
        return "+"
    }
    if tok == "-=" {
        return "-"
    }
    if tok == "*=" {
        return "*"
    }
    if tok == "/=" {
        return "/"
    }
    if tok == "%=" {
        return "%"
    }
    if tok == "&&=" {
        return "&&"
    }
    if tok == "||=" {
        return "||"
    }
    if tok == "??=" {
        return "??"
    }
    if tok == "&=" {
        return "&"
    }
    if tok == "|=" {
        return "|"
    }
    if tok == "^=" {
        return "^"
    }
    if tok == "<<=" {
        return "<<"
    }
    if tok == ">>=" {
        return ">>"
    }
    if tok == ">>>=" {
        return ">>>"
    }
    if tok == "**=" {
        return "**"
    }
    return ""
}

pub fn finishAssignStmt(lhs, rhs) {
    if lhs.kind == AST_VAR {
        return { "kind": AST_ASSIGN, "sym": lhs["sym"], "rhs": rhs }
    }
    if lhs.kind == AST_INDEX {
        return { "kind": AST_INDEX_ASSIGN, "object": lhs["object"], "index": lhs["index"], "rhs": rhs }
    }
    if lhs.kind == AST_MEMBER {
        return { "kind": AST_MEMBER_ASSIGN, "object": lhs["object"], "field": lhs["field"], "rhs": rhs }
    }
    throw "invalid assign lhs"
}

pub fn parseStmt_expr(sess) {
    sess["pAssignLhs"] = pCallCompare(sess)
    let lhs = sess["pAssignLhs"]
    let tok = sess["pCur"].type
    if tok == "=" {
        bump(sess)
        // P6b: do not reuse sess["pSave"] — parseAddShift clobbers sess["pSave"] while parsing RHS
        // (e.g. `E["a"] = { "x": 1 + 2 }` → false "invalid assign lhs").
        sess["pInit"] = pCallCompare(sess)
        return finishAssignStmt(lhs, sess["pInit"])
    }
    let cop = compoundAssignBinOp(tok)
    if cop != "" {
        bump(sess)
        sess["pInit"] = pCallCompare(sess)
        return finishAssignStmt(lhs, { "kind": AST_BINARY, "op": cop, "left": lhs, "right": sess["pInit"], "compoundAssign": 1 })
    }
    sess["pVal"] = lhs
    return { "kind": AST_EXPR, "expr": sess["pVal"] }
}

// --- parser_stmt_fn_body ---
pub fn parseStmt_fn_body(sess) {
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    // SH2: nested `fn` in the body clobbers sess pFnSym/pParams — snap before parse.
    let snapSym = "" + sess["pFnSym"]
    let snapPub = sess["pFnPub"]
    let snapAsync = sess["pIsAsync"]
    let snapGen = sess["pIsGen"]
    let snapParams = []
    let spi = 0
    while spi < len(sess["pParams"]) {
        snapParams = push(snapParams, sess["pParams"][spi])
        spi = spi + 1
    }
    let snapParamTypes = []
    if sess["pParamTypes"] != undefined && sess["pParamTypes"] != null {
        spi = 0
        while spi < len(sess["pParamTypes"]) {
            snapParamTypes = push(snapParamTypes, sess["pParamTypes"][spi])
            spi = spi + 1
        }
    }
    let snapParamDefaults = []
    if sess["pParamDefaults"] != undefined && sess["pParamDefaults"] != null {
        spi = 0
        while spi < len(sess["pParamDefaults"]) {
            snapParamDefaults = push(snapParamDefaults, sess["pParamDefaults"][spi])
            spi = spi + 1
        }
    }
    let snapRest = ""
    if sess["pFnRest"] != undefined && sess["pFnRest"] != null {
        snapRest = "" + sess["pFnRest"]
    }
    let snapTypeParams = []
    spi = 0
    if sess["pTypeParams"] != undefined && sess["pTypeParams"] != null {
        while spi < len(sess["pTypeParams"]) {
            snapTypeParams = push(snapTypeParams, sess["pTypeParams"][spi])
            spi = spi + 1
        }
    }
    let snapRet = sess["pReturnType"]
    let snapWhere = []
    spi = 0
    if sess["pWhereClause"] != undefined && sess["pWhereClause"] != null {
        while spi < len(sess["pWhereClause"]) {
            snapWhere = push(snapWhere, sess["pWhereClause"][spi])
            spi = spi + 1
        }
    }
    bump(sess)
    pEnterBody(sess)
    pParseBodyUntilRBrace(sess, "Unclosed block")
    let fnBody = pLeaveBody(sess)
    return {
        "kind": AST_FN,
        "sym": snapSym,
        "isPub": snapPub,
        "typeParams": snapTypeParams,
        "params": snapParams,
        "paramTypes": snapParamTypes,
        "paramDefaults": snapParamDefaults,
        "rest": snapRest,
        "returnType": snapRet,
        "whereClause": snapWhere,
        "isAsync": snapAsync,
        "isGen": snapGen,
        "body": { "kind": AST_BLOCK, "body": fnBody }
    }
}

// --- parser_stmt_fn_params ---
pub fn parseStmt_fn_params(sess) {
    sess["pParams"] = []
    sess["pParamTypes"] = []
    sess["pParamDefaults"] = []
    sess["pFnRest"] = ""
    let sawDefault = 0
    if sess["pCur"].type == ")" {
        return 0
    }
    while true {
        sess["pTok"] = sess["pCur"]
        if sess["pTok"].type == "..." {
            bump(sess)
            sess["pTok"] = sess["pCur"]
            if sess["pTok"].type != TOKEN_IDENT {
                throw "Expected rest parameter name"
            }
            bump(sess)
            let restName = poolPush(sess, sess["pTok"].value)
            sess["pFnRest"] = restName
            sess["pParams"] = push(sess["pParams"], restName)
            sess["pParamTypes"] = push(sess["pParamTypes"], "")
            sess["pParamDefaults"] = push(sess["pParamDefaults"], null)
            if sess["pCur"].type == "," {
                throw "Rest parameter must be last"
            }
            break
        }
        if sess["pTok"].type != TOKEN_IDENT {
            throw "Expected parameter name"
        }
        bump(sess)
        sess["pParams"] = push(sess["pParams"], poolPush(sess, sess["pTok"].value))
        sess["pParamType"] = ""
        if sess["pCur"].type == ":" {
            bump(sess)
            sess["pTok"] = sess["pCur"]
            if sess["pTok"].type != TOKEN_IDENT {
                throw "Expected parameter type"
            }
            bump(sess)
            sess["pParamType"] = sess["pTok"].value
        }
        sess["pParamTypes"] = push(sess["pParamTypes"], sess["pParamType"])
        let def = null
        if sess["pCur"].type == "=" {
            bump(sess)
            sawDefault = 1
            def = pCallCompare(sess)
        } else {
            if sawDefault == 1 {
                throw "Non-default parameter after default parameter"
            }
        }
        sess["pParamDefaults"] = push(sess["pParamDefaults"], def)
        if sess["pCur"].type == "," {
            bump(sess)
        } else {
            break
        }
    }
    return 0
}

// --- parser_stmt_fn_ret ---
pub fn parseStmt_fn_ret(sess) {
    sess["pReturnType"] = ""
    if sess["pCur"].type != "->" {
        return 0
    }
    bump(sess)
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != TOKEN_IDENT {
        throw "Expected return type"
    }
    bump(sess)
    sess["pReturnType"] = sess["pTok"].value
    return 0
}

// --- parser_stmt_fn_where ---
pub fn parseStmt_fn_where(sess) {
    sess["pWhereClause"] = []
    if sess["pCur"].type != TOKEN_WHERE {
        return 0
    }
    bump(sess)
    while true {
        sess["pTok"] = sess["pCur"]
        if sess["pTok"].type != TOKEN_IDENT {
            throw "Expected type parameter in where"
        }
        bump(sess)
        sess["pWhereParam"] = sess["pTok"].value
        if sess["pCur"].type != ":" {
            throw "Expected : in where"
        }
        bump(sess)
        sess["pTok"] = sess["pCur"]
        if sess["pTok"].type != TOKEN_IDENT {
            throw "Expected trait name in where"
        }
        bump(sess)
        sess["pWhereTrait"] = sess["pTok"].value
        sess["pWhereClause"] = push(sess["pWhereClause"], {
            "typeParam": sess["pWhereParam"],
            "traitName": sess["pWhereTrait"]
        })
        if sess["pCur"].type == "," {
            bump(sess)
        } else {
            break
        }
    }
    return 0
}

// --- parser_stmt_for ---
pub fn parseStmt_for_body_block(sess) {
    if sess["pCur"].type == ")" {
        bump(sess)
    }
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    pEnterLoopBody(sess)
    pParseLoopUntilRBrace(sess)
    return { "kind": AST_BLOCK, "body": pLeaveLoopBody(sess) }
}

pub fn parseStmt_for_of_from_ident(sess) {
    let forAwait = sess["pForAwait"]
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != TOKEN_IDENT {
        throw "Expected for binding"
    }
    bump(sess)
    let forSym = sess["pTok"].value
    let forKind = AST_FOR_OF
    if sess["pCur"].type == TOKEN_IN {
        bump(sess)
        forKind = AST_FOR_IN
    } else {
        if sess["pCur"].type != TOKEN_OF {
            throw "Expected of or in"
        }
        bump(sess)
    }
    let forIter = pCallCompare(sess)
    return {
        "kind": forKind,
        "sym": forSym,
        "iterable": forIter,
        "isAsync": forAwait,
        "body": parseStmt_for_body_block(sess)
    }
}

pub fn parseStmt_for_classic(sess) {
    let init = parseStmt_let(sess)
    if init == null {
        throw "Expected let in classic for"
    }
    if sess["pCur"].type != ";" {
        throw "Expected ; after for init"
    }
    bump(sess)
    let cond = null
    if sess["pCur"].type != ";" {
        cond = pCallCompare(sess)
    }
    if sess["pCur"].type != ";" {
        throw "Expected ; after for cond"
    }
    bump(sess)
    let step = null
    if sess["pCur"].type != "{" && sess["pCur"].type != ")" {
        step = parseStmt_expr(sess)
    }
    return {
        "kind": AST_FOR,
        "init": init,
        "cond": cond,
        "step": step,
        "body": parseStmt_for_body_block(sess)
    }
}

pub fn parseStmt_for(sess) {
    if !(sess["pCur"].type == TOKEN_FOR) {
        return null
    }
    bump(sess)
    if sess["pCur"].type == "(" {
        bump(sess)
    }
    sess["pForAwait"] = 0
    if sess["pCur"].type == TOKEN_AWAIT {
        bump(sess)
        sess["pForAwait"] = 1
    }
    if sess["pCur"].type == TOKEN_LET {
        let t2 = "EOF"
        if sess["pPos"] + 2 < sess["pToksLen"] {
            t2 = sess["pToks"][sess["pPos"] + 2].type
        }
        if t2 == TOKEN_OF || t2 == TOKEN_IN {
            bump(sess)
            return parseStmt_for_of_from_ident(sess)
        }
        if sess["pForAwait"] == 1 {
            throw "for await requires `of` iteration"
        }
        return parseStmt_for_classic(sess)
    }
    if sess["pForAwait"] == 1 {
        if sess["pCur"].type == TOKEN_IN {
            throw "for await requires `of` iteration"
        }
    }
    return parseStmt_for_of_from_ident(sess)
}

// --- parser_stmt_if_arm ---
pub fn parseStmt_if_arm(sess) {
    let armCond = pCallCompare(sess)
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    pEnterBody(sess)
    pParseBodyUntilRBrace(sess, "Unclosed if block")
    let armThen = { "kind": AST_BLOCK, "body": pLeaveBody(sess) }
    return { "cond": armCond, "then": armThen }
}

// --- parser_stmt_if_else_block ---
pub fn parseStmt_if_else_block(sess) {
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    pEnterBody(sess)
    pParseBodyUntilRBrace(sess, "Unclosed else block")
    return { "kind": AST_BLOCK, "body": pLeaveBody(sess) }
}

// --- parser_stmt_iface_assoc ---
pub fn parseStmt_iface_assoc(sess) {
    if !(sess["pCur"].type == TOKEN_IDENT && sess["pCur"].value == "type") {
        return 0
    }
    bump(sess)
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != TOKEN_IDENT {
        throw "Expected associated type name"
    }
    bump(sess)
    sess["pAssocTypes"] = push(sess["pAssocTypes"], sess["pTok"].value)
    if sess["pCur"].type != ";" {
        throw "Expected ; after associated type"
    }
    bump(sess)
    return 1
}

// --- parser_stmt_iface_meth_sig ---
pub fn parseStmt_iface_meth_sig(sess) {
    bump(sess)
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != TOKEN_IDENT {
        throw "Expected method name"
    }
    bump(sess)
    sess["pFnSym"] = sess["pTok"].value
    if sess["pCur"].type != "(" {
        throw "Expected ( at " + ("" + sess["pCur"].line) + ":" + ("" + sess["pCur"].column) + " tok=" + sess["pCur"].type
    }
    bump(sess)
    parseStmt_class_method_params(sess)
    if sess["pCur"].type != ")" {
        throw "Expected )"
    }
    bump(sess)
    return 0
}

// --- parser_stmt_iface_meth_tail ---
pub fn parseStmt_iface_meth_tail(sess) {
    let ifaceMethParams = sess["pMethParams"]
    let ifaceMethSym = sess["pFnSym"]
    let ifaceMethDefaults = sess["pMethParamDefaults"]
    if ifaceMethDefaults == undefined || ifaceMethDefaults == null {
        ifaceMethDefaults = []
    }
    let ifaceMethRest = ""
    if sess["pMethRest"] != undefined && sess["pMethRest"] != null {
        ifaceMethRest = "" + sess["pMethRest"]
    }
    if sess["pCur"].type == "{" {
        bump(sess)
        pEnterBody(sess)
        pParseBodyUntilRBrace(sess, "Unclosed default method body")
        let defBody = pLeaveBody(sess)
        sess["pIfaceMethods"] = push(sess["pIfaceMethods"], {
            "sym": ifaceMethSym,
            "params": ifaceMethParams,
            "paramDefaults": ifaceMethDefaults,
            "rest": ifaceMethRest,
            "body": { "kind": AST_BLOCK, "body": defBody }
        })
    } else {
        if sess["pCur"].type != ";" {
            throw "Expected ; or default method body"
        }
        bump(sess)
        sess["pIfaceMethods"] = push(sess["pIfaceMethods"], {
            "sym": ifaceMethSym,
            "params": ifaceMethParams,
            "paramDefaults": ifaceMethDefaults,
            "rest": ifaceMethRest
        })
    }
    return 0
}

// --- parser_stmt_lateAssign ---
pub fn parseStmt_lateAssign(sess) {
    if !(sess["pCur"].type == TOKEN_IDENT) {
        return null
    }
        if sess["pPos"] + 1 < sess["pToksLen"] {
            sess["pNextTok"] = sess["pToks"][sess["pPos"] + 1]
        } else {
            sess["pNextTok"] = { "type": "EOF", "value": null, "line": 1, "column": 1 }
        }
        if sess["pNextTok"].type == "=" {
            sess["pTok"] = sess["pCur"]
            sess["pBindSym"] = poolPush(sess, sess["pTok"].value)
            bump(sess)
            bump(sess)
            sess["pVal"] = pCallCompare(sess)
            return { "kind": AST_ASSIGN, "sym": sess["pBindSym"], "rhs": sess["pVal"] }
        }
        return null
}

// --- parser_stmt_let_array ---
/// Nested `let { x: [a, b] }` / `let [{ a }]` — names, rest, nested array/object.
pub fn parseLetPattern(sess) {
    if sess["pCur"].type == "[" {
        return { "kind": "array", "items": parseLetArrayItems(sess) }
    }
    if sess["pCur"].type == "{" {
        return { "kind": "object", "fields": parseLetObjectFields(sess) }
    }
    if sess["pCur"].type != TOKEN_IDENT {
        throw "Expected binding"
    }
    bump(sess)
    return { "kind": "name", "sym": poolPush(sess, sess["pTok"].value) }
}

/// `let [a, ...rest] = xs` — names + rest + nested patterns.
pub fn parseLetArrayItems(sess) {
    bump(sess)
    let items = []
    while sess["pCur"].type != "]" {
        if sess["pCur"].type == "," {
            bump(sess)
            continue
        }
        if sess["pCur"].type == "..." {
            bump(sess)
            let rname = ""
            if sess["pCur"].type == TOKEN_IDENT {
                bump(sess)
                rname = poolPush(sess, sess["pTok"].value)
            }
            items = push(items, { "kind": "rest", "sym": rname })
            if sess["pCur"].type == "," {
                bump(sess)
            }
            continue
        }
        items = push(items, parseLetPattern(sess))
        if sess["pCur"].type == "," {
            bump(sess)
        }
    }
    bump(sess)
    return items
}

// --- parser_stmt_let_object ---
/// `let { a, ...rest } = obj` — shorthand, ident rename, rest, nested patterns.
pub fn parseLetObjectFields(sess) {
    bump(sess)
    let fields = []
    while sess["pCur"].type != "}" {
        if sess["pCur"].type == "," {
            bump(sess)
            continue
        }
        if sess["pCur"].type == "..." {
            bump(sess)
            let rname = ""
            if sess["pCur"].type == TOKEN_IDENT {
                bump(sess)
                rname = poolPush(sess, sess["pTok"].value)
            }
            fields = push(fields, { "kind": "rest", "sym": rname })
            if sess["pCur"].type == "," {
                bump(sess)
            }
            continue
        }
        if sess["pCur"].type != TOKEN_IDENT {
            throw "Expected binding in let {}"
        }
        bump(sess)
        let key = poolPush(sess, sess["pTok"].value)
        if sess["pCur"].type == ":" {
            bump(sess)
            fields = push(fields, { "kind": "field", "key": key, "pat": parseLetPattern(sess) })
        } else {
            fields = push(fields, { "kind": "shorthand", "key": key })
        }
        if sess["pCur"].type == "," {
            bump(sess)
        }
    }
    bump(sess)
    return fields
}

// --- parser_stmt_let ---
pub fn parseStmt_let(sess) {
    if !(sess["pCur"].type == TOKEN_LET) {
        return null
    }
        bump(sess)
        if sess["pCur"].type == "[" {
            let letItems = parseLetArrayItems(sess)
            if sess["pCur"].type != "=" {
                throw "Expected ="
            }
            bump(sess)
            sess["pInit"] = pCallCompare(sess)
            return { "kind": AST_LET, "pat": { "kind": "array", "items": letItems }, "init": sess["pInit"], "isPub": sess["pIsPub"] }
        }
        if sess["pCur"].type == "{" {
            let letFields = parseLetObjectFields(sess)
            if sess["pCur"].type != "=" {
                throw "Expected ="
            }
            bump(sess)
            sess["pInit"] = pCallCompare(sess)
            return { "kind": AST_LET, "pat": { "kind": "object", "fields": letFields }, "init": sess["pInit"], "isPub": sess["pIsPub"] }
        }
        sess["pTok"] = sess["pCur"]
        if sess["pTok"].type != TOKEN_IDENT {
            throw "Expected identifier after let"
        }
        sess["pLetSym"] = sess["pTok"].value
        bump(sess)
        sess["pBindSym"] = poolPush(sess, sess["pLetSym"])
        if sess["pCur"].type != "=" {
            throw "Expected ="
        }
        bump(sess)
        sess["pInit"] = pCallCompare(sess)
        return { "kind": AST_LET, "sym": sess["pBindSym"], "init": sess["pInit"], "isPub": sess["pIsPub"] }
}

pub fn parseStmt_using(sess) {
    if !(sess["pCur"].type == TOKEN_USING) {
        return null
    }
    bump(sess)
    if sess["pCur"].type != TOKEN_IDENT {
        throw "Expected identifier after using"
    }
    sess["pTok"] = sess["pCur"]
    bump(sess)
    let uName = poolPush(sess, sess["pTok"].value)
    if sess["pCur"].type != "=" {
        throw "Expected ="
    }
    bump(sess)
    let uInit = pCallCompare(sess)
    return { "kind": AST_USING, "name": uName, "init": uInit }
}

// --- parser_stmt_return ---
pub fn parseStmt_return(sess) {
    if !(sess["pCur"].type == TOKEN_RETURN) {
        return null
    }
        bump(sess)
        if sess["pCur"].type == ";" {
            return { "kind": AST_RETURN, "value": null }
        }
        if sess["pCur"].type == "}" {
            return { "kind": AST_RETURN, "value": null }
        }
        if sess["pCur"].type == "EOF" {
            return { "kind": AST_RETURN, "value": null }
        }
        sess["pVal"] = pCallCompare(sess)
        return { "kind": AST_RETURN, "value": sess["pVal"] }
}

// --- parser_stmt_throw ---
pub fn parseStmt_throw(sess) {
    if !(sess["pCur"].type == TOKEN_THROW || sess["pCur"].type == TOKEN_RAISE) {
        return null
    }
        bump(sess)
        sess["pVal"] = pCallCompare(sess)
        return { "kind": AST_THROW, "expr": sess["pVal"] }
}

pub fn parseStmt_pass(sess) {
    if !(sess["pCur"].type == TOKEN_PASS) {
        return null
    }
    bump(sess)
    return { "kind": AST_PASS }
}

pub fn parseStmt_assert(sess) {
    if !(sess["pCur"].type == TOKEN_ASSERT) {
        return null
    }
    bump(sess)
    let cond = pCallCompare(sess)
    let msg = null
    if sess["pCur"].type == "," {
        bump(sess)
        msg = pCallCompare(sess)
    }
    return { "kind": AST_ASSERT, "cond": cond, "message": msg }
}

pub fn parseStmt_with(sess) {
    if !(sess["pCur"].type == TOKEN_WITH) {
        return null
    }
    bump(sess)
    let wVal = pCallCompare(sess)
    if sess["pCur"].type != TOKEN_AS {
        throw "Expected as"
    }
    bump(sess)
    if sess["pCur"].type != TOKEN_IDENT {
        throw "Expected binding name"
    }
    sess["pTok"] = sess["pCur"]
    bump(sess)
    let wName = poolPush(sess, sess["pTok"].value)
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    pEnterBody(sess)
    pParseBodyUntilRBrace(sess, "Unclosed with")
    let wBody = pLeaveBody(sess)
    return {
        "kind": AST_WITH,
        "name": wName,
        "value": wVal,
        "body": { "kind": AST_BLOCK, "body": wBody }
    }
}

// --- parser_stmt_try_body ---
pub fn parseStmt_try_body(sess) {
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    pEnterBody(sess)
    pParseBodyUntilRBrace(sess, "Unclosed try")
    return pLeaveBody(sess)
}

// --- parser_stmt_try_catch ---
pub fn parseStmt_try_catch(sess) {
    if sess["pCur"].type != TOKEN_CATCH {
        return null
    }
    bump(sess)
    if sess["pCur"].type != "(" {
        throw "Expected ( at " + ("" + sess["pCur"].line) + ":" + ("" + sess["pCur"].column) + " tok=" + sess["pCur"].type
    }
    bump(sess)
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != TOKEN_IDENT {
        throw "Expected catch binding"
    }
    bump(sess)
    let errSym = sess["pTok"].value
    if sess["pCur"].type != ")" {
        throw "Expected )"
    }
    bump(sess)
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    pEnterBody(sess)
    pParseBodyUntilRBrace(sess, "Unclosed catch")
    let catchBody = pLeaveBody(sess)
    return {
        "errName": errSym,
        "handler": { "kind": AST_BLOCK, "body": catchBody }
    }
}

pub fn parseStmt_try_finally(sess) {
    if sess["pCur"].type != TOKEN_FINALLY {
        return null
    }
    bump(sess)
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    pEnterBody(sess)
    pParseBodyUntilRBrace(sess, "Unclosed finally")
    let finBody = pLeaveBody(sess)
    return { "kind": AST_BLOCK, "body": finBody }
}

pub fn parseSwitchCaseBody(sess) {
    if sess["pCur"].type != "{" {
        return pCallStmt(sess)
    }
    bump(sess)
    pEnterBody(sess)
    pParseBodyUntilRBrace(sess, "Unclosed switch case")
    return { "kind": AST_BLOCK, "body": pLeaveBody(sess) }
}

pub fn parseStmt_switch(sess) {
    if !(sess["pCur"].type == TOKEN_SWITCH) {
        return null
    }
    bump(sess)
    if sess["pCur"].type != "(" {
        throw "Expected ("
    }
    bump(sess)
    let scrut = pCallCompare(sess)
    if sess["pCur"].type != ")" {
        throw "Expected )"
    }
    bump(sess)
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    let cases = []
    let defB = null
    while sess["pCur"].type != "}" {
        if sess["pCur"].type == "EOF" {
            throw "Unclosed switch"
        }
        if sess["pCur"].type == TOKEN_CASE {
            let values = []
            while sess["pCur"].type == TOKEN_CASE {
                bump(sess)
                let cv = pCallCompare(sess)
                if sess["pCur"].type != ":" {
                    throw "Expected :"
                }
                bump(sess)
                values = push(values, cv)
            }
            let body = parseSwitchCaseBody(sess)
            let vi = 0
            while vi < len(values) {
                cases = push(cases, { "value": values[vi], "body": body })
                vi = vi + 1
            }
        } else {
            if sess["pCur"].type == TOKEN_DEFAULT {
                bump(sess)
                if sess["pCur"].type != ":" {
                    throw "Expected :"
                }
                bump(sess)
                defB = parseSwitchCaseBody(sess)
            } else {
                throw "Expected case or default"
            }
        }
    }
    bump(sess)
    return { "kind": AST_SWITCH, "scrutinee": scrut, "cases": cases, "defaultBody": defB }
}

pub fn parseStmt_do(sess) {
    if !(sess["pCur"].type == TOKEN_DO) {
        return null
    }
    bump(sess)
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    pEnterLoopBody(sess)
    pParseLoopUntilRBrace(sess)
    let doBody = pLeaveLoopBody(sess)
    if sess["pCur"].type != TOKEN_WHILE {
        throw "Expected while"
    }
    bump(sess)
    let doCond = pCallCompare(sess)
    if sess["pCur"].type == ";" {
        bump(sess)
    }
    return { "kind": AST_DO_WHILE, "cond": doCond, "body": { "kind": AST_BLOCK, "body": doBody } }
}

// --- parser_stmt_while ---
pub fn parseStmt_while(sess) {
    if !(sess["pCur"].type == TOKEN_WHILE) {
        return null
    }
    bump(sess)
    if sess["pCur"].type == TOKEN_LET {
        bump(sess)
        let pat = pCallMatchPat(sess)
        bump(sess)
        let scrut = pCallCompare(sess)
        if sess["pCur"].type != "{" {
            throw "Expected {"
        }
        bump(sess)
        pEnterLoopBody(sess)
        pParseLoopUntilRBrace(sess)
        let whileBody = pLeaveLoopBody(sess)
        let okArm = { "kind": AST_BLOCK, "body": whileBody }
        let brArm = { "kind": AST_BLOCK, "body": [{ "kind": AST_BREAK }] }
        let arms = []
        arms = push(arms, { "pattern": pat, "guard": null, "body": okArm })
        arms = push(arms, { "pattern": { "kind": "wild" }, "guard": null, "body": brArm })
        let mx = { "kind": AST_MATCH, "scrutinee": scrut, "arms": arms }
        let trueLit = { "kind": AST_LITERAL, "lit": LIT_BOOL, "value": true }
        return { "kind": AST_WHILE, "cond": trueLit, "body": { "kind": AST_BLOCK, "body": [{ "kind": AST_EXPR, "expr": mx }] } }
    }
    let whileCond = pCallCompare(sess)
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    pEnterLoopBody(sess)
    pParseLoopUntilRBrace(sess)
    let whileBody = pLeaveLoopBody(sess)
    return { "kind": AST_WHILE, "cond": whileCond, "body": { "kind": AST_BLOCK, "body": whileBody } }
}

// --- parser_stmt_class_method ---
pub fn parseStmt_class_method(sess) {
    if sess["pCur"].type != TOKEN_FN {
        return 0
    }
    bump(sess)
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != TOKEN_IDENT {
        throw "Expected method name"
    }
    bump(sess)
    sess["pFnSym"] = sess["pTok"].value
    sess["pMethTypeParams"] = pCallTypeArgs(sess)
    if sess["pCur"].type != "(" {
        throw "Expected ( at " + ("" + sess["pCur"].line) + ":" + ("" + sess["pCur"].column) + " tok=" + sess["pCur"].type
    }
    bump(sess)
    parseStmt_class_method_params(sess)
    if sess["pCur"].type != ")" {
        throw "Expected )"
    }
    bump(sess)
    parseStmt_fn_where(sess)
    let snapMethWhere = []
    let wpi = 0
    if sess["pWhereClause"] != undefined && sess["pWhereClause"] != null {
        while wpi < len(sess["pWhereClause"]) {
            snapMethWhere = push(snapMethWhere, sess["pWhereClause"][wpi])
            wpi = wpi + 1
        }
    }
    sess["pMethWhere"] = snapMethWhere
    return parseStmt_class_method_body(sess)
}

// --- parser_stmt_enum_variant ---
pub fn parseStmt_enum_variant(sess) {
    parseStmt_enum_name(sess)
    sess["pVariantSym"] = poolPush(sess, sess["pVariantName"])
    sess["pVariantFields"] = []
    if sess["pCur"].type == "(" {
        bump(sess)
        while sess["pCur"].type != ")" {
            sess["pTok"] = sess["pCur"]
            if sess["pTok"].type != TOKEN_IDENT {
                throw "Expected variant field type"
            }
            bump(sess)
            sess["pVariantFields"] = push(sess["pVariantFields"], poolPush(sess, sess["pTok"].value))
            if sess["pCur"].type == "," {
                bump(sess)
            }
        }
        bump(sess)
    }
    object_array_push(sess, "pVariants", {
        "name": sess["pVariantSym"],
        "fields": slice(sess["pVariantFields"], 0)
    })
    if sess["pCur"].type == "," {
        bump(sess)
    }
    return 0
}

// --- parser_stmt_fn_sig ---
pub fn parseStmt_fn_sig(sess) {
    bump(sess)
    sess["pIsGen"] = 0
    if sess["pCur"].type == "*" {
        bump(sess)
        sess["pIsGen"] = 1
    }
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != TOKEN_IDENT {
        throw "Expected function name"
    }
    bump(sess)
    sess["pFnSym"] = sess["pTok"].value
    sess["pFnPub"] = sess["pIsPub"]
    sess["pTypeParams"] = pCallTypeArgs(sess)
    if sess["pCur"].type != "(" {
        throw "Expected ( at " + ("" + sess["pCur"].line) + ":" + ("" + sess["pCur"].column) + " tok=" + sess["pCur"].type
    }
    bump(sess)
    parseStmt_fn_params(sess)
    if sess["pCur"].type != ")" {
        throw "Expected )"
    }
    bump(sess)
    return parseStmt_fn_ret(sess)
}

// --- parser_stmt_if ---
pub fn parseStmt_ifLet(sess) {
    bump(sess)
    let pat = pCallMatchPat(sess)
    bump(sess)
    let scrut = pCallCompare(sess)
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    pEnterBody(sess)
    pParseBodyUntilRBrace(sess, "Unclosed if let block")
    let thenB = { "kind": AST_BLOCK, "body": pLeaveBody(sess) }
    let elseB = { "kind": AST_LITERAL, "lit": LIT_NULL, "value": null }
    if sess["pCur"].type == TOKEN_ELSE {
        bump(sess)
        if sess["pCur"].type == TOKEN_IF {
            elseB = parseStmt_if(sess)
        } else {
            elseB = parseStmt_if_else_block(sess)
        }
    }
    let arms = []
    arms = push(arms, { "pattern": pat, "guard": null, "body": thenB })
    arms = push(arms, { "pattern": { "kind": "wild" }, "guard": null, "body": elseB })
    return { "kind": AST_EXPR, "expr": { "kind": AST_MATCH, "scrutinee": scrut, "arms": arms } }
}

pub fn parseStmt_if(sess) {
    if !(sess["pCur"].type == TOKEN_IF) {
        return null
    }
    bump(sess)
    if sess["pCur"].type == TOKEN_LET {
        return parseStmt_ifLet(sess)
    }
    // Iterative else-if: avoid deep parseStmt recursion (hangs on long chains).
    let chainConds = []
    let chainThens = []
    let finalElse = null
    while true {
        let arm = parseStmt_if_arm(sess)
        chainConds = push(chainConds, arm["cond"])
        chainThens = push(chainThens, arm["then"])
        if sess["pCur"].type != TOKEN_ELSE {
            break
        }
        bump(sess)
        if sess["pCur"].type == TOKEN_IF {
            bump(sess)
            if sess["pCur"].type == TOKEN_LET {
                finalElse = parseStmt_ifLet(sess)
                break
            }
            continue
        }
        finalElse = parseStmt_if_else_block(sess)
        break
    }
    let i = len(chainConds) - 1
    let ifNode = { "kind": AST_IF, "cond": chainConds[i], "then": chainThens[i], "elseBranch": finalElse }
    i = i - 1
    while i >= 0 {
        ifNode = { "kind": AST_IF, "cond": chainConds[i], "then": chainThens[i], "elseBranch": ifNode }
        i = i - 1
    }
    return ifNode
}

// --- parser_stmt_iface_meth ---
pub fn parseStmt_iface_meth(sess) {
    if sess["pCur"].type != TOKEN_FN {
        throw "Expected fn in interface"
    }
    parseStmt_iface_meth_sig(sess)
    return parseStmt_iface_meth_tail(sess)
}

// --- parser_stmt_try ---
pub fn parseStmt_try(sess) {
    if !(sess["pCur"].type == TOKEN_TRY) {
        return null
    }
    bump(sess)
    let tryBody = parseStmt_try_body(sess)
    let catchPart = parseStmt_try_catch(sess)
    let fin = parseStmt_try_finally(sess)
    if catchPart == null {
        if fin == null {
            throw "Expected catch"
        }
        catchPart = {
            "errName": "e",
            "handler": { "kind": AST_BLOCK, "body": [] },
            "bareFinally": 1
        }
    }
    let bareFin = catchPart["bareFinally"]
    if bareFin == undefined {
        bareFin = 0
    }
    return {
        "kind": AST_TRY,
        "body": { "kind": AST_BLOCK, "body": tryBody },
        "errName": catchPart["errName"],
        "handler": catchPart["handler"],
        "finalizer": fin,
        "bareFinally": bareFin
    }
}

// --- parser_stmt_class ---
pub fn parseStmt_class(sess) {
    if !(sess["pCur"].type == TOKEN_CLASS || sess["pCur"].type == TOKEN_STRUCT) {
        return null
    }
    sess["pIsStruct"] = 0
    if sess["pCur"].type == TOKEN_STRUCT {
        sess["pIsStruct"] = 1
    }
    bump(sess)
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != TOKEN_IDENT {
        if sess["pIsStruct"] == 1 {
            throw "Expected struct name"
        }
        throw "Expected class name"
    }
    bump(sess)
    sess["pClassSym"] = sess["pTok"].value
    sess["pTypeParams"] = pCallTypeArgs(sess)
    sess["pExtends"] = ""
    sess["pExtendsTypeArgs"] = []
    if sess["pIsStruct"] != 1 {
        if sess["pCur"].type == TOKEN_EXTENDS {
            bump(sess)
            sess["pTok"] = sess["pCur"]
            if sess["pTok"].type != TOKEN_IDENT {
                throw "Expected base class"
            }
            bump(sess)
            sess["pExtends"] = sess["pTok"].value
            sess["pExtendsTypeArgs"] = pCallTypeArgs(sess)
            if sess["pExtendsTypeArgs"] == undefined {
                sess["pExtendsTypeArgs"] = []
            }
        }
    }
    sess["pImplements"] = []
    if sess["pCur"].type == TOKEN_IMPLEMENTS {
        bump(sess)
        while true {
            sess["pTok"] = sess["pCur"]
            if sess["pTok"].type != TOKEN_IDENT {
                throw "Expected interface name"
            }
            bump(sess)
            let implName = sess["pTok"].value
            let implArgs = pCallTypeArgs(sess)
            if implArgs == undefined {
                implArgs = []
            }
            if len(implArgs) > 0 {
                implName = implName + "$" + implArgs[0]
                let iai = 1
                while iai < len(implArgs) {
                    implName = implName + "_" + implArgs[iai]
                    iai = iai + 1
                }
            }
            sess["pImplements"] = push(sess["pImplements"], implName)
            if sess["pCur"].type == "," {
                bump(sess)
            } else {
                break
            }
        }
    }
    parseStmt_fn_where(sess)
    let snapClassWhere = []
    let cwi = 0
    if sess["pWhereClause"] != undefined && sess["pWhereClause"] != null {
        while cwi < len(sess["pWhereClause"]) {
            snapClassWhere = push(snapClassWhere, sess["pWhereClause"][cwi])
            cwi = cwi + 1
        }
    }
    sess["pClassWhere"] = snapClassWhere
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    sess["pClassFields"] = []
    sess["pClassMethods"] = []
    sess["pClassAssoc"] = []
    while sess["pCur"].type != "}" {
        if sess["pCur"].type == TOKEN_FN {
            parseStmt_class_method(sess)
        } else {
            if sess["pCur"].type == TOKEN_IDENT {
                if sess["pCur"].value == "type" {
                    parseStmt_class_assoc(sess)
                } else {
                    parseStmt_class_field(sess)
                }
            } else {
                parseStmt_class_field(sess)
            }
        }
    }
    bump(sess)
    return {
        "kind": AST_CLASS,
        "sym": sess["pClassSym"],
        "typeParams": sess["pTypeParams"],
        "extends": sess["pExtends"],
        "extendsTypeArgs": sess["pExtendsTypeArgs"],
        "fields": sess["pClassFields"],
        "methods": sess["pClassMethods"],
        "implements": sess["pImplements"],
        "whereClause": sess["pClassWhere"],
        "associatedTypes": sess["pClassAssoc"],
        "isStruct": sess["pIsStruct"]
    }
}

// --- parser_stmt_enum ---
pub fn parseStmt_enum(sess) {
    if !(sess["pCur"].type == TOKEN_ENUM) {
        return null
    }
    bump(sess)
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != TOKEN_IDENT {
        throw "Expected enum name"
    }
    bump(sess)
    sess["pEnumSym"] = sess["pTok"].value
    sess["pTypeParams"] = pCallTypeArgs(sess)
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    sess["pVariants"] = []
    while sess["pCur"].type != "}" {
        if sess["pCur"].type == "," {
            bump(sess)
        } else {
            parseStmt_enum_variant(sess)
        }
    }
    bump(sess)
    return { "kind": AST_ENUM, "sym": sess["pEnumSym"], "typeParams": sess["pTypeParams"], "variants": sess["pVariants"] }
}

// --- parser_stmt_fn ---
pub fn parseStmt_fn(sess) {
    if !(sess["pCur"].type == TOKEN_FN) {
        return null
    }
    parseStmt_fn_sig(sess)
    parseStmt_fn_where(sess)
    return parseStmt_fn_body(sess)
}

// --- parser_stmt_iface ---
pub fn parseStmt_iface(sess) {
    if !(sess["pCur"].type == TOKEN_INTERFACE || sess["pCur"].type == TOKEN_TRAIT) {
        return null
    }
    bump(sess)
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != TOKEN_IDENT {
        throw "Expected interface/trait name"
    }
    bump(sess)
    sess["pIfaceSym"] = sess["pTok"].value
    sess["pTypeParams"] = pCallTypeArgs(sess)
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    sess["pIfaceMethods"] = []
    sess["pAssocTypes"] = []
    while sess["pCur"].type != "}" {
        let gotAssoc = parseStmt_iface_assoc(sess)
        if gotAssoc == 0 {
            parseStmt_iface_meth(sess)
        }
    }
    bump(sess)
    return {
        "kind": AST_INTERFACE,
        "sym": sess["pIfaceSym"],
        "typeParams": sess["pTypeParams"],
        "methods": sess["pIfaceMethods"],
        "associatedTypes": sess["pAssocTypes"]
    }
}

// --- parser_stmt_dispatch_ctrl ---
pub fn parseStmt_dispatch_ctrl(sess) {
    let r = parseStmt_if(sess)
    if r != null { return r }
    r = parseStmt_try(sess)
    if r != null { return r }
    r = parseStmt_for(sess)
    if r != null { return r }
    r = parseStmt_do(sess)
    if r != null { return r }
    r = parseStmt_while(sess)
    if r != null { return r }
    r = parseStmt_switch(sess)
    if r != null { return r }
    r = parseStmt_continue(sess)
    if r != null { return r }
    r = parseStmt_break(sess)
    if r != null { return r }
    r = parseStmt_fallthrough(sess)
    if r != null { return r }
    r = parseStmt_throw(sess)
    if r != null { return r }
    r = parseStmt_pass(sess)
    if r != null { return r }
    r = parseStmt_assert(sess)
    if r != null { return r }
    r = parseStmt_with(sess)
    if r != null { return r }
    r = parseStmt_return(sess)
    if r != null { return r }
    r = parseStmt_block(sess)
    if r != null { return r }
    r = parseStmt_lateAssign(sess)
    if r != null { return r }
    return parseStmt_expr(sess)
}

// --- parser_stmt_dispatch_decl ---
pub fn parseStmt_dispatch_decl(sess) {
    let r = parseStmt_let(sess)
    if r != null { return r }
    r = parseStmt_using(sess)
    if r != null { return r }
    r = parseStmt_earlyAssign(sess)
    if r != null { return r }
    r = parseStmt_enum(sess)
    if r != null { return r }
    r = parseStmt_class(sess)
    if r != null { return r }
    r = parseStmt_iface(sess)
    if r != null { return r }
    r = parseStmt_fn(sess)
    if r != null { return r }
    return null
}

// --- parser_stmt ---
pub fn parseStmt(sess) {
    if sess["pCur"].type == "EOF" {
        return null
    }
    sess["pIsPub"] = 0
    sess["pIsAsync"] = 0
    sess["pIsGen"] = 0
    if sess["pCur"].type == TOKEN_PUB {
        bump(sess)
        sess["pIsPub"] = 1
    }
    if sess["pCur"].type == TOKEN_ASYNC {
        let pos = sess["pPos"]
        let n = sess["pToksLen"]
        let nxt = sess["pEofTok"]
        if pos + 1 < n {
            nxt = sess["pToks"][pos + 1]
        }
        let nt = nxt.type
        if nt == TOKEN_FN {
            bump(sess)
            sess["pIsAsync"] = 1
            if sess["pCur"].type == TOKEN_PUB {
                bump(sess)
                sess["pIsPub"] = 1
            }
        } else {
            if nt == TOKEN_PUB {
                bump(sess)
                sess["pIsAsync"] = 1
                if sess["pCur"].type == TOKEN_PUB {
                    bump(sess)
                    sess["pIsPub"] = 1
                }
                if sess["pCur"].type != TOKEN_FN {
                    throw "`async` must be followed by `fn`"
                }
            } else {
                if nt != "(" {
                    if nt != TOKEN_IDENT {
                        throw "`async` must be followed by `fn`"
                    }
                }
            }
        }
    }
    let r = parseStmt_dispatch_decl(sess)
    if r != null {
        return r
    }
    return parseStmt_dispatch_ctrl(sess)
}
