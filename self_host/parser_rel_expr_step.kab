import "self_host/lexer_defs"
import "self_host/ast_defs"
import "self_host/parser_hooks"
import "self_host/parser_util"
import "self_host/parser_rel_expr_apply"

pub fn parseRelExpr_step(sess) {
    if !(sess["pCur"].type == "==" || sess["pCur"].type == "!=" || sess["pCur"].type == "<" || sess["pCur"].type == ">" || sess["pCur"].type == ">=" || sess["pCur"].type == "<=") {
        return 0
    }
    let op = sess["pCur"].type
    bump(sess)
    return parseRelExpr_apply(sess, op, sess["pLeft"])
}
