import "self_host/emit_defs"
import "self_host/emit_local_map"

pub fn emitMainInitCore(E, program) {
    E["eProgram"] = program
    E["eConsts"] = []
    E["eConstMap"] = {}
    E["eConstN"] = 0
    E["eOps"] = []
    E["eOpsN"] = 0
    E["eGlobals"] = []
    E["eGlobalMap"] = {}
    E["eGlobalN"] = 0
    E["eFunctions"] = []
    E["eFnOps"] = []
    E["eFnOpsN"] = 0
    E["eBlockDepth"] = 0
    E["eCalleeDepth"] = 0
    E["eCallArgDepth"] = 0
    E["eObjDepth"] = 0
    E["eArrDepth"] = 0
    E["eIfDepth"] = 0
    E["eMemberDepth"] = 0
    E["eIndexDepth"] = 0
    E["eFnGlobals"] = []
    E["eFnLocals"] = []
    resetLocalMap(E)
    E["eInFn"] = 0
}
