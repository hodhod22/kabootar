// .kbc text format constants (mirrors src/bytecode/types.rs).
import "self_host/lexer_defs"

pub let KBC_HEADER = "kabootar-bytecode/1"

// P6b: OP_* wire membership lives here (CI-fast defs) so skip-listed serialize_body
// does not carry ~600B string Const AST nodes through self-host leaf compile.
pub let IR_WITH_ARG = "|const|load_global|store_global|load_local|store_local|take_local|take_global|array_push_local|array_push_global|array_pop_local|array_pop_global|acc_add_local|acc_add_global|len_local|len_global|index_get_local|index_get_global|make_object|make_array|get_member|set_member|jump|jump_if_false|jump_if_true|call|jump_if_result_err|make_arrow_fn|"
pub let IR_ZERO_ARG = "|pop|add|sub|mul|div|mod|pow|neg|not|eq|ne|lt|gt|ge|le|and|or|bit_and|bit_or|bit_xor|shl|shr|ushr|bit_not|index_get|index_set|return|throw|iterator_step_in_place|make_ok|make_err|make_some|make_none|halt|"
