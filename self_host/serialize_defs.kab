// .kbc text format constants (mirrors src/bytecode/types.rs).
import "self_host/lexer_defs"
import "self_host/emit_defs"

pub let KBC_HEADER = "kabootar-bytecode/1"

// P6b: OP_* wire membership lives here (CI-fast defs) so skip-listed serialize_body
// does not carry ~600B string Const AST nodes through self-host leaf compile.
pub let IR_WITH_ARG = "|const|load_global|store_global|load_local|store_local|take_local|take_global|array_push_local|array_push_global|array_pop_local|array_pop_global|acc_add_local|acc_add_global|len_local|len_global|index_get_local|index_get_global|make_object|make_array|get_member|set_member|jump|jump_if_false|jump_if_true|call|jump_if_result_err|make_arrow_fn|"
pub let IR_ZERO_ARG = "|pop|add|sub|mul|div|mod|pow|neg|not|eq|ne|lt|gt|ge|le|and|or|bit_and|bit_or|bit_xor|shl|shr|ushr|bit_not|index_get|index_set|return|throw|iterator_step_in_place|make_ok|make_err|make_some|make_none|halt|"

// P6b: pure helpers live in defs (not skip-listed leaf AST). Bisect showed
// escStr/constLine/irOpLine each add ~10–16s to leaf self-host compile.

pub fn serEscStr(s) {
    let out = ""
    let i = 0
    let n = len(s)
    while i < n {
        let ch = char_at(s, i)
        let piece = ch
        if ch == "\\" {
            piece = "\\\\"
        }
        if ch == " " {
            piece = "\\s"
        }
        if ch == "\n" {
            piece = "\\n"
        }
        if ch == "\r" {
            piece = "\\r"
        }
        if ch == "\t" {
            piece = "\\t"
        }
        out = out + piece
        i = i + 1
    }
    return out
}

pub fn serConstLine(idx, val) {
    let line = "const "
    line = line + ("" + idx)
    line = line + " "
    if val == KAB_UNDEF_CONST {
        line = line + "undefined"
        return line
    }
    if val == null {
        line = line + "null"
        return line
    }
    if val == true {
        line = line + "bool true"
        return line
    }
    if val == false {
        line = line + "bool false"
        return line
    }
    if typeof(val) == "string" {
        line = line + "string "
        line = line + serEscStr(val)
        return line
    }
    line = line + "number "
    line = line + ("" + val)
    return line
}

pub fn serIrOpLine(op) {
    if op == null {
        throw "serialize: null op in IR"
    }
    let name = op.op
    if name == OP_NEW_INSTANCE {
        let line = OP_NEW_INSTANCE
        line = line + " "
        line = line + ("" + op.arg)
        line = line + " "
        let a2 = op.arg2
        if a2 == undefined {
            a2 = 0
        }
        line = line + ("" + a2)
        return line
    }
    if str_index_of(IR_WITH_ARG, "|" + name + "|") >= 0 {
        let line = name
        line = line + " "
        line = line + ("" + op.arg)
        return line
    }
    if str_index_of(IR_ZERO_ARG, "|" + name + "|") >= 0 {
        return name
    }
    throw "Unsupported IR op: " + name
}

pub fn serJoinComma(arr) {
    let params = ""
    let k = 0
    let n = len(arr)
    while k < n {
        if params == "" {
            params = arr[k]
        } else {
            params = params + ","
            params = params + arr[k]
        }
        k = k + 1
    }
    return params
}
