import "self_host/vm_s_ip"

pub fn runOpJumpNullish(S, name, arg, op, pool, globals, functions) {
    if name == "jump_if_not_nullish" {
        if len(S["stack"]) == 0 {
            throw "vm stack underflow"
        }
        let v = S["stack"][len(S["stack"]) - 1]
        if v != null && v != undefined {
            vAddIpS(S, 1 + arg)
            return 1
        }
        vBumpIpS(S)
        return 1
    }
    return 0
}
