// P6b: VM mem shard (array_push).
import "self_host/vm_s_push"
import "self_host/vm_s_pop"
import "self_host/vm_s_ip"

pub fn runOpMemArrayPush(S, name, arg, op, pool, globals, functions) {
    if name == "array_push" {
        let item = vPopS(S)
        let arr = vPopS(S)
        let next = push(arr, item)
        vPushS(S, next)
        vPushS(S, len(next))
        vBumpIpS(S)
        return 1
    }
    return 0
}
