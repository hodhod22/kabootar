// Test suite for the self-hosted Kabootar parser

import "self_host/lexer"
import "self_host/parser"
import "self_host/ast_defs"

let passed = 0
let fail = 0

fn assert_eq(a, b, msg) {
    if a == b {
        passed = passed + 1
    } else {
        fail = fail + 1
        println("FAIL: " + msg + " -- expected " + json_stringify(b) + ", got " + json_stringify(a))
    }
}

fn assert_kind(node, kind, msg) {
    assert_eq(node.kind, kind, msg)
}

// -- Literals and expressions --------------------------------------
{
    let ast = parseTokens(tokenize("1 + 2"))
    assert_kind(ast, AST_PROGRAM, "program root")
    assert_eq(len(ast.body), 1, "expr stmt count")
    let stmt = ast.body[0]
    assert_kind(stmt, AST_EXPR, "expr stmt kind")
    assert_kind(stmt.expr, AST_BINARY, "add binary")
    assert_eq(stmt.expr.op, "+", "add op")
    assert_kind(stmt.expr["left"], AST_LITERAL, "left literal")
    assert_eq(stmt.expr["left"].value, 1, "left value")
}

// -- let binding ---------------------------------------------------
{
    let ast = parseTokens(tokenize("let x = 42"))
    assert_eq(len(ast.body), 1, "let stmt count")
    let stmt = ast.body[0]
    assert_kind(stmt, AST_LET, "let stmt")
    assert_eq(stmt.sym, "x", "let sym")
    assert_kind(stmt.init, AST_LITERAL, "let init literal")
    assert_eq(stmt.init.value, 42, "let init value")
}

// -- assign --------------------------------------------------------
{
    let ast = parseTokens(tokenize("x = 10"))
    assert_kind(ast.body[0], AST_ASSIGN, "assign stmt")
    assert_eq(ast.body[0].sym, "x", "assign sym")
}

// -- return --------------------------------------------------------
{
    let ast = parseTokens(tokenize("return 1"))
    assert_kind(ast.body[0], AST_RETURN, "return stmt")
    assert_kind(ast.body[0].value, AST_LITERAL, "return value")
}

// -- call ----------------------------------------------------------
{
    let ast = parseTokens(tokenize("foo(1, 2)"))
    assert_kind(ast.body[0].expr, AST_CALL, "call expr")
    assert_kind(ast.body[0].expr.callee, AST_VAR, "call callee")
    assert_eq(ast.body[0].expr.callee.sym, "foo", "callee sym")
    assert_eq(len(ast.body[0].expr.args), 2, "call arg count")
}

// -- if / else -----------------------------------------------------
{
    let ast = parseTokens(tokenize("if x == 1 { return 0 } else { return 1 }"))
    assert_kind(ast.body[0], AST_IF, "if stmt")
    assert_kind(ast.body[0].cond, AST_BINARY, "if cond")
    assert_eq(ast.body[0].cond.op, "==", "if cond op")
    assert_kind(ast.body[0].then, AST_BLOCK, "if then")
    assert_kind(ast.body[0].elseBranch, AST_BLOCK, "if else")
}

// -- while ---------------------------------------------------------
{
    let ast = parseTokens(tokenize("while x == 0 { x = 1 }"))
    assert_kind(ast.body[0], AST_WHILE, "while stmt")
    assert_kind(ast.body[0].body, AST_BLOCK, "while body")
}

// -- while cond not clobbered by inner if --------------------------
{
    let ast = parseTokens(tokenize("while x == 0 { if y == 1 { y = 2 } }"))
    assert_kind(ast.body[0], AST_WHILE, "while with inner if")
    assert_kind(ast.body[0].cond, AST_BINARY, "while cond preserved")
    assert_eq(ast.body[0].cond.op, "==", "while cond op")
    assert_kind(ast.body[0].cond["left"], AST_VAR, "while cond lhs")
    assert_eq(ast.body[0].cond["left"].sym, "x", "while cond var")
}

// -- assign sym not clobbered by object key in rhs ----------------
{
    let ast = parseTokens(tokenize("tokens = push(tokens, { column: 1 })"))
    assert_kind(ast.body[0], AST_ASSIGN, "assign with object rhs")
    assert_eq(ast.body[0].sym, "tokens", "assign sym preserved")
}

// -- bracket index preserves object (not pLeft) --------------------
{
    let ast = parseTokens(tokenize("let kw = KEYWORDS[id]"))
    assert_kind(ast.body[0].init, AST_INDEX, "index expr")
    assert_kind(ast.body[0].init["object"], AST_VAR, "index object")
    assert_eq(ast.body[0].init["object"].sym, "KEYWORDS", "index object sym")
    assert_kind(ast.body[0].init["index"], AST_VAR, "index rhs")
    assert_eq(ast.body[0].init["index"].sym, "id", "index rhs sym")
}

// -- && preserves compare ops on both sides -----------------------
{
    let ast = parseTokens(tokenize("cd >= 65 && cd <= 90"))
    assert_kind(ast.body[0].expr, AST_BINARY, "and expr")
    assert_eq(ast.body[0].expr.op, "&&", "and op")
    assert_eq(ast.body[0].expr["left"].op, ">=", "lhs compare")
    assert_eq(ast.body[0].expr["right"].op, "<=", "rhs compare")
}

// -- compare rhs includes add/sub (len(stack) - 1) ----------------
{
    let ast = parseTokens(tokenize("while i < len(stack) - 1 { i = 1 }"))
    assert_kind(ast.body[0], AST_WHILE, "while with len-1 cond")
    assert_kind(ast.body[0].cond, AST_BINARY, "while cond binary")
    assert_eq(ast.body[0].cond.op, "<", "while cond op")
    assert_kind(ast.body[0].cond["right"], AST_BINARY, "rhs is subtraction")
    assert_eq(ast.body[0].cond["right"].op, "-", "rhs sub op")
}

// -- assign ident lookahead must not clobber expr stmt ------------
{
    let ast = parseTokens(tokenize("x = 1"))
    assert_kind(ast.body[0], AST_ASSIGN, "assign stmt")
    assert_eq(ast.body[0].sym, "x", "assign sym")
    let ast2 = parseTokens(tokenize("x"))
    assert_kind(ast2.body[0], AST_EXPR, "ident expr stmt")
    assert_kind(ast2.body[0].expr, AST_VAR, "ident expr var")
    assert_eq(ast2.body[0].expr.sym, "x", "ident expr sym")
}

// -- object key not clobbered by parseCompare rhs ------------------
{
    let ast = parseTokens(tokenize("push(a, { column: lxCol })"))
    assert_kind(ast.body[0].expr, AST_CALL, "call with object arg")
    let obj = ast.body[0].expr.args[1]
    assert_kind(obj, AST_OBJECT, "object arg")
    assert_eq(obj.fields[0].key, "column", "object key preserved")
}

// -- assign at EOF (peekAt(1) must not OOB) -----------------------
{
    let ast = parseTokens(tokenize("x"))
    assert_kind(ast.body[0].expr, AST_VAR, "ident at eof")
}

// -- fn ------------------------------------------------------------
{
    let ast = parseTokens(tokenize("fn add(a, b) { return a + b }"))
    assert_kind(ast.body[0], AST_FN, "fn stmt")
    assert_eq(ast.body[0].sym, "add", "fn sym")
    assert_eq(len(ast.body[0].params), 2, "fn param count")
}

// -- generic fn type params + annotations --------------------------
{
    let ast = parseTokens(tokenize("fn id<T>(x: T) -> T { return x }"))
    assert_kind(ast.body[0], AST_FN, "generic fn stmt")
    assert_eq(ast.body[0].sym, "id", "generic fn sym")
    assert_eq(len(ast.body[0].typeParams), 1, "type param count")
    assert_eq(ast.body[0].typeParams[0], "T", "type param name")
    assert_eq(len(ast.body[0].paramTypes), 1, "param type count")
    assert_eq(ast.body[0].paramTypes[0], "T", "param type ann")
    assert_eq(ast.body[0].returnType, "T", "return type")
}

// -- generic call explicit type args -------------------------------
{
    let ast = parseTokens(tokenize("id<Number>(42)"))
    assert_kind(ast.body[0].expr, AST_CALL, "generic call expr")
    assert_eq(len(ast.body[0].expr.typeArgs), 1, "call type arg count")
    assert_eq(ast.body[0].expr.typeArgs[0], "Number", "call type arg")
}

// -- generic call inferred (no typeArgs field clash with compare) --
{
    let ast = parseTokens(tokenize("id(42)"))
    assert_kind(ast.body[0].expr, AST_CALL, "inferred generic call")
    assert_eq(len(ast.body[0].expr.typeArgs), 0, "empty type args")
    let ast2 = parseTokens(tokenize("a < b"))
    assert_kind(ast2.body[0].expr, AST_BINARY, "compare not generic call")
    assert_eq(ast2.body[0].expr.op, "<", "compare op")
}

// -- pair two type params ------------------------------------------
{
    let ast = parseTokens(tokenize("fn pair<A, B>(a: A, b: B) -> Array { return [a, b] }"))
    assert_eq(len(ast.body[0].typeParams), 2, "two type params")
    assert_eq(ast.body[0].typeParams[1], "B", "second type param")
}

// -- generic enum type params ------------------------------------
{
    let src = "enum Option<T> { Some(T), None }"
    let ast = parseTokens(tokenize(src))
    assert_kind(ast.body[0], AST_ENUM, "generic enum stmt")
    assert_eq(ast.body[0].sym, "Option", "enum sym")
    assert_eq(len(ast.body[0].typeParams), 1, "enum type param count")
    assert_eq(ast.body[0].typeParams[0], "T", "enum type param")
    assert_eq(len(ast.body[0].variants), 2, "enum variant count")
    assert_eq(ast.body[0].variants[0].name, "Some", "Some variant")
}

// -- member type args Option<Number>.None --------------------------
{
    let ast = parseTokens(tokenize("Option<Number>.None"))
    assert_kind(ast.body[0].expr, AST_MEMBER, "typed enum member")
    assert_eq(len(ast.body[0].expr.typeArgs), 1, "member type arg count")
    assert_eq(ast.body[0].expr.typeArgs[0], "Number", "member type arg")
    assert_eq(ast.body[0].expr.field, "None", "None field")
}

// -- generic class type params (G8) --------------------------------
{
    let src = "class Box<T> { value: Number }"
    let ast = parseTokens(tokenize(src))
    assert_kind(ast.body[0], AST_CLASS, "generic class stmt")
    assert_eq(ast.body[0].sym, "Box", "class sym")
    assert_eq(len(ast.body[0].typeParams), 1, "class type param count")
    assert_eq(ast.body[0].typeParams[0], "T", "class type param")
}

// -- generic class method type params (G7) -------------------------
{
    let src = "class Holder { fn echo<T>(x) { return x } }"
    let ast = parseTokens(tokenize(src))
    assert_kind(ast.body[0], AST_CLASS, "class with generic method")
    assert_eq(len(ast.body[0].methods), 1, "one method")
    assert_eq(ast.body[0].methods[0].sym, "echo", "method sym")
    assert_eq(len(ast.body[0].methods[0].typeParams), 1, "method type param count")
    assert_eq(ast.body[0].methods[0].typeParams[0], "T", "method type param")
}

// -- struct + self (R4) --------------------------------------------
{
    let src = "struct Point { x: number; fn sum(self) { return self.x } }"
    let ast = parseTokens(tokenize(src))
    assert_kind(ast.body[0], AST_CLASS, "struct stmt")
    assert_eq(ast.body[0].isStruct, 1, "isStruct")
    assert_eq(ast.body[0].sym, "Point", "struct sym")
    assert_eq(len(ast.body[0].fields), 1, "struct field count")
    assert_eq(len(ast.body[0].methods), 1, "struct method count")
    assert_eq(ast.body[0].methods[0].params[0], "self", "self param")
}

// -- trait (T5) ----------------------------------------------------
{
    let src = "trait Show { fn show(); }"
    let ast = parseTokens(tokenize(src))
    assert_kind(ast.body[0], AST_INTERFACE, "trait stmt")
    assert_eq(ast.body[0].sym, "Show", "trait sym")
    assert_eq(len(ast.body[0].methods), 1, "trait method count")
}

// -- associated type in trait (T5 deepen) --------------------------
{
    let src = "trait Iter { type Item; fn next(); }"
    let ast = parseTokens(tokenize(src))
    assert_kind(ast.body[0], AST_INTERFACE, "trait with assoc type")
    assert_eq(len(ast.body[0].associatedTypes), 1, "assoc type count")
    assert_eq(ast.body[0].associatedTypes[0], "Item", "assoc type Item")
    assert_eq(len(ast.body[0].methods), 1, "trait method after assoc")
}

// -- where clause on fn (T5) ---------------------------------------
{
    let src = "fn id<T>(x) where T: Show { return x }"
    let ast = parseTokens(tokenize(src))
    assert_kind(ast.body[0], AST_FN, "fn with where")
    assert_eq(len(ast.body[0].whereClause), 1, "where count")
    assert_eq(ast.body[0].whereClause[0].typeParam, "T", "where type param")
    assert_eq(ast.body[0].whereClause[0].traitName, "Show", "where trait")
}

// -- block ---------------------------------------------------------
{
    let ast = parseTokens(tokenize("{ let a = 1; return a }"))
    assert_kind(ast.body[0], AST_BLOCK, "block stmt")
    assert_eq(len(ast.body[0].body), 2, "block stmt count")
}

// -- multi-statement program ---------------------------------------
{
    let ast = parseTokens(tokenize("let x = 1; let y = 2; x + y"))
    assert_eq(len(ast.body), 3, "multi stmt count")
}

// -- let x = 1 program (EOF must not become expr stmt) --------------
{
    let ast = parseTokens(tokenize("let x = 1"))
    assert_kind(ast, AST_PROGRAM, "let program root")
    assert_eq(len(ast.body), 1, "let program one stmt")
    assert_kind(ast.body[0], AST_LET, "let program stmt")
    assert_eq(ast.body[0].sym, "x", "let program sym")
}

// -- Report --------------------------------------------------------
println("")
println("Self-hosted parser tests: " + ("" + passed) + " passed, " + ("" + fail) + " failed")
if fail > 0 {
    throw "PARSER TESTS FAILED"
}
