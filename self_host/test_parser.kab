// Test suite for the self-hosted Kabootar parser

import "self_host/lexer"
import "self_host/parser"
import "self_host/ast_defs"

let passed = 0
let fail = 0

fn assert_eq(a, b, msg) {
    if a == b {
        passed = passed + 1
    } else {
        fail = fail + 1
        println("FAIL: " + msg + " -- expected " + json_stringify(b) + ", got " + json_stringify(a))
    }
}

fn assert_kind(node, kind, msg) {
    assert_eq(node.kind, kind, msg)
}

// -- Literals and expressions --------------------------------------
{
    let ast = parseTokens(tokenize("1 + 2"))
    assert_kind(ast, AST_PROGRAM, "program root")
    assert_eq(len(ast.body), 1, "expr stmt count")
    let stmt = ast.body[0]
    assert_kind(stmt, AST_EXPR, "expr stmt kind")
    assert_kind(stmt.expr, AST_BINARY, "add binary")
    assert_eq(stmt.expr.op, "+", "add op")
    assert_kind(stmt.expr["left"], AST_LITERAL, "left literal")
    assert_eq(stmt.expr["left"].value, 1, "left value")
}

// -- let binding ---------------------------------------------------
{
    let ast = parseTokens(tokenize("let x = 42"))
    assert_eq(len(ast.body), 1, "let stmt count")
    let stmt = ast.body[0]
    assert_kind(stmt, AST_LET, "let stmt")
    assert_eq(stmt.sym, "x", "let sym")
    assert_kind(stmt.init, AST_LITERAL, "let init literal")
    assert_eq(stmt.init.value, 42, "let init value")
}

// -- assign --------------------------------------------------------
{
    let ast = parseTokens(tokenize("x = 10"))
    assert_kind(ast.body[0], AST_ASSIGN, "assign stmt")
    assert_eq(ast.body[0].sym, "x", "assign sym")
}

// -- return --------------------------------------------------------
{
    let ast = parseTokens(tokenize("return 1"))
    assert_kind(ast.body[0], AST_RETURN, "return stmt")
    assert_kind(ast.body[0].value, AST_LITERAL, "return value")
}

// -- call ----------------------------------------------------------
{
    let ast = parseTokens(tokenize("foo(1, 2)"))
    assert_kind(ast.body[0].expr, AST_CALL, "call expr")
    assert_kind(ast.body[0].expr.callee, AST_VAR, "call callee")
    assert_eq(ast.body[0].expr.callee.sym, "foo", "callee sym")
    assert_eq(len(ast.body[0].expr.args), 2, "call arg count")
}

// -- if / else -----------------------------------------------------
{
    let ast = parseTokens(tokenize("if x == 1 { return 0 } else { return 1 }"))
    assert_kind(ast.body[0], AST_IF, "if stmt")
    assert_kind(ast.body[0].cond, AST_BINARY, "if cond")
    assert_eq(ast.body[0].cond.op, "==", "if cond op")
    assert_kind(ast.body[0].then, AST_BLOCK, "if then")
    assert_kind(ast.body[0].elseBranch, AST_BLOCK, "if else")
}

// -- while ---------------------------------------------------------
{
    let ast = parseTokens(tokenize("while x == 0 { x = 1 }"))
    assert_kind(ast.body[0], AST_WHILE, "while stmt")
    assert_kind(ast.body[0].body, AST_BLOCK, "while body")
}

// -- fn ------------------------------------------------------------
{
    let ast = parseTokens(tokenize("fn add(a, b) { return a + b }"))
    assert_kind(ast.body[0], AST_FN, "fn stmt")
    assert_eq(ast.body[0].sym, "add", "fn sym")
    assert_eq(len(ast.body[0].params), 2, "fn param count")
}

// -- block ---------------------------------------------------------
{
    let ast = parseTokens(tokenize("{ let a = 1; return a }"))
    assert_kind(ast.body[0], AST_BLOCK, "block stmt")
    assert_eq(len(ast.body[0].body), 2, "block stmt count")
}

// -- multi-statement program ---------------------------------------
{
    let ast = parseTokens(tokenize("let x = 1; let y = 2; x + y"))
    assert_eq(len(ast.body), 3, "multi stmt count")
}

// -- Report --------------------------------------------------------
println("")
println("Self-hosted parser tests: " + ("" + passed) + " passed, " + ("" + fail) + " failed")
if fail > 0 {
    throw "PARSER TESTS FAILED"
}
