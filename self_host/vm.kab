// H6e: Kabootar bytecode VM subset (stack interpreter on self_host IR).
// import "self_host/vm"

import "self_host/emit_defs"

let vStack = []
let vLocals = []
let vGlobals = []
let vClasses = []
let vArrows = []
let vTryRegions = []
let vLocalNames = []
let vThisStack = []
let vLastThis = null
let vNextInstId = 1
let vIp = 0
let vDone = false
let vResult = null
let vUnsupported = false

fn vPush(v) {
    vStack = push(vStack, v)
}

fn vPop() {
    if len(vStack) == 0 {
        throw "vm stack underflow"
    }
    let top = vStack[len(vStack) - 1]
    vStack = pop(vStack)
    return top
}

fn vTruthy(v) {
    if v == false || v == null || v == undefined {
        return false
    }
    return true
}

fn poolVal(pool, idx) {
    if idx < 0 || idx >= len(pool) {
        throw "vm bad const index"
    }
    let v = pool[idx]
    if v == KAB_UNDEF_CONST {
        return undefined
    }
    return v
}

fn poolKey(pool, idx) {
    let k = poolVal(pool, idx)
    if k == null || k == undefined {
        return ""
    }
    return "" + k
}

fn vThis() {
    if len(vThisStack) == 0 {
        return undefined
    }
    return vThisStack[len(vThisStack) - 1]
}

fn vWriteThis(updated) {
    if len(vThisStack) == 0 {
        return
    }
    vThisStack = pop(vThisStack)
    vThisStack = push(vThisStack, updated)
}

fn vIsCurrentThis(obj) {
    if obj == null || obj == undefined {
        return false
    }
    if len(vThisStack) == 0 {
        return false
    }
    let cur = vThisStack[len(vThisStack) - 1]
    if cur == null || cur == undefined {
        return false
    }
    if typeof(obj) != "object" || typeof(cur) != "object" {
        return false
    }
    if obj["vmI"] == undefined || cur["vmI"] == undefined {
        return false
    }
    return obj["vmI"] == cur["vmI"]
}

fn vFindMethod(classDef, name) {
    let methods = classDef["methods"]
    let i = 0
    while i < len(methods) {
        if methods[i]["sym"] == name {
            return methods[i]
        }
        i = i + 1
    }
    return null
}

fn vMemberGet(obj, key) {
    if obj == null || obj == undefined {
        return undefined
    }
    if typeof(obj) == "object" {
        if obj["vmC"] != undefined {
            if object_has_own(obj, key) {
                return obj[key]
            }
            let ci = obj["vmC"]
            let meth = vFindMethod(vClasses[ci], key)
            if meth != null {
                return { "vmM": meth, "vmR": obj }
            }
            return undefined
        }
    }
    return obj[key]
}

fn vMemberSet(obj, key, val) {
    if obj == null || obj == undefined {
        throw "vm cannot set member on nullish"
    }
    obj[key] = val
    return obj
}

fn vIndexGet(container, idx) {
    if container == null || container == undefined {
        return undefined
    }
    return container[idx]
}

fn vIndexSet(container, idx, val) {
    if container == null || container == undefined {
        throw "vm cannot index nullish"
    }
    container[idx] = val
    return container
}

fn vResolveGlobal(globals, idx) {
    let name = globals[idx]
    if name == "this" || name == "self" {
        return vThis()
    }
    let cur = vGlobals[idx]
    if cur != undefined {
        return cur
    }
    if name == null || name == undefined {
        return undefined
    }
    let host = bytecode_host_get("" + name)
    if host != undefined {
        vGlobals[idx] = host
    }
    return host
}

fn vCallHost(callee, ordered) {
    return bytecode_host_call(callee, ordered)
}

/// Safe map probe — BytecodeFn/native are typeof object but reject string index.
fn vObjGet(obj, key) {
    return bytecode_host_map_get(obj, key)
}

fn vFindTry(regions, ip) {
    if regions == null || regions == undefined {
        return null
    }
    let best = null
    let bi = 0
    while bi < len(regions) {
        let r = regions[bi]
        if ip >= r["bodyStart"] && ip <= r["bodyEnd"] {
            if best == null || r["bodyStart"] >= best["bodyStart"] {
                best = r
            }
        }
        bi = bi + 1
    }
    return best
}

fn vSnapCaps() {
    let caps = {}
    let i = 0
    while i < len(vLocalNames) {
        if i < len(vLocals) {
            caps[vLocalNames[i]] = vLocals[i]
        }
        i = i + 1
    }
    return caps
}

fn runFnBody(fnDef, pool, globals, functions, callArgs, caps) {
    let oldStack = vStack
    let oldLocals = vLocals
    let oldNames = vLocalNames
    let oldTry = vTryRegions
    let oldIp = vIp
    let oldDone = vDone
    let oldResult = vResult
    let oldUnsupported = vUnsupported

    vStack = []
    vLocals = []
    vLocalNames = fnDef["locals"]
    if vLocalNames == undefined {
        vLocalNames = []
    }
    let tr = fnDef["tryRegions"]
    if tr == undefined {
        tr = []
    }
    vTryRegions = tr
    let li = 0
    while li < len(fnDef["locals"]) {
        vLocals = push(vLocals, undefined)
        li = li + 1
    }
    let pi = 0
    while pi < len(fnDef["params"]) {
        if pi < len(callArgs) {
            vLocals[pi] = callArgs[pi]
        }
        pi = pi + 1
    }
    if caps != null && caps != undefined {
        let ci = len(fnDef["params"])
        while ci < len(fnDef["locals"]) {
            let nm = fnDef["locals"][ci]
            if caps[nm] != undefined {
                vLocals[ci] = caps[nm]
            }
            ci = ci + 1
        }
    }
    vIp = 0
    vDone = false
    vResult = null
    vUnsupported = false

    runOps(fnDef["ops"], pool, globals, functions)

    let out = vResult
    if vDone == false {
        if len(vStack) > 0 {
            out = vStack[len(vStack) - 1]
        }
    }

    vStack = oldStack
    vLocals = oldLocals
    vLocalNames = oldNames
    vTryRegions = oldTry
    vIp = oldIp
    vDone = oldDone
    vResult = oldResult
    vUnsupported = oldUnsupported
    if vUnsupported {
        throw "vm unsupported opcode in fn"
    }
    return out
}

fn runMethodBody(meth, pool, globals, functions, recv, callArgs) {
    vThisStack = push(vThisStack, recv)
    let out = null
    let err = null
    try {
        out = runFnBody(meth, pool, globals, functions, callArgs, null)
    } catch (e) {
        err = e
    }
    vLastThis = vThisStack[len(vThisStack) - 1]
    vThisStack = pop(vThisStack)
    if err != null {
        throw err
    }
    return out
}

fn vNewInstance(classIdx, argc, pool, globals, functions) {
    if classIdx < 0 || classIdx >= len(vClasses) {
        throw "vm bad class index"
    }
    let classDef = vClasses[classIdx]
    let raw = []
    let ai = 0
    while ai < argc {
        raw = push(raw, vPop())
        ai = ai + 1
    }
    let ordered = []
    let oi = argc - 1
    while oi >= 0 {
        ordered = push(ordered, raw[oi])
        oi = oi - 1
    }
    let id = vNextInstId
    vNextInstId = vNextInstId + 1
    let inst = { "vmC": classIdx, "vmI": id }
    let init = vFindMethod(classDef, "init")
    if init == null {
        init = vFindMethod(classDef, "constructor")
    }
    if init != null {
        vLastThis = inst
        runMethodBody(init, pool, globals, functions, inst, ordered)
        if vLastThis != null {
            inst = vLastThis
        }
    } else {
        if argc > 0 {
            throw "vm class has no init: " + classDef["sym"]
        }
    }
    return inst
}

/// Dispatch helper for runOps (Mem). Returns 0=miss, 1=continue, 2=break.
fn runOpMem(name, arg, op, pool, globals, functions) {
    if name == OP_CONST {
        vPush(poolVal(pool, arg))
        vIp = vIp + 1
        return 1
    }
    if name == OP_LOAD_LOCAL {
        vPush(vLocals[arg])
        vIp = vIp + 1
        return 1
    }
    if name == OP_STORE_LOCAL {
        let v = vPop()
        vLocals[arg] = v
        vIp = vIp + 1
        return 1
    }
    if name == OP_LOAD_GLOBAL {
        vPush(vResolveGlobal(globals, arg))
        vIp = vIp + 1
        return 1
    }
    if name == OP_STORE_GLOBAL {
        let gname = globals[arg]
        let gv = vPop()
        if gname == "this" || gname == "self" {
            // ignore writes to this/self binding
        } else {
            vGlobals[arg] = gv
        }
        vIp = vIp + 1
        return 1
    }
    if name == "array_push" {
        let item = vPop()
        let arr = vPop()
        let next = push(arr, item)
        vPush(next)
        vPush(len(next))
        vIp = vIp + 1
        return 1
    }
    if name == "take_local" {
        // Move binding onto stack (host ArrayPush path expects taken array under item).
        let arr = vLocals[arg]
        vLocals[arg] = undefined
        vPush(arr)
        vIp = vIp + 1
        return 1
    }
    if name == "take_global" {
        let arr = vResolveGlobal(globals, arg)
        vGlobals[arg] = undefined
        vPush(arr)
        vIp = vIp + 1
        return 1
    }
    if name == "array_push_local" {
        // Prefer host O(1) path when available (bytecode_array_push); else push().
        let item = vPop()
        let arr = vPop()
        let next = bytecode_array_push(arr, item)
        vLocals[arg] = next
        vPush(len(next))
        vIp = vIp + 1
        return 1
    }
    if name == "array_push_global" {
        let item = vPop()
        let arr = vPop()
        let next = bytecode_array_push(arr, item)
        vGlobals[arg] = next
        vPush(len(next))
        vIp = vIp + 1
        return 1
    }
    if name == "array_pop_local" {
        let arr = vLocals[arg]
        vLocals[arg] = pop(arr)
        vPush(null)
        vIp = vIp + 1
        return 1
    }
    if name == "array_pop_global" {
        let arr = vResolveGlobal(globals, arg)
        vGlobals[arg] = pop(arr)
        vPush(null)
        vIp = vIp + 1
        return 1
    }
    if name == "acc_add_local" {
        let rhs = vPop()
        vLocals[arg] = vLocals[arg] + rhs
        vIp = vIp + 1
        return 1
    }
    if name == "acc_add_global" {
        let rhs = vPop()
        let cur = vResolveGlobal(globals, arg)
        vGlobals[arg] = cur + rhs
        vIp = vIp + 1
        return 1
    }
    if name == OP_POP {
        vPop()
        vIp = vIp + 1
        return 1
    }
    return 0
}

/// Dispatch helper for runOps (Arith). Returns 0=miss, 1=continue, 2=break.
fn runOpArith(name, arg, op, pool, globals, functions) {
    if name == OP_ADD {
        let b = vPop()
        let a = vPop()
        vPush(a + b)
        vIp = vIp + 1
        return 1
    }
    if name == OP_SUB {
        let b = vPop()
        let a = vPop()
        vPush(a - b)
        vIp = vIp + 1
        return 1
    }
    if name == OP_MUL {
        let b = vPop()
        let a = vPop()
        vPush(a * b)
        vIp = vIp + 1
        return 1
    }
    if name == OP_DIV {
        let b = vPop()
        let a = vPop()
        vPush(a / b)
        vIp = vIp + 1
        return 1
    }
    if name == OP_MOD {
        let b = vPop()
        let a = vPop()
        vPush(a % b)
        vIp = vIp + 1
        return 1
    }
    if name == OP_POW {
        let b = vPop()
        let a = vPop()
        vPush(a ** b)
        vIp = vIp + 1
        return 1
    }
    if name == OP_NEG {
        let v = vPop()
        vPush(0 - v)
        vIp = vIp + 1
        return 1
    }
    if name == "bit_and" {
        let b = vPop()
        let a = vPop()
        vPush(a & b)
        vIp = vIp + 1
        return 1
    }
    if name == "bit_or" {
        let b = vPop()
        let a = vPop()
        vPush(a | b)
        vIp = vIp + 1
        return 1
    }
    if name == "bit_xor" {
        let b = vPop()
        let a = vPop()
        vPush(a ^ b)
        vIp = vIp + 1
        return 1
    }
    if name == "shl" {
        let b = vPop()
        let a = vPop()
        vPush(a << b)
        vIp = vIp + 1
        return 1
    }
    if name == "shr" {
        let b = vPop()
        let a = vPop()
        vPush(a >> b)
        vIp = vIp + 1
        return 1
    }
    if name == "ushr" {
        let b = vPop()
        let a = vPop()
        vPush(a >>> b)
        vIp = vIp + 1
        return 1
    }
    if name == "bit_not" {
        let v = vPop()
        vPush(~v)
        vIp = vIp + 1
        return 1
    }
    return 0
}

/// Dispatch helper for runOps (CmpLogic). Returns 0=miss, 1=continue, 2=break.
fn runOpCmp(name, arg, op, pool, globals, functions) {
    if name == OP_EQ {
        let b = vPop()
        let a = vPop()
        vPush(a == b)
        vIp = vIp + 1
        return 1
    }
    if name == OP_NE {
        let b = vPop()
        let a = vPop()
        vPush(a != b)
        vIp = vIp + 1
        return 1
    }
    if name == OP_LT {
        let b = vPop()
        let a = vPop()
        vPush(a < b)
        vIp = vIp + 1
        return 1
    }
    if name == OP_GT {
        let b = vPop()
        let a = vPop()
        vPush(a > b)
        vIp = vIp + 1
        return 1
    }
    if name == OP_LE {
        let b = vPop()
        let a = vPop()
        vPush(a <= b)
        vIp = vIp + 1
        return 1
    }
    if name == OP_GE {
        let b = vPop()
        let a = vPop()
        vPush(a >= b)
        vIp = vIp + 1
        return 1
    }
    if name == OP_AND {
        let b = vPop()
        let a = vPop()
        if vTruthy(a) {
            vPush(b)
        } else {
            vPush(a)
        }
        vIp = vIp + 1
        return 1
    }
    if name == OP_OR {
        let b = vPop()
        let a = vPop()
        if vTruthy(a) {
            vPush(a)
        } else {
            vPush(b)
        }
        vIp = vIp + 1
        return 1
    }
    if name == OP_NOT {
        let v = vPop()
        vPush(!vTruthy(v))
        vIp = vIp + 1
        return 1
    }
    if name == OP_GET_MEMBER {
        let key = poolKey(pool, arg)
        let obj = vPop()
        vPush(vMemberGet(obj, key))
        vIp = vIp + 1
        return 1
    }
    if name == OP_NEW_INSTANCE {
        let argc = op["arg2"]
        if argc == undefined {
            argc = 0
        }
        vPush(vNewInstance(arg, argc, pool, globals, functions))
        vIp = vIp + 1
        return 1
    }
    return 0
}

/// Dispatch helper for runOps (Data). Returns 0=miss, 1=continue, 2=break.
fn runOpData(name, arg, op, pool, globals, functions) {
    if name == OP_MAKE_OBJECT {
        let n = arg
        let map = {}
        let ci = 0
        while ci < n {
            let key = vPop()
            let val = vPop()
            map["" + key] = val
            ci = ci + 1
        }
        vPush(map)
        vIp = vIp + 1
        return 1
    }
    if name == OP_MAKE_ARRAY {
        let n = arg
        let raw = []
        let ai = 0
        while ai < n {
            raw = push(raw, vPop())
            ai = ai + 1
        }
        let arr = []
        let oi = n - 1
        while oi >= 0 {
            arr = push(arr, raw[oi])
            oi = oi - 1
        }
        vPush(arr)
        vIp = vIp + 1
        return 1
    }
    if name == OP_INDEX_GET {
        let idx = vPop()
        let container = vPop()
        vPush(vIndexGet(container, idx))
        vIp = vIp + 1
        return 1
    }
    if name == OP_INDEX_SET {
        let val = vPop()
        let idx = vPop()
        let container = vPop()
        let asThis = vIsCurrentThis(container)
        let updated = vIndexSet(container, idx, val)
        if asThis {
            vWriteThis(updated)
        }
        vPush(updated)
        vPush(val)
        vIp = vIp + 1
        return 1
    }
    if name == OP_SET_MEMBER {
        let key = poolKey(pool, arg)
        let val = vPop()
        let obj = vPop()
        let asThis = vIsCurrentThis(obj)
        let updated = vMemberSet(obj, key, val)
        if asThis {
            vWriteThis(updated)
        }
        vPush(updated)
        vPush(val)
        vIp = vIp + 1
        return 1
    }
    if name == "dup" {
        if len(vStack) == 0 {
            throw "vm stack underflow"
        }
        vPush(vStack[len(vStack) - 1])
        vIp = vIp + 1
        return 1
    }
    if name == "swap" {
        let a = vPop()
        let b = vPop()
        vPush(a)
        vPush(b)
        vIp = vIp + 1
        return 1
    }
    if name == "get_length" {
        let v = vPop()
        vPush(len(v))
        vIp = vIp + 1
        return 1
    }
    if name == "concat_array" {
        let right = vPop()
        let left = vPop()
        let out = left
        let ci = 0
        while ci < len(right) {
            out = push(out, right[ci])
            ci = ci + 1
        }
        vPush(out)
        vIp = vIp + 1
        return 1
    }
    if name == "merge_object" {
        let right = vPop()
        let left = vPop()
        let keys = object_keys(right)
        let ki = 0
        while ki < len(keys) {
            let k = keys[ki]
            left[k] = right[k]
            ki = ki + 1
        }
        vPush(left)
        vIp = vIp + 1
        return 1
    }
    if name == "make_ok" {
        vPush({ "vmResult": "ok", "v": vPop() })
        vIp = vIp + 1
        return 1
    }
    if name == "make_err" {
        vPush({ "vmResult": "err", "v": vPop() })
        vIp = vIp + 1
        return 1
    }
    if name == "make_some" {
        vPush({ "vmOption": "some", "v": vPop() })
        vIp = vIp + 1
        return 1
    }
    if name == "make_none" {
        vPush({ "vmOption": "none" })
        vIp = vIp + 1
        return 1
    }
    if name == "make_arrow_fn" {
        vPush({ "vmArrow": arg, "caps": vSnapCaps() })
        vIp = vIp + 1
        return 1
    }
    if name == "iterator_step_in_place" {
        let it = vPop()
        let pair = bytecode_iterator_step_in_place(it)
        vPush(pair[0])
        vPush(pair[1])
        vIp = vIp + 1
        return 1
    }
    return 0
}

/// Dispatch helper for runOps (Jump). Returns 0=miss, 1=continue, 2=break.
fn runOpJump(name, arg, op, pool, globals, functions) {
    if name == OP_JUMP {
        vIp = vIp + 1 + arg
        return 1
    }
    if name == OP_JUMP_IF_FALSE {
        let v = vPop()
        if !vTruthy(v) {
            vIp = vIp + 1 + arg
            return 1
        }
        vIp = vIp + 1
        return 1
    }
    if name == OP_JUMP_IF_TRUE {
        let v = vPop()
        if vTruthy(v) {
            vIp = vIp + 1 + arg
            return 1
        }
        vIp = vIp + 1
        return 1
    }
    if name == "jump_if_not_nullish" {
        if len(vStack) == 0 {
            throw "vm stack underflow"
        }
        let v = vStack[len(vStack) - 1]
        if v != null && v != undefined {
            vIp = vIp + 1 + arg
            return 1
        }
        vIp = vIp + 1
        return 1
    }
    if name == "jump_if_result_err" {
        let v = vPop()
        if typeof(v) == "object" && v != null && v["vmResult"] == "err" {
            vPush(v["v"])
            vIp = vIp + 1 + arg
            return 1
        }
        if typeof(v) == "object" && v != null && v["vmResult"] == "ok" {
            vPush(v["v"])
        } else {
            vPush(v)
        }
        vIp = vIp + 1
        return 1
    }
    return 0
}

/// Dispatch helper for runOps (Call). Returns 0=miss, 1=continue, 2=break.
fn runOpCall(name, arg, op, pool, globals, functions) {
    if name == "call_from_array" {
        let argsArr = vPop()
        let callee = vPop()
        let ordered = []
        let ai = 0
        while ai < len(argsArr) {
            ordered = push(ordered, argsArr[ai])
            ai = ai + 1
        }
        let vmFn = vObjGet(callee, "vmFn")
        let vmM = vObjGet(callee, "vmM")
        let vmArrow = vObjGet(callee, "vmArrow")
        if vmFn != undefined {
            vPush(runFnBody(functions[vmFn], pool, globals, functions, ordered, null))
        } else if vmArrow != undefined {
            vPush(runFnBody(vArrows[vmArrow], pool, globals, functions, ordered, vObjGet(callee, "caps")))
        } else if vmM != undefined {
            vPush(runMethodBody(vmM, pool, globals, functions, vObjGet(callee, "vmR"), ordered))
        } else {
            vPush(vCallHost(callee, ordered))
        }
        vIp = vIp + 1
        return 1
    }
    if name == OP_CALL {
        let argc = arg
        let callee = vPop()
        let rawArgs = []
        let ai = 0
        while ai < argc {
            rawArgs = push(rawArgs, vPop())
            ai = ai + 1
        }
        if callee == null || callee == undefined {
            vUnsupported = true
            return 2
        }
        let ordered = []
        let oi = argc - 1
        while oi >= 0 {
            ordered = push(ordered, rawArgs[oi])
            oi = oi - 1
        }
        let vmFn = vObjGet(callee, "vmFn")
        let vmM = vObjGet(callee, "vmM")
        let vmArrow = vObjGet(callee, "vmArrow")
        if vmFn != undefined {
            vPush(runFnBody(functions[vmFn], pool, globals, functions, ordered, null))
        } else if vmArrow != undefined {
            vPush(runFnBody(vArrows[vmArrow], pool, globals, functions, ordered, vObjGet(callee, "caps")))
        } else if vmM != undefined {
            vPush(runMethodBody(vmM, pool, globals, functions, vObjGet(callee, "vmR"), ordered))
        } else {
            vPush(vCallHost(callee, ordered))
        }
        vIp = vIp + 1
        return 1
    }
    return 0
}

/// Dispatch helper for runOps (Ctrl). Returns 0=miss, 1=continue, 2=break.
fn runOpCtrl(name, arg, op, pool, globals, functions) {
    if name == OP_THROW {
        let reason = null
        if len(vStack) > 0 {
            reason = vPop()
        }
        let region = vFindTry(vTryRegions, vIp)
        if region != null {
            let el = region["errLocal"]
            while len(vLocals) <= el {
                vLocals = push(vLocals, undefined)
            }
            vLocals[el] = reason
            vPush(reason)
            vIp = region["catchStart"]
            return 1
        }
        throw reason
    }
    if name == OP_RETURN {
        if len(vStack) > 0 {
            vResult = vStack[len(vStack) - 1]
        } else {
            vResult = null
        }
        vDone = true
        return 2
    }
    if name == OP_HALT {
        if len(vStack) > 0 {
            vResult = vStack[len(vStack) - 1]
        }
        vDone = true
        return 2
    }
    return 0
}
fn runOps(ops, pool, globals, functions) {
    while vIp < len(ops) && vDone == false && vUnsupported == false {
        let op = ops[vIp]
        let name = op["op"]
        let arg = op["arg"]
        let st = runOpMem(name, arg, op, pool, globals, functions)
        if st == 0 {
            st = runOpArith(name, arg, op, pool, globals, functions)
        }
        if st == 0 {
            st = runOpCmp(name, arg, op, pool, globals, functions)
        }
        if st == 0 {
            st = runOpData(name, arg, op, pool, globals, functions)
        }
        if st == 0 {
            st = runOpJump(name, arg, op, pool, globals, functions)
        }
        if st == 0 {
            st = runOpCall(name, arg, op, pool, globals, functions)
        }
        if st == 0 {
            st = runOpCtrl(name, arg, op, pool, globals, functions)
        }
        if st == 2 {
            break
        }
        if st == 0 {
            throw "vm unsupported opcode: " + name
        }
    }
}
pub fn runModule(bc) {
    if bc == null || bc == undefined {
        throw "vm: null module"
    }
    let pool = bc["constants"]
    let globals = bc["globals"]
    let functions = bc["functions"]
    let classes = bc["classes"]
    let imports = bc["imports"]
    let arrows = bc["arrows"]
    let tryRegions = bc["tryRegions"]
    let localNames = bc["locals"]
    if pool == null || pool == undefined {
        pool = []
    }
    if globals == null || globals == undefined {
        globals = []
    }
    if functions == null || functions == undefined {
        functions = []
    }
    if classes == null || classes == undefined {
        classes = []
    }
    if imports == null || imports == undefined {
        imports = []
    }
    if arrows == null || arrows == undefined {
        arrows = []
    }
    if tryRegions == null || tryRegions == undefined {
        tryRegions = []
    }
    if localNames == null || localNames == undefined {
        localNames = []
    }
    // Reentrancy: nested runModule (imports / host calls) must not clobber frames.
    let oldStack = vStack
    let oldLocals = vLocals
    let oldGlobals = vGlobals
    let oldClasses = vClasses
    let oldArrows = vArrows
    let oldTry = vTryRegions
    let oldNames = vLocalNames
    let oldThis = vThisStack
    let oldLastThis = vLastThis
    let oldIp = vIp
    let oldDone = vDone
    let oldResult = vResult
    let oldUnsupported = vUnsupported

    vGlobals = []
    let gi = 0
    while gi < len(globals) {
        vGlobals = push(vGlobals, undefined)
        gi = gi + 1
    }
    let ii = 0
    while ii < len(imports) {
        let pairs = bytecode_host_import("" + imports[ii])
        if pairs != null && pairs != undefined {
            let pi = 0
            while pi < len(pairs) {
                let pair = pairs[pi]
                let en = pair[0]
                let host = pair[1]
                let gi3 = 0
                while gi3 < len(globals) {
                    if globals[gi3] == en {
                        vGlobals[gi3] = host
                    }
                    gi3 = gi3 + 1
                }
                pi = pi + 1
            }
        }
        ii = ii + 1
    }
    vClasses = classes
    vArrows = arrows
    vTryRegions = tryRegions
    vLocalNames = localNames
    let fi = 0
    while fi < len(functions) {
        let sym = functions[fi]["sym"]
        let gi2 = 0
        while gi2 < len(globals) {
            if globals[gi2] == sym {
                vGlobals[gi2] = { "vmFn": fi }
            }
            gi2 = gi2 + 1
        }
        fi = fi + 1
    }
    vStack = []
    vLocals = []
    let li = 0
    while li < len(localNames) {
        vLocals = push(vLocals, undefined)
        li = li + 1
    }
    vThisStack = []
    vLastThis = null
    vIp = 0
    vDone = false
    vResult = null
    vUnsupported = false
    let ops = bc["ops"]
    if ops == null || ops == undefined {
        ops = []
    }
    let fillI = 0
    while fillI < len(globals) {
        if vGlobals[fillI] == undefined {
            let fillH = bytecode_host_get("" + globals[fillI])
            if fillH != undefined {
                vGlobals[fillI] = fillH
            }
        }
        fillI = fillI + 1
    }
    runOps(ops, pool, globals, functions)
    let out = vResult
    let unsupported = vUnsupported
    let done = vDone
    if done == false {
        if len(vStack) > 0 {
            out = vStack[len(vStack) - 1]
        }
    }
    vStack = oldStack
    vLocals = oldLocals
    vGlobals = oldGlobals
    vClasses = oldClasses
    vArrows = oldArrows
    vTryRegions = oldTry
    vLocalNames = oldNames
    vThisStack = oldThis
    vLastThis = oldLastThis
    vIp = oldIp
    vDone = oldDone
    vResult = oldResult
    vUnsupported = oldUnsupported
    if unsupported {
        throw "vm unsupported opcode in main"
    }
    return out
}
