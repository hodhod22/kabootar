// H6e: Kabootar bytecode VM subset (stack interpreter on self_host IR).
// import "self_host/vm"

import "self_host/emit_defs"

let vStack = []
let vLocals = []
let vGlobals = []
let vClasses = []
let vArrows = []
let vTryRegions = []
let vLocalNames = []
let vThisStack = []
let vLastThis = null
let vNextInstId = 1
let vIp = 0
let vDone = false
let vResult = null
let vUnsupported = false

fn vPush(v) {
    vStack = push(vStack, v)
}

fn vPop() {
    if len(vStack) == 0 {
        throw "vm stack underflow"
    }
    let top = vStack[len(vStack) - 1]
    vStack = pop(vStack)
    return top
}

fn vTruthy(v) {
    if v == false || v == null || v == undefined {
        return false
    }
    return true
}

fn poolVal(pool, idx) {
    if idx < 0 || idx >= len(pool) {
        throw "vm bad const index"
    }
    let v = pool[idx]
    if v == KAB_UNDEF_CONST {
        return undefined
    }
    return v
}

fn poolKey(pool, idx) {
    let k = poolVal(pool, idx)
    if k == null || k == undefined {
        return ""
    }
    return "" + k
}

fn vThis() {
    if len(vThisStack) == 0 {
        return undefined
    }
    return vThisStack[len(vThisStack) - 1]
}

fn vWriteThis(updated) {
    if len(vThisStack) == 0 {
        return
    }
    vThisStack = pop(vThisStack)
    vThisStack = push(vThisStack, updated)
}

fn vIsCurrentThis(obj) {
    if obj == null || obj == undefined {
        return false
    }
    if len(vThisStack) == 0 {
        return false
    }
    let cur = vThisStack[len(vThisStack) - 1]
    if cur == null || cur == undefined {
        return false
    }
    if typeof(obj) != "object" || typeof(cur) != "object" {
        return false
    }
    if obj["vmI"] == undefined || cur["vmI"] == undefined {
        return false
    }
    return obj["vmI"] == cur["vmI"]
}

fn vFindMethod(classDef, name) {
    let methods = classDef["methods"]
    let i = 0
    while i < len(methods) {
        if methods[i]["sym"] == name {
            return methods[i]
        }
        i = i + 1
    }
    return null
}

fn vMemberGet(obj, key) {
    if obj == null || obj == undefined {
        return undefined
    }
    if typeof(obj) == "object" {
        if obj["vmC"] != undefined {
            if object_has_own(obj, key) {
                return obj[key]
            }
            let ci = obj["vmC"]
            let meth = vFindMethod(vClasses[ci], key)
            if meth != null {
                return { "vmM": meth, "vmR": obj }
            }
            return undefined
        }
    }
    return obj[key]
}

fn vMemberSet(obj, key, val) {
    if obj == null || obj == undefined {
        throw "vm cannot set member on nullish"
    }
    obj[key] = val
    return obj
}

fn vIndexGet(container, idx) {
    if container == null || container == undefined {
        return undefined
    }
    return container[idx]
}

fn vIndexSet(container, idx, val) {
    if container == null || container == undefined {
        throw "vm cannot index nullish"
    }
    container[idx] = val
    return container
}

fn vResolveGlobal(globals, idx) {
    let name = globals[idx]
    if name == "this" || name == "self" {
        return vThis()
    }
    let cur = vGlobals[idx]
    if cur != undefined {
        return cur
    }
    if name == null || name == undefined {
        return undefined
    }
    let host = bytecode_host_get("" + name)
    if host != undefined {
        vGlobals[idx] = host
    }
    return host
}

fn vCallHost(callee, ordered) {
    return bytecode_host_call(callee, ordered)
}

fn vFindTry(regions, ip) {
    if regions == null || regions == undefined {
        return null
    }
    let best = null
    let bi = 0
    while bi < len(regions) {
        let r = regions[bi]
        if ip >= r["bodyStart"] && ip <= r["bodyEnd"] {
            if best == null || r["bodyStart"] >= best["bodyStart"] {
                best = r
            }
        }
        bi = bi + 1
    }
    return best
}

fn vSnapCaps() {
    let caps = {}
    let i = 0
    while i < len(vLocalNames) {
        if i < len(vLocals) {
            caps[vLocalNames[i]] = vLocals[i]
        }
        i = i + 1
    }
    return caps
}

fn runFnBody(fnDef, pool, globals, functions, callArgs, caps) {
    let oldStack = vStack
    let oldLocals = vLocals
    let oldNames = vLocalNames
    let oldTry = vTryRegions
    let oldIp = vIp
    let oldDone = vDone
    let oldResult = vResult
    let oldUnsupported = vUnsupported

    vStack = []
    vLocals = []
    vLocalNames = fnDef["locals"]
    if vLocalNames == undefined {
        vLocalNames = []
    }
    let tr = fnDef["tryRegions"]
    if tr == undefined {
        tr = []
    }
    vTryRegions = tr
    let li = 0
    while li < len(fnDef["locals"]) {
        vLocals = push(vLocals, undefined)
        li = li + 1
    }
    let pi = 0
    while pi < len(fnDef["params"]) {
        if pi < len(callArgs) {
            vLocals[pi] = callArgs[pi]
        }
        pi = pi + 1
    }
    if caps != null && caps != undefined {
        let ci = len(fnDef["params"])
        while ci < len(fnDef["locals"]) {
            let nm = fnDef["locals"][ci]
            if caps[nm] != undefined {
                vLocals[ci] = caps[nm]
            }
            ci = ci + 1
        }
    }
    vIp = 0
    vDone = false
    vResult = null
    vUnsupported = false

    runOps(fnDef["ops"], pool, globals, functions)

    let out = vResult
    if vDone == false {
        if len(vStack) > 0 {
            out = vStack[len(vStack) - 1]
        }
    }

    vStack = oldStack
    vLocals = oldLocals
    vLocalNames = oldNames
    vTryRegions = oldTry
    vIp = oldIp
    vDone = oldDone
    vResult = oldResult
    vUnsupported = oldUnsupported
    if vUnsupported {
        throw "vm unsupported opcode in fn"
    }
    return out
}

fn runMethodBody(meth, pool, globals, functions, recv, callArgs) {
    vThisStack = push(vThisStack, recv)
    let out = null
    let err = null
    try {
        out = runFnBody(meth, pool, globals, functions, callArgs, null)
    } catch (e) {
        err = e
    }
    vLastThis = vThisStack[len(vThisStack) - 1]
    vThisStack = pop(vThisStack)
    if err != null {
        throw err
    }
    return out
}

fn vNewInstance(classIdx, argc, pool, globals, functions) {
    if classIdx < 0 || classIdx >= len(vClasses) {
        throw "vm bad class index"
    }
    let classDef = vClasses[classIdx]
    let raw = []
    let ai = 0
    while ai < argc {
        raw = push(raw, vPop())
        ai = ai + 1
    }
    let ordered = []
    let oi = argc - 1
    while oi >= 0 {
        ordered = push(ordered, raw[oi])
        oi = oi - 1
    }
    let id = vNextInstId
    vNextInstId = vNextInstId + 1
    let inst = { "vmC": classIdx, "vmI": id }
    let init = vFindMethod(classDef, "init")
    if init == null {
        init = vFindMethod(classDef, "constructor")
    }
    if init != null {
        vLastThis = inst
        runMethodBody(init, pool, globals, functions, inst, ordered)
        if vLastThis != null {
            inst = vLastThis
        }
    } else {
        if argc > 0 {
            throw "vm class has no init: " + classDef["sym"]
        }
    }
    return inst
}

fn runOps(ops, pool, globals, functions) {
    while vIp < len(ops) && vDone == false && vUnsupported == false {
        let op = ops[vIp]
        let name = op["op"]
        let arg = op["arg"]
        if name == OP_CONST {
            vPush(poolVal(pool, arg))
        } else if name == OP_LOAD_LOCAL {
            vPush(vLocals[arg])
        } else if name == OP_STORE_LOCAL {
            let v = vPop()
            vLocals[arg] = v
        } else if name == OP_LOAD_GLOBAL {
            vPush(vResolveGlobal(globals, arg))
        } else if name == OP_STORE_GLOBAL {
            let gname = globals[arg]
            let gv = vPop()
            if gname == "this" || gname == "self" {
                // ignore writes to this/self binding
            } else {
                vGlobals[arg] = gv
            }
        } else if name == OP_ADD {
            let b = vPop()
            let a = vPop()
            vPush(a + b)
        } else if name == OP_SUB {
            let b = vPop()
            let a = vPop()
            vPush(a - b)
        } else if name == OP_MUL {
            let b = vPop()
            let a = vPop()
            vPush(a * b)
        } else if name == OP_DIV {
            let b = vPop()
            let a = vPop()
            vPush(a / b)
        } else if name == OP_MOD {
            let b = vPop()
            let a = vPop()
            vPush(a % b)
        } else if name == OP_POW {
            let b = vPop()
            let a = vPop()
            vPush(a ** b)
        } else if name == OP_NEG {
            let v = vPop()
            vPush(0 - v)
        } else if name == OP_EQ {
            let b = vPop()
            let a = vPop()
            vPush(a == b)
        } else if name == OP_NE {
            let b = vPop()
            let a = vPop()
            vPush(a != b)
        } else if name == OP_LT {
            let b = vPop()
            let a = vPop()
            vPush(a < b)
        } else if name == OP_GT {
            let b = vPop()
            let a = vPop()
            vPush(a > b)
        } else if name == OP_LE {
            let b = vPop()
            let a = vPop()
            vPush(a <= b)
        } else if name == OP_GE {
            let b = vPop()
            let a = vPop()
            vPush(a >= b)
        } else if name == OP_AND {
            let b = vPop()
            let a = vPop()
            if vTruthy(a) {
                vPush(b)
            } else {
                vPush(a)
            }
        } else if name == OP_OR {
            let b = vPop()
            let a = vPop()
            if vTruthy(a) {
                vPush(a)
            } else {
                vPush(b)
            }
        } else if name == OP_NOT {
            let v = vPop()
            vPush(!vTruthy(v))
        } else if name == OP_MAKE_OBJECT {
            let n = arg
            let map = {}
            let ci = 0
            while ci < n {
                let key = vPop()
                let val = vPop()
                map["" + key] = val
                ci = ci + 1
            }
            vPush(map)
        } else if name == OP_MAKE_ARRAY {
            let n = arg
            let raw = []
            let ai = 0
            while ai < n {
                raw = push(raw, vPop())
                ai = ai + 1
            }
            let arr = []
            let oi = n - 1
            while oi >= 0 {
                arr = push(arr, raw[oi])
                oi = oi - 1
            }
            vPush(arr)
        } else if name == OP_INDEX_GET {
            let idx = vPop()
            let container = vPop()
            vPush(vIndexGet(container, idx))
        } else if name == OP_INDEX_SET {
            let val = vPop()
            let idx = vPop()
            let container = vPop()
            let asThis = vIsCurrentThis(container)
            let updated = vIndexSet(container, idx, val)
            if asThis {
                vWriteThis(updated)
            }
            vPush(updated)
            vPush(val)
        } else if name == OP_GET_MEMBER {
            let key = poolKey(pool, arg)
            let obj = vPop()
            vPush(vMemberGet(obj, key))
        } else if name == OP_SET_MEMBER {
            let key = poolKey(pool, arg)
            let val = vPop()
            let obj = vPop()
            let asThis = vIsCurrentThis(obj)
            let updated = vMemberSet(obj, key, val)
            if asThis {
                vWriteThis(updated)
            }
            vPush(updated)
            vPush(val)
        } else if name == "dup" {
            if len(vStack) == 0 {
                throw "vm stack underflow"
            }
            vPush(vStack[len(vStack) - 1])
        } else if name == "swap" {
            let a = vPop()
            let b = vPop()
            vPush(a)
            vPush(b)
        } else if name == "get_length" {
            let v = vPop()
            vPush(len(v))
        } else if name == "array_push" {
            let item = vPop()
            let arr = vPop()
            let next = push(arr, item)
            vPush(next)
            vPush(len(next))
        } else if name == "concat_array" {
            let right = vPop()
            let left = vPop()
            let out = left
            let ci = 0
            while ci < len(right) {
                out = push(out, right[ci])
                ci = ci + 1
            }
            vPush(out)
        } else if name == "merge_object" {
            let right = vPop()
            let left = vPop()
            let keys = object_keys(right)
            let ki = 0
            while ki < len(keys) {
                let k = keys[ki]
                left[k] = right[k]
                ki = ki + 1
            }
            vPush(left)
        } else if name == "call_from_array" {
            let argsArr = vPop()
            let callee = vPop()
            let ordered = []
            let ai = 0
            while ai < len(argsArr) {
                ordered = push(ordered, argsArr[ai])
                ai = ai + 1
            }
            let isVmFn = false
            let isMeth = false
            let isArrow = false
            if typeof(callee) == "object" {
                if callee["vmFn"] != undefined {
                    isVmFn = true
                }
                if callee["vmM"] != undefined {
                    isMeth = true
                }
                if callee["vmArrow"] != undefined {
                    isArrow = true
                }
            }
            if isVmFn {
                vPush(runFnBody(functions[callee["vmFn"]], pool, globals, functions, ordered, null))
            } else if isArrow {
                vPush(runFnBody(vArrows[callee["vmArrow"]], pool, globals, functions, ordered, callee["caps"]))
            } else if isMeth {
                vPush(runMethodBody(callee["vmM"], pool, globals, functions, callee["vmR"], ordered))
            } else {
                vPush(vCallHost(callee, ordered))
            }
        } else if name == "bit_and" {
            let b = vPop()
            let a = vPop()
            vPush(a & b)
        } else if name == "bit_or" {
            let b = vPop()
            let a = vPop()
            vPush(a | b)
        } else if name == "bit_xor" {
            let b = vPop()
            let a = vPop()
            vPush(a ^ b)
        } else if name == "shl" {
            let b = vPop()
            let a = vPop()
            vPush(a << b)
        } else if name == "shr" {
            let b = vPop()
            let a = vPop()
            vPush(a >> b)
        } else if name == "ushr" {
            let b = vPop()
            let a = vPop()
            vPush(a >>> b)
        } else if name == "bit_not" {
            let v = vPop()
            vPush(~v)
        } else if name == OP_POP {
            vPop()
        } else if name == OP_JUMP {
            vIp = vIp + 1 + arg
            continue
        } else if name == OP_JUMP_IF_FALSE {
            let v = vPop()
            if !vTruthy(v) {
                vIp = vIp + 1 + arg
                continue
            }
        } else if name == OP_JUMP_IF_TRUE {
            let v = vPop()
            if vTruthy(v) {
                vIp = vIp + 1 + arg
                continue
            }
        } else if name == "jump_if_not_nullish" {
            if len(vStack) == 0 {
                throw "vm stack underflow"
            }
            let v = vStack[len(vStack) - 1]
            if v != null && v != undefined {
                vIp = vIp + 1 + arg
                continue
            }
        } else if name == "jump_if_result_err" {
            let v = vPop()
            // Kab Result Err is rare; non-Result = success path (push back).
            vPush(v)
        } else if name == "make_arrow_fn" {
            vPush({ "vmArrow": arg, "caps": vSnapCaps() })
        } else if name == "iterator_step_in_place" {
            let it = vPop()
            let pair = bytecode_iterator_step_in_place(it)
            vPush(pair[0])
            vPush(pair[1])
        } else if name == OP_NEW_INSTANCE {
            let argc = op["arg2"]
            if argc == undefined {
                argc = 0
            }
            vPush(vNewInstance(arg, argc, pool, globals, functions))
        } else if name == OP_CALL {
            let argc = arg
            let callee = vPop()
            let rawArgs = []
            let ai = 0
            while ai < argc {
                rawArgs = push(rawArgs, vPop())
                ai = ai + 1
            }
            if callee == null || callee == undefined {
                vUnsupported = true
                break
            }
            let ordered = []
            let oi = argc - 1
            while oi >= 0 {
                ordered = push(ordered, rawArgs[oi])
                oi = oi - 1
            }
            let isVmFn = false
            let isMeth = false
            let isArrow = false
            if typeof(callee) == "object" {
                if callee["vmFn"] != undefined {
                    isVmFn = true
                }
                if callee["vmM"] != undefined {
                    isMeth = true
                }
                if callee["vmArrow"] != undefined {
                    isArrow = true
                }
            }
            if isVmFn {
                let fi = callee["vmFn"]
                let fnDef = functions[fi]
                vPush(runFnBody(fnDef, pool, globals, functions, ordered, null))
            } else if isArrow {
                let ai = callee["vmArrow"]
                let arrow = vArrows[ai]
                vPush(runFnBody(arrow, pool, globals, functions, ordered, callee["caps"]))
            } else if isMeth {
                let meth = callee["vmM"]
                let recv = callee["vmR"]
                vPush(runMethodBody(meth, pool, globals, functions, recv, ordered))
            } else {
                vPush(vCallHost(callee, ordered))
            }
        } else if name == OP_THROW {
            let reason = null
            if len(vStack) > 0 {
                reason = vPop()
            }
            let region = vFindTry(vTryRegions, vIp)
            if region != null {
                let el = region["errLocal"]
                while len(vLocals) <= el {
                    vLocals = push(vLocals, undefined)
                }
                vLocals[el] = reason
                vPush(reason)
                vIp = region["catchStart"]
                continue
            }
            throw reason
        } else if name == OP_RETURN {
            if len(vStack) > 0 {
                vResult = vStack[len(vStack) - 1]
            } else {
                vResult = null
            }
            vDone = true
            break
        } else if name == OP_HALT {
            if len(vStack) > 0 {
                vResult = vStack[len(vStack) - 1]
            }
            vDone = true
            break
        } else {
            throw "vm unsupported opcode: " + name
        }
        vIp = vIp + 1
    }
}

/// Run self_host IR module (`emit` output). Throws on unsupported opcode.
pub fn runModule(bc) {
    if bc == null || bc == undefined {
        throw "vm: null module"
    }
    let pool = bc["constants"]
    let globals = bc["globals"]
    let functions = bc["functions"]
    let classes = bc["classes"]
    let imports = bc["imports"]
    let arrows = bc["arrows"]
    let tryRegions = bc["tryRegions"]
    let localNames = bc["locals"]
    if pool == null || pool == undefined {
        pool = []
    }
    if globals == null || globals == undefined {
        globals = []
    }
    if functions == null || functions == undefined {
        functions = []
    }
    if classes == null || classes == undefined {
        classes = []
    }
    if imports == null || imports == undefined {
        imports = []
    }
    if arrows == null || arrows == undefined {
        arrows = []
    }
    if tryRegions == null || tryRegions == undefined {
        tryRegions = []
    }
    if localNames == null || localNames == undefined {
        localNames = []
    }
    let ii = 0
    while ii < len(imports) {
        bytecode_host_import("" + imports[ii])
        ii = ii + 1
    }
    vClasses = classes
    vArrows = arrows
    vTryRegions = tryRegions
    vLocalNames = localNames
    vGlobals = []
    let gi = 0
    while gi < len(globals) {
        vGlobals = push(vGlobals, undefined)
        gi = gi + 1
    }
    let fi = 0
    while fi < len(functions) {
        let sym = functions[fi]["sym"]
        let gi2 = 0
        while gi2 < len(globals) {
            if globals[gi2] == sym {
                vGlobals[gi2] = { "vmFn": fi }
            }
            gi2 = gi2 + 1
        }
        fi = fi + 1
    }
    vStack = []
    vLocals = []
    let li = 0
    while li < len(localNames) {
        vLocals = push(vLocals, undefined)
        li = li + 1
    }
    vThisStack = []
    vLastThis = null
    vIp = 0
    vDone = false
    vResult = null
    vUnsupported = false
    let ops = bc["ops"]
    if ops == null || ops == undefined {
        ops = []
    }
    runOps(ops, pool, globals, functions)
    if vUnsupported {
        throw "vm unsupported opcode in main"
    }
    if vDone {
        return vResult
    }
    if len(vStack) > 0 {
        return vStack[len(vStack) - 1]
    }
    return null
}
