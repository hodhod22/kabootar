// Part of deserialize line handlers.
import "self_host/deserialize_ops"

/// Same contract as host `parse_class_method_index_list`: `ci mi [comma-list]`.
/// Empty params/locals omit the third token (`class_method_params 0 0`).
fn classMethIdxList(rest) {
    let rest = trim(rest)
    let sp = str_index_of(rest, " ")
    let ci = parse_int(trim(str_slice(rest, 0, sp)))
    let rest2 = trim(str_slice(rest, sp + 1, len(rest)))
    let sp2 = str_index_of(rest2, " ")
    if sp2 < 0 {
        return [ci, parse_int(rest2), ""]
    }
    let mi = parse_int(trim(str_slice(rest2, 0, sp2)))
    let list = trim(str_slice(rest2, sp2 + 1, len(rest2)))
    return [ci, mi, list]
}

pub fn deserClass(st, line) {
    if starts_with(line, "classes=") || starts_with(line, "class_method_globals ") {
        return "ok"
    }
    if starts_with(line, "class ") {
        let rest = str_slice(line, 6, len(line))
        let sp = str_index_of(rest, " ")
        let sym = unescapeKbc(trim(str_slice(rest, sp + 1, len(rest))))
        st["classes"] = push(st["classes"], { "sym": sym, "methods": [], "fields": [], "isStruct": 0 })
        return "ok"
    }
    if starts_with(line, "class_is_struct ") {
        let idx = parse_int(trim(str_slice(line, 16, len(line))))
        st["classes"][idx]["isStruct"] = 1
        return "ok"
    }
    if starts_with(line, "class_extends ") {
        let rest = str_slice(line, 14, len(line))
        let sp = str_index_of(rest, " ")
        let ci = parse_int(trim(str_slice(rest, 0, sp)))
        let parent = unescapeKbc(trim(str_slice(rest, sp + 1, len(rest))))
        st["classes"][ci]["extends"] = parent
        return "ok"
    }
    if starts_with(line, "class_method ") {
        let rest = str_slice(line, 13, len(line))
        let sp = str_index_of(rest, " ")
        let ci = parse_int(trim(str_slice(rest, 0, sp)))
        let rest2 = trim(str_slice(rest, sp + 1, len(rest)))
        let sp2 = str_index_of(rest2, " ")
        let mi = parse_int(trim(str_slice(rest2, 0, sp2)))
        let sym = unescapeKbc(trim(str_slice(rest2, sp2 + 1, len(rest2))))
        let methods = st["classes"][ci]["methods"]
        while len(methods) <= mi {
            methods = push(methods, { "sym": "", "params": [], "locals": [], "ops": [], "constants": [] })
        }
        methods[mi]["sym"] = sym
        st["classes"][ci]["methods"] = methods
        return "ok"
    }
    if starts_with(line, "class_method_params ") {
        let p = classMethIdxList(str_slice(line, 20, len(line)))
        let meth = st["classes"][p[0]]["methods"][p[1]]
        meth["params"] = commaList(p[2])
        st["classes"][p[0]]["methods"][p[1]] = meth
        return "ok"
    }
    if starts_with(line, "class_method_locals ") {
        let p = classMethIdxList(str_slice(line, 20, len(line)))
        let meth = st["classes"][p[0]]["methods"][p[1]]
        meth["locals"] = commaList(p[2])
        st["classes"][p[0]]["methods"][p[1]] = meth
        return "ok"
    }
    if starts_with(line, "class_method_const ") {
        let rest = str_slice(line, 19, len(line))
        let sp = str_index_of(rest, " ")
        let ci = parse_int(trim(str_slice(rest, 0, sp)))
        let rest2 = trim(str_slice(rest, sp + 1, len(rest)))
        let sp2 = str_index_of(rest2, " ")
        let mi = parse_int(trim(str_slice(rest2, 0, sp2)))
        let constRest = trim(str_slice(rest2, sp2 + 1, len(rest2)))
        let val = parseConstLine("const " + constRest)
        let meth = st["classes"][ci]["methods"][mi]
        if meth["constants"] == undefined {
            meth["constants"] = []
        }
        meth["constants"] = push(meth["constants"], val)
        st["classes"][ci]["methods"][mi] = meth
        return "ok"
    }
    if starts_with(line, "class_field_type ") {
        let rest = str_slice(line, 17, len(line))
        let sp = str_index_of(rest, " ")
        let ci = parse_int(trim(str_slice(rest, 0, sp)))
        let rest2 = trim(str_slice(rest, sp + 1, len(rest)))
        let sp2 = str_index_of(rest2, " ")
        let fi = parse_int(trim(str_slice(rest2, 0, sp2)))
        let tn = unescapeKbc(trim(str_slice(rest2, sp2 + 1, len(rest2))))
        st["classes"][ci]["fields"][fi]["type"] = tn
        return "ok"
    }
    if starts_with(line, "class_field ") {
        let rest = str_slice(line, 12, len(line))
        let sp = str_index_of(rest, " ")
        let ci = parse_int(trim(str_slice(rest, 0, sp)))
        let rest2 = trim(str_slice(rest, sp + 1, len(rest)))
        let sp2 = str_index_of(rest2, " ")
        let fi = parse_int(trim(str_slice(rest2, 0, sp2)))
        let name = unescapeKbc(trim(str_slice(rest2, sp2 + 1, len(rest2))))
        let fields = st["classes"][ci]["fields"]
        if fields == undefined {
            fields = []
        }
        while len(fields) <= fi {
            fields = push(fields, { "name": "", "type": "" })
        }
        fields[fi]["name"] = name
        st["classes"][ci]["fields"] = fields
        return "ok"
    }
    if starts_with(line, "class_method_op ") {
        let rest = str_slice(line, 16, len(line))
        let sp = str_index_of(rest, " ")
        let ci = parse_int(trim(str_slice(rest, 0, sp)))
        let rest2 = trim(str_slice(rest, sp + 1, len(rest)))
        let sp2 = str_index_of(rest2, " ")
        let mi = parse_int(trim(str_slice(rest2, 0, sp2)))
        let opLine = trim(str_slice(rest2, sp2 + 1, len(rest2)))
        let op = parseOpLine(opLine)
        let meth = st["classes"][ci]["methods"][mi]
        if meth["ops"] == undefined {
            meth["ops"] = []
        }
        meth["ops"] = push(meth["ops"], op)
        st["classes"][ci]["methods"][mi] = meth
        return "ok"
    }
    return "skip"
}

