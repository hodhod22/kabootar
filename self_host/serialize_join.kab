// P6b: comma-join helper (skip-listed until ≤10s).
pub fn serJoinComma(arr) {
    let params = ""
    let k = 0
    let n = len(arr)
    while k < n {
        if params == "" {
            params = arr[k]
        } else {
            params = params + ","
            params = params + arr[k]
        }
        k = k + 1
    }
    return params
}
