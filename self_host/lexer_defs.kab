// Self-hosted Kabootar lexer definitions.
// Mirrors src/lexer/token.rs.

// ----- CHARACTER CONSTANTS (direct ASCII values) -----
pub let QUOTE = "\""
pub let BACKTICK = "`"
pub let CHAR_TAB = "\t"
pub let CHAR_NL = "\n"
pub let CHAR_CR = "\r"

