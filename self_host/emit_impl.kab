// H6e: self-hosted bytecode emitter body — heavy impl (skip-listed; see self_host/emit.kab).
// Produces opcode IR from AST.
// Session accumulators (eOps, eConsts, …) stay module-global; recursion temps use fn-locals (L1/S1).
import "self_host/ast_defs"
import "self_host/emit_defs"

let eConsts = []
let eOps = []
let eOpsN = 0
let eGlobals = []
let eFnOps = []
let eFnOpsN = 0
let eFnGlobals = []
let eFnLocals = []
// P6b: O(1) sym dedup maps (avoid per-probe LoadGlobal clone of eConsts/eGlobals).
let eConstMap = {}
let eConstN = 0
let eGlobalMap = {}
let eGlobalN = 0
// P6b: O(1) fn-local lookup (emitSym/localSymIndex AccAdd hot path).
let eLocalMap = {}
let eLocalN = 0
let eInFn = 0
let eIdx = 0
let eSym = null
let eJmp = 0
let eEnd = 0
let eNode = null
let eProg = 0
let eLeft = null
let eRight = null
let eOp = ""
let eBinOp = ""
let eBinaryL = null
let eBinaryR = null
let eCond = null
let eThen = null
let eElse = null
let eCondStack = []
let eThenStack = []
let eElseStack = []
let eProgram = null
let eFunctions = []
let eParams = []
let eFnBody = null
let eFnName = ""
let eBxL = null
let eBxR = null
let eBxRhs = null
let eArgs = []
let eCallee = null
let eCalleeStack = []
let eCallI = 0
let eArgN = 0
let eLocalI = 0
let eGlobI = 0
let eConstI = 0
let eStmtI = 0
let eObjI = 0
let eParamI = 0
let eFound = 0
let eWhileHead = 0
let eJumpOff = 0
let eWhileHeads = []
let eBreakIdxs = []
let eBreakFromStack = []
let eBi = 0
let eBf = 0
let eWh = 0
let eWhNew = []
let eWhI = 0
let eList = []
let eBodyStmts = []
let eBlockStmts = []
let eBlockN = 0
let eBlockI = 0
let eBlockNStack = []
let eBlockIStack = []
let eBlockStmtsStack = []
let eBlockDepth = 0
let eCalleeDepth = 0
let eCallArgDepth = 0
let eObjDepth = 0
let eArrDepth = 0
let eIfDepth = 0
let eMemberDepth = 0
let eIndexDepth = 0
let eLenScratch = 0
let eFld = null
let eIfJmpStack = []
let eIfSkipStack = []
let eExports = []
let eImports = []
let eFnSave = ""
let eFnPub = 0
let eStoreSym = ""
let eAssignSym = ""
let eExprStmt = null
let eMemberFld = ""
let eMemberFldStack = []
let eSnapI = 0
let eSnapOut = []
let eLoopSave = 0
let eStmtKind = ""
let eStmtNode = null
let eObjIStack = []
let eObjNStack = []
let eArrIStack = []
let eArrNStack = []
let eCallArgIStack = []
let eCallArgNStack = []
// Nested calls overwrite module-global `eArgs` / `eArgN`; restore from these stacks.
let eArgsStack = []
let eIndexStack = []
let eLitNode = null
let eGenericTemplates = []
let eSpecMangled = []
let eBindingSyms = []
let eBindingTypes = []
let eGenericClassTemplates = []
let eGenericEnumTemplates = []
let eGenericMethodTemplates = []
let eClasses = []
let eEnums = []
let eClassMethods = []
let eClassMethodsSrc = []
let eClassIsStruct = 0
let eArrows = []
let eTryRegions = []
let eFnTryRegions = []
let eForCounter = 0
let eGenTmpl = null
let eGenSym = ""
let eMangled = ""
let eExplicit = []
let eTypeParams = []
let eTypeArgs = []
let eSaveInFn = 0
let eSaveFnOps = []
let eSaveFnLocals = []
let eSaveFnGlobals = []
let eGenI = 0
let eInferType = ""
let eResolveI = 0
let eRecvClass = ""
let eCtorCallee = null
let eCtorName = ""
let eMethodMangled = ""
let eMethTmpl = null
let eNewClasses = []
let eNewMethods = []
let eClassIdx = 0
let eFoundMeth = 0
let eCtorArgs = []

// <=7 top-level fn per module (Windows OOM / stack overflow at module init).
// P6b: stable key for const-table dedup (length-prefixed strings).
fn constKey(arg) {
    if arg == KAB_UNDEF_CONST {
        return "U"
    }
    if arg == null {
        return "N"
    }
    if arg == true {
        return "T"
    }
    if arg == false {
        return "F"
    }
    let t = typeof(arg)
    if t == "string" {
        return "S" + ("" + len(arg)) + ":" + arg
    }
    if t == "number" {
        return "D" + ("" + arg)
    }
    return "X" + ("" + arg)
}

fn resetLocalMap() {
    eLocalMap = {}
    eLocalN = 0
}

fn rebuildLocalMap() {
    eLocalMap = {}
    eLocalN = 0
    let i = 0
    let n = len(eFnLocals)
    while i < n {
        eLocalMap[eFnLocals[i]] = i
        eLocalN = eLocalN + 1
        i = i + 1
    }
}

fn symIndex(mode, arg) {
    if mode == "local" {
        let lHit = eLocalMap[arg]
        if lHit != undefined {
            return lHit
        }
        eFnLocals = push(eFnLocals, arg)
        let lIdx = eLocalN
        eLocalN = eLocalN + 1
        eLocalMap[arg] = lIdx
        return lIdx
    }
    if mode == "global" {
        let gHit = eGlobalMap[arg]
        if gHit != undefined {
            return gHit
        }
        eGlobals = push(eGlobals, arg)
        let gIdx = eGlobalN
        eGlobalN = eGlobalN + 1
        eGlobalMap[arg] = gIdx
        return gIdx
    }
    if mode == "const" {
        let cKey = constKey(arg)
        let cHit = eConstMap[cKey]
        if cHit != undefined {
            return cHit
        }
        eConsts = push(eConsts, arg)
        let cIdx = eConstN
        eConstN = eConstN + 1
        eConstMap[cKey] = cIdx
        return cIdx
    }
    if mode == "constLit" {
        if arg["lit"] == LIT_UNDEF {
            return symIndex("const", KAB_UNDEF_CONST)
        }
        return symIndex("const", arg["value"])
    }
    if mode == "class" {
        eClassIdx = 0
        while eClassIdx < len(eClasses) {
            if eClasses[eClassIdx]["sym"] == arg {
                return eClassIdx
            }
            eClassIdx = eClassIdx + 1
        }
        return -1
    }
    throw "symIndex: bad mode"
}

// mode "snap" -> copy array; mode "pushLen" -> push len(arr) onto stack
fn arrUtil(mode, stack, arr) {
    if mode == "snap" {
        // Single O(n) clone via native slice (not O(n²) push loop).
        return slice(stack, 0)
    }
    eLenScratch = len(arr)
    return push(stack, eLenScratch)
}

fn emitOp(op, arg) {
    if eInFn == 1 {
        eFnOps = push(eFnOps, { "op": op, "arg": arg })
        eFnOpsN = eFnOpsN + 1
    } else {
        eOps = push(eOps, { "op": op, "arg": arg })
        eOpsN = eOpsN + 1
    }
}

/// Nested calls: save callee before recursive emitExpr on args (module-global eCallee).
fn emitCallCallee() {
    // P6b: use eCalleeDepth (avoid len(eCalleeStack) LoadGlobal clone).
    eCallee = eCalleeStack[eCalleeDepth - 1]
    eCalleeStack = pop(eCalleeStack)
    eCalleeDepth = eCalleeDepth - 1
    emitExpr(eCallee)
}

fn dropCallCallee() {
    eCalleeStack = pop(eCalleeStack)
    eCalleeDepth = eCalleeDepth - 1
}

/// P6b: emit each Call arg via eCallArgDepth (no len(stack) clones / pop-push per arg).
/// Caller must push eCallArgIStack(0), eCallArgNStack(n), eArgsStack(args) first.
fn emitCallArgExprs() {
    eCallArgDepth = eCallArgDepth + 1
    let cad = eCallArgDepth
    while eCallArgIStack[cad - 1] < eCallArgNStack[cad - 1] {
        eArgs = eArgsStack[cad - 1]
        emitExpr(eArgs[eCallArgIStack[cad - 1]])
        eCallArgIStack[cad - 1] = eCallArgIStack[cad - 1] + 1
    }
    eArgsStack = pop(eArgsStack)
    eArgN = eCallArgNStack[cad - 1]
    eCallArgIStack = pop(eCallArgIStack)
    eCallArgNStack = pop(eCallArgNStack)
    eCallArgDepth = eCallArgDepth - 1
}

fn emitSym(store, sym) {
    // P6b: map lookup only — no len(eFnLocals)/eGlobals LoadGlobal clone scans.
    if store == 0 {
        if eInFn == 0 {
            eIdx = symIndex("global", sym)
            emitOp(OP_LOAD_GLOBAL, eIdx)
            return
        }
        let li = eLocalMap[sym]
        if li != undefined {
            emitOp(OP_LOAD_LOCAL, li)
            return
        }
        let gi = eGlobalMap[sym]
        if gi != undefined {
            emitOp(OP_LOAD_GLOBAL, gi)
            return
        }
        eIdx = symIndex("global", sym)
        emitOp(OP_LOAD_GLOBAL, eIdx)
        return
    }
    if eInFn == 0 {
        eIdx = symIndex("global", sym)
        emitOp(OP_STORE_GLOBAL, eIdx)
        return
    }
    let sli = eLocalMap[sym]
    if sli != undefined {
        emitOp(OP_STORE_LOCAL, sli)
        return
    }
    let sgi = eGlobalMap[sym]
    if sgi != undefined {
        emitOp(OP_STORE_GLOBAL, sgi)
        return
    }
    eIdx = symIndex("local", sym)
    emitOp(OP_STORE_LOCAL, eIdx)
}

/// Local index if `sym` is an fn-local, else -1.
fn localSymIndex(sym) {
    if eInFn != 1 {
        return -1
    }
    let li = eLocalMap[sym]
    if li != undefined {
        return li
    }
    return -1
}

/// `name = push(name, item)` → Take + ArrayPush* (classic eval order; O(1) in-place).
fn tryEmitArrayPushAssign(sym, rhs) {
    if rhs.kind != AST_CALL {
        return false
    }
    let cal = rhs["callee"]
    let args = rhs["args"]
    if cal.kind != AST_VAR {
        return false
    }
    if cal["sym"] != "push" {
        return false
    }
    if len(args) != 2 {
        return false
    }
    let a0 = args[0]
    if a0.kind != AST_VAR {
        return false
    }
    if a0["sym"] != sym {
        return false
    }
    let li = localSymIndex(sym)
    if li >= 0 {
        emitOp(OP_TAKE_LOCAL, li)
        emitExpr(args[1])
        emitOp(OP_ARRAY_PUSH_LOCAL, li)
        emitOp(OP_POP, 0)
        return true
    }
    let gi = symIndex("global", sym)
    emitOp(OP_TAKE_GLOBAL, gi)
    emitExpr(args[1])
    emitOp(OP_ARRAY_PUSH_GLOBAL, gi)
    emitOp(OP_POP, 0)
    return true
}

/// `name = name + a + b + …` → AccAdd* (in-place).
/// Statement path: AccAdd pops rhs only — no Const(null) junk on the stack
/// (expr-assign value is unused for AST_ASSIGN stmts; ArrayPush uses POP similarly).
/// P6b: early reject + recurse (no pieces[] push) so emit of dense `sOut = sOut + …`
/// chains stays O(depth) instead of O(n²) array copies.
fn tryEmitAccAddAssign(sym, rhs) {
    if rhs.kind != AST_BINARY {
        return false
    }
    if rhs["op"] != "+" {
        return false
    }
    let left = rhs["left"]
    let right = rhs["right"]
    if left.kind == AST_VAR {
        if left["sym"] != sym {
            return false
        }
        let li = localSymIndex(sym)
        if li >= 0 {
            emitExpr(right)
            emitOp(OP_ACC_ADD_LOCAL, li)
            return true
        }
        let gi = symIndex("global", sym)
        emitExpr(right)
        emitOp(OP_ACC_ADD_GLOBAL, gi)
        return true
    }
    if left.kind == AST_BINARY {
        if left["op"] == "+" {
            if tryEmitAccAddAssign(sym, left) {
                let li = localSymIndex(sym)
                if li >= 0 {
                    emitExpr(right)
                    emitOp(OP_ACC_ADD_LOCAL, li)
                    return true
                }
                let gi = symIndex("global", sym)
                emitExpr(right)
                emitOp(OP_ACC_ADD_GLOBAL, gi)
                return true
            }
        }
    }
    return false
}

fn emitExpr(node) {
    eNode = node
    if eNode == null {
        throw "emitExpr: null node"
    }
    if eNode.kind == AST_LITERAL {
        eIdx = symIndex("constLit",eNode)
        emitOp(OP_CONST, eIdx)
        return
    }
    if eNode.kind == AST_VAR {
        eSym = eNode["sym"]
        if eSym == "None" {
            emitOp(OP_MAKE_NONE, 0)
            return
        }
        emitSym(0,eSym)
        return
    }
    if eNode.kind == AST_UNARY {
        let uOp = eNode["op"]
        let uInner = eNode["expr"]
        emitExpr(uInner)
        if uOp == "!" {
            emitOp(OP_NOT, 0)
            return
        }
        if uOp == "-" {
            emitOp(OP_NEG, 0)
            return
        }
        if uOp == "~" {
            emitOp(OP_BIT_NOT, 0)
            return
        }
        throw "Unsupported unary op: " + uOp
    }
    if eNode.kind == AST_ARROW {
        let aParams = eNode["params"]
        let aBody = eNode["body"]
        let saveIn = eInFn
        let saveOps = arrUtil("snap", eFnOps)
        let saveLocals = arrUtil("snap", eFnLocals)
        let saveGlobals = arrUtil("snap", eFnGlobals)
        let saveTry = arrUtil("snap", eFnTryRegions)
        eInFn = 1
        eFnOps = []
        eFnOpsN = 0
        eFnLocals = []
        resetLocalMap()
        eFnGlobals = []
        eFnTryRegions = []
        let api = 0
        while api < len(aParams) {
            symIndex("local", aParams[api])
            api = api + 1
        }
        if aBody.kind == AST_BLOCK {
            emitStmt(aBody)
        } else {
            emitExpr(aBody)
            emitOp(OP_RETURN, 0)
        }
        let ai = len(eArrows)
        eArrows = push(eArrows, {
            "sym": "__arrow_" + ai,
            "params": arrUtil("snap", aParams),
            "locals": arrUtil("snap", eFnLocals),
            "ops": arrUtil("snap", eFnOps),
            "tryRegions": arrUtil("snap", eFnTryRegions)
        })
        eInFn = saveIn
        eFnOps = saveOps
        eFnOpsN = len(saveOps)
        eFnLocals = saveLocals
        rebuildLocalMap()
        eFnGlobals = saveGlobals
        eFnTryRegions = saveTry
        emitOp(OP_MAKE_ARROW, ai)
        return
    }
    if eNode.kind == AST_BINARY {
        let binOp = eNode["op"]
        let binRight = eNode["right"]
        emitExpr(eNode["left"])
        emitExpr(binRight)
        eBinOp = binOp
        if eBinOp == "+" {
            emitOp(OP_ADD, 0)
            return
        }
        if eBinOp == "-" {
            emitOp(OP_SUB, 0)
            return
        }
        if eBinOp == "*" {
            emitOp(OP_MUL, 0)
            return
        }
        if eBinOp == "/" {
            emitOp(OP_DIV, 0)
            return
        }
        if eBinOp == "%" {
            emitOp(OP_MOD, 0)
            return
        }
        if eBinOp == "**" {
            emitOp(OP_POW, 0)
            return
        }
        if eBinOp == "==" {
            emitOp(OP_EQ, 0)
            return
        }
        if eBinOp == "!=" {
            emitOp(OP_NE, 0)
            return
        }
        if eBinOp == "<" {
            emitOp(OP_LT, 0)
            return
        }
        if eBinOp == ">" {
            emitOp(OP_GT, 0)
            return
        }
        if eBinOp == ">=" {
            emitOp(OP_GE, 0)
            return
        }
        if eBinOp == "<=" {
            emitOp(OP_LE, 0)
            return
        }
        if eBinOp == "&&" {
            emitOp(OP_AND, 0)
            return
        }
        if eBinOp == "||" {
            emitOp(OP_OR, 0)
            return
        }
        if eBinOp == "&" {
            emitOp(OP_BIT_AND, 0)
            return
        }
        if eBinOp == "|" {
            emitOp(OP_BIT_OR, 0)
            return
        }
        if eBinOp == "^" {
            emitOp(OP_BIT_XOR, 0)
            return
        }
        if eBinOp == "<<" {
            emitOp(OP_SHL, 0)
            return
        }
        if eBinOp == ">>" {
            emitOp(OP_SHR, 0)
            return
        }
        if eBinOp == ">>>" {
            emitOp(OP_USHR, 0)
            return
        }
        throw "Unsupported binary op: " + eBinOp
    }
    if eNode.kind == AST_OBJECT {
        // Use fn-local field list — nested array/object emit must not clobber a shared eList.
        // P6b: eObjDepth avoids len(eObjIStack) clones + pop/push per field.
        let objFields = eNode["fields"]
        eObjIStack = push(eObjIStack, 0)
        eObjNStack = arrUtil("pushLen",eObjNStack, objFields)
        eObjDepth = eObjDepth + 1
        let od = eObjDepth
        while eObjIStack[od - 1] < eObjNStack[od - 1] {
            eObjI = eObjIStack[od - 1]
            eFld = objFields[eObjI]
            emitExpr(eFld["value"])
            eIdx = symIndex("const",eFld["key"])
            emitOp(OP_CONST, eIdx)
            eObjIStack[od - 1] = eObjIStack[od - 1] + 1
        }
        eObjIStack = pop(eObjIStack)
        eObjNStack = pop(eObjNStack)
        eObjDepth = eObjDepth - 1
        emitOp(OP_MAKE_OBJECT, len(objFields))
        return
    }
    if eNode.kind == AST_ARRAY {
        // P6b: eArrDepth avoids len(eArrIStack) clones + pop/push per elem.
        let arrElems = eNode["elems"]
        eArrIStack = push(eArrIStack, 0)
        eArrNStack = arrUtil("pushLen",eArrNStack, arrElems)
        eArrDepth = eArrDepth + 1
        let ad = eArrDepth
        while eArrIStack[ad - 1] < eArrNStack[ad - 1] {
            eObjI = eArrIStack[ad - 1]
            emitExpr(arrElems[eObjI])
            eArrIStack[ad - 1] = eArrIStack[ad - 1] + 1
        }
        eArrIStack = pop(eArrIStack)
        eArrNStack = pop(eArrNStack)
        eArrDepth = eArrDepth - 1
        emitOp(OP_MAKE_ARRAY, len(arrElems))
        return
    }
    if eNode.kind == AST_MEMBER {
        // P6b: eMemberDepth avoids len(eMemberFldStack) LoadGlobal clone.
        eBxL = eNode["object"]
        eMemberFldStack = push(eMemberFldStack, eNode["field"])
        eMemberDepth = eMemberDepth + 1
        eMemTypeArgs = eNode["typeArgs"]
        if eMemTypeArgs == undefined {
            eMemTypeArgs = []
        }
        if eBxL.kind == AST_VAR {
            eGenSym = eBxL["sym"]
            eFound = 0
            eGenI = 0
            while eGenI < len(eGenericEnumTemplates) {
                if eGenericEnumTemplates[eGenI]["sym"] == eGenSym {
                    eGenTmpl = eGenericEnumTemplates[eGenI]
                    eFound = 1
                    break
                }
                eGenI = eGenI + 1
            }
            if eFound == 1 {
                if len(eMemTypeArgs) > 0 {
                    eTypeArgs = arrUtil("snap",eMemTypeArgs)
                    eMangled = eGenSym
                    if len(eTypeArgs) > 0 {
                        eMangled = eMangled + "$" + eTypeArgs[0]
                        eResolveI = 1
                        while eResolveI < len(eTypeArgs) {
                            eMangled = eMangled + "_" + eTypeArgs[eResolveI]
                            eResolveI = eResolveI + 1
                        }
                    }
                    eFound = 0
                    eGenI = 0
                    while eGenI < len(eEnums) {
                        if eEnums[eGenI]["sym"] == eMangled {
                            eFound = 1
                            break
                        }
                        eGenI = eGenI + 1
                    }
                    if eFound == 0 {
                        eEnums = push(eEnums, {
                            "sym": eMangled,
                            "variants": arrUtil("snap",eGenTmpl["variants"])
                        })
                        symIndex("global",eMangled)
                    }
                }
            }
        }
        emitExpr(eBxL)
        eMemberFld = eMemberFldStack[eMemberDepth - 1]
        eMemberFldStack = pop(eMemberFldStack)
        eMemberDepth = eMemberDepth - 1
        eIdx = symIndex("const",eMemberFld)
        emitOp(OP_GET_MEMBER, eIdx)
        return
    }
    if eNode.kind == AST_INDEX {
        // P6b: eIndexDepth avoids len(eIndexStack) LoadGlobal clone.
        eIndexStack = push(eIndexStack, eNode["index"])
        eIndexDepth = eIndexDepth + 1
        emitExpr(eNode["object"])
        emitExpr(eIndexStack[eIndexDepth - 1])
        eIndexStack = pop(eIndexStack)
        eIndexDepth = eIndexDepth - 1
        emitOp(OP_INDEX_GET, 0)
        return
    }
    if eNode.kind == AST_CALL {
        eArgs = eNode["args"]
        eCalleeStack = push(eCalleeStack, eNode["callee"])
        eCalleeDepth = eCalleeDepth + 1
        eCallee = eNode["callee"]
        if eCallee.kind == AST_VAR {
            let ctorName = eCallee["sym"]
            if len(eArgs) == 1 {
                if ctorName == "Ok" {
                    emitExpr(eArgs[0])
                    emitOp(OP_MAKE_OK, 0)
                    eCalleeStack = pop(eCalleeStack)
                    eCalleeDepth = eCalleeDepth - 1
                    return
                }
                if ctorName == "Err" {
                    emitExpr(eArgs[0])
                    emitOp(OP_MAKE_ERR, 0)
                    eCalleeStack = pop(eCalleeStack)
                    eCalleeDepth = eCalleeDepth - 1
                    return
                }
                if ctorName == "Some" {
                    emitExpr(eArgs[0])
                    emitOp(OP_MAKE_SOME, 0)
                    eCalleeStack = pop(eCalleeStack)
                    eCalleeDepth = eCalleeDepth - 1
                    return
                }
            }
        }
        if eCallee.kind == AST_MEMBER {
            eMemObj = eCallee["object"]
            eMemFld = eCallee["field"]
            eMemTypeArgs = eCallee["typeArgs"]
            if eMemTypeArgs == undefined {
                eMemTypeArgs = []
            }
            if eMemObj.kind == AST_VAR {
                eGenSym = eMemObj["sym"]
                eFound = 0
                eGenI = 0
                while eGenI < len(eGenericEnumTemplates) {
                    if eGenericEnumTemplates[eGenI]["sym"] == eGenSym {
                        eGenTmpl = eGenericEnumTemplates[eGenI]
                        eFound = 1
                        break
                    }
                    eGenI = eGenI + 1
                }
                if eFound == 1 {
                    eExplicit = eNode["typeArgs"]
                    if eExplicit == undefined {
                        eExplicit = []
                    }
                    if len(eExplicit) > 0 {
                        eTypeArgs = arrUtil("snap",eExplicit)
                    } else {
                        if len(eMemTypeArgs) > 0 {
                            eTypeArgs = arrUtil("snap",eMemTypeArgs)
                        } else {
                            eTypeArgs = []
                            eResolveI = 0
                            while eResolveI < len(eArgs) {
                                eInferType = ""
                                if eArgs[eResolveI].kind == AST_LITERAL {
                                    if eArgs[eResolveI].lit == LIT_NUMBER {
                                        eInferType = "Number"
                                    }
                                    if eArgs[eResolveI].lit == LIT_STRING {
                                        eInferType = "String"
                                    }
                                }
                                if eInferType == "" {
                                    if eArgs[eResolveI].kind == AST_VAR {
                                        eBi = 0
                                        while eBi < len(eBindingSyms) {
                                            if eBindingSyms[eBi] == eArgs[eResolveI]["sym"] {
                                                eInferType = eBindingTypes[eBi]
                                            }
                                            eBi = eBi + 1
                                        }
                                    }
                                }
                                if eInferType == "" {
                                    throw "Cannot infer type for " + eGenSym
                                }
                                eTypeArgs = push(eTypeArgs, eInferType)
                                eResolveI = eResolveI + 1
                            }
                        }
                    }
                    eMangled = eGenSym
                    if len(eTypeArgs) > 0 {
                        eMangled = eMangled + "$" + eTypeArgs[0]
                        eResolveI = 1
                        while eResolveI < len(eTypeArgs) {
                            eMangled = eMangled + "_" + eTypeArgs[eResolveI]
                            eResolveI = eResolveI + 1
                        }
                    }
                    eFound = 0
                    eGenI = 0
                    while eGenI < len(eEnums) {
                        if eEnums[eGenI]["sym"] == eMangled {
                            eFound = 1
                            break
                        }
                        eGenI = eGenI + 1
                    }
                    if eFound == 0 {
                        eEnums = push(eEnums, {
                            "sym": eMangled,
                            "variants": arrUtil("snap",eGenTmpl["variants"])
                        })
                        symIndex("global",eMangled)
                    }
                    eArgN = len(eArgs)
                    eCallArgIStack = push(eCallArgIStack, 0)
                    eCallArgNStack = push(eCallArgNStack, eArgN)
                    eArgsStack = push(eArgsStack, eArgs)
                    emitCallArgExprs()
                    while eArgN > 0 {
                        emitOp(OP_POP, 0)
                        eArgN = eArgN - 1
                    }
                    dropCallCallee()
                    return
                }
            }
        eRecvClass = ""
        if eMemObj.kind == AST_VAR {
            eBi = 0
            while eBi < len(eBindingSyms) {
                if eBindingSyms[eBi] == eMemObj["sym"] {
                    eRecvClass = eBindingTypes[eBi]
                }
                eBi = eBi + 1
            }
        }
        if eRecvClass == "" {
            if eMemObj.kind == AST_CALL {
                eCtorCallee = eMemObj["callee"]
                if eCtorCallee.kind == AST_VAR {
                    eCtorName = eCtorCallee["sym"]
                    eGenI = 0
                    while eGenI < len(eClasses) {
                        if eClasses[eGenI]["sym"] == eCtorName {
                            eRecvClass = eCtorName
                        }
                        eGenI = eGenI + 1
                    }
                }
            }
        }
        eMethTmpl = null
        eFound = 0
        if eRecvClass != "" {
            eGenI = 0
            while eGenI < len(eGenericMethodTemplates) {
                if eGenericMethodTemplates[eGenI]["classSym"] == eRecvClass {
                    if eGenericMethodTemplates[eGenI]["methodSym"] == eMemFld {
                        eMethTmpl = eGenericMethodTemplates[eGenI]
                        eFound = 1
                    }
                }
                eGenI = eGenI + 1
            }
        }
        if eFound == 1 {
            eExplicit = eNode["typeArgs"]
            if eExplicit == undefined {
                eExplicit = []
            }
            if len(eExplicit) > 0 {
                eTypeArgs = arrUtil("snap",eExplicit)
            } else {
                eTypeArgs = []
                eResolveI = 0
                while eResolveI < len(eArgs) {
                    eInferType = ""
                    if eArgs[eResolveI].kind == AST_LITERAL {
                        if eArgs[eResolveI].lit == LIT_NUMBER {
                            eInferType = "Number"
                        }
                        if eArgs[eResolveI].lit == LIT_STRING {
                            eInferType = "String"
                        }
                    }
                    if eInferType == "" {
                        if eArgs[eResolveI].kind == AST_VAR {
                            eBi = 0
                            while eBi < len(eBindingSyms) {
                                if eBindingSyms[eBi] == eArgs[eResolveI]["sym"] {
                                    eInferType = eBindingTypes[eBi]
                                }
                                eBi = eBi + 1
                            }
                        }
                    }
                    if eInferType == "" {
                        throw "Cannot infer type for " + eMemFld
                    }
                    eTypeArgs = push(eTypeArgs, eInferType)
                    eResolveI = eResolveI + 1
                }
            }
            eMethodMangled = eMemFld
            if len(eTypeArgs) > 0 {
                eMethodMangled = eMethodMangled + "$" + eTypeArgs[0]
                eResolveI = 1
                while eResolveI < len(eTypeArgs) {
                    eMethodMangled = eMethodMangled + "_" + eTypeArgs[eResolveI]
                    eResolveI = eResolveI + 1
                }
            }
            eFoundMeth = 0
            eClassIdx = 0
            while eClassIdx < len(eClasses) {
                if eClasses[eClassIdx]["sym"] == eRecvClass {
                    eMi = 0
                    while eMi < len(eClasses[eClassIdx]["methods"]) {
                        if eClasses[eClassIdx]["methods"][eMi]["sym"] == eMethodMangled {
                            eFoundMeth = 1
                        }
                        eMi = eMi + 1
                    }
                    if eFoundMeth == 0 {
                        eSaveInFn = eInFn
                        eSaveFnOps = arrUtil("snap",eFnOps)
                        eSaveFnLocals = arrUtil("snap",eFnLocals)
                        eSaveFnGlobals = arrUtil("snap",eFnGlobals)
                        eInFn = 1
                        eFnOps = []
                        eFnOpsN = 0
                        eFnGlobals = []
                        eFnLocals = []
                        resetLocalMap()
                        eParams = eMethTmpl["params"]
                        eParamI = 0
                        while eParamI < len(eParams) {
                            eLoopSave = eParamI
                            symIndex("local",eParams[eParamI])
                            eParamI = eLoopSave + 1
                        }
                        emitStmt(eMethTmpl["body"])
                        eNewMethods = arrUtil("snap",eClasses[eClassIdx]["methods"])
                        eNewMethods = push(eNewMethods, {
                            "sym": eMethodMangled,
                            "params": arrUtil("snap",eParams),
                            "locals": arrUtil("snap",eFnLocals),
                            "globals": arrUtil("snap",eFnGlobals),
                            "ops": arrUtil("snap",eFnOps)
                        })
                        eNewClasses = []
                        eGenI = 0
                        while eGenI < len(eClasses) {
                            if eGenI == eClassIdx {
                                eNewClasses = push(eNewClasses, {
                                    "sym": eRecvClass,
                                    "methods": eNewMethods
                                })
                            } else {
                                eNewClasses = push(eNewClasses, eClasses[eGenI])
                            }
                            eGenI = eGenI + 1
                        }
                        eClasses = eNewClasses
                        eInFn = eSaveInFn
                        eFnOps = eSaveFnOps
                        eFnOpsN = len(eSaveFnOps)
                        eFnLocals = eSaveFnLocals
                        rebuildLocalMap()
                        eFnGlobals = eSaveFnGlobals
                    }
                }
                eClassIdx = eClassIdx + 1
            }
            eArgN = len(eArgs)
            emitExpr(eMemObj)
            eIdx = symIndex("const",eMethodMangled)
            emitOp(OP_GET_MEMBER, eIdx)
            eCallArgIStack = push(eCallArgIStack, 0)
            eCallArgNStack = push(eCallArgNStack, eArgN)
            eArgsStack = push(eArgsStack, eArgs)
            emitCallArgExprs()
            emitOp(OP_CALL, eArgN)
            dropCallCallee()
            return
        }
        }
        if eCallee.kind == AST_VAR {
            eGenSym = eCallee["sym"]
            eGenTmpl = null
            eFound = 0
            eGenI = 0
            while eGenI < len(eGenericClassTemplates) {
                if eGenericClassTemplates[eGenI]["sym"] == eGenSym {
                    eGenTmpl = eGenericClassTemplates[eGenI]
                    eFound = 1
                    break
                }
                eGenI = eGenI + 1
            }
            if eFound == 1 {
                eExplicit = eNode["typeArgs"]
                if eExplicit == undefined {
                    eExplicit = []
                }
                if len(eExplicit) > 0 {
                    eTypeArgs = arrUtil("snap",eExplicit)
                } else {
                    eTypeArgs = []
                    eResolveI = 0
                    while eResolveI < len(eArgs) {
                        eInferType = ""
                        if eArgs[eResolveI].kind == AST_LITERAL {
                            if eArgs[eResolveI].lit == LIT_NUMBER {
                                eInferType = "Number"
                            }
                            if eArgs[eResolveI].lit == LIT_STRING {
                                eInferType = "String"
                            }
                        }
                        if eInferType == "" {
                            if eArgs[eResolveI].kind == AST_VAR {
                                eBi = 0
                                while eBi < len(eBindingSyms) {
                                    if eBindingSyms[eBi] == eArgs[eResolveI]["sym"] {
                                        eInferType = eBindingTypes[eBi]
                                    }
                                    eBi = eBi + 1
                                }
                            }
                        }
                        if eInferType == "" {
                            throw "Cannot infer type for " + eGenSym
                        }
                        eTypeArgs = push(eTypeArgs, eInferType)
                        eResolveI = eResolveI + 1
                    }
                }
                eMangled = eGenSym
                if len(eTypeArgs) > 0 {
                    eMangled = eMangled + "$" + eTypeArgs[0]
                    eResolveI = 1
                    while eResolveI < len(eTypeArgs) {
                        eMangled = eMangled + "_" + eTypeArgs[eResolveI]
                        eResolveI = eResolveI + 1
                    }
                }
                eFound = 0
                eGenI = 0
                while eGenI < len(eClasses) {
                    if eClasses[eGenI]["sym"] == eMangled {
                        eFound = 1
                        break
                    }
                    eGenI = eGenI + 1
                }
                if eFound == 0 {
                    eClassMethods = []
                    eMi = 0
                    while eMi < len(eGenTmpl["methods"]) {
                        eMeth = eGenTmpl["methods"][eMi]
                        eMethTypeParams = eMeth["typeParams"]
                        if eMethTypeParams == undefined {
                            eMethTypeParams = []
                        }
                        if len(eMethTypeParams) == 0 {
                            eInFn = 1
                            eFnOps = []
                            eFnOpsN = 0
                            eFnGlobals = []
                            eFnLocals = []
                            resetLocalMap()
                            eParams = eMeth["params"]
                            eParamI = 0
                            while eParamI < len(eParams) {
                                eLoopSave = eParamI
                                symIndex("local",eParams[eParamI])
                                eParamI = eLoopSave + 1
                            }
                            emitStmt(eMeth["body"])
                            eClassMethods = push(eClassMethods, {
                                "sym": eMeth["sym"],
                                "params": arrUtil("snap",eParams),
                                "locals": arrUtil("snap",eFnLocals),
                                "globals": arrUtil("snap",eFnGlobals),
                                "ops": arrUtil("snap",eFnOps)
                            })
                            eInFn = 0
                        } else {
                            eGenericMethodTemplates = push(eGenericMethodTemplates, {
                                "classSym": eMangled,
                                "methodSym": eMeth["sym"],
                                "typeParams": arrUtil("snap",eMethTypeParams),
                                "params": arrUtil("snap",eMeth["params"]),
                                "body": eMeth["body"]
                            })
                        }
                        eMi = eMi + 1
                    }
                    eClasses = push(eClasses, { "sym": eMangled, "methods": eClassMethods })
                    symIndex("global",eMangled)
                }
                eArgN = len(eArgs)
                eCallArgIStack = push(eCallArgIStack, 0)
                eCallArgNStack = push(eCallArgNStack, eArgN)
                eArgsStack = push(eArgsStack, eArgs)
                emitCallArgExprs()
                eClassIdx = symIndex("class",eMangled)
                if eClassIdx < 0 {
                    throw "Missing specialized class " + eMangled
                }
                if eInFn == 1 {
                    eFnOps = push(eFnOps, { "op": OP_NEW_INSTANCE, "arg": eClassIdx, "arg2": eArgN })
                    eFnOpsN = eFnOpsN + 1
                } else {
                    eOps = push(eOps, { "op": OP_NEW_INSTANCE, "arg": eClassIdx, "arg2": eArgN })
                    eOpsN = eOpsN + 1
                }
                dropCallCallee()
                return
            }
            eGenTmpl = null
            eFound = 0
            eGenI = 0
            while eGenI < len(eGenericTemplates) {
                if eGenericTemplates[eGenI]["sym"] == eGenSym {
                    eGenTmpl = eGenericTemplates[eGenI]
                    eFound = 1
                    break
                }
                eGenI = eGenI + 1
            }
            if eFound == 1 {
                eExplicit = eNode["typeArgs"]
                if eExplicit == undefined {
                    eExplicit = []
                }
                if len(eExplicit) > 0 {
                    eTypeArgs = arrUtil("snap",eExplicit)
                } else {
                    eTypeArgs = []
                    eResolveI = 0
                    while eResolveI < len(eArgs) {
                        eInferType = ""
                        if eArgs[eResolveI].kind == AST_LITERAL {
                            if eArgs[eResolveI].lit == LIT_NUMBER {
                                eInferType = "Number"
                            }
                            if eArgs[eResolveI].lit == LIT_STRING {
                                eInferType = "String"
                            }
                            if eArgs[eResolveI].lit == LIT_BOOL {
                                eInferType = "Bool"
                            }
                            if eArgs[eResolveI].lit == LIT_NULL {
                                eInferType = "Null"
                            }
                            if eArgs[eResolveI].lit == LIT_UNDEF {
                                eInferType = "Undefined"
                            }
                        }
                        if eInferType == "" {
                            if eArgs[eResolveI].kind == AST_VAR {
                                eBi = 0
                                while eBi < len(eBindingSyms) {
                                    if eBindingSyms[eBi] == eArgs[eResolveI]["sym"] {
                                        eInferType = eBindingTypes[eBi]
                                    }
                                    eBi = eBi + 1
                                }
                            }
                        }
                        if eInferType == "" {
                            throw "Cannot infer type for " + eGenSym
                        }
                        eTypeArgs = push(eTypeArgs, eInferType)
                        eResolveI = eResolveI + 1
                    }
                }
                eMangled = eGenSym
                if len(eTypeArgs) > 0 {
                    eMangled = eMangled + "$" + eTypeArgs[0]
                    eResolveI = 1
                    while eResolveI < len(eTypeArgs) {
                        eMangled = eMangled + "_" + eTypeArgs[eResolveI]
                        eResolveI = eResolveI + 1
                    }
                }
                eFound = 0
                eGenI = 0
                while eGenI < len(eSpecMangled) {
                    if eSpecMangled[eGenI] == eMangled {
                        eFound = 1
                        break
                    }
                    eGenI = eGenI + 1
                }
                if eFound == 0 {
                    eSaveInFn = eInFn
                    eSaveFnOps = arrUtil("snap",eFnOps)
                    eSaveFnLocals = arrUtil("snap",eFnLocals)
                    eSaveFnGlobals = arrUtil("snap",eFnGlobals)
                    eFnSave = eMangled
                    eParams = eGenTmpl["params"]
                    eFnBody = eGenTmpl["body"]
                    eInFn = 1
                    eFnOps = []
                    eFnOpsN = 0
                    eFnGlobals = []
                    eFnLocals = []
                    resetLocalMap()
                    eParamI = 0
                    while eParamI < len(eParams) {
                        eLoopSave = eParamI
                        symIndex("local",eParams[eParamI])
                        eParamI = eLoopSave + 1
                    }
                    emitStmt(eFnBody)
                    eFunctions = push(eFunctions, {
                        "sym": eFnSave,
                        "params": arrUtil("snap",eParams),
                        "locals": arrUtil("snap",eFnLocals),
                        "globals": arrUtil("snap",eFnGlobals),
                        "ops": arrUtil("snap",eFnOps)
                    })
                    symIndex("global",eFnSave)
                    eSpecMangled = push(eSpecMangled, eMangled)
                    eInFn = eSaveInFn
                    eFnOps = eSaveFnOps
                    eFnOpsN = len(eSaveFnOps)
                    eFnLocals = eSaveFnLocals
                    rebuildLocalMap()
                    eFnGlobals = eSaveFnGlobals
                }
                eCallee = { "kind": AST_VAR, "sym": eMangled }
            }
            eClassIdx = symIndex("class",eGenSym)
            if eClassIdx >= 0 {
                eArgN = len(eArgs)
                eCallArgIStack = push(eCallArgIStack, 0)
                eCallArgNStack = push(eCallArgNStack, eArgN)
                eArgsStack = push(eArgsStack, eArgs)
                emitCallArgExprs()
                if eInFn == 1 {
                    eFnOps = push(eFnOps, { "op": OP_NEW_INSTANCE, "arg": eClassIdx, "arg2": eArgN })
                    eFnOpsN = eFnOpsN + 1
                } else {
                    eOps = push(eOps, { "op": OP_NEW_INSTANCE, "arg": eClassIdx, "arg2": eArgN })
                    eOpsN = eOpsN + 1
                }
                dropCallCallee()
                return
            }
        }
        eArgN = len(eArgs)
        if eArgN == 0 {
            emitCallCallee()
            emitOp(OP_CALL, 0)
            return
        }
        if eArgN == 1 {
            eBxL = eArgs[0]
            if eBxL.kind == AST_LITERAL {
                eIdx = symIndex("constLit",eBxL)
                emitOp(OP_CONST, eIdx)
            } else {
                if eBxL.kind == AST_VAR {
                    eSym = eBxL["sym"]
                    emitSym(0,eSym)
                } else {
                    emitExpr(eBxL)
                }
            }
            emitCallCallee()
            emitOp(OP_CALL, 1)
            return
        }
        if eArgN == 2 {
            eBxL = eArgs[0]
            eBxR = eArgs[1]
            if eBxL.kind == AST_LITERAL {
                eIdx = symIndex("constLit",eBxL)
                emitOp(OP_CONST, eIdx)
            } else {
                if eBxL.kind == AST_VAR {
                    eSym = eBxL["sym"]
                    emitSym(0,eSym)
                } else {
                    emitExpr(eBxL)
                }
            }
            if eBxR.kind == AST_LITERAL {
                eIdx = symIndex("constLit",eBxR)
                emitOp(OP_CONST, eIdx)
            } else {
                if eBxR.kind == AST_VAR {
                    eSym = eBxR["sym"]
                    emitSym(0,eSym)
                } else {
                    emitExpr(eBxR)
                }
            }
            emitCallCallee()
            emitOp(OP_CALL, 2)
            return
        }
        eCallArgIStack = push(eCallArgIStack, 0)
        eCallArgNStack = push(eCallArgNStack, eArgN)
        eArgsStack = push(eArgsStack, eArgs)
        eCallArgDepth = eCallArgDepth + 1
        let cad = eCallArgDepth
        while eCallArgIStack[cad - 1] < eCallArgNStack[cad - 1] {
            eArgs = eArgsStack[cad - 1]
            eCallI = eCallArgIStack[cad - 1]
            eBxL = eArgs[eCallI]
            if eBxL.kind == AST_LITERAL {
                eIdx = symIndex("constLit",eBxL)
                emitOp(OP_CONST, eIdx)
            } else {
                if eBxL.kind == AST_VAR {
                    eSym = eBxL["sym"]
                    emitSym(0,eSym)
                } else {
                    emitExpr(eBxL)
                }
            }
            eCallArgIStack[cad - 1] = eCallArgIStack[cad - 1] + 1
        }
        eArgsStack = pop(eArgsStack)
        eArgN = eCallArgNStack[cad - 1]
        eCallArgIStack = pop(eCallArgIStack)
        eCallArgNStack = pop(eCallArgNStack)
        eCallArgDepth = eCallArgDepth - 1
        emitCallCallee()
        emitOp(OP_CALL, eArgN)
        return
    }
    throw "Unsupported expr: " + eNode.kind
}

// P6b: shared jump patch / len push — use op counters (avoid len(eOps) LoadGlobal clone).
fn patchRelJump(opName, idx) {
    if eInFn == 1 {
        eJumpOff = eFnOpsN - idx - 1
        eFnOps[idx] = { "op": opName, "arg": eJumpOff }
    } else {
        eJumpOff = eOpsN - idx - 1
        eOps[idx] = { "op": opName, "arg": eJumpOff }
    }
}

fn pushJmpAtLen(stack) {
    if eInFn == 1 {
        return push(stack, eFnOpsN)
    }
    return push(stack, eOpsN)
}

/// If stmt body (called early from emitStmt — dense leaves are If-heavy).
/// P6b: eIfDepth indexes If stacks (avoid len(eIf*/eCond*) LoadGlobal clones).
fn emitIfStmt() {
    eCondStack = push(eCondStack, eCond)
    eThenStack = push(eThenStack, eThen)
    eElseStack = push(eElseStack, eElse)
    eIfDepth = eIfDepth + 1
    let id = eIfDepth
    eCond = eNode["cond"]
    eThen = eNode["then"]
    eElse = eNode["elseBranch"]
    emitExpr(eCond)
    eIfJmpStack = pushJmpAtLen(eIfJmpStack)
    emitOp(OP_JUMP_IF_FALSE, 0)
    emitStmt(eThen)
    if eElse != null {
        eIfSkipStack = pushJmpAtLen(eIfSkipStack)
        emitOp(OP_JUMP, 0)
        eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
        patchRelJump(OP_JUMP_IF_FALSE, eJmp)
        eIfJmpStack = pop(eIfJmpStack)
        emitStmt(eElse)
        eIdx = eIfSkipStack[len(eIfSkipStack) - 1]
        patchRelJump(OP_JUMP, eIdx)
        eIfSkipStack = pop(eIfSkipStack)
    } else {
        eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
        patchRelJump(OP_JUMP_IF_FALSE, eJmp)
        eIfJmpStack = pop(eIfJmpStack)
    }
    eCond = eCondStack[id - 1]
    eThen = eThenStack[id - 1]
    eElse = eElseStack[id - 1]
    eCondStack = pop(eCondStack)
    eThenStack = pop(eThenStack)
    eElseStack = pop(eElseStack)
    eIfDepth = eIfDepth - 1
}

fn emitStmt(node) {
    eStmtNode = node
    eNode = node
    eStmtKind = eStmtNode.kind
    // P6b: check If before the long Let/Assign/… chain (serialize_body is If-dense).
    if eStmtKind == AST_IF {
        emitIfStmt()
        return
    }
    if eNode.kind == AST_LET {
        eAssignSym = eNode["sym"]
        eLitNode = eNode["init"]
        if eLitNode["kind"] == AST_LITERAL {
            if eLitNode["lit"] == LIT_NUMBER {
                eBindingSyms = push(eBindingSyms, eAssignSym)
                eBindingTypes = push(eBindingTypes, "Number")
            }
            if eLitNode["lit"] == LIT_STRING {
                eBindingSyms = push(eBindingSyms, eAssignSym)
                eBindingTypes = push(eBindingTypes, "String")
            }
        }
        if eLitNode["kind"] == AST_CALL {
            eCtorCallee = eLitNode["callee"]
            if eCtorCallee.kind == AST_VAR {
                eCtorName = eCtorCallee["sym"]
                eFound = 0
                eGenI = 0
                while eGenI < len(eClasses) {
                    if eClasses[eGenI]["sym"] == eCtorName {
                        eBindingSyms = push(eBindingSyms, eAssignSym)
                        eBindingTypes = push(eBindingTypes, eCtorName)
                        eFound = 1
                    }
                    eGenI = eGenI + 1
                }
                if eFound == 0 {
                    eGenTmpl = null
                    eGenI = 0
                    while eGenI < len(eGenericClassTemplates) {
                        if eGenericClassTemplates[eGenI]["sym"] == eCtorName {
                            eGenTmpl = eGenericClassTemplates[eGenI]
                        }
                        eGenI = eGenI + 1
                    }
                    if eGenTmpl != null {
                        eCtorArgs = eLitNode["args"]
                        eTypeArgs = []
                        eResolveI = 0
                        while eResolveI < len(eCtorArgs) {
                            eInferType = ""
                            if eCtorArgs[eResolveI].kind == AST_LITERAL {
                                if eCtorArgs[eResolveI].lit == LIT_NUMBER {
                                    eInferType = "Number"
                                }
                                if eCtorArgs[eResolveI].lit == LIT_STRING {
                                    eInferType = "String"
                                }
                            }
                            if eInferType != "" {
                                eTypeArgs = push(eTypeArgs, eInferType)
                            }
                            eResolveI = eResolveI + 1
                        }
                        eMangled = eCtorName
                        if len(eTypeArgs) > 0 {
                            eMangled = eMangled + "$" + eTypeArgs[0]
                            eResolveI = 1
                            while eResolveI < len(eTypeArgs) {
                                eMangled = eMangled + "_" + eTypeArgs[eResolveI]
                                eResolveI = eResolveI + 1
                            }
                        }
                        eBindingSyms = push(eBindingSyms, eAssignSym)
                        eBindingTypes = push(eBindingTypes, eMangled)
                    }
                }
            }
        }
        emitExpr(eNode["init"])
        if eInFn == 1 {
            eIdx = symIndex("local",eAssignSym)
            emitOp(OP_STORE_LOCAL, eIdx)
        } else {
            eIdx = symIndex("global",eAssignSym)
            emitOp(OP_STORE_GLOBAL, eIdx)
        }
        if eInFn != 1 {
            // Read isPub from the let stmt before emitExpr clobbers eNode.
            eLetPub = eStmtNode["isPub"]
            if eLetPub {
                eExports = push(eExports, ("" + eAssignSym) + "")
            }
        }
        return
    }
    if eNode.kind == AST_ASSIGN {
        eAssignSym = eNode["sym"]
        if tryEmitArrayPushAssign(eAssignSym, eNode["rhs"]) {
            return
        }
        if tryEmitAccAddAssign(eAssignSym, eNode["rhs"]) {
            return
        }
        emitExpr(eNode["rhs"])
        emitSym(1,eAssignSym)
        return
    }
    if eNode.kind == AST_INDEX_ASSIGN {
        eBxL = eNode["object"]
        eBxR = eNode["index"]
        eBxRhs = eNode["rhs"]
        emitExpr(eBxL)
        emitExpr(eBxR)
        emitExpr(eBxRhs)
        emitOp(OP_INDEX_SET, 0)
        emitOp(OP_POP, 0)
        emitOp(OP_POP, 0)
        return
    }
    if eNode.kind == AST_MEMBER_ASSIGN {
        eBxL = eNode["object"]
        eMemberFld = eNode["field"]
        eBxRhs = eNode["rhs"]
        emitExpr(eBxL)
        emitExpr(eBxRhs)
        eIdx = symIndex("const", eMemberFld)
        emitOp(OP_SET_MEMBER, eIdx)
        emitOp(OP_POP, 0)
        emitOp(OP_POP, 0)
        return
    }
    if eNode.kind == AST_EXPR {
        eExprStmt = eNode["expr"]
        emitExpr(eExprStmt)
        if eExprStmt.kind != AST_THROW {
            emitOp(OP_POP, 0)
        }
        return
    }
    if eNode.kind == AST_THROW {
        emitExpr(eNode["expr"])
        emitOp(OP_THROW, 0)
        return
    }
    if eNode.kind == AST_TRY {
        if eInFn != 1 {
            throw "try/catch only supported inside fn (self-host emit)"
        }
        let tryBody = eNode["body"]
        let tryHandler = eNode["handler"]
        let errName = eNode["errName"]
        let bodyStart = eFnOpsN
        emitStmt(tryBody)
        let bodyEnd = eFnOpsN
        // Statement try: jump over catch on success (throw uses tryRegions).
        emitOp(OP_JUMP, 0)
        let jmpEndIdx = bodyEnd
        let catchStart = eFnOpsN
        let errLocal = symIndex("local", errName)
        eFnTryRegions = push(eFnTryRegions, {
            "bodyStart": bodyStart,
            "bodyEnd": bodyEnd,
            "catchStart": catchStart,
            "errLocal": errLocal
        })
        emitOp(OP_STORE_LOCAL, errLocal)
        emitStmt(tryHandler)
        let afterCatch = eFnOpsN
        eFnOps[jmpEndIdx] = { "op": OP_JUMP, "arg": afterCatch - jmpEndIdx - 1 }
        return
    }
    if eNode.kind == AST_FOR_OF {
        if eInFn != 1 {
            throw "for-of only supported inside fn (self-host emit)"
        }
        let forSym = eNode["sym"]
        let forIter = eNode["iterable"]
        let forBody = eNode["body"]
        let n = eForCounter
        eForCounter = n + 1
        let src = "__kab_f" + n + "_src"
        let res = "__kab_f" + n + "_r"
        let srcIdx = symIndex("local", src)
        let resIdx = symIndex("local", res)
        let varIdx = symIndex("local", forSym)
        emitExpr(forIter)
        emitOp(OP_STORE_LOCAL, srcIdx)
        emitOp(OP_LOAD_LOCAL, srcIdx)
        emitOp(OP_LOAD_GLOBAL, symIndex("global", "iterator_begin"))
        emitOp(OP_CALL, 1)
        emitOp(OP_STORE_LOCAL, srcIdx)
        eBreakFromStack = arrUtil("pushLen", eBreakFromStack, eBreakIdxs)
        let loopStart = eFnOpsN
        eWhileHeads = push(eWhileHeads, loopStart)
        emitOp(OP_LOAD_LOCAL, srcIdx)
        emitOp(OP_ITER_STEP, 0)
        emitOp(OP_STORE_LOCAL, resIdx)
        emitOp(OP_STORE_LOCAL, srcIdx)
        emitOp(OP_LOAD_LOCAL, resIdx)
        emitOp(OP_CONST, symIndex("const", "done"))
        emitOp(OP_INDEX_GET, 0)
        let jmpDoneIdx = eFnOpsN
        emitOp(OP_JUMP_IF_FALSE, 0)
        let jmpExitIdx = eFnOpsN
        emitOp(OP_JUMP, 0)
        let bodyStart = eFnOpsN
        eFnOps[jmpDoneIdx] = { "op": OP_JUMP_IF_FALSE, "arg": bodyStart - jmpDoneIdx - 1 }
        emitOp(OP_LOAD_LOCAL, resIdx)
        emitOp(OP_CONST, symIndex("const", "value"))
        emitOp(OP_INDEX_GET, 0)
        emitOp(OP_STORE_LOCAL, varIdx)
        emitStmt(forBody)
        emitOp(OP_JUMP, loopStart - eFnOpsN - 1)
        let loopEnd = eFnOpsN
        eFnOps[jmpExitIdx] = { "op": OP_JUMP, "arg": loopEnd - jmpExitIdx - 1 }
        eBf = eBreakFromStack[len(eBreakFromStack) - 1]
        eBi = eBf
        while eBi < len(eBreakIdxs) {
            eJumpOff = loopEnd - eBreakIdxs[eBi] - 1
            eFnOps[eBreakIdxs[eBi]] = { "op": OP_JUMP, "arg": eJumpOff }
            eBi = eBi + 1
        }
        if eBf > 0 {
            eBreakIdxs = slice(eBreakIdxs, 0, eBf)
        } else {
            eBreakIdxs = []
        }
        if len(eWhileHeads) > 0 {
            eWhileHeads = pop(eWhileHeads)
        } else {
            eWhileHeads = []
        }
        if len(eBreakFromStack) > 0 {
            eBreakFromStack = pop(eBreakFromStack)
        } else {
            eBreakFromStack = []
        }
        return
    }
    if eNode.kind == AST_RETURN {
        if eNode["value"] == null {
            emitOp(OP_CONST, symIndex("const",null))
        } else {
            emitExpr(eNode["value"])
        }
        emitOp(OP_RETURN, 0)
        return
    }
    if eNode.kind == AST_BLOCK {
        eBlockStmtsStack = push(eBlockStmtsStack, eNode["body"])
        eBlockNStack = arrUtil("pushLen",eBlockNStack, eNode["body"])
        eBlockIStack = push(eBlockIStack, 0)
        eBlockDepth = eBlockDepth + 1
        let bd = eBlockDepth
        while eBlockIStack[bd - 1] < eBlockNStack[bd - 1] {
            eBlockStmts = eBlockStmtsStack[bd - 1]
            eBlockI = eBlockIStack[bd - 1]
            eStmtNode = eBlockStmts[eBlockI]
            if eStmtNode == null {
                throw "emit block null stmt at " + ("" + eBlockI)
            }
            emitStmt(eStmtNode)
            eBlockIStack[bd - 1] = eBlockIStack[bd - 1] + 1
        }
        eBlockStmtsStack = pop(eBlockStmtsStack)
        eBlockNStack = pop(eBlockNStack)
        eBlockIStack = pop(eBlockIStack)
        eBlockDepth = eBlockDepth - 1
        return
    }
    if eNode.kind == AST_CONTINUE {
        if len(eWhileHeads) == 0 {
            throw "continue outside loop"
        }
        eWh = eWhileHeads[len(eWhileHeads) - 1]
        if eInFn == 1 {
            eJumpOff = eWh - eFnOpsN - 1
        } else {
            eJumpOff = eWh - eOpsN - 1
        }
        emitOp(OP_JUMP, eJumpOff)
        return
    }
    if eNode.kind == AST_BREAK {
        if len(eBreakFromStack) == 0 {
            throw "break outside loop"
        }
        eBreakIdxs = pushJmpAtLen(eBreakIdxs)
        emitOp(OP_JUMP, 0)
        return
    }
    if eNode.kind == AST_WHILE {
        eCond = eNode["cond"]
        eThen = eNode["body"]
        eBreakFromStack = arrUtil("pushLen",eBreakFromStack, eBreakIdxs)
        if eInFn == 1 {
            eWhileHead = eFnOpsN
        } else {
            eWhileHead = eOpsN
        }
        eWhileHeads = push(eWhileHeads, eWhileHead)
        emitExpr(eCond)
        eIfJmpStack = pushJmpAtLen(eIfJmpStack)
        emitOp(OP_JUMP_IF_FALSE, 0)
        emitStmt(eThen)
        if eInFn == 1 {
            eJumpOff = eWhileHead - eFnOpsN - 1
        } else {
            eJumpOff = eWhileHead - eOpsN - 1
        }
        emitOp(OP_JUMP, eJumpOff)
        eJmp = eIfJmpStack[len(eIfJmpStack) - 1]
        patchRelJump(OP_JUMP_IF_FALSE, eJmp)
        eIfJmpStack = pop(eIfJmpStack)
        if eInFn == 1 {
            eEnd = eFnOpsN
        } else {
            eEnd = eOpsN
        }
        eBf = eBreakFromStack[len(eBreakFromStack) - 1]
        eBi = eBf
        while eBi < len(eBreakIdxs) {
            eJumpOff = eEnd - eBreakIdxs[eBi] - 1
            if eInFn == 1 {
                eFnOps[eBreakIdxs[eBi]] = { "op": OP_JUMP, "arg": eJumpOff }
            } else {
                eOps[eBreakIdxs[eBi]] = { "op": OP_JUMP, "arg": eJumpOff }
            }
            eBi = eBi + 1
        }
        if eBf > 0 {
            eBreakIdxs = slice(eBreakIdxs, 0, eBf)
        } else {
            eBreakIdxs = []
        }
        if len(eWhileHeads) > 0 {
            eWhileHeads = pop(eWhileHeads)
        } else {
            eWhileHeads = []
        }
        if len(eBreakFromStack) > 0 {
            eBreakFromStack = pop(eBreakFromStack)
        } else {
            eBreakFromStack = []
        }
        return
    }
    if eNode.kind == AST_ENUM {
        eTypeParams = eNode["typeParams"]
        if eTypeParams == undefined {
            eTypeParams = []
        }
        if len(eTypeParams) > 0 {
            eGenericEnumTemplates = push(eGenericEnumTemplates, {
                "sym": eNode["sym"],
                "typeParams": arrUtil("snap",eTypeParams),
                "variants": arrUtil("snap",eNode["variants"])
            })
        }
        return
    }
    if eNode.kind == AST_CLASS {
        eFnSave = "" + eNode["sym"]
        eTypeParams = eNode["typeParams"]
        if eTypeParams == undefined {
            eTypeParams = []
        }
        if len(eTypeParams) > 0 {
            eGenericClassTemplates = push(eGenericClassTemplates, {
                "sym": eFnSave,
                "typeParams": arrUtil("snap",eTypeParams),
                "methods": arrUtil("snap",eNode["methods"])
            })
            return
        }
        // Snap before emitStmt — emitStmt overwrites module-global eNode.
        eClassMethodsSrc = eNode["methods"]
        eClassIsStruct = eNode["isStruct"]
        eClassMethods = []
        eMi = 0
        while eMi < len(eClassMethodsSrc) {
            eMeth = eClassMethodsSrc[eMi]
            eMethTypeParams = eMeth["typeParams"]
            if eMethTypeParams == undefined {
                eMethTypeParams = []
            }
            if len(eMethTypeParams) > 0 {
                eGenericMethodTemplates = push(eGenericMethodTemplates, {
                    "classSym": eFnSave,
                    "methodSym": eMeth["sym"],
                    "typeParams": arrUtil("snap",eMethTypeParams),
                    "params": arrUtil("snap",eMeth["params"]),
                    "body": eMeth["body"]
                })
            } else {
                eInFn = 1
                eFnOps = []
                eFnOpsN = 0
                eFnGlobals = []
                eFnLocals = []
                resetLocalMap()
                eParams = eMeth["params"]
                eParamI = 0
                while eParamI < len(eParams) {
                    eLoopSave = eParamI
                    symIndex("local",eParams[eParamI])
                    eParamI = eLoopSave + 1
                }
                emitStmt(eMeth["body"])
                eClassMethods = push(eClassMethods, {
                    "sym": eMeth["sym"],
                    "params": arrUtil("snap",eParams),
                    "locals": arrUtil("snap",eFnLocals),
                    "globals": arrUtil("snap",eFnGlobals),
                    "ops": arrUtil("snap",eFnOps)
                })
                eInFn = 0
            }
            eMi = eMi + 1
        }
        eClasses = push(eClasses, {
            "sym": eFnSave,
            "methods": eClassMethods,
            "isStruct": eClassIsStruct
        })
        return
    }
    if eNode.kind == AST_INTERFACE {
        return
    }
    if eNode.kind == AST_FN {
        eFnSave = "" + eNode["sym"]
        eFnPub = eNode["isPub"]
        eParams = eNode["params"]
        eFnBody = eNode["body"]
        eTypeParams = eNode["typeParams"]
        if eTypeParams == undefined {
            eTypeParams = []
        }
        if len(eTypeParams) > 0 {
            eGenericTemplates = push(eGenericTemplates, {
                "sym": eFnSave,
                "typeParams": arrUtil("snap",eTypeParams),
                "params": arrUtil("snap",eParams),
                "body": eFnBody,
                "isPub": eFnPub
            })
            if eFnPub == 1 {
                eExports = push(eExports, ("" + eFnSave) + "")
            }
            return
        }
        eInFn = 1
        eFnOps = []
        eFnOpsN = 0
        eFnGlobals = []
        eFnLocals = []
        resetLocalMap()
        eFnTryRegions = []
        eParamI = 0
        while eParamI < len(eParams) {
            eLoopSave = eParamI
            symIndex("local",eParams[eParamI])
            eParamI = eLoopSave + 1
        }
        emitStmt(eFnBody)
        eFunctions = push(eFunctions, {
            "sym": eFnSave,
            "params": arrUtil("snap",eParams),
            "locals": arrUtil("snap",eFnLocals),
            "globals": arrUtil("snap",eFnGlobals),
            "ops": arrUtil("snap",eFnOps),
            "tryRegions": arrUtil("snap", eFnTryRegions)
        })
        eInFn = 0
        eFnTryRegions = []
        symIndex("global",eFnSave)
        if eFnPub == 1 {
            eExports = push(eExports, ("" + eFnSave) + "")
        }
        return
    }
    if eNode == null {
        throw "emitStmt: null node"
    }
    if eNode.kind == undefined {
        throw "emitStmt: missing kind"
    }
    throw "Unsupported stmt: " + eStmtKind
}

pub fn emitImpl(program) {
    eProgram = program
    eConsts = []
    eConstMap = {}
    eConstN = 0
    eOps = []
    eOpsN = 0
    eGlobals = []
    eGlobalMap = {}
    eGlobalN = 0
    eFunctions = []
    eFnOps = []
    eFnOpsN = 0
    eBlockDepth = 0
    eCalleeDepth = 0
    eCallArgDepth = 0
    eObjDepth = 0
    eArrDepth = 0
    eIfDepth = 0
    eMemberDepth = 0
    eIndexDepth = 0
    eFnGlobals = []
    eFnLocals = []
    resetLocalMap()
    eInFn = 0
    eWhileHeads = []
    eBreakIdxs = []
    eBreakFromStack = []
    eIfJmpStack = []
    eIfSkipStack = []
    eMemberFldStack = []
    eBlockStmtsStack = []
    eBlockNStack = []
    eBlockIStack = []
    eObjIStack = []
    eObjNStack = []
    eArrIStack = []
    eArrNStack = []
    eCallArgIStack = []
    eCallArgNStack = []
    eArgsStack = []
    eCalleeStack = []
    eGenericTemplates = []
    eGenericClassTemplates = []
    eGenericEnumTemplates = []
    eGenericMethodTemplates = []
    eClasses = []
    eEnums = []
    eArrows = []
    eTryRegions = []
    eFnTryRegions = []
    eForCounter = 0
    eSpecMangled = []
    eBindingSyms = []
    eBindingTypes = []
    eExports = []
    eImports = []
    eProg = 0
    if eProgram["imports"] != undefined {
        eImports = eProgram["imports"]
    }
    eBlockStmtsStack = push(eBlockStmtsStack, eProgram["body"])
    eBlockNStack = arrUtil("pushLen",eBlockNStack, eProgram["body"])
    eBlockIStack = push(eBlockIStack, 0)
    eBlockDepth = eBlockDepth + 1
    let pd = eBlockDepth
    while eBlockIStack[pd - 1] < eBlockNStack[pd - 1] {
        eBlockStmts = eBlockStmtsStack[pd - 1]
        eBlockI = eBlockIStack[pd - 1]
        eStmtNode = eBlockStmts[eBlockI]
        if eStmtNode == null {
            throw "emit program null stmt at " + ("" + eBlockI)
        }
        emitStmt(eStmtNode)
        eBlockIStack[pd - 1] = eBlockIStack[pd - 1] + 1
    }
    eBlockDepth = eBlockDepth - 1
    emitOp(OP_HALT, 0)
    return {
        "constants": eConsts,
        "globals": eGlobals,
        "ops": eOps,
        "functions": eFunctions,
        "classes": eClasses,
        "enums": eEnums,
        "arrows": eArrows,
        "tryRegions": eTryRegions,
        "locals": [],
        "genericMethodTemplates": eGenericMethodTemplates,
        "exports": eExports,
        "imports": eImports
    }
}
