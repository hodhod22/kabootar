// P6b: escape helper (skip-listed until ≤10s).
pub fn serEscStr(s) {
    let out = ""
    let i = 0
    let n = len(s)
    while i < n {
        let ch = char_at(s, i)
        let piece = ch
        if ch == "\\" {
            piece = "\\\\"
        }
        if ch == " " {
            piece = "\\s"
        }
        if ch == "\n" {
            piece = "\\n"
        }
        if ch == "\r" {
            piece = "\\r"
        }
        if ch == "\t" {
            piece = "\\t"
        }
        out = out + piece
        i = i + 1
    }
    return out
}
