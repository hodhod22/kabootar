// Test suite for self-hosted .kbc serialization

import "self_host/lexer"
import "self_host/parser"
import "self_host/emit"
import "self_host/serialize"
import "self_host/serialize_defs"
import "self_host/emit_defs"

let passed = 0
let fail = 0
let tText = ""
let tI = 0
let tHas = 0

fn assert_eq(a, b, msg) {
    if a == b {
        passed = passed + 1
    } else {
        fail = fail + 1
        println("FAIL: " + msg + " -- expected " + json_stringify(b) + ", got " + json_stringify(a))
    }
}

fn assert_true(v, msg) {
    if v {
        passed = passed + 1
    } else {
        fail = fail + 1
        println("FAIL: " + msg)
    }
}

// -- header + main code --------------------------------------------
{
    let bc = emit(parseTokens(tokenize("let x = 1; return x")))
    tText = serialize_bc(bc)
    assert_true(char_at(tText, 0) == "k", "text starts with k")
    assert_true(len(tText) > 20, "non-trivial output")
}

// -- function section ----------------------------------------------
{
    let bc = emit(parseTokens(tokenize("fn add(a, b) { return a + b }")))
    tText = serialize_bc(bc)
    assert_true(tText != "", "fn serialize non-empty")
    assert_eq(len(bc.functions), 1, "fn count in ir")
}

// -- undefined const serializes as `undefined` not `null` ----------
{
    let bc = emit(parseTokens(tokenize("if kw == undefined { return 1 }")))
    tText = serialize_bc(bc)
    assert_true(len(tText) > 0, "undefined compare serializes")
    tHas = 0
    tI = 0
    while tI < len(bc.constants) {
        if bc.constants[tI] == KAB_UNDEF_CONST {
            tHas = 1
        }
        tI = tI + 1
    }
    assert_eq(tHas, 1, "undefined const in pool")
    assert_true(str_index_of(tText, "undefined") >= 0, "text contains undefined const")
}

println("")
println("Self-hosted serialize tests: " + ("" + passed) + " passed, " + ("" + fail) + " failed")
if fail > 0 {
    throw "SERIALIZE TESTS FAILED"
}
