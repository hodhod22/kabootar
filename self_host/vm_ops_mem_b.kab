// P6b: VM mem half-facade b.
import "self_host/vm_ops_mem_global"
import "self_host/vm_ops_mem_array_push"

pub fn runOpMemB(S, name, arg, op, pool, globals, functions) {
    let st = runOpMemGlobal(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpMemArrayPush(S, name, arg, op, pool, globals, functions)
}
