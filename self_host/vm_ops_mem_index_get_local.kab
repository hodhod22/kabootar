import "self_host/vm_s_push"
import "self_host/vm_s_pop"
import "self_host/vm_s_ip"

pub fn runOpMemIndexGetLocal(S, name, arg, op, pool, globals, functions) {
    if name == "index_get_local" {
        let idx = vPopS(S)
        vPushS(S, S["locals"][arg][idx])
        vBumpIpS(S)
        return 1
    }
    return 0
}
