// P6b: op/list append helpers (skip-listed until ≤10s).
import "self_host/lexer_defs"
import "self_host/serialize_ir_line"
import "self_host/serialize_out"

/// Typed i64 AccAdd-loop (SH9 serialize): host Cranelift can compile this helper.
pub fn serCount(n) {
    let i = 0
    let s = 0
    while i < n {
        s = s + 1
        i = i + 1
    }
    return s
}

pub fn serAppendTaggedOps(out, tag, i, ops) {
    let j = 0
    let n = len(ops)
    if serCount(n) != n {
        throw "serialize tagged op count mismatch"
    }
    while j < n {
        out = serOutTagged(out, tag, i, serIrOpLine(ops[j]))
        j = j + 1
    }
    return out
}

pub fn serAppendOps(out, ops) {
    let i = 0
    let n = len(ops)
    if serCount(n) != n {
        throw "serialize op count mismatch"
    }
    while i < n {
        out = out + CHAR_NL + serIrOpLine(ops[i])
        i = i + 1
    }
    return out
}
