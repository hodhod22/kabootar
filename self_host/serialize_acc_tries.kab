// P6b: main try-region appender (skip-listed until ≤10s).
import "self_host/serialize_out"

pub fn serAppendMainTries(out, tryRegions) {
    if tryRegions == undefined {
        return out
    }
    let i = 0
    let nMtr = len(tryRegions)
    while i < nMtr {
        out = serOutTry4(out, "main_try_region", i, tryRegions[i])
        i = i + 1
    }
    return out
}
