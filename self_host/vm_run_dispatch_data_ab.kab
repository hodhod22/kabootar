// P6b: 2-way dispatch chain (≤10s self-host compile).
import "self_host/vm_ops_data_a"
import "self_host/vm_ops_data_b"

pub fn runOpDataAb(S, name, arg, op, pool, globals, functions) {
    let st = runOpDataA(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpDataB(S, name, arg, op, pool, globals, functions)
}
