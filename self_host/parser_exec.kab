// SH2/SH13: one session object, reset in-place. Tramp is 0-arg and reads gSess.
import "self_host/parser_session"
import "self_host/parser_tramp"
import "self_host/parser_main"

let gSess = null

fn tramp() {
    return pTramp(gSess)
}

pub fn parseTokensExec(tokens) {
    let sess = gSess
    if sess == null {
        sess = pMakeSession()
        gSess = sess
        sess["tramp"] = tramp
    } else {
        pResetSession(sess)
        sess["tramp"] = tramp
    }
    sess["_hook"] = 0
    return parseMain(sess, tokens)
}
