// SH2/SH13: reuse session; tramp takes sess (do not read gSess — LoadGlobal IC can stale).
// SH5: parseMain + pTramp + session + postfix live here (was parser_main / parser_tramp /
// parser_session / parser_postfix — compile-DAG 9 -> 8).
// SH6: yield e * 10 (mul loop); resume must not load tryRegions (breaks yield pause).
import "self_host/ast_defs"
import "self_host/lexer_scan"
import "self_host/parser_stmt"

fn pSessionInit_core(sess) {
    sess["pPos"] = 0
    sess["pToks"] = []
    sess["pToksLen"] = 0
    sess["pCur"] = null
    sess["pEofTok"] = { "type": "EOF", "value": null, "line": 1, "column": 1 }
    sess["pTok"] = null
    sess["pNextTok"] = null
    sess["pDone"] = 0
    sess["pSymPool"] = []
    sess["pSymN"] = 0
    sess["pSymOut"] = ""
    sess["pSymSrc"] = ""
    sess["pSymI"] = 0
    sess["pPopI"] = 0
    sess["pPopNew"] = []
    sess["pImports"] = []
    sess["pIsPub"] = 0
    sess["pFnPub"] = 0
    sess["pInAddSub"] = 0
    sess["pNoBit"] = 0
    return 0
}

fn pSessionInit_expr(sess) {
    sess["pLeft"] = null
    sess["pRight"] = null
    sess["pArgs"] = []
    sess["pIdent"] = null
    sess["pInit"] = null
    sess["pVal"] = null
    sess["pCallee"] = null
    sess["pObjFields"] = []
    sess["pSave"] = null
    sess["pAssignLhs"] = null
    sess["pBinOp"] = ""
    sess["pSaveSym"] = ""
    sess["pBindSym"] = ""
    sess["pExprLeft"] = null
    sess["pAddLeft"] = null
    sess["pAddLeftStack"] = []
    sess["pTypeArgs"] = []
    sess["pSnapTypeArgs"] = []
    sess["pIsGenericCallee"] = 0
    sess["pAngleI"] = 0
    sess["pAngleTok"] = null
    sess["pAngleOut"] = []
    sess["pMemberName"] = ""
    sess["pPendingArrowAsync"] = 0
    return 0
}

fn pSessionInit_stmt(sess) {
    sess["pBody"] = []
    sess["pBodyStack"] = []
    sess["pStmts"] = []
    sess["pParams"] = []
    sess["pParamDefaults"] = []
    sess["pFnRest"] = ""
    sess["pCond"] = null
    sess["pCondStack"] = []
    sess["pThen"] = null
    sess["pElse"] = null
    sess["pLoopBody"] = []
    sess["pFnSym"] = ""
    sess["pLetSym"] = ""
    sess["pBodyDepth"] = 0
    sess["pCondDepth"] = 0
    return 0
}

fn pSessionInit_type(sess) {
    sess["pTypeParams"] = []
    sess["pParamTypes"] = []
    sess["pReturnType"] = ""
    sess["pVariants"] = []
    sess["pClassFields"] = []
    sess["pClassMethods"] = []
    sess["pFieldType"] = ""
    sess["pFieldDefault"] = null
    sess["pVariantFields"] = []
    sess["pMethTypeParams"] = []
    sess["pMethParams"] = []
    sess["pMethParamTypes"] = []
    sess["pMethParamDefaults"] = []
    sess["pMethRest"] = ""
    sess["pVariantName"] = ""
    sess["pVariantSym"] = ""
    sess["pEnumSym"] = ""
    sess["pClassSym"] = ""
    sess["pIsStruct"] = 0
    sess["pIfaceSym"] = ""
    sess["pIfaceMethods"] = []
    sess["pAssocTypes"] = []
    sess["pWhereClause"] = []
    sess["pWhereParam"] = ""
    sess["pWhereTrait"] = ""
    sess["pParamType"] = ""
    sess["pImplements"] = []
    sess["pClassAssoc"] = []
    return 0
}

pub fn pMakeSession() {
    let sess = {}
    pSessionInit_core(sess)
    pSessionInit_expr(sess)
    pSessionInit_stmt(sess)
    pSessionInit_type(sess)
    return sess
}

pub fn pResetSession(sess) {
    pSessionInit_core(sess)
    pSessionInit_expr(sess)
    pSessionInit_stmt(sess)
    pSessionInit_type(sess)
    return 0
}

let gSess = null

fn parseTypeArgs_scan(sess) {
    if sess["pCur"].type != "<" {
        return 0
    }
    sess["pAngleI"] = sess["pPos"] + 1
    if sess["pAngleI"] >= sess["pToksLen"] {
        return 0
    }
    sess["pAngleTok"] = sess["pToks"][sess["pAngleI"]]
    if sess["pAngleTok"].type != TOKEN_IDENT {
        return 0
    }
    sess["pAngleI"] = sess["pAngleI"] + 1
    while sess["pAngleI"] < sess["pToksLen"] {
        sess["pAngleTok"] = sess["pToks"][sess["pAngleI"]]
        if sess["pAngleTok"].type == ">" {
            break
        }
        if sess["pAngleTok"].type == "<" {
            return 0
        }
        if sess["pAngleTok"].type == "," {
            sess["pAngleI"] = sess["pAngleI"] + 1
        } else {
            if sess["pAngleTok"].type == TOKEN_IDENT {
                sess["pAngleI"] = sess["pAngleI"] + 1
            } else {
                return 0
            }
        }
    }
    if sess["pAngleI"] >= sess["pToksLen"] {
        return 0
    }
    if sess["pToks"][sess["pAngleI"]].type != ">" {
        return 0
    }
    return 1
}

pub fn parseTypeArgs(sess) {
    if parseTypeArgs_scan(sess) == 0 {
        return []
    }
    bump(sess)
    sess["pAngleOut"] = []
    while sess["pCur"].type != ">" {
        sess["pTok"] = sess["pCur"]
        if sess["pTok"].type != TOKEN_IDENT {
            throw "Expected type name"
        }
        bump(sess)
        sess["pAngleOut"] = push(sess["pAngleOut"], poolPush(sess, sess["pTok"].value))
        if sess["pCur"].type == "," {
            bump(sess)
        }
    }
    if sess["pCur"].type != ">" {
        throw "Expected >"
    }
    bump(sess)
    return sess["pAngleOut"]
}

pub fn pTramp(sess) {
    if sess["_hook"] == 1 {
        return parseTypeArgs(sess)
    }
    if sess["_hook"] == 0 {
        return parsePostfix(sess)
    }
    if sess["_hook"] == 2 {
        return parseUnary(sess)
    }
    if sess["_hook"] == 3 {
        return parseMul(sess)
    }
    if sess["_hook"] == 4 {
        return parseAddShift(sess)
    }
    if sess["_hook"] == 5 {
        return parseRelExpr(sess)
    }
    if sess["_hook"] == 6 {
        return parseCompare(sess)
    }
    if sess["_hook"] == 7 {
        return parseStmt(sess)
    }
    if sess["_hook"] == 8 {
        return parseMatchPat(sess)
    }
    throw "parser tramp: bad hook " + ("" + sess["_hook"])
}

fn tramp(sess) {
    return pTramp(sess)
}

pub fn parseMain(sess, tokens) {
    sess["pToks"] = tokens
    sess["pToksLen"] = len(tokens)
    sess["pPos"] = 0
    if sess["pToksLen"] > 0 {
        sess["pCur"] = sess["pToks"][0]
    } else {
        sess["pCur"] = sess["pEofTok"]
    }
    sess["pSymPool"] = []
    sess["pSymN"] = 0
    sess["pImports"] = []
    sess["pCondStack"] = []
    sess["pCondDepth"] = 0
    sess["pAddLeftStack"] = []
    sess["pBodyStack"] = push([], sess["pBody"])
    sess["pBodyDepth"] = 1
    sess["pBody"] = []
    sess["pDone"] = 0
    let n = 0
    while sess["pDone"] == 0 {
        n = n + 1
        if n > 1000000 {
            throw "parser runaway"
        }
        if sess["pPos"] >= sess["pToksLen"] {
            sess["pDone"] = 1
        }
        if sess["pDone"] == 0 {
            sess["pTok"] = sess["pCur"]
            if sess["pTok"].type == "EOF" {
                sess["pDone"] = 1
            }
        }
        if sess["pDone"] == 0 {
            let importNext = ""
            if sess["pPos"] + 1 < sess["pToksLen"] {
                importNext = sess["pToks"][sess["pPos"] + 1].type
            }
            if sess["pTok"].type == TOKEN_IMPORT && importNext == TOKEN_STRING {
                bump(sess)
                sess["pTok"] = sess["pCur"]
                bump(sess)
                sess["pImports"] = push(sess["pImports"], sess["pTok"].value)
                if sess["pCur"].type == ";" {
                    bump(sess)
                }
            } else {
                sess["pVal"] = pCallStmt(sess)
                if sess["pVal"] != null {
                    sess["pBody"] = push(sess["pBody"], sess["pVal"])
                }
            }
            if sess["pCur"].type == ";" {
                bump(sess)
            }
        }
    }
    let programBody = sess["pBody"]
    let st = sess["pBodyStack"]
    sess["pBody"] = st[len(st) - 1]
    sess["pBodyStack"] = slice(st, 0, len(st) - 1)
    sess["pBodyDepth"] = sess["pBodyDepth"] - 1
    return { "kind": AST_PROGRAM, "body": programBody, "imports": sess["pImports"] }
}

pub fn parseTokensExec(tokens) {
    let sess = gSess
    if sess == null {
        sess = pMakeSession()
        gSess = sess
        sess["tramp"] = tramp
    } else {
        pResetSession(sess)
        sess["tramp"] = tramp
    }
    sess["_hook"] = 0
    return parseMain(sess, tokens)
}

// SH5: unary/mul/add-shift/rel/compare (was parser_expr).
pub fn parseUnary(sess) {
    if sess["pCur"].type == "!" {
        bump(sess)
        sess["pLeft"] = { "kind": AST_UNARY, "op": "!", "expr": pCallUnary(sess) }
        return sess["pLeft"]
    }
    if sess["pCur"].type == "-" {
        bump(sess)
        sess["pLeft"] = { "kind": AST_UNARY, "op": "-", "expr": pCallUnary(sess) }
        return sess["pLeft"]
    }
    if sess["pCur"].type == "~" {
        bump(sess)
        sess["pLeft"] = { "kind": AST_UNARY, "op": "~", "expr": pCallUnary(sess) }
        return sess["pLeft"]
    }
    if sess["pCur"].type == TOKEN_NOT {
        bump(sess)
        sess["pLeft"] = { "kind": AST_UNARY, "op": "!", "expr": pCallUnary(sess) }
        return sess["pLeft"]
    }
    if sess["pCur"].type == TOKEN_DELETE {
        bump(sess)
        sess["pLeft"] = { "kind": AST_UNARY, "op": "delete", "expr": pCallUnary(sess) }
        return sess["pLeft"]
    }
    if sess["pCur"].type == TOKEN_AWAIT {
        bump(sess)
        sess["pLeft"] = { "kind": AST_UNARY, "op": "await", "expr": pCallUnary(sess) }
        return sess["pLeft"]
    }
    if sess["pCur"].type == TOKEN_YIELD {
        bump(sess)
        if sess["pCur"].type == "*" {
            bump(sess)
            sess["pLeft"] = { "kind": AST_UNARY, "op": "yield_star", "expr": pCallUnary(sess) }
            return sess["pLeft"]
        }
        let yExpr = pCallUnary(sess)
        while sess["pCur"].type == "*" || sess["pCur"].type == "/" || sess["pCur"].type == "%" || sess["pCur"].type == "**" {
            let yOp = sess["pCur"].type
            bump(sess)
            yExpr = { "kind": AST_BINARY, "op": yOp, "left": yExpr, "right": pCallUnary(sess) }
        }
        sess["pLeft"] = { "kind": AST_UNARY, "op": "yield", "expr": yExpr }
        return sess["pLeft"]
    }
    return pCallPostfix(sess)
}

pub fn parseMul(sess) {
    sess["pLeft"] = pCallUnary(sess)
    while sess["pCur"].type == "*" || sess["pCur"].type == "/" || sess["pCur"].type == "%" || sess["pCur"].type == "**" {
        let op = sess["pCur"].type
        bump(sess)
        let left = sess["pLeft"]
        let right = pCallUnary(sess)
        sess["pLeft"] = { "kind": AST_BINARY, "op": op, "left": left, "right": right }
    }
    return sess["pLeft"]
}

pub fn parseAddShift_plus(sess) {
    // P6b: one loop for +/- so `a - b + c` does not leave `+ c` unparsed.
    while sess["pCur"].type == "+" || sess["pCur"].type == "-" {
        let op = sess["pCur"].type
        bump(sess)
        let left = sess["pLeft"]
        let right = pCallMul(sess)
        while sess["pCur"].type == "<<" || sess["pCur"].type == ">>" || sess["pCur"].type == ">>>" {
            let shOp = sess["pCur"].type
            bump(sess)
            right = { "kind": AST_BINARY, "op": shOp, "left": right, "right": pCallMul(sess) }
        }
        sess["pLeft"] = { "kind": AST_BINARY, "op": op, "left": left, "right": right }
    }
    return 0
}

pub fn parseAddShift_shift(sess) {
    while sess["pCur"].type == "<<" || sess["pCur"].type == ">>" || sess["pCur"].type == ">>>" {
        let op = sess["pCur"].type
        bump(sess)
        let left = sess["pLeft"]
        let right = pCallMul(sess)
        // JS: + binds tighter than << — allow +/- on shift RHS.
        while sess["pCur"].type == "+" || sess["pCur"].type == "-" {
            let addOp = sess["pCur"].type
            bump(sess)
            right = { "kind": AST_BINARY, "op": addOp, "left": right, "right": pCallMul(sess) }
        }
        sess["pLeft"] = { "kind": AST_BINARY, "op": op, "left": left, "right": right }
    }
    return 0
}

pub fn parseAddShift(sess) {
    sess["pLeft"] = pCallMul(sess)
    parseAddShift_plus(sess)
    parseAddShift_shift(sess)
    return sess["pLeft"]
}

pub fn parseRelExpr(sess) {
    sess["pLeft"] = pCallAddShift(sess)
    while sess["pCur"].type == "==" || sess["pCur"].type == "!=" || sess["pCur"].type == "<" || sess["pCur"].type == ">" || sess["pCur"].type == ">=" || sess["pCur"].type == "<=" || sess["pCur"].type == TOKEN_IN {
        let op = sess["pCur"].type
        bump(sess)
        let left = sess["pLeft"]
        let right = pCallAddShift(sess)
        sess["pLeft"] = { "kind": AST_BINARY, "op": op, "left": left, "right": right }
    }
    return sess["pLeft"]
}

pub fn parseCompare_bit(sess) {
    if sess["pNoBit"] == 0 {
        while sess["pCur"].type == "&" {
            bump(sess)
            let left = sess["pLeft"]
            let right = pCallRelExpr(sess)
            sess["pLeft"] = { "kind": AST_BINARY, "op": "&", "left": left, "right": right }
        }
        while sess["pCur"].type == "^" {
            bump(sess)
            let left = sess["pLeft"]
            let right = pCallRelExpr(sess)
            sess["pLeft"] = { "kind": AST_BINARY, "op": "^", "left": left, "right": right }
        }
        while sess["pCur"].type == "|" {
            bump(sess)
            let left = sess["pLeft"]
            let right = pCallRelExpr(sess)
            sess["pLeft"] = { "kind": AST_BINARY, "op": "|", "left": left, "right": right }
        }
    }
    return 0
}

pub fn parseCompare_eq(sess) {
    while sess["pCur"].type == "==" || sess["pCur"].type == "!=" || sess["pCur"].type == "<" || sess["pCur"].type == ">" || sess["pCur"].type == ">=" || sess["pCur"].type == "<=" || sess["pCur"].type == TOKEN_IS || sess["pCur"].type == TOKEN_IN {
        let op = sess["pCur"].type
        bump(sess)
        if op == TOKEN_IS {
            if sess["pCur"].type == TOKEN_NOT {
                bump(sess)
                op = "is not"
            } else {
                op = "is"
            }
        }
        let left = sess["pLeft"]
        let right = pCallRelExpr(sess)
        sess["pLeft"] = { "kind": AST_BINARY, "op": op, "left": left, "right": right }
    }
    return 0
}

pub fn parseCompare_logic_and(sess) {
    while sess["pCur"].type == "&&" {
        bump(sess)
        let left = sess["pLeft"]
        let right = pCallRelExpr(sess)
        if sess["pNoBit"] == 0 {
            while sess["pCur"].type == "&" || sess["pCur"].type == "^" || sess["pCur"].type == "|" {
                let op = sess["pCur"].type
                bump(sess)
                right = { "kind": AST_BINARY, "op": op, "left": right, "right": pCallRelExpr(sess) }
            }
        }
        sess["pLeft"] = { "kind": AST_BINARY, "op": "&&", "left": left, "right": right }
    }
    return 0
}

pub fn parseCompare_logic_or_bit(sess) {
    if sess["pNoBit"] != 0 {
        return 0
    }
    while sess["pCur"].type == "&" || sess["pCur"].type == "^" || sess["pCur"].type == "|" {
        let op = sess["pCur"].type
        bump(sess)
        sess["pRight"] = { "kind": AST_BINARY, "op": op, "left": sess["pRight"], "right": pCallRelExpr(sess) }
    }
    return 0
}

pub fn parseCompare_logic_or_and(sess) {
    while sess["pCur"].type == "&&" {
        bump(sess)
        let andLeft = sess["pRight"]
        let andRight = pCallRelExpr(sess)
        sess["pRight"] = andRight
        parseCompare_logic_or_bit(sess)
        andRight = sess["pRight"]
        sess["pRight"] = { "kind": AST_BINARY, "op": "&&", "left": andLeft, "right": andRight }
    }
    return 0
}

pub fn parseCompare_logic_or(sess) {
    while sess["pCur"].type == "||" {
        bump(sess)
        let left = sess["pLeft"]
        sess["pRight"] = pCallRelExpr(sess)
        parseCompare_logic_or_bit(sess)
        parseCompare_logic_or_and(sess)
        sess["pLeft"] = { "kind": AST_BINARY, "op": "||", "left": left, "right": sess["pRight"] }
    }
    return 0
}

pub fn parseCompare_logic(sess) {
    parseCompare_logic_and(sess)
    parseCompare_logic_or(sess)
    return 0
}

pub fn parseCompare(sess) {
    if sess["pCur"].type == "EOF" {
        throw "parseCompare EOF"
    }
    // P6b: fully iterative precedence climb (no right-recursive parseCompare).
    sess["pLeft"] = pCallAddShift(sess)
    if sess["pInAddSub"] == 1 {
        return sess["pLeft"]
    }
    parseCompare_eq(sess)
    parseCompare_bit(sess)
    if sess["pNoBit"] == 1 {
        return sess["pLeft"]
    }
    parseCompare_logic(sess)
    parseCompare_nullish(sess)
    parseCompare_ternary(sess)
    return sess["pLeft"]
}

pub fn parseCompare_nullish(sess) {
    while sess["pCur"].type == "??" {
        bump(sess)
        let left = sess["pLeft"]
        let right = pCallAddShift(sess)
        sess["pLeft"] = { "kind": AST_BINARY, "op": "??", "left": left, "right": right }
    }
    return 0
}

pub fn hasTernaryColon(sess) {
    let i = sess["pPos"] + 1
    let n = sess["pToksLen"]
    let depth = 0
    while i < n {
        let t = sess["pToks"][i].type
        if t == "(" || t == "[" || t == "{" {
            depth = depth + 1
        } else {
            if t == ")" || t == "]" || t == "}" {
                if depth == 0 {
                    return 0
                }
                depth = depth - 1
            } else {
                if t == ";" {
                    if depth == 0 {
                        return 0
                    }
                } else {
                    if t == ":" {
                        if depth == 0 {
                            return 1
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return 0
}

pub fn parseCompare_ternary(sess) {
    if sess["pCur"].type != "?" {
        return 0
    }
    if hasTernaryColon(sess) == 0 {
        bump(sess)
        sess["pLeft"] = { "kind": AST_RESULT_QUESTION, "inner": sess["pLeft"] }
        return 0
    }
    bump(sess)
    let cond = sess["pLeft"]
    let thenB = pCallCompare(sess)
    if sess["pCur"].type != ":" {
        throw "Expected :"
    }
    bump(sess)
    let elseB = pCallCompare(sess)
    sess["pLeft"] = { "kind": AST_TERNARY, "cond": cond, "thenB": thenB, "elseB": elseB }
    return 0
}

// SH5 deepen: postfix parse merged here (was self_host/parser_postfix).

// --- parser_postfix_arr ---
pub fn parsePostfix_arr(sess) {
    if sess["pLeft"] != null {
        return 0
    }
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != "[" {
        return 0
    }
    bump(sess)
    // Nested `[a, f(x)]` / `f([1], g(y))` must not share sess["pArgs"] (wipes outer list).
    let arrElems = []
    while sess["pCur"].type != "]" {
        if sess["pCur"].type == "..." {
            bump(sess)
            arrElems = push(arrElems, { "kind": AST_SPREAD, "expr": pCallCompare(sess) })
        } else {
            arrElems = push(arrElems, pCallCompare(sess))
        }
        if sess["pCur"].type == "," {
            bump(sess)
        }
    }
    bump(sess)
    sess["pLeft"] = { "kind": AST_ARRAY, "elems": arrElems }
    return 0
}

// --- parser_postfix_bare_arrow ---
pub fn parsePostfix_bareArrow(sess) {
    let left = sess["pLeft"]
    if left == null || left == undefined || left == 0 {
        return 0
    }
    let lk = left["kind"]
    if lk == null || lk == undefined {
        return 0
    }
    if !(lk == AST_VAR && sess["pCur"].type == "=>") {
        return 0
    }
    bump(sess)
    let bareParams = [sess["pLeft"]["sym"]]
    let bareBody = null
    if sess["pCur"].type == "{" {
        bump(sess)
        pEnterBody(sess)
        pParseBodyUntilRBrace(sess, "Unclosed arrow block")
        let bb = pLeaveBody(sess)
        bareBody = { "kind": AST_BLOCK, "body": bb }
    } else {
        bareBody = pCallCompare(sess)
    }
    let aKind = AST_ARROW
    if sess["pPendingArrowAsync"] == 1 {
        aKind = AST_ARROW_ASYNC
    }
    sess["pLeft"] = { "kind": aKind, "params": bareParams, "body": bareBody }
    return 0
}

// --- parser_postfix_lit_bool ---
pub fn parsePostfix_lit_bool(sess) {
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type == TOKEN_TRUE {
        bump(sess)
        sess["pLeft"] = { "kind": AST_LITERAL, "lit": LIT_BOOL, "value": true }
        return 1
    }
    if sess["pTok"].type == TOKEN_FALSE {
        bump(sess)
        sess["pLeft"] = { "kind": AST_LITERAL, "lit": LIT_BOOL, "value": false }
        return 1
    }
    if sess["pTok"].type == TOKEN_NULL {
        bump(sess)
        sess["pLeft"] = { "kind": AST_LITERAL, "lit": LIT_NULL, "value": null }
        return 1
    }
    if sess["pTok"].type == TOKEN_UNDEFINED {
        bump(sess)
        sess["pLeft"] = { "kind": AST_LITERAL, "lit": LIT_UNDEF, "value": undefined }
        return 1
    }
    if sess["pTok"].type == TOKEN_NONE {
        bump(sess)
        sess["pLeft"] = { "kind": AST_VAR, "sym": "None" }
        return 1
    }
    return 0
}

// --- parser_postfix_lit_ident ---
pub fn parsePostfix_lit_ident(sess) {
    if sess["pLeft"] != null {
        return 0
    }
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type == TOKEN_IDENT {
        bump(sess)
        sess["pLeft"] = { "kind": AST_VAR, "sym": poolPush(sess, sess["pTok"].value) }
        return 0
    }
    if sess["pTok"].type == TOKEN_SELF {
        bump(sess)
        sess["pLeft"] = { "kind": AST_VAR, "sym": "self" }
        return 0
    }
    if sess["pTok"].type == TOKEN_THIS {
        bump(sess)
        sess["pLeft"] = { "kind": AST_VAR, "sym": "this" }
        return 0
    }
    if sess["pTok"].type == TOKEN_SUPER {
        bump(sess)
        sess["pLeft"] = { "kind": AST_SUPER }
        return 0
    }
    if sess["pTok"].type == TOKEN_IS {
        bump(sess)
        sess["pLeft"] = { "kind": AST_VAR, "sym": "instanceof" }
        return 0
    }
    if sess["pTok"].type == TOKEN_IMPORT {
        bump(sess)
        if sess["pCur"].type == "." {
            bump(sess)
            sess["pTok"] = sess["pCur"]
            if !(sess["pTok"].type == TOKEN_IDENT && sess["pTok"].value == "meta") {
                throw "import expression expects .meta or (specifier)"
            }
            bump(sess)
            sess["pLeft"] = {
                "kind": AST_CALL,
                "callee": { "kind": AST_VAR, "sym": "import_meta" },
                "args": [],
                "typeArgs": []
            }
            return 0
        }
        if sess["pCur"].type == "(" {
            bump(sess)
            let spec = pCallCompare(sess)
            if sess["pCur"].type != ")" {
                throw "Expected )"
            }
            bump(sess)
            sess["pLeft"] = {
                "kind": AST_CALL,
                "callee": { "kind": AST_VAR, "sym": "dynamic_import" },
                "args": [spec],
                "typeArgs": []
            }
            return 0
        }
        throw "import expression expects .meta or (specifier)"
    }
    return 0
}

// --- parser_postfix_lit_num ---
pub fn parsePostfix_lit_num(sess) {
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type == TOKEN_NUMBER || sess["pTok"].type == TOKEN_FLOAT {
        bump(sess)
        sess["pLeft"] = { "kind": AST_LITERAL, "lit": LIT_NUMBER, "value": sess["pTok"].value }
        return 1
    }
    if sess["pTok"].type == TOKEN_STRING {
        bump(sess)
        sess["pLeft"] = { "kind": AST_LITERAL, "lit": LIT_STRING, "value": sess["pTok"].value }
        return 1
    }
    if sess["pTok"].type == TOKEN_TEMPLATE {
        let tParts = sess["pTok"].value
        bump(sess)
        sess["pLeft"] = parseTemplateParts(sess, tParts)
        return 1
    }
    return 0
}

pub fn parseTemplateInterp(sess, src) {
    let toks = tokenizeExec(src)
    let saveToks = sess["pToks"]
    let saveLen = sess["pToksLen"]
    let savePos = sess["pPos"]
    let saveCur = sess["pCur"]
    let saveTok = sess["pTok"]
    let saveLeft = sess["pLeft"]
    let saveTypeArgs = sess["pTypeArgs"]
    sess["pToks"] = toks
    sess["pToksLen"] = len(toks)
    sess["pPos"] = 0
    if sess["pToksLen"] > 0 {
        sess["pCur"] = toks[0]
    } else {
        sess["pCur"] = sess["pEofTok"]
    }
    sess["pLeft"] = null
    sess["pTypeArgs"] = []
    let expr = pCallCompare(sess)
    sess["pToks"] = saveToks
    sess["pToksLen"] = saveLen
    sess["pPos"] = savePos
    sess["pCur"] = saveCur
    sess["pTok"] = saveTok
    sess["pLeft"] = saveLeft
    sess["pTypeArgs"] = saveTypeArgs
    return expr
}

pub fn parseTemplateParts(sess, parts) {
    let acc = null
    let pi = 0
    while pi < len(parts) {
        let piece = null
        if parts[pi]["t"] == "s" {
            piece = { "kind": AST_LITERAL, "lit": LIT_STRING, "value": parts[pi]["v"] }
        } else {
            piece = parseTemplateInterp(sess, parts[pi]["v"])
        }
        if acc == null {
            acc = piece
        } else {
            acc = { "kind": AST_BINARY, "op": "+", "left": acc, "right": piece }
        }
        pi = pi + 1
    }
    if acc == null {
        return { "kind": AST_LITERAL, "lit": LIT_STRING, "value": "" }
    }
    return acc
}

// --- parser_postfix_lit_wrap ---
pub fn parsePostfix_lit_wrap(sess) {
    if sess["pLeft"] != null {
        return 0
    }
    sess["pTok"] = sess["pCur"]
    if !(sess["pTok"].type == TOKEN_OK || sess["pTok"].type == TOKEN_ERR || sess["pTok"].type == TOKEN_SOME) {
        return 0
    }
    bump(sess)
    let wrapName = sess["pTok"].type
    if sess["pCur"].type != "(" {
        throw "Expected ( at " + ("" + sess["pCur"].line) + ":" + ("" + sess["pCur"].column) + " tok=" + sess["pCur"].type
    }
    bump(sess)
    let wrapInner = pCallCompare(sess)
    if sess["pCur"].type != ")" {
        throw "Expected )"
    }
    bump(sess)
    sess["pLeft"] = {
        "kind": AST_CALL,
        "callee": { "kind": AST_VAR, "sym": wrapName },
        "args": [wrapInner]
    }
    return 0
}

// --- parser_postfix_obj ---
pub fn parsePostfix_objMethod(sess, key) {
    bump(sess)
    let scanned = parsePostfix_paren_scan(sess)
    if scanned["ok"] != 1 {
        throw "Expected method params"
    }
    if sess["pCur"].type != "{" {
        throw "Expected {"
    }
    bump(sess)
    pEnterBody(sess)
    pParseBodyUntilRBrace(sess, "Unclosed object method")
    let ab = pLeaveBody(sess)
    return { "key": key, "value": { "kind": AST_ARROW, "params": scanned["params"], "paramDefaults": scanned["defaults"], "rest": scanned["rest"], "body": { "kind": AST_BLOCK, "body": ab } } }
}

pub fn parsePostfix_obj(sess) {
    if sess["pLeft"] != null {
        return 0
    }
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != "{" {
        return 0
    }
    bump(sess)
    let objFields = []
    while sess["pCur"].type != "}" {
        if sess["pCur"].type == "..." {
            bump(sess)
            objFields = push(objFields, { "kind": AST_SPREAD, "expr": pCallCompare(sess) })
        } else {
            if sess["pCur"].type == "[" {
                bump(sess)
                let keyExpr = pCallCompare(sess)
                if sess["pCur"].type != "]" {
                    throw "Expected ]"
                }
                bump(sess)
                if sess["pCur"].type != ":" {
                    throw "Expected :"
                }
                bump(sess)
                objFields = push(objFields, { "kind": AST_COMPUTED, "key": keyExpr, "value": pCallCompare(sess) })
            } else {
                sess["pTok"] = sess["pCur"]
                let key = ""
                if sess["pTok"].type == TOKEN_IDENT {
                    bump(sess)
                    key = poolPush(sess, sess["pTok"].value)
                } else {
                    if sess["pTok"].type == TOKEN_STRING {
                        bump(sess)
                        key = poolPush(sess, sess["pTok"].value)
                    } else {
                        throw "Expected object key"
                    }
                }
                if sess["pCur"].type == "(" {
                    objFields = push(objFields, parsePostfix_objMethod(sess, key))
                } else {
                    if sess["pCur"].type == ":" {
                        bump(sess)
                        objFields = push(objFields, { "key": key, "value": pCallCompare(sess) })
                    } else {
                        if sess["pTok"].type != TOKEN_IDENT {
                            throw "Expected :"
                        }
                        objFields = push(objFields, { "key": key, "value": { "kind": AST_VAR, "sym": key } })
                    }
                }
            }
        }
        if sess["pCur"].type == "," {
            bump(sess)
        }
    }
    bump(sess)
    sess["pLeft"] = { "kind": AST_OBJECT, "fields": objFields }
    return 0
}

// --- parser_postfix_paren_arrow ---
pub fn parsePostfix_paren_arrow(sess, scanned) {
    let aAsync = sess["pPendingArrowAsync"]
    sess["pPendingArrowAsync"] = 0
    bump(sess)
    let arrowBody = null
    if sess["pCur"].type == "{" {
        bump(sess)
        pEnterBody(sess)
        pParseBodyUntilRBrace(sess, "Unclosed arrow block")
        let ab = pLeaveBody(sess)
        arrowBody = { "kind": AST_BLOCK, "body": ab }
    } else {
        arrowBody = pCallCompare(sess)
    }
    let aKind = AST_ARROW
    if aAsync == 1 {
        aKind = AST_ARROW_ASYNC
    }
    if aAsync == true {
        aKind = AST_ARROW_ASYNC
    }
    sess["pLeft"] = {
        "kind": aKind,
        "params": scanned["params"],
        "paramDefaults": scanned["defaults"],
        "rest": scanned["rest"],
        "body": arrowBody
    }
    return 0
}

// --- parser_postfix_paren_group ---
pub fn parsePostfix_paren_group(sess, savePos) {
    sess["pPos"] = savePos
    if sess["pPos"] < sess["pToksLen"] {
        sess["pCur"] = sess["pToks"][sess["pPos"]]
    } else {
        sess["pCur"] = sess["pEofTok"]
    }
    bump(sess)
    sess["pLeft"] = pCallCompare(sess)
    if sess["pCur"].type != ")" {
        throw "Expected )"
    }
    bump(sess)
    return 0
}

// --- parser_postfix_paren_scan ---
pub fn parsePostfix_paren_scan(sess) {
    let arrowParams = []
    let arrowDefaults = []
    let arrowRest = ""
    let arrowOk = 1
    let sawDefault = 0
    if sess["pCur"].type == ")" {
        bump(sess)
        return { "ok": arrowOk, "params": arrowParams, "defaults": arrowDefaults, "rest": arrowRest }
    }
    while sess["pCur"].type != ")" {
        if sess["pCur"].type == "..." {
            bump(sess)
            if sess["pCur"].type != TOKEN_IDENT {
                arrowOk = 0
                break
            }
            sess["pTok"] = sess["pCur"]
            bump(sess)
            arrowRest = sess["pTok"].value
            arrowParams = push(arrowParams, arrowRest)
            arrowDefaults = push(arrowDefaults, null)
            if sess["pCur"].type == "," {
                arrowOk = 0
            }
            break
        }
        if sess["pCur"].type != TOKEN_IDENT {
            arrowOk = 0
            break
        }
        sess["pTok"] = sess["pCur"]
        bump(sess)
        arrowParams = push(arrowParams, sess["pTok"].value)
        let def = null
        if sess["pCur"].type == "=" {
            bump(sess)
            sawDefault = 1
            def = pCallCompare(sess)
        } else {
            if sawDefault == 1 {
                arrowOk = 0
                break
            }
        }
        arrowDefaults = push(arrowDefaults, def)
        if sess["pCur"].type == "," {
            bump(sess)
        } else {
            if sess["pCur"].type != ")" {
                arrowOk = 0
                break
            }
        }
    }
    if arrowOk == 1 {
        if sess["pCur"].type != ")" {
            arrowOk = 0
        } else {
            bump(sess)
        }
    }
    return { "ok": arrowOk, "params": arrowParams, "defaults": arrowDefaults, "rest": arrowRest }
}

// --- parser_postfix_tail_call ---
pub fn parsePostfix_tail_call(sess) {
    if sess["pCur"].type != "(" {
        return 0
    }
    sess["pCallee"] = sess["pLeft"]
    if sess["pCallee"] == null || sess["pCallee"] == 0 || sess["pCallee"] == undefined {
        return 0
    }
    if sess["pCallee"].kind == AST_VAR {
        sess["pCallee"] = { "kind": AST_VAR, "sym": sess["pCallee"]["sym"] }
    }
    let savedCallee = sess["pCallee"]
    let savedTypeArgs = sess["pTypeArgs"]
    bump(sess)
    // Nested `len(wrap(1))` / `str_slice(s, 2, len(s))`: inner call must not reset outer pArgs.
    let callArgs = []
    if sess["pCur"].type != ")" {
        while true {
            let arg = null
            if sess["pCur"].type == "..." {
                bump(sess)
                arg = { "kind": AST_SPREAD, "expr": pCallCompare(sess) }
            } else {
                arg = pCallCompare(sess)
            }
            callArgs = push(callArgs, arg)
            if sess["pCur"].type == "," {
                bump(sess)
            } else {
                break
            }
        }
    }
    if sess["pCur"].type != ")" {
        throw "Expected )"
    }
    bump(sess)
    sess["pLeft"] = { "kind": AST_CALL, "callee": savedCallee, "args": callArgs, "typeArgs": savedTypeArgs }
    sess["pTypeArgs"] = []
    return 1
}

// --- parser_postfix_tail_generic ---
pub fn parsePostfix_tail_generic(sess) {
    if sess["pCur"].type != "<" {
        return 0
    }
    if sess["pLeft"] == null || sess["pLeft"] == 0 || sess["pLeft"] == undefined {
        return 0
    }
    sess["pIsGenericCallee"] = 0
    if sess["pLeft"].kind == AST_VAR {
        sess["pIsGenericCallee"] = 1
    }
    if sess["pLeft"].kind == AST_MEMBER {
        sess["pIsGenericCallee"] = 1
    }
    if sess["pIsGenericCallee"] == 1 {
        sess["pSnapTypeArgs"] = pCallTypeArgs(sess)
        if len(sess["pSnapTypeArgs"]) > 0 {
            sess["pTypeArgs"] = sess["pSnapTypeArgs"]
            return 1
        }
    }
    return -1
}

// --- parser_postfix_tail_index ---
pub fn parsePostfix_tail_index(sess) {
    if sess["pCur"].type != "[" {
        return 0
    }
    bump(sess)
    let indexObj = sess["pLeft"]
    sess["pRight"] = pCallCompare(sess)
    if sess["pCur"].type != "]" {
        throw "Expected ]"
    }
    bump(sess)
    sess["pLeft"] = { "kind": AST_INDEX, "object": indexObj, "index": sess["pRight"] }
    return 1
}

// --- parser_postfix_tail_member_name ---
pub fn parsePostfix_tail_member_name(sess) {
    sess["pTok"] = sess["pCur"]
    sess["pMemberName"] = ""
    if sess["pTok"].type == TOKEN_IDENT {
        bump(sess)
        sess["pMemberName"] = sess["pTok"].value
        return 0
    }
    if sess["pTok"].type == TOKEN_NONE {
        bump(sess)
        sess["pMemberName"] = "None"
        return 0
    }
    if sess["pTok"].type == TOKEN_SOME {
        bump(sess)
        sess["pMemberName"] = "Some"
        return 0
    }
    if sess["pTok"].type == TOKEN_OK {
        bump(sess)
        sess["pMemberName"] = "Ok"
        return 0
    }
    if sess["pTok"].type == TOKEN_ERR {
        bump(sess)
        sess["pMemberName"] = "Err"
        return 0
    }
    if sess["pTok"].type == TOKEN_RETURN {
        bump(sess)
        sess["pMemberName"] = "return"
        return 0
    }
    if sess["pTok"].type == TOKEN_THROW {
        bump(sess)
        sess["pMemberName"] = "throw"
        return 0
    }
    throw "Expected member name"
}

// --- parser_postfix_lit_scalar ---
pub fn parsePostfix_lit_scalar(sess) {
    if parsePostfix_lit_num(sess) == 1 {
        return 0
    }
    parsePostfix_lit_bool(sess)
    return 0
}

// --- parser_postfix_obj_arr ---
pub fn parsePostfix_obj_arr(sess) {
    if sess["pLeft"] != null {
        return 0
    }
    parsePostfix_obj(sess)
    parsePostfix_arr(sess)
    return 0
}

// --- parser_postfix_paren ---
pub fn parsePostfix_paren(sess) {
    let pl = sess["pLeft"]
    if pl != null {
        if pl != 0 {
            if pl != undefined {
                return 0
            }
        }
    }
    sess["pTok"] = sess["pCur"]
    if sess["pTok"].type != "(" {
        return 0
    }
    let savePos = sess["pPos"]
    bump(sess)
    let scanned = parsePostfix_paren_scan(sess)
    if scanned["ok"] == 1 && sess["pCur"].type == "=>" {
        parsePostfix_paren_arrow(sess, scanned)
    } else {
        parsePostfix_paren_group(sess, savePos)
    }
    return 0
}

// --- parser_postfix_tail_member ---
pub fn parsePostfix_tail_member(sess) {
    if sess["pCur"].type != "." {
        return 0
    }
    bump(sess)
    parsePostfix_tail_member_name(sess)
    sess["pMemberName"] = poolPush(sess, sess["pMemberName"])
    sess["pLeft"] = {
        "kind": AST_MEMBER,
        "object": sess["pLeft"],
        "field": sess["pMemberName"],
        "typeArgs": sess["pTypeArgs"]
    }
    sess["pTypeArgs"] = []
    return 1
}

// --- parser_postfix_tail_opt ---
pub fn parsePostfix_tail_opt(sess) {
    if sess["pCur"].type != "?." {
        return 0
    }
    bump(sess)
    if sess["pCur"].type == "[" {
        bump(sess)
        let indexObj = sess["pLeft"]
        let index = pCallCompare(sess)
        if sess["pCur"].type != "]" {
            throw "Expected ]"
        }
        bump(sess)
        sess["pLeft"] = { "kind": AST_OPTIONAL_INDEX, "object": indexObj, "index": index }
        return 1
    }
    if sess["pCur"].type == "(" {
        let savedCallee = sess["pLeft"]
        bump(sess)
        let callArgs = []
        if sess["pCur"].type != ")" {
            while true {
                let arg = pCallCompare(sess)
                callArgs = push(callArgs, arg)
                if sess["pCur"].type == "," {
                    bump(sess)
                } else {
                    break
                }
            }
        }
        if sess["pCur"].type != ")" {
            throw "Expected )"
        }
        bump(sess)
        sess["pLeft"] = { "kind": AST_OPTIONAL_CALL, "callee": savedCallee, "args": callArgs }
        return 1
    }
    parsePostfix_tail_member_name(sess)
    sess["pMemberName"] = poolPush(sess, sess["pMemberName"])
    sess["pLeft"] = {
        "kind": AST_OPTIONAL_MEMBER,
        "object": sess["pLeft"],
        "field": sess["pMemberName"]
    }
    return 1
}

// --- parser_postfix_lit ---
pub fn parsePostfix_lit(sess) {
    sess["pLeft"] = null
    sess["pTypeArgs"] = []
    parsePostfix_lit_scalar(sess)
    parsePostfix_lit_wrap(sess)
    parsePostfix_lit_ident(sess)
    return 0
}

// --- parser_postfix_tail ---
pub fn parsePostfix_tail(sess) {
    let n = 0
    while true {
        n = n + 1
        if n > 1000000 {
            throw "postfix tail runaway"
        }
        let g = parsePostfix_tail_generic(sess)
        if g == 1 {
            // continue loop for call/member after type args
        } else {
            if g == -1 {
                break
            }
            let o = parsePostfix_tail_opt(sess)
            if o == 0 {
            let c = parsePostfix_tail_call(sess)
            if c == 0 {
                let m = parsePostfix_tail_member(sess)
                if m == 0 {
                    let ix = parsePostfix_tail_index(sess)
                    if ix == 0 {
                        break
                    }
                }
            }
            }
        }
    }
    return sess["pLeft"]
}

pub fn matchPatRangeHiMissing(sess) {
    let t = sess["pCur"].type
    if t == "=>" {
        return 1
    }
    if t == "|" {
        return 1
    }
    if t == TOKEN_IF {
        return 1
    }
    if t == "," {
        return 1
    }
    if t == "}" {
        return 1
    }
    if t == "=" {
        return 1
    }
    return 0
}

pub fn parseMatchPatRangeOp(sess) {
    let rt = sess["pCur"].type
    let inc = 0
    if rt == "..=" {
        inc = 1
    }
    bump(sess)
    return inc
}

pub fn parseMatchPatPrimary(sess) {
    let t = sess["pCur"].type
    if t == ".." || t == "..=" {
        let inc = parseMatchPatRangeOp(sess)
        let hi = parseMatchPatAtom(sess)
        return { "kind": "range", "lo": null, "hi": hi, "inc": inc }
    }
    let first = parseMatchPatAtom(sess)
    let rt = sess["pCur"].type
    if rt != ".." && rt != "..=" {
        return first
    }
    let inc = parseMatchPatRangeOp(sess)
    if matchPatRangeHiMissing(sess) == 1 {
        return { "kind": "range", "lo": first, "hi": null, "inc": inc }
    }
    let hi = parseMatchPatAtom(sess)
    return { "kind": "range", "lo": first, "hi": hi, "inc": inc }
}

pub fn parseMatchPat(sess) {
    let first = parseMatchPatPrimary(sess)
    if sess["pCur"].type != "|" {
        return first
    }
    let alts = []
    alts = push(alts, first)
    while sess["pCur"].type == "|" {
        bump(sess)
        alts = push(alts, parseMatchPatPrimary(sess))
    }
    return { "kind": "or", "alts": alts }
}

pub fn parseMatchPatAtom(sess) {
    let t = sess["pCur"].type
    if t == "(" {
        bump(sess)
        let inner = parseMatchPat(sess)
        if sess["pCur"].type != ")" {
            throw "Expected ) in pattern"
        }
        bump(sess)
        return inner
    }
    if t == "[" {
        bump(sess)
        let pieces = []
        while sess["pCur"].type != "]" {
            if sess["pCur"].type == "," {
                bump(sess)
                continue
            }
            if sess["pCur"].type == "..." {
                bump(sess)
                let rname = ""
                if sess["pCur"].type == TOKEN_IDENT {
                    bump(sess)
                    rname = sess["pTok"]["value"]
                }
                pieces = push(pieces, { "kind": "rest", "sym": rname })
                continue
            }
            pieces = push(pieces, { "kind": "item", "pat": parseMatchPat(sess) })
        }
        bump(sess)
        return { "kind": "array", "pieces": pieces }
    }
    if t == "{" {
        bump(sess)
        let fields = []
        while sess["pCur"].type != "}" {
            if sess["pCur"].type == "," {
                bump(sess)
                continue
            }
            if sess["pCur"].type == "..." {
                bump(sess)
                let rname = ""
                if sess["pCur"].type == TOKEN_IDENT {
                    bump(sess)
                    rname = sess["pTok"]["value"]
                }
                fields = push(fields, { "kind": "rest", "sym": rname })
                continue
            }
            bump(sess)
            let key = sess["pTok"]["value"]
            let hadColon = 0
            if sess["pCur"].type == ":" {
                bump(sess)
                hadColon = 1
                fields = push(fields, { "kind": "field", "key": key, "pat": parseMatchPat(sess) })
            }
            if hadColon == 0 {
                fields = push(fields, { "kind": "shorthand", "key": key })
            }
        }
        bump(sess)
        return { "kind": "object", "fields": fields }
    }
    if t == TOKEN_IDENT {
        bump(sess)
        let name = sess["pTok"]["value"]
        if name == "_" {
            return { "kind": "wild" }
        }
        if sess["pCur"].type == "." {
            bump(sess)
            sess["pTok"] = sess["pCur"]
            let variant = ""
            if sess["pTok"].type == TOKEN_IDENT {
                bump(sess)
                variant = sess["pTok"].value
            } else {
                if sess["pTok"].type == TOKEN_SOME {
                    bump(sess)
                    variant = "Some"
                } else {
                    if sess["pTok"].type == TOKEN_NONE {
                        bump(sess)
                        variant = "None"
                    } else {
                        if sess["pTok"].type == TOKEN_OK {
                            bump(sess)
                            variant = "Ok"
                        } else {
                            if sess["pTok"].type == TOKEN_ERR {
                                bump(sess)
                                variant = "Err"
                            } else {
                                throw "Expected enum variant name"
                            }
                        }
                    }
                }
            }
            let fields = []
            if sess["pCur"].type == "(" {
                bump(sess)
                while sess["pCur"].type != ")" {
                    if sess["pCur"].type == "," {
                        bump(sess)
                        continue
                    }
                    fields = push(fields, parseMatchPat(sess))
                }
                bump(sess)
            }
            return { "kind": "enum", "typeName": name, "variant": variant, "fields": fields }
        }
        if sess["pCur"].type == "@" {
            bump(sess)
            let inner = parseMatchPat(sess)
            return { "kind": "at", "sym": name, "inner": inner }
        }
        return { "kind": "var", "sym": name }
    }
    if t == TOKEN_NUMBER || t == TOKEN_FLOAT {
        bump(sess)
        return { "kind": "const", "value": sess["pTok"]["value"] }
    }
    if t == TOKEN_STRING {
        bump(sess)
        return { "kind": "const", "value": sess["pTok"]["value"] }
    }
    if t == TOKEN_TRUE {
        bump(sess)
        return { "kind": "const", "value": true }
    }
    if t == TOKEN_FALSE {
        bump(sess)
        return { "kind": "const", "value": false }
    }
    if t == TOKEN_NULL {
        bump(sess)
        return { "kind": "const", "value": null }
    }
    if t == TOKEN_UNDEFINED {
        bump(sess)
        return { "kind": "const", "undef": 1 }
    }
    if t == TOKEN_NAN {
        bump(sess)
        return { "kind": "const", "nan": 1 }
    }
    if t == TOKEN_NONE {
        bump(sess)
        return { "kind": "none" }
    }
    if t == TOKEN_SOME || t == TOKEN_OK || t == TOKEN_ERR {
        bump(sess)
        let wrap = "some"
        if t == TOKEN_OK {
            wrap = "ok"
        }
        if t == TOKEN_ERR {
            wrap = "err"
        }
        bump(sess)
        let inner = parseMatchPat(sess)
        bump(sess)
        return { "kind": wrap, "inner": inner }
    }
    throw "Unexpected token in pattern"
}

pub fn parsePostfix_match(sess) {
    if sess["pCur"].type != TOKEN_MATCH {
        return 0
    }
    bump(sess)
    let value = pCallCompare(sess)
    bump(sess)
    let arms = []
    while sess["pCur"].type != "}" {
        let pat = parseMatchPat(sess)
        let guard = null
        if sess["pCur"].type == TOKEN_IF {
            bump(sess)
            guard = pCallCompare(sess)
        }
        bump(sess)
        let body = pCallCompare(sess)
        arms = push(arms, { "pattern": pat, "guard": guard, "body": body })
        if sess["pCur"].type == "," {
            bump(sess)
        }
    }
    bump(sess)
    sess["pLeft"] = { "kind": AST_MATCH, "scrutinee": value, "arms": arms }
    return 1
}

// --- parser_postfix_async_prefix ---
pub fn parsePostfix_asyncPrefix(sess) {
    if sess["pCur"].type != TOKEN_ASYNC {
        return 0
    }
    let pos = sess["pPos"]
    let n = sess["pToksLen"]
    let nxt = sess["pEofTok"]
    if pos + 1 < n {
        nxt = sess["pToks"][pos + 1]
    }
    let nt = nxt.type
    if nt != "(" {
        if nt != TOKEN_IDENT {
            return 0
        }
    }
    bump(sess)
    sess["pPendingArrowAsync"] = 1
    return 1
}

// --- parser_postfix_primary ---
pub fn parsePostfix_primary(sess) {
    sess["pLeft"] = null
    sess["pTypeArgs"] = []
    parsePostfix_lit(sess)
    if sess["pLeft"] == null {
        parsePostfix_paren(sess)
    }
    if sess["pLeft"] == null {
        parsePostfix_obj_arr(sess)
    }
    if sess["pLeft"] == null {
        parsePostfix_match(sess)
    }
    if sess["pLeft"] == null {
        throw json_stringify(sess["pCur"])
    }
    return 0
}

// --- parser_postfix ---
pub fn parsePostfix(sess) {
    if sess["pCur"].type == "EOF" {
        throw "parsePostfix EOF"
    }
    let wantAsync = parsePostfix_asyncPrefix(sess)
    parsePostfix_primary(sess)
    parsePostfix_bareArrow(sess)
    if wantAsync != 0 {
        if sess["pLeft"]["kind"] != AST_ARROW {
            if sess["pLeft"]["kind"] != AST_ARROW_ASYNC {
                throw "`async` must be followed by `fn` or `=>`"
            }
        }
        sess["pLeft"]["kind"] = AST_ARROW_ASYNC
    }
    sess["pPendingArrowAsync"] = 0
    return parsePostfix_tail(sess)
}
