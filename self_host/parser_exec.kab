// SH2/SH13: reuse session; tramp takes sess (do not read gSess — LoadGlobal IC can stale).
import "self_host/parser_session"
import "self_host/parser_tramp"
import "self_host/parser_main"

let gSess = null

fn tramp(sess) {
    return pTramp(sess)
}

pub fn parseTokensExec(tokens) {
    let sess = gSess
    if sess == null {
        sess = pMakeSession()
        gSess = sess
        sess["tramp"] = tramp
    } else {
        pResetSession(sess)
        sess["tramp"] = tramp
    }
    sess["_hook"] = 0
    return parseMain(sess, tokens)
}
