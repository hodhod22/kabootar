import "self_host/vm_s_push"
import "self_host/vm_s_ip"
import "self_host/vm_s_resolve"

pub fn runOpMemLoadGlobal(S, name, arg, op, pool, globals, functions) {
    if name == "load_global" {
        vPushS(S, vResolveGlobalS(S, globals, arg))
        vBumpIpS(S)
        return 1
    }
    return 0
}
