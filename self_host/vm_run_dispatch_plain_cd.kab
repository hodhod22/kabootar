// P6b: 2-way dispatch chain (≤10s self-host compile).
import "self_host/vm_run_dispatch_cmp"
import "self_host/vm_run_dispatch_data"

pub fn runOpPlainCd(S, name, arg, op, pool, globals, functions) {
    let st = runOpCmpS(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpDataS(S, name, arg, op, pool, globals, functions)
}
