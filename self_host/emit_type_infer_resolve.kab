// P6b: explicit type-arg load + resolve wrappers.
import "self_host/ast_defs"
import "self_host/emit_defs"
import "self_host/emit_arr_util"
import "self_host/emit_type_infer_args"

pub fn emitLoadExplicitTypeArgs(E) {
    E["eExplicit"] = E["eNode"]["typeArgs"]
    if E["eExplicit"] == undefined {
        E["eExplicit"] = []
    }
    if len(E["eExplicit"]) > 0 {
        E["eTypeArgs"] = arrUtil(E, "snap", E["eExplicit"])
    }
}

pub fn emitResolveTypeArgs(E, argsKey, errSym, litFull) {
    emitLoadExplicitTypeArgs(E)
    if len(E["eExplicit"]) == 0 {
        emitInferTypeArgsFrom(E, argsKey, errSym, litFull)
    }
}

pub fn emitResolveTypeArgsMem(E, argsKey, errSym, litFull) {
    emitLoadExplicitTypeArgs(E)
    if len(E["eExplicit"]) > 0 {
        return
    }
    if len(E["eMemTypeArgs"]) > 0 {
        E["eTypeArgs"] = arrUtil(E, "snap", E["eMemTypeArgs"])
        return
    }
    emitInferTypeArgsFrom(E, argsKey, errSym, litFull)
}
