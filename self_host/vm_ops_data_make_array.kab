import "self_host/vm_s_push"
import "self_host/vm_s_ip"
import "self_host/vm_s_pop_n"
import "self_host/vm_s_rev_arr"

pub fn runOpDataMakeArray(S, name, arg, op, pool, globals, functions) {
    if name == "make_array" {
        let n = arg
        let raw = vPopNRaw(S, n)
        let arr = vReverseArr(raw, n)
        vPushS(S, arr)
        vBumpIpS(S)
        return 1
    }
    return 0
}
