import "self_host/compile"
os_mount("/proj", ".")

compile("let eCallRet = 0\nfn t(E) { eCallRet = (\"\" + E[\"eAssignSym\"]) + \"\"; return eCallRet }")
println("OK module chained plus")

compile("fn t(E) { let loopEnd = 10; eCallRet = loopEnd - E[\"eBreakIdxs\"][E[\"eBi\"]]; return eCallRet }")
println("OK sub nested index")

compile("fn t(E) { E[\"eFnOps\"][E[\"eBreakIdxs\"][E[\"eBi\"]]] = { \"op\": \"j\", \"arg\": E[\"eJumpOff\"] }; return E }")
println("OK nested idx obj assign")
