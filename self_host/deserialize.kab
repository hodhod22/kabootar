// Parse kabootar-bytecode/1 text → self_host IR subset. import "self_host/deserialize"
import "self_host/lexer_defs"
import "self_host/serialize_defs"
import "self_host/emit_defs"
import "self_host/deserialize_ops"
import "self_host/deserialize_handlers"

pub fn deserializeKbc(text) {
    let lines = splitLines(text)
    if len(lines) == 0 {
        throw "deserialize: empty"
    }
    if lines[0] != KBC_HEADER {
        throw "deserialize: bad header"
    }
    let st = {
        "constants": [],
        "globals": [],
        "locals": [],
        "functions": [],
        "classes": [],
        "enums": [],
        "imports": [],
        "arrows": [],
        "tryRegions": [],
        "ops": [],
        "inCode": false
    }
    let li = 1
    while li < len(lines) {
        let line = lines[li]
        if line == "code" {
            st["inCode"] = true
            li = li + 1
            continue
        }
        let r = deserApplyLine(st, line)
        if r == "break" {
            break
        }
        li = li + 1
    }
    return {
        "constants": st["constants"],
        "globals": st["globals"],
        "locals": st["locals"],
        "functions": st["functions"],
        "classes": st["classes"],
        "enums": st["enums"],
        "imports": st["imports"],
        "arrows": st["arrows"],
        "tryRegions": st["tryRegions"],
        "ops": st["ops"]
    }
}
