// P6b: 2-way dispatch chain (≤10s self-host compile).
import "self_host/vm_run_dispatch_mem"
import "self_host/vm_run_dispatch_arith"

pub fn runOpPlainMa(S, name, arg, op, pool, globals, functions) {
    let st = runOpMemS(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpArithS(S, name, arg, op, pool, globals, functions)
}
