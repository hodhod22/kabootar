import "self_host/lexer_defs"
import "self_host/ast_defs"
import "self_host/parser_hooks"
import "self_host/parser_util"

pub fn parseCompare(sess) {
    if sess["pCur"].type == "EOF" {
        throw "parseCompare EOF"
    }
    // P6b: fully iterative precedence climb (no right-recursive parseCompare).
    sess["pLeft"] = pCallAddShift(sess)
    if sess["pInAddSub"] == 1 {
        return sess["pLeft"]
    }
    while sess["pCur"].type == "==" || sess["pCur"].type == "!=" || sess["pCur"].type == "<" || sess["pCur"].type == ">" || sess["pCur"].type == ">=" || sess["pCur"].type == "<=" {
        sess["pBinOp"] = sess["pCur"].type
        bump(sess)
        sess["pSave"] = sess["pLeft"]
        sess["pRight"] = pCallAddShift(sess)
        sess["pLeft"] = { "kind": AST_BINARY, "op": sess["pBinOp"], "left": sess["pSave"], "right": sess["pRight"] }
    }
    if sess["pNoBit"] == 0 {
        while sess["pCur"].type == "&" {
            bump(sess)
            sess["pSave"] = sess["pLeft"]
            sess["pRight"] = pCallRelExpr(sess)
            sess["pLeft"] = { "kind": AST_BINARY, "op": "&", "left": sess["pSave"], "right": sess["pRight"] }
        }
        while sess["pCur"].type == "^" {
            bump(sess)
            sess["pSave"] = sess["pLeft"]
            sess["pRight"] = pCallRelExpr(sess)
            sess["pLeft"] = { "kind": AST_BINARY, "op": "^", "left": sess["pSave"], "right": sess["pRight"] }
        }
        while sess["pCur"].type == "|" {
            bump(sess)
            sess["pSave"] = sess["pLeft"]
            sess["pRight"] = pCallRelExpr(sess)
            sess["pLeft"] = { "kind": AST_BINARY, "op": "|", "left": sess["pSave"], "right": sess["pRight"] }
        }
    }
    if sess["pNoBit"] == 1 {
        return sess["pLeft"]
    }
    while sess["pCur"].type == "&&" {
        bump(sess)
        sess["pExprLeft"] = sess["pLeft"]
        sess["pRight"] = pCallRelExpr(sess)
        // bit binds tighter — allow &/^/| on && RHS
        if sess["pNoBit"] == 0 {
            while sess["pCur"].type == "&" || sess["pCur"].type == "^" || sess["pCur"].type == "|" {
                sess["pBinOp"] = sess["pCur"].type
                bump(sess)
                sess["pRight"] = { "kind": AST_BINARY, "op": sess["pBinOp"], "left": sess["pRight"], "right": pCallRelExpr(sess) }
            }
        }
        sess["pLeft"] = { "kind": AST_BINARY, "op": "&&", "left": sess["pExprLeft"], "right": sess["pRight"] }
    }
    while sess["pCur"].type == "||" {
        bump(sess)
        sess["pExprLeft"] = sess["pLeft"]
        // || RHS: &&-chain of rel/bit
        sess["pRight"] = pCallRelExpr(sess)
        if sess["pNoBit"] == 0 {
            while sess["pCur"].type == "&" || sess["pCur"].type == "^" || sess["pCur"].type == "|" {
                sess["pBinOp"] = sess["pCur"].type
                bump(sess)
                sess["pRight"] = { "kind": AST_BINARY, "op": sess["pBinOp"], "left": sess["pRight"], "right": pCallRelExpr(sess) }
            }
        }
        while sess["pCur"].type == "&&" {
            bump(sess)
            let andLeft = sess["pRight"]
            let andRight = pCallRelExpr(sess)
            if sess["pNoBit"] == 0 {
                while sess["pCur"].type == "&" || sess["pCur"].type == "^" || sess["pCur"].type == "|" {
                    sess["pBinOp"] = sess["pCur"].type
                    bump(sess)
                    andRight = { "kind": AST_BINARY, "op": sess["pBinOp"], "left": andRight, "right": pCallRelExpr(sess) }
                }
            }
            sess["pRight"] = { "kind": AST_BINARY, "op": "&&", "left": andLeft, "right": andRight }
        }
        sess["pLeft"] = { "kind": AST_BINARY, "op": "||", "left": sess["pExprLeft"], "right": sess["pRight"] }
    }
    return sess["pLeft"]
}


