// P6b: mangle symbol with E["eTypeArgs"] suffix.
let eCallRet = 0

pub fn emitMangleWithTypeArgs(E, nameKey) {
    if len(E["eTypeArgs"]) == 0 {
        return
    }
    eCallRet = E[nameKey] + "$"
    E[nameKey] = eCallRet + E["eTypeArgs"][0]
    E["eResolveI"] = 1
    while E["eResolveI"] < len(E["eTypeArgs"]) {
        eCallRet = E[nameKey] + "_"
        E[nameKey] = eCallRet + E["eTypeArgs"][E["eResolveI"]]
        E["eResolveI"] = E["eResolveI"] + 1
    }
}
