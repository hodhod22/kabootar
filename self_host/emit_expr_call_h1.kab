import "self_host/ast_defs"
import "self_host/emit_defs"
import "self_host/emit_hooks"
import "self_host/emit_sym_index"
import "self_host/emit_arr_util"
import "self_host/emit_op"
import "self_host/emit_sym"
import "self_host/emit_local_map"
import "self_host/emit_call_callee"
import "self_host/emit_drop_callee"
import "self_host/emit_call_args"
import "self_host/emit_try_len"

let eCallRet = 0
let eCallRet2 = 0

import "self_host/emit_expr_call_h2"
import "self_host/emit_expr_call_h3"

pub fn emitExpr_call_h1(E) {
        E["eGenSym"] = E["eCallee"]["sym"]
        E["eGenTmpl"] = null
        E["eFound"] = 0
        E["eGenI"] = 0
        while E["eGenI"] < len(E["eGenericClassTemplates"]) {
            if E["eGenericClassTemplates"][E["eGenI"]]["sym"] == E["eGenSym"] {
                E["eGenTmpl"] = E["eGenericClassTemplates"][E["eGenI"]]
                E["eFound"] = 1
                break
            }
            E["eGenI"] = E["eGenI"] + 1
        }
        if E["eFound"] == 1 {
            emitExpr_call_h3(E)
            if E["_callDone"] == 1 {
                E["_callDone"] = 1
                return 0
            }
        }
        E["eGenTmpl"] = null
        E["eFound"] = 0
        E["eGenI"] = 0
        while E["eGenI"] < len(E["eGenericTemplates"]) {
            if E["eGenericTemplates"][E["eGenI"]]["sym"] == E["eGenSym"] {
                E["eGenTmpl"] = E["eGenericTemplates"][E["eGenI"]]
                E["eFound"] = 1
                break
            }
            E["eGenI"] = E["eGenI"] + 1
        }
        if E["eFound"] == 1 {
            emitExpr_call_h2(E)
            if E["_callDone"] == 1 {
                E["_callDone"] = 1
                return 0
            }
        }
        eCallRet = symIndex(E, "class",E["eGenSym"])
        E["eClassIdx"] = eCallRet
        if E["eClassIdx"] >= 0 {
            E["eCallArgIStack"] = push(E["eCallArgIStack"], 0)
            E["eCallArgNStack"] = push(E["eCallArgNStack"], E["eArgN"])
            E["eArgsStack"] = push(E["eArgsStack"], E["eArgs"])
            emitCallArgExprs(E)
            if E["eInFn"] == 1 {
                E["eFnOps"] = push(E["eFnOps"], { "op": OP_NEW_INSTANCE, "arg": E["eClassIdx"], "arg2": E["eArgN"] })
                E["eFnOpsN"] = E["eFnOpsN"] + 1
            } else {
                E["eOps"] = push(E["eOps"], { "op": OP_NEW_INSTANCE, "arg": E["eClassIdx"], "arg2": E["eArgN"] })
                E["eOpsN"] = E["eOpsN"] + 1
            }
            dropCallCallee(E)
            E["_callDone"] = 1
            return 0
        }
}
