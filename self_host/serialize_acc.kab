// P6b: serSerializeBc orchestration (skip-listed until ≤10s).
import "self_host/serialize_ir"
import "self_host/serialize_out"
import "self_host/serialize_sections"
import "self_host/serialize_acc_pool"
import "self_host/serialize_acc_tail"

pub fn serSerializeBc(bc) {
    let out = KBC_HEADER
    out = serOutTagEq(out, "constants=", len(bc.constants))
    out = serAppendConsts(out, bc.constants)
    out = serAppendGlobals(out, bc.globals)
    out = serAppendFunctions(out, bc.functions)
    out = serAppendArrows(out, bc.arrows)
    return serAppendBcTail(out, bc)
}
