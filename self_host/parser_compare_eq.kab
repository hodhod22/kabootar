import "self_host/lexer_defs"
import "self_host/ast_defs"
import "self_host/parser_hooks"
import "self_host/parser_util"

pub fn parseCompare_eq(sess) {
    while sess["pCur"].type == "==" || sess["pCur"].type == "!=" || sess["pCur"].type == "<" || sess["pCur"].type == ">" || sess["pCur"].type == ">=" || sess["pCur"].type == "<=" {
        sess["pBinOp"] = sess["pCur"].type
        bump(sess)
        sess["pSave"] = sess["pLeft"]
        sess["pRight"] = pCallAddShift(sess)
        sess["pLeft"] = { "kind": AST_BINARY, "op": sess["pBinOp"], "left": sess["pSave"], "right": sess["pRight"] }
    }
    return 0
}
