import "self_host/lexer_defs"
import "self_host/ast_defs"

pub fn peek(sess) {
    return sess["pCur"]
}


pub fn bump(sess) {
    sess["pTok"] = sess["pCur"]
    if sess["pPos"] < sess["pToksLen"] {
        sess["pPos"] = sess["pPos"] + 1
        if sess["pPos"] < sess["pToksLen"] {
            sess["pCur"] = sess["pToks"][sess["pPos"]]
        } else {
            sess["pCur"] = sess["pEofTok"]
        }
    }
    return sess["pTok"]
}

// P6b: poolPush avoids len(sess["pSymPool"]) LoadGlobal clone after every push.

// P6b: poolPush — AccAdd-safe (temp newPool; see emit eCallRet pattern).
pub fn poolPush(sess, v) {
    let newPool = push(sess["pSymPool"], v)
    sess["pSymPool"] = newPool
    sess["pSymN"] = sess["pSymN"] + 1
    return v
}
