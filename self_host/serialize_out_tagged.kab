// P6b: tagged out helpers (skip-listed until ≤10s).
import "self_host/serialize_out_base"

pub fn serOutTagged(out, tag, i, rest) {
    let s = serOutTag(out, tag)
    s = serOutSpNum(s, i)
    return serOutSp(s, rest)
}

pub fn serOutTagged2(out, tag, a, b, rest) {
    let s = serOutTag(out, tag)
    s = serOutSpNum(s, a)
    s = serOutSpNum(s, b)
    return serOutSp(s, rest)
}
