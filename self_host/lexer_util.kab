import "self_host/lexer_defs"

pub fn lxEat(sess) {
    sess["pos"] = sess["pos"] + 1
    sess["col"] = sess["col"] + 1
    return 0
}

pub fn lxCh(sess) {
    return char_at(sess["src"], sess["pos"])
}

pub fn lxTok(typ, val, line, col) {
    return { "type": typ, "value": val, "line": line, "column": col }
}

pub fn lxHas(sess) {
    return sess["pos"] < sess["srcLen"]
}

pub fn lxStarts(sess, ch) {
    if sess["pos"] >= sess["srcLen"] {
        return 0
    }
    if char_at(sess["src"], sess["pos"]) == ch {
        return 1
    }
    return 0
}
