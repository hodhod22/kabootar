// SH2/SH13: reuse session; tramp takes E (do not read gE — LoadGlobal IC can stale).
import "self_host/emit_session"
import "self_host/emit_tramp"
import "self_host/emit_main_fn"

let gE = null

fn tramp(E) {
    return eTramp(E)
}

pub fn emitMainExec(program) {
    let E = gE
    if E == null {
        E = eMakeSession()
        gE = E
        E["tramp"] = tramp
    } else {
        eResetSession(E)
        E["tramp"] = tramp
    }
    E["_hook"] = 0
    E["_node"] = null
    return emitMain(E, program)
}
