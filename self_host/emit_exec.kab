// SH2: fresh emit session per emit() call. Tramp is 0-arg and reads gE.
import "self_host/emit_session"
import "self_host/emit_tramp"
import "self_host/emit_main_fn"

let gE = null

fn tramp() {
    return eTramp(gE)
}

pub fn emitMainExec(program) {
    let E = eMakeSession()
    gE = E
    E["tramp"] = tramp
    E["_hook"] = 0
    E["_node"] = null
    return emitMain(E, program)
}
