let gE = null

fn tramp(E) {
    return eTramp(E)
}

pub fn emitMainExec(program) {
    let E = gE
    if E == null {
        E = eMakeSession()
        gE = E
        E["tramp"] = tramp
    } else {
        eResetSession(E)
        E["tramp"] = tramp
    }
    E["_hook"] = 0
    E["_node"] = null
    return emitMain(E, program)
}

pub let emitMainFromExec = emitMainExec
