import "self_host/ast_defs"
import "self_host/emit_defs"
import "self_host/emit_hooks"
import "self_host/emit_op"
import "self_host/emit_patch_jump"

let eCallRet = 0
let eCallRet2 = 0


pub fn emitStmt_break(E) {
    if E["eNode"].kind != AST_BREAK {
        return false
    }
        if len(E["eBreakFromStack"]) == 0 {
            throw "break outside loop"
        }
        eCallRet = pushJmpAtLen(E, E["eBreakIdxs"])
        E["eBreakIdxs"] = eCallRet
        emitOp(E, OP_JUMP, 0)
        return true
    return true
}

