// Smoke: lexer + parser + emit pipeline
import "self_host/lexer"
import "self_host/parser"
import "self_host/emit"

let ast = parseTokens(tokenize("let x = 1; return x"))
let bc = emit(ast)
if len(bc.globals) != 1 {
    throw "smoke: expected one global"
}
if bc.globals[0] != "x" {
    throw "smoke: expected global x"
}
println("self_host smoke ok")
