import "self_host/vm_s_pop"
import "self_host/vm_s_catch"

pub fn runOpCtrlThrow(S, name, arg, op, pool, globals, functions) {
    if name == "throw" {
        let reason = null
        if len(S["stack"]) > 0 {
            reason = vPopS(S)
        }
        if vCatchThrow(S, reason) == 1 {
            return 1
        }
        throw reason
    }
    return 0
}
