import "self_host/lexer_defs"
import "self_host/ast_defs"
import "self_host/parser_hooks"
import "self_host/parser_util"

pub fn parseUnary(sess) {
    if sess["pCur"].type == "!" {
        bump(sess)
        let uInner = pCallUnary(sess)
        return { "kind": AST_UNARY, "op": "!", "expr": uInner }
    }
    if sess["pCur"].type == "-" {
        bump(sess)
        let uInner = pCallUnary(sess)
        return { "kind": AST_UNARY, "op": "-", "expr": uInner }
    }
    if sess["pCur"].type == "~" {
        bump(sess)
        let uInner = pCallUnary(sess)
        return { "kind": AST_UNARY, "op": "~", "expr": uInner }
    }
    return pCallPostfix(sess)
}


