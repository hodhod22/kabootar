import "self_host/lexer_defs"
import "self_host/ast_defs"
import "self_host/parser_hooks"
import "self_host/parser_util"

pub fn parseUnary(sess) {
    if sess["pCur"].type == "!" {
        bump(sess)
        sess["pLeft"] = { "kind": AST_UNARY, "op": "!", "expr": pCallUnary(sess) }
        return sess["pLeft"]
    }
    if sess["pCur"].type == "-" {
        bump(sess)
        sess["pLeft"] = { "kind": AST_UNARY, "op": "-", "expr": pCallUnary(sess) }
        return sess["pLeft"]
    }
    if sess["pCur"].type == "~" {
        bump(sess)
        sess["pLeft"] = { "kind": AST_UNARY, "op": "~", "expr": pCallUnary(sess) }
        return sess["pLeft"]
    }
    return pCallPostfix(sess)
}
