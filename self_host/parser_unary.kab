import "self_host/lexer_defs"
import "self_host/ast_defs"
import "self_host/parser_hooks"
import "self_host/parser_util"
import "self_host/parser_unary_ops"

pub fn parseUnary(sess) {
    if parseUnary_bang(sess) == 1 {
        return sess["pLeft"]
    }
    if parseUnary_neg(sess) == 1 {
        return sess["pLeft"]
    }
    if parseUnary_bitnot(sess) == 1 {
        return sess["pLeft"]
    }
    return pCallPostfix(sess)
}
