import "self_host/emit_defs"
import "self_host/serialize_ir"

pub fn serIrOpNewInstance(op) {
    let line = OP_NEW_INSTANCE
    line = line + " "
    line = line + ("" + op.arg)
    line = line + " "
    let a2 = op.arg2
    if a2 == undefined {
        a2 = 0
    }
    line = line + ("" + a2)
    return line
}

pub fn serIrOpLookup(name, op) {
    if str_index_of(IR_WITH_ARG, "|" + name + "|") >= 0 {
        let line = name
        line = line + " "
        line = line + ("" + op.arg)
        return line
    }
    if str_index_of(IR_ZERO_ARG, "|" + name + "|") >= 0 {
        return name
    }
    throw "Unsupported IR op: " + name
}

pub fn serIrOpLine(op) {
    if op == null {
        throw "serialize: null op in IR"
    }
    let name = op.op
    if name == OP_NEW_INSTANCE {
        return serIrOpNewInstance(op)
    }
    return serIrOpLookup(name, op)
}
