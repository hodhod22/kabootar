// P6b: IR op line dispatcher (skip-listed until ≤10s).
import "self_host/emit_defs"
import "self_host/serialize_ir_op_new"
import "self_host/serialize_ir_op_lookup"

pub fn serIrOpLine(op) {
    if op == null {
        throw "serialize: null op in IR"
    }
    let name = op.op
    if name == OP_NEW_INSTANCE {
        return serIrOpNewInstance(op)
    }
    return serIrOpLookup(name, op)
}
