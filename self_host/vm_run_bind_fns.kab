// P6b: bind bytecode fns into S.globals as {vmFn:i}.
pub fn vBindFns(S, globals, functions) {
    let fi = 0
    while fi < len(functions) {
        let sym = functions[fi]["sym"]
        let gi2 = 0
        while gi2 < len(globals) {
            if globals[gi2] == sym {
                S["globals"][gi2] = { "vmFn": fi }
            }
            gi2 = gi2 + 1
        }
        fi = fi + 1
    }
}
