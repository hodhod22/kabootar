import "self_host/vm_s_push"
import "self_host/vm_s_ip"

pub fn runOpMemTakeLocal(S, name, arg, op, pool, globals, functions) {
    if name == "take_local" {
        let arr = S["locals"][arg]
        S["locals"][arg] = undefined
        vPushS(S, arr)
        vBumpIpS(S)
        return 1
    }
    return 0
}
