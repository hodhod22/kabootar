import "self_host/ast_defs"
import "self_host/emit_defs"
import "self_host/emit_hooks"
import "self_host/emit_arr_util"
import "self_host/emit_fn_body"

// Emit one method from E["eMeth"] into E["eClassMethods"] or generic templates.
pub fn emitGenClassMeth(E) {
    E["eMethTypeParams"] = E["eMeth"]["typeParams"]
    if E["eMethTypeParams"] == undefined {
        E["eMethTypeParams"] = []
    }
    if len(E["eMethTypeParams"]) == 0 {
        E["eParams"] = E["eMeth"]["params"]
        E["eFnBody"] = E["eMeth"]["body"]
        emitFnCompileBody(E)
        E["eClassMethods"] = push(E["eClassMethods"], {
            "sym": E["eMeth"]["sym"],
            "params": arrUtil(E, "snap", E["eParams"]),
            "locals": arrUtil(E, "snap", E["eFnLocals"]),
            "globals": arrUtil(E, "snap", E["eFnGlobals"]),
            "ops": arrUtil(E, "snap", E["eFnOps"])
        })
        E["eInFn"] = 0
        return 0
    }
    E["eGenericMethodTemplates"] = push(E["eGenericMethodTemplates"], {
        "classSym": E["eMangled"],
        "methodSym": E["eMeth"]["sym"],
        "typeParams": arrUtil(E, "snap", E["eMethTypeParams"]),
        "params": arrUtil(E, "snap", E["eMeth"]["params"]),
        "body": E["eMeth"]["body"]
    })
    return 0
}
