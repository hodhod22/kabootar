import "self_host/lexer_defs"
import "self_host/ast_defs"
import "self_host/parser_hooks"
import "self_host/parser_util"

pub fn pEnterBody(sess) {
    // Assign-back (not object_array_push): sess is Rc-shared across tramp calls.
    sess["pBodyStack"] = push(sess["pBodyStack"], sess["pBody"])
    sess["pBodyDepth"] = sess["pBodyDepth"] + 1
    sess["pBody"] = []
    return 0
}

pub fn pLeaveBody(sess) {
    let body = sess["pBody"]
    let st = sess["pBodyStack"]
    let n = len(st)
    sess["pBody"] = st[n - 1]
    sess["pBodyStack"] = slice(st, 0, n - 1)
    sess["pBodyDepth"] = sess["pBodyDepth"] - 1
    return body
}

pub fn pParseBodyUntilRBrace(sess, eofMsg) {
    while sess["pCur"].type != "}" {
        if sess["pCur"].type == "EOF" {
            throw eofMsg
        }
        let stmt = pCallStmt(sess)
        sess["pBody"] = push(sess["pBody"], stmt)
        if sess["pCur"].type == ";" {
            bump(sess)
        }
    }
    bump(sess)
    return 0
}

pub fn pEnterLoopBody(sess) {
    sess["pBodyStack"] = push(sess["pBodyStack"], sess["pLoopBody"])
    sess["pBodyDepth"] = sess["pBodyDepth"] + 1
    sess["pLoopBody"] = []
    return 0
}

pub fn pLeaveLoopBody(sess) {
    let body = sess["pLoopBody"]
    let st = sess["pBodyStack"]
    let n = len(st)
    sess["pLoopBody"] = st[n - 1]
    sess["pBodyStack"] = slice(st, 0, n - 1)
    sess["pBodyDepth"] = sess["pBodyDepth"] - 1
    return body
}

pub fn pParseLoopUntilRBrace(sess) {
    while sess["pCur"].type != "}" {
        let stmt = pCallStmt(sess)
        sess["pLoopBody"] = push(sess["pLoopBody"], stmt)
        if sess["pCur"].type == ";" {
            bump(sess)
        }
    }
    bump(sess)
    return 0
}
