import "self_host/vm_s_push"
import "self_host/vm_s_ip"
import "self_host/vm_s_caps"

pub fn runOpDataOptionArrow(S, name, arg, op, pool, globals, functions) {
    if name == "make_arrow_fn" {
        vPushS(S, { "vmArrow": arg, "caps": vSnapCapsS(S) })
        vBumpIpS(S)
        return 1
    }
    return 0
}
