// Bootstrap smoke: self-hosted compile of sample.kab-equivalent source.
import "self_host/compile"
import "self_host/lexer_defs"

let kbc = compile("let n = 10" + CHAR_NL + "return n + 32")
if char_at(kbc, 0) != "k" {
    throw "bootstrap: bad header"
}
if len(kbc) < 30 {
    throw "bootstrap: output too short"
}
println("bootstrap smoke ok")
