// P6b: 2-way dispatch chain (≤10s self-host compile).
import "self_host/vm_run_dispatch_arith_ab"
import "self_host/vm_run_dispatch_arith_cd"

pub fn runOpArithS(S, name, arg, op, pool, globals, functions) {
    let st = runOpArithAb(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpArithCd(S, name, arg, op, pool, globals, functions)
}
