import "self_host/parse"
import "self_host/emit"
import "self_host/ast_defs"
os_mount("/proj", "C:/after-2026-06-03/new-kabootar-reserv/nova-interpreter")
let ast = parse(read_text_file("/proj/self_host/lexer.kab"))
let i = 0
while i < len(ast.body) {
    let sym = ast.body[i].sym
    let sub = { "kind": AST_PROGRAM, "body": [ast.body[i]], "imports": ast.imports }
    emit(sub)
    println("OK fn " + ("" + i) + ": " + ("" + sym))
    i = i + 1
}
return len(ast.body)
