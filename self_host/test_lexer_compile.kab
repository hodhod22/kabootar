// Smoke: self-hosted compile of lexer-like char_at loop.
import "self_host/compile"
import "self_host/lexer_defs"

let kbc = compile("let pos = 0" + CHAR_NL + "let src = " + QUOTE + "ab" + QUOTE + CHAR_NL + "while pos < len(src) {" + CHAR_NL + "  pos = pos + 1" + CHAR_NL + "}" + CHAR_NL + "return pos")
if char_at(kbc, 0) != "k" {
    throw "lexer compile: bad header"
}
println("lexer compile smoke ok")
