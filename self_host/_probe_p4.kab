import "self_host/compile"
os_mount("/proj", ".")
compile("fn t(E) { E[\"a\"] = 1; return E }")
println("OK idx AccAdd num")
compile("fn t(E) { E[\"a\"] = { \"x\": 1 }; return E }")
println("OK idx AccAdd obj lit")
compile("fn t(E) { E[\"a\"] = { \"x\": 1 + 2 }; return E }")
println("OK idx AccAdd obj num plus")
compile("fn t(E) { let ai = 0; E[\"a\"] = { \"sym\": \"a\" + ai }; return E }")
println("OK idx AccAdd obj str plus")
