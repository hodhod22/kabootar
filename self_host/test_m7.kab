// Milestone 7: != chains and lexer-like compile patterns.
import "self_host/lexer"
import "self_host/parser"
import "self_host/ast_defs"
import "self_host/compile"

let passed = 0
let fail = 0

fn assert_eq(a, b, msg) {
    if a == b {
        passed = passed + 1
    } else {
        fail = fail + 1
        println("FAIL: " + msg)
    }
}

fn assert_kind(node, kind, msg) {
    assert_eq(node.kind, kind, msg)
}

{
    let ast = parseTokens(tokenize("x != null"))
    assert_kind(ast.body[0].expr, AST_BINARY, "ne null")
    assert_eq(ast.body[0].expr.op, "!=", "ne op")
}

{
    let ast = parseTokens(tokenize("kw == undefined"))
    assert_kind(ast.body[0].expr, AST_BINARY, "eq undefined")
    assert_eq(ast.body[0].expr.op, "==", "eq undef op")
}

{
    let ast = parseTokens(tokenize("while x { continue }"))
    assert_kind(ast.body[0], AST_WHILE, "while continue")
    assert_kind(ast.body[0].body.body[0], AST_CONTINUE, "continue stmt")
}

{
    let ast = parseTokens(tokenize("while x { break }"))
    assert_kind(ast.body[0].body.body[0], AST_BREAK, "break stmt")
}

{
    let kbc = compile("let parts = []")
    if char_at(kbc, 0) != "k" {
        throw "array literal compile failed"
    }
    passed = passed + 1
}

println("")
println("Self-hosted milestone-7 subset: " + ("" + passed) + " passed, " + ("" + fail) + " failed")
if fail > 0 {
    throw "M7 SUBSET FAILED"
}
