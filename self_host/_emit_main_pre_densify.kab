                    E["eSaveFnOpsN"] = E["eFnOpsN"]
                    E["eSaveFnLocals"] = arrUtil(E, "snap",E["eFnLocals"])
                    E["eSaveFnGlobals"] = arrUtil(E, "snap",E["eFnGlobals"])
