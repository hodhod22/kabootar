                    E["eFnOps"] = E["eSaveFnOps"]
                    E["eFnOpsN"] = E["eSaveFnOpsN"]
                    E["eFnLocals"] = E["eSaveFnLocals"]
                    rebuildLocalMap(E)
                    E["eFnGlobals"] = E["eSaveFnGlobals"]
                }
                E["eCallee"] = { "kind": AST_VAR, "sym": E["eMangled"] }
            }
            eCallRet = symIndex(E, "class",E["eGenSym"])
            E["eClassIdx"] = eCallRet
            if E["eClassIdx"] >= 0 {
                E["eCallArgIStack"] = push(E["eCallArgIStack"], 0)
                E["eCallArgNStack"] = push(E["eCallArgNStack"], E["eArgN"])
                E["eArgsStack"] = push(E["eArgsStack"], E["eArgs"])
                emitCallArgExprs(E)
                if E["eInFn"] == 1 {
                    E["eFnOps"] = push(E["eFnOps"], { "op": OP_NEW_INSTANCE, "arg": E["eClassIdx"], "arg2": E["eArgN"] })
                    E["eFnOpsN"] = E["eFnOpsN"] + 1
                } else {
                    E["eOps"] = push(E["eOps"], { "op": OP_NEW_INSTANCE, "arg": E["eClassIdx"], "arg2": E["eArgN"] })
                    E["eOpsN"] = E["eOpsN"] + 1
                }
                dropCallCallee(E)
                return
            }
        }
        if E["eArgN"] == 0 {
            emitCallCallee(E)
            emitOp(E, OP_CALL, 0)
            return
        }
        if E["eArgN"] == 1 {
            E["eBxL"] = E["eArgs"][0]
            if E["eBxL"].kind == AST_LITERAL {
                eCallRet = symIndex(E, "constLit",E["eBxL"])
                E["eIdx"] = eCallRet
                emitOp(E, OP_CONST, eCallRet)
            } else {
                if E["eBxL"].kind == AST_VAR {
                    E["eSym"] = E["eBxL"]["sym"]
                    emitSym(E, 0,E["eSym"])
                } else {
                    emitExpr(E, E["eBxL"])
                }
            }
            emitCallCallee(E)
            emitOp(E, OP_CALL, 1)
            return
        }
        if E["eArgN"] == 2 {
            E["eBxL"] = E["eArgs"][0]
            E["eBxR"] = E["eArgs"][1]
            if E["eBxL"].kind == AST_LITERAL {
                eCallRet = symIndex(E, "constLit",E["eBxL"])
                E["eIdx"] = eCallRet
                emitOp(E, OP_CONST, eCallRet)
            } else {
                if E["eBxL"].kind == AST_VAR {
                    E["eSym"] = E["eBxL"]["sym"]
                    emitSym(E, 0,E["eSym"])
                } else {
                    emitExpr(E, E["eBxL"])
                }
            }
            if E["eBxR"].kind == AST_LITERAL {
                eCallRet = symIndex(E, "constLit",E["eBxR"])
                E["eIdx"] = eCallRet
                emitOp(E, OP_CONST, eCallRet)
            } else {
                if E["eBxR"].kind == AST_VAR {
                    E["eSym"] = E["eBxR"]["sym"]
                    emitSym(E, 0,E["eSym"])
                } else {
                    emitExpr(E, E["eBxR"])
                }
            }
            emitCallCallee(E)
            emitOp(E, OP_CALL, 2)
            return
        }
        E["eCallArgIStack"] = push(E["eCallArgIStack"], 0)
        E["eCallArgNStack"] = push(E["eCallArgNStack"], E["eArgN"])
        E["eArgsStack"] = push(E["eArgsStack"], E["eArgs"])
        E["eCallArgDepth"] = E["eCallArgDepth"] + 1
        let cad = E["eCallArgDepth"]
        while E["eCallArgIStack"][cad - 1] < E["eCallArgNStack"][cad - 1] {
            E["eArgs"] = E["eArgsStack"][cad - 1]
            E["eCallI"] = E["eCallArgIStack"][cad - 1]
            E["eBxL"] = E["eArgs"][E["eCallI"]]
            if E["eBxL"].kind == AST_LITERAL {
                eCallRet = symIndex(E, "constLit",E["eBxL"])
                E["eIdx"] = eCallRet
                emitOp(E, OP_CONST, eCallRet)
            } else {
                if E["eBxL"].kind == AST_VAR {
                    E["eSym"] = E["eBxL"]["sym"]
                    emitSym(E, 0,E["eSym"])
                } else {
                    emitExpr(E, E["eBxL"])
                }
            }
            E["eCallArgIStack"][cad - 1] = E["eCallArgIStack"][cad - 1] + 1
        }
        E["eArgsStack"] = pop(E["eArgsStack"])
        E["eArgN"] = E["eCallArgNStack"][cad - 1]
        E["eCallArgIStack"] = pop(E["eCallArgIStack"])
        E["eCallArgNStack"] = pop(E["eCallArgNStack"])
        E["eCallArgDepth"] = E["eCallArgDepth"] - 1
        emitCallCallee(E)
        emitOp(E, OP_CALL, E["eArgN"])
        return
    }
    throw "Unsupported expr: " + E["eNode"].kind
}

// P6b: shared jump patch / len push — use op counters (avoid len(E["eOps"]) LoadGlobal clone).
fn patchRelJump(E, opName, idx) {
    if E["eInFn"] == 1 {
        eCallRet = E["eFnOpsN"] - idx
        E["eJumpOff"] = eCallRet - 1
        E["eFnOps"][idx] = { "op": opName, "arg": E["eJumpOff"] }
    } else {
        eCallRet = E["eOpsN"] - idx
        E["eJumpOff"] = eCallRet - 1
        E["eOps"][idx] = { "op": opName, "arg": E["eJumpOff"] }
    }
}

fn pushJmpAtLen(E, stack) {
    if E["eInFn"] == 1 {
        return push(stack, E["eFnOpsN"])
    }
    return push(stack, E["eOpsN"])
}

/// If stmt body (called early from emitStmt — dense leaves are If-heavy).
/// P6b: E["eIfDepth"] indexes If stacks (avoid len(eIf*/E["eCond"]*) LoadGlobal clones).
fn emitIfStmt(E) {
    E["eCondStack"] = push(E["eCondStack"], E["eCond"])
    E["eThenStack"] = push(E["eThenStack"], E["eThen"])
    E["eElseStack"] = push(E["eElseStack"], E["eElse"])
    E["eIfDepth"] = E["eIfDepth"] + 1
    let id = E["eIfDepth"]
    E["eCond"] = E["eNode"]["cond"]
    E["eThen"] = E["eNode"]["then"]
    E["eElse"] = E["eNode"]["elseBranch"]
    emitExpr(E, E["eCond"])
    eCallRet = pushJmpAtLen(E, E["eIfJmpStack"])
    E["eIfJmpStack"] = eCallRet
    emitOp(E, OP_JUMP_IF_FALSE, 0)
    emitStmt(E, E["eThen"])
    if E["eElse"] != null {
        eCallRet = pushJmpAtLen(E, E["eIfSkipStack"])
        E["eIfSkipStack"] = eCallRet
        emitOp(E, OP_JUMP, 0)
        // Jmp/skip stacks: always top via len (jmp is popped before else; depth ≠ len).
        // P6b: len_* / index_get_* make this cheap (no LoadGlobal clone).
        eCallRet = len(E["eIfJmpStack"]) - 1
        E["eJmp"] = E["eIfJmpStack"][eCallRet]
        patchRelJump(E, OP_JUMP_IF_FALSE, E["eJmp"])
        E["eIfJmpStack"] = pop(E["eIfJmpStack"])
        emitStmt(E, E["eElse"])
        eCallRet = len(E["eIfSkipStack"]) - 1
        E["eIdx"] = E["eIfSkipStack"][eCallRet]
        patchRelJump(E, OP_JUMP, E["eIdx"])
        E["eIfSkipStack"] = pop(E["eIfSkipStack"])
    } else {
        eCallRet = len(E["eIfJmpStack"]) - 1
        E["eJmp"] = E["eIfJmpStack"][eCallRet]
        patchRelJump(E, OP_JUMP_IF_FALSE, E["eJmp"])
        E["eIfJmpStack"] = pop(E["eIfJmpStack"])
    }
    E["eCond"] = E["eCondStack"][id - 1]
    E["eThen"] = E["eThenStack"][id - 1]
    E["eElse"] = E["eElseStack"][id - 1]
    E["eCondStack"] = pop(E["eCondStack"])
    E["eThenStack"] = pop(E["eThenStack"])
    E["eElseStack"] = pop(E["eElseStack"])
    E["eIfDepth"] = E["eIfDepth"] - 1
}

fn emitStmt(E, node) {
    E["eStmtNode"] = node
    E["eNode"] = node
    E["eStmtKind"] = E["eStmtNode"].kind
    // P6b: check If before the long Let/Assign/… chain (serialize_body is If-dense).
    if E["eStmtKind"] == AST_IF {
        emitIfStmt(E)
        return
    }
    if E["eNode"].kind == AST_LET {
        E["eAssignSym"] = E["eNode"]["sym"]
        E["eLitNode"] = E["eNode"]["init"]
        if E["eLitNode"]["kind"] == AST_LITERAL {
            if E["eLitNode"]["lit"] == LIT_NUMBER {
                E["eBindingSyms"] = push(E["eBindingSyms"], E["eAssignSym"])
                E["eBindingTypes"] = push(E["eBindingTypes"], "Number")
            }
            if E["eLitNode"]["lit"] == LIT_STRING {
                E["eBindingSyms"] = push(E["eBindingSyms"], E["eAssignSym"])
                E["eBindingTypes"] = push(E["eBindingTypes"], "String")
            }
        }
        if E["eLitNode"]["kind"] == AST_CALL {
            E["eCtorCallee"] = E["eLitNode"]["callee"]
            if E["eCtorCallee"].kind == AST_VAR {
                E["eCtorName"] = E["eCtorCallee"]["sym"]
                E["eFound"] = 0
                E["eGenI"] = 0
                while E["eGenI"] < E["eClassesN"] {
                    if E["eClasses"][E["eGenI"]]["sym"] == E["eCtorName"] {
                        E["eBindingSyms"] = push(E["eBindingSyms"], E["eAssignSym"])
                        E["eBindingTypes"] = push(E["eBindingTypes"], E["eCtorName"])
                        E["eFound"] = 1
                    }
                    E["eGenI"] = E["eGenI"] + 1
                }
                if E["eFound"] == 0 {
                    E["eGenTmpl"] = null
                    E["eGenI"] = 0
                    while E["eGenI"] < len(E["eGenericClassTemplates"]) {
                        if E["eGenericClassTemplates"][E["eGenI"]]["sym"] == E["eCtorName"] {
                            E["eGenTmpl"] = E["eGenericClassTemplates"][E["eGenI"]]
                        }
                        E["eGenI"] = E["eGenI"] + 1
                    }
                    if E["eGenTmpl"] != null {
                        E["eCtorArgs"] = E["eLitNode"]["args"]
                        E["eTypeArgs"] = []
                        E["eResolveI"] = 0
                        while E["eResolveI"] < len(E["eCtorArgs"]) {
                            E["eInferType"] = ""
                            if E["eCtorArgs"][E["eResolveI"]].kind == AST_LITERAL {
                                if E["eCtorArgs"][E["eResolveI"]].lit == LIT_NUMBER {
                                    E["eInferType"] = "Number"
                                }
                                if E["eCtorArgs"][E["eResolveI"]].lit == LIT_STRING {
                                    E["eInferType"] = "String"
                                }
                            }
                            if E["eInferType"] != "" {
                                E["eTypeArgs"] = push(E["eTypeArgs"], E["eInferType"])
                            }
                            E["eResolveI"] = E["eResolveI"] + 1
                        }
                        E["eMangled"] = E["eCtorName"]
                        if len(E["eTypeArgs"]) > 0 {
                            eCallRet = E["eMangled"] + "$"
                            E["eMangled"] = eCallRet + E["eTypeArgs"][0]
                            E["eResolveI"] = 1
                            while E["eResolveI"] < len(E["eTypeArgs"]) {
                                eCallRet = E["eMangled"] + "_"
                                E["eMangled"] = eCallRet + E["eTypeArgs"][E["eResolveI"]]
                                E["eResolveI"] = E["eResolveI"] + 1
                            }
                        }
                        E["eBindingSyms"] = push(E["eBindingSyms"], E["eAssignSym"])
                        E["eBindingTypes"] = push(E["eBindingTypes"], E["eMangled"])
                    }
                }
            }
        }
        emitExpr(E, E["eNode"]["init"])
        if E["eInFn"] == 1 {
            eCallRet = symIndex(E, "local",E["eAssignSym"])
            E["eIdx"] = eCallRet
            emitOp(E, OP_STORE_LOCAL, eCallRet)
        } else {
            eCallRet = symIndex(E, "global",E["eAssignSym"])
            E["eIdx"] = eCallRet
            emitOp(E, OP_STORE_GLOBAL, eCallRet)
        }
        if E["eInFn"] != 1 {
            // Read isPub from the let stmt before emitExpr clobbers E["eNode"].
            eLetPub = E["eStmtNode"]["isPub"]
            if eLetPub {
                eCallRet = ("" + E["eAssignSym"]) + ""
                E["eExports"] = push(E["eExports"], eCallRet)
            }
        }
        return
    }
    if E["eNode"].kind == AST_ASSIGN {
        E["eAssignSym"] = E["eNode"]["sym"]
        if tryEmitArrayPushAssign(E, E["eAssignSym"], E["eNode"]["rhs"]) {
            return
        }
        if tryEmitAccAddAssign(E, E["eAssignSym"], E["eNode"]["rhs"]) {
            return
        }
        emitExpr(E, E["eNode"]["rhs"])
        emitSym(E, 1,E["eAssignSym"])
        return
    }
    if E["eNode"].kind == AST_INDEX_ASSIGN {
        E["eBxL"] = E["eNode"]["object"]
        E["eBxR"] = E["eNode"]["index"]
        E["eBxRhs"] = E["eNode"]["rhs"]
        emitExpr(E, E["eBxL"])
        emitExpr(E, E["eBxR"])
        emitExpr(E, E["eBxRhs"])
        emitOp(E, OP_INDEX_SET, 0)
        emitOp(E, OP_POP, 0)
        emitOp(E, OP_POP, 0)
        return
    }
    if E["eNode"].kind == AST_MEMBER_ASSIGN {
        E["eBxL"] = E["eNode"]["object"]
        E["eMemberFld"] = E["eNode"]["field"]
        E["eBxRhs"] = E["eNode"]["rhs"]
        emitExpr(E, E["eBxL"])
        emitExpr(E, E["eBxRhs"])
        eCallRet = symIndex(E, "const", E["eMemberFld"])
        E["eIdx"] = eCallRet
        emitOp(E, OP_SET_MEMBER, eCallRet)
        emitOp(E, OP_POP, 0)
        emitOp(E, OP_POP, 0)
        return
    }
    if E["eNode"].kind == AST_EXPR {
        E["eExprStmt"] = E["eNode"]["expr"]
        emitExpr(E, E["eExprStmt"])
        if E["eExprStmt"].kind != AST_THROW {
            emitOp(E, OP_POP, 0)
        }
        return
    }
    if E["eNode"].kind == AST_THROW {
        emitExpr(E, E["eNode"]["expr"])
        emitOp(E, OP_THROW, 0)
        return
    }
    if E["eNode"].kind == AST_TRY {
        if E["eInFn"] != 1 {
            throw "try/catch only supported inside fn (self-host emit)"
        }
        let tryBody = E["eNode"]["body"]
        let tryHandler = E["eNode"]["handler"]
        let errName = E["eNode"]["errName"]
        let bodyStart = E["eFnOpsN"]
        emitStmt(E, tryBody)
        let bodyEnd = E["eFnOpsN"]
        // Statement try: jump over catch on success (throw uses tryRegions).
        emitOp(E, OP_JUMP, 0)
        let jmpEndIdx = bodyEnd
        let catchStart = E["eFnOpsN"]
        let errLocal = symIndex(E, "local", errName)
        E["eFnTryRegions"] = push(E["eFnTryRegions"], {
            "bodyStart": bodyStart,
            "bodyEnd": bodyEnd,
            "catchStart": catchStart,
            "errLocal": errLocal
        })
        emitOp(E, OP_STORE_LOCAL, errLocal)
        emitStmt(E, tryHandler)
        let afterCatch = E["eFnOpsN"]
        eCallRet = afterCatch - jmpEndIdx - 1
        E["eFnOps"][jmpEndIdx] = { "op": OP_JUMP, "arg": eCallRet }
        return
    }
    if E["eNode"].kind == AST_FOR_OF {
        if E["eInFn"] != 1 {
            throw "for-of only supported inside fn (self-host emit)"
        }
        let forSym = E["eNode"]["sym"]
        let forIter = E["eNode"]["iterable"]
        let forBody = E["eNode"]["body"]
        let n = E["eForCounter"]
        E["eForCounter"] = n + 1
        let src = "__kab_f" + n + "_src"
        let res = "__kab_f" + n + "_r"
        let srcIdx = symIndex(E, "local", src)
        let resIdx = symIndex(E, "local", res)
        let varIdx = symIndex(E, "local", forSym)
        emitExpr(E, forIter)
        emitOp(E, OP_STORE_LOCAL, srcIdx)
        emitOp(E, OP_LOAD_LOCAL, srcIdx)
        emitOp(E, OP_LOAD_GLOBAL, symIndex(E, "global", "iterator_begin"))
        emitOp(E, OP_CALL, 1)
        emitOp(E, OP_STORE_LOCAL, srcIdx)
        E["eBreakFromStack"] = arrUtil(E, "pushLen", E["eBreakFromStack"], E["eBreakIdxs"])
        let loopStart = E["eFnOpsN"]
        E["eWhileHeads"] = push(E["eWhileHeads"], loopStart)
        emitOp(E, OP_LOAD_LOCAL, srcIdx)
        emitOp(E, OP_ITER_STEP, 0)
        emitOp(E, OP_STORE_LOCAL, resIdx)
        emitOp(E, OP_STORE_LOCAL, srcIdx)
        emitOp(E, OP_LOAD_LOCAL, resIdx)
        emitOp(E, OP_CONST, symIndex(E, "const", "done"))
        emitOp(E, OP_INDEX_GET, 0)
        let jmpDoneIdx = E["eFnOpsN"]
        emitOp(E, OP_JUMP_IF_FALSE, 0)
        let jmpExitIdx = E["eFnOpsN"]
        emitOp(E, OP_JUMP, 0)
        let bodyStart = E["eFnOpsN"]
        eCallRet = bodyStart - jmpDoneIdx - 1
        E["eFnOps"][jmpDoneIdx] = { "op": OP_JUMP_IF_FALSE, "arg": eCallRet }
        emitOp(E, OP_LOAD_LOCAL, resIdx)
        emitOp(E, OP_CONST, symIndex(E, "const", "value"))
        emitOp(E, OP_INDEX_GET, 0)
        emitOp(E, OP_STORE_LOCAL, varIdx)
        emitStmt(E, forBody)
        emitOp(E, OP_JUMP, loopStart - E["eFnOpsN"] - 1)
        let loopEnd = E["eFnOpsN"]
        eCallRet = loopEnd - jmpExitIdx - 1
        E["eFnOps"][jmpExitIdx] = { "op": OP_JUMP, "arg": eCallRet }
        eCallRet = len(E["eBreakFromStack"]) - 1
        E["eBf"] = E["eBreakFromStack"][eCallRet]
        E["eBi"] = E["eBf"]
        while E["eBi"] < len(E["eBreakIdxs"]) {
            eCallRet = loopEnd - E["eBreakIdxs"][E["eBi"]]
            E["eJumpOff"] = eCallRet - 1
            E["eFnOps"][E["eBreakIdxs"][E["eBi"]]] = { "op": OP_JUMP, "arg": E["eJumpOff"] }
            E["eBi"] = E["eBi"] + 1
        }
        if E["eBf"] > 0 {
            E["eBreakIdxs"] = slice(E["eBreakIdxs"], 0, E["eBf"])
        } else {
            E["eBreakIdxs"] = []
        }
        if len(E["eWhileHeads"]) > 0 {
            E["eWhileHeads"] = pop(E["eWhileHeads"])
        } else {
            E["eWhileHeads"] = []
        }
        if len(E["eBreakFromStack"]) > 0 {
            E["eBreakFromStack"] = pop(E["eBreakFromStack"])
        } else {
            E["eBreakFromStack"] = []
        }
        return
    }
    if E["eNode"].kind == AST_RETURN {
        if E["eNode"]["value"] == null {
            emitOp(E, OP_CONST, symIndex(E, "const",null))
        } else {
            emitExpr(E, E["eNode"]["value"])
        }
        emitOp(E, OP_RETURN, 0)
        return
    }
    if E["eNode"].kind == AST_BLOCK {
        E["eBlockStmtsStack"] = push(E["eBlockStmtsStack"], E["eNode"]["body"])
        E["eBlockNStack"] = arrUtil(E, "pushLen",E["eBlockNStack"], E["eNode"]["body"])
        E["eBlockIStack"] = push(E["eBlockIStack"], 0)
        E["eBlockDepth"] = E["eBlockDepth"] + 1
        let bd = E["eBlockDepth"]
        while E["eBlockIStack"][bd - 1] < E["eBlockNStack"][bd - 1] {
            E["eBlockStmts"] = E["eBlockStmtsStack"][bd - 1]
            E["eBlockI"] = E["eBlockIStack"][bd - 1]
            E["eStmtNode"] = E["eBlockStmts"][E["eBlockI"]]
            if E["eStmtNode"] == null {
                throw "emit block null stmt at " + ("" + E["eBlockI"])
            }
            emitStmt(E, E["eStmtNode"])
            E["eBlockIStack"][bd - 1] = E["eBlockIStack"][bd - 1] + 1
        }
        E["eBlockStmtsStack"] = pop(E["eBlockStmtsStack"])
        E["eBlockNStack"] = pop(E["eBlockNStack"])
        E["eBlockIStack"] = pop(E["eBlockIStack"])
        E["eBlockDepth"] = E["eBlockDepth"] - 1
        return
    }
    if E["eNode"].kind == AST_CONTINUE {
        if len(E["eWhileHeads"]) == 0 {
            throw "continue outside loop"
        }
        eCallRet = len(E["eWhileHeads"]) - 1
        E["eWh"] = E["eWhileHeads"][eCallRet]
        if E["eInFn"] == 1 {
            eCallRet = E["eWh"] - E["eFnOpsN"]
            E["eJumpOff"] = eCallRet - 1
        } else {
            eCallRet = E["eWh"] - E["eOpsN"]
            E["eJumpOff"] = eCallRet - 1
        }
        emitOp(E, OP_JUMP, E["eJumpOff"])
        return
    }
    if E["eNode"].kind == AST_BREAK {
        if len(E["eBreakFromStack"]) == 0 {
            throw "break outside loop"
        }
        eCallRet = pushJmpAtLen(E, E["eBreakIdxs"])
        E["eBreakIdxs"] = eCallRet
        emitOp(E, OP_JUMP, 0)
        return
    }
    if E["eNode"].kind == AST_WHILE {
        E["eCond"] = E["eNode"]["cond"]
        E["eThen"] = E["eNode"]["body"]
        E["eBreakFromStack"] = arrUtil(E, "pushLen",E["eBreakFromStack"], E["eBreakIdxs"])
        if E["eInFn"] == 1 {
            E["eWhileHead"] = E["eFnOpsN"]
        } else {
            E["eWhileHead"] = E["eOpsN"]
        }
        E["eWhileHeads"] = push(E["eWhileHeads"], E["eWhileHead"])
        emitExpr(E, E["eCond"])
        eCallRet = pushJmpAtLen(E, E["eIfJmpStack"])
        E["eIfJmpStack"] = eCallRet
        emitOp(E, OP_JUMP_IF_FALSE, 0)
        emitStmt(E, E["eThen"])
        if E["eInFn"] == 1 {
            eCallRet = E["eWhileHead"] - E["eFnOpsN"]
            E["eJumpOff"] = eCallRet - 1
        } else {
            eCallRet = E["eWhileHead"] - E["eOpsN"]
            E["eJumpOff"] = eCallRet - 1
        }
        emitOp(E, OP_JUMP, E["eJumpOff"])
        eCallRet = len(E["eIfJmpStack"]) - 1
        E["eJmp"] = E["eIfJmpStack"][eCallRet]
        patchRelJump(E, OP_JUMP_IF_FALSE, E["eJmp"])
        E["eIfJmpStack"] = pop(E["eIfJmpStack"])
        if E["eInFn"] == 1 {
            E["eEnd"] = E["eFnOpsN"]
        } else {
            E["eEnd"] = E["eOpsN"]
        }
        eCallRet = len(E["eBreakFromStack"]) - 1
        E["eBf"] = E["eBreakFromStack"][eCallRet]
        E["eBi"] = E["eBf"]
        while E["eBi"] < len(E["eBreakIdxs"]) {
            eCallRet = E["eEnd"] - E["eBreakIdxs"][E["eBi"]]
            E["eJumpOff"] = eCallRet - 1
            if E["eInFn"] == 1 {
                E["eFnOps"][E["eBreakIdxs"][E["eBi"]]] = { "op": OP_JUMP, "arg": E["eJumpOff"] }
            } else {
                E["eOps"][E["eBreakIdxs"][E["eBi"]]] = { "op": OP_JUMP, "arg": E["eJumpOff"] }
            }
            E["eBi"] = E["eBi"] + 1
        }
        if E["eBf"] > 0 {
            E["eBreakIdxs"] = slice(E["eBreakIdxs"], 0, E["eBf"])
        } else {
            E["eBreakIdxs"] = []
        }
        if len(E["eWhileHeads"]) > 0 {
            E["eWhileHeads"] = pop(E["eWhileHeads"])
        } else {
            E["eWhileHeads"] = []
        }
        if len(E["eBreakFromStack"]) > 0 {
            E["eBreakFromStack"] = pop(E["eBreakFromStack"])
        } else {
            E["eBreakFromStack"] = []
        }
        return
    }
    if E["eNode"].kind == AST_ENUM {
        E["eTypeParams"] = E["eNode"]["typeParams"]
        if E["eTypeParams"] == undefined {
            E["eTypeParams"] = []
        }
        if len(E["eTypeParams"]) > 0 {
            E["eGenericEnumTemplates"] = push(E["eGenericEnumTemplates"], {
                "sym": E["eNode"]["sym"],
                "typeParams": arrUtil(E, "snap",E["eTypeParams"]),
                "variants": arrUtil(E, "snap",E["eNode"]["variants"])
            })
        }
        return
    }
    if E["eNode"].kind == AST_CLASS {
        E["eFnSave"] = "" + E["eNode"]["sym"]
        E["eTypeParams"] = E["eNode"]["typeParams"]
        if E["eTypeParams"] == undefined {
            E["eTypeParams"] = []
        }
        if len(E["eTypeParams"]) > 0 {
            E["eGenericClassTemplates"] = push(E["eGenericClassTemplates"], {
                "sym": E["eFnSave"],
                "typeParams": arrUtil(E, "snap",E["eTypeParams"]),
                "methods": arrUtil(E, "snap",E["eNode"]["methods"])
            })
            return
        }
        // Snap before emitStmt — emitStmt overwrites module-global E["eNode"].
        E["eClassMethodsSrc"] = E["eNode"]["methods"]
        E["eClassIsStruct"] = E["eNode"]["isStruct"]
        E["eClassMethods"] = []
        eMi = 0
        while eMi < len(E["eClassMethodsSrc"]) {
            eMeth = E["eClassMethodsSrc"][eMi]
            eMethTypeParams = eMeth["typeParams"]
            if eMethTypeParams == undefined {
                eMethTypeParams = []
            }
            if len(eMethTypeParams) > 0 {
                E["eGenericMethodTemplates"] = push(E["eGenericMethodTemplates"], {
                    "classSym": E["eFnSave"],
                    "methodSym": eMeth["sym"],
                    "typeParams": arrUtil(E, "snap",eMethTypeParams),
                    "params": arrUtil(E, "snap",eMeth["params"]),
                    "body": eMeth["body"]
                })
            } else {
                E["eInFn"] = 1
                E["eFnOps"] = []
                E["eFnOpsN"] = 0
                E["eFnGlobals"] = []
                E["eFnLocals"] = []
                resetLocalMap(E)
                E["eParams"] = eMeth["params"]
                E["eParamI"] = 0
                while E["eParamI"] < len(E["eParams"]) {
                    E["eLoopSave"] = E["eParamI"]
                    symIndex(E, "local",E["eParams"][E["eParamI"]])
                    E["eParamI"] = E["eLoopSave"] + 1
                }
                emitStmt(E, eMeth["body"])
                E["eClassMethods"] = push(E["eClassMethods"], {
                    "sym": eMeth["sym"],
                    "params": arrUtil(E, "snap",E["eParams"]),
                    "locals": arrUtil(E, "snap",E["eFnLocals"]),
                    "globals": arrUtil(E, "snap",E["eFnGlobals"]),
                    "ops": arrUtil(E, "snap",E["eFnOps"])
                })
                E["eInFn"] = 0
            }
            eMi = eMi + 1
        }
        E["eClasses"] = push(E["eClasses"], {
            "sym": E["eFnSave"],
            "methods": E["eClassMethods"],
            "isStruct": E["eClassIsStruct"]
        })
        E["eClassesN"] = E["eClassesN"] + 1
        return
    }
    if E["eNode"].kind == AST_INTERFACE {
        return
    }
    if E["eNode"].kind == AST_FN {
        E["eFnSave"] = "" + E["eNode"]["sym"]
        E["eFnPub"] = E["eNode"]["isPub"]
        E["eParams"] = E["eNode"]["params"]
        E["eFnBody"] = E["eNode"]["body"]
        E["eTypeParams"] = E["eNode"]["typeParams"]
        if E["eTypeParams"] == undefined {
            E["eTypeParams"] = []
        }
        if len(E["eTypeParams"]) > 0 {
            E["eGenericTemplates"] = push(E["eGenericTemplates"], {
                "sym": E["eFnSave"],
                "typeParams": arrUtil(E, "snap",E["eTypeParams"]),
                "params": arrUtil(E, "snap",E["eParams"]),
                "body": E["eFnBody"],
                "isPub": E["eFnPub"]
            })
            if E["eFnPub"] == 1 {
                eCallRet = ("" + E["eFnSave"]) + ""
                E["eExports"] = push(E["eExports"], eCallRet)
            }
            return
        }
        E["eInFn"] = 1
        E["eFnOps"] = []
        E["eFnOpsN"] = 0
        E["eFnGlobals"] = []
        E["eFnLocals"] = []
        resetLocalMap(E)
        E["eFnTryRegions"] = []
        E["eParamI"] = 0
        while E["eParamI"] < len(E["eParams"]) {
            E["eLoopSave"] = E["eParamI"]
            symIndex(E, "local",E["eParams"][E["eParamI"]])
            E["eParamI"] = E["eLoopSave"] + 1
        }
        emitStmt(E, E["eFnBody"])
        E["eFunctions"] = push(E["eFunctions"], {
            "sym": E["eFnSave"],
            "params": arrUtil(E, "snap",E["eParams"]),
            "locals": arrUtil(E, "snap",E["eFnLocals"]),
            "globals": arrUtil(E, "snap",E["eFnGlobals"]),
            "ops": arrUtil(E, "snap",E["eFnOps"]),
            "tryRegions": arrUtil(E, "snap", E["eFnTryRegions"])
        })
        E["eInFn"] = 0
        E["eFnTryRegions"] = []
        symIndex(E, "global",E["eFnSave"])
        if E["eFnPub"] == 1 {
            eCallRet = ("" + E["eFnSave"]) + ""
            E["eExports"] = push(E["eExports"], eCallRet)
        }
        return
    }
    if E["eNode"] == null {
        throw "emitStmt: null node"
    }
    if E["eNode"].kind == undefined {
        throw "emitStmt: missing kind"
    }
    throw "Unsupported stmt: " + E["eStmtKind"]
}

pub fn emitMain(E, program) {
    E["eProgram"] = program
    E["eConsts"] = []
    E["eConstMap"] = {}
    E["eConstN"] = 0
    E["eOps"] = []
    E["eOpsN"] = 0
    E["eGlobals"] = []
    E["eGlobalMap"] = {}
    E["eGlobalN"] = 0
    E["eFunctions"] = []
    E["eFnOps"] = []
    E["eFnOpsN"] = 0
    E["eBlockDepth"] = 0
    E["eCalleeDepth"] = 0
    E["eCallArgDepth"] = 0
    E["eObjDepth"] = 0
    E["eArrDepth"] = 0
    E["eIfDepth"] = 0
    E["eMemberDepth"] = 0
    E["eIndexDepth"] = 0
    E["eFnGlobals"] = []
    E["eFnLocals"] = []
    resetLocalMap(E)
    E["eInFn"] = 0
    E["eWhileHeads"] = []
    E["eBreakIdxs"] = []
    E["eBreakFromStack"] = []
    E["eIfJmpStack"] = []
    E["eIfSkipStack"] = []
    E["eMemberFldStack"] = []
    E["eBlockStmtsStack"] = []
    E["eBlockNStack"] = []
    E["eBlockIStack"] = []
    E["eObjIStack"] = []
    E["eObjNStack"] = []
    E["eArrIStack"] = []
    E["eArrNStack"] = []
    E["eCallArgIStack"] = []
    E["eCallArgNStack"] = []
    E["eArgsStack"] = []
    E["eCalleeStack"] = []
    E["eGenericTemplates"] = []
    E["eGenericClassTemplates"] = []
    E["eGenericEnumTemplates"] = []
    E["eGenericMethodTemplates"] = []
    E["eClasses"] = []
    E["eClassesN"] = 0
    E["eEnums"] = []
    E["eArrows"] = []
    E["eTryRegions"] = []
    E["eFnTryRegions"] = []
    E["eForCounter"] = 0
    E["eSpecMangled"] = []
    E["eBindingSyms"] = []
    E["eBindingTypes"] = []
    E["eExports"] = []
    E["eImports"] = []
    E["eProg"] = 0
    if E["eProgram"]["imports"] != undefined {
        E["eImports"] = E["eProgram"]["imports"]
    }
    E["eBlockStmtsStack"] = push(E["eBlockStmtsStack"], E["eProgram"]["body"])
    E["eBlockNStack"] = arrUtil(E, "pushLen",E["eBlockNStack"], E["eProgram"]["body"])
    E["eBlockIStack"] = push(E["eBlockIStack"], 0)
    E["eBlockDepth"] = E["eBlockDepth"] + 1
    let pd = E["eBlockDepth"]
    while E["eBlockIStack"][pd - 1] < E["eBlockNStack"][pd - 1] {
        E["eBlockStmts"] = E["eBlockStmtsStack"][pd - 1]
        E["eBlockI"] = E["eBlockIStack"][pd - 1]
        E["eStmtNode"] = E["eBlockStmts"][E["eBlockI"]]
        if E["eStmtNode"] == null {
            throw "emit program null stmt at " + ("" + E["eBlockI"])
        }
        emitStmt(E, E["eStmtNode"])
        E["eBlockIStack"][pd - 1] = E["eBlockIStack"][pd - 1] + 1
    }
    E["eBlockDepth"] = E["eBlockDepth"] - 1
    emitOp(E, OP_HALT, 0)
    return {
        "constants": E["eConsts"],
        "globals": E["eGlobals"],
        "ops": E["eOps"],
        "functions": E["eFunctions"],
        "classes": E["eClasses"],
        "enums": E["eEnums"],
        "arrows": E["eArrows"],
        "tryRegions": E["eTryRegions"],
        "locals": [],
        "genericMethodTemplates": E["eGenericMethodTemplates"],
        "exports": E["eExports"],
        "imports": E["eImports"]
    }
}

