import "self_host/emit_defs"
import "self_host/emit_op"

pub fn emitExpr_binaryLogic(E, binOp) {
    if binOp == "&&" {
        emitOp(E, OP_AND, 0)
        return 1
    }
    if binOp == "||" {
        emitOp(E, OP_OR, 0)
        return 1
    }
    return 0
}

pub fn emitExpr_binaryBit(E, binOp) {
    if binOp == "&" {
        emitOp(E, OP_BIT_AND, 0)
        return 1
    }
    if binOp == "|" {
        emitOp(E, OP_BIT_OR, 0)
        return 1
    }
    if binOp == "^" {
        emitOp(E, OP_BIT_XOR, 0)
        return 1
    }
    if binOp == "<<" {
        emitOp(E, OP_SHL, 0)
        return 1
    }
    if binOp == ">>" {
        emitOp(E, OP_SHR, 0)
        return 1
    }
    if binOp == ">>>" {
        emitOp(E, OP_USHR, 0)
        return 1
    }
    return 0
}
