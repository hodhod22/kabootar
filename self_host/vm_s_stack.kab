import "self_host/emit_defs"
import "kab/gc"
import "kab/gc/gc_alloc"
import "kab/gc/gc_pace"
import "kab/gc/gc_host"

// --- vm_s_caps ---
// P6b: snap local caps from session S.
pub fn vSnapCapsS(S) {
    let caps = {}
    let i = 0
    let names = S["localNames"]
    let locals = S["locals"]
    while i < len(names) {
        if i < len(locals) {
            caps[names[i]] = locals[i]
        }
        i = i + 1
    }
    return caps
}

// --- vm_s_find_method ---
// P6b: find method on class def (pure).
pub fn vFindMethod(classDef, name) {
    let methods = vObjGet(classDef, "methods")
    if typeof(methods) != "array" {
        return null
    }
    let i = 0
    while i < len(methods) {
        if vObjGet(methods[i], "sym") == name {
            return methods[i]
        }
        i = i + 1
    }
    return null
}

pub fn vFindClassByName(S, name) {
    let classes = S["classes"]
    let i = 0
    while i < len(classes) {
        if classes[i]["sym"] == name {
            return classes[i]
        }
        i = i + 1
    }
    return null
}

// --- vm_s_host ---
// P6b: host call / map get (pure).
pub fn vCallHost(callee, ordered) {
    return bytecode_host_call(callee, ordered)
}

pub fn vObjGet(obj, key) {
    return bytecode_host_map_get(obj, key)
}

// --- vm_s_index_get ---
pub fn vIndexGet(container, idx) {
    if container == null || container == undefined {
        return undefined
    }
    return container[idx]
}

// --- vm_s_index_set ---
pub fn vIndexSet(container, idx, val) {
    if container == null || container == undefined {
        throw "vm cannot index nullish"
    }
    container[idx] = val
    return container
}

// --- vm_s_ip ---
// P6b: ip helpers on session S.
pub fn vBumpIpS(S) {
    S["ip"] = S["ip"] + 1
}

/// Add delta to S.ip (avoid `S["ip"] = S["ip"] + 1 + arg` — self-host emit rejects that).
pub fn vAddIpS(S, delta) {
    let n = S["ip"] + delta
    S["ip"] = n
}

// --- vm_s_member_set ---
pub fn vMemberSet(obj, key, val) {
    if obj == null || obj == undefined {
        throw "vm cannot set member on nullish"
    }
    obj[key] = val
    return obj
}

// --- vm_s_pool_val ---
// P6b: poolVal helper.

pub fn poolVal(pool, idx) {
    if idx < 0 || idx >= len(pool) {
        throw "vm bad const index"
    }
    let v = pool[idx]
    if v == KAB_UNDEF_CONST {
        return undefined
    }
    return v
}

// --- vm_s_pop ---
// P6b: pop from session stack.
pub fn vPopS(S) {
    if len(S["stack"]) == 0 {
        throw "vm stack underflow"
    }
    return object_array_pop(S, "stack")
}

pub fn vPeekS(S) {
    let st = S["stack"]
    if len(st) == 0 {
        throw "vm stack underflow"
    }
    return st[len(st) - 1]
}

// --- vm_s_push ---
// P6b: push onto session stack.
pub fn vPushS(S, v) {
    object_array_push(S, "stack", v)
}

// --- vm_s_resolve_host ---
pub fn vResolveGlobalCached(S, globals, idx, name) {
    if name == "instanceof" {
        let marker = { "vmInstof": 1 }
        S["globals"][idx] = marker
        return marker
    }
    let cur = S["globals"][idx]
    if cur != undefined {
        return cur
    }
    if name == null || name == undefined {
        return undefined
    }
    let host = bytecode_host_get("" + name)
    if host != undefined {
        S["globals"][idx] = host
    }
    return host
}

// --- vm_s_rev_arr ---
pub fn vReverseArr(raw, n) {
    let arr = []
    let oi = n - 1
    while oi >= 0 {
        arr = push(arr, raw[oi])
        oi = oi - 1
    }
    return arr
}

// --- vm_s_this_get ---
pub fn vThisS(S) {
    if len(S["thisStack"]) == 0 {
        return undefined
    }
    return S["thisStack"][len(S["thisStack"]) - 1]
}

// SH6: same contract as host resolve_super_member — parent method bound to this, else field.
pub fn vSuperMemberGetS(S, key) {
    let obj = vThisS(S)
    if obj == null || obj == undefined {
        throw "`super` used outside of method"
    }
    if typeof(obj) != "object" {
        throw "`super` requires class instance `this`"
    }
    let ci = obj["vmC"]
    if ci == undefined {
        throw "`super` requires class instance `this`"
    }
    let classDef = S["classes"][ci]
    let parentName = classDef["extends"]
    if parentName == null || parentName == undefined {
        throw "Class " + classDef["sym"] + " has no superclass"
    }
    let parent = vFindClassByName(S, parentName)
    if parent == null {
        throw "Unknown base class: " + parentName
    }
    let meth = vFindMethod(parent, key)
    if meth != null {
        return { "vmM": meth, "vmR": obj }
    }
    if object_has_own(obj, key) {
        return obj[key]
    }
    throw "Super has no member " + key
}

// SH6: `is(obj, "Class")` / `instanceof` on Kab-VM instances (`vmC`), same
// inheritance walk as host `instance_of_class` (sym + extends). Not ClassInstance.
pub fn vInstanceofS(S, ordered) {
    if len(ordered) < 2 {
        throw "is() expects 2 arguments"
    }
    let obj = ordered[0]
    let className = ordered[1]
    if typeof(obj) != "object" || obj == null {
        return false
    }
    let ci = obj["vmC"]
    if typeof(ci) != "number" {
        return false
    }
    let classes = S["classes"]
    if ci < 0 || ci >= len(classes) {
        return false
    }
    let current = classes[ci]
    while current != null {
        if current["sym"] == className {
            return true
        }
        let parentName = current["extends"]
        if parentName == null || parentName == undefined {
            return false
        }
        current = vFindClassByName(S, parentName)
        if current == null {
            return false
        }
    }
    return false
}

// --- vm_s_this_is_obj ---
pub fn vIsCurrentThisObj(obj, cur) {
    if typeof(obj) != "object" || typeof(cur) != "object" {
        return false
    }
    if obj["vmI"] == undefined || cur["vmI"] == undefined {
        return false
    }
    return obj["vmI"] == cur["vmI"]
}

// --- vm_s_this_write ---
pub fn vWriteThisS(S, updated) {
    if len(S["thisStack"]) == 0 {
        return
    }
    S["thisStack"] = pop(S["thisStack"])
    S["thisStack"] = push(S["thisStack"], updated)
}

/// After a method returns, replace caller bindings that share `vmI` with `lastThis`.
pub fn vSameVmI(a, b) {
    if a == undefined || b == undefined {
        return false
    }
    return ("" + a) == ("" + b)
}

pub fn vInstId(obj) {
    if obj == null || obj == undefined {
        return undefined
    }
    if typeof(obj) != "object" {
        return undefined
    }
    let id = vObjGet(obj, "vmI")
    if id == undefined {
        id = vObjGet(obj, "__kab_oid")
    }
    return id
}

/// Merge src's fields into dst in place, firing the write barrier on each
/// inst-valued write — a heaped dst gaining a young pointer must reach the
/// remembered set or a minor collect can miss it.
pub fn vMergeInstInPlace(S, dst, src) {
    if typeof(dst) != "object" || dst == null {
        return
    }
    if typeof(src) != "object" || src == null {
        return
    }
    let keys = object_keys(src)
    let i = 0
    while i < len(keys) {
        let k = keys[i]
        dst[k] = src[k]
        vGcLogWriteS(S, dst, src[k])
        i = i + 1
    }
    return
}

pub fn vHeapGet(S, id) {
    if id == undefined {
        return undefined
    }
    let heap = S["insts"]
    if typeof(heap) != "array" {
        return undefined
    }
    if id < 0 || id >= len(heap) {
        return undefined
    }
    return heap[id]
}

pub fn vHeapPut(S, obj) {
    let id = vInstId(obj)
    if id == undefined {
        return
    }
    let heap = S["insts"]
    if typeof(heap) != "array" {
        heap = []
    }
    while len(heap) <= id {
        heap = push(heap, undefined)
    }
    heap[id] = obj
    S["insts"] = heap
    return
}

/// Publish obj to the inst heap, charging the nursery only when the id slot
/// is fresh (re-puts of an already-heaped inst are updates, not allocs).
/// During an in-progress collect the fresh inst is allocated black so the
/// in-flight cycle never sweeps a just-published object.
pub fn vHeapPutFreshS(S, obj) {
    let id = vInstId(obj)
    if id != undefined && vHeapGet(S, id) == undefined {
        vNurseryCharge(S, gcInstShellBytes())
        vGcAllocBlackS(S, obj)
    }
    vHeapPut(S, obj)
}

/// Alloc-black: a fresh publish during an in-flight mark is shaded so the
/// cycle never sweeps a just-allocated inst. A minor collect shades young
/// ids only — a publish that reused an old-space slot is already outside
/// the minor's partition. Shared by every publish path (canonical/publish/
/// writeback puts, inst shells, generator publish).
pub fn vGcAllocBlackS(S, obj) {
    if S["gcMarkActive"] == true {
        S["gcMarkSt"] = vGcMarkValS(S["gcMarkSt"], obj)
    }
    return
}

pub fn vCanonicalInstS(S, v) {
    let id = vInstId(v)
    let h = vHeapGet(S, id)
    if h != undefined {
        return h
    }
    if id != undefined {
        vHeapPutFreshS(S, v)
    }
    return v
}

pub fn vPublishInstS(S, updated) {
    if updated == null || updated == undefined {
        return updated
    }
    if vInstId(updated) == undefined {
        if len(S["thisStack"]) > 0 {
            let cur = S["thisStack"][len(S["thisStack"]) - 1]
            let cid = vInstId(cur)
            if cid != undefined {
                updated["vmI"] = cid
                if cur["vmC"] != undefined {
                    updated["vmC"] = cur["vmC"]
                }
            }
        }
    }
    vHeapPutFreshS(S, updated)
    if len(S["thisStack"]) > 0 {
        let cur2 = S["thisStack"][len(S["thisStack"]) - 1]
        if vSameVmI(vInstId(cur2), vInstId(updated)) {
            vWriteThisS(S, updated)
        }
    }
    return updated
}

pub fn vWritebackAfterMethodS(S, recv, updated) {
    let id = vInstId(recv)
    if id == undefined {
        id = vInstId(updated)
    }
    let fresh = vHeapGet(S, id)
    if fresh != undefined {
        updated = fresh
    }
    if updated == null || updated == undefined {
        return
    }
    if typeof(updated) != "object" {
        return
    }
    if id == undefined {
        vMergeInstInPlace(S, recv, updated)
        return
    }
    updated["vmI"] = id
    vHeapPutFreshS(S, updated)
    vMergeInstInPlace(S, recv, updated)
    S["locals"] = vReplaceByVmI(S["locals"], updated, id)
    S["globals"] = vReplaceByVmI(S["globals"], updated, id)
    return
}

pub fn vWritebackInstanceS(S, updated) {
    vWritebackAfterMethodS(S, null, updated)
}

// --- vm_s_gc_charge ---
/// Major-collect cadence: the first collect is always major (it
/// establishes the gcOldId generation watermark); after that a major runs
/// every vGcMajorEvery-th collect OR when the last minor's survival rate
/// hit vGcMajorSurvPct — survivors promote into old space and pressure it.
pub fn vGcMajorEvery() {
    return 4
}

pub fn vGcMajorSurvPct() {
    return 50
}

pub fn vGcMajorOk(S, c) {
    if c <= 1 || c % vGcMajorEvery() == 1 {
        return true
    }
    return S["gcMajorDue"] == true
}

/// Charge nursery bump for one heap publish. A full nursery begins an
/// incremental collect — minor (nursery-only) or major (full) per
/// vGcMajorOk; marking then proceeds in slices under the frame budget on
/// every charge until the worklist drains, which arms the lazy sweep —
/// dead slots tombstone in vGcSweepSliceS slices on later charges and the
/// cycle settles gcUsed/gcCap to the live-bytes watermark when the sweep
/// cursor reaches the heap end (host heap still skuld).
pub fn vNurseryCharge(S, n) {
    let cap = S["gcCap"]
    if cap == null {
        cap = gcNurseryCap()
        S["gcCap"] = cap
    }
    let used = S["gcUsed"]
    if used == null {
        used = 0
    }
    let next = gcAllocOrCollect(used, n, cap)
    if next < used && S["gcMarkActive"] != true && S["gcSweepActive"] != true {
        let c = S["gcCollects"]
        if c == null {
            c = 0
        }
        c = c + 1
        S["gcCollects"] = c
        vGcCollectBeginS(S, vGcMajorOk(S, c) == false)
    }
    if S["gcMarkActive"] == true {
        vGcMarkSliceS(S, vGcMarkSliceN())
        if S["gcMarkActive"] == true {
            S["gcUsed"] = next
            return
        }
        return
    }
    if S["gcSweepActive"] == true {
        vGcSweepSliceS(S, vGcSweepSliceN())
        if S["gcSweepActive"] == true {
            S["gcUsed"] = next
            return
        }
        return
    }
    S["gcUsed"] = next
}

// --- vm_s_gc_audit ---
/// Add one value's inst id to the root set (dedup via seen map).
/// `st` = { "roots": [...ids], "seen": {"id" -> true} }; the string-keyed
/// seen map keeps membership O(1) instead of a linear scan over roots.
/// (ids can be large host __kab_oid values — never index arrays by id.)
pub fn vGcMarkValS(st, v) {
    let id = vInstId(v)
    if id == undefined {
        return st
    }
    if st["minor"] == true {
        let young = st["young"]
        if typeof(young) == "number" && id < young {
            return st
        }
    }
    let k = " " + id
    let seen = st["seen"]
    if seen[k] != undefined {
        return st
    }
    seen[k] = true
    st["seen"] = seen
    st["roots"] = push(st["roots"], id)
    return st
}

/// Deduped inst ids (vmI/__kab_oid) found in one value array.
pub fn vGcScanArrS(st, arr) {
    if typeof(arr) != "array" {
        return st
    }
    let i = 0
    while i < len(arr) {
        st = vGcMarkValS(st, arr[i])
        i = i + 1
    }
    return st
}

/// Scan a single session root — array, inst, or any other value.
pub fn vGcScanValS(st, v) {
    if typeof(v) == "array" {
        return vGcScanArrS(st, v)
    }
    return vGcMarkValS(st, v)
}

/// Incremental mark slice budget — inst fields scanned per charge keeps the
/// pause inside the 16 ms frame budget (gcFrameBudgetMs).
pub fn vGcMarkSliceN() {
    return 64
}

/// Begin a collect: snapshot the root set (stack/locals/globals/thisStack
/// plus lastThis/result/classes/_args) into S["gcMarkSt"] and mark it
/// active. The transitive BFS then continues in slices via vGcMarkSliceS.
/// `minor` runs a nursery-only collect: only ids >= gcOldId (the young
/// generation watermark) can shade, and the worklist is seeded by young
/// roots plus the young children of dirty old holders — the persistent
/// remembered set (gcRemIds) plus this cycle's write log. Old-space
/// liveness is not decided here.
pub fn vGcCollectBeginS(S, minor) {
    let st = { "roots": [], "seen": {}, "wi": 0, "fieldsN": 0 }
    if minor == true {
        st["minor"] = true
        let y = S["gcOldId"]
        if typeof(y) != "number" {
            y = 1
        }
        st["young"] = y
    }
    st = vGcScanArrS(st, S["stack"])
    st = vGcScanArrS(st, S["locals"])
    st = vGcScanArrS(st, S["globals"])
    st = vGcScanArrS(st, S["thisStack"])
    st = vGcScanValS(st, S["lastThis"])
    st = vGcScanValS(st, S["result"])
    st = vGcScanValS(st, S["classes"])
    st = vGcScanValS(st, S["_args"])
    st = vGcScanValS(st, S["curGen"])
    // genClose holds closing return values inside {c,v} wrappers — scan
    // each recorded "v" so a generator's close value keeps its insts
    // alive while it is suspended.
    let gc2 = S["genClose"]
    if typeof(gc2) == "object" && gc2 != null {
        let gk = object_keys(gc2)
        let gi = 0
        while gi < len(gk) {
            let ent = gc2[gk[gi]]
            if typeof(ent) == "object" && ent != null {
                st = vGcScanValS(st, ent["v"])
            }
            gi = gi + 1
        }
    }
    if minor == true {
        let heap = S["insts"]
        if typeof(heap) == "array" {
            let rem = S["gcRemIds"]
            if typeof(rem) == "array" {
                let ri = 0
                while ri < len(rem) {
                    st = vGcScanFieldsS(st, heap, rem[ri])
                    ri = ri + 1
                }
            }
            let wl = S["gcWriteLog"]
            if typeof(wl) == "array" {
                let wi = 0
                while wi < len(wl) {
                    st = vGcScanFieldsS(st, heap, wl[wi])
                    wi = wi + 1
                }
            }
        }
    }
    S["gcRootsN"] = len(st["roots"])
    S["gcCollectT0"] = date_now_ms()
    S["gcMarkSt"] = st
    S["gcMarkActive"] = true
    S["gcMinor"] = minor == true
    return
}

/// Scan the fields of one marked inst (worklist step).
pub fn vGcScanFieldsS(st, heap, rid) {
    if typeof(rid) != "number" || rid < 0 || rid >= len(heap) {
        return st
    }
    let obj = heap[rid]
    if typeof(obj) != "object" || obj == null {
        return st
    }
    let keys = object_keys(obj)
    st["fieldsN"] = st["fieldsN"] + len(keys)
    let ki = 0
    while ki < len(keys) {
        let k = keys[ki]
        if len(k) < 5 || str_slice(k, 0, 5) != "weak_" {
            st = vGcScanValS(st, obj[k])
        }
        ki = ki + 1
    }
    return st
}

/// Continue the in-progress collect: scan fields of at most `budget` marked
/// insts. When the worklist drains, dirty holders from the write log are
/// rescanned (remembered-set semantics: a child stored into a scanned inst
/// mid-cycle still gets marked). When both drain, finish the cycle.
pub fn vGcMarkSliceS(S, budget) {
    if S["gcMarkActive"] != true {
        return
    }
    let st = S["gcMarkSt"]
    let heap = S["insts"]
    let n = 0
    if typeof(heap) == "array" {
        while n < budget {
            if st["wi"] < len(st["roots"]) {
                st = vGcScanFieldsS(st, heap, st["roots"][st["wi"]])
                st["wi"] = st["wi"] + 1
            } else {
                let wl = S["gcWriteLog"]
                if typeof(wl) != "array" || len(wl) == 0 {
                    break
                }
                let hid = wl[len(wl) - 1]
                S["gcWriteLog"] = pop(wl)
                let ws = S["gcWriteSeen"]
                if typeof(ws) == "object" && ws != null {
                    ws[" " + hid] = undefined
                    S["gcWriteSeen"] = ws
                }
                st = vGcScanFieldsS(st, heap, hid)
            }
            n = n + 1
        }
    }
    let wl2 = S["gcWriteLog"]
    let pending = typeof(wl2) == "array" && len(wl2) > 0
    if typeof(heap) != "array" || (st["wi"] >= len(st["roots"]) && pending == false) {
        vGcFinishMarkS(S, st)
        S["gcMarkActive"] = false
        return
    }
    S["gcMarkSt"] = st
    return
}

/// Finish a collect's mark phase: record the marked count and write-log
/// stats, then arm the lazy sweep — the heap walk itself runs in
/// vGcSweepSliceS slices on later charges so the pause stays inside the
/// frame budget. gcSweepMinNew is the id watermark: the freelist stays
/// locked while sweeping, so every post-mark publish gets an id above it.
pub fn vGcFinishMarkS(S, st) {
    let heap = S["insts"]
    S["gcMarkedN"] = len(st["roots"])
    if typeof(heap) != "array" {
        S["gcLiveN"] = 0
        S["gcDeadN"] = 0
        S["gcDeadBytes"] = 0
        return
    }
    let wc = S["gcWriteCycleN"]
    if typeof(wc) == "number" {
        S["gcWriteN"] = wc
    } else {
        S["gcWriteN"] = 0
    }
    S["gcWriteCycleN"] = 0
    S["gcWriteLog"] = []
    S["gcWriteSeen"] = {}
    S["gcMarkFieldsN"] = st["fieldsN"]
    let mn = S["nextInstId"]
    if typeof(mn) != "number" {
        mn = 2147483647
    }
    S["gcSweepMinNew"] = mn
    S["gcSweepAt"] = 0
    S["gcSweepSeen"] = st["seen"]
    S["gcSweepLiveN"] = 0
    S["gcSweepDeadN"] = 0
    S["gcSweepFreshN"] = 0
    S["gcSweepActive"] = true
    return
}

// --- vm_s_gc_sweep ---
/// Lazy-sweep slice budget — heap slots visited per charge keeps the pause
/// inside the 16 ms frame budget (gcFrameBudgetMs).
pub fn vGcSweepSliceN() {
    return 64
}

/// Clear weak_ fields on `obj` whose target id is dead — not marked this
/// cycle and below the post-mark watermark (a fresh publish is not weak-
/// cleared). Shared by lazy-sweep slices; mutates the shared object in
/// place like the eager sweep did.
pub fn vGcWeakClearObjS(obj, seen, minNew) {
    if typeof(obj) != "object" || obj == null {
        return obj
    }
    let keys = object_keys(obj)
    let ki = 0
    while ki < len(keys) {
        let k = keys[ki]
        if len(k) >= 5 && str_slice(k, 0, 5) == "weak_" {
            let wid = vInstId(obj[k])
            if wid != undefined && wid < minNew && seen[" " + wid] != true {
                obj[k] = undefined
            }
        }
        ki = ki + 1
    }
    return obj
}

/// Continue the armed lazy sweep: visit at most `budget` heap slots from
/// S["gcSweepAt"]. A slot is live when its id was marked this cycle, fresh
/// when its id is >= gcSweepMinNew (published after the mark finished —
/// counted for bytes but outside the mark-era readiness check); anything
/// else is tombstoned and its id goes to the free list, reusable below the
/// cursor. Live and fresh insts get their weak_ fields cleared against the
/// final mark set. When the cursor reaches the heap end the cycle settles
/// gcUsed/gcCap/gcHostReady/gcCollectMs.
pub fn vGcSweepSliceS(S, budget) {
    if S["gcSweepActive"] != true {
        return
    }
    let heap = S["insts"]
    if typeof(heap) != "array" {
        S["gcSweepActive"] = false
        return
    }
    let seen = S["gcSweepSeen"]
    if typeof(seen) != "object" || seen == null {
        seen = {}
    }
    let mn = S["gcSweepMinNew"]
    if typeof(mn) != "number" {
        mn = 2147483647
    }
    let at = S["gcSweepAt"]
    if typeof(at) != "number" {
        at = 0
    }
    let live = S["gcSweepLiveN"]
    if typeof(live) != "number" {
        live = 0
    }
    let dead = S["gcSweepDeadN"]
    if typeof(dead) != "number" {
        dead = 0
    }
    let fresh = S["gcSweepFreshN"]
    if typeof(fresh) != "number" {
        fresh = 0
    }
    let freeIds = S["gcFreeIds"]
    if typeof(freeIds) != "array" {
        freeIds = []
    }
    let minor = S["gcMinor"] == true
    let oldId = S["gcOldId"]
    if typeof(oldId) != "number" {
        oldId = 1
    }
    let n = 0
    while at < len(heap) && n < budget {
        let id = vInstId(heap[at])
        if id != undefined {
            if id >= mn {
                fresh = fresh + 1
                vGcWeakClearObjS(heap[at], seen, mn)
            } else if minor && id < oldId {
                // old-space slot — a minor collect leaves it alone
            } else if seen[" " + id] == true {
                live = live + 1
                vGcWeakClearObjS(heap[at], seen, mn)
            } else {
                heap[at] = undefined
                freeIds = push(freeIds, id)
                dead = dead + 1
            }
        }
        at = at + 1
        n = n + 1
    }
    S["insts"] = heap
    S["gcFreeIds"] = freeIds
    S["gcSweepAt"] = at
    S["gcSweepLiveN"] = live
    S["gcSweepDeadN"] = dead
    S["gcSweepFreshN"] = fresh
    if at < len(heap) {
        return
    }
    // Cursor reached the heap end: trim the tombstone tail, drop freed ids
    // that would just re-pad the heap, then settle the cycle counters.
    while len(heap) > 0 && heap[len(heap) - 1] == undefined {
        heap = pop(heap)
    }
    let pruned = []
    let fi = 0
    while fi < len(freeIds) {
        if freeIds[fi] < len(heap) {
            pruned = push(pruned, freeIds[fi])
        }
        fi = fi + 1
    }
    S["insts"] = heap
    S["gcFreeIds"] = pruned
    S["gcLiveN"] = live
    S["gcDeadN"] = dead
    S["gcDeadBytes"] = dead * gcInstShellBytes()
    S["gcReclaimedN"] = dead
    S["gcReclaimedBytes"] = dead * gcInstShellBytes()
    let liveBytes = (live + fresh) * gcInstShellBytes()
    if S["gcMinor"] == true {
        // Young-only accounting: old-space live bytes carry over from the
        // last major settle; the gcOldId watermark stays put.
        let ob = S["gcOldBytes"]
        if typeof(ob) == "number" {
            liveBytes = ob + liveBytes
        }
        // Survival pacing: a minor that keeps most of the nursery alive is
        // promoting pressure into old space — run a major next.
        let tot = live + dead
        S["gcMajorDue"] = tot > 0 && live * 100 >= tot * vGcMajorSurvPct()
    } else {
        // Major settle: every survivor is promoted — the generation
        // watermark moves to the bump frontier, and rem-set holders that
        // died this cycle drop out of the remembered set.
        let ni = S["nextInstId"]
        if typeof(ni) == "number" {
            S["gcOldId"] = ni
        }
        S["gcOldBytes"] = liveBytes
        let rem = S["gcRemIds"]
        if typeof(rem) == "array" && len(rem) > 0 {
            let keepR = []
            let seenR = {}
            let ri = 0
            while ri < len(rem) {
                let hid = rem[ri]
                if seen[" " + hid] == true {
                    keepR = push(keepR, hid)
                    seenR[" " + hid] = true
                }
                ri = ri + 1
            }
            S["gcRemIds"] = keepR
            S["gcRemSeen"] = seenR
        }
        S["gcMajorDue"] = false
    }
    S["gcUsed"] = liveBytes
    S["gcLiveBytes"] = liveBytes
    S["gcCap"] = gcPaceGrow(S["gcCap"], liveBytes, 80, S["gcCap"] * 8)
    S["gcHostReady"] = gcHostReadyOk(S["gcRootsN"], S["gcMarkedN"], live, dead, S["gcReclaimedN"])
    let t0 = S["gcCollectT0"]
    if typeof(t0) == "number" {
        let ms = date_now_ms() - t0
        S["gcCollectMs"] = ms
        S["gcOverBudget"] = ms > gcFrameBudgetMs()
    }
    S["gcSweepActive"] = false
    S["gcSweepSeen"] = {}
    S["gcSweepMinNew"] = 0
    S["gcMinor"] = false
    return
}

/// Stop-the-world sweep drain: run lazy slices until the armed sweep ends
/// (kept for the audit path; the charge path slices under the frame budget).
pub fn vGcSweepDeadS(S) {
    while S["gcSweepActive"] == true {
        vGcSweepSliceS(S, 1048576)
    }
    return
}

/// Idle-time GC: advance the in-flight collect by `budget` items while the
/// mutator is idle — mark slices first, then sweep slices. Returns true
/// while collect work remains (more idle drains still useful).
pub fn vGcIdleS(S, budget) {
    if S["gcMarkActive"] == true {
        vGcMarkSliceS(S, budget)
        return true
    }
    if S["gcSweepActive"] == true {
        vGcSweepSliceS(S, budget)
        return true
    }
    return false
}

/// Stop-the-world collect: begin a major cycle and drain all mark and
/// sweep slices in one call (used by the audit path and tests; the charge
/// path slices under the frame budget).
pub fn vGcRootsAuditS(S) {
    vGcCollectBeginS(S, false)
    while S["gcMarkActive"] == true {
        vGcMarkSliceS(S, 1048576)
    }
    vGcSweepDeadS(S)
    return
}

/// Take an inst id for a fresh publish: reuse a swept slot first so the
/// id-indexed heap stays dense, else bump nextInstId. While a lazy sweep is
/// armed the freelist stays locked — a reused low id would look mark-era
/// dead when the cursor reaches it, so fresh ids bump past gcSweepMinNew.
pub fn vGcTakeInstIdS(S) {
    let free = S["gcFreeIds"]
    if S["gcSweepActive"] != true && typeof(free) == "array" && len(free) > 0 {
        let id = free[len(free) - 1]
        S["gcFreeIds"] = pop(free)
        return id
    }
    let id = S["nextInstId"]
    if id == null || id == undefined {
        id = 1
    }
    S["nextInstId"] = id + 1
    return id
}

pub fn vReplaceByVmI(arr, updated, id) {
    if arr == null || arr == undefined {
        return arr
    }
    let out = []
    let i = 0
    let n = len(arr)
    while i < n {
        let v = arr[i]
        let keep = v
        if v != null {
            if v != undefined {
                let hit = vSameVmI(vInstId(v), id)
                if hit {
                    keep = updated
                }
            }
        }
        out = push(out, keep)
        i = i + 1
    }
    return out
}

// --- vm_s_truthy ---
// P6b: truthy helper (pure).
pub fn vTruthy(v) {
    if v == false || v == null || v == undefined {
        return false
    }
    if typeof(v) == "number" {
        if v == 0 {
            return false
        }
        if v != v {
            return false
        }
    }
    if typeof(v) == "string" {
        if v == "" {
            return false
        }
    }
    return true
}

// --- vm_s_try ---
// P6b: find try region (pure).
pub fn vFindTry(regions, ip) {
    if regions == null || regions == undefined {
        return null
    }
    let best = null
    let bi = 0
    while bi < len(regions) {
        let r = regions[bi]
        let hit = 0
        if ip == r["catchStart"] {
            hit = 1
        } else {
            if ip >= r["bodyStart"] {
                if ip < r["catchStart"] {
                    hit = 1
                }
            }
        }
        if hit == 1 {
            if best == null || r["bodyStart"] >= best["bodyStart"] {
                best = r
            }
        }
        bi = bi + 1
    }
    return best
}

// --- vm_s_member_class ---
pub fn vMemberGetClass(S, obj, key) {
    if object_has_own(obj, key) {
        return obj[key]
    }
    let ci = vObjGet(obj, "vmC")
    let classes = S["classes"]
    if typeof(ci) != "number" || typeof(classes) != "array" {
        return undefined
    }
    if ci < 0 || ci >= len(classes) {
        return undefined
    }
    let meth = vFindMethod(classes[ci], key)
    if meth != null {
        return { "vmM": meth, "vmR": vCanonicalInstS(S, obj) }
    }
    return undefined
}

// --- vm_s_pool_key ---
// P6b: poolKey helper.

pub fn poolKey(pool, idx) {
    let k = poolVal(pool, idx)
    if k == null || k == undefined {
        return ""
    }
    return "" + k
}

// --- vm_s_pop_n ---
pub fn vPopNRaw(S, n) {
    let raw = []
    let ai = 0
    while ai < n {
        raw = push(raw, vPopS(S))
        ai = ai + 1
    }
    return raw
}

// --- vm_s_stack ---
// P6b: stack/ip facade — re-exports via import side effects for dependents that only import this.

// --- vm_s_jump_result_ok ---
pub fn vJumpResultUnwrap(S, v) {
    if typeof(v) == "object" && v != null && v["vmResult"] == "ok" {
        vPushS(S, v["v"])
    } else {
        vPushS(S, v)
    }
    vBumpIpS(S)
}

// --- vm_s_resolve ---
pub fn vResolveGlobalS(S, globals, idx) {
    let name = globals[idx]
    if name == "this" || name == "self" {
        return vThisS(S)
    }
    return vResolveGlobalCached(S, globals, idx, name)
}

// --- vm_s_this_is ---
pub fn vIsCurrentThisS(S, obj) {
    if obj == null || obj == undefined {
        return false
    }
    if len(S["thisStack"]) == 0 {
        return false
    }
    let cur = S["thisStack"][len(S["thisStack"]) - 1]
    if cur == null || cur == undefined {
        return false
    }
    return vIsCurrentThisObj(obj, cur)
}

// --- vm_s_pad_locals ---
pub fn vPadLocalsTo(S, el) {
    while len(S["locals"]) <= el {
        S["locals"] = push(S["locals"], undefined)
    }
}

// --- vm_s_member_get ---
pub fn vMemberGetS(S, obj, key) {
    if obj == null || obj == undefined {
        return undefined
    }
    obj = vCanonicalInstS(S, obj)
    S["lastMemKey"] = "" + key
    S["lastMemObj"] = obj
    if vObjGet(obj, "vmEnumNs") == 1 {
        return vEnumNsGet(obj, key)
    }
    if vObjGet(obj, "vmC") != undefined {
        return vMemberGetClass(S, obj, key)
    }
    if typeof(obj) == "array" {
        return vIndexGet(obj, key)
    }
    let ks = "" + key
    if vObjGet(obj, "vmGen") == 1 {
        if ks == "throw" {
            return { "vmGenThrow": 1, "vmR": vCanonicalInstS(S, obj) }
        }
    }
    if vObjGet(obj, "vmGen") == true {
        if ks == "throw" {
            return { "vmGenThrow": 1, "vmR": vCanonicalInstS(S, obj) }
        }
    }
    return obj[key]
}

pub fn vEnumNsGet(obj, key) {
    let vs = obj["variants"]
    if vs == undefined {
        return undefined
    }
    let i = 0
    while i < len(vs) {
        if vs[i]["name"] == key {
            let fields = vs[i]["fields"]
            if fields == undefined || len(fields) == 0 {
                return { "vmEnum": 1, "typeName": obj["typeName"], "variant": key, "fields": [] }
            }
            return { "vmEnumCtor": 1, "typeName": obj["typeName"], "variant": key, "arity": len(fields) }
        }
        i = i + 1
    }
    return undefined
}

// --- vm_s_pool ---
// P6b: thin pool facade.

pub let poolVal = poolVal
pub let poolKey = poolKey

// --- vm_s_gc_barrier ---
/// Write barrier: when an inst field/element starts pointing at an inst,
/// remember the holder's id in S["gcWriteLog"] (deduped via gcWriteSeen).
/// Two records: the per-cycle write log (incremental-mark rescan, drained
/// by mark slices) and the persistent remembered set gcRemIds/gcRemSeen —
/// old-space holders that gained a young pointer are rescanned at the next
/// minor collect; dead holders are pruned at each major settle.
pub fn vGcLogWriteS(S, holder, val) {
    let vid = vInstId(val)
    if vid == undefined {
        return
    }
    let id = vInstId(holder)
    if id == undefined {
        return
    }
    // Remembered set: old holder -> young target survives minors only via
    // this record (young holders are covered by normal reachability).
    let oldId = S["gcOldId"]
    if typeof(oldId) == "number" && id < oldId && vid >= oldId {
        let rseen = S["gcRemSeen"]
        if typeof(rseen) != "object" || rseen == null {
            rseen = {}
        }
        if rseen[" " + id] != true {
            rseen[" " + id] = true
            S["gcRemSeen"] = rseen
            let rem = S["gcRemIds"]
            if typeof(rem) != "array" {
                rem = []
            }
            S["gcRemIds"] = push(rem, id)
        }
    }
    if S["gcMarkActive"] != true {
        return
    }
    let seen = S["gcWriteSeen"]
    if typeof(seen) != "object" || seen == null {
        seen = {}
    }
    let k = " " + id
    if seen[k] != undefined {
        S["gcWriteSeen"] = seen
        return
    }
    seen[k] = true
    S["gcWriteSeen"] = seen
    let log = S["gcWriteLog"]
    if typeof(log) != "array" {
        log = []
    }
    S["gcWriteLog"] = push(log, id)
    let wc = S["gcWriteCycleN"]
    if typeof(wc) != "number" {
        wc = 0
    }
    S["gcWriteCycleN"] = wc + 1
    return
}

// --- vm_s_member_set_push ---
pub fn vMemberSetPush(S, obj, key, val) {
    obj = vCanonicalInstS(S, obj)
    let updated = vPublishInstS(S, vMemberSet(obj, key, val))
    vGcLogWriteS(S, updated, val)
    if vIsCurrentThisS(S, obj) {
        vWriteThisS(S, updated)
    }
    vPushS(S, updated)
    vPushS(S, val)
    vBumpIpS(S)
}

// --- vm_s_index_set_push ---
pub fn vIndexSetPush(S, container, idx, val) {
    let updated = vPublishInstS(S, vIndexSet(container, idx, val))
    vGcLogWriteS(S, updated, val)
    if vIsCurrentThisS(S, container) {
        vWriteThisS(S, updated)
    }
    vPushS(S, updated)
    vPushS(S, val)
    vBumpIpS(S)
}

// --- vm_s_catch ---
pub fn vCatchThrow(S, reason) {
    let region = vFindTry(S["tryRegions"], S["ip"])
    if region == null {
        if S["ip"] >= 1 {
            region = vFindTry(S["tryRegions"], S["ip"] - 1)
        }
    }
    if region == null {
        if S["ip"] >= 2 {
            region = vFindTry(S["tryRegions"], S["ip"] - 2)
        }
    }
    if region == null {
        return 0
    }
    let el = region["errLocal"]
    vPadLocalsTo(S, el)
    S["locals"][el] = reason
    vPushS(S, reason)
    S["ip"] = region["catchStart"]
    return 1
}
