// Part of deserialize line handlers.
import "self_host/deserialize_ops"

pub fn deserEnsureFnArrow(st, fi, ai, name) {
    let functions = st["functions"]
    while len(functions) <= fi {
        functions = push(functions, { "sym": "", "params": [], "locals": [], "ops": [], "tryRegions": [], "arrows": [] })
    }
    if functions[fi]["arrows"] == undefined {
        functions[fi]["arrows"] = []
    }
    let arrows = functions[fi]["arrows"]
    while len(arrows) <= ai {
        arrows = push(arrows, { "sym": "", "params": [], "locals": [], "ops": [] })
    }
    if name != "" {
        arrows[ai]["sym"] = unescapeKbc(name)
    }
    functions[fi]["arrows"] = arrows
    st["functions"] = functions
}

pub fn deserFn(st, line) {
    if starts_with(line, "functions=") {
        return "ok"
    }
    if starts_with(line, "fn_try_region ") {
        let rest = trim(str_slice(line, 14, len(line)))
        let parts = split(rest, " ")
        let fi = parse_int(parts[0])
        let functions = st["functions"]
        while len(functions) <= fi {
            functions = push(functions, { "sym": "", "params": [], "locals": [], "ops": [], "tryRegions": [] })
        }
        if functions[fi]["tryRegions"] == undefined {
            functions[fi]["tryRegions"] = []
        }
        functions[fi]["tryRegions"] = push(functions[fi]["tryRegions"], {
            "bodyStart": parse_int(parts[2]),
            "bodyEnd": parse_int(parts[3]),
            "catchStart": parse_int(parts[4]),
            "errLocal": parse_int(parts[5])
        })
        st["functions"] = functions
        return "ok"
    }
    if starts_with(line, "fn ") {
        let rest = str_slice(line, 3, len(line))
        let sp = str_index_of(rest, " ")
        let sym = unescapeKbc(trim(str_slice(rest, sp + 1, len(rest))))
        st["functions"] = push(st["functions"], { "sym": sym, "params": [], "locals": [], "ops": [], "tryRegions": [] })
        return "ok"
    }
    if starts_with(line, "fn_params ") {
        let rest = str_slice(line, 10, len(line))
        let sp = str_index_of(rest, " ")
        let idx = parse_int(trim(str_slice(rest, 0, sp)))
        let list = trim(str_slice(rest, sp + 1, len(rest)))
        st["functions"][idx]["params"] = commaList(list)
        return "ok"
    }
    if starts_with(line, "fn_locals ") {
        let rest = str_slice(line, 10, len(line))
        let sp = str_index_of(rest, " ")
        let idx = parse_int(trim(str_slice(rest, 0, sp)))
        let list = trim(str_slice(rest, sp + 1, len(rest)))
        st["functions"][idx]["locals"] = commaList(list)
        return "ok"
    }
    if starts_with(line, "fn_async ") {
        let rest = trim(str_slice(line, 9, len(line)))
        let fi = parse_int(rest)
        let functions = st["functions"]
        while len(functions) <= fi {
            functions = push(functions, { "sym": "", "params": [], "locals": [], "ops": [], "tryRegions": [] })
        }
        functions[fi]["isAsync"] = 1
        st["functions"] = functions
        return "ok"
    }
    if starts_with(line, "fn_generator ") {
        let rest = trim(str_slice(line, 13, len(line)))
        let fi = parse_int(rest)
        let functions = st["functions"]
        while len(functions) <= fi {
            functions = push(functions, { "sym": "", "params": [], "locals": [], "ops": [], "tryRegions": [] })
        }
        functions[fi]["isGen"] = 1
        st["functions"] = functions
        return "ok"
    }
    if starts_with(line, "fn_arrow_op ") {
        let rest = trim(str_slice(line, 12, len(line)))
        let sp1 = str_index_of(rest, " ")
        let fi = parse_int(trim(str_slice(rest, 0, sp1)))
        let rest2 = trim(str_slice(rest, sp1 + 1, len(rest)))
        let sp2 = str_index_of(rest2, " ")
        let ai = parse_int(trim(str_slice(rest2, 0, sp2)))
        let opLine = trim(str_slice(rest2, sp2 + 1, len(rest2)))
        deserEnsureFnArrow(st, fi, ai, "")
        st["functions"][fi]["arrows"][ai]["ops"] = push(st["functions"][fi]["arrows"][ai]["ops"], parseOpLine(opLine))
        return "ok"
    }
    if starts_with(line, "fn_arrow_params ") {
        let rest = trim(str_slice(line, 16, len(line)))
        let sp1 = str_index_of(rest, " ")
        let fi = parse_int(trim(str_slice(rest, 0, sp1)))
        let rest2 = trim(str_slice(rest, sp1 + 1, len(rest)))
        let sp2 = str_index_of(rest2, " ")
        let ai = parse_int(trim(str_slice(rest2, 0, sp2)))
        let list = trim(str_slice(rest2, sp2 + 1, len(rest2)))
        deserEnsureFnArrow(st, fi, ai, "")
        st["functions"][fi]["arrows"][ai]["params"] = commaList(list)
        return "ok"
    }
    if starts_with(line, "fn_arrow_locals ") {
        let rest = trim(str_slice(line, 16, len(line)))
        let sp1 = str_index_of(rest, " ")
        let fi = parse_int(trim(str_slice(rest, 0, sp1)))
        let rest2 = trim(str_slice(rest, sp1 + 1, len(rest)))
        let sp2 = str_index_of(rest2, " ")
        let ai = parse_int(trim(str_slice(rest2, 0, sp2)))
        let list = trim(str_slice(rest2, sp2 + 1, len(rest2)))
        deserEnsureFnArrow(st, fi, ai, "")
        st["functions"][fi]["arrows"][ai]["locals"] = commaList(list)
        return "ok"
    }
    if starts_with(line, "fn_arrow_async ") {
        let rest = trim(str_slice(line, 15, len(line)))
        let sp1 = str_index_of(rest, " ")
        let fi = parse_int(trim(str_slice(rest, 0, sp1)))
        let ai = parse_int(trim(str_slice(rest, sp1 + 1, len(rest))))
        deserEnsureFnArrow(st, fi, ai, "")
        st["functions"][fi]["arrows"][ai]["isAsync"] = 1
        return "ok"
    }
    if starts_with(line, "fn_arrows ") {
        return "ok"
    }
    if starts_with(line, "fn_arrow ") {
        let rest = trim(str_slice(line, 9, len(line)))
        let sp1 = str_index_of(rest, " ")
        let fi = parse_int(trim(str_slice(rest, 0, sp1)))
        let rest2 = trim(str_slice(rest, sp1 + 1, len(rest)))
        let sp2 = str_index_of(rest2, " ")
        let ai = parse_int(trim(str_slice(rest2, 0, sp2)))
        let name = trim(str_slice(rest2, sp2 + 1, len(rest2)))
        deserEnsureFnArrow(st, fi, ai, name)
        return "ok"
    }
    if starts_with(line, "fn_op ") {
        let rest = str_slice(line, 6, len(line))
        let sp = str_index_of(rest, " ")
        let idx = parse_int(trim(str_slice(rest, 0, sp)))
        let opLine = trim(str_slice(rest, sp + 1, len(rest)))
        let op = parseOpLine(opLine)
        st["functions"][idx]["ops"] = push(st["functions"][idx]["ops"], op)
        return "ok"
    }
    return "skip"
}

