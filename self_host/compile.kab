// Full self-hosted pipeline: source text -> kabootar-bytecode/1 text.
// SH5 deepen: ownership + emit_exec merged here (compile-DAG 12 -> 9).
import "self_host/ast_defs"
import "self_host/lexer_scan"
import "self_host/parser_exec"
import "self_host/emit_expr_body"
import "self_host/emit_stmt_body"

// SH3a: len(expr) → get_length (bust compiler-image fingerprint when emit_expr_body changes).

let gMsParse = 0
let gMsEmit = 0
let gMsSer = 0
let gMsTotal = 0

/// FT F0: last `compile()` phase times (ms). kind 1=parse 2=emit 3=serialize else total.
pub fn lastCompileMs(kind) {
    if kind == 1 {
        return gMsParse
    }
    if kind == 2 {
        return gMsEmit
    }
    if kind == 3 {
        return gMsSer
    }
    return gMsTotal
}

/// True when the file head opts into affine ownership (@manual).
fn sourceIsManual(source) {
    let s = "" + source
    let n = len(s)
    if n > 512 {
        s = str_slice(s, 0, 512)
    }
    if str_includes(s, "@manual") {
        return true
    }
    return false
}

/// H6e: product preprocess in Kab — Comptime 3.0 folds `comptime { … }` to literals before parse.
fn preprocess(source) {
    let s = "" + source
    s = replace_all(s, "@pure\n", "")
    s = replace_all(s, "@io\n", "")
    s = replace_all(s, "@gc\n", "")
    s = replace_all(s, "@manual\n", "")
    s = comptime_fold(s)
    return s
}

fn sourceTooBig(source) {
    return len("" + source) > 65536
}

fn sourceEmpty(source) {
    return len("" + source) == 0
}

fn sourceLooksLikeKbc(source) {
    return str_index_of("" + source, "kabootar-bytecode/1") == 0
}

fn parseSource(source) {
    return parseTokensExec(tokenizeExec(source))
}

fn guardAndPreprocess(source) {
    if sourceEmpty(source) {
        throw "SH16: empty source"
    }
    if sourceLooksLikeKbc(source) {
        throw "SH16: refusing to compile bytecode as source"
    }
    if sourceTooBig(source) {
        throw "SH16: source exceeds bootPolicy maxBytes; split the module"
    }
    if sourceIsManual(source) {
        let err = checkOwnership(source)
        if err != null {
            throw err
        }
    }
    return preprocess(source)
}

pub fn compile(source) {
    let src = guardAndPreprocess(source)
    let t0 = date_now_ms()
    let ast = parseSource(src)
    let t1 = date_now_ms()
    let ir = emitMainExec(ast)
    let t2 = date_now_ms()
    let kbc = serSerializeBc(ir)
    let t3 = date_now_ms()
    gMsParse = t1 - t0
    gMsEmit = t2 - t1
    gMsSer = t3 - t2
    gMsTotal = t3 - t0
    if env_get("KABOOTAR_P10_PROFILE") == "1" {
        println("PROFILE self_host parse_ms " + ("" + (t1 - t0)))
        println("PROFILE self_host emit_ms " + ("" + (t2 - t1)))
        println("PROFILE self_host serialize_ms " + ("" + (t3 - t2)))
        println("PROFILE self_host total_ms " + ("" + (t3 - t0)))
        println("PROFILE self_host kbc_len " + ("" + len(kbc)))
    }
    return kbc
}

/// IR module for Kab VM (`runModule` in self_host/vm).
pub fn compileIr(source) {
    let src = guardAndPreprocess(source)
    let t0 = date_now_ms()
    let ast = parseSource(src)
    let t1 = date_now_ms()
    let ir = emitMainExec(ast)
    let t2 = date_now_ms()
    gMsParse = t1 - t0
    gMsEmit = t2 - t1
    gMsSer = 0
    gMsTotal = t2 - t0
    return ir
}


// SH5 deepen: ownership checker merged here (was self_host/ownership).
// Minimal affine ownership checker for @manual modules (O5 subset).
let oPlaceKeys = []
let oPlaceVals = []
let oMutKeys = []
let oMutVals = []
let oSharedKeys = []
let oSharedVals = []
let oErrors = []
let oToks = []
let oI = 0

fn oErr(msg) {
    oErrors = push(oErrors, msg)
}

fn oPairIndex(keys, name) {
    let i = 0
    while i < len(keys) {
        if keys[i] == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn oPairGet(keys, vals, name) {
    let i = oPairIndex(keys, name)
    if i < 0 {
        return null
    }
    return vals[i]
}

fn oPairSetVals(vals, idx, val) {
    let nxt = []
    let j = 0
    while j < len(vals) {
        if j == idx {
            nxt = push(nxt, val)
        } else {
            nxt = push(nxt, vals[j])
        }
        j = j + 1
    }
    return nxt
}

fn oPlaceGet(name) {
    return oPairGet(oPlaceKeys, oPlaceVals, name)
}

fn oSetPlace(name, val) {
    let i = oPairIndex(oPlaceKeys, name)
    if i < 0 {
        oPlaceKeys = push(oPlaceKeys, name)
        oPlaceVals = push(oPlaceVals, val)
        return
    }
    oPlaceVals = oPairSetVals(oPlaceVals, i, val)
}

fn oMutCount(name) {
    let v = oPairGet(oMutKeys, oMutVals, name)
    if v == null {
        return 0
    }
    return v
}

fn oSharedCount(name) {
    let v = oPairGet(oSharedKeys, oSharedVals, name)
    if v == null {
        return 0
    }
    return v
}

fn oMutAdd(name, delta) {
    let n = oMutCount(name) + delta
    let stored = n
    if n < 0 {
        stored = 0
    }
    let i = oPairIndex(oMutKeys, name)
    if i < 0 {
        oMutKeys = push(oMutKeys, name)
        oMutVals = push(oMutVals, stored)
        return
    }
    oMutVals = oPairSetVals(oMutVals, i, stored)
}

fn oSharedAdd(name, delta) {
    let n = oSharedCount(name) + delta
    let stored = n
    if n < 0 {
        stored = 0
    }
    let i = oPairIndex(oSharedKeys, name)
    if i < 0 {
        oSharedKeys = push(oSharedKeys, name)
        oSharedVals = push(oSharedVals, stored)
        return
    }
    oSharedVals = oPairSetVals(oSharedVals, i, stored)
}

fn oIsIdentStart(ch) {
    if ch == "_" {
        return 1
    }
    let letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let j = 0
    while j < len(letters) {
        if char_at(letters, j) == ch {
            return 1
        }
        j = j + 1
    }
    return 0
}

fn oIsIdentChar(ch) {
    if oIsIdentStart(ch) == 1 {
        return 1
    }
    return oIsDigit(ch)
}

fn oIsDigit(ch) {
    let digits = "0123456789"
    let j = 0
    while j < len(digits) {
        if char_at(digits, j) == ch {
            return 1
        }
        j = j + 1
    }
    return 0
}

fn oTokenize(source) {
    let toks = []
    let s = "" + source
    let i = 0
    while i < len(s) {
        let ch = char_at(s, i)
        if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
            i = i + 1
        } else {
            if ch == "\"" {
                i = i + 1
                while i < len(s) && char_at(s, i) != "\"" {
                    if char_at(s, i) == "\\" {
                        i = i + 1
                    }
                    i = i + 1
                }
                if i < len(s) {
                    i = i + 1
                }
                toks = push(toks, { "k": "str", "v": "" })
            } else {
                    if oIsIdentStart(ch) == 1 || ch == "@" {
                    let start = i
                    i = i + 1
                    while i < len(s) && oIsIdentChar(char_at(s, i)) == 1 {
                        i = i + 1
                    }
                    toks = push(toks, { "k": "id", "v": substring(s, start, i) })
                } else {
                    if oIsDigit(ch) == 1 {
                        while i < len(s) && oIsDigit(char_at(s, i)) == 1 {
                            i = i + 1
                        }
                        toks = push(toks, { "k": "num", "v": "0" })
                    } else {
                        toks = push(toks, { "k": "op", "v": ch })
                        i = i + 1
                    }
                }
            }
        }
    }
    return toks
}

fn oPeek() {
    if oI >= len(oToks) {
        return { "k": "eof", "v": "" }
    }
    return oToks[oI]
}

fn oBump() {
    let t = oPeek()
    if oI < len(oToks) {
        oI = oI + 1
    }
    return t
}

fn oAtId(name) {
    let t = oPeek()
    if t.k == "id" && t.v == name {
        return 1
    }
    return 0
}

fn oIsBorrowed(name) {
    if oMutCount(name) > 0 {
        return 1
    }
    if oSharedCount(name) > 0 {
        return 1
    }
    return 0
}

fn oUse(name, doMove) {
    let st = oPlaceGet(name)
    if st == "moved" {
        oErr("ownership: use after move of `" + name + "`")
        return 0
    }
    if st == "owned" {
        if doMove == 1 {
            if oIsBorrowed(name) == 1 {
                oErr("ownership: cannot move `" + name + "` while borrowed")
                return 0
            }
            oSetPlace(name, "moved")
            return 1
        }
        return 0
    }
    return 0
}

fn oBorrow(name, isMut) {
    let st = oPlaceGet(name)
    if st == "moved" {
        oErr("ownership: use after move of `" + name + "`")
        return
    }
    if st != "owned" {
        return
    }
    if isMut == 1 {
        if oMutCount(name) > 0 {
            oErr("ownership: exclusive &mut borrow of `" + name + "` already active")
            return
        }
        if oSharedCount(name) > 0 {
            oErr("ownership: cannot &mut `" + name + "` while shared-borrowed")
            return
        }
        oMutAdd(name, 1)
    } else {
        if oMutCount(name) > 0 {
            oErr("ownership: cannot shared-borrow `" + name + "` while &mut active")
            return
        }
        oSharedAdd(name, 1)
    }
}

fn oClearCallBorrows(names) {
    let i = 0
    while i < len(names) {
        let n = names[i]
        if oMutCount(n) > 0 {
            oMutAdd(n, -1)
        }
        if oSharedCount(n) > 0 {
            oSharedAdd(n, -1)
        }
        i = i + 1
    }
}

fn oSkipCallArgs(doMove) {
    if oPeek().v != "(" {
        return
    }
    oBump()
    let depth = 1
    let callBorrows = []
    while oI < len(oToks) && depth > 0 {
        let t = oPeek()
        if t.v == "(" {
            oBump()
            depth = depth + 1
        } else {
            if t.v == ")" {
                oBump()
                depth = depth - 1
            } else {
                if depth == 1 && t.k == "op" && t.v == "&" {
                    // & / &mut borrow — peek, do not move; track for exclusivity
                    oBump()
                    let isMut = 0
                    if oAtId("mut") == 1 {
                        oBump()
                        isMut = 1
                    }
                    if oPeek().k == "id" {
                        let n = oPeek().v
                        oBump()
                        oBorrow(n, isMut)
                        callBorrows = push(callBorrows, n)
                    }
                } else {
                    if t.k == "id" && depth == 1 {
                        oBump()
                        oUse(t.v, doMove)
                    } else {
                        oBump()
                    }
                }
            }
        }
    }
    // Borrow scope = call expression
    oClearCallBorrows(callBorrows)
}

/// Parse a primary/call expression. Returns 1 if it produces Owned.
fn oExpr(doMove) {
    let t = oPeek()
    // O5 deepen: bare &x / &mut x — peek (no move). Call-arg borrows tracked in oSkipCallArgs.
    if t.k == "op" && t.v == "&" {
        oBump()
        if oAtId("mut") == 1 {
            oBump()
        }
        let nameTok = oPeek()
        if nameTok.k == "id" {
            oBump()
            oUse(nameTok.v, 0)
        }
        return 0
    }
    if t.k != "id" {
        if t.k != "eof" {
            oBump()
        }
        return 0
    }
    let name = t.v
    oBump()
    if name == "owned_alloc" || name == "alloc" {
        if oPeek().v == "(" {
            oSkipCallArgs(0)
        }
        return 1
    }
    if name == "drop" || name == "owned_move" || name == "move" || name == "free" {
        if oPeek().v == "(" {
            oBump()
            if oPeek().k == "op" && oPeek().v == "&" {
                oBump()
                if oAtId("mut") == 1 {
                    oBump()
                }
            }
            let arg = oPeek()
            if arg.k == "id" {
                oBump()
                oUse(arg.v, 1)
            }
            if oPeek().v == ")" {
                oBump()
            }
        }
        return 1
    }
    if name == "owned_read" || name == "owned_write" || name == "read" || name == "write" {
        if oPeek().v == "(" {
            oSkipCallArgs(0)
        }
        return 0
    }
    if oPeek().v == "(" {
        // O2: bare Owned call-arg moves unless & / &mut
        oSkipCallArgs(1)
        return 0
    }
    return oUse(name, doMove)
}

fn oStmt() {
    if oAtId("@manual") == 1 {
        oBump()
        return
    }
    if oAtId("let") == 1 {
        oBump()
        let nameTok = oPeek()
        if nameTok.k != "id" {
            return
        }
        let name = nameTok.v
        oBump()
        if oPeek().v == "=" {
            oBump()
            let produced = oExpr(1)
            if produced == 1 {
                oSetPlace(name, "owned")
            }
        }
        return
    }
    let t = oPeek()
    if t.k == "id" {
        let name = t.v
        let save = oI
        oBump()
        if oPeek().v == "=" {
            oBump()
            let produced = oExpr(1)
            if produced == 1 {
                oSetPlace(name, "owned")
            }
            return
        }
        oI = save
    }
    oExpr(0)
}

pub fn checkOwnership(source) {
    oPlaceKeys = []
    oPlaceVals = []
    oMutKeys = []
    oMutVals = []
    oSharedKeys = []
    oSharedVals = []
    oErrors = []
    oToks = oTokenize(source)
    oI = 0
    while oI < len(oToks) {
        let before = oI
        oStmt()
        if oI == before {
            oBump()
        }
    }
    let i = 0
    while i < len(oPlaceKeys) {
        let k = oPlaceKeys[i]
        if oPlaceVals[i] == "owned" {
            oErr("ownership: Owned '" + k + "' dropped out of scope without move/drop (leak-lint)")
        }
        i = i + 1
    }
    if len(oErrors) == 0 {
        return null
    }
    let msg = oErrors[0]
    i = 1
    while i < len(oErrors) {
        msg = msg + "\n" + oErrors[i]
        i = i + 1
    }
    return msg
}

pub fn checkSource(source) {
    return checkOwnership(source)
}


