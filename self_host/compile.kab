    object_array_clear(E, "eBlockStmtsStack")
    E["eBlockDepth"] = 0
    E["eCalleeDepth"] = 0
    E["eCallArgDepth"] = 0
    E["eObjDepth"] = 0
    E["eArrDepth"] = 0
    E["eIfDepth"] = 0
    E["eMemberDepth"] = 0
    E["eIndexDepth"] = 0
    E["eLenScratch"] = 0
    E["eFld"] = null
    object_array_clear(E, "eIfJmpStack")
    object_array_clear(E, "eIfSkipStack")
    object_array_clear(E, "eExports")
    object_array_clear(E, "eImports")
    E["eFnSave"] = ""
    E["eFnPub"] = 0
    E["eStoreSym"] = ""
    E["eAssignSym"] = ""
    E["eExprStmt"] = null
    E["eMemberFld"] = ""
    object_array_clear(E, "eMemberFldStack")
    E["eSnapI"] = 0
    object_array_clear(E, "eSnapOut")
    E["eLoopSave"] = 0
    E["eStmtKind"] = ""
    E["eStmtNode"] = null
    object_array_clear(E, "eObjIStack")
    object_array_clear(E, "eObjNStack")
    object_array_clear(E, "eArrIStack")
    object_array_clear(E, "eArrNStack")
    object_array_clear(E, "eCallArgIStack")
    object_array_clear(E, "eCallArgNStack")
    object_array_clear(E, "eArgsStack")
    object_array_clear(E, "eIndexStack")
    E["eLitNode"] = null
    E["eGenericTemplates"] = []
    E["eTraitImpls"] = {}
    E["eSpecMangled"] = []
    E["eBindingSyms"] = []
    E["eBindingTypes"] = []
    E["eGenericClassTemplates"] = []
    E["eGenericEnumTemplates"] = []
    E["eGenericMethodTemplates"] = []
    E["eClasses"] = []
    E["eClassesN"] = 0
    E["eInterfaces"] = []
    E["eEnums"] = []
    E["eClassMethods"] = []
    E["eClassMethodsSrc"] = []
    E["eClassIsStruct"] = 0
    E["eArrows"] = []
    E["eTryRegions"] = []
    E["eFnTryRegions"] = []
    E["eTryEmitStack"] = []
    E["eFinStack"] = []
    E["eForCounter"] = 0
    E["eGenTmpl"] = null
    E["eGenSym"] = ""
    E["eMangled"] = ""
    E["eExplicit"] = []
    E["eTypeParams"] = []
    E["eTypeArgs"] = []
    E["eSaveInFn"] = 0
    E["eSaveFnOps"] = []
    E["eSaveFnOpsN"] = 0
    E["eSaveFnLocals"] = []
    E["eSaveFnGlobals"] = []
    E["eGenI"] = 0
    E["eInferType"] = ""
    E["eResolveI"] = 0
    E["eRecvClass"] = ""
    E["eCtorCallee"] = null
    E["eCtorName"] = ""
    E["eMethodMangled"] = ""
    E["eMethTmpl"] = null
    E["eWhereSrc"] = null
    E["eNewClasses"] = []
    E["eNewMethods"] = []
    E["eClassIdx"] = 0
    E["eFoundMeth"] = 0
    E["eCtorArgs"] = []
}

let gE = null

pub fn emitMainInitCore(E, program) {
    E["eProgram"] = program
    object_array_clear(E, "eConsts")
    E["eConstMap"] = {}
    E["eConstN"] = 0
    object_array_clear(E, "eOps")
    E["eOpsN"] = 0
    object_array_clear(E, "eGlobals")
    E["eGlobalMap"] = {}
    E["eGlobalN"] = 0
    object_array_clear(E, "eFunctions")
    object_array_clear(E, "eFnOps")
    E["eFnOpsN"] = 0
    E["eBlockDepth"] = 0
    E["eCalleeDepth"] = 0
    E["eCallArgDepth"] = 0
    E["eObjDepth"] = 0
    E["eArrDepth"] = 0
    E["eIfDepth"] = 0
    E["eMemberDepth"] = 0
    E["eIndexDepth"] = 0
    object_array_clear(E, "eFnGlobals")
    object_array_clear(E, "eFnLocals")
    resetLocalMap(E)
    E["eInFn"] = 0
}

pub fn emitMainInitStacks(E) {
    object_array_clear(E, "eWhileHeads")
    object_array_clear(E, "eBreakIdxs")
    object_array_clear(E, "eBreakFromStack")
    object_array_clear(E, "eIterCloseStack")
    object_array_clear(E, "eIfJmpStack")
    object_array_clear(E, "eIfSkipStack")
    object_array_clear(E, "eMemberFldStack")
    object_array_clear(E, "eBlockStmtsStack")
    object_array_clear(E, "eBlockNStack")
    object_array_clear(E, "eBlockIStack")
    object_array_clear(E, "eObjIStack")
    object_array_clear(E, "eObjNStack")
    object_array_clear(E, "eArrIStack")
    object_array_clear(E, "eArrNStack")
    object_array_clear(E, "eCallArgIStack")
    object_array_clear(E, "eCallArgNStack")
    object_array_clear(E, "eArgsStack")
    object_array_clear(E, "eCalleeStack")
}

pub fn emitMainInitMeta(E) {
    object_array_clear(E, "eGenericTemplates")
    E["eTraitImpls"] = {}
    object_array_clear(E, "eGenericClassTemplates")
    object_array_clear(E, "eGenericEnumTemplates")
    object_array_clear(E, "eGenericMethodTemplates")
    object_array_clear(E, "eClasses")
    E["eClassesN"] = 0
    E["eInterfaces"] = []
    object_array_clear(E, "eEnums")
    object_array_clear(E, "eArrows")
    object_array_clear(E, "eTryRegions")
    object_array_clear(E, "eFnTryRegions")
    object_array_clear(E, "eTryEmitStack")
    object_array_clear(E, "eFinStack")
    E["eForCounter"] = 0
    object_array_clear(E, "eSpecMangled")
    object_array_clear(E, "eBindingSyms")
    object_array_clear(E, "eBindingTypes")
    object_array_clear(E, "eExports")
    E["eImports"] = []
    E["eProg"] = 0
    if E["eProgram"]["imports"] != undefined {
        E["eImports"] = E["eProgram"]["imports"]
    }
}

pub fn emitMainInit(E, program) {
    emitMainInitCore(E, program)
    emitMainInitStacks(E)
    emitMainInitMeta(E)
}

pub fn emitMain(E, program) {
    emitMainInit(E, program)
    object_array_push(E, "eBlockStmtsStack", E["eProgram"]["body"])
    arrUtil(E, "pushLenKey", "eBlockNStack", E["eProgram"]["body"])
    object_array_push(E, "eBlockIStack", 0)
    E["eBlockDepth"] = E["eBlockDepth"] + 1
    let pd = E["eBlockDepth"]
    while E["eBlockIStack"][pd - 1] < E["eBlockNStack"][pd - 1] {
        E["eBlockStmts"] = E["eBlockStmtsStack"][pd - 1]
        E["eBlockI"] = E["eBlockIStack"][pd - 1]
        E["eStmtNode"] = E["eBlockStmts"][E["eBlockI"]]
        if E["eStmtNode"] == null {
            throw "emit program null stmt at " + ("" + E["eBlockI"])
        }
        eCallStmt(E, E["eStmtNode"])
        E["eBlockIStack"][pd - 1] = E["eBlockIStack"][pd - 1] + 1
    }
    E["eBlockDepth"] = E["eBlockDepth"] - 1
    emitDisposeUsings(E, E["eProgram"]["body"])
    emitOp(E, OP_HALT, 0)
    let nops = E["eOpsN"]
    if accCount(nops) != nops {
        throw "emit op count mismatch"
    }
    return {
        "constants": E["eConsts"],
        "globals": E["eGlobals"],
        "ops": E["eOps"],
        "functions": E["eFunctions"],
        "classes": E["eClasses"],
        "interfaces": E["eInterfaces"],
        "enums": E["eEnums"],
        "arrows": E["eArrows"],
        "tryRegions": E["eTryRegions"],
        "locals": [],
        "genericMethodTemplates": E["eGenericMethodTemplates"],
        "exports": E["eExports"],
        "imports": E["eImports"]
    }
}

pub fn eTramp(E) {
    if E["_hook"] == 0 {
        return emitExprBody(E, E["_node"])
    }
    return emitStmtBody(E, E["_node"])
}

fn eTrampFn(E) {
    return eTramp(E)
}

pub fn emitMainExec(program) {
    let E = gE
    if E == null {
        E = eMakeSession()
        gE = E
        E["tramp"] = eTrampFn
    } else {
        eResetSession(E)
        E["tramp"] = eTrampFn
    }
    E["_hook"] = 0
    E["_node"] = null
    return emitMain(E, program)
}

pub let emitMainFromExec = emitMainExec
// SH5 deepen: serialize_sections merged here (compile-DAG 8 -> 7).

pub let KBC_HEADER = "kabootar-bytecode/1"

pub let IR_WITH_ARG = "|const|load_global|store_global|load_local|store_local|take_local|take_global|array_push_local|array_push_global|array_pop_local|array_pop_global|acc_add_local|acc_add_global|len_local|len_global|index_get_local|index_get_global|make_object|make_array|get_member|get_super_method|member_set|jump|jump_if_false|jump_if_true|jump_if_not_nullish|call|jump_if_result_err|make_arrow_fn|jump_unless_option_some|jump_unless_option_none|jump_unless_result_ok|jump_unless_result_err|jump_unless_array|jump_unless_object|jump_unless_object_empty|index_peek_from_end|object_rest|unpack_enum_fields|new_instance_from_array|"
pub let IR_ZERO_ARG = "|pop|dup|swap|add|sub|mul|div|mod|pow|neg|not|eq|ne|lt|gt|ge|le|and|or|bit_and|bit_or|bit_xor|shl|shr|ushr|bit_not|index_get|index_set|return|throw|iterator_step_in_place|async_iterator_step_in_place|make_ok|make_err|make_some|make_none|halt|match_fail|unwrap_option_some|unwrap_result_ok|unwrap_result_err|get_length|result_question|concat_array|merge_object|call_from_array|await|yield|"

pub fn serJoinComma(arr) {
    let params = ""
    let k = 0
    let n = len(arr)
    while k < n {
        if params == "" {
            params = arr[k]
        } else {
            params = params + ","
            params = params + arr[k]
        }
        k = k + 1
    }
    return params
}

pub fn serEscStr(s) {
    let out = ""
    let i = 0
    let n = len(s)
    while i < n {
        let ch = char_at(s, i)
        let piece = ch
        if ch == "\\" {
            piece = "\\\\"
        }
        if ch == " " {
            piece = "\\s"
        }
        if ch == "\n" {
            piece = "\\n"
        }
        if ch == "\r" {
            piece = "\\r"
        }
        if ch == "\t" {
            piece = "\\t"
        }
        out = out + piece
        i = i + 1
    }
    return out
}

pub fn serConstLine(idx, val) {
    let line = "const "
    line = line + ("" + idx)
    line = line + " "
    if val == KAB_UNDEF_CONST {
        line = line + "undefined"
        return line
    }
    if val == null {
        line = line + "null"
        return line
    }
    if val == true {
        line = line + "bool true"
        return line
    }
    if val == false {
        line = line + "bool false"
        return line
    }
    if typeof(val) == "string" {
        line = line + "string "
        line = line + serEscStr(val)
        return line
    }
    if is_float(val) {
        line = line + "float "
        line = line + ("" + val)
        return line
    }
    line = line + "number "
    line = line + ("" + val)
    return line
}

pub fn serIrOpNewInstance(op) {
    let line = OP_NEW_INSTANCE
    line = line + " "
    line = line + ("" + op.arg)
    line = line + " "
    let a2 = op.arg2
    if a2 == undefined {
        a2 = 0
    }
    line = line + ("" + a2)
    return line
}

pub fn serIrOpTwoArg(op) {
    let line = op.op
    line = line + " "
    line = line + ("" + op.arg)
    line = line + " "
    let a2 = op.arg2
    if a2 == undefined {
        a2 = 0
    }
    line = line + ("" + a2)
    return line
}

pub fn serIrOpThreeArg(op) {
    let line = op.op
    line = line + " "
    line = line + ("" + op.arg)
    line = line + " "
    let a2 = op.arg2
    if a2 == undefined {
        a2 = 0
    }
    line = line + ("" + a2)
    line = line + " "
    let a3 = op.arg3
    if a3 == undefined {
        a3 = 0
    }
    line = line + ("" + a3)
    return line
}

pub fn serIrOpLookup(name, op) {
    if str_index_of(IR_WITH_ARG, "|" + name + "|") >= 0 {
        let line = name
        line = line + " "
        line = line + ("" + op.arg)
        return line
    }
    if str_index_of(IR_ZERO_ARG, "|" + name + "|") >= 0 {
        return name
    }
    throw "Unsupported IR op: " + name
}

pub fn serIrOpLine(op) {
    if op == null {
        throw "serialize: null op in IR"
    }
    let name = op["op"]
    if name == undefined {
        name = op.op
    }
    if name == OP_NEW_INSTANCE {
        return serIrOpTwoArg(op)
    }
    if name == OP_JUMP_UNLESS_CONST_EQ {
        return serIrOpTwoArg(op)
    }
    if name == OP_JUMP_UNLESS_HAS_MEMBER {
        return serIrOpTwoArg(op)
    }
    if name == OP_ARRAY_SLICE_REST {
        return serIrOpTwoArg(op)
    }
    if name == OP_JUMP_UNLESS_ENUM_VARIANT {
        return serIrOpThreeArg(op)
    }
    return serIrOpLookup(name, op)
}

pub fn serOutTag(out, tag) {
    return out + CHAR_NL + tag
}

pub fn serOutSpNum(out, x) {
    return out + " " + ("" + x)
}

pub fn serOutSp(out, s) {
    return out + " " + s
}

pub fn serOutTagEq(out, tag, n) {
    return out + CHAR_NL + tag + ("" + n)
}

pub fn serOutTagged(out, tag, i, rest) {
    let s = serOutTag(out, tag)
    s = serOutSpNum(s, i)
    return serOutSp(s, rest)
}

pub fn serOutTagged2(out, tag, a, b, rest) {
    let s = serOutTag(out, tag)
    s = serOutSpNum(s, a)
    s = serOutSpNum(s, b)
    return serOutSp(s, rest)
}

pub fn serOutTry4(out, tag, a, tr) {
    let s = serOutTag(out, tag)
    s = serOutSpNum(s, a)
    s = serOutSpNum(s, tr["bodyStart"])
    s = serOutSpNum(s, tr["bodyEnd"])
    s = serOutSpNum(s, tr["catchStart"])
    return serOutSpNum(s, tr["errLocal"])
}

pub fn serOutTry5(out, tag, a, b, tr) {
    let s = serOutTag(out, tag)
    s = serOutSpNum(s, a)
    s = serOutSpNum(s, b)
    s = serOutSpNum(s, tr["bodyStart"])
    s = serOutSpNum(s, tr["bodyEnd"])
    s = serOutSpNum(s, tr["catchStart"])
    return serOutSpNum(s, tr["errLocal"])
}

pub fn serAppendNamedList(out, zeroTag, eqTag, itemTag, items) {
    if items == undefined {
        return serOutTag(out, zeroTag)
    }
    out = serOutTagEq(out, eqTag, len(items))
    let i = 0
    let n = len(items)
    while i < n {
        out = serOutTagged(out, itemTag, i, items[i])
        i = i + 1
    }
    return out
}

/// Typed i64 AccAdd-loop (SH9 serialize): host Cranelift can compile this helper.
pub fn serCount(n) {
    let i = 0
    let s = 0
    while i < n {
        s = s + 1
        i = i + 1
    }
    return s
}

pub fn serAppendTaggedOps(out, tag, i, ops) {
    let j = 0
    let n = len(ops)
    if serCount(n) != n {
        throw "serialize tagged op count mismatch"
    }
    while j < n {
        out = serOutTagged(out, tag, i, serIrOpLine(ops[j]))
        j = j + 1
    }
    return out
}

pub fn serAppendOps(out, ops) {
    let i = 0
    let n = len(ops)
    if serCount(n) != n {
        throw "serialize op count mismatch"
    }
    while i < n {
        out = out + CHAR_NL + serIrOpLine(ops[i])
        i = i + 1
    }
    return out
}

pub fn serAppendOneArrow(out, i, arr) {
    out = serOutTagged(out, "arrow", i, arr["sym"])
    out = serOutTagged(out, "arrow_params", i, serJoinComma(arr["params"]))
    out = serOutTagged(out, "arrow_locals", i, serJoinComma(arr["locals"]))
    if arr["isAsync"] == 1 {
        out = out + CHAR_NL + "arrow_async " + ("" + i)
    }
    if arr["isAsync"] == true {
        out = out + CHAR_NL + "arrow_async " + ("" + i)
    }
    return serAppendTaggedOps(out, "arrow_op", i, arr["ops"])
}

/// SH2: arrows nested in a named fn (`fn_arrow` / `fn_arrow_op` lines).
pub fn serAppendFnArrows(out, fi, arrows) {
    if arrows == undefined {
        return out
    }
    let n = len(arrows)
    if n == 0 {
        return out
    }
    out = serOutTagged(out, "fn_arrows", fi, n)
    let ai = 0
    while ai < n {
        let arr = arrows[ai]
        out = out + CHAR_NL + "fn_arrow " + ("" + fi) + " " + ("" + ai) + " " + arr["sym"]
        out = out + CHAR_NL + "fn_arrow_params " + ("" + fi) + " " + ("" + ai) + " " + serJoinComma(arr["params"])
        out = out + CHAR_NL + "fn_arrow_locals " + ("" + fi) + " " + ("" + ai) + " " + serJoinComma(arr["locals"])
        if arr["isAsync"] == 1 {
            out = out + CHAR_NL + "fn_arrow_async " + ("" + fi) + " " + ("" + ai)
        }
        if arr["isAsync"] == true {
            out = out + CHAR_NL + "fn_arrow_async " + ("" + fi) + " " + ("" + ai)
        }
        let j = 0
        let ops = arr["ops"]
        let on = len(ops)
        while j < on {
            out = out + CHAR_NL + "fn_arrow_op " + ("" + fi) + " " + ("" + ai) + " " + serIrOpLine(ops[j])
            j = j + 1
        }
        ai = ai + 1
    }
    return out
}

pub fn serAppendArrows(out, arrows) {
    if arrows == undefined {
        return serOutTag(out, "arrows=0")
    }
    out = serOutTagEq(out, "arrows=", len(arrows))
    let i = 0
    let n = len(arrows)
    while i < n {
        out = serAppendOneArrow(out, i, arrows[i])
        i = i + 1
    }
    return out
}

pub fn serAppendFnTries(out, i, regions) {
    let j = 0
    let nTr = len(regions)
    while j < nTr {
        out = serOutTry5(out, "fn_try_region", i, j, regions[j])
        j = j + 1
    }
    return out
}

pub fn serAppendOneFn(out, i, f) {
    out = serOutTagged(out, "fn", i, f.sym)
    out = serOutTagged(out, "fn_params", i, serJoinComma(f.params))
    out = serOutTagged(out, "fn_locals", i, serJoinComma(f.locals))
    if f["isAsync"] == 1 {
        out = out + CHAR_NL + "fn_async " + ("" + i)
    }
    if f["isAsync"] == true {
        out = out + CHAR_NL + "fn_async " + ("" + i)
    }
    if f["isGen"] == 1 {
        out = out + CHAR_NL + "fn_generator " + ("" + i)
    }
    if f["isGen"] == true {
        out = out + CHAR_NL + "fn_generator " + ("" + i)
    }
    if f["tryRegions"] != undefined {
        out = serAppendFnTries(out, i, f["tryRegions"])
    }
    out = serAppendFnArrows(out, i, f["arrows"])
    return out
}

pub fn serAppendFunctions(out, fns) {
    out = serOutTagEq(out, "functions=", len(fns))
    let i = 0
    let n = len(fns)
    while i < n {
        out = serAppendOneFn(out, i, fns[i])
        out = serAppendTaggedOps(out, "fn_op", i, fns[i].ops)
        i = i + 1
    }
    return out
}

pub fn serAppendClassMethodOps(out, ci, j, ops) {
    let k = 0
    let nOps = len(ops)
    while k < nOps {
        out = serOutTagged2(out, "class_method_op", ci, j, serIrOpLine(ops[k]))
        k = k + 1
    }
    return out
}

pub fn serAppendClassMethodConsts(out, ci, j, constants) {
    if constants == undefined {
        return out
    }
    let k = 0
    let n = len(constants)
    while k < n {
        let line = serConstLine(k, constants[k])
        out = serOutTag(out, "class_method_const")
        out = serOutSpNum(out, ci)
        out = serOutSpNum(out, j)
        out = serOutSp(out, str_slice(line, 6, len(line)))
        k = k + 1
    }
    return out
}

pub fn serAppendOneClassMethod(out, ci, j, meth) {
    out = serOutTagged2(out, "class_method", ci, j, meth["sym"])
    out = serOutTagged2(out, "class_method_params", ci, j, serJoinComma(meth["params"]))
    out = serOutTagged2(out, "class_method_locals", ci, j, serJoinComma(meth["locals"]))
    out = serOutTagged2(out, "class_method_globals", ci, j, serJoinComma(meth["globals"]))
    out = serAppendClassMethodConsts(out, ci, j, meth["constants"])
    return serAppendClassMethodOps(out, ci, j, meth["ops"])
}

pub fn serAppendClassMethods(out, ci, methods) {
    let j = 0
    let n = len(methods)
    while j < n {
        out = serAppendOneClassMethod(out, ci, j, methods[j])
        j = j + 1
    }
    return out
}

pub fn serAppendOneEnumVariant(out, ei, vi, v) {
    out = serOutTagged2(out, "enum_variant", ei, vi, v["name"])
    let fields = v["fields"]
    if fields == undefined {
        return out
    }
    if len(fields) == 0 {
        return out
    }
    return serOutTagged2(out, "enum_variant_fields", ei, vi, serJoinComma(fields))
}

pub fn serAppendEnums(out, enums) {
    if enums == undefined {
        return serOutTag(out, "enums=0")
    }
    out = serOutTagEq(out, "enums=", len(enums))
    let i = 0
    let n = len(enums)
    while i < n {
        let en = enums[i]
        out = serOutTagged(out, "enum", i, en["sym"])
        let vars = en["variants"]
        if vars == undefined {
            vars = []
        }
        let vi = 0
        while vi < len(vars) {
            out = serAppendOneEnumVariant(out, i, vi, vars[vi])
            vi = vi + 1
        }
        i = i + 1
    }
    return out
}

pub fn serAppendClassFields(out, ci, fields) {
    if fields == undefined {
        return out
    }
    let fi = 0
    let n = len(fields)
    while fi < n {
        let f = fields[fi]
        out = serOutTagged2(out, "class_field", ci, fi, f["name"])
        if f["type"] != "" {
            if f["type"] != undefined {
                out = serOutTagged2(out, "class_field_type", ci, fi, f["type"])
            }
        }
        fi = fi + 1
    }
    return out
}

pub fn serAppendIfaceMethods(out, ii, methods) {
    if methods == undefined {
        return out
    }
    let mi = 0
    let n = len(methods)
    while mi < n {
        let m = methods[mi]
        out = serOutTagged2(out, "iface_method", ii, mi, m["sym"])
        out = serOutTagged2(out, "iface_method_params", ii, mi, serJoinComma(m["params"]))
        if m["default"] == 1 {
            out = serOutTag(out, "iface_method_default")
            out = serOutSpNum(out, ii)
            out = serOutSpNum(out, mi)
            out = serAppendIfaceDefault(out, ii, mi, m)
        }
        mi = mi + 1
    }
    return out
}

pub fn serAppendIfaceDefault(out, ii, mi, m) {
    let constants = m["constants"]
    if constants == undefined {
        constants = []
    }
    let k = 0
    while k < len(constants) {
        let line = serConstLine(k, constants[k])
        out = serOutTag(out, "iface_method_default_const")
        out = serOutSpNum(out, ii)
        out = serOutSpNum(out, mi)
        out = serOutSp(out, str_slice(line, 6, len(line)))
        k = k + 1
    }
    out = serOutTagged2(out, "iface_method_default_params", ii, mi, serJoinComma(m["params"]))
    out = serOutTagged2(out, "iface_method_default_locals", ii, mi, serJoinComma(m["locals"]))
    out = serOutTagged2(out, "iface_method_default_globals", ii, mi, serJoinComma(m["globals"]))
    let ops = m["ops"]
    if ops == undefined {
        ops = []
    }
    k = 0
    while k < len(ops) {
        out = serOutTagged2(out, "iface_method_default_op", ii, mi, serIrOpLine(ops[k]))
        k = k + 1
    }
    return out
}

pub fn serAppendInterfaces(out, ifaces) {
    if ifaces == undefined {
        return serOutTag(out, "interfaces=0")
    }
    out = serOutTagEq(out, "interfaces=", len(ifaces))
    let i = 0
    let n = len(ifaces)
    while i < n {
        let iface = ifaces[i]
        out = serOutTagged(out, "interface", i, iface["sym"])
        let tparams = iface["typeParams"]
        if tparams != undefined {
            if len(tparams) > 0 {
                out = serOutTagged(out, "interface_type_params", i, serJoinComma(tparams))
            }
        }
        let assoc = iface["associatedTypes"]
        if assoc != undefined {
            if len(assoc) > 0 {
                out = serOutTagged(out, "interface_assoc_types", i, serJoinComma(assoc))
            }
        }
        out = serAppendIfaceMethods(out, i, iface["methods"])
        i = i + 1
    }
    return out
}

pub fn serAppendClassExtends(out, ci, ext) {
    if ext == undefined {
        return out
    }
    if ext == "" {
        return out
    }
    return serOutTagged(out, "class_extends", ci, serEscStr(ext))
}

pub fn serAppendClassImplements(out, ci, impls) {
    if impls == undefined {
        return out
    }
    if len(impls) == 0 {
        return out
    }
    return serOutTagged(out, "class_implements", ci, serJoinComma(impls))
}

pub fn serAppendClassAssoc(out, ci, assoc) {
    if assoc == undefined {
        return out
    }
    if len(assoc) == 0 {
        return out
    }
    let encoded = ""
    let i = 0
    while i < len(assoc) {
        let p = assoc[i]
        let piece = p["name"] + "=" + p["type"]
        if encoded == "" {
            encoded = piece
        } else {
            encoded = encoded + "," + piece
        }
        i = i + 1
    }
    return serOutTagged(out, "class_assoc_types", ci, encoded)
}

pub fn serAppendClasses(out, classes) {
    if classes == undefined {
        return serOutTag(out, "classes=0")
    }
    out = serOutTagEq(out, "classes=", len(classes))
    let i = 0
    let n = len(classes)
    while i < n {
        let cls = classes[i]
        out = serOutTagged(out, "class", i, cls["sym"])
        if cls["isStruct"] == 1 {
            out = serOutTag(out, "class_is_struct")
            out = serOutSpNum(out, i)
        }
        out = serAppendClassExtends(out, i, cls["extends"])
        out = serAppendClassImplements(out, i, cls["implements"])
        out = serAppendClassAssoc(out, i, cls["associatedTypes"])
        out = serAppendClassFields(out, i, cls["fields"])
        out = serAppendClassMethods(out, i, cls["methods"])
        i = i + 1
    }
    return out
}

pub fn serAppendConsts(out, constants) {
    let i = 0
    let n = len(constants)
    while i < n {
        out = out + CHAR_NL + serConstLine(i, constants[i])
        i = i + 1
    }
    return out
}

pub fn serAppendGlobals(out, globals) {
    let i = 0
    let n = len(globals)
    while i < n {
        out = serOutTagged(out, "global", i, globals[i])
        i = i + 1
    }
    return out
}

pub fn serAppendBcTailRest(out, bc) {
    out = serAppendNamedList(out, "exports=0", "exports=", "export", bc.exports)
    out = serAppendNamedList(out, "imports=0", "imports=", "import", bc.imports)
    out = serAppendInterfaces(out, bc["interfaces"])
    out = serAppendClasses(out, bc.classes)
    out = serAppendEnums(out, bc["enums"])
    out = serOutTag(out, "code")
    return serAppendOps(out, bc.ops)
}

pub fn serAppendMainTries(out, tryRegions) {
    if tryRegions == undefined {
        return out
    }
    let nMtr = len(tryRegions)
    let i = 0
    while i < nMtr {
        out = serOutTry4(out, "main_try_region", i, tryRegions[i])
        i = i + 1
    }
    return out
}

pub fn serAppendBcTail(out, bc) {
    out = serAppendMainTries(out, bc.tryRegions)
    return serAppendBcTailRest(out, bc)
}

pub fn serSerializeBc(bc) {
    let out = KBC_HEADER
    out = serOutTagEq(out, "constants=", len(bc.constants))
    out = serAppendConsts(out, bc.constants)
    out = serAppendGlobals(out, bc.globals)
    out = serAppendFunctions(out, bc.functions)
    out = serAppendArrows(out, bc.arrows)
    return serAppendBcTail(out, bc)
}
