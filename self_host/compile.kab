pub fn eResetSession(E) {
    object_array_clear(E, "eConsts")
    object_array_clear(E, "eOps")
    E["eOpsN"] = 0
    object_array_clear(E, "eGlobals")
    object_array_clear(E, "eFnOps")
    E["eFnOpsN"] = 0
    object_array_clear(E, "eFnGlobals")
    object_array_clear(E, "eFnLocals")
    E["eConstMap"] = {}
    E["eConstN"] = 0
    E["eGlobalMap"] = {}
    E["eGlobalN"] = 0
    E["eLocalMap"] = {}
    E["eLocalN"] = 0
    E["eInFn"] = 0
