    object_array_clear(E, "eBlockNStack")
    object_array_clear(E, "eBlockIStack")
    object_array_clear(E, "eBlockStmtsStack")
    E["eBlockDepth"] = 0
    E["eCalleeDepth"] = 0
    E["eCallArgDepth"] = 0
    E["eObjDepth"] = 0
    E["eArrDepth"] = 0
    E["eIfDepth"] = 0
    E["eMemberDepth"] = 0
    E["eIndexDepth"] = 0
    E["eLenScratch"] = 0
    E["eFld"] = null
    object_array_clear(E, "eIfJmpStack")
    object_array_clear(E, "eIfSkipStack")
    object_array_clear(E, "eExports")
    object_array_clear(E, "eImports")
    E["eFnSave"] = ""
    E["eFnPub"] = 0
    E["eStoreSym"] = ""
    E["eAssignSym"] = ""
    E["eExprStmt"] = null
    E["eMemberFld"] = ""
    object_array_clear(E, "eMemberFldStack")
    E["eSnapI"] = 0
    object_array_clear(E, "eSnapOut")
    E["eLoopSave"] = 0
    E["eStmtKind"] = ""
    E["eStmtNode"] = null
    object_array_clear(E, "eObjIStack")
    object_array_clear(E, "eObjNStack")
    object_array_clear(E, "eArrIStack")
    object_array_clear(E, "eArrNStack")
    object_array_clear(E, "eCallArgIStack")
    object_array_clear(E, "eCallArgNStack")
    object_array_clear(E, "eArgsStack")
    object_array_clear(E, "eIndexStack")
    E["eLitNode"] = null
    E["eGenericTemplates"] = []
    E["eTraitImpls"] = {}
    E["eSpecMangled"] = []
    E["eBindingSyms"] = []
    E["eBindingTypes"] = []
    E["eGenericClassTemplates"] = []
    E["eGenericEnumTemplates"] = []
    E["eGenericMethodTemplates"] = []
    E["eClasses"] = []
    E["eClassesN"] = 0
    E["eInterfaces"] = []
    E["eEnums"] = []
    E["eClassMethods"] = []
    E["eClassMethodsSrc"] = []
    E["eClassIsStruct"] = 0
    E["eArrows"] = []
    E["eTryRegions"] = []
    E["eFnTryRegions"] = []
    E["eTryEmitStack"] = []
    E["eFinStack"] = []
    E["eForCounter"] = 0
    E["eGenTmpl"] = null
    E["eGenSym"] = ""
    E["eMangled"] = ""
    E["eExplicit"] = []
    E["eTypeParams"] = []
    E["eTypeArgs"] = []
    E["eSaveInFn"] = 0
    E["eSaveFnOps"] = []
    E["eSaveFnOpsN"] = 0
    E["eSaveFnLocals"] = []
    E["eSaveFnGlobals"] = []
    E["eGenI"] = 0
    E["eInferType"] = ""
    E["eResolveI"] = 0
    E["eRecvClass"] = ""
    E["eCtorCallee"] = null
    E["eCtorName"] = ""
    E["eMethodMangled"] = ""
    E["eMethTmpl"] = null
    E["eWhereSrc"] = null
    E["eNewClasses"] = []
    E["eNewMethods"] = []
    E["eClassIdx"] = 0
    E["eFoundMeth"] = 0
    E["eCtorArgs"] = []
}

let gE = null

pub fn emitMainInitCore(E, program) {
    E["eProgram"] = program
    object_array_clear(E, "eConsts")
    E["eConstMap"] = {}
    E["eConstN"] = 0
    object_array_clear(E, "eOps")
    E["eOpsN"] = 0
    object_array_clear(E, "eGlobals")
    E["eGlobalMap"] = {}
    E["eGlobalN"] = 0
    object_array_clear(E, "eFunctions")
    object_array_clear(E, "eFnOps")
    E["eFnOpsN"] = 0
    E["eBlockDepth"] = 0
    E["eCalleeDepth"] = 0
    E["eCallArgDepth"] = 0
    E["eObjDepth"] = 0
    E["eArrDepth"] = 0
    E["eIfDepth"] = 0
    E["eMemberDepth"] = 0
    E["eIndexDepth"] = 0
    object_array_clear(E, "eFnGlobals")
    object_array_clear(E, "eFnLocals")
    resetLocalMap(E)
    E["eInFn"] = 0
}

pub fn emitMainInitStacks(E) {
    object_array_clear(E, "eWhileHeads")
    object_array_clear(E, "eBreakIdxs")
    object_array_clear(E, "eBreakFromStack")
    object_array_clear(E, "eIterCloseStack")
    object_array_clear(E, "eIfJmpStack")
    object_array_clear(E, "eIfSkipStack")
    object_array_clear(E, "eMemberFldStack")
    object_array_clear(E, "eBlockStmtsStack")
    object_array_clear(E, "eBlockNStack")
    object_array_clear(E, "eBlockIStack")
    object_array_clear(E, "eObjIStack")
    object_array_clear(E, "eObjNStack")
    object_array_clear(E, "eArrIStack")
    object_array_clear(E, "eArrNStack")
    object_array_clear(E, "eCallArgIStack")
    object_array_clear(E, "eCallArgNStack")
    object_array_clear(E, "eArgsStack")
    object_array_clear(E, "eCalleeStack")
}

pub fn emitMainInitMeta(E) {
    object_array_clear(E, "eGenericTemplates")
    E["eTraitImpls"] = {}
    object_array_clear(E, "eGenericClassTemplates")
    object_array_clear(E, "eGenericEnumTemplates")
    object_array_clear(E, "eGenericMethodTemplates")
    object_array_clear(E, "eClasses")
    E["eClassesN"] = 0
    E["eInterfaces"] = []
    object_array_clear(E, "eEnums")
    object_array_clear(E, "eArrows")
    object_array_clear(E, "eTryRegions")
    object_array_clear(E, "eFnTryRegions")
    object_array_clear(E, "eTryEmitStack")
    object_array_clear(E, "eFinStack")
    E["eForCounter"] = 0
    object_array_clear(E, "eSpecMangled")
    object_array_clear(E, "eBindingSyms")
    object_array_clear(E, "eBindingTypes")
    object_array_clear(E, "eExports")
    E["eImports"] = []
    E["eProg"] = 0
    if E["eProgram"]["imports"] != undefined {
        E["eImports"] = E["eProgram"]["imports"]
    }
}

pub fn emitMainInit(E, program) {
    emitMainInitCore(E, program)
    emitMainInitStacks(E)
    emitMainInitMeta(E)
}

pub fn emitMain(E, program) {
    emitMainInit(E, program)
    object_array_push(E, "eBlockStmtsStack", E["eProgram"]["body"])
    arrUtil(E, "pushLenKey", "eBlockNStack", E["eProgram"]["body"])
    object_array_push(E, "eBlockIStack", 0)
    E["eBlockDepth"] = E["eBlockDepth"] + 1
    let pd = E["eBlockDepth"]
    while E["eBlockIStack"][pd - 1] < E["eBlockNStack"][pd - 1] {
        E["eBlockStmts"] = E["eBlockStmtsStack"][pd - 1]
        E["eBlockI"] = E["eBlockIStack"][pd - 1]
        E["eStmtNode"] = E["eBlockStmts"][E["eBlockI"]]
        if E["eStmtNode"] == null {
            throw "emit program null stmt at " + ("" + E["eBlockI"])
        }
        eCallStmt(E, E["eStmtNode"])
        E["eBlockIStack"][pd - 1] = E["eBlockIStack"][pd - 1] + 1
    }
    E["eBlockDepth"] = E["eBlockDepth"] - 1
    emitDisposeUsings(E, E["eProgram"]["body"])
    emitOp(E, OP_HALT, 0)
    let nops = E["eOpsN"]
    if accCount(nops) != nops {
        throw "emit op count mismatch"
    }
    return {
        "constants": E["eConsts"],
        "globals": E["eGlobals"],
        "ops": E["eOps"],
        "functions": E["eFunctions"],
        "classes": E["eClasses"],
        "interfaces": E["eInterfaces"],
        "enums": E["eEnums"],
        "arrows": E["eArrows"],
        "tryRegions": E["eTryRegions"],
        "locals": [],
        "genericMethodTemplates": E["eGenericMethodTemplates"],
        "exports": E["eExports"],
        "imports": E["eImports"]
    }
}

pub fn eTramp(E) {
    if E["_hook"] == 0 {
        return emitExprBody(E, E["_node"])
    }
    return emitStmtBody(E, E["_node"])
}

fn eTrampFn(E) {
    return eTramp(E)
}

pub fn emitMainExec(program) {
    let E = gE
    if E == null {
        E = eMakeSession()
        gE = E
        E["tramp"] = eTrampFn
    } else {
        eResetSession(E)
        E["tramp"] = eTrampFn
    }
    E["_hook"] = 0
    E["_node"] = null
    return emitMain(E, program)
}

pub let emitMainFromExec = emitMainExec
