// Full self-hosted pipeline: source text -> kabootar-bytecode/1 text.
import "self_host/parse"
import "self_host/emit"
import "self_host/serialize"
import "self_host/ownership"

/// True when source opts into affine ownership (@manual).
fn sourceIsManual(source) {
    let s = "" + source
    if str_includes(s, "@manual") {
        return true
    }
    return false
}

/// H6e: product preprocess in Kab — strip `comptime {` so the parser never needs the Rust preprocessor.
fn preprocess(source) {
    let s = "" + source
    s = replace_all(s, "@pure\n", "")
    s = replace_all(s, "@io\n", "")
    s = replace_all(s, "@gc\n", "")
    s = replace_all(s, "@manual\n", "")
    s = replace_all(s, "comptime {", "{")
    return s
}

pub fn compile(source) {
    // O5 product wire: Kab ownership checker on @manual modules only.
    if sourceIsManual(source) {
        let err = checkOwnership(source)
        if err != null {
            throw err
        }
    }
    let t0 = date_now_ms()
    let ast = parse(preprocess(source))
    let t1 = date_now_ms()
    let ir = emit(ast)
    let t2 = date_now_ms()
    let kbc = serialize_bc(ir)
    let t3 = date_now_ms()
    if env_get("KABOOTAR_P10_PROFILE") == "1" {
        println("PROFILE self_host parse_ms " + ("" + (t1 - t0)))
        println("PROFILE self_host emit_ms " + ("" + (t2 - t1)))
        println("PROFILE self_host serialize_ms " + ("" + (t3 - t2)))
        println("PROFILE self_host total_ms " + ("" + (t3 - t0)))
        println("PROFILE self_host kbc_len " + ("" + len(kbc)))
    }
    return kbc
}

/// IR module for Kab VM (`runModule` in self_host/vm).
pub fn compileIr(source) {
    if sourceIsManual(source) {
        let err = checkOwnership(source)
        if err != null {
            throw err
        }
    }
    return emit(parse(preprocess(source)))
}
