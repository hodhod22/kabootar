// Full self-hosted pipeline: source text -> kabootar-bytecode/1 text.
import "self_host/lexer_scan"
import "self_host/parser_exec"
import "self_host/emit_exec"
import "self_host/serialize_sections"
import "self_host/ownership"

// SH3a: len(expr) → get_length (bust compiler-image fingerprint when emit_expr_body changes).

let gMsParse = 0
let gMsEmit = 0
let gMsSer = 0
let gMsTotal = 0

/// FT F0: last `compile()` phase times (ms). kind 1=parse 2=emit 3=serialize else total.
pub fn lastCompileMs(kind) {
    if kind == 1 {
        return gMsParse
    }
    if kind == 2 {
        return gMsEmit
    }
    if kind == 3 {
        return gMsSer
    }
    return gMsTotal
}

/// True when the file head opts into affine ownership (@manual).
fn sourceIsManual(source) {
    let s = "" + source
    let n = len(s)
    if n > 512 {
        s = str_slice(s, 0, 512)
    }
    if str_includes(s, "@manual") {
        return true
    }
    return false
}

/// H6e: product preprocess in Kab — Comptime 3.0 folds `comptime { … }` to literals before parse.
fn preprocess(source) {
    let s = "" + source
    s = replace_all(s, "@pure\n", "")
    s = replace_all(s, "@io\n", "")
    s = replace_all(s, "@gc\n", "")
    s = replace_all(s, "@manual\n", "")
    s = comptime_fold(s)
    return s
}

fn sourceTooBig(source) {
    return len("" + source) > 65536
}

fn sourceEmpty(source) {
    return len("" + source) == 0
}

fn sourceLooksLikeKbc(source) {
    return str_index_of("" + source, "kabootar-bytecode/1") == 0
}

fn parseSource(source) {
    return parseTokensExec(tokenizeExec(source))
}

fn guardAndPreprocess(source) {
    if sourceEmpty(source) {
        throw "SH16: empty source"
    }
    if sourceLooksLikeKbc(source) {
        throw "SH16: refusing to compile bytecode as source"
    }
    if sourceTooBig(source) {
        throw "SH16: source exceeds bootPolicy maxBytes; split the module"
    }
    if sourceIsManual(source) {
        let err = checkOwnership(source)
        if err != null {
            throw err
        }
    }
    return preprocess(source)
}

pub fn compile(source) {
    let src = guardAndPreprocess(source)
    let t0 = date_now_ms()
    let ast = parseSource(src)
    let t1 = date_now_ms()
    let ir = emitMainExec(ast)
    let t2 = date_now_ms()
    let kbc = serSerializeBc(ir)
    let t3 = date_now_ms()
    gMsParse = t1 - t0
    gMsEmit = t2 - t1
    gMsSer = t3 - t2
    gMsTotal = t3 - t0
    if env_get("KABOOTAR_P10_PROFILE") == "1" {
        println("PROFILE self_host parse_ms " + ("" + (t1 - t0)))
        println("PROFILE self_host emit_ms " + ("" + (t2 - t1)))
        println("PROFILE self_host serialize_ms " + ("" + (t3 - t2)))
        println("PROFILE self_host total_ms " + ("" + (t3 - t0)))
        println("PROFILE self_host kbc_len " + ("" + len(kbc)))
    }
    return kbc
}

/// IR module for Kab VM (`runModule` in self_host/vm).
pub fn compileIr(source) {
    let src = guardAndPreprocess(source)
    let t0 = date_now_ms()
    let ast = parseSource(src)
    let t1 = date_now_ms()
    let ir = emitMainExec(ast)
    let t2 = date_now_ms()
    gMsParse = t1 - t0
    gMsEmit = t2 - t1
    gMsSer = 0
    gMsTotal = t2 - t0
    return ir
}
