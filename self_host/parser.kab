// Self-hosted Kabootar parser - subset mirroring src/parser.rs.
// Session cursors (pPos, pToks, …) stay module-global; recursion temps use fn-locals (L1/S1).
import "self_host/lexer_defs"
import "self_host/ast_defs"

let pPos = 0
let pToks = []
let pLeft = null
let pRight = null
let pArgs = []
let pTok = null
let pIdent = null
let pInit = null
let pVal = null
let pBody = []
let pBodyStack = []
let pStmts = []
let pParams = []
let pCond = null
let pCondStack = []
let pThen = null
let pElse = null
let pLoopBody = []
let pCallee = null
let pObjFields = []
let pSave = null
let pBinOp = ""
let pSaveSym = ""
let pBindSym = ""
let pExprLeft = null
let pFnSym = ""
let pFnPub = 0
let pIsPub = 0
let pLetSym = ""
let pSymPool = []
let pSymN = 0
let pImports = []
let pPopI = 0
let pPopNew = []
let pSymOut = ""
let pSymSrc = ""
let pSymI = 0
let pInAddSub = 0
let pAddLeft = null
let pAddLeftStack = []
let pNextTok = null
let pDone = 0
let pTypeParams = []
let pParamTypes = []
let pReturnType = ""
let pTypeArgs = []
let pVariants = []
let pClassFields = []
let pClassMethods = []
let pFieldType = ""
let pFieldDefault = null
let pVariantFields = []
let pMethTypeParams = []
let pMethParams = []
let pMethParamTypes = []
let pIsGenericCallee = 0
let pAngleI = 0
let pAngleTok = null
let pAngleOut = []
let pMemberName = ""
let pVariantName = ""
let pVariantSym = ""
let pEnumSym = ""
let pClassSym = ""
let pIsStruct = 0
let pIfaceSym = ""
let pIfaceMethods = []
let pWhereClause = []
let pWhereParam = ""
let pWhereTrait = ""
let pSnapTypeArgs = []
let pParamType = ""

fn popStack(stack) {
    pPopNew = []
    pPopI = 0
    while pPopI < len(stack) - 1 {
        pPopNew = push(pPopNew, stack[pPopI])
        pPopI = pPopI + 1
    }
    return pPopNew
}

fn symCopy(name) {
    pSymOut = ""
    pSymSrc = "" + name
    pSymI = 0
    while pSymI < len(pSymSrc) {
        pSymOut = pSymOut + char_at(pSymSrc, pSymI)
        pSymI = pSymI + 1
    }
    return pSymOut
}

fn peek() {
    if pPos >= len(pToks) {
        return { "type": "EOF", "value": null, "line": 1, "column": 1 }
    }
    return pToks[pPos]
}

fn bump() {
    pTok = peek()
    if pPos < len(pToks) {
        pPos = pPos + 1
    }
    return pTok
}

fn parseTypeArgs() {
    if peek().type != "<" {
        return []
    }
    pAngleI = pPos + 1
    if pAngleI >= len(pToks) {
        return []
    }
    pAngleTok = pToks[pAngleI]
    if pAngleTok.type != TOKEN_IDENT {
        return []
    }
    pAngleI = pAngleI + 1
    while pAngleI < len(pToks) {
        pAngleTok = pToks[pAngleI]
        if pAngleTok.type == ">" {
            break
        }
        if pAngleTok.type == "<" {
            return []
        }
        if pAngleTok.type == "," {
            pAngleI = pAngleI + 1
        } else {
            if pAngleTok.type == TOKEN_IDENT {
                pAngleI = pAngleI + 1
            } else {
                return []
            }
        }
    }
    if pAngleI >= len(pToks) {
        return []
    }
    if pToks[pAngleI].type != ">" {
        return []
    }
    bump()
    pAngleOut = []
    while peek().type != ">" {
        pTok = peek()
        if pTok.type != TOKEN_IDENT {
            throw "Expected type name"
        }
        bump()
        pSymPool = push(pSymPool, symCopy(pTok.value))
        pAngleOut = push(pAngleOut, pSymPool[len(pSymPool) - 1])
        if peek().type == "," {
            bump()
        }
    }
    if peek().type != ">" {
        throw "Expected >"
    }
    bump()
    return pAngleOut
}

fn parsePostfix() {
    if peek().type == "EOF" {
        throw "parsePostfix EOF"
    }
    pLeft = null
    pTypeArgs = []
    pTok = peek()
    if pTok.type == TOKEN_NUMBER {
        bump()
        pLeft = { "kind": AST_LITERAL, "lit": LIT_NUMBER, "value": pTok.value }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_STRING {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_STRING, "value": pTok.value }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_TRUE {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_BOOL, "value": true }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_FALSE {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_BOOL, "value": false }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_NULL {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_NULL, "value": null }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_UNDEFINED {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_UNDEF, "value": undefined }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_IDENT {
            bump()
            pSymPool = push(pSymPool, symCopy(pTok.value))
            pLeft = { "kind": AST_VAR, "sym": pSymPool[len(pSymPool) - 1] }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_SELF {
            bump()
            pLeft = { "kind": AST_VAR, "sym": "self" }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_THIS {
            bump()
            pLeft = { "kind": AST_VAR, "sym": "this" }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == "(" {
            bump()
            pLeft = parseCompare()
            if peek().type != ")" {
                throw "Expected )"
            }
            bump()
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == "{" {
            bump()
            pObjFields = []
            while peek().type != "}" {
                pTok = peek()
                if pTok.type == TOKEN_IDENT {
                    bump()
                    pSymPool = push(pSymPool, symCopy(pTok.value))
                    pSaveSym = pSymPool[len(pSymPool) - 1]
                } else {
                    if pTok.type == TOKEN_STRING {
                        bump()
                        pSymPool = push(pSymPool, symCopy(pTok.value))
                        pSaveSym = pSymPool[len(pSymPool) - 1]
                    } else {
                        throw "Expected object key"
                    }
                }
                if peek().type != ":" {
                    throw "Expected :"
                }
                bump()
                pVal = parseCompare()
                pObjFields = push(pObjFields, { "key": pSaveSym, "value": pVal })
                if peek().type == "," {
                    bump()
                }
            }
            bump()
            pLeft = { "kind": AST_OBJECT, "fields": pObjFields }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == "[" {
            bump()
            pArgs = []
            while peek().type != "]" {
                pArgs = push(pArgs, parseCompare())
                if peek().type == "," {
                    bump()
                }
            }
            bump()
            pLeft = { "kind": AST_ARRAY, "elems": pArgs }
        }
    }
    if pLeft == null {
        throw json_stringify(peek())
    }
    while true {
        if peek().type == "<" {
            pIsGenericCallee = 0
            if pLeft.kind == AST_VAR {
                pIsGenericCallee = 1
            }
            if pLeft.kind == AST_MEMBER {
                pIsGenericCallee = 1
            }
            if pIsGenericCallee == 1 {
                pSnapTypeArgs = parseTypeArgs()
                if len(pSnapTypeArgs) > 0 {
                    pTypeArgs = pSnapTypeArgs
                } else {
                    break
                }
            } else {
                break
            }
        } else {
            if peek().type == "(" {
                pCallee = pLeft
                if pCallee.kind == AST_VAR {
                    pCallee = { "kind": AST_VAR, "sym": symCopy(pCallee["sym"]) }
                }
                let savedCallee = pCallee
                let savedTypeArgs = pTypeArgs
                bump()
                pArgs = []
                if peek().type != ")" {
                    while true {
                        pArgs = push(pArgs, parseCompare())
                        if peek().type == "," {
                            bump()
                        } else {
                            break
                        }
                    }
                }
                if peek().type != ")" {
                    throw "Expected )"
                }
                bump()
                pLeft = { "kind": AST_CALL, "callee": savedCallee, "args": pArgs, "typeArgs": savedTypeArgs }
                pTypeArgs = []
            } else {
                if peek().type == "." {
                    bump()
                    pTok = peek()
                    pMemberName = ""
                    if pTok.type == TOKEN_IDENT {
                        bump()
                        pMemberName = symCopy(pTok.value)
                    } else {
                        if pTok.type == TOKEN_NONE {
                            bump()
                            pMemberName = "None"
                        } else {
                            if pTok.type == TOKEN_SOME {
                                bump()
                                pMemberName = "Some"
                            } else {
                                if pTok.type == TOKEN_OK {
                                    bump()
                                    pMemberName = "Ok"
                                } else {
                                    if pTok.type == TOKEN_ERR {
                                        bump()
                                        pMemberName = "Err"
                                    } else {
                                        throw "Expected member name"
                                    }
                                }
                            }
                        }
                    }
                    pSymPool = push(pSymPool, pMemberName)
                    pLeft = {
                        "kind": AST_MEMBER,
                        "object": pLeft,
                        "field": pSymPool[len(pSymPool) - 1],
                        "typeArgs": pTypeArgs
                    }
                    pTypeArgs = []
                } else {
                    if peek().type == "[" {
                        bump()
                        let indexObj = pLeft
                        pRight = parseCompare()
                        if peek().type != "]" {
                            throw "Expected ]"
                        }
                        bump()
                        pLeft = { "kind": AST_INDEX, "object": indexObj, "index": pRight }
                    } else {
                        break
                    }
                }
            }
        }
    }
    return pLeft
}

fn parseCompare() {
    if peek().type == "EOF" {
        throw "parseCompare EOF"
    }
    pLeft = parsePostfix()
    while peek().type == "+" {
        bump()
        pAddLeftStack = push(pAddLeftStack, pLeft)
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pAddLeft = pAddLeftStack[len(pAddLeftStack) - 1]
        pLeft = { "kind": AST_BINARY, "op": "+", "left": pAddLeft, "right": pRight }
        pAddLeftStack = popStack(pAddLeftStack)
    }
    while peek().type == "-" {
        bump()
        pAddLeftStack = push(pAddLeftStack, pLeft)
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pAddLeft = pAddLeftStack[len(pAddLeftStack) - 1]
        pLeft = { "kind": AST_BINARY, "op": "-", "left": pAddLeft, "right": pRight }
        pAddLeftStack = popStack(pAddLeftStack)
    }
    if pInAddSub == 1 {
        return pLeft
    }
    while peek().type == "==" {
        pBinOp = peek().type
        bump()
        pSave = pLeft
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    while peek().type == "!=" {
        pBinOp = peek().type
        bump()
        pSave = pLeft
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    while peek().type == "<" {
        pBinOp = peek().type
        bump()
        pSave = pLeft
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    while peek().type == ">" {
        pBinOp = peek().type
        bump()
        pSave = pLeft
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    while peek().type == ">=" {
        pBinOp = peek().type
        bump()
        pSave = pLeft
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    while peek().type == "<=" {
        pBinOp = peek().type
        bump()
        pSave = pLeft
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    while peek().type == "&&" {
        bump()
        pExprLeft = pLeft
        pRight = parseCompare()
        pLeft = { "kind": AST_BINARY, "op": "&&", "left": pExprLeft, "right": pRight }
    }
    return pLeft
}

fn parseStmt() {
    if peek().type == "EOF" {
        return null
    }
    if peek().type == TOKEN_LET {
        bump()
        pTok = peek()
        if pTok.type != TOKEN_IDENT {
            throw "Expected identifier after let"
        }
        pLetSym = symCopy(pTok.value)
        bump()
        pSymPool = push(pSymPool, pLetSym)
        pBindSym = pSymPool[len(pSymPool) - 1]
        if peek().type != "=" {
            throw "Expected ="
        }
        bump()
        pInit = parseCompare()
        return { "kind": AST_LET, "sym": pBindSym, "init": pInit }
    }
    pIsPub = 0
    if peek().type == TOKEN_PUB {
        bump()
        pIsPub = 1
    }
    if peek().type == TOKEN_ENUM {
        bump()
        pTok = peek()
        if pTok.type != TOKEN_IDENT {
            throw "Expected enum name"
        }
        bump()
        pEnumSym = symCopy(pTok.value)
        pTypeParams = parseTypeArgs()
        if peek().type != "{" {
            throw "Expected {"
        }
        bump()
        pVariants = []
        while peek().type != "}" {
            if peek().type == "," {
                bump()
            } else {
                pTok = peek()
                pVariantName = ""
                if pTok.type == TOKEN_IDENT {
                    bump()
                    pVariantName = symCopy(pTok.value)
                } else {
                    if pTok.type == TOKEN_NONE {
                        bump()
                        pVariantName = "None"
                    } else {
                        if pTok.type == TOKEN_SOME {
                            bump()
                            pVariantName = "Some"
                        } else {
                            if pTok.type == TOKEN_OK {
                                bump()
                                pVariantName = "Ok"
                            } else {
                                if pTok.type == TOKEN_ERR {
                                    bump()
                                    pVariantName = "Err"
                                } else {
                                    if pTok.type == TOKEN_TRUE {
                                        bump()
                                        pVariantName = "True"
                                    } else {
                                        if pTok.type == TOKEN_FALSE {
                                            bump()
                                            pVariantName = "False"
                                        } else {
                                            throw "Expected variant name"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                pSymPool = push(pSymPool, pVariantName)
                pVariantSym = pSymPool[len(pSymPool) - 1]
                pVariantFields = []
                if peek().type == "(" {
                    bump()
                    while peek().type != ")" {
                        pTok = peek()
                        if pTok.type != TOKEN_IDENT {
                            throw "Expected variant field type"
                        }
                        bump()
                        pSymPool = push(pSymPool, symCopy(pTok.value))
                        pVariantFields = push(pVariantFields, pSymPool[len(pSymPool) - 1])
                        if peek().type == "," {
                            bump()
                        }
                    }
                    bump()
                }
                pVariants = push(pVariants, {
                    "name": pVariantSym,
                    "fields": pVariantFields
                })
                if peek().type == "," {
                    bump()
                }
            }
        }
        bump()
        return { "kind": AST_ENUM, "sym": pEnumSym, "typeParams": pTypeParams, "variants": pVariants }
    }
    if peek().type == TOKEN_CLASS || peek().type == TOKEN_STRUCT {
        pIsStruct = 0
        if peek().type == TOKEN_STRUCT {
            pIsStruct = 1
        }
        bump()
        pTok = peek()
        if pTok.type != TOKEN_IDENT {
            if pIsStruct == 1 {
                throw "Expected struct name"
            }
            throw "Expected class name"
        }
        bump()
        pClassSym = symCopy(pTok.value)
        pTypeParams = parseTypeArgs()
        if peek().type != "{" {
            throw "Expected {"
        }
        bump()
        pClassFields = []
        pClassMethods = []
        while peek().type != "}" {
            if peek().type == TOKEN_FN {
                bump()
                pTok = peek()
                if pTok.type != TOKEN_IDENT {
                    throw "Expected method name"
                }
                bump()
                pFnSym = symCopy(pTok.value)
                pMethTypeParams = parseTypeArgs()
                if peek().type != "(" {
                    throw "Expected ("
                }
                bump()
                pMethParams = []
                pMethParamTypes = []
                if peek().type != ")" {
                    while true {
                        pTok = peek()
                        if pTok.type == TOKEN_SELF {
                            bump()
                            pSymPool = push(pSymPool, "self")
                            pMethParams = push(pMethParams, pSymPool[len(pSymPool) - 1])
                            pMethParamTypes = push(pMethParamTypes, "")
                        } else {
                            if pTok.type != TOKEN_IDENT {
                                throw "Expected parameter name"
                            }
                            bump()
                            pSymPool = push(pSymPool, symCopy(pTok.value))
                            pMethParams = push(pMethParams, pSymPool[len(pSymPool) - 1])
                            pParamType = ""
                            if peek().type == ":" {
                                bump()
                                pTok = peek()
                                if pTok.type != TOKEN_IDENT {
                                    throw "Expected parameter type"
                                }
                                bump()
                                pParamType = symCopy(pTok.value)
                            }
                            pMethParamTypes = push(pMethParamTypes, pParamType)
                        }
                        if peek().type == "," {
                            bump()
                        } else {
                            break
                        }
                    }
                }
                if peek().type != ")" {
                    throw "Expected )"
                }
                bump()
                if peek().type != "{" {
                    throw "Expected {"
                }
                bump()
                pBodyStack = push(pBodyStack, pBody)
                pBody = []
                while peek().type != "}" {
                    if peek().type == "EOF" {
                        throw "Unclosed block"
                    }
                    pBody = push(pBody, parseStmt())
                    if peek().type == ";" {
                        bump()
                    }
                }
                bump()
                let methBody = pBody
                pBody = pBodyStack[len(pBodyStack) - 1]
                pBodyStack = popStack(pBodyStack)
                pVal = {
                    "sym": pFnSym,
                    "typeParams": pMethTypeParams,
                    "params": pMethParams,
                    "paramTypes": pMethParamTypes,
                    "returnType": "",
                    "body": { "kind": AST_BLOCK, "body": methBody }
                }
                pClassMethods = push(pClassMethods, pVal)
            } else {
                pTok = peek()
                if pTok.type != TOKEN_IDENT {
                    throw "Expected field name"
                }
                bump()
                pSaveSym = symCopy(pTok.value)
                pSymPool = push(pSymPool, pSaveSym)
                pFieldType = ""
                if peek().type == ":" {
                    bump()
                    pTok = peek()
                    if pTok.type != TOKEN_IDENT {
                        throw "Expected field type"
                    }
                    bump()
                    pFieldType = symCopy(pTok.value)
                }
                pFieldDefault = null
                if peek().type == "=" {
                    bump()
                    pFieldDefault = parseCompare()
                }
                if peek().type == ";" {
                    bump()
                }
                pVal = { "name": pSymPool[len(pSymPool) - 1], "type": pFieldType, "default": pFieldDefault }
                pClassFields = push(pClassFields, pVal)
            }
        }
        bump()
        return {
            "kind": AST_CLASS,
            "sym": pClassSym,
            "typeParams": pTypeParams,
            "fields": pClassFields,
            "methods": pClassMethods,
            "isStruct": pIsStruct
        }
    }
    if peek().type == TOKEN_INTERFACE || peek().type == TOKEN_TRAIT {
        bump()
        pTok = peek()
        if pTok.type != TOKEN_IDENT {
            throw "Expected interface/trait name"
        }
        bump()
        pIfaceSym = symCopy(pTok.value)
        pTypeParams = parseTypeArgs()
        if peek().type != "{" {
            throw "Expected {"
        }
        bump()
        pIfaceMethods = []
        while peek().type != "}" {
            if peek().type != TOKEN_FN {
                throw "Expected fn in interface"
            }
            bump()
            pTok = peek()
            if pTok.type != TOKEN_IDENT {
                throw "Expected method name"
            }
            bump()
            pFnSym = symCopy(pTok.value)
            if peek().type != "(" {
                throw "Expected ("
            }
            bump()
            pMethParams = []
            if peek().type != ")" {
                while true {
                    pTok = peek()
                    if pTok.type != TOKEN_IDENT {
                        throw "Expected parameter name"
                    }
                    bump()
                    pSymPool = push(pSymPool, symCopy(pTok.value))
                    pMethParams = push(pMethParams, pSymPool[len(pSymPool) - 1])
                    if peek().type == "," {
                        bump()
                    } else {
                        break
                    }
                }
            }
            if peek().type != ")" {
                throw "Expected )"
            }
            bump()
            if peek().type != ";" {
                throw "Expected ;"
            }
            bump()
            pIfaceMethods = push(pIfaceMethods, { "sym": pFnSym, "params": pMethParams })
        }
        bump()
        return {
            "kind": AST_INTERFACE,
            "sym": pIfaceSym,
            "typeParams": pTypeParams,
            "methods": pIfaceMethods
        }
    }
    if peek().type == TOKEN_FN {
        bump()
        pTok = peek()
        if pTok.type != TOKEN_IDENT {
            throw "Expected function name"
        }
        bump()
        pFnSym = symCopy(pTok.value)
        pFnPub = pIsPub
        pTypeParams = parseTypeArgs()
        if peek().type != "(" {
            throw "Expected ("
        }
        bump()
        pParams = []
        pParamTypes = []
        if peek().type != ")" {
            while true {
                pTok = peek()
                if pTok.type != TOKEN_IDENT {
                    throw "Expected parameter name"
                }
                bump()
                pSymPool = push(pSymPool, symCopy(pTok.value))
                pParams = push(pParams, pSymPool[len(pSymPool) - 1])
                pParamType = ""
                if peek().type == ":" {
                    bump()
                    pTok = peek()
                    if pTok.type != TOKEN_IDENT {
                        throw "Expected parameter type"
                    }
                    bump()
                    pParamType = symCopy(pTok.value)
                }
                pParamTypes = push(pParamTypes, pParamType)
                if peek().type == "," {
                    bump()
                } else {
                    break
                }
            }
        }
        if peek().type != ")" {
            throw "Expected )"
        }
        bump()
        pReturnType = ""
        if peek().type == "->" {
            bump()
            pTok = peek()
            if pTok.type != TOKEN_IDENT {
                throw "Expected return type"
            }
            bump()
            pReturnType = symCopy(pTok.value)
        }
        pWhereClause = []
        if peek().type == TOKEN_WHERE {
            bump()
            while true {
                pTok = peek()
                if pTok.type != TOKEN_IDENT {
                    throw "Expected type parameter in where"
                }
                bump()
                pWhereParam = symCopy(pTok.value)
                if peek().type != ":" {
                    throw "Expected : in where"
                }
                bump()
                pTok = peek()
                if pTok.type != TOKEN_IDENT {
                    throw "Expected trait name in where"
                }
                bump()
                pWhereTrait = symCopy(pTok.value)
                pWhereClause = push(pWhereClause, {
                    "typeParam": pWhereParam,
                    "traitName": pWhereTrait
                })
                if peek().type == "," {
                    bump()
                } else {
                    break
                }
            }
        }
        if peek().type != "{" {
            throw "Expected {"
        }
        bump()
        pBodyStack = push(pBodyStack, pBody)
        pBody = []
        while peek().type != "}" {
            if peek().type == "EOF" {
                throw "Unclosed block"
            }
            pBody = push(pBody, parseStmt())
            if peek().type == ";" {
                bump()
            }
        }
        bump()
        let fnBody = pBody
        pBody = pBodyStack[len(pBodyStack) - 1]
        pBodyStack = popStack(pBodyStack)
        return {
            "kind": AST_FN,
            "sym": pFnSym,
            "isPub": pFnPub,
            "typeParams": pTypeParams,
            "params": pParams,
            "paramTypes": pParamTypes,
            "returnType": pReturnType,
            "whereClause": pWhereClause,
            "body": { "kind": AST_BLOCK, "body": fnBody }
        }
    }
    if peek().type == TOKEN_IF {
        bump()
        pCond = parseCompare()
        pCondStack = push(pCondStack, pCond)
        if peek().type != "{" {
            throw "Expected {"
        }
        bump()
        pBodyStack = push(pBodyStack, pBody)
        pBody = []
        while peek().type != "}" {
            pBody = push(pBody, parseStmt())
            if peek().type == ";" {
                bump()
            }
        }
        bump()
        pThen = { "kind": AST_BLOCK, "body": pBody }
        pBody = pBodyStack[len(pBodyStack) - 1]
        pBodyStack = popStack(pBodyStack)
        pElse = null
        if peek().type == TOKEN_ELSE {
            bump()
            if peek().type != "{" {
                throw "Expected {"
            }
            bump()
            pBodyStack = push(pBodyStack, pBody)
            pBody = []
            while peek().type != "}" {
                pBody = push(pBody, parseStmt())
                if peek().type == ";" {
                    bump()
                }
            }
            bump()
            pElse = { "kind": AST_BLOCK, "body": pBody }
            pBody = pBodyStack[len(pBodyStack) - 1]
            pBodyStack = popStack(pBodyStack)
        }
        pSave = pCondStack[len(pCondStack) - 1]
        pCondStack = popStack(pCondStack)
        return { "kind": AST_IF, "cond": pSave, "then": pThen, "elseBranch": pElse }
    }
    if peek().type == TOKEN_WHILE {
        bump()
        pCond = parseCompare()
        pCondStack = push(pCondStack, pCond)
        if peek().type != "{" {
            throw "Expected {"
        }
        bump()
        pBodyStack = push(pBodyStack, pLoopBody)
        pLoopBody = []
        while peek().type != "}" {
            pLoopBody = push(pLoopBody, parseStmt())
            if peek().type == ";" {
                bump()
            }
        }
        bump()
        let whileBody = pLoopBody
        pLoopBody = pBodyStack[len(pBodyStack) - 1]
        pBodyStack = popStack(pBodyStack)
        pSave = pCondStack[len(pCondStack) - 1]
        pCondStack = popStack(pCondStack)
        return { "kind": AST_WHILE, "cond": pSave, "body": { "kind": AST_BLOCK, "body": whileBody } }
    }
    if peek().type == TOKEN_CONTINUE {
        bump()
        return { "kind": AST_CONTINUE }
    }
    if peek().type == TOKEN_BREAK {
        bump()
        return { "kind": AST_BREAK }
    }
    if peek().type == TOKEN_THROW {
        bump()
        pVal = parseCompare()
        return { "kind": AST_THROW, "expr": pVal }
    }
    if peek().type == TOKEN_RETURN {
        bump()
        if peek().type == ";" {
            return { "kind": AST_RETURN, "value": null }
        }
        if peek().type == "}" {
            return { "kind": AST_RETURN, "value": null }
        }
        if peek().type == "EOF" {
            return { "kind": AST_RETURN, "value": null }
        }
        pVal = parseCompare()
        return { "kind": AST_RETURN, "value": pVal }
    }
    if peek().type == "{" {
        bump()
        pBodyStack = push(pBodyStack, pStmts)
        pStmts = []
        while peek().type != "}" {
            if peek().type == "EOF" {
                throw "Unclosed block"
            }
            pStmts = push(pStmts, parseStmt())
            if peek().type == ";" {
                bump()
            }
        }
        bump()
        let blockStmts = pStmts
        pStmts = pBodyStack[len(pBodyStack) - 1]
        pBodyStack = popStack(pBodyStack)
        return { "kind": AST_BLOCK, "body": blockStmts }
    }
    if peek().type == TOKEN_IDENT {
        if pPos + 1 < len(pToks) {
            pNextTok = pToks[pPos + 1]
        } else {
            pNextTok = { "type": "EOF", "value": null, "line": 1, "column": 1 }
        }
        if pNextTok.type == "=" {
            pTok = peek()
            pSymPool = push(pSymPool, symCopy(pTok.value))
            pBindSym = pSymPool[len(pSymPool) - 1]
            bump()
            bump()
            pVal = parseCompare()
            return { "kind": AST_ASSIGN, "sym": pBindSym, "rhs": pVal }
        }
    }
    pSave = parseCompare()
    if peek().type == "=" {
        bump()
        pInit = parseCompare()
        if pSave.kind == AST_VAR {
            return { "kind": AST_ASSIGN, "sym": pSave["sym"], "rhs": pInit }
        }
        if pSave.kind == AST_INDEX {
            return { "kind": AST_INDEX_ASSIGN, "object": pSave["object"], "index": pSave["index"], "rhs": pInit }
        }
        throw "invalid assign lhs"
    }
    pVal = pSave
    return { "kind": AST_EXPR, "expr": pVal }
}

pub fn parseTokens(tokens) {
    pToks = tokens
    pPos = 0
    pSymPool = []
    pImports = []
    pCondStack = []
    pAddLeftStack = []
    pBodyStack = push(pBodyStack, pBody)
    pBody = []
    pDone = 0
    while pDone == 0 {
        if pPos >= len(pToks) {
            pDone = 1
        }
        if pDone == 0 {
            pTok = peek()
            if pTok.type == "EOF" {
                pDone = 1
            }
        }
        if pDone == 0 {
            if pTok.type == TOKEN_IMPORT {
                bump()
                pTok = peek()
                if pTok.type == TOKEN_STRING {
                    bump()
                    pImports = push(pImports, symCopy(pTok.value))
                }
                if peek().type == ";" {
                    bump()
                }
            } else {
                pVal = parseStmt()
                if pVal != null {
                    pBody = push(pBody, pVal)
                }
            }
            if peek().type == ";" {
                bump()
            }
        }
    }
    let programBody = pBody
    pBody = pBodyStack[len(pBodyStack) - 1]
    pBodyStack = popStack(pBodyStack)
    return { "kind": AST_PROGRAM, "body": programBody, "imports": pImports }
}
