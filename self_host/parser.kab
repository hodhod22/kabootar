// Self-hosted Kabootar parser - subset mirroring src/parser.rs.
// Parser scratch slots are module-level: Kabootar fn locals are not re-entrant.
import "self_host/lexer_defs"
import "self_host/ast_defs"

let pPos = 0
let pToks = []
let pLeft = null
let pRight = null
let pArgs = []
let pTok = null
let pIdent = null
let pInit = null
let pVal = null
let pBody = []
let pBodyStack = []
let pStmts = []
let pParams = []
let pCond = null
let pCondStack = []
let pThen = null
let pElse = null
let pLoopBody = []
let pCallee = null
let pObjFields = []
let pSave = null
let pBinOp = ""
let pSaveSym = ""
let pBindSym = ""
let pExprLeft = null
let pIndexObj = null
let pFnSym = ""
let pFnPub = 0
let pIsPub = 0
let pLetSym = ""
let pSymPool = []
let pSymN = 0
let pImports = []
let pPopI = 0
let pPopNew = []
let pSymOut = ""
let pSymSrc = ""
let pSymI = 0
let pInAddSub = 0
let pAddLeft = null
let pAddLeftStack = []
let pNextTok = null
let pDone = 0

fn popStack(stack) {
    pPopNew = []
    pPopI = 0
    while pPopI < len(stack) - 1 {
        pPopNew = push(pPopNew, stack[pPopI])
        pPopI = pPopI + 1
    }
    return pPopNew
}

fn symCopy(name) {
    pSymOut = ""
    pSymSrc = "" + name
    pSymI = 0
    while pSymI < len(pSymSrc) {
        pSymOut = pSymOut + char_at(pSymSrc, pSymI)
        pSymI = pSymI + 1
    }
    return pSymOut
}

fn peek() {
    if pPos >= len(pToks) {
        return { "type": "EOF", "value": null, "line": 1, "column": 1 }
    }
    return pToks[pPos]
}

fn bump() {
    pTok = peek()
    if pPos < len(pToks) {
        pPos = pPos + 1
    }
    return pTok
}

fn parsePostfix() {
    if peek().type == "EOF" {
        throw "parsePostfix EOF"
    }
    pLeft = null
    pTok = peek()
    if pTok.type == TOKEN_NUMBER {
        bump()
        pLeft = { "kind": AST_LITERAL, "lit": LIT_NUMBER, "value": pTok.value }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_STRING {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_STRING, "value": pTok.value }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_TRUE {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_BOOL, "value": true }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_FALSE {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_BOOL, "value": false }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_NULL {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_NULL, "value": null }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_UNDEFINED {
            bump()
            pLeft = { "kind": AST_LITERAL, "lit": LIT_UNDEF, "value": undefined }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == TOKEN_IDENT {
            bump()
            pSymPool = push(pSymPool, symCopy(pTok.value))
            pLeft = { "kind": AST_VAR, "sym": pSymPool[len(pSymPool) - 1] }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == "(" {
            bump()
            pLeft = parseCompare()
            if peek().type != ")" {
                throw "Expected )"
            }
            bump()
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == "{" {
            bump()
            pObjFields = []
            while peek().type != "}" {
                pTok = peek()
                if pTok.type == TOKEN_IDENT {
                    bump()
                    pSymPool = push(pSymPool, symCopy(pTok.value))
                    pSaveSym = pSymPool[len(pSymPool) - 1]
                } else {
                    if pTok.type == TOKEN_STRING {
                        bump()
                        pSymPool = push(pSymPool, symCopy(pTok.value))
                        pSaveSym = pSymPool[len(pSymPool) - 1]
                    } else {
                        throw "Expected object key"
                    }
                }
                if peek().type != ":" {
                    throw "Expected :"
                }
                bump()
                pVal = parseCompare()
                pObjFields = push(pObjFields, { "key": pSaveSym, "value": pVal })
                if peek().type == "," {
                    bump()
                }
            }
            bump()
            pLeft = { "kind": AST_OBJECT, "fields": pObjFields }
        }
    }
    if pLeft == null {
        pTok = peek()
        if pTok.type == "[" {
            bump()
            pArgs = []
            while peek().type != "]" {
                pArgs = push(pArgs, parseCompare())
                if peek().type == "," {
                    bump()
                }
            }
            bump()
            pLeft = { "kind": AST_ARRAY, "elems": pArgs }
        }
    }
    if pLeft == null {
        throw json_stringify(peek())
    }
    while true {
        if peek().type == "(" {
            pCallee = pLeft
            bump()
            pArgs = []
            if peek().type != ")" {
                while true {
                    pArgs = push(pArgs, parseCompare())
                    if peek().type == "," {
                        bump()
                    } else {
                        break
                    }
                }
            }
            if peek().type != ")" {
                throw "Expected )"
            }
            bump()
            pLeft = { "kind": AST_CALL, "callee": pCallee, "args": pArgs }
        } else {
            if peek().type == "." {
                bump()
                pTok = peek()
                if pTok.type != TOKEN_IDENT {
                    throw "Expected field name"
                }
                bump()
                pSymPool = push(pSymPool, symCopy(pTok.value))
                pLeft = { "kind": AST_MEMBER, "object": pLeft, "field": pSymPool[len(pSymPool) - 1] }
            } else {
                if peek().type == "[" {
                    bump()
                    pIndexObj = pLeft
                    pRight = parseCompare()
                    if peek().type != "]" {
                        throw "Expected ]"
                    }
                    bump()
                    pLeft = { "kind": AST_INDEX, "object": pIndexObj, "index": pRight }
                } else {
                    break
                }
            }
        }
    }
    return pLeft
}

fn parseCompare() {
    if peek().type == "EOF" {
        throw "parseCompare EOF"
    }
    pLeft = parsePostfix()
    while peek().type == "+" {
        bump()
        pAddLeftStack = push(pAddLeftStack, pLeft)
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pAddLeft = pAddLeftStack[len(pAddLeftStack) - 1]
        pLeft = { "kind": AST_BINARY, "op": "+", "left": pAddLeft, "right": pRight }
        pAddLeftStack = popStack(pAddLeftStack)
    }
    while peek().type == "-" {
        bump()
        pAddLeftStack = push(pAddLeftStack, pLeft)
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pAddLeft = pAddLeftStack[len(pAddLeftStack) - 1]
        pLeft = { "kind": AST_BINARY, "op": "-", "left": pAddLeft, "right": pRight }
        pAddLeftStack = popStack(pAddLeftStack)
    }
    if pInAddSub == 1 {
        return pLeft
    }
    while peek().type == "==" {
        pBinOp = peek().type
        bump()
        pSave = pLeft
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    while peek().type == "!=" {
        pBinOp = peek().type
        bump()
        pSave = pLeft
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    while peek().type == "<" {
        pBinOp = peek().type
        bump()
        pSave = pLeft
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    while peek().type == ">" {
        pBinOp = peek().type
        bump()
        pSave = pLeft
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    while peek().type == ">=" {
        pBinOp = peek().type
        bump()
        pSave = pLeft
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    while peek().type == "<=" {
        pBinOp = peek().type
        bump()
        pSave = pLeft
        pInAddSub = 1
        pRight = parseCompare()
        pInAddSub = 0
        pLeft = { "kind": AST_BINARY, "op": pBinOp, "left": pSave, "right": pRight }
    }
    return pLeft
}

fn parseExpr() {
    if peek().type == "EOF" {
        throw "parseExpr EOF"
    }
    pLeft = parseCompare()
    while peek().type == "&&" {
        bump()
        pExprLeft = pLeft
        pRight = parseCompare()
        pLeft = { "kind": AST_BINARY, "op": "&&", "left": pExprLeft, "right": pRight }
    }
    return pLeft
}

fn parseStmt() {
    if peek().type == "EOF" {
        return null
    }
    if peek().type == TOKEN_LET {
        bump()
        pTok = peek()
        if pTok.type != TOKEN_IDENT {
            throw "Expected identifier after let"
        }
        pLetSym = symCopy(pTok.value)
        bump()
        pSymPool = push(pSymPool, pLetSym)
        pBindSym = pSymPool[len(pSymPool) - 1]
        if peek().type != "=" {
            throw "Expected ="
        }
        bump()
        pInit = parseExpr()
        return { "kind": AST_LET, "sym": pBindSym, "init": pInit }
    }
    pIsPub = 0
    if peek().type == TOKEN_PUB {
        bump()
        pIsPub = 1
    }
    if peek().type == TOKEN_FN {
        bump()
        pTok = peek()
        if pTok.type != TOKEN_IDENT {
            throw "Expected function name"
        }
        bump()
        pFnSym = symCopy(pTok.value)
        pFnPub = pIsPub
        if peek().type != "(" {
            throw "Expected ("
        }
        bump()
        pParams = []
        if peek().type != ")" {
            while true {
                pTok = peek()
                if pTok.type != TOKEN_IDENT {
                    throw "Expected parameter name"
                }
                bump()
                pSymPool = push(pSymPool, symCopy(pTok.value))
                pParams = push(pParams, pSymPool[len(pSymPool) - 1])
                if peek().type == "," {
                    bump()
                } else {
                    break
                }
            }
        }
        if peek().type != ")" {
            throw "Expected )"
        }
        bump()
        if peek().type != "{" {
            throw "Expected {"
        }
        bump()
        pBodyStack = push(pBodyStack, pBody)
        pBody = []
        while peek().type != "}" {
            if peek().type == "EOF" {
                throw "Unclosed block"
            }
            pBody = push(pBody, parseStmt())
            if peek().type == ";" {
                bump()
            }
        }
        bump()
        let fnBody = pBody
        pBody = pBodyStack[len(pBodyStack) - 1]
        pBodyStack = popStack(pBodyStack)
        return { "kind": AST_FN, "sym": pFnSym, "isPub": pFnPub, "params": pParams, "body": { "kind": AST_BLOCK, "body": fnBody } }
    }
    if peek().type == TOKEN_IF {
        bump()
        pCond = parseExpr()
        pCondStack = push(pCondStack, pCond)
        if peek().type != "{" {
            throw "Expected {"
        }
        bump()
        pBodyStack = push(pBodyStack, pBody)
        pBody = []
        while peek().type != "}" {
            pBody = push(pBody, parseStmt())
            if peek().type == ";" {
                bump()
            }
        }
        bump()
        pThen = { "kind": AST_BLOCK, "body": pBody }
        pBody = pBodyStack[len(pBodyStack) - 1]
        pBodyStack = popStack(pBodyStack)
        pElse = null
        if peek().type == TOKEN_ELSE {
            bump()
            if peek().type != "{" {
                throw "Expected {"
            }
            bump()
            pBodyStack = push(pBodyStack, pBody)
            pBody = []
            while peek().type != "}" {
                pBody = push(pBody, parseStmt())
                if peek().type == ";" {
                    bump()
                }
            }
            bump()
            pElse = { "kind": AST_BLOCK, "body": pBody }
            pBody = pBodyStack[len(pBodyStack) - 1]
            pBodyStack = popStack(pBodyStack)
        }
        pSave = pCondStack[len(pCondStack) - 1]
        pCondStack = popStack(pCondStack)
        return { "kind": AST_IF, "cond": pSave, "then": pThen, "elseBranch": pElse }
    }
    if peek().type == TOKEN_WHILE {
        bump()
        pCond = parseExpr()
        pCondStack = push(pCondStack, pCond)
        if peek().type != "{" {
            throw "Expected {"
        }
        bump()
        pBodyStack = push(pBodyStack, pLoopBody)
        pLoopBody = []
        while peek().type != "}" {
            pLoopBody = push(pLoopBody, parseStmt())
            if peek().type == ";" {
                bump()
            }
        }
        bump()
        let whileBody = pLoopBody
        pLoopBody = pBodyStack[len(pBodyStack) - 1]
        pBodyStack = popStack(pBodyStack)
        pSave = pCondStack[len(pCondStack) - 1]
        pCondStack = popStack(pCondStack)
        return { "kind": AST_WHILE, "cond": pSave, "body": { "kind": AST_BLOCK, "body": whileBody } }
    }
    if peek().type == TOKEN_CONTINUE {
        bump()
        return { "kind": AST_CONTINUE }
    }
    if peek().type == TOKEN_BREAK {
        bump()
        return { "kind": AST_BREAK }
    }
    if peek().type == TOKEN_THROW {
        bump()
        pVal = parseExpr()
        return { "kind": AST_THROW, "expr": pVal }
    }
    if peek().type == TOKEN_RETURN {
        bump()
        if peek().type == ";" {
            return { "kind": AST_RETURN, "value": null }
        }
        if peek().type == "}" {
            return { "kind": AST_RETURN, "value": null }
        }
        if peek().type == "EOF" {
            return { "kind": AST_RETURN, "value": null }
        }
        pVal = parseExpr()
        return { "kind": AST_RETURN, "value": pVal }
    }
    if peek().type == "{" {
        bump()
        pBodyStack = push(pBodyStack, pStmts)
        pStmts = []
        while peek().type != "}" {
            if peek().type == "EOF" {
                throw "Unclosed block"
            }
            pStmts = push(pStmts, parseStmt())
            if peek().type == ";" {
                bump()
            }
        }
        bump()
        let blockStmts = pStmts
        pStmts = pBodyStack[len(pBodyStack) - 1]
        pBodyStack = popStack(pBodyStack)
        return { "kind": AST_BLOCK, "body": blockStmts }
    }
    if peek().type == TOKEN_IDENT {
        if pPos + 1 < len(pToks) {
            pNextTok = pToks[pPos + 1]
        } else {
            pNextTok = { "type": "EOF", "value": null, "line": 1, "column": 1 }
        }
        if pNextTok.type == "=" {
            pTok = peek()
            pSymPool = push(pSymPool, symCopy(pTok.value))
            pBindSym = pSymPool[len(pSymPool) - 1]
            bump()
            bump()
            pVal = parseExpr()
            return { "kind": AST_ASSIGN, "sym": pBindSym, "rhs": pVal }
        }
    }
    pVal = parseExpr()
    return { "kind": AST_EXPR, "expr": pVal }
}

pub fn parseTokens(tokens) {
    pToks = tokens
    pPos = 0
    pSymPool = []
    pImports = []
    pBodyStack = push(pBodyStack, pBody)
    pBody = []
    pDone = 0
    while pDone == 0 {
        if pPos >= len(pToks) {
            pDone = 1
        }
        if pDone == 0 {
            pTok = peek()
            if pTok.type == "EOF" {
                pDone = 1
            }
        }
        if pDone == 0 {
            if pTok.type == TOKEN_IMPORT {
                bump()
                pTok = peek()
                if pTok.type == TOKEN_STRING {
                    bump()
                    pImports = push(pImports, symCopy(pTok.value))
                }
                if peek().type == ";" {
                    bump()
                }
            } else {
                pVal = parseStmt()
                if pVal != null {
                    pBody = push(pBody, pVal)
                }
            }
            if peek().type == ";" {
                bump()
            }
        }
    }
    let programBody = pBody
    pBody = pBodyStack[len(pBodyStack) - 1]
    pBodyStack = popStack(pBodyStack)
    return { "kind": AST_PROGRAM, "body": programBody, "imports": pImports }
}
