// H6e: self-hosted Kabootar parser — thin facade (impl in parser_impl.kab).
// import "self_host/parser"
//
// Re-export by alias (not a wrapping fn) — see self_host/vm.kab header for why
// wrapping fns break Kab VM reentrancy under KABOOTAR_VM=kab-only.
//
// parser_impl.kab stays skip-listed: self-host-compiling its ~46KB body is far too
// slow for CI (self-hosting cost scales with AST size of the source being compiled,
// independent of file size relative to the 64KB self-host-attempt threshold). This
// facade's own source is tiny, so `compile self_host/parser.kab --self-host` is
// CI-fast regardless of how heavy parser_impl.kab is.

import "self_host/parser_impl"

pub let parseTokens = parseTokensImpl
