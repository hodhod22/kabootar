// Part of deserialize line handlers.
import "self_host/deserialize_ops"

pub fn deserCode(st, line) {
    if starts_with(line, "source=") || starts_with(line, "statements=") {
        return "break"
    }
    st["ops"] = push(st["ops"], parseOpLine(line))
    return "ok"
}

pub fn deserMisc(st, line) {
    if starts_with(line, "constants=") || starts_with(line, "exports=") || starts_with(line, "imports=") {
        return "ok"
    }
    if starts_with(line, "const ") {
        st["constants"] = push(st["constants"], parseConstLine(line))
        return "ok"
    }
    if starts_with(line, "global ") {
        let rest = str_slice(line, 7, len(line))
        let sp = str_index_of(rest, " ")
        let name = unescapeKbc(trim(str_slice(rest, sp + 1, len(rest))))
        st["globals"] = push(st["globals"], name)
        return "ok"
    }
    if starts_with(line, "local ") {
        let rest = str_slice(line, 6, len(line))
        let sp = str_index_of(rest, " ")
        let idx = parse_int(trim(str_slice(rest, 0, sp)))
        let name = unescapeKbc(trim(str_slice(rest, sp + 1, len(rest))))
        let locals = st["locals"]
        while len(locals) <= idx {
            locals = push(locals, "")
        }
        locals[idx] = name
        st["locals"] = locals
        return "ok"
    }
    if starts_with(line, "main_try_region ") {
        let rest = trim(str_slice(line, 16, len(line)))
        let parts = split(rest, " ")
        st["tryRegions"] = push(st["tryRegions"], {
            "bodyStart": parse_int(parts[1]),
            "bodyEnd": parse_int(parts[2]),
            "catchStart": parse_int(parts[3]),
            "errLocal": parse_int(parts[4])
        })
        return "ok"
    }
    if starts_with(line, "import ") {
        let rest = str_slice(line, 7, len(line))
        let sp = str_index_of(rest, " ")
        let name = unescapeKbc(trim(str_slice(rest, sp + 1, len(rest))))
        st["imports"] = push(st["imports"], name)
        return "ok"
    }
    return "skip"
}

pub fn deserEnum(st, line) {
    if starts_with(line, "enums=") {
        return "ok"
    }
    if starts_with(line, "enum ") {
        let rest = str_slice(line, 5, len(line))
        let sp = str_index_of(rest, " ")
        let idx = parse_int(trim(str_slice(rest, 0, sp)))
        let sym = unescapeKbc(trim(str_slice(rest, sp + 1, len(rest))))
        let enums = st["enums"]
        if enums == undefined {
            enums = []
        }
        while len(enums) <= idx {
            enums = push(enums, { "sym": "", "variants": [] })
        }
        enums[idx]["sym"] = sym
        st["enums"] = enums
        return "ok"
    }
    if starts_with(line, "enum_variant_fields ") {
        let rest = trim(str_slice(line, 20, len(line)))
        let sp = str_index_of(rest, " ")
        let ei = parse_int(trim(str_slice(rest, 0, sp)))
        let rest2 = trim(str_slice(rest, sp + 1, len(rest)))
        let sp2 = str_index_of(rest2, " ")
        let vi = parse_int(trim(str_slice(rest2, 0, sp2)))
        let fl = unescapeKbc(trim(str_slice(rest2, sp2 + 1, len(rest2))))
        let fields = []
        if fl != "" {
            fields = split(fl, ",")
        }
        st["enums"][ei]["variants"][vi]["fields"] = fields
        return "ok"
    }
    if starts_with(line, "enum_variant ") {
        let rest = trim(str_slice(line, 13, len(line)))
        let sp = str_index_of(rest, " ")
        let ei = parse_int(trim(str_slice(rest, 0, sp)))
        let rest2 = trim(str_slice(rest, sp + 1, len(rest)))
        let sp2 = str_index_of(rest2, " ")
        let vi = parse_int(trim(str_slice(rest2, 0, sp2)))
        let name = unescapeKbc(trim(str_slice(rest2, sp2 + 1, len(rest2))))
        let vars = st["enums"][ei]["variants"]
        while len(vars) <= vi {
            vars = push(vars, { "name": "", "fields": [] })
        }
        vars[vi]["name"] = name
        st["enums"][ei]["variants"] = vars
        return "ok"
    }
    return "skip"
}

