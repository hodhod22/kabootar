import "self_host/vm_s_push"
import "self_host/vm_s_ip"

pub fn runOpDataDup(S, name, arg, op, pool, globals, functions) {
    if name == "dup" {
        if len(S["stack"]) == 0 {
            throw "vm stack underflow"
        }
        vPushS(S, S["stack"][len(S["stack"]) - 1])
        vBumpIpS(S)
        return 1
    }
    return 0
}
