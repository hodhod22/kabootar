import "self_host/lexer_defs"

let lxPos = 0
let lxSrc = ""

fn lxScan() {
    if lxSrc == "" {
        return { "type": TOKEN_EOF, "value": null, "line": 1, "column": 1 }
    }
    return { "type": TOKEN_IDENT, "value": "ab", "line": 1, "column": 1 }
}

pub fn tokenize(source) {
    lxPos = 0
    lxSrc = source
    let tokens = []
    let tok = lxScan()
    if tok.type == TOKEN_EOF {
        return []
    }
    tokens = push(tokens, tok)
    tokens = push(tokens, { "type": TOKEN_EOF, "value": null, "line": 1, "column": 1 })
    return tokens
}
