import "self_host/lexer_defs"
import "self_host/ast_defs"
import "self_host/parser_hooks"
import "self_host/parser_util"

pub fn parseCompare_bit(sess) {
    if sess["pNoBit"] == 0 {
        while sess["pCur"].type == "&" {
            bump(sess)
            let left = sess["pLeft"]
            let right = pCallRelExpr(sess)
            sess["pLeft"] = { "kind": AST_BINARY, "op": "&", "left": left, "right": right }
        }
        while sess["pCur"].type == "^" {
            bump(sess)
            let left = sess["pLeft"]
            let right = pCallRelExpr(sess)
            sess["pLeft"] = { "kind": AST_BINARY, "op": "^", "left": left, "right": right }
        }
        while sess["pCur"].type == "|" {
            bump(sess)
            let left = sess["pLeft"]
            let right = pCallRelExpr(sess)
            sess["pLeft"] = { "kind": AST_BINARY, "op": "|", "left": left, "right": right }
        }
    }
    return 0
}
