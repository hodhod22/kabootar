// P6b: parser trampoline hooks (shared AccAdd path; was parser_hooks).
pub fn pCallHook(sess, n) {
    let prevH = sess["_hook"]
    sess["_hook"] = n
    let r = sess["tramp"](sess)
    sess["_hook"] = prevH
    return r
}

pub fn pCallPostfix(sess) {
    return pCallHook(sess, 0)
}

pub fn pCallTypeArgs(sess) {
    return pCallHook(sess, 1)
}

pub fn pCallUnary(sess) {
    return pCallHook(sess, 2)
}

pub fn pCallMul(sess) {
    return pCallHook(sess, 3)
}

pub fn pCallAddShift(sess) {
    return pCallHook(sess, 4)
}

pub fn pCallRelExpr(sess) {
    return pCallHook(sess, 5)
}

pub fn pCallCompare(sess) {
    return pCallHook(sess, 6)
}

pub fn pCallStmt(sess) {
    return pCallHook(sess, 7)
}

pub fn pCallMatchPat(sess) {
    return pCallHook(sess, 8)
}

pub fn peek(sess) {
    return sess["pCur"]
}

pub fn bump(sess) {
    sess["pTok"] = sess["pCur"]
    let pos = sess["pPos"]
    let n = sess["pToksLen"]
    if pos < n {
        pos = pos + 1
        sess["pPos"] = pos
        if pos < n {
            sess["pCur"] = sess["pToks"][pos]
        } else {
            sess["pCur"] = sess["pEofTok"]
        }
    }
    return sess["pTok"]
}

pub fn poolPush(sess, v) {
    sess["pSymPool"] = push(sess["pSymPool"], v)
    sess["pSymN"] = sess["pSymN"] + 1
    return v
}

pub fn pEnterBody(sess) {
    // Assign-back (not object_array_push): sess is Rc-shared across tramp calls.
    sess["pBodyStack"] = push(sess["pBodyStack"], sess["pBody"])
    sess["pBodyDepth"] = sess["pBodyDepth"] + 1
    sess["pBody"] = []
    return 0
}

pub fn pLeaveBody(sess) {
    let body = sess["pBody"]
    let st = sess["pBodyStack"]
    let n = len(st)
    sess["pBody"] = st[n - 1]
    sess["pBodyStack"] = slice(st, 0, n - 1)
    sess["pBodyDepth"] = sess["pBodyDepth"] - 1
    return body
}

pub fn pParseBodyUntilRBrace(sess, eofMsg) {
    while sess["pCur"].type != "}" {
        if sess["pCur"].type == "EOF" {
            throw eofMsg
        }
        let stmt = pCallStmt(sess)
        sess["pBody"] = push(sess["pBody"], stmt)
        if sess["pCur"].type == ";" {
            bump(sess)
        }
    }
    bump(sess)
    return 0
}

pub fn pEnterLoopBody(sess) {
    sess["pBodyStack"] = push(sess["pBodyStack"], sess["pLoopBody"])
    sess["pBodyDepth"] = sess["pBodyDepth"] + 1
    sess["pLoopBody"] = []
    return 0
}

pub fn pLeaveLoopBody(sess) {
    let body = sess["pLoopBody"]
    let st = sess["pBodyStack"]
    let n = len(st)
    sess["pLoopBody"] = st[n - 1]
    sess["pBodyStack"] = slice(st, 0, n - 1)
    sess["pBodyDepth"] = sess["pBodyDepth"] - 1
    return body
}

pub fn pParseLoopUntilRBrace(sess) {
    while sess["pCur"].type != "}" {
        let stmt = pCallStmt(sess)
        sess["pLoopBody"] = push(sess["pLoopBody"], stmt)
        if sess["pCur"].type == ";" {
            bump(sess)
        }
    }
    bump(sess)
    return 0
}


// SH5 deepen: emit_sym merged here (was self_host/emit_sym).

// P6b: trampoline hooks for emitExpr/emitStmt across shards (no circular imports).
// SH5: emitOp / arrUtil / SH9 helpers (was emit_hooks / emit_arr_util).
pub fn eCallExpr(E, node) {
    let prevH = E["_hook"]
    let prevN = E["_node"]
    E["_hook"] = 0
    E["_node"] = node
    E["tramp"](E)
    E["_hook"] = prevH
    E["_node"] = prevN
}

pub fn eCallStmt(E, node) {
    let prevH = E["_hook"]
    let prevN = E["_node"]
    E["_hook"] = 1
    E["_node"] = node
    E["tramp"](E)
    E["_hook"] = prevH
    E["_node"] = prevN
}

pub fn emitOp(E, op, arg) {
    let rec = { "op": op, "arg": arg }
    if E["eInFn"] == 1 {
        E["eFnOps"] = push(E["eFnOps"], rec)
        E["eFnOpsN"] = E["eFnOpsN"] + 1
    } else {
        E["eOps"] = push(E["eOps"], rec)
        E["eOpsN"] = E["eOpsN"] + 1
    }
}

pub fn emitOp2(E, op, arg, arg2) {
    let rec = { "op": op, "arg": arg, "arg2": arg2 }
    if E["eInFn"] == 1 {
        E["eFnOps"] = push(E["eFnOps"], rec)
        E["eFnOpsN"] = E["eFnOpsN"] + 1
    } else {
        E["eOps"] = push(E["eOps"], rec)
        E["eOpsN"] = E["eOpsN"] + 1
    }
}

pub fn emitOp3(E, op, arg, arg2, arg3) {
    let rec = { "op": op, "arg": arg, "arg2": arg2, "arg3": arg3 }
    if E["eInFn"] == 1 {
        E["eFnOps"] = push(E["eFnOps"], rec)
        E["eFnOpsN"] = E["eFnOpsN"] + 1
    } else {
        E["eOps"] = push(E["eOps"], rec)
        E["eOpsN"] = E["eOpsN"] + 1
    }
}

pub fn opsLen(E) {
    if E["eInFn"] == 1 {
        return E["eFnOpsN"]
    }
    return E["eOpsN"]
}

pub fn patchJumpAt(E, idx) {
    patchJumpTo(E, idx, opsLen(E))
}

pub fn patchJumpTo(E, idx, target) {
    let rec = null
    if E["eInFn"] == 1 {
        rec = E["eFnOps"][idx]
    } else {
        rec = E["eOps"][idx]
    }
    let off = target - idx - 1
    let patched = { "op": rec.op, "arg": rec.arg }
    if rec.arg3 != undefined {
        patched = { "op": rec.op, "arg": rec.arg, "arg2": rec.arg2, "arg3": off }
    } else {
        if rec.arg2 != undefined {
            patched = { "op": rec.op, "arg": rec.arg, "arg2": off }
        } else {
            patched = { "op": rec.op, "arg": off }
        }
    }
    if E["eInFn"] == 1 {
        E["eFnOps"][idx] = patched
    } else {
        E["eOps"][idx] = patched
    }
}

pub fn arrUtil(E, mode, stack, arr) {
    if mode == "snap" {
        // Single O(n) clone via native slice (not O(n²) push loop).
        return slice(stack, 0)
    }
    E["eLenScratch"] = len(arr)
    if mode == "pushLenKey" {
        object_array_push(E, stack, E["eLenScratch"])
        return 0
    }
    return push(stack, E["eLenScratch"])
}

/// Typed i64 AccAdd-loop (SH9): host Cranelift can compile this helper.
pub fn accCount(n) {
    let i = 0
    let s = 0
    while i < n {
        s = s + 1
        i = i + 1
    }
    return s
}

/// Typed i64 index-loop (SH9): `s += i` so Cranelift sees AccAdd with the loop index.
pub fn idxSum(n) {
    let i = 0
    let s = 0
    while i < n {
        s = s + i
        i = i + 1
    }
    return s
}

/// SH9 IndexGet-loop: `s += xs[i]` — host JIT flattens i64 arrays then Cranelift-loads.
pub fn idxSumArr(xs) {
    let i = 0
    let n = len(xs)
    let s = 0
    while i < n {
        s = s + xs[i]
        i = i + 1
    }
    return s
}

/// SH9: LenLocal over a string (or any `len()` container) — JIT passes length, no IndexGet.
pub fn strCount(s) {
    let i = 0
    let n = len(s)
    let t = 0
    while i < n {
        t = t + 1
        i = i + 1
    }
    return t
}

/// SH9: `s[i]` is a 1-char string Value (VM semantics, not i64 codepoint).
pub fn strAt(s, i) {
    return s[i]
}

/// SH9: AccAdd of `s[i]` 1-char strings (same as VM `t = t + s[i]`).
pub fn strJoinIdx(s) {
    let i = 0
    let n = len(s)
    let t = ""
    while i < n {
        t = t + s[i]
        i = i + 1
    }
    return t
}

// SH5: const/sym maps (was emit_sym_index).
pub fn constKey(E, arg) {
    if arg == KAB_UNDEF_CONST {
        return "U"
    }
    if arg == null {
        return "N"
    }
    if arg == true {
        return "T"
    }
    if arg == false {
        return "F"
    }
    let t = typeof(arg)
    if t == "string" {
        return "S" + ("" + len(arg)) + ":" + arg
    }
    if t == "number" {
        return "D" + ("" + arg)
    }
    return "X" + ("" + arg)
}

pub fn symIndex(E, mode, arg) {
    if mode == "local" {
        let lHit = E["eLocalMap"][arg]
        if lHit != undefined {
            return lHit
        }
        E["eFnLocals"] = push(E["eFnLocals"], arg)
        let lIdx = E["eLocalN"]
        E["eLocalN"] = E["eLocalN"] + 1
        E["eLocalMap"][arg] = lIdx
        return lIdx
    }
    if mode == "global" {
        let gHit = E["eGlobalMap"][arg]
        if gHit != undefined {
            return gHit
        }
        E["eGlobals"] = push(E["eGlobals"], arg)
        let gIdx = E["eGlobalN"]
        E["eGlobalN"] = E["eGlobalN"] + 1
        E["eGlobalMap"][arg] = gIdx
        return gIdx
    }
    if mode == "const" {
        let cKey = constKey(E, arg)
        if object_has_own(E["eConstMap"], cKey) {
            return E["eConstMap"][cKey]
        }
        E["eConsts"] = push(E["eConsts"], arg)
        let cIdx = E["eConstN"]
        E["eConstN"] = E["eConstN"] + 1
        E["eConstMap"][cKey] = cIdx
        return cIdx
    }
    if mode == "constLit" {
        if arg["lit"] == LIT_UNDEF {
            return symIndex(E, "const", KAB_UNDEF_CONST)
        }
        return symIndex(E, "const", arg["value"])
    }
    if mode == "class" {
        E["eClassIdx"] = 0
        while E["eClassIdx"] < E["eClassesN"] {
            if E["eClasses"][E["eClassIdx"]]["sym"] == arg {
                return E["eClassIdx"]
            }
            E["eClassIdx"] = E["eClassIdx"] + 1
        }
        let miss = 0
        miss = miss - 1
        return miss
    }
    throw "symIndex: bad mode"
}

pub fn localSymIndex(E, sym) {
    if E["eInFn"] != 1 {
        return -1
    }
    let li = E["eLocalMap"][sym]
    if li != undefined {
        return li
    }
    return -1
}

pub fn resetLocalMap(E) {
    E["eLocalMap"] = {}
    E["eLocalN"] = 0
}

pub fn rebuildLocalMap(E) {
    E["eLocalMap"] = {}
    E["eLocalN"] = 0
    let i = 0
    let n = len(E["eFnLocals"])
    while i < n {
        E["eLocalMap"][E["eFnLocals"][i]] = i
        E["eLocalN"] = E["eLocalN"] + 1
        i = i + 1
    }
}

let eCallRet = 0

pub fn emitSym(E, store, sym) {
    // P6b: map lookup only — no len(E["eFnLocals"])/E["eGlobals"] LoadGlobal clone scans.
    if store == 0 {
        if E["eInFn"] == 0 {
            eCallRet = symIndex(E, "global", sym)
            E["eIdx"] = eCallRet
            emitOp(E, OP_LOAD_GLOBAL, eCallRet)
            return
        }
        let li = E["eLocalMap"][sym]
        if li != undefined {
            emitOp(E, OP_LOAD_LOCAL, li)
            return
        }
        let gi = E["eGlobalMap"][sym]
        if gi != undefined {
            emitOp(E, OP_LOAD_GLOBAL, gi)
            return
        }
        eCallRet = symIndex(E, "global", sym)
        E["eIdx"] = eCallRet
        emitOp(E, OP_LOAD_GLOBAL, eCallRet)
        return
    }
    if E["eInFn"] == 0 {
        eCallRet = symIndex(E, "global", sym)
        E["eIdx"] = eCallRet
        emitOp(E, OP_STORE_GLOBAL, eCallRet)
        return
    }
    let sli = E["eLocalMap"][sym]
    if sli != undefined {
        emitOp(E, OP_STORE_LOCAL, sli)
        return
    }
    let sgi = E["eGlobalMap"][sym]
    if sgi != undefined {
        emitOp(E, OP_STORE_GLOBAL, sgi)
        return
    }
    eCallRet = symIndex(E, "local", sym)
    E["eIdx"] = eCallRet
    emitOp(E, OP_STORE_LOCAL, eCallRet)
}

// SH5: fn scope / nested named fn / generic class meth (was emit_fn_scope).
pub fn emitFnScopeSave(E) {
    E["eSaveInFn"] = E["eInFn"]
    E["eSaveFnOps"] = arrUtil(E, "snap", E["eFnOps"])
    E["eSaveFnOpsN"] = E["eFnOpsN"]
    E["eSaveFnLocals"] = arrUtil(E, "snap", E["eFnLocals"])
    E["eSaveFnGlobals"] = arrUtil(E, "snap", E["eFnGlobals"])
}

pub fn emitFnScopeRestore(E) {
    E["eInFn"] = E["eSaveInFn"]
    E["eFnOps"] = E["eSaveFnOps"]
    E["eFnOpsN"] = E["eSaveFnOpsN"]
    E["eFnLocals"] = E["eSaveFnLocals"]
    rebuildLocalMap(E)
    E["eFnGlobals"] = E["eSaveFnGlobals"]
}

/// Missing args stay undefined in Kab-VM; apply default via jump_if_not_nullish.
pub fn emitFnParamDefaults(E, params, defaults) {
    if defaults == undefined || defaults == null {
        return 0
    }
    let di = 0
    while di < len(params) {
        if di >= len(defaults) {
            break
        }
        let def = defaults[di]
        if def != null && def != undefined && def != false {
            let li = localSymIndex(E, params[di])
            emitOp(E, OP_LOAD_LOCAL, li)
            let jumpKeep = opsLen(E)
            emitOp(E, OP_JUMP_IF_NOT_NULLISH, 0)
            emitOp(E, OP_POP, 0)
            eCallExpr(E, def)
            emitOp(E, OP_STORE_LOCAL, li)
            let jumpEnd = opsLen(E)
            emitOp(E, OP_JUMP, 0)
            patchJumpAt(E, jumpKeep)
            emitOp(E, OP_POP, 0)
            patchJumpAt(E, jumpEnd)
        }
        di = di + 1
    }
    return 0
}

/// Rest param survives rust kbc roundtrip as a locals marker (no new rust field).
pub fn emitFnMarkRest(E, rest) {
    if rest == undefined || rest == null || rest == "" {
        return 0
    }
    symIndex(E, "local", KAB_FN_REST_MARK)
    return 0
}

/// SH2: nested `fn name()` inside a function — save outer eFnOps (locals, not eSave*).
pub fn emitNestedNamedFn(E) {
    let aParams = E["eNode"]["params"]
    let aBody = E["eNode"]["body"]
    let aName = "" + E["eNode"]["sym"]
    let saveIn = E["eInFn"]
    let saveOps = arrUtil(E, "snap", E["eFnOps"])
    let saveFnOpsN = E["eFnOpsN"]
    let saveLocals = arrUtil(E, "snap", E["eFnLocals"])
    let saveGlobals = arrUtil(E, "snap", E["eFnGlobals"])
    let saveTry = arrUtil(E, "snap", E["eFnTryRegions"])
    E["eInFn"] = 1
    E["eFnOps"] = []
    E["eFnOpsN"] = 0
    E["eFnLocals"] = []
    resetLocalMap(E)
    E["eFnGlobals"] = []
    E["eFnTryRegions"] = []
    let api = 0
    while api < len(aParams) {
        symIndex(E, "local", aParams[api])
        api = api + 1
    }
    emitFnMarkRest(E, E["eNode"]["rest"])
    emitFnParamDefaults(E, aParams, E["eNode"]["paramDefaults"])
    if aBody.kind == AST_BLOCK {
        eCallStmt(E, aBody)
    } else {
        eCallExpr(E, aBody)
        emitOp(E, OP_RETURN, 0)
    }
    let ai = len(E["eArrows"])
    let arrowSym = "__arrow_" + ai
    E["eArrows"] = push(E["eArrows"], {
        "sym": arrowSym,
        "params": arrUtil(E, "snap", aParams),
        "locals": arrUtil(E, "snap", E["eFnLocals"]),
        "ops": arrUtil(E, "snap", E["eFnOps"]),
        "tryRegions": arrUtil(E, "snap", E["eFnTryRegions"]),
        "isAsync": E["eNode"]["isAsync"],
        "isGen": E["eNode"]["isGen"]
    })
    E["eInFn"] = saveIn
    E["eFnOps"] = saveOps
    E["eFnOpsN"] = saveFnOpsN
    E["eFnLocals"] = saveLocals
    rebuildLocalMap(E)
    E["eFnGlobals"] = saveGlobals
    E["eFnTryRegions"] = saveTry
    emitOp(E, OP_MAKE_ARROW, ai)
    emitSym(E, 1, aName)
}

pub fn emitInferVarBinding(E, varNode) {
    if varNode.kind != AST_VAR {
        return
    }
    E["eBi"] = 0
    while E["eBi"] < len(E["eBindingSyms"]) {
        if E["eBindingSyms"][E["eBi"]] == varNode["sym"] {
            E["eInferType"] = E["eBindingTypes"][E["eBi"]]
        }
        E["eBi"] = E["eBi"] + 1
    }
}

pub fn emitInferNestedCall(E, callNode, litFull) {
    if callNode.kind != AST_CALL {
        return
    }
    let cargs = callNode["args"]
    if cargs == undefined {
        return
    }
    if len(cargs) == 0 {
        return
    }
    let inner = cargs[0]
    if litFull == 1 {
        emitInferLitFull(E, inner)
    } else {
        emitInferLitBasic(E, inner)
    }
    if E["eInferType"] == "" {
        emitInferVarBinding(E, inner)
    }
    if E["eInferType"] == "" {
        emitInferNestedCall(E, inner, litFull)
    }
}

pub fn emitInferLitBasic(E, litNode) {
    E["eInferType"] = ""
    if litNode.kind != AST_LITERAL {
        return
    }
    if litNode.lit == LIT_NUMBER {
        E["eInferType"] = "Number"
        return
    }
    if litNode.lit == LIT_STRING {
        E["eInferType"] = "String"
        return
    }
}

pub fn emitInferLitFull(E, litNode) {
    emitInferLitBasic(E, litNode)
    if E["eInferType"] != "" {
        return
    }
    if litNode.kind != AST_LITERAL {
        return
    }
    if litNode.lit == LIT_BOOL {
        E["eInferType"] = "Bool"
        return
    }
    if litNode.lit == LIT_NULL {
        E["eInferType"] = "Null"
        return
    }
    if litNode.lit == LIT_UNDEF {
        E["eInferType"] = "Undefined"
        return
    }
}

pub fn emitSubstTypeName(E, tn) {
    if tn == undefined {
        return ""
    }
    if tn == "" {
        return tn
    }
    let tparams = E["eGenTmpl"]["typeParams"]
    if tparams == undefined {
        return tn
    }
    let idx = 0
    while idx < len(tparams) {
        if tparams[idx] == tn {
            if idx < len(E["eTypeArgs"]) {
                return E["eTypeArgs"][idx]
            }
        }
        idx = idx + 1
    }
    return tn
}

pub fn emitSubstClassFields(E, fields) {
    let out = []
    let i = 0
    while i < len(fields) {
        let f = fields[i]
        let tn = f["type"]
        if tn == undefined {
            tn = ""
        }
        let defv = f["default"]
        out = push(out, { "name": f["name"], "type": emitSubstTypeName(E, tn), "default": defv })
        i = i + 1
    }
    return out
}

pub fn emitSubstEnumVariants(E, vars) {
    let out = []
    let i = 0
    while i < len(vars) {
        let vf = vars[i]["fields"]
        if vf == undefined {
            vf = []
        }
        let nf = []
        let j = 0
        while j < len(vf) {
            nf = push(nf, emitSubstTypeName(E, vf[j]))
            j = j + 1
        }
        out = push(out, { "name": vars[i]["name"], "fields": nf })
        i = i + 1
    }
    return out
}

let eMangleRet = 0

pub fn emitMangleWithTypeArgs(E, nameKey) {
    if len(E["eTypeArgs"]) == 0 {
        return
    }
    eMangleRet = E[nameKey] + "$"
    E[nameKey] = eMangleRet + E["eTypeArgs"][0]
    E["eResolveI"] = 1
    while E["eResolveI"] < len(E["eTypeArgs"]) {
        eMangleRet = E[nameKey] + "_"
        E[nameKey] = eMangleRet + E["eTypeArgs"][E["eResolveI"]]
        E["eResolveI"] = E["eResolveI"] + 1
    }
}

pub fn emitInferTypeArgsFrom(E, argsKey, errSym, litFull) {
    object_array_clear(E, "eTypeArgs")
    E["eResolveI"] = 0
    while E["eResolveI"] < len(E[argsKey]) {
        E["eInferArg"] = E[argsKey][E["eResolveI"]]
        E["eInferType"] = ""
        if litFull == 1 {
            emitInferLitFull(E, E["eInferArg"])
        } else {
            emitInferLitBasic(E, E["eInferArg"])
        }
        if E["eInferType"] == "" {
            emitInferVarBinding(E, E["eInferArg"])
        }
        if E["eInferType"] == "" {
            emitInferNestedCall(E, E["eInferArg"], litFull)
        }
        if E["eInferType"] == "" {
            if errSym != "" {
                throw "Cannot infer type for " + errSym
            }
        } else {
            object_array_push(E, "eTypeArgs", E["eInferType"])
        }
        E["eResolveI"] = E["eResolveI"] + 1
    }
}

pub fn emitLoadExplicitTypeArgs(E) {
    E["eExplicit"] = E["eNode"]["typeArgs"]
    if E["eExplicit"] == undefined {
        E["eExplicit"] = []
    }
    if len(E["eExplicit"]) > 0 {
        E["eTypeArgs"] = arrUtil(E, "snap", E["eExplicit"])
    }
}

pub fn emitResolveTypeArgs(E, argsKey, errSym, litFull) {
    emitLoadExplicitTypeArgs(E)
    if len(E["eExplicit"]) == 0 {
        emitInferTypeArgsFrom(E, argsKey, errSym, litFull)
    }
}

pub fn emitResolveTypeArgsMem(E, argsKey, errSym, litFull) {
    emitLoadExplicitTypeArgs(E)
    if len(E["eExplicit"]) > 0 {
        return
    }
    if len(E["eMemTypeArgs"]) > 0 {
        E["eTypeArgs"] = arrUtil(E, "snap", E["eMemTypeArgs"])
        return
    }
    emitInferTypeArgsFrom(E, argsKey, errSym, litFull)
}

pub fn emitFnCompileBody(E) {
    E["eInFn"] = 1
    object_array_clear(E, "eFnOps")
    E["eFnOpsN"] = 0
    object_array_clear(E, "eFnGlobals")
    object_array_clear(E, "eFnLocals")
    resetLocalMap(E)
    E["eParamI"] = 0
    while E["eParamI"] < len(E["eParams"]) {
        E["eLoopSave"] = E["eParamI"]
        symIndex(E, "local", E["eParams"][E["eParamI"]])
        E["eParamI"] = E["eLoopSave"] + 1
    }
    emitFnMarkRest(E, E["eFnRest"])
    emitFnParamDefaults(E, E["eParams"], E["eParamDefaults"])
    eCallStmt(E, E["eFnBody"])
}

pub fn emitGenClassMeth(E) {
    E["eMethTypeParams"] = E["eMeth"]["typeParams"]
    if E["eMethTypeParams"] == undefined {
        E["eMethTypeParams"] = []
    }
    if len(E["eMethTypeParams"]) == 0 {
        E["eParams"] = E["eMeth"]["params"]
        if E["eParams"] == undefined {
            E["eParams"] = []
        }
        let methParams = []
        let mpi = 0
        while mpi < len(E["eParams"]) {
            methParams = push(methParams, E["eParams"][mpi])
            mpi = mpi + 1
        }
        E["eParams"] = methParams
        E["eInFn"] = 1
        E["eFnOps"] = []
        E["eFnOpsN"] = 0
        E["eFnGlobals"] = []
        E["eFnLocals"] = []
        resetLocalMap(E)
        if E["eClassIsStruct"] == 1 {
            symIndex(E, "local", "self")
        } else {
            symIndex(E, "local", "this")
        }
        E["eParamI"] = 0
        while E["eParamI"] < len(E["eParams"]) {
            E["eLoopSave"] = E["eParamI"]
            if E["eParams"][E["eParamI"]] != "this" {
                if E["eParams"][E["eParamI"]] != "self" {
                    symIndex(E, "local", E["eParams"][E["eParamI"]])
                }
            }
            E["eParamI"] = E["eLoopSave"] + 1
        }
        rebuildLocalMap(E)
        emitFnMarkRest(E, E["eMeth"]["rest"])
        emitFnParamDefaults(E, E["eParams"], E["eMeth"]["paramDefaults"])
        emitOp(E, OP_MAKE_NONE, 0)
        emitOp(E, OP_POP, 0)
        eCallStmt(E, E["eMeth"]["body"])
        E["eClassMethods"] = push(E["eClassMethods"], {
            "sym": E["eMeth"]["sym"],
            "params": arrUtil(E, "snap", E["eParams"]),
            "locals": arrUtil(E, "snap", E["eFnLocals"]),
            "globals": arrUtil(E, "snap", E["eFnGlobals"]),
            "constants": arrUtil(E, "snap", E["eConsts"]),
            "ops": arrUtil(E, "snap", E["eFnOps"])
        })
        E["eInFn"] = 0
        return 0
    }
    let methWhere = E["eMeth"]["whereClause"]
    if methWhere == undefined {
        methWhere = []
    }
    E["eGenericMethodTemplates"] = push(E["eGenericMethodTemplates"], {
        "classSym": E["eMangled"],
        "methodSym": E["eMeth"]["sym"],
        "typeParams": arrUtil(E, "snap", E["eMethTypeParams"]),
        "params": arrUtil(E, "snap", E["eMeth"]["params"]),
        "paramDefaults": E["eMeth"]["paramDefaults"],
        "rest": E["eMeth"]["rest"],
        "body": E["eMeth"]["body"],
        "whereClause": arrUtil(E, "snap", methWhere)
    })
    return 0
}

// --- lexer_scan (was separate module; SH5 merge 6: ast_defs inlined) ---


pub fn lxEat(sess) {
    sess["pos"] = sess["pos"] + 1
    sess["col"] = sess["col"] + 1
    return 0
}

pub fn lxCh(sess) {
    return char_at(sess["src"], sess["pos"])
}

pub fn lxTok(typ, val, line, col) {
    return { "type": typ, "value": val, "line": line, "column": col }
}

pub fn lxHas(sess) {
    return sess["pos"] < sess["srcLen"]
}

pub fn lxStarts(sess, ch) {
    if sess["pos"] >= sess["srcLen"] {
        return 0
    }
    if char_at(sess["src"], sess["pos"]) == ch {
        return 1
    }
    return 0
}

// --- lexer_scan_arith ---
pub fn lxScanPlusMinus(sess, c, line, col) {
    if c == "+" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("+=", null, line, col)
        }
        return lxTok("+", null, line, col)
    }
    if c == "-" {
        lxEat(sess)
        if lxStarts(sess, ">") == 1 {
            lxEat(sess)
            return lxTok("->", null, line, col)
        }
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("-=", null, line, col)
        }
        return lxTok("-", null, line, col)
    }
    return null
}

pub fn lxScanMulDiv(sess, c, line, col) {
    if c == "*" {
        lxEat(sess)
        if lxStarts(sess, "*") == 1 {
            lxEat(sess)
            if lxStarts(sess, "=") == 1 {
                lxEat(sess)
                return lxTok("**=", null, line, col)
            }
            return lxTok("**", null, line, col)
        }
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("*=", null, line, col)
        }
        return lxTok("*", null, line, col)
    }
    if c == "/" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("/=", null, line, col)
        }
        return lxTok("/", null, line, col)
    }
    if c == "%" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("%=", null, line, col)
        }
        return lxTok("%", null, line, col)
    }
    return null
}

// --- lexer_scan_cmp ---
pub fn lxScanCmp(sess, c, line, col) {
    if c == "<" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("<=", null, line, col)
        }
        if lxStarts(sess, "<") == 1 {
            lxEat(sess)
            if lxStarts(sess, "=") == 1 {
                lxEat(sess)
                return lxTok("<<=", null, line, col)
            }
            return lxTok("<<", null, line, col)
        }
        return lxTok("<", null, line, col)
    }
    if c == ">" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok(">=", null, line, col)
        }
        if lxStarts(sess, ">") == 1 {
            lxEat(sess)
            if lxStarts(sess, ">") == 1 {
                lxEat(sess)
                if lxStarts(sess, "=") == 1 {
                    lxEat(sess)
                    return lxTok(">>>=", null, line, col)
                }
                return lxTok(">>>", null, line, col)
            }
            if lxStarts(sess, "=") == 1 {
                lxEat(sess)
                return lxTok(">>=", null, line, col)
            }
            return lxTok(">>", null, line, col)
        }
        return lxTok(">", null, line, col)
    }
    if c == "." {
        lxEat(sess)
        if lxStarts(sess, ".") == 1 {
            lxEat(sess)
            if lxStarts(sess, ".") == 1 {
                lxEat(sess)
                return lxTok("...", null, line, col)
            }
            if lxStarts(sess, "=") == 1 {
                lxEat(sess)
                return lxTok("..=", null, line, col)
            }
            return lxTok("..", null, line, col)
        }
        return lxTok(".", null, line, col)
    }
    return null
}

// --- lexer_scan_eq ---
pub fn lxScanEqBang(sess, c, line, col) {
    if c == "?" {
        lxEat(sess)
        if lxStarts(sess, "?") == 1 {
            lxEat(sess)
            if lxStarts(sess, "=") == 1 {
                lxEat(sess)
                return lxTok("??=", null, line, col)
            }
            return lxTok("??", null, line, col)
        }
        if lxStarts(sess, ".") == 1 {
            lxEat(sess)
            return lxTok("?.", null, line, col)
        }
        return lxTok("?", null, line, col)
    }
    if c == "=" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("==", null, line, col)
        }
        if lxStarts(sess, ">") == 1 {
            lxEat(sess)
            return lxTok("=>", null, line, col)
        }
        return lxTok("=", null, line, col)
    }
    if c == "!" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("!=", null, line, col)
        }
        return lxTok("!", null, line, col)
    }
    return null
}

pub fn lxScanLogic(sess, c, line, col) {
    if c == "&" {
        lxEat(sess)
        if lxStarts(sess, "&") == 1 {
            lxEat(sess)
            if lxStarts(sess, "=") == 1 {
                lxEat(sess)
                return lxTok("&&=", null, line, col)
            }
            return lxTok("&&", null, line, col)
        }
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("&=", null, line, col)
        }
        return lxTok("&", null, line, col)
    }
    if c == "|" {
        lxEat(sess)
        if lxStarts(sess, "|") == 1 {
            lxEat(sess)
            if lxStarts(sess, "=") == 1 {
                lxEat(sess)
                return lxTok("||=", null, line, col)
            }
            return lxTok("||", null, line, col)
        }
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("|=", null, line, col)
        }
        return lxTok("|", null, line, col)
    }
    return null
}

// --- lexer_scan_punct ---
pub fn lxScanPunct(sess, c, line, col) {
    if c == "(" {
        lxEat(sess)
        return lxTok("(", null, line, col)
    }
    if c == ")" {
        lxEat(sess)
        return lxTok(")", null, line, col)
    }
    if c == "{" {
        lxEat(sess)
        return lxTok("{", null, line, col)
    }
    if c == "}" {
        lxEat(sess)
        return lxTok("}", null, line, col)
    }
    if c == "[" {
        lxEat(sess)
        return lxTok("[", null, line, col)
    }
    if c == "]" {
        lxEat(sess)
        return lxTok("]", null, line, col)
    }
    if c == ";" {
        lxEat(sess)
        return lxTok(";", null, line, col)
    }
    if c == "," {
        lxEat(sess)
        return lxTok(",", null, line, col)
    }
    if c == ":" {
        lxEat(sess)
        return lxTok(":", null, line, col)
    }
    if c == "^" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("^=", null, line, col)
        }
        return lxTok("^", null, line, col)
    }
    if c == "~" {
        lxEat(sess)
        return lxTok("~", null, line, col)
    }
    if c == "@" {
        lxEat(sess)
        return lxTok("@", null, line, col)
    }
    return null
}

// --- lexer_scan_string ---
pub fn lxScanHash(sess, c, line, col) {
    if c != "#" {
        return null
    }
    lxEat(sess)
    let start = sess["pos"]
    let cd = 0
    let ok = 0
    let src = sess["src"]
    let srcLen = sess["srcLen"]
    let pos = sess["pos"]
    let scol = sess["col"]
    while pos < srcLen {
        cd = char_code_at(src, pos)
        ok = 0
        if cd >= 65 && cd <= 90 { ok = 1 }
        if cd >= 97 && cd <= 122 { ok = 1 }
        if cd >= 48 && cd <= 57 { ok = 1 }
        if cd == 95 { ok = 1 }
        if ok == 0 { break }
        pos = pos + 1
        scol = scol + 1
    }
    sess["pos"] = pos
    sess["col"] = scol
    if pos == start {
        throw "Expected identifier after # at line " + ("" + line) + " col " + ("" + col)
    }
    return lxTok(TOKEN_PRIVATE, str_slice(src, start, pos), line, col)
}

pub fn lxScanString(sess, c, line, col) {
    if c != "\"" {
        return null
    }
    lxEat(sess)
    let start = sess["pos"]
    let i = sess["pos"]
    let hasEsc = 0
    let ch = ""
    while i < sess["srcLen"] {
        ch = char_at(sess["src"], i)
        if ch == "\\" {
            hasEsc = 1
            break
        }
        if ch == "\"" {
            break
        }
        i = i + 1
    }
    if hasEsc == 0 {
        if i >= sess["srcLen"] {
            throw "Unterminated string at line " + ("" + line) + " col " + ("" + col)
        }
        let s = str_slice(sess["src"], start, i)
        sess["col"] = sess["col"] + (i - start) + 1
        sess["pos"] = i + 1
        return lxTok(TOKEN_STRING, s, line, col)
    }
    let s = ""
    while sess["pos"] < sess["srcLen"] {
        ch = char_at(sess["src"], sess["pos"])
        if ch == "\\" {
            lxEat(sess)
            if sess["pos"] >= sess["srcLen"] {
                throw "Unterminated string escape at line " + ("" + line) + " col " + ("" + col)
            }
            let e = char_at(sess["src"], sess["pos"])
            lxEat(sess)
            let piece = "\\" + e
            if e == "n" { piece = "\n" }
            if e == "r" { piece = "\r" }
            if e == "t" { piece = "\t" }
            if e == "\"" { piece = "\"" }
            if e == "\\" { piece = "\\" }
            s = s + piece
            continue
        }
        if ch == "\"" {
            lxEat(sess)
            break
        }
        lxEat(sess)
        s = s + ch
    }
    return lxTok(TOKEN_STRING, s, line, col)
}

pub fn lxScanTemplate(sess, c, line, col) {
    if c != BACKTICK {
        return null
    }
    lxEat(sess)
    let parts = []
    let buf = ""
    while sess["pos"] < sess["srcLen"] {
        let ch = char_at(sess["src"], sess["pos"])
        if ch == BACKTICK {
            lxEat(sess)
            if buf != "" {
                parts = push(parts, { "t": "s", "v": buf })
            }
            if len(parts) == 0 {
                return lxTok(TOKEN_STRING, "", line, col)
            }
            if len(parts) == 1 {
                if parts[0]["t"] == "s" {
                    return lxTok(TOKEN_STRING, parts[0]["v"], line, col)
                }
            }
            return lxTok(TOKEN_TEMPLATE, parts, line, col)
        }
        if ch == "$" {
            if sess["pos"] + 1 < sess["srcLen"] {
                if char_at(sess["src"], sess["pos"] + 1) == "{" {
                    lxEat(sess)
                    lxEat(sess)
                    if buf != "" {
                        parts = push(parts, { "t": "s", "v": buf })
                        buf = ""
                    }
                    let depth = 1
                    let expr = ""
                    while sess["pos"] < sess["srcLen"] {
                        if depth == 0 {
                            break
                        }
                        let ec = char_at(sess["src"], sess["pos"])
                        lxEat(sess)
                        if ec == "{" {
                            depth = depth + 1
                            expr = expr + ec
                        } else {
                            if ec == "}" {
                                depth = depth - 1
                                if depth == 0 {
                                    break
                                }
                                expr = expr + ec
                            } else {
                                expr = expr + ec
                            }
                        }
                    }
                    if depth != 0 {
                        throw "Unterminated ${} in template at line " + ("" + line) + " col " + ("" + col)
                    }
                    parts = push(parts, { "t": "e", "v": expr })
                    continue
                }
            }
        }
        lxEat(sess)
        buf = buf + ch
    }
    throw "Unterminated template literal at line " + ("" + line) + " col " + ("" + col)
}

// --- lexer_scan_word ---
pub fn lxScanNumber(sess, code0, line, col) {
    if !(code0 >= 48 && code0 <= 57) {
        return null
    }
    let src = sess["src"]
    let srcLen = sess["srcLen"]
    let start = sess["pos"]
    let pos = start + 1
    let scol = sess["col"] + 1
    let cd = 0
    while pos < srcLen {
        cd = char_code_at(src, pos)
        if cd < 48 || cd > 57 {
            break
        }
        pos = pos + 1
        scol = scol + 1
    }
    sess["pos"] = pos
    sess["col"] = scol
    let digits = str_slice(src, start, pos)
    if lxStarts(sess, "n") == 1 {
        lxEat(sess)
        return lxTok(TOKEN_BIGINT, digits, line, col)
    }
    if lxStarts(sess, ".") == 1 {
        let afterDot = sess["pos"] + 1
        let isFrac = 0
        if afterDot < sess["srcLen"] {
            cd = char_code_at(sess["src"], afterDot)
            if cd >= 48 && cd <= 57 {
                isFrac = 1
            }
        }
        if isFrac == 1 {
            lxEat(sess)
            src = sess["src"]
            srcLen = sess["srcLen"]
            pos = sess["pos"]
            scol = sess["col"]
            let fracStart = pos
            while pos < srcLen {
                cd = char_code_at(src, pos)
                if cd < 48 || cd > 57 {
                    break
                }
                pos = pos + 1
                scol = scol + 1
            }
            sess["pos"] = pos
            sess["col"] = scol
            let frac = str_slice(src, fracStart, pos)
            return lxTok(TOKEN_FLOAT, parse_float(digits + "." + frac), line, col)
        }
    }
    return lxTok(TOKEN_NUMBER, parse_int(digits), line, col)
}

pub fn lxScanIdent(sess, c, code0, line, col) {
    let src = sess["src"]
    let srcLen = sess["srcLen"]
    let start = sess["pos"]
    let pos = start
    let scol = sess["col"]
    let cd = 0
    let ok = 0
    if c == "_" {
        pos = pos + 1
        scol = scol + 1
        while pos < srcLen {
            cd = char_code_at(src, pos)
            ok = 0
            if cd >= 65 && cd <= 90 { ok = 1 }
            if cd >= 97 && cd <= 122 { ok = 1 }
            if cd >= 48 && cd <= 57 { ok = 1 }
            if cd == 95 { ok = 1 }
            if ok == 0 { break }
            pos = pos + 1
            scol = scol + 1
        }
        sess["pos"] = pos
        sess["col"] = scol
        return lxTok(TOKEN_IDENT, str_slice(src, start, pos), line, col)
    }
    let isAlpha = 0
    if code0 >= 97 && code0 <= 122 { isAlpha = 1 }
    if isAlpha == 0 && code0 >= 65 && code0 <= 90 { isAlpha = 1 }
    if isAlpha == 0 {
        return null
    }
    pos = pos + 1
    scol = scol + 1
    while pos < srcLen {
        cd = char_code_at(src, pos)
        ok = 0
        if cd >= 65 && cd <= 90 { ok = 1 }
        if cd >= 97 && cd <= 122 { ok = 1 }
        if cd >= 48 && cd <= 57 { ok = 1 }
        if cd == 95 { ok = 1 }
        if ok == 0 { break }
        pos = pos + 1
        scol = scol + 1
    }
    sess["pos"] = pos
    sess["col"] = scol
    let id = str_slice(src, start, pos)
    let kw = KEYWORDS[id]
    if kw == undefined {
        return lxTok(TOKEN_IDENT, id, line, col)
    }
    return lxTok(kw, null, line, col)
}

// --- lexer_scan ---
pub fn lxScan(sess) {
    if sess["pos"] >= sess["srcLen"] {
        return lxTok(TOKEN_EOF, null, sess["line"], sess["col"])
    }
    let c = char_at(sess["src"], sess["pos"])
    let line = sess["line"]
    let col = sess["col"]
    let tok = lxScanPunct(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanPlusMinus(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanMulDiv(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanEqBang(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanLogic(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanCmp(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanHash(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanString(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanTemplate(sess, c, line, col)
    if tok != null { return tok }
    let code0 = char_code_at(c, 0)
    tok = lxScanNumber(sess, code0, line, col)
    if tok != null { return tok }
    tok = lxScanIdent(sess, c, code0, line, col)
    if tok != null { return tok }
    throw "Unknown character: " + c + " at line " + ("" + line) + " col " + ("" + col)
}

// SH5: skip + tokenizeExec (was lexer_tokenize).
// SH12: cache src/srcLen/pos locally; reuse gLxSess + in-place token array.
pub fn lxSkipSpace(sess) {
    let src = sess["src"]
    let srcLen = sess["srcLen"]
    let pos = sess["pos"]
    let col = sess["col"]
    let line = sess["line"]
    let cd = 0
    while pos < srcLen {
        cd = char_code_at(src, pos)
        if cd == 32 || cd == 9 || cd == 13 {
            col = col + 1
            pos = pos + 1
            continue
        }
        if cd == 10 {
            line = line + 1
            col = 1
            pos = pos + 1
            continue
        }
        break
    }
    sess["pos"] = pos
    sess["col"] = col
    sess["line"] = line
    return 0
}

pub fn lxSkipLineComment(sess) {
    let src = sess["src"]
    let srcLen = sess["srcLen"]
    let pos = sess["pos"]
    if pos >= srcLen {
        return 0
    }
    if char_at(src, pos) != "/" {
        return 0
    }
    if pos + 1 >= srcLen {
        return 0
    }
    if char_at(src, pos + 1) != "/" {
        return 0
    }
    pos = pos + 2
    let col = sess["col"] + 2
    let line = sess["line"]
    let cd = 0
    while pos < srcLen {
        cd = char_code_at(src, pos)
        if cd == 10 {
            line = line + 1
            col = 1
            pos = pos + 1
            break
        }
        col = col + 1
        pos = pos + 1
    }
    sess["pos"] = pos
    sess["col"] = col
    sess["line"] = line
    return 1
}

pub fn lxSkipBlockComment(sess) {
    let src = sess["src"]
    let srcLen = sess["srcLen"]
    let pos = sess["pos"]
    if pos >= srcLen {
        return 0
    }
    if char_at(src, pos) != "/" {
        return 0
    }
    if pos + 1 >= srcLen {
        return 0
    }
    if char_at(src, pos + 1) != "*" {
        return 0
    }
    pos = pos + 2
    let col = sess["col"] + 2
    let line = sess["line"]
    let cd = 0
    while pos < srcLen {
        cd = char_code_at(src, pos)
        pos = pos + 1
        col = col + 1
        if cd == 10 {
            line = line + 1
            col = 1
        }
        if cd == 42 && pos < srcLen && char_at(src, pos) == "/" {
            pos = pos + 1
            col = col + 1
            break
        }
    }
    sess["pos"] = pos
    sess["col"] = col
    sess["line"] = line
    return 1
}

let gLxSess = null

pub fn tokenizeExec(source) {
    let sess = gLxSess
    if sess == null {
        sess = {
            "pos": 0,
            "src": source,
            "srcLen": len(source),
            "line": 1,
            "col": 1,
            "tokens": []
        }
        gLxSess = sess
    } else {
        sess["pos"] = 0
        sess["src"] = source
        sess["srcLen"] = len(source)
        sess["line"] = 1
        sess["col"] = 1
        object_array_clear(sess, "tokens")
    }
    let srcLen = sess["srcLen"]
    let tok = null
    let n = 0
    let at = 0
    while true {
        n = n + 1
        if n > srcLen + 8 {
            throw "lexer runaway"
        }
        lxSkipSpace(sess)
        if sess["pos"] >= srcLen {
            break
        }
        if lxSkipLineComment(sess) == 1 {
            continue
        }
        if lxSkipBlockComment(sess) == 1 {
            continue
        }
        at = sess["pos"]
        tok = lxScan(sess)
        if sess["pos"] <= at && tok.type != TOKEN_EOF {
            throw "lexer stuck pos=" + ("" + at) + " type=" + ("" + tok.type)
        }
        if tok.type == TOKEN_EOF {
            break
        }
        object_array_push(sess, "tokens", tok)
    }
    object_array_push(sess, "tokens", lxTok(TOKEN_EOF, null, sess["line"], sess["col"]))
    let toks = sess["tokens"]
    sess["tokens"] = []
    return toks
}

