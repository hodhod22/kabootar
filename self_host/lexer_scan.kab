import "self_host/ast_defs"

pub fn lxEat(sess) {
    sess["pos"] = sess["pos"] + 1
    sess["col"] = sess["col"] + 1
    return 0
}

pub fn lxCh(sess) {
    return char_at(sess["src"], sess["pos"])
}

pub fn lxTok(typ, val, line, col) {
    return { "type": typ, "value": val, "line": line, "column": col }
}

pub fn lxHas(sess) {
    return sess["pos"] < sess["srcLen"]
}

pub fn lxStarts(sess, ch) {
    if sess["pos"] >= sess["srcLen"] {
        return 0
    }
    if char_at(sess["src"], sess["pos"]) == ch {
        return 1
    }
    return 0
}

// --- lexer_scan_arith ---
pub fn lxScanPlusMinus(sess, c, line, col) {
    if c == "+" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("+=", null, line, col)
        }
        return lxTok("+", null, line, col)
    }
    if c == "-" {
        lxEat(sess)
        if lxStarts(sess, ">") == 1 {
            lxEat(sess)
            return lxTok("->", null, line, col)
        }
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("-=", null, line, col)
        }
        return lxTok("-", null, line, col)
    }
    return null
}

pub fn lxScanMulDiv(sess, c, line, col) {
    if c == "*" {
        lxEat(sess)
        if lxStarts(sess, "*") == 1 {
            lxEat(sess)
            return lxTok("**", null, line, col)
        }
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("*=", null, line, col)
        }
        return lxTok("*", null, line, col)
    }
    if c == "/" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("/=", null, line, col)
        }
        return lxTok("/", null, line, col)
    }
    if c == "%" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("%=", null, line, col)
        }
        return lxTok("%", null, line, col)
    }
    return null
}

// --- lexer_scan_cmp ---
pub fn lxScanCmp(sess, c, line, col) {
    if c == "<" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("<=", null, line, col)
        }
        if lxStarts(sess, "<") == 1 {
            lxEat(sess)
            return lxTok("<<", null, line, col)
        }
        return lxTok("<", null, line, col)
    }
    if c == ">" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok(">=", null, line, col)
        }
        if lxStarts(sess, ">") == 1 {
            lxEat(sess)
            if lxStarts(sess, ">") == 1 {
                lxEat(sess)
                return lxTok(">>>", null, line, col)
            }
            return lxTok(">>", null, line, col)
        }
        return lxTok(">", null, line, col)
    }
    if c == "." {
        lxEat(sess)
        if lxStarts(sess, ".") == 1 {
            lxEat(sess)
            if lxStarts(sess, ".") == 1 {
                lxEat(sess)
                return lxTok("...", null, line, col)
            }
            throw "Expected ... at line " + ("" + line) + " col " + ("" + col)
        }
        return lxTok(".", null, line, col)
    }
    return null
}

// --- lexer_scan_eq ---
pub fn lxScanEqBang(sess, c, line, col) {
    if c == "?" {
        lxEat(sess)
        if lxStarts(sess, "?") == 1 {
            lxEat(sess)
            return lxTok("??", null, line, col)
        }
        if lxStarts(sess, ".") == 1 {
            lxEat(sess)
            return lxTok("?.", null, line, col)
        }
        return lxTok("?", null, line, col)
    }
    if c == "=" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("==", null, line, col)
        }
        if lxStarts(sess, ">") == 1 {
            lxEat(sess)
            return lxTok("=>", null, line, col)
        }
        return lxTok("=", null, line, col)
    }
    if c == "!" {
        lxEat(sess)
        if lxStarts(sess, "=") == 1 {
            lxEat(sess)
            return lxTok("!=", null, line, col)
        }
        return lxTok("!", null, line, col)
    }
    return null
}

pub fn lxScanLogic(sess, c, line, col) {
    if c == "&" {
        lxEat(sess)
        if lxStarts(sess, "&") == 1 {
            lxEat(sess)
            return lxTok("&&", null, line, col)
        }
        return lxTok("&", null, line, col)
    }
    if c == "|" {
        lxEat(sess)
        if lxStarts(sess, "|") == 1 {
            lxEat(sess)
            return lxTok("||", null, line, col)
        }
        return lxTok("|", null, line, col)
    }
    return null
}

// --- lexer_scan_punct ---
pub fn lxScanPunct(sess, c, line, col) {
    if c == "(" {
        lxEat(sess)
        return lxTok("(", null, line, col)
    }
    if c == ")" {
        lxEat(sess)
        return lxTok(")", null, line, col)
    }
    if c == "{" {
        lxEat(sess)
        return lxTok("{", null, line, col)
    }
    if c == "}" {
        lxEat(sess)
        return lxTok("}", null, line, col)
    }
    if c == "[" {
        lxEat(sess)
        return lxTok("[", null, line, col)
    }
    if c == "]" {
        lxEat(sess)
        return lxTok("]", null, line, col)
    }
    if c == ";" {
        lxEat(sess)
        return lxTok(";", null, line, col)
    }
    if c == "," {
        lxEat(sess)
        return lxTok(",", null, line, col)
    }
    if c == ":" {
        lxEat(sess)
        return lxTok(":", null, line, col)
    }
    if c == "^" {
        lxEat(sess)
        return lxTok("^", null, line, col)
    }
    if c == "~" {
        lxEat(sess)
        return lxTok("~", null, line, col)
    }
    return null
}

// --- lexer_scan_string ---
pub fn lxScanHash(sess, c, line, col) {
    if c != "#" {
        return null
    }
    lxEat(sess)
    let start = sess["pos"]
    let cd = 0
    let ok = 0
    let src = sess["src"]
    let srcLen = sess["srcLen"]
    let pos = sess["pos"]
    let scol = sess["col"]
    while pos < srcLen {
        cd = char_code_at(src, pos)
        ok = 0
        if cd >= 65 && cd <= 90 { ok = 1 }
        if cd >= 97 && cd <= 122 { ok = 1 }
        if cd >= 48 && cd <= 57 { ok = 1 }
        if cd == 95 { ok = 1 }
        if ok == 0 { break }
        pos = pos + 1
        scol = scol + 1
    }
    sess["pos"] = pos
    sess["col"] = scol
    if pos == start {
        throw "Expected identifier after # at line " + ("" + line) + " col " + ("" + col)
    }
    return lxTok(TOKEN_PRIVATE, str_slice(src, start, pos), line, col)
}

pub fn lxScanString(sess, c, line, col) {
    if c != "\"" {
        return null
    }
    lxEat(sess)
    let start = sess["pos"]
    let i = sess["pos"]
    let hasEsc = 0
    let ch = ""
    while i < sess["srcLen"] {
        ch = char_at(sess["src"], i)
        if ch == "\\" {
            hasEsc = 1
            break
        }
        if ch == "\"" {
            break
        }
        i = i + 1
    }
    if hasEsc == 0 {
        if i >= sess["srcLen"] {
            throw "Unterminated string at line " + ("" + line) + " col " + ("" + col)
        }
        let s = str_slice(sess["src"], start, i)
        sess["col"] = sess["col"] + (i - start) + 1
        sess["pos"] = i + 1
        return lxTok(TOKEN_STRING, s, line, col)
    }
    let s = ""
    while sess["pos"] < sess["srcLen"] {
        ch = char_at(sess["src"], sess["pos"])
        if ch == "\\" {
            lxEat(sess)
            if sess["pos"] >= sess["srcLen"] {
                throw "Unterminated string escape at line " + ("" + line) + " col " + ("" + col)
            }
            let e = char_at(sess["src"], sess["pos"])
            lxEat(sess)
            let piece = "\\" + e
            if e == "n" { piece = "\n" }
            if e == "r" { piece = "\r" }
            if e == "t" { piece = "\t" }
            if e == "\"" { piece = "\"" }
            if e == "\\" { piece = "\\" }
            s = s + piece
            continue
        }
        if ch == "\"" {
            lxEat(sess)
            break
        }
        lxEat(sess)
        s = s + ch
    }
    return lxTok(TOKEN_STRING, s, line, col)
}

// --- lexer_scan_word ---
pub fn lxScanNumber(sess, code0, line, col) {
    if !(code0 >= 48 && code0 <= 57) {
        return null
    }
    let src = sess["src"]
    let srcLen = sess["srcLen"]
    let start = sess["pos"]
    let pos = start + 1
    let scol = sess["col"] + 1
    let cd = 0
    while pos < srcLen {
        cd = char_code_at(src, pos)
        if cd < 48 || cd > 57 {
            break
        }
        pos = pos + 1
        scol = scol + 1
    }
    sess["pos"] = pos
    sess["col"] = scol
    let digits = str_slice(src, start, pos)
    if lxStarts(sess, "n") == 1 {
        lxEat(sess)
        return lxTok(TOKEN_BIGINT, digits, line, col)
    }
    if lxStarts(sess, ".") == 1 {
        lxEat(sess)
        src = sess["src"]
        srcLen = sess["srcLen"]
        pos = sess["pos"]
        scol = sess["col"]
        let fracStart = pos
        while pos < srcLen {
            cd = char_code_at(src, pos)
            if cd < 48 || cd > 57 {
                break
            }
            pos = pos + 1
            scol = scol + 1
        }
        sess["pos"] = pos
        sess["col"] = scol
        let frac = str_slice(src, fracStart, pos)
        return lxTok(TOKEN_FLOAT, parse_float(digits + "." + frac), line, col)
    }
    return lxTok(TOKEN_NUMBER, parse_int(digits), line, col)
}

pub fn lxScanIdent(sess, c, code0, line, col) {
    let src = sess["src"]
    let srcLen = sess["srcLen"]
    let start = sess["pos"]
    let pos = start
    let scol = sess["col"]
    let cd = 0
    let ok = 0
    if c == "_" {
        pos = pos + 1
        scol = scol + 1
        while pos < srcLen {
            cd = char_code_at(src, pos)
            ok = 0
            if cd >= 65 && cd <= 90 { ok = 1 }
            if cd >= 97 && cd <= 122 { ok = 1 }
            if cd >= 48 && cd <= 57 { ok = 1 }
            if cd == 95 { ok = 1 }
            if ok == 0 { break }
            pos = pos + 1
            scol = scol + 1
        }
        sess["pos"] = pos
        sess["col"] = scol
        return lxTok(TOKEN_IDENT, str_slice(src, start, pos), line, col)
    }
    let isAlpha = 0
    if code0 >= 97 && code0 <= 122 { isAlpha = 1 }
    if isAlpha == 0 && code0 >= 65 && code0 <= 90 { isAlpha = 1 }
    if isAlpha == 0 {
        return null
    }
    pos = pos + 1
    scol = scol + 1
    while pos < srcLen {
        cd = char_code_at(src, pos)
        ok = 0
        if cd >= 65 && cd <= 90 { ok = 1 }
        if cd >= 97 && cd <= 122 { ok = 1 }
        if cd >= 48 && cd <= 57 { ok = 1 }
        if cd == 95 { ok = 1 }
        if ok == 0 { break }
        pos = pos + 1
        scol = scol + 1
    }
    sess["pos"] = pos
    sess["col"] = scol
    let id = str_slice(src, start, pos)
    let kw = KEYWORDS[id]
    if kw == undefined {
        return lxTok(TOKEN_IDENT, id, line, col)
    }
    return lxTok(kw, null, line, col)
}

// --- lexer_scan ---
pub fn lxScan(sess) {
    if sess["pos"] >= sess["srcLen"] {
        return lxTok(TOKEN_EOF, null, sess["line"], sess["col"])
    }
    let c = char_at(sess["src"], sess["pos"])
    let line = sess["line"]
    let col = sess["col"]
    let tok = lxScanPunct(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanPlusMinus(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanMulDiv(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanEqBang(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanLogic(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanCmp(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanHash(sess, c, line, col)
    if tok != null { return tok }
    tok = lxScanString(sess, c, line, col)
    if tok != null { return tok }
    if c == BACKTICK {
        throw "Template literal not supported at line " + ("" + line) + " col " + ("" + col)
    }
    let code0 = char_code_at(c, 0)
    tok = lxScanNumber(sess, code0, line, col)
    if tok != null { return tok }
    tok = lxScanIdent(sess, c, code0, line, col)
    if tok != null { return tok }
    throw "Unknown character: " + c + " at line " + ("" + line) + " col " + ("" + col)
}

// SH5: skip + tokenizeExec (was lexer_tokenize).
// SH12: cache src/srcLen/pos locally; reuse gLxSess + in-place token array.
pub fn lxSkipSpace(sess) {
    let src = sess["src"]
    let srcLen = sess["srcLen"]
    let pos = sess["pos"]
    let col = sess["col"]
    let line = sess["line"]
    let cd = 0
    while pos < srcLen {
        cd = char_code_at(src, pos)
        if cd == 32 || cd == 9 || cd == 13 {
            col = col + 1
            pos = pos + 1
            continue
        }
        if cd == 10 {
            line = line + 1
            col = 1
            pos = pos + 1
            continue
        }
        break
    }
    sess["pos"] = pos
    sess["col"] = col
    sess["line"] = line
    return 0
}

pub fn lxSkipLineComment(sess) {
    let src = sess["src"]
    let srcLen = sess["srcLen"]
    let pos = sess["pos"]
    if pos >= srcLen {
        return 0
    }
    if char_at(src, pos) != "/" {
        return 0
    }
    if pos + 1 >= srcLen {
        return 0
    }
    if char_at(src, pos + 1) != "/" {
        return 0
    }
    pos = pos + 2
    let col = sess["col"] + 2
    let line = sess["line"]
    let cd = 0
    while pos < srcLen {
        cd = char_code_at(src, pos)
        if cd == 10 {
            line = line + 1
            col = 1
            pos = pos + 1
            break
        }
        col = col + 1
        pos = pos + 1
    }
    sess["pos"] = pos
    sess["col"] = col
    sess["line"] = line
    return 1
}

pub fn lxSkipBlockComment(sess) {
    let src = sess["src"]
    let srcLen = sess["srcLen"]
    let pos = sess["pos"]
    if pos >= srcLen {
        return 0
    }
    if char_at(src, pos) != "/" {
        return 0
    }
    if pos + 1 >= srcLen {
        return 0
    }
    if char_at(src, pos + 1) != "*" {
        return 0
    }
    pos = pos + 2
    let col = sess["col"] + 2
    let line = sess["line"]
    let cd = 0
    while pos < srcLen {
        cd = char_code_at(src, pos)
        pos = pos + 1
        col = col + 1
        if cd == 10 {
            line = line + 1
            col = 1
        }
        if cd == 42 && pos < srcLen && char_at(src, pos) == "/" {
            pos = pos + 1
            col = col + 1
            break
        }
    }
    sess["pos"] = pos
    sess["col"] = col
    sess["line"] = line
    return 1
}

let gLxSess = null

pub fn tokenizeExec(source) {
    let sess = gLxSess
    if sess == null {
        sess = {
            "pos": 0,
            "src": source,
            "srcLen": len(source),
            "line": 1,
            "col": 1,
            "tokens": []
        }
        gLxSess = sess
    } else {
        sess["pos"] = 0
        sess["src"] = source
        sess["srcLen"] = len(source)
        sess["line"] = 1
        sess["col"] = 1
        object_array_clear(sess, "tokens")
    }
    let srcLen = sess["srcLen"]
    let tok = null
    let n = 0
    let at = 0
    while true {
        n = n + 1
        if n > srcLen + 8 {
            throw "lexer runaway"
        }
        lxSkipSpace(sess)
        if sess["pos"] >= srcLen {
            break
        }
        if lxSkipLineComment(sess) == 1 {
            continue
        }
        if lxSkipBlockComment(sess) == 1 {
            continue
        }
        at = sess["pos"]
        tok = lxScan(sess)
        if sess["pos"] <= at && tok.type != TOKEN_EOF {
            throw "lexer stuck pos=" + ("" + at) + " type=" + ("" + tok.type)
        }
        if tok.type == TOKEN_EOF {
            break
        }
        object_array_push(sess, "tokens", tok)
    }
    object_array_push(sess, "tokens", lxTok(TOKEN_EOF, null, sess["line"], sess["col"]))
    let toks = sess["tokens"]
    sess["tokens"] = []
    return toks
}
