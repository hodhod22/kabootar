import "self_host/vm_s_push"
import "self_host/vm_s_ip"

pub fn runOpMemArrayPopGlobal(S, name, arg, op, pool, globals, functions) {
    if name == "array_pop_global" {
        let arr = S["globals"][arg]
        S["globals"][arg] = pop(arr)
        vPushS(S, null)
        vBumpIpS(S)
        return 1
    }
    return 0
}
