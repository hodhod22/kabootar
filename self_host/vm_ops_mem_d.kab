// P6b: VM mem half-facade d (pop bind + acc add).
import "self_host/vm_ops_mem_array_pop_bind"
import "self_host/vm_ops_mem_acc_add"

pub fn runOpMemD(S, name, arg, op, pool, globals, functions) {
    let st = runOpMemArrayPopBind(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpMemAccAdd(S, name, arg, op, pool, globals, functions)
}
