// H6e: Kabootar bytecode VM subset — thin facade (impl in vm_run.kab).
// import "self_host/vm_impl" (used internally by self_host/vm.kab)
//
// Re-export by alias (not a wrapping fn): a wrapping `fn runModuleImpl` adds an extra
// host `call_value` frame. Under KABOOTAR_VM=kab-only that breaks reentrancy of module
// `vGlobals` when the outer probe is self-host-compiled (lets → globals) and a nested
// guest has imports — see self_host/vm.kab header for the full explanation (that
// facade re-exports this one's `runModuleImpl` again as `runModule`).
//
// vm_run.kab is itself a thin facade now; the heavy body lives in vm_run_body.kab,
// which is the only file on the skip list. Self-host-compiling that ~27KB body
// (runOpMem/Arith/Cmp/Data/Jump/Call/Ctrl dispatch plus runFnBody/runMethodBody/
// vNewInstance) is too slow for CI, and it cannot be sharded further: its ~15 top-
// level fns all share module-level interpreter state (vStack, vLocals, vGlobals,
// vClasses, …) via plain call/return, and Kabootar modules don't share globals
// across files (each import gets its own copy of exported bindings). This facade's
// own source is a two-line import + alias, so `compile self_host/vm_impl.kab
// --self-host` is CI-fast regardless of vm_run_body.kab.

import "self_host/vm_run"

pub let runModuleImpl = runModuleImplCore
