import "self_host/ast_defs"
import "self_host/emit_sym"

pub fn dropCallCallee(E) {
    object_array_pop(E, "eCalleeStack")
    E["eCalleeDepth"] = E["eCalleeDepth"] - 1
}

pub fn emitCallCallee(E) {
    E["eCallee"] = object_array_pop(E, "eCalleeStack")
    E["eCalleeDepth"] = E["eCalleeDepth"] - 1
    eCallExpr(E, E["eCallee"])
}

pub fn emitCallArgExprs(E) {
    E["eCallArgDepth"] = E["eCallArgDepth"] + 1
    let cad = E["eCallArgDepth"]
    while E["eCallArgIStack"][cad - 1] < E["eCallArgNStack"][cad - 1] {
        E["eArgs"] = E["eArgsStack"][cad - 1]
        eCallExpr(E, E["eArgs"][E["eCallArgIStack"][cad - 1]])
        E["eCallArgIStack"][cad - 1] = E["eCallArgIStack"][cad - 1] + 1
    }
    object_array_pop(E, "eArgsStack")
    E["eArgN"] = object_array_pop(E, "eCallArgNStack")
    object_array_pop(E, "eCallArgIStack")
    E["eCallArgDepth"] = E["eCallArgDepth"] - 1
}

pub fn tryEmitLenCall(E, callee, args) {
    if callee.kind != AST_VAR {
        return false
    }
    if callee["sym"] != "len" {
        return false
    }
    if len(args) != 1 {
        return false
    }
    let a0 = args[0]
    if a0.kind == AST_VAR {
        let sym = a0["sym"]
        let li = localSymIndex(E, sym)
        if li >= 0 {
            emitOp(E, OP_LEN_LOCAL, li)
            return true
        }
        let gi = symIndex(E, "global", sym)
        emitOp(E, OP_LEN_GLOBAL, gi)
        return true
    }
    // SH3a: do not clobber outer argv N-path (eArgN/eArgs/eNode) while emitting len(expr).
    let saveArgN = E["eArgN"]
    let saveArgs = E["eArgs"]
    let saveNode = E["eNode"]
    eCallExpr(E, a0)
    emitOp(E, OP_GET_LENGTH, 0)
    E["eArgN"] = saveArgN
    E["eArgs"] = saveArgs
    E["eNode"] = saveNode
    return true
}

// SH11: direct emit for simple AccAdd patterns like "x = x + 1"
pub fn tryEmitAccAddLiteral(E, target, rhs) {
    if target.kind != AST_VAR {
        return false
    }
    if rhs.kind != AST_LITERAL {
        return false
    }
    let val = rhs["value"]
    if val != 1 {
        return false
    }
    let sym = target["sym"]
    let li = localSymIndex(E, sym)
    if li >= 0 {
        emitOp(E, OP_ACC_ADD_LOCAL, li)
        return true
    }
    let gi = symIndex(E, "global", sym)
    emitOp(E, OP_ACC_ADD_GLOBAL, gi)
    return true
}

// SH11: direct emit for IndexGet on local arrays
pub fn tryEmitIndexGetLocal(E, arr, idx) {
    if arr.kind != AST_VAR {
        return false
    }
    if idx.kind != AST_LITERAL {
        return false
    }
    let arrSym = arr["sym"]
    let arrLi = localSymIndex(E, arrSym)
    if arrLi < 0 {
        return false
    }
    let idxVal = idx["value"]
    if idxVal < 0 {
        return false
    }
    let idxLi = localSymIndex(E, "idx")
    if idxLi < 0 {
        return false
    }
    emitOp(E, OP_INDEX_GET_LOCAL, arrLi)
    return true
}

// SH11: direct emit for constant binary operations
pub fn tryEmitConstBinaryOp(E, op, left, right) {
    if left.kind != AST_LITERAL {
        return false
    }
    if right.kind != AST_LITERAL {
        return false
    }
    let leftVal = left["value"]
    let rightVal = right["value"]
    
    // Only optimize simple constant folding for immediate values
    if op == "+" {
        let sum = leftVal + rightVal
        let ci = symIndex(E, "constLit", { "kind": AST_LITERAL, "value": sum })
        emitOp(E, OP_CONST, ci)
        return true
    }
    if op == "-" {
        let diff = leftVal - rightVal
        let ci = symIndex(E, "constLit", { "kind": AST_LITERAL, "value": diff })
        emitOp(E, OP_CONST, ci)
        return true
    }
    if op == "*" {
        let prod = leftVal * rightVal
        let ci = symIndex(E, "constLit", { "kind": AST_LITERAL, "value": prod })
        emitOp(E, OP_CONST, ci)
        return true
    }
    return false
}

// SH11: direct emit for array literal with constant elements
pub fn tryEmitConstArrayLiteral(E, elements) {
    if len(elements) == 0 {
        return false
    }
    let allConst = 1
    let i = 0
    while i < len(elements) {
        if elements[i].kind != AST_LITERAL {
            allConst = 0
        }
        i = i + 1
    }
    if allConst == 0 {
        return false
    }
    // For small constant arrays, we could pre-allocate
    if len(elements) <= 4 {
        emitOp(E, OP_MAKE_ARRAY, len(elements))
        let j = 0
        while j < len(elements) {
            let ci = symIndex(E, "constLit", elements[j])
            emitOp(E, OP_CONST, ci)
            j = j + 1
        }
        return true
    }
    return false
}

// SH11: direct emit for simple string comparisons
pub fn tryEmitStringEqLiteral(E, left, right) {
    if left.kind != AST_VAR {
        return false
    }
    if right.kind != AST_LITERAL {
        return false
    }
    let sym = left["sym"]
    let li = localSymIndex(E, sym)
    if li >= 0 {
        emitOp(E, OP_LOAD_LOCAL, li)
        let ci = symIndex(E, "constLit", right)
        emitOp(E, OP_CONST, ci)
        emitOp(E, OP_EQ, 0)
        return true
    }
    let gi = symIndex(E, "global", sym)
    emitOp(E, OP_LOAD_GLOBAL, gi)
    let ci = symIndex(E, "constLit", right)
    emitOp(E, OP_CONST, ci)
    emitOp(E, OP_EQ, 0)
    return true
}

// SH11: direct emit for array.length property access
pub fn tryEmitArrayLengthProperty(E, obj, prop) {
    if obj.kind != AST_VAR {
        return false
    }
    if prop.kind != AST_LITERAL {
        return false
    }
    if prop["value"] != "length" {
        return false
    }
    let sym = obj["sym"]
    let li = localSymIndex(E, sym)
    if li >= 0 {
        emitOp(E, OP_LEN_LOCAL, li)
        return true
    }
    let gi = symIndex(E, "global", sym)
    emitOp(E, OP_LEN_GLOBAL, gi)
    return true
}

// SH11: direct emit for simple array.pop() pattern
pub fn tryEmitArrayPopPattern(E, callee, args) {
    if callee.kind != AST_MEMBER {
        return false
    }
    let obj = callee["object"]
    let prop = callee["property"]
    if prop.kind != AST_VAR {
        return false
    }
    if prop["sym"] != "pop" {
        return false
    }
    if len(args) != 0 {
        return false
    }
    if obj.kind != AST_VAR {
        return false
    }
    let sym = obj["sym"]
    let li = localSymIndex(E, sym)
    if li >= 0 {
        emitOp(E, OP_ARRAY_POP_LOCAL, li)
        return true
    }
    let gi = symIndex(E, "global", sym)
    emitOp(E, OP_ARRAY_POP_GLOBAL, gi)
    return true
}

// SH11: direct emit for simple negation pattern
pub fn tryEmitSimpleNegation(E, expr) {
    if expr.kind != AST_UNARY {
        return false
    }
    if expr["op"] != "-" {
        return false
    }
    let operand = expr["operand"]
    if operand.kind != AST_LITERAL {
        return false
    }
    let val = operand["value"]
    let negated = -val
    let ci = symIndex(E, "constLit", { "kind": AST_LITERAL, "value": negated })
    emitOp(E, OP_CONST, ci)
    return true
}

let eCallRetFast = 0

pub fn emitCallArgFast(E, argNode) {
    if argNode.kind == AST_LITERAL {
        eCallRetFast = symIndex(E, "constLit", argNode)
        E["eIdx"] = eCallRetFast
        emitOp(E, OP_CONST, eCallRetFast)
        return 0
    }
    if argNode.kind == AST_VAR {
        E["eSym"] = argNode["sym"]
        emitSym(E, 0, E["eSym"])
        return 0
    }
    eCallExpr(E, argNode)
    return 0
}

pub fn emitCallArgsHaveSpread(args) {
    let i = 0
    while i < len(args) {
        if args[i].kind == AST_SPREAD {
            return 1
        }
        i = i + 1
    }
    return 0
}

pub fn emitCallArgsFlushPending(E, pending, have) {
    if len(pending) == 0 {
        return have
    }
    let pi = 0
    while pi < len(pending) {
        emitCallArgFast(E, pending[pi])
        pi = pi + 1
    }
    emitOp(E, OP_MAKE_ARRAY, len(pending))
    if have == 1 {
        emitOp(E, OP_CONCAT_ARRAY, 0)
    }
    return 1
}

pub fn emitCallArgsAsArray(E, args) {
    let have = 0
    let pending = []
    let i = 0
    while i < len(args) {
        let a = args[i]
        if a.kind == AST_SPREAD {
            have = emitCallArgsFlushPending(E, pending, have)
            pending = []
            eCallExpr(E, a["expr"])
            if have == 1 {
                emitOp(E, OP_CONCAT_ARRAY, 0)
            }
            have = 1
        } else {
            pending = push(pending, a)
        }
        i = i + 1
    }
    have = emitCallArgsFlushPending(E, pending, have)
    if have == 0 {
        emitOp(E, OP_MAKE_ARRAY, 0)
    }
}

pub fn emitExpr_callSpread(E) {
    emitCallArgsAsArray(E, E["eArgs"])
    let callee = E["eCallee"]
    if callee.kind == AST_VAR {
        let ci = symIndex(E, "class", callee["sym"])
        if ci >= 0 {
            emitOp(E, OP_NEW_INSTANCE_FROM_ARRAY, ci)
            dropCallCallee(E)
            E["_callDone"] = 1
            return 0
        }
    }
    emitCallCallee(E)
    emitOp(E, OP_SWAP, 0)
    emitOp(E, OP_CALL_FROM_ARRAY, 0)
    E["_callDone"] = 1
    return 0
}

// --- emit_expr_array ---
pub fn emitExpr_array(E) {
    if E["eNode"].kind != AST_ARRAY {
        return false
    }
        // P6b: E["eArrDepth"] avoids len(E["eArrIStack"]) clones + pop/push per elem.
        let arrElems = E["eNode"]["elems"]
        if emitCallArgsHaveSpread(arrElems) == 1 {
            emitCallArgsAsArray(E, arrElems)
            return true
        }
        object_array_push(E, "eArrIStack", 0)
        arrUtil(E, "pushLenKey", "eArrNStack", arrElems)
        E["eArrDepth"] = E["eArrDepth"] + 1
        let ad = E["eArrDepth"]
        while E["eArrIStack"][ad - 1] < E["eArrNStack"][ad - 1] {
            E["eObjI"] = E["eArrIStack"][ad - 1]
            eCallExpr(E, arrElems[E["eObjI"]])
            E["eArrIStack"][ad - 1] = E["eArrIStack"][ad - 1] + 1
        }
        object_array_pop(E, "eArrIStack")
        object_array_pop(E, "eArrNStack")
        E["eArrDepth"] = E["eArrDepth"] - 1
        emitOp(E, OP_MAKE_ARRAY, len(arrElems))
        return true
    return true
}

// --- emit_expr_arrow ---
pub fn emitExpr_arrow(E) {
    if E["eNode"].kind != AST_ARROW {
        return false
    }
        let aParams = E["eNode"]["params"]
        let aBody = E["eNode"]["body"]
        let saveIn = E["eInFn"]
        let saveOps = arrUtil(E, "snap", E["eFnOps"])
        let saveFnOpsN = E["eFnOpsN"]
        let saveLocals = arrUtil(E, "snap", E["eFnLocals"])
        let saveGlobals = arrUtil(E, "snap", E["eFnGlobals"])
        let saveTry = arrUtil(E, "snap", E["eFnTryRegions"])
        E["eInFn"] = 1
        E["eFnOps"] = []
        E["eFnOpsN"] = 0
        E["eFnLocals"] = []
        resetLocalMap(E)
        E["eFnGlobals"] = []
        E["eFnTryRegions"] = []
        let api = 0
        while api < len(aParams) {
            symIndex(E, "local", aParams[api])
            api = api + 1
        }
        emitFnMarkRest(E, E["eNode"]["rest"])
        emitFnParamDefaults(E, aParams, E["eNode"]["paramDefaults"])
        if aBody.kind == AST_BLOCK {
            eCallStmt(E, aBody)
        } else {
            eCallExpr(E, aBody)
            emitOp(E, OP_RETURN, 0)
        }
        let ai = len(E["eArrows"])
        let arrowSym = "__arrow_" + ai
        E["eArrows"] = push(E["eArrows"], {
            "sym": arrowSym,
            "params": arrUtil(E, "snap", aParams),
            "locals": arrUtil(E, "snap", E["eFnLocals"]),
            "ops": arrUtil(E, "snap", E["eFnOps"]),
            "tryRegions": arrUtil(E, "snap", E["eFnTryRegions"])
        })
        E["eInFn"] = saveIn
        E["eFnOps"] = saveOps
        E["eFnOpsN"] = saveFnOpsN
        E["eFnLocals"] = saveLocals
        rebuildLocalMap(E)
        E["eFnGlobals"] = saveGlobals
        E["eFnTryRegions"] = saveTry
        emitOp(E, OP_MAKE_ARROW, ai)
        return true
    return true
}

// --- emit_expr_binary_ac ---
pub fn emitExpr_binaryArith(E, binOp) {
    if binOp == "+" {
        emitOp(E, OP_ADD, 0)
        return 1
    }
    if binOp == "-" {
        emitOp(E, OP_SUB, 0)
        return 1
    }
    if binOp == "*" {
        emitOp(E, OP_MUL, 0)
        return 1
    }
    if binOp == "/" {
        emitOp(E, OP_DIV, 0)
        return 1
    }
    if binOp == "%" {
        emitOp(E, OP_MOD, 0)
        return 1
    }
    if binOp == "**" {
        emitOp(E, OP_POW, 0)
        return 1
    }
    return 0
}

pub fn emitExpr_binaryCmp(E, binOp) {
    if binOp == "==" {
        emitOp(E, OP_EQ, 0)
        return 1
    }
    if binOp == "!=" {
        emitOp(E, OP_NE, 0)
        return 1
    }
    if binOp == "<" {
        emitOp(E, OP_LT, 0)
        return 1
    }
    if binOp == ">" {
        emitOp(E, OP_GT, 0)
        return 1
    }
    if binOp == ">=" {
        emitOp(E, OP_GE, 0)
        return 1
    }
    if binOp == "<=" {
        emitOp(E, OP_LE, 0)
        return 1
    }
    if binOp == "in" {
        emitOp(E, OP_IN, 0)
        return 1
    }
    if binOp == "is" {
        emitSym(E, 0, "object_is")
        emitOp(E, OP_CALL, 2)
        return 1
    }
    if binOp == "is not" {
        emitSym(E, 0, "object_is")
        emitOp(E, OP_CALL, 2)
        emitOp(E, OP_NOT, 0)
        return 1
    }
    return 0
}

// --- emit_expr_binary_lb ---
pub fn emitExpr_binaryLogic(E, binOp) {
    if binOp == "&&" {
        emitOp(E, OP_AND, 0)
        return 1
    }
    if binOp == "||" {
        emitOp(E, OP_OR, 0)
        return 1
    }
    return 0
}

pub fn emitExpr_binaryBit(E, binOp) {
    if binOp == "&" {
        emitOp(E, OP_BIT_AND, 0)
        return 1
    }
    if binOp == "|" {
        emitOp(E, OP_BIT_OR, 0)
        return 1
    }
    if binOp == "^" {
        emitOp(E, OP_BIT_XOR, 0)
        return 1
    }
    if binOp == "<<" {
        emitOp(E, OP_SHL, 0)
        return 1
    }
    if binOp == ">>" {
        emitOp(E, OP_SHR, 0)
        return 1
    }
    if binOp == ">>>" {
        emitOp(E, OP_USHR, 0)
        return 1
    }
    return 0
}

// --- emit_expr_call_argv_n ---
pub fn emitExpr_callArgvN(E) {
    object_array_push(E, "eCallArgIStack", 0)
    object_array_push(E, "eCallArgNStack", E["eArgN"])
    object_array_push(E, "eArgsStack", E["eArgs"])
    E["eCallArgDepth"] = E["eCallArgDepth"] + 1
    let cad = E["eCallArgDepth"]
    while E["eCallArgIStack"][cad - 1] < E["eCallArgNStack"][cad - 1] {
        E["eArgs"] = E["eArgsStack"][cad - 1]
        E["eCallI"] = E["eCallArgIStack"][cad - 1]
        emitCallArgFast(E, E["eArgs"][E["eCallI"]])
        E["eCallArgIStack"][cad - 1] = E["eCallArgIStack"][cad - 1] + 1
    }
    object_array_pop(E, "eArgsStack")
    E["eArgN"] = object_array_pop(E, "eCallArgNStack")
    object_array_pop(E, "eCallArgIStack")
    E["eCallArgDepth"] = E["eCallArgDepth"] - 1
    emitCallCallee(E)
    emitOp(E, OP_CALL, E["eArgN"])
    E["_callDone"] = 1
    return 0
}

// --- emit_expr_call_argv_small ---
pub fn emitExpr_callArgvSmall(E) {
    if E["eArgN"] == 0 {
        emitCallCallee(E)
        emitOp(E, OP_CALL, 0)
        E["_callDone"] = 1
        return 0
    }
    if E["eArgN"] == 1 {
        emitCallArgFast(E, E["eArgs"][0])
        emitCallCallee(E)
        emitOp(E, OP_CALL, 1)
        E["_callDone"] = 1
        return 0
    }
    if E["eArgN"] == 2 {
        emitCallArgFast(E, E["eArgs"][0])
        emitCallArgFast(E, E["eArgs"][1])
        emitCallCallee(E)
        emitOp(E, OP_CALL, 2)
        E["_callDone"] = 1
        return 0
    }
    return 1
}

// --- emit_expr_call_ctor_ops ---
pub fn emitExpr_callCtorOkErr(E, ctorName) {
    if ctorName == "Ok" {
        eCallExpr(E, E["eArgs"][0])
        emitOp(E, OP_MAKE_OK, 0)
        object_array_pop(E, "eCalleeStack")
        E["eCalleeDepth"] = E["eCalleeDepth"] - 1
        E["_callDone"] = 1
        return 1
    }
    if ctorName == "Err" {
        eCallExpr(E, E["eArgs"][0])
        emitOp(E, OP_MAKE_ERR, 0)
        object_array_pop(E, "eCalleeStack")
        E["eCalleeDepth"] = E["eCalleeDepth"] - 1
        E["_callDone"] = 1
        return 1
    }
    return 0
}

pub fn emitExpr_callCtorSome(E, ctorName) {
    if ctorName != "Some" {
        return 0
    }
    eCallExpr(E, E["eArgs"][0])
    emitOp(E, OP_MAKE_SOME, 0)
    object_array_pop(E, "eCalleeStack")
    E["eCalleeDepth"] = E["eCalleeDepth"] - 1
    E["_callDone"] = 1
    return 1
}

pub fn emitCheckWhere(E) {
    let src = E["eWhereSrc"]
    if src == undefined || src == null {
        src = E["eGenTmpl"]
    }
    if src == null {
        return 0
    }
    let clause = src["whereClause"]
    if clause == undefined {
        return 0
    }
    if len(clause) == 0 {
        return 0
    }
    let tparams = src["typeParams"]
    if tparams == undefined {
        tparams = []
    }
    let bi = 0
    while bi < len(clause) {
        let bound = clause[bi]
        let tp = bound["typeParam"]
        let tr = bound["traitName"]
        let idx = 0
        let foundTp = 0
        while idx < len(tparams) {
            if tparams[idx] == tp {
                foundTp = 1
                break
            }
            idx = idx + 1
        }
        if foundTp == 0 {
            let whereUnkMsg = "where: unknown type parameter " + tp
            throw whereUnkMsg
        }
        if idx >= len(E["eTypeArgs"]) {
            let whereMissMsg = "where: missing concrete type for " + tp
            throw whereMissMsg
        }
        let ty = E["eTypeArgs"][idx]
        let impls = E["eTraitImpls"][ty]
        if impls == undefined {
            let dollar = str_index_of("" + ty, "$")
            if dollar > 0 {
                impls = E["eTraitImpls"][str_slice("" + ty, 0, dollar)]
            }
        }
        if impls == undefined {
            impls = []
        }
        let ok = 0
        let ji = 0
        while ji < len(impls) {
            if impls[ji] == tr {
                ok = 1
            }
            ji = ji + 1
        }
        if ok == 0 {
            let whereMsg = "where: type " + ty + " does not implement " + tr + " (required by where " + tp + " : " + tr + ")"
            throw whereMsg
        }
        bi = bi + 1
    }
    return 0
}

// --- emit_expr_call_h2_spec ---
// Specialize generic function template to E["eMangled"] if missing.
pub fn emitExpr_call_h2_spec(E) {
    emitCheckWhere(E)
    E["eFound"] = 0
    E["eGenI"] = 0
    while E["eGenI"] < len(E["eSpecMangled"]) {
        if E["eSpecMangled"][E["eGenI"]] == E["eMangled"] {
            E["eFound"] = 1
            break
        }
        E["eGenI"] = E["eGenI"] + 1
    }
    if E["eFound"] != 0 {
        return 0
    }
    emitFnScopeSave(E)
    E["eFnSave"] = E["eMangled"]
    E["eParams"] = E["eGenTmpl"]["params"]
    E["eParamDefaults"] = E["eGenTmpl"]["paramDefaults"]
    E["eFnRest"] = E["eGenTmpl"]["rest"]
    E["eFnBody"] = E["eGenTmpl"]["body"]
    emitFnCompileBody(E)
    E["eFunctions"] = push(E["eFunctions"], {
        "sym": E["eFnSave"],
        "params": arrUtil(E, "snap", E["eParams"]),
        "locals": arrUtil(E, "snap", E["eFnLocals"]),
        "globals": arrUtil(E, "snap", E["eFnGlobals"]),
        "ops": arrUtil(E, "snap", E["eFnOps"])
    })
    symIndex(E, "global", E["eFnSave"])
    E["eSpecMangled"] = push(E["eSpecMangled"], E["eMangled"])
    emitFnScopeRestore(E)
    return 0
}

// --- emit_expr_call_h3_parent ---
// Resolve Child<T> extends Base<T> against concrete eTypeArgs, specialize parent first.
pub fn emitSpecializeParentClass(E) {
    let parentBase = E["eGenTmpl"]["extends"]
    if parentBase == undefined {
        E["eParentMangled"] = ""
        return 0
    }
    if parentBase == "" {
        E["eParentMangled"] = ""
        return 0
    }
    let etargs = E["eGenTmpl"]["extendsTypeArgs"]
    if etargs == undefined {
        etargs = []
    }
    let tparams = E["eGenTmpl"]["typeParams"]
    if tparams == undefined {
        tparams = []
    }
    let resolved = []
    if len(etargs) == 0 {
        E["eParentMangled"] = parentBase
    } else {
        let ai = 0
        while ai < len(etargs) {
            let arg = etargs[ai]
            let found = 0
            let idx = 0
            while idx < len(tparams) {
                if tparams[idx] == arg {
                    if idx < len(E["eTypeArgs"]) {
                        resolved = push(resolved, E["eTypeArgs"][idx])
                        found = 1
                    }
                }
                idx = idx + 1
            }
            if found == 0 {
                resolved = push(resolved, arg)
            }
            ai = ai + 1
        }
        let saveTA = E["eTypeArgs"]
        E["eTypeArgs"] = resolved
        E["eParentMangled"] = parentBase
        emitMangleWithTypeArgs(E, "eParentMangled")
        E["eTypeArgs"] = saveTA
    }
    let pTmpl = null
    let gi = 0
    while gi < len(E["eGenericClassTemplates"]) {
        if E["eGenericClassTemplates"][gi]["sym"] == parentBase {
            pTmpl = E["eGenericClassTemplates"][gi]
        }
        gi = gi + 1
    }
    if pTmpl != null {
        let saveTmpl = E["eGenTmpl"]
        let saveMang = E["eMangled"]
        let saveTA2 = E["eTypeArgs"]
        let saveParent = E["eParentMangled"]
        E["eGenTmpl"] = pTmpl
        E["eMangled"] = E["eParentMangled"]
        if len(etargs) > 0 {
            E["eTypeArgs"] = resolved
        }
        emitExpr_call_h3_gen(E)
        E["eGenTmpl"] = saveTmpl
        E["eMangled"] = saveMang
        E["eTypeArgs"] = saveTA2
        E["eParentMangled"] = saveParent
    }
    return 0
}

// --- emit_expr_call_h3_gen ---
pub fn emitExpr_call_h3_gen(E) {
    E["eFound"] = 0
    E["eGenI"] = 0
    while E["eGenI"] < E["eClassesN"] {
        if E["eClasses"][E["eGenI"]]["sym"] == E["eMangled"] {
            E["eFound"] = 1
            break
        }
        E["eGenI"] = E["eGenI"] + 1
    }
    if E["eFound"] != 0 {
        return 0
    }
    emitSpecializeParentClass(E)
    E["eClassIsStruct"] = E["eGenTmpl"]["isStruct"]
    if E["eClassIsStruct"] == undefined {
        E["eClassIsStruct"] = 0
    }
    E["eClassMethods"] = []
    E["eMi"] = 0
    while E["eMi"] < len(E["eGenTmpl"]["methods"]) {
        E["eMeth"] = E["eGenTmpl"]["methods"][E["eMi"]]
        emitGenClassMeth(E)
        E["eMi"] = E["eMi"] + 1
    }
    let specFields = E["eGenTmpl"]["fields"]
    if specFields == undefined {
        specFields = []
    }
    let specImpl = E["eGenTmpl"]["implements"]
    if specImpl == undefined {
        specImpl = []
    }
    let specAssoc = E["eGenTmpl"]["associatedTypes"]
    if specAssoc == undefined {
        specAssoc = []
    }
    let specExtends = E["eParentMangled"]
    if specExtends == undefined {
        specExtends = ""
    }
    E["eClasses"] = push(E["eClasses"], {
        "sym": E["eMangled"],
        "methods": E["eClassMethods"],
        "fields": emitSubstClassFields(E, specFields),
        "implements": arrUtil(E, "snap", specImpl),
        "associatedTypes": arrUtil(E, "snap", specAssoc),
        "isStruct": E["eClassIsStruct"],
        "extends": specExtends
    })
    if len(specImpl) > 0 {
        let implMap = E["eTraitImpls"]
        if implMap == undefined {
            implMap = {}
        }
        implMap[E["eMangled"]] = specImpl
        E["eTraitImpls"] = implMap
    }
    E["eClassesN"] = E["eClassesN"] + 1
    symIndex(E, "global", E["eMangled"])
    return 0
}

// --- emit_expr_call_h3_inst ---
let eCallRet = 0

// Emit ctor args + NEW_INSTANCE for specialized class call.
pub fn emitExpr_call_h3_inst(E) {
    object_array_push(E, "eCallArgIStack", 0)
    object_array_push(E, "eCallArgNStack", E["eArgN"])
    object_array_push(E, "eArgsStack", E["eArgs"])
    emitCallArgExprs(E)
    eCallRet = symIndex(E, "class", E["eMangled"])
    E["eClassIdx"] = eCallRet
    if E["eClassIdx"] < 0 {
        throw "Missing specialized class " + E["eMangled"]
    }
    if E["eInFn"] == 1 {
        object_array_push(E, "eFnOps", { "op": OP_NEW_INSTANCE, "arg": E["eClassIdx"], "arg2": E["eArgN"] })
        E["eFnOpsN"] = E["eFnOpsN"] + 1
    } else {
        object_array_push(E, "eOps", { "op": OP_NEW_INSTANCE, "arg": E["eClassIdx"], "arg2": E["eArgN"] })
        E["eOpsN"] = E["eOpsN"] + 1
    }
    dropCallCallee(E)
    E["_callDone"] = 1
    return 0
}

// --- emit_expr_call_h5_do_install ---
// Compile + attach one specialized method to E["eRecvClass"] at E["eClassIdx"].
pub fn emitExpr_call_h5_do_install(E) {
    let saveArgN = E["eArgN"]
    let saveArgs = E["eArgs"]
    emitFnScopeSave(E)
    E["eParams"] = E["eMethTmpl"]["params"]
    E["eFnBody"] = E["eMethTmpl"]["body"]
    E["eFnRest"] = E["eMethTmpl"]["rest"]
    E["eParamDefaults"] = E["eMethTmpl"]["paramDefaults"]
    emitFnCompileBody(E)
    let classes = E["eClasses"]
    let cls = classes[E["eClassIdx"]]
    let methods = arrUtil(E, "snap", cls["methods"])
    methods = push(methods, {
        "sym": E["eMethodMangled"],
        "params": arrUtil(E, "snap", E["eParams"]),
        "locals": arrUtil(E, "snap", E["eFnLocals"]),
        "globals": arrUtil(E, "snap", E["eFnGlobals"]),
        "constants": arrUtil(E, "snap", E["eConsts"]),
        "ops": arrUtil(E, "snap", E["eFnOps"])
    })
    cls["methods"] = methods
    classes[E["eClassIdx"]] = cls
    E["eClasses"] = classes
    emitFnScopeRestore(E)
    E["eArgN"] = saveArgN
    E["eArgs"] = saveArgs
    return 0
}

// --- emit_expr_call_h5_emit ---
// Emit receiver + GET_MEMBER + CALL for specialized method.
pub fn emitExpr_call_h5_emit(E) {
    let saveArgN = E["eArgN"]
    let saveArgs = E["eArgs"]
    object_array_push(E, "eCallArgIStack", 0)
    object_array_push(E, "eCallArgNStack", saveArgN)
    object_array_push(E, "eArgsStack", saveArgs)
    emitCallArgExprs(E)
    eCallExpr(E, E["eMemObj"])
    eCallRet = symIndex(E, "const", E["eMethodMangled"])
    E["eIdx"] = eCallRet
    emitOp(E, OP_GET_MEMBER, eCallRet)
    emitOp(E, OP_CALL, saveArgN)
    dropCallCallee(E)
    E["_callDone"] = 1
    return 0
}

// --- emit_expr_call_h7 ---
let eCallRet2 = 0

pub fn emitEnsureSpecializedEnum(E) {
    E["eFound"] = 0
    E["eGenI"] = 0
    while E["eGenI"] < len(E["eEnums"]) {
        if E["eEnums"][E["eGenI"]]["sym"] == E["eMangled"] {
            E["eFound"] = 1
            break
        }
        E["eGenI"] = E["eGenI"] + 1
    }
    if E["eFound"] == 0 {
        let vars = E["eGenTmpl"]["variants"]
        if vars == undefined {
            vars = []
        }
        E["eEnums"] = push(E["eEnums"], {
            "sym": E["eMangled"],
            "variants": emitSubstEnumVariants(E, vars)
        })
        symIndex(E, "global", E["eMangled"])
    }
    return 0
}

pub fn emitExpr_call_h7(E) {
    let saveArgN = E["eArgN"]
    let saveArgs = E["eArgs"]
    emitResolveTypeArgsMem(E, "eArgs", E["eGenSym"], 0)
    E["eMangled"] = E["eGenSym"]
    emitMangleWithTypeArgs(E, "eMangled")
    emitEnsureSpecializedEnum(E)
    object_array_push(E, "eCallArgIStack", 0)
    object_array_push(E, "eCallArgNStack", saveArgN)
    object_array_push(E, "eArgsStack", saveArgs)
    emitCallArgExprs(E)
    emitSym(E, 0, E["eMangled"])
    eCallRet = symIndex(E, "const", E["eMemFld"])
    E["eIdx"] = eCallRet
    emitOp(E, OP_GET_MEMBER, eCallRet)
    emitOp(E, OP_CALL, saveArgN)
    dropCallCallee(E)
    E["_callDone"] = 1
    return 0
}

// --- emit_expr_index ---
pub fn emitExpr_index(E) {
    if E["eNode"].kind != AST_INDEX {
        return false
    }
        // P6b: name[i] → IndexGetLocal/Global (clone element only).
        E["eBxL"] = E["eNode"]["object"]
        if E["eBxL"].kind == AST_VAR {
            object_array_push(E, "eIndexStack", E["eNode"]["index"])
            E["eIndexDepth"] = E["eIndexDepth"] + 1
            eCallExpr(E, E["eIndexStack"][E["eIndexDepth"] - 1])
            object_array_pop(E, "eIndexStack")
            E["eIndexDepth"] = E["eIndexDepth"] - 1
            E["eSym"] = E["eBxL"]["sym"]
            let ili = localSymIndex(E, E["eSym"])
            if ili >= 0 {
                emitOp(E, OP_INDEX_GET_LOCAL, ili)
                return true
            }
            let igi = symIndex(E, "global", E["eSym"])
            emitOp(E, OP_INDEX_GET_GLOBAL, igi)
            return true
        }
        // P6b: E["eIndexDepth"] avoids len(E["eIndexStack"]) LoadGlobal clone.
        object_array_push(E, "eIndexStack", E["eNode"]["index"])
        E["eIndexDepth"] = E["eIndexDepth"] + 1
        eCallExpr(E, E["eNode"]["object"])
        eCallExpr(E, E["eIndexStack"][E["eIndexDepth"] - 1])
        object_array_pop(E, "eIndexStack")
        E["eIndexDepth"] = E["eIndexDepth"] - 1
        emitOp(E, OP_INDEX_GET, 0)
        return true
    return true
}

// --- emit_expr_literal ---
pub fn emitExpr_literal(E) {
    if E["eNode"].kind != AST_LITERAL {
        return false
    }
        eCallRet = symIndex(E, "constLit",E["eNode"])
        E["eIdx"] = eCallRet
        emitOp(E, OP_CONST, eCallRet)
        return true
    return true
}

// --- emit_expr_member ---
let eMemTypeArgs = null


pub fn emitExpr_member(E) {
    if E["eNode"].kind != AST_MEMBER {
        return false
    }
        // P6b: E["eMemberDepth"] avoids len(E["eMemberFldStack"]) LoadGlobal clone.
        E["eBxL"] = E["eNode"]["object"]
        object_array_push(E, "eMemberFldStack", E["eNode"]["field"])
        E["eMemberDepth"] = E["eMemberDepth"] + 1
        eMemTypeArgs = E["eNode"]["typeArgs"]
        if eMemTypeArgs == undefined {
            eMemTypeArgs = []
        }
        if E["eBxL"].kind == AST_VAR {
            E["eGenSym"] = E["eBxL"]["sym"]
            E["eFound"] = 0
            E["eGenI"] = 0
            while E["eGenI"] < len(E["eGenericEnumTemplates"]) {
                if E["eGenericEnumTemplates"][E["eGenI"]]["sym"] == E["eGenSym"] {
                    E["eGenTmpl"] = E["eGenericEnumTemplates"][E["eGenI"]]
                    E["eFound"] = 1
                    break
                }
                E["eGenI"] = E["eGenI"] + 1
            }
            if E["eFound"] == 1 {
                if len(eMemTypeArgs) > 0 {
                    E["eTypeArgs"] = arrUtil(E, "snap",eMemTypeArgs)
                    E["eMangled"] = E["eGenSym"]
                    emitMangleWithTypeArgs(E, "eMangled")
                    emitEnsureSpecializedEnum(E)
                    emitSym(E, 0, E["eMangled"])
                    E["eMemberFld"] = object_array_pop(E, "eMemberFldStack")
                    E["eMemberDepth"] = E["eMemberDepth"] - 1
                    eCallRet = symIndex(E, "const", E["eMemberFld"])
                    E["eIdx"] = eCallRet
                    emitOp(E, OP_GET_MEMBER, eCallRet)
                    return true
                }
            }
        }
        if E["eBxL"].kind == AST_SUPER {
            E["eMemberFld"] = object_array_pop(E, "eMemberFldStack")
            E["eMemberDepth"] = E["eMemberDepth"] - 1
            eCallRet = symIndex(E, "const", E["eMemberFld"])
            E["eIdx"] = eCallRet
            emitOp(E, OP_GET_SUPER_METHOD, eCallRet)
            return true
        }
        eCallExpr(E, E["eBxL"])
        E["eMemberFld"] = object_array_pop(E, "eMemberFldStack")
        E["eMemberDepth"] = E["eMemberDepth"] - 1
        eCallRet = symIndex(E, "const",E["eMemberFld"])
        E["eIdx"] = eCallRet
        emitOp(E, OP_GET_MEMBER, eCallRet)
        return true
    return true
}

pub fn emitExpr_optional_member(E) {
    if E["eNode"].kind != AST_OPTIONAL_MEMBER {
        return false
    }
    let optObj = E["eNode"]["object"]
    let optFld = E["eNode"]["field"]
    eCallExpr(E, optObj)
    eCallRet = symIndex(E, "const", optFld)
    emitOp(E, OP_CONST, eCallRet)
    emitSym(E, 0, "__opt_member")
    emitOp(E, OP_CALL, 2)
    return true
}

pub fn emitExpr_optional_index(E) {
    if E["eNode"].kind != AST_OPTIONAL_INDEX {
        return false
    }
    let optObj = E["eNode"]["object"]
    let optIdx = E["eNode"]["index"]
    eCallExpr(E, optObj)
    eCallExpr(E, optIdx)
    emitSym(E, 0, "__opt_index")
    emitOp(E, OP_CALL, 2)
    return true
}

pub fn emitExpr_optional_call(E) {
    if E["eNode"].kind != AST_OPTIONAL_CALL {
        return false
    }
    let optCallee = E["eNode"]["callee"]
    let optArgs = E["eNode"]["args"]
    eCallExpr(E, optCallee)
    let jumpKeep = opsLen(E)
    emitOp(E, OP_JUMP_IF_NOT_NULLISH, 0)
    emitOp(E, OP_POP, 0)
    let ui = symIndex(E, "const", KAB_UNDEF_CONST)
    emitOp(E, OP_CONST, ui)
    let jumpEnd = opsLen(E)
    emitOp(E, OP_JUMP, 0)
    patchJumpAt(E, jumpKeep)
    let oi = 0
    while oi < len(optArgs) {
        eCallExpr(E, optArgs[oi])
        oi = oi + 1
    }
    emitOp(E, OP_CALL, len(optArgs))
    patchJumpAt(E, jumpEnd)
    return true
}

pub fn emitObjFieldsHaveComputed(fields) {
    let i = 0
    while i < len(fields) {
        if fields[i].kind == AST_COMPUTED {
            return 1
        }
        i = i + 1
    }
    return 0
}

pub fn emitObjFieldsHaveSpread(fields) {
    let i = 0
    while i < len(fields) {
        if fields[i].kind == AST_SPREAD {
            return 1
        }
        i = i + 1
    }
    return 0
}

pub fn emitObjFieldsFlushPending(E, pending, have) {
    if len(pending) == 0 {
        return have
    }
    let pi = 0
    while pi < len(pending) {
        eCallExpr(E, pending[pi]["value"])
        let ci = symIndex(E, "const", pending[pi]["key"])
        emitOp(E, OP_CONST, ci)
        pi = pi + 1
    }
    emitOp(E, OP_MAKE_OBJECT, len(pending))
    if have == 1 {
        emitOp(E, OP_MERGE_OBJECT, 0)
    }
    return 1
}

pub fn emitObjFieldsAsObject(E, fields) {
    let have = 0
    let pending = []
    let i = 0
    while i < len(fields) {
        let f = fields[i]
        if f.kind == AST_SPREAD {
            have = emitObjFieldsFlushPending(E, pending, have)
            pending = []
            eCallExpr(E, f["expr"])
            if have == 1 {
                emitOp(E, OP_MERGE_OBJECT, 0)
            }
            have = 1
        } else {
            if f.kind == AST_COMPUTED {
                have = emitObjFieldsFlushPending(E, pending, have)
                pending = []
                if have == 0 {
                    emitOp(E, OP_MAKE_OBJECT, 0)
                    have = 1
                }
                eCallExpr(E, f["key"])
                eCallExpr(E, f["value"])
                emitOp(E, OP_INDEX_SET, 0)
                emitOp(E, OP_POP, 0)
            } else {
                pending = push(pending, f)
            }
        }
        i = i + 1
    }
    have = emitObjFieldsFlushPending(E, pending, have)
    if have == 0 {
        emitOp(E, OP_MAKE_OBJECT, 0)
    }
}

// --- emit_expr_object ---
pub fn emitExpr_object(E) {
    if E["eNode"].kind != AST_OBJECT {
        return false
    }
        // Use fn-local field list — nested array/object emit must not clobber a shared E["eList"].
        // P6b: E["eObjDepth"] avoids len(E["eObjIStack"]) clones + pop/push per field.
        let objFields = E["eNode"]["fields"]
        if emitObjFieldsHaveSpread(objFields) == 1 || emitObjFieldsHaveComputed(objFields) == 1 {
            emitObjFieldsAsObject(E, objFields)
            return true
        }
        object_array_push(E, "eObjIStack", 0)
        arrUtil(E, "pushLenKey", "eObjNStack", objFields)
        E["eObjDepth"] = E["eObjDepth"] + 1
        let od = E["eObjDepth"]
        while E["eObjIStack"][od - 1] < E["eObjNStack"][od - 1] {
            let oi = E["eObjIStack"][od - 1]
            let fld = objFields[oi]
            eCallExpr(E, fld["value"])
            eCallRet = symIndex(E, "const", fld["key"])
            emitOp(E, OP_CONST, eCallRet)
            E["eObjIStack"][od - 1] = oi + 1
        }
        object_array_pop(E, "eObjIStack")
        object_array_pop(E, "eObjNStack")
        E["eObjDepth"] = E["eObjDepth"] - 1
        emitOp(E, OP_MAKE_OBJECT, len(objFields))
        return true
    return true
}

// --- emit_expr_unary ---
pub fn emitExpr_unary(E) {
    if E["eNode"].kind != AST_UNARY {
        return false
    }
        let uOp = E["eNode"]["op"]
        let uInner = E["eNode"]["expr"]
        if uOp == "delete" {
            if uInner.kind != AST_MEMBER {
                throw "delete expects object property access"
            }
            let delObj = uInner["object"]
            let delField = uInner["field"]
            eCallExpr(E, {
                "kind": AST_CALL,
                "callee": { "kind": AST_VAR, "sym": "object_delete_prop" },
                "args": [
                    delObj,
                    { "kind": AST_LITERAL, "lit": LIT_STRING, "value": delField }
                ],
                "typeArgs": []
            })
            if delObj.kind == AST_VAR {
                emitOp(E, OP_DUP, 0)
                emitSym(E, 1, delObj["sym"])
            }
            return true
        }
        eCallExpr(E, uInner)
        if uOp == "!" {
            emitOp(E, OP_NOT, 0)
            return true
        }
        if uOp == "-" {
            emitOp(E, OP_NEG, 0)
            return true
        }
        if uOp == "~" {
            emitOp(E, OP_BIT_NOT, 0)
            return true
        }
        if uOp == "await" {
            emitOp(E, OP_AWAIT, 0)
            return true
        }
        throw "Unsupported unary op: " + uOp
    return true
}

// --- emit_expr_var ---
pub fn emitExpr_var(E) {
    if E["eNode"].kind != AST_VAR {
        return false
    }
        E["eSym"] = E["eNode"]["sym"]
        if E["eSym"] == "None" {
            emitOp(E, OP_MAKE_NONE, 0)
            return true
        }
        emitSym(E, 0,E["eSym"])
        return true
    return true
}

// --- emit_expr_binary ---
pub fn emitExpr_nullish(E) {
    let binRight = E["eNode"]["right"]
    eCallExpr(E, E["eNode"]["left"])
    emitOp(E, OP_DUP, 0)
    let jumpKeep = opsLen(E)
    emitOp(E, OP_JUMP_IF_NOT_NULLISH, 0)
    emitOp(E, OP_POP, 0)
    emitOp(E, OP_POP, 0)
    eCallExpr(E, binRight)
    let jumpEnd = opsLen(E)
    emitOp(E, OP_JUMP, 0)
    patchJumpAt(E, jumpKeep)
    emitOp(E, OP_POP, 0)
    patchJumpAt(E, jumpEnd)
    return true
}

pub fn emitExpr_and(E) {
    let binRight = E["eNode"]["right"]
    eCallExpr(E, E["eNode"]["left"])
    emitOp(E, OP_DUP, 0)
    let jumpEnd = opsLen(E)
    emitOp(E, OP_JUMP_IF_FALSE, 0)
    emitOp(E, OP_POP, 0)
    eCallExpr(E, binRight)
    patchJumpAt(E, jumpEnd)
    return true
}

pub fn emitExpr_or(E) {
    let binRight = E["eNode"]["right"]
    eCallExpr(E, E["eNode"]["left"])
    emitOp(E, OP_DUP, 0)
    let jumpRight = opsLen(E)
    emitOp(E, OP_JUMP_IF_FALSE, 0)
    let jumpEnd = opsLen(E)
    emitOp(E, OP_JUMP, 0)
    patchJumpAt(E, jumpRight)
    emitOp(E, OP_POP, 0)
    eCallExpr(E, binRight)
    patchJumpAt(E, jumpEnd)
    return true
}

pub fn emitExpr_ternary(E) {
    if E["eNode"].kind != AST_TERNARY {
        return false
    }
    let tCond = E["eNode"]["cond"]
    let tThen = E["eNode"]["thenB"]
    let tElse = E["eNode"]["elseB"]
    eCallExpr(E, tCond)
    let jumpElse = opsLen(E)
    emitOp(E, OP_JUMP_IF_FALSE, 0)
    eCallExpr(E, tThen)
    let jumpEnd = opsLen(E)
    emitOp(E, OP_JUMP, 0)
    patchJumpAt(E, jumpElse)
    eCallExpr(E, tElse)
    patchJumpAt(E, jumpEnd)
    return true
}

pub fn emitExpr_result_question(E) {
    if E["eNode"].kind != AST_RESULT_QUESTION {
        return false
    }
    let inner = E["eNode"]["inner"]
    eCallExpr(E, inner)
    emitOp(E, OP_RESULT_QUESTION, 0)
    return true
}

pub fn emitExpr_binary(E) {
    if E["eNode"].kind != AST_BINARY {
        return false
    }
        let binOp = E["eNode"]["op"]
        if binOp == "??" {
            return emitExpr_nullish(E)
        }
        if binOp == "&&" {
            return emitExpr_and(E)
        }
        if binOp == "||" {
            return emitExpr_or(E)
        }
        let binRight = E["eNode"]["right"]
        eCallExpr(E, E["eNode"]["left"])
        eCallExpr(E, binRight)
        E["eBinOp"] = binOp
        if emitExpr_binaryArith(E, E["eBinOp"]) == 1 {
            return true
        }
        if emitExpr_binaryCmp(E, E["eBinOp"]) == 1 {
            return true
        }
        if emitExpr_binaryLogic(E, E["eBinOp"]) == 1 {
            return true
        }
        if emitExpr_binaryBit(E, E["eBinOp"]) == 1 {
            return true
        }
        throw "Unsupported binary op: " + E["eBinOp"]
    return true
}

// --- emit_expr_call_argv ---
pub fn emitExpr_callArgv(E) {
    // SH3a: always snapshot eArgs/eArgN (N-path). The arity-2 fast path
    // clobbered callee/args when the second argument was itself a call
    // (`push(stack, len(x))` emitted `len` instead of `push`).
    emitExpr_callArgvN(E)
    return 0
}

// --- emit_expr_call_ctor ---
pub fn emitExpr_callCtors(E) {
    if E["eCallee"].kind != AST_VAR {
        return 0
    }
    if E["eArgN"] != 1 {
        return 0
    }
    let ctorName = E["eCallee"]["sym"]
    if emitExpr_callCtorOkErr(E, ctorName) == 1 {
        return 1
    }
    if emitExpr_callCtorSome(E, ctorName) == 1 {
        return 1
    }
    return 0
}

// --- emit_expr_call_h2 ---
pub fn emitExpr_call_h2(E) {
    emitResolveTypeArgs(E, "eArgs", E["eGenSym"], 1)
    E["eMangled"] = E["eGenSym"]
    emitMangleWithTypeArgs(E, "eMangled")
    emitExpr_call_h2_spec(E)
    E["eCallee"] = { "kind": AST_VAR, "sym": E["eMangled"] }
    let calleeStk = E["eCalleeStack"]
    calleeStk[E["eCalleeDepth"] - 1] = E["eCallee"]
    E["eCalleeStack"] = calleeStk
}

// --- emit_expr_call_h3_spec ---
pub fn emitExpr_call_h3_spec(E) {
    let saveArgs = []
    let sai = 0
    while sai < len(E["eArgs"]) {
        saveArgs = push(saveArgs, E["eArgs"][sai])
        sai = sai + 1
    }
    let saveArgN = E["eArgN"]
    emitCheckWhere(E)
    emitExpr_call_h3_gen(E)
    E["eArgs"] = saveArgs
    E["eArgN"] = saveArgN
    emitExpr_call_h3_inst(E)
}

// --- emit_expr_call_h5_install ---
pub fn emitExpr_call_h5_install(E) {
    E["eFoundMeth"] = 0
    E["eClassIdx"] = 0
    while E["eClassIdx"] < E["eClassesN"] {
        if E["eClasses"][E["eClassIdx"]]["sym"] == E["eRecvClass"] {
            E["eMi"] = 0
            while E["eMi"] < len(E["eClasses"][E["eClassIdx"]]["methods"]) {
                if E["eClasses"][E["eClassIdx"]]["methods"][E["eMi"]]["sym"] == E["eMethodMangled"] {
                    E["eFoundMeth"] = 1
                }
                E["eMi"] = E["eMi"] + 1
            }
            if E["eFoundMeth"] == 0 {
                emitExpr_call_h5_do_install(E)
            }
        }
        E["eClassIdx"] = E["eClassIdx"] + 1
    }
}

// --- emit_expr_call_h3 ---
pub fn emitExpr_call_h3(E) {
    emitResolveTypeArgs(E, "eArgs", E["eGenSym"], 0)
    E["eMangled"] = E["eGenSym"]
    emitMangleWithTypeArgs(E, "eMangled")
    emitExpr_call_h3_spec(E)
}

// --- emit_expr_call_h5_meth ---
pub fn emitExpr_call_h5_meth(E) {
    emitExpr_call_h5_install(E)
    emitExpr_call_h5_emit(E)
}

// --- emit_expr_call_h1 ---
pub fn emitExpr_call_h1(E) {
        E["eGenSym"] = E["eCallee"]["sym"]
        E["eGenTmpl"] = null
        E["eFound"] = 0
        E["eGenI"] = 0
        while E["eGenI"] < len(E["eGenericClassTemplates"]) {
            if E["eGenericClassTemplates"][E["eGenI"]]["sym"] == E["eGenSym"] {
                E["eGenTmpl"] = E["eGenericClassTemplates"][E["eGenI"]]
                E["eFound"] = 1
                break
            }
            E["eGenI"] = E["eGenI"] + 1
        }
        if E["eFound"] == 1 {
            let saveArgs = []
            let sai = 0
            while sai < len(E["eArgs"]) {
                saveArgs = push(saveArgs, E["eArgs"][sai])
                sai = sai + 1
            }
            let saveArgN = E["eArgN"]
            emitExpr_call_h3(E)
            E["eArgs"] = saveArgs
            E["eArgN"] = saveArgN
            if E["_callDone"] == 1 {
                E["_callDone"] = 1
                return 0
            }
        }
        E["eGenTmpl"] = null
        E["eFound"] = 0
        E["eGenI"] = 0
        while E["eGenI"] < len(E["eGenericTemplates"]) {
            if E["eGenericTemplates"][E["eGenI"]]["sym"] == E["eGenSym"] {
                E["eGenTmpl"] = E["eGenericTemplates"][E["eGenI"]]
                E["eFound"] = 1
                break
            }
            E["eGenI"] = E["eGenI"] + 1
        }
        if E["eFound"] == 1 {
            let saveArgsFn = []
            let sfi = 0
            while sfi < len(E["eArgs"]) {
                saveArgsFn = push(saveArgsFn, E["eArgs"][sfi])
                sfi = sfi + 1
            }
            let saveArgNFn = E["eArgN"]
            emitExpr_call_h2(E)
            E["eArgs"] = saveArgsFn
            E["eArgN"] = saveArgNFn
            if E["_callDone"] == 1 {
                E["_callDone"] = 1
                return 0
            }
        }
        eCallRet = symIndex(E, "class",E["eGenSym"])
        E["eClassIdx"] = eCallRet
        if E["eClassIdx"] >= 0 {
            object_array_push(E, "eCallArgIStack", 0)
            object_array_push(E, "eCallArgNStack", E["eArgN"])
            object_array_push(E, "eArgsStack", E["eArgs"])
            emitCallArgExprs(E)
            if E["eInFn"] == 1 {
                object_array_push(E, "eFnOps", { "op": OP_NEW_INSTANCE, "arg": E["eClassIdx"], "arg2": E["eArgN"] })
                E["eFnOpsN"] = E["eFnOpsN"] + 1
            } else {
                object_array_push(E, "eOps", { "op": OP_NEW_INSTANCE, "arg": E["eClassIdx"], "arg2": E["eArgN"] })
                E["eOpsN"] = E["eOpsN"] + 1
            }
            dropCallCallee(E)
            E["_callDone"] = 1
            return 0
        }
}

// --- emit_expr_call_h5 ---
pub fn emitExpr_call_h5(E) {
    emitResolveTypeArgs(E, "eArgs", E["eMemFld"], 0)
    E["eWhereSrc"] = E["eMethTmpl"]
    emitCheckWhere(E)
    E["eWhereSrc"] = null
    E["eMethodMangled"] = E["eMemFld"]
    emitMangleWithTypeArgs(E, "eMethodMangled")
    emitExpr_call_h5_meth(E)
}

// --- emit_expr_call_h6 ---
pub fn emitExpr_call_h6(E) {
        E["eGenSym"] = E["eMemObj"]["sym"]
        E["eFound"] = 0
        E["eGenI"] = 0
        while E["eGenI"] < len(E["eGenericEnumTemplates"]) {
            if E["eGenericEnumTemplates"][E["eGenI"]]["sym"] == E["eGenSym"] {
                E["eGenTmpl"] = E["eGenericEnumTemplates"][E["eGenI"]]
                E["eFound"] = 1
                break
            }
            E["eGenI"] = E["eGenI"] + 1
        }
        if E["eFound"] == 1 {
            emitExpr_call_h7(E)
            if E["_callDone"] == 1 {
                E["_callDone"] = 1
                return 0
            }
        }
}

// --- emit_expr_call_h4 ---
pub fn emitExpr_call_h4(E) {
        E["eMemObj"] = E["eCallee"]["object"]
        E["eMemFld"] = E["eCallee"]["field"]
        E["eMemTypeArgs"] = E["eCallee"]["typeArgs"]
        if E["eMemTypeArgs"] == undefined {
            E["eMemTypeArgs"] = []
        }
        if E["eMemObj"].kind == AST_VAR {
            emitExpr_call_h6(E)
            if E["_callDone"] == 1 {
                E["_callDone"] = 1
                return 0
            }
        }
    E["eRecvClass"] = ""
    if E["eMemObj"].kind == AST_VAR {
        E["eBi"] = 0
        while E["eBi"] < len(E["eBindingSyms"]) {
            if E["eBindingSyms"][E["eBi"]] == E["eMemObj"]["sym"] {
                E["eRecvClass"] = E["eBindingTypes"][E["eBi"]]
            }
            E["eBi"] = E["eBi"] + 1
        }
    }
    if E["eRecvClass"] == "" {
        if E["eMemObj"].kind == AST_CALL {
            E["eCtorCallee"] = E["eMemObj"]["callee"]
            if E["eCtorCallee"].kind == AST_VAR {
                E["eCtorName"] = E["eCtorCallee"]["sym"]
                E["eGenI"] = 0
                while E["eGenI"] < E["eClassesN"] {
                    if E["eClasses"][E["eGenI"]]["sym"] == E["eCtorName"] {
                        E["eRecvClass"] = E["eCtorName"]
                    }
                    E["eGenI"] = E["eGenI"] + 1
                }
            }
        }
    }
    E["eMethTmpl"] = null
    E["eFound"] = 0
    if E["eRecvClass"] != "" {
        E["eGenI"] = 0
        while E["eGenI"] < len(E["eGenericMethodTemplates"]) {
            if E["eGenericMethodTemplates"][E["eGenI"]]["classSym"] == E["eRecvClass"] {
                if E["eGenericMethodTemplates"][E["eGenI"]]["methodSym"] == E["eMemFld"] {
                    E["eMethTmpl"] = E["eGenericMethodTemplates"][E["eGenI"]]
                    E["eFound"] = 1
                }
            }
            E["eGenI"] = E["eGenI"] + 1
        }
    }
    if E["eFound"] == 1 {
        emitExpr_call_h5(E)
        if E["_callDone"] == 1 {
            E["_callDone"] = 1
            return 0
        }
    }
}

// --- emit_expr_call ---
pub fn emitExpr_call(E) {
    if E["eNode"].kind != AST_CALL {
        return false
    }
    E["_callDone"] = 0
        // SH3a: intercept len(...) before mutating eArgs/eArgN (nested str_slice/len).
        if tryEmitLenCall(E, E["eNode"]["callee"], E["eNode"]["args"]) {
            E["_callDone"] = 1
            return true
        }
        E["eArgs"] = E["eNode"]["args"]
        E["eArgN"] = len(E["eArgs"])
        object_array_push(E, "eCalleeStack", E["eNode"]["callee"])
        E["eCalleeDepth"] = E["eCalleeDepth"] + 1
        E["eCallee"] = E["eNode"]["callee"]
        if emitCallArgsHaveSpread(E["eArgs"]) == 1 {
            emitExpr_callSpread(E)
            return true
        }
        if emitExpr_callCtors(E) == 1 {
            return true
        }
        if E["eCallee"].kind == AST_MEMBER {
            emitExpr_call_h4(E)
            if E["_callDone"] == 1 {
                return true
            }
        }
        if E["eCallee"].kind == AST_VAR {
            emitExpr_call_h1(E)
            if E["_callDone"] == 1 {
                return true
            }
        }
        emitExpr_callArgv(E)
        return true
    return true
}

// --- emit_expr_body ---
pub fn emitExprBody(E, node) {
    E["eNode"] = node
    if node == null {
        throw "emitExpr: null node"
    }
    let kind = node.kind
    if kind == AST_LITERAL {
        emitExpr_literal(E)
        return
    }
    if kind == AST_VAR {
        emitExpr_var(E)
        return
    }
    if kind == AST_SUPER {
        throw "super must be followed by .member"
    }
    if kind == AST_UNARY {
        emitExpr_unary(E)
        return
    }
    if kind == AST_ARROW {
        emitExpr_arrow(E)
        return
    }
    if kind == AST_BINARY {
        emitExpr_binary(E)
        return
    }
    if kind == AST_TERNARY {
        emitExpr_ternary(E)
        return
    }
    if kind == AST_RESULT_QUESTION {
        emitExpr_result_question(E)
        return
    }
    if kind == AST_OBJECT {
        emitExpr_object(E)
        return
    }
    if kind == AST_ARRAY {
        emitExpr_array(E)
        return
    }
    if kind == AST_MEMBER {
        emitExpr_member(E)
        return
    }
    if kind == AST_INDEX {
        emitExpr_index(E)
        return
    }
    if kind == AST_OPTIONAL_MEMBER {
        emitExpr_optional_member(E)
        return
    }
    if kind == AST_OPTIONAL_INDEX {
        emitExpr_optional_index(E)
        return
    }
    if kind == AST_OPTIONAL_CALL {
        emitExpr_optional_call(E)
        return
    }
    if kind == AST_CALL {
        emitExpr_call(E)
        return
    }
    if kind == AST_MATCH {
        emitExpr_match(E)
        return
    }
    throw "Unsupported expr: " + kind
}

pub fn emitPatJump(E, op) {
    let j = opsLen(E)
    emitOp(E, op, 0)
    E["ePatFails"] = push(E["ePatFails"], j)
}

pub fn emitPatJump2(E, op, arg) {
    let j = opsLen(E)
    emitOp2(E, op, arg, 0)
    E["ePatFails"] = push(E["ePatFails"], j)
}

pub fn emitPatJump3(E, op, arg, arg2) {
    let j = opsLen(E)
    emitOp3(E, op, arg, arg2, 0)
    E["ePatFails"] = push(E["ePatFails"], j)
}

pub fn emitMatchArrPiece(E, piece, idx) {
    emitOp(E, OP_DUP, 0)
    let ci = symIndex(E, "const", idx)
    emitOp(E, OP_CONST, ci)
    emitOp(E, OP_INDEX_GET, 0)
    if piece.kind == "wild" {
        emitOp(E, OP_POP, 0)
        return
    }
    emitMatchPat(E, piece["pat"])
}

pub fn emitMatchArrPieceFromEnd(E, piece, fromEnd) {
    emitOp(E, OP_DUP, 0)
    emitOp(E, OP_INDEX_PEEK_FROM_END, fromEnd)
    if piece.kind == "wild" {
        emitOp(E, OP_POP, 0)
        return
    }
    emitMatchPat(E, piece["pat"])
}

pub fn emitMatchPatArray(E, pat) {
    emitPatJump(E, OP_JUMP_UNLESS_ARRAY)
    let pieces = pat.pieces
    let restAt = -1
    let pi = 0
    while pi < len(pieces) {
        if pieces[pi].kind == "rest" {
            restAt = pi
        }
        pi = pi + 1
    }
    if restAt < 0 {
        emitOp(E, OP_DUP, 0)
        emitOp(E, OP_GET_LENGTH, 0)
        let nPieces = len(pieces)
        let lenCi = symIndex(E, "const", nPieces)
        emitOp(E, OP_CONST, lenCi)
        emitOp(E, OP_EQ, 0)
        emitPatJump(E, OP_JUMP_IF_FALSE)
        pi = 0
        while pi < len(pieces) {
            emitMatchArrPiece(E, pieces[pi], pi)
            pi = pi + 1
        }
        emitOp(E, OP_POP, 0)
        return
    }
    let afterN = len(pieces) - restAt - 1
    emitOp(E, OP_DUP, 0)
    emitOp(E, OP_GET_LENGTH, 0)
    let minN = restAt + afterN
    let minCi = symIndex(E, "const", minN)
    emitOp(E, OP_CONST, minCi)
    emitOp(E, OP_GE, 0)
    emitPatJump(E, OP_JUMP_IF_FALSE)
    pi = 0
    while pi < restAt {
        emitMatchArrPiece(E, pieces[pi], pi)
        pi = pi + 1
    }
    let rname = pieces[restAt]["sym"]
    if rname != "" && rname != null && rname != undefined {
        emitOp(E, OP_DUP, 0)
        emitOp2(E, OP_ARRAY_SLICE_REST, restAt, afterN)
        emitSym(E, 1, rname)
    }
    pi = 0
    while pi < afterN {
        emitMatchArrPieceFromEnd(E, pieces[restAt + 1 + pi], afterN - pi)
        pi = pi + 1
    }
    emitOp(E, OP_POP, 0)
}

pub fn emitMatchPatObject(E, pat) {
    emitPatJump(E, OP_JUMP_UNLESS_OBJECT)
    let fields = pat.fields
    if len(fields) == 0 {
        emitPatJump(E, OP_JUMP_UNLESS_OBJECT_EMPTY)
        emitOp(E, OP_POP, 0)
        return
    }
    let boundKeys = []
    let fi = 0
    while fi < len(fields) {
        let f = fields[fi]
        let fk = f.kind
        if fk == "shorthand" {
            let ki = symIndex(E, "const", f.key)
            emitPatJump2(E, OP_JUMP_UNLESS_HAS_MEMBER, ki)
            emitOp(E, OP_DUP, 0)
            emitOp(E, OP_GET_MEMBER, ki)
            emitSym(E, 1, f.key)
            boundKeys = push(boundKeys, f.key)
        }
        if fk == "field" {
            let ki = symIndex(E, "const", f.key)
            emitPatJump2(E, OP_JUMP_UNLESS_HAS_MEMBER, ki)
            emitOp(E, OP_DUP, 0)
            emitOp(E, OP_GET_MEMBER, ki)
            emitMatchPat(E, f["pat"])
            boundKeys = push(boundKeys, f.key)
        }
        if fk == "rest" {
            let rname = f["sym"]
            if rname != "" && rname != null && rname != undefined {
                emitOp(E, OP_DUP, 0)
                if len(boundKeys) == 0 {
                    emitSym(E, 1, rname)
                } else {
                    let bi = 0
                    while bi < len(boundKeys) {
                        let restKey = boundKeys[bi]
                        let restCi = symIndex(E, "const", restKey)
                        emitOp(E, OP_CONST, restCi)
                        bi = bi + 1
                    }
                    emitOp(E, OP_OBJECT_REST, len(boundKeys))
                    emitSym(E, 1, rname)
                }
            }
        }
        fi = fi + 1
    }
    emitOp(E, OP_POP, 0)
}

pub fn emitMatchPatConstPush(E, pat) {
    let cval = pat.value
    if pat.undef == 1 {
        cval = KAB_UNDEF_CONST
    }
    if pat.nan == 1 {
        cval = 0 / 0
    }
    let cidx = symIndex(E, "const", cval)
    emitOp(E, OP_CONST, cidx)
}

pub fn emitMatchPatRange(E, pat) {
    let hasLo = 0
    if pat.lo != null && pat.lo != undefined {
        hasLo = 1
    }
    let hasHi = 0
    if pat.hi != null && pat.hi != undefined {
        hasHi = 1
    }
    if hasLo == 1 {
        emitOp(E, OP_DUP, 0)
        emitMatchPatConstPush(E, pat.lo)
        emitOp(E, OP_GE, 0)
        emitPatJump(E, OP_JUMP_IF_FALSE)
    }
    if hasHi == 1 {
        emitOp(E, OP_DUP, 0)
        emitMatchPatConstPush(E, pat.hi)
        if pat.inc == 1 {
            emitOp(E, OP_LE, 0)
        } else {
            emitOp(E, OP_LT, 0)
        }
        emitPatJump(E, OP_JUMP_IF_FALSE)
    }
    emitOp(E, OP_POP, 0)
}

pub fn emitMatchPatOr(E, pat) {
    let alts = pat.alts
    let n = len(alts)
    if n <= 1 {
        if n == 1 {
            emitMatchPat(E, alts[0])
        }
        return
    }
    let okJumps = []
    let ai = 0
    while ai < n {
        let last = 0
        if ai + 1 >= n {
            last = 1
        }
        let saveFails = E["ePatFails"]
        E["ePatFails"] = []
        if last == 0 {
            emitOp(E, OP_DUP, 0)
        }
        emitMatchPat(E, alts[ai])
        if last == 0 {
            emitOp(E, OP_POP, 0)
            okJumps = push(okJumps, opsLen(E))
            emitOp(E, OP_JUMP, 0)
            let fails = E["ePatFails"]
            let fi = 0
            while fi < len(fails) {
                patchJumpAt(E, fails[fi])
                fi = fi + 1
            }
            emitOp(E, OP_POP, 0)
            E["ePatFails"] = saveFails
        } else {
            let fails = E["ePatFails"]
            let fi = 0
            while fi < len(fails) {
                saveFails = push(saveFails, fails[fi])
                fi = fi + 1
            }
            E["ePatFails"] = saveFails
        }
        ai = ai + 1
    }
    let orEnd = opsLen(E)
    let oi = 0
    while oi < len(okJumps) {
        patchJumpTo(E, okJumps[oi], orEnd)
        oi = oi + 1
    }
}

pub fn emitMatchPat(E, pat) {
    let k = pat.kind
    if k == "or" {
        emitMatchPatOr(E, pat)
        return
    }
    if k == "range" {
        emitMatchPatRange(E, pat)
        return
    }
    if k == "at" {
        emitOp(E, OP_DUP, 0)
        emitSym(E, 1, pat.sym)
        emitMatchPat(E, pat.inner)
        return
    }
    if k == "wild" {
        emitOp(E, OP_POP, 0)
        return
    }
    if k == "var" {
        emitSym(E, 1, pat.sym)
        return
    }
    if k == "array" {
        emitMatchPatArray(E, pat)
        return
    }
    if k == "object" {
        emitMatchPatObject(E, pat)
        return
    }
    if k == "none" {
        emitPatJump(E, OP_JUMP_UNLESS_OPTION_NONE)
        emitOp(E, OP_POP, 0)
        return
    }
    if k == "some" {
        emitPatJump(E, OP_JUMP_UNLESS_OPTION_SOME)
        emitOp(E, OP_UNWRAP_OPTION_SOME, 0)
        emitMatchPat(E, pat.inner)
        return
    }
    if k == "ok" {
        emitPatJump(E, OP_JUMP_UNLESS_RESULT_OK)
        emitOp(E, OP_UNWRAP_RESULT_OK, 0)
        emitMatchPat(E, pat.inner)
        return
    }
    if k == "err" {
        emitPatJump(E, OP_JUMP_UNLESS_RESULT_ERR)
        emitOp(E, OP_UNWRAP_RESULT_ERR, 0)
        emitMatchPat(E, pat.inner)
        return
    }
    if k == "enum" {
        let ti = symIndex(E, "const", pat["typeName"])
        let vi = symIndex(E, "const", pat["variant"])
        emitPatJump3(E, OP_JUMP_UNLESS_ENUM_VARIANT, ti, vi)
        let fields = pat["fields"]
        if fields == undefined {
            fields = []
        }
        if len(fields) == 0 {
            emitOp(E, OP_POP, 0)
            return
        }
        emitOp(E, OP_UNPACK_ENUM_FIELDS, len(fields))
        let ei = 0
        while ei < len(fields) {
            emitMatchPat(E, fields[ei])
            ei = ei + 1
        }
        return
    }
    let cval = pat.value
    if pat.undef == 1 {
        cval = KAB_UNDEF_CONST
    }
    if pat.nan == 1 {
        cval = 0 / 0
    }
    let cidx = symIndex(E, "const", cval)
    emitPatJump2(E, OP_JUMP_UNLESS_CONST_EQ, cidx)
    emitOp(E, OP_POP, 0)
}

pub fn emitExpr_match(E) {
    let node = E["eNode"]
    eCallExpr(E, node["scrutinee"])
    let arms = node["arms"]
    let n = len(arms)
    let endJumps = []
    let armHeads = []
    let guardPatches = []
    let failAts = []
    let ai = 0
    while ai < n {
        armHeads = push(armHeads, opsLen(E))
        emitOp(E, OP_DUP, 0)
        E["ePatFails"] = []
        emitMatchPat(E, arms[ai]["pattern"])
        if arms[ai]["guard"] != null {
            eCallExpr(E, arms[ai]["guard"])
            let gj = opsLen(E)
            emitOp(E, OP_JUMP_IF_FALSE, 0)
            guardPatches = push(guardPatches, [gj, ai + 1])
        }
        let body = arms[ai]["body"]
        let bk = body.kind
        if bk == AST_BLOCK || bk == AST_IF || bk == AST_EXPR || bk == AST_WHILE {
            eCallStmt(E, body)
            let ni = symIndex(E, "const", null)
            emitOp(E, OP_CONST, ni)
        } else {
            eCallExpr(E, body)
        }
        emitOp(E, OP_SWAP, 0)
        emitOp(E, OP_POP, 0)
        endJumps = push(endJumps, opsLen(E))
        emitOp(E, OP_JUMP, 0)
        let failAt = opsLen(E)
        failAts = push(failAts, failAt)
        let fails = E["ePatFails"]
        let fi = 0
        while fi < len(fails) {
            patchJumpAt(E, fails[fi])
            fi = fi + 1
        }
        emitOp(E, OP_POP, 0)
        ai = ai + 1
    }
    let gi = 0
    while gi < len(guardPatches) {
        let gp = guardPatches[gi]
        let next = gp[1]
        if next < n {
            patchJumpTo(E, gp[0], armHeads[next])
        } else {
            patchJumpTo(E, gp[0], failAts[n - 1])
        }
        gi = gi + 1
    }
    emitOp(E, OP_MATCH_FAIL, 0)
    let ei = 0
    while ei < len(endJumps) {
        patchJumpAt(E, endJumps[ei])
        ei = ei + 1
    }
}
