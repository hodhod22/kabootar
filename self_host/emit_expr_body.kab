import "self_host/ast_defs"
import "self_host/emit_defs"
import "self_host/emit_expr_literal"
import "self_host/emit_expr_var"
import "self_host/emit_expr_unary"
import "self_host/emit_expr_arrow"
import "self_host/emit_expr_binary"
import "self_host/emit_expr_object"
import "self_host/emit_expr_array"
import "self_host/emit_expr_member"
import "self_host/emit_expr_index"
import "self_host/emit_expr_call"

pub fn emitExprBody(E, node) {
    E["eNode"] = node
    if node == null {
        throw "emitExpr: null node"
    }
    let kind = node.kind
    if kind == AST_LITERAL {
        emitExpr_literal(E)
        return
    }
    if kind == AST_VAR {
        emitExpr_var(E)
        return
    }
    if kind == AST_UNARY {
        emitExpr_unary(E)
        return
    }
    if kind == AST_ARROW {
        emitExpr_arrow(E)
        return
    }
    if kind == AST_BINARY {
        emitExpr_binary(E)
        return
    }
    if kind == AST_OBJECT {
        emitExpr_object(E)
        return
    }
    if kind == AST_ARRAY {
        emitExpr_array(E)
        return
    }
    if kind == AST_MEMBER {
        emitExpr_member(E)
        return
    }
    if kind == AST_INDEX {
        emitExpr_index(E)
        return
    }
    if kind == AST_CALL {
        emitExpr_call(E)
        return
    }
    throw "Unsupported expr: " + kind
}
