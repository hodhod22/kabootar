// P6b: VM arith half-facade d.
import "self_host/vm_ops_arith_shift"
import "self_host/vm_ops_arith_ushr"

pub fn runOpArithD(S, name, arg, op, pool, globals, functions) {
    let st = runOpArithShift(S, name, arg, op, pool, globals, functions)
    if st != 0 {
        return st
    }
    return runOpArithUshr(S, name, arg, op, pool, globals, functions)
}
