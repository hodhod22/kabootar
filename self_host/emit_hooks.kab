// P6b: trampoline hooks for emitExpr/emitStmt across shards (no circular imports).
pub fn eCallExpr(E, node) {
    let prevH = E["_hook"]
    let prevN = E["_node"]
    E["_hook"] = 0
    E["_node"] = node
    E["tramp"]()
    E["_hook"] = prevH
    E["_node"] = prevN
}

pub fn eCallStmt(E, node) {
    let prevH = E["_hook"]
    let prevN = E["_node"]
    E["_hook"] = 1
    E["_node"] = node
    E["tramp"]()
    E["_hook"] = prevH
    E["_node"] = prevN
}
