import "self_host/vm_s_push"
import "self_host/vm_s_pop"
import "self_host/vm_s_ip"

pub fn runOpDataSwap(S, name, arg, op, pool, globals, functions) {
    if name == "swap" {
        let a = vPopS(S)
        let b = vPopS(S)
        vPushS(S, a)
        vPushS(S, b)
        vBumpIpS(S)
        return 1
    }
    return 0
}
