import "self_host/vm_run_mod_enter_a"
import "self_host/vm_run_mod_enter_b"

pub fn vModEnter(S, bc) {
    let a = vModEnterA(S, bc)
    let n = a["n"]
    vModEnterB(S, n)
    return {
        "old": a["old"],
        "pool": n["pool"],
        "globals": n["globals"],
        "functions": n["functions"],
        "ops": n["ops"]
    }
}
