@version "1.0.0"

// CAD Document - Document management with scene tree as single source of truth
// Canonical path: import "cad/document"

import "cad/transform"
import "cad/geom"
import "cad/layout"
import "cad/history"
import "cad/host"

pub fn createDocument(name, units) {
    let sceneRoot = createSceneNode("root", "Root")
    sceneRoot["id"] = "root"
    
    let nodes = {}
    nodes["root"] = sceneRoot
    
    return {
        "kind": "CADDocument",
        "id": generateDocumentId(),
        "name": name,
        "units": units,
        "version": "1.0",
        "cadVersion": "1.0",
        "profile": "drafting",
        "metadata": {
            "title": name,
            "author": "",
            "created": null,
            "modified": null,
            "description": ""
        },
        "layers": {
            "default": createLayer("default", { "r": 0.0, "g": 0.0, "b": 0.0, "a": 1.0 })
        },
        "activeLayer": "default",
        "nodes": nodes,
        "nodeCounter": 0,
        "idCounter": 0,
        "selection": createSelection(),
        "undoStack": [],
        "redoStack": [],
        "maxUndoSteps": 100,
        "sceneRoot": sceneRoot,
        "pages": [],
        "activePage": 0,
        "useCommandHistory": true,
        "epsilon": getEpsilonForUnits(units),
        "displayPrecision": getDisplayPrecisionForUnits(units)
    }
}

pub fn getEpsilonForUnits(units) {
    if units == "px" {
        return 0.5
    } else if units == "mm" {
        return 0.01
    } else if units == "in" {
        return 0.001
    }
    return 0.01
}

pub fn getDisplayPrecisionForUnits(units) {
    if units == "px" {
        return 0
    } else if units == "mm" {
        return 2
    } else if units == "in" {
        return 3
    }
    return 2
}

pub fn setDocumentEpsilon(document, epsilon) {
    document["epsilon"] = epsilon
    return document
}

pub fn setDocumentDisplayPrecision(document, precision) {
    document["displayPrecision"] = precision
    return document
}

// Note: Command pattern is the primary undo/redo mechanism
// useCommandHistory = true uses command pattern (recommended)
// useCommandHistory = false uses snapshot-based undo (legacy, for batch operations only)
// Command pattern is more memory-efficient and enables collaborative editing

pub fn createSceneNode(kind, name) {
    return {
        "kind": kind,
        "id": null,
        "name": name,
        "parent": null,
        "children": [],
        "transform": createTransform(),
        "visible": true,
        "locked": false,
        "opacity": 1.0,
        "layer": "default",
        "styleSet": null,
        "layout": null,
        "data": {},
        "meta": {},
        "transformDirty": false,
        "layoutDirty": false,
        "constraintDirty": false
    }
}

pub fn createSceneNodeWithId(document, kind, name) {
    let node = createSceneNode(kind, name)
    node["id"] = generateNodeId(document)
    return node
}

pub fn createFrameNode(name, x, y, width, height) {
    let node = createSceneNode("Frame", name)
    node["transform"]["position"] = vec2(x, y)
    node["width"] = width
    node["height"] = height
    return node
}

pub fn createGroupNode(name) {
    return createSceneNode("Group", name)
}

pub fn createComponentNode(name, definitionId) {
    let node = createSceneNode("Component", name)
    node["definitionId"] = definitionId
    node["overrides"] = {}
    return node
}

pub fn addSceneChild(parent, child) {
    parent["children"] = push(parent["children"], child["id"])
    child["parent"] = parent["id"]
    return parent
}

pub fn addNodeToDocument(document, node) {
    document["nodes"][node["id"]] = node
    document["nodeCounter"] = document["nodeCounter"] + 1
    return document
}

pub fn removeNodeFromDocument(document, nodeId) {
    let newNodes = {}
    for id in document["nodes"] {
        if id != nodeId {
            newNodes[id] = document["nodes"][id]
        }
    }
    document["nodes"] = newNodes
    return document
}

pub fn getNode(document, nodeId) {
    return document["nodes"][nodeId]
}

pub fn getNodeCount(document) {
    let count = 0
    for id in document["nodes"] {
        count = count + 1
    }
    return count
}

pub fn removeSceneChild(parent, childId) {
    let newChildren = []
    let i = 0
    while i < len(parent["children"]) {
        if parent["children"][i] != childId {
            newChildren = push(newChildren, parent["children"][i])
        }
        i = i + 1
    }
    parent["children"] = newChildren
    return parent
}

pub fn setSceneNodeParent(node, parentId) {
    node["parent"] = parentId
    return node
}

pub fn setSceneNodeTransform(node, transform) {
    node["transform"] = transform
    return node
}

pub fn setSceneNodeVisible(node, visible) {
    node["visible"] = visible
    return node
}

pub fn setSceneNodeLocked(node, locked) {
    node["locked"] = locked
    return node
}

pub fn setSceneNodeOpacity(node, opacity) {
    node["opacity"] = opacity
    return node
}

pub fn setNodeTransformDirty(node, dirty) {
    node["transformDirty"] = dirty
    return node
}

pub fn setNodeLayoutDirty(node, dirty) {
    node["layoutDirty"] = dirty
    return node
}

pub fn setNodeConstraintDirty(node, dirty) {
    node["constraintDirty"] = dirty
    return node
}

pub fn isNodeTransformDirty(node) {
    return node["transformDirty"]
}

pub fn isNodeLayoutDirty(node) {
    return node["layoutDirty"]
}

pub fn isNodeConstraintDirty(node) {
    return node["constraintDirty"]
}

pub fn documentCommit(document) {
    document = resolveLayout(document)
    document = updateWorldTransforms(document)
    // Note: resolveConstraints is NOT called here - constraint system is experimental
    // and not integrated with node-based architecture. Import "cad/constraint" explicitly
    // if you need constraint solving, but it will not be part of automatic commit.
    document = clearDirtyFlags(document)
    return document
}

pub fn resolveConstraints(document) {
    let sceneRoot = document["sceneRoot"]
    document = resolveNodeConstraintsDFS(document, sceneRoot)
    return document
}

fn resolveNodeConstraintsDFS(document, node) {
    if node == null || node["constraintDirty"] == false {
        return document
    }
    
    node = resolveNodeConstraints(node)
    node["constraintDirty"] = false
    document["nodes"][node["id"]] = node
    
    let i = 0
    while i < len(node["children"]) {
        let childId = node["children"][i]
        let child = document["nodes"][childId]
        if child != null {
            document = resolveNodeConstraintsDFS(document, child)
        }
        i = i + 1
    }
    
    return document
}

fn resolveNodeConstraints(node) {
    return node
}

// Note: Constraint resolution on nodes is Phase 2
// Current constraint system (cad/constraint) operates on entities
// To enable node constraints, either:
// 1. Update constraint system to use nodes instead of entities
// 2. Create new node-based constraint system
// For now, this is a no-op - layout is Phase 1 priority

pub fn resolveLayout(document) {
    let sceneRoot = document["sceneRoot"]
    document = resolveNodeLayoutDFS(document, sceneRoot)
    return document
}

fn resolveNodeLayoutDFS(document, node) {
    if node == null {
        return document
    }
    
    let i = 0
    while i < len(node["children"]) {
        let childId = node["children"][i]
        let child = document["nodes"][childId]
        if child != null {
            document = resolveNodeLayoutDFS(document, child)
        }
        i = i + 1
    }
    
    if node["layoutDirty"] == true && node["layout"] != null {
        node = resolveNodeLayout(document, node)
        node["layoutDirty"] = false
        document["nodes"][node["id"]] = node
    }
    
    return document
}

fn resolveNodeLayout(document, node) {
    let layout = node["layout"]
    let children = []
    let i = 0
    while i < len(node["children"]) {
        let childId = node["children"][i]
        let child = document["nodes"][childId]
        if child != null {
            children = push(children, child)
        }
        i = i + 1
    }
    
    if layout != null {
        let containerWidth = node["width"]
        let containerHeight = node["height"]
        layout = recomputeLayout(layout, children, containerWidth, containerHeight)
        node["layout"] = layout
        
        let j = 0
        while j < len(children) {
            let child = children[j]
            if layout["childPositions"] != null && j < len(layout["childPositions"]) {
                let pos = layout["childPositions"][j]
                child["transform"]["position"] = pos
                child["transformDirty"] = true
                document["nodes"][child["id"]] = child
            }
            j = j + 1
        }
    }
    
    return node
}

pub fn updateWorldTransforms(document) {
    let sceneRoot = document["sceneRoot"]
    document = updateNodeWorldTransformDFS(document, sceneRoot, null)
    return document
}

fn updateNodeWorldTransformDFS(document, node, parentWorldMatrix) {
    if node == null {
        return document
    }
    
    if parentWorldMatrix == null {
        node["transform"]["worldMatrix"] = node["transform"]["localMatrix"]
    } else {
        node["transform"]["worldMatrix"] = matrix2DMultiply(parentWorldMatrix, node["transform"]["localMatrix"])
    }
    
    node["transformDirty"] = false
    document["nodes"][node["id"]] = node
    
    let i = 0
    while i < len(node["children"]) {
        let childId = node["children"][i]
        let child = document["nodes"][childId]
        if child != null {
            document = updateNodeWorldTransformDFS(document, child, node["transform"]["worldMatrix"])
        }
        i = i + 1
    }
    
    return document
}

pub fn clearDirtyFlags(document) {
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null {
            node["transformDirty"] = false
            node["layoutDirty"] = false
            node["constraintDirty"] = false
            document["nodes"][nodeId] = node
        }
    }
    return document
}

pub fn createPage(name) {
    return {
        "kind": "Page",
        "id": generateDocumentId(),
        "name": name,
        "sceneRoot": createSceneNode("root", "Root")
    }
}

pub fn addPage(document, page) {
    document["pages"] = push(document["pages"], page)
    return document
}

pub fn setActivePage(document, pageIndex) {
    document["activePage"] = pageIndex
    return document
}

pub fn getActivePage(document) {
    return document["pages"][document["activePage"]]
}

pub fn setDocumentProfile(document, profile) {
    document["profile"] = profile
    return applyProfile(document, profile)
}

pub fn applyProfile(document, profile) {
    if profile == "design" {
        document = applyDesignProfile(document)
    } else if profile == "drafting" {
        document = applyDraftingProfile(document)
    } else if profile == "schematic" {
        document = applySchematicProfile(document)
    }
    return document
}

fn applyDesignProfile(document) {
    document["units"] = "px"
    document["gridSize"] = 10.0
    document["snapEnabled"] = true
    document["snapToGrid"] = true
    document["snapToPixel"] = true
    document["defaultTools"] = ["select", "frame", "vector", "text", "hand"]
    return document
}

fn applyDraftingProfile(document) {
    document["units"] = "mm"
    document["gridSize"] = 5.0
    document["snapEnabled"] = true
    document["snapToGrid"] = true
    document["snapToEndpoint"] = true
    document["snapToMidpoint"] = true
    document["snapToCenter"] = true
    document["defaultTools"] = ["select", "line", "arc", "circle", "dimension", "trim"]
    return document
}

fn applySchematicProfile(document) {
    document["units"] = "mm"
    document["gridSize"] = 2.54
    document["snapEnabled"] = true
    document["snapToGrid"] = true
    document["snapToPort"] = true
    document["snapToComponent"] = true
    document["defaultTools"] = ["select", "component", "wire", "net", "label"]
    return document
}

pub fn getDocumentProfile(document) {
    return document["profile"]
}

pub fn createLayer(name, color) {
    return {
        "kind": "Layer",
        "name": name,
        "color": color,
        "visible": true,
        "locked": false,
        "printable": true,
        "lineWidth": 1.0,
        "lineStyle": "solid"
    }
}

pub fn createSelection() {
    return {
        "kind": "Selection",
        "nodeIds": [],
        "mode": "single"
    }
}

pub fn addLayer(document, layer) {
    document["layers"][layer["name"]] = layer
    return document
}

pub fn removeLayer(document, layerName) {
    if layerName == "default" {
        return document
    }
    document["layers"][layerName] = null
    return document
}

pub fn setActiveLayer(document, layerName) {
    if document["layers"][layerName] != null {
        document["activeLayer"] = layerName
    }
    return document
}

pub fn getLayer(document, layerName) {
    return document["layers"][layerName]
}

pub fn setLayerVisible(document, layerName, visible) {
    if document["layers"][layerName] != null {
        document["layers"][layerName]["visible"] = visible
    }
    return document
}

pub fn setLayerLocked(document, layerName, locked) {
    if document["layers"][layerName] != null {
        document["layers"][layerName]["locked"] = locked
    }
    return document
}

pub fn addNode(document, parentId, node) {
    let nodeId = generateNodeId(document)
    node["id"] = nodeId
    document["nodes"][nodeId] = node
    document["nodeCounter"] = document["nodeCounter"] + 1
    
    if parentId != null {
        let parent = document["nodes"][parentId]
        if parent != null {
            parent["children"] = push(parent["children"], nodeId)
            node["parent"] = parentId
        }
    }
    
    return document
}

pub fn removeNode(document, nodeId) {
    let node = document["nodes"][nodeId]
    if node == null {
        return document
    }
    
    let parentId = node["parent"]
    if parentId != null {
        let parent = document["nodes"][parentId]
        if parent != null {
            let newChildren = []
            let i = 0
            while i < len(parent["children"]) {
                if parent["children"][i] != nodeId {
                    newChildren = push(newChildren, parent["children"][i])
                }
                i = i + 1
            }
            parent["children"] = newChildren
        }
    }
    
    let newNodes = {}
    for id in document["nodes"] {
        if id != nodeId {
            newNodes[id] = document["nodes"][id]
        }
    }
    document["nodes"] = newNodes
    
    return document
}

pub fn reparentNode(document, nodeId, newParentId) {
    let node = document["nodes"][nodeId]
    if node == null {
        return document
    }
    
    let oldParentId = node["parent"]
    if oldParentId != null {
        let oldParent = document["nodes"][oldParentId]
        if oldParent != null {
            let newChildren = []
            let i = 0
            while i < len(oldParent["children"]) {
                if oldParent["children"][i] != nodeId {
                    newChildren = push(newChildren, oldParent["children"][i])
                }
                i = i + 1
            }
            oldParent["children"] = newChildren
        }
    }
    
    if newParentId != null {
        let newParent = document["nodes"][newParentId]
        if newParent != null {
            newParent["children"] = push(newParent["children"], nodeId)
            node["parent"] = newParentId
        }
    } else {
        node["parent"] = null
    }
    
    return document
}

pub fn selectNode(document, nodeId) {
    let selection = document["selection"]
    if selection["mode"] == "single" {
        selection["nodeIds"] = [nodeId]
    } else {
        let found = false
        let i = 0
        while i < len(selection["nodeIds"]) {
            if selection["nodeIds"][i] == nodeId {
                found = true
            }
            i = i + 1
        }
        if found == false {
            selection["nodeIds"] = push(selection["nodeIds"], nodeId)
        }
    }
    document["selection"] = selection
    return document
}

pub fn deselectNode(document, nodeId) {
    let selection = document["selection"]
    let newIds = []
    let i = 0
    while i < len(selection["nodeIds"]) {
        if selection["nodeIds"][i] != nodeId {
            newIds = push(newIds, selection["nodeIds"][i])
        }
        i = i + 1
    }
    selection["nodeIds"] = newIds
    document["selection"] = selection
    return document
}

fn removeFromSelection(document, nodeId) {
    let selection = document["selection"]
    let newIds = []
    let i = 0
    while i < len(selection["nodeIds"]) {
        if selection["nodeIds"][i] != nodeId {
            newIds = push(newIds, selection["nodeIds"][i])
        }
        i = i + 1
    }
    selection["nodeIds"] = newIds
    document["selection"] = selection
    return document
}

pub fn clearSelection(document) {
    document["selection"]["nodeIds"] = []
    return document
}

pub fn selectAll(document) {
    let selection = document["selection"]
    selection["nodeIds"] = []
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null {
            selection["nodeIds"] = push(selection["nodeIds"], nodeId)
        }
    }
    document["selection"] = selection
    return document
}

pub fn invertSelection(document) {
    let selection = document["selection"]
    let newIds = []
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null {
            let selected = false
            let i = 0
            while i < len(selection["nodeIds"]) {
                if selection["nodeIds"][i] == nodeId {
                    selected = true
                }
                i = i + 1
            }
            if selected == false {
                newIds = push(newIds, nodeId)
            }
        }
    }
    selection["nodeIds"] = newIds
    document["selection"] = selection
    return document
}

pub fn getSelectedCount(document) {
    return len(document["selection"]["nodeIds"])
}

pub fn isSelected(document, nodeId) {
    let i = 0
    while i < len(document["selection"]["nodeIds"]) {
        if document["selection"]["nodeIds"][i] == nodeId {
            return true
        }
        i = i + 1
    }
    return false
}

pub fn setSelectionMode(document, mode) {
    document["selection"]["mode"] = mode
    return document
}

pub fn beginUndo(document, description) {
    let snapshot = createDocumentSnapshot(document)
    document["undoStack"] = push(document["undoStack"], {
        "description": description,
        "snapshot": snapshot
    })
    
    if len(document["undoStack"]) > document["maxUndoSteps"] {
        document["undoStack"] = removeFirst(document["undoStack"])
    }
    
    document["redoStack"] = []
    return document
}

pub fn undo(document) {
    if document["useCommandHistory"] == true {
        return undoCommand(document)
    }
    
    if len(document["undoStack"]) == 0 {
        return document
    }
    
    let action = document["undoStack"][len(document["undoStack"]) - 1]
    document["undoStack"] = removeLast(document["undoStack"])
    
    let currentSnapshot = createDocumentSnapshot(document)
    document["redoStack"] = push(document["redoStack"], {
        "description": action["description"],
        "snapshot": currentSnapshot
    })
    
    document = restoreDocumentSnapshot(document, action["snapshot"])
    return document
}

pub fn redo(document) {
    if document["useCommandHistory"] == true {
        return redoCommand(document)
    }
    
    if len(document["redoStack"]) == 0 {
        return document
    }
    
    let action = document["redoStack"][len(document["redoStack"]) - 1]
    document["redoStack"] = removeLast(document["redoStack"])
    
    let currentSnapshot = createDocumentSnapshot(document)
    document["undoStack"] = push(document["undoStack"], {
        "description": action["description"],
        "snapshot": currentSnapshot
    })
    
    document = restoreDocumentSnapshot(document, action["snapshot"])
    return document
}

pub fn canUndo(document) {
    return len(document["undoStack"]) > 0
}

pub fn canRedo(document) {
    return len(document["redoStack"]) > 0
}

pub fn clearUndoRedo(document) {
    document["undoStack"] = []
    document["redoStack"] = []
    return document
}

fn createDocumentSnapshot(document) {
    return {
        "nodes": deepCopyNodes(document["nodes"]),
        "layers": deepCopyLayers(document["layers"]),
        "nodeCounter": document["nodeCounter"],
        "idCounter": document["idCounter"],
        "selection": deepCopySelection(document["selection"]),
        "sceneRoot": deepCopySceneNode(document["sceneRoot"]),
        "pages": deepCopyPages(document["pages"]),
        "activePage": document["activePage"]
    }
}

fn restoreDocumentSnapshot(document, snapshot) {
    document["nodes"] = deepCopyNodes(snapshot["nodes"])
    document["layers"] = deepCopyLayers(snapshot["layers"])
    document["nodeCounter"] = snapshot["nodeCounter"]
    document["idCounter"] = snapshot["idCounter"]
    document["selection"] = deepCopySelection(snapshot["selection"])
    document["sceneRoot"] = deepCopySceneNode(snapshot["sceneRoot"])
    document["pages"] = deepCopyPages(snapshot["pages"])
    document["activePage"] = snapshot["activePage"]
    return document
}

fn deepCopyNodes(nodes) {
    let copy = {}
    for nodeId in nodes {
        let node = nodes[nodeId]
        if node != null {
            copy[nodeId] = deepCopyNode(node)
        }
    }
    return copy
}

fn deepCopyNode(node) {
    let copy = {}
    for key in node {
        if key == "transform" {
            copy[key] = deepCopyTransform(node["transform"])
        } else if key == "children" {
            copy[key] = node["children"]
        } else {
            copy[key] = node[key]
        }
    }
    return copy
}

fn deepCopyLayers(layers) {
    let copy = {}
    for layerName in layers {
        let layer = layers[layerName]
        if layer != null {
            copy[layerName] = {
                "name": layer["name"],
                "color": layer["color"],
                "visible": layer["visible"],
                "locked": layer["locked"],
                "printable": layer["printable"],
                "lineWidth": layer["lineWidth"],
                "lineStyle": layer["lineStyle"]
            }
        }
    }
    return copy
}

fn deepCopySelection(selection) {
    return {
        "kind": selection["kind"],
        "nodeIds": selection["nodeIds"],
        "mode": selection["mode"]
    }
}

fn deepCopySceneNode(node) {
    let copy = {}
    for key in node {
        if key == "transform" {
            copy[key] = deepCopyTransform(node["transform"])
        } else if key == "children" {
            copy[key] = node["children"]
        } else {
            copy[key] = node[key]
        }
    }
    return copy
}

fn deepCopyTransform(transform) {
    return {
        "kind": transform["kind"],
        "id": transform["id"],
        "position": vec2(transform["position"]["x"], transform["position"]["y"]),
        "rotation": transform["rotation"],
        "scale": vec2(transform["scale"]["x"], transform["scale"]["y"]),
        "parent": transform["parent"],
        "children": transform["children"],
        "worldMatrix": transform["worldMatrix"],
        "dirty": transform["dirty"]
    }
}

fn deepCopyPages(pages) {
    let copy = []
    let i = 0
    while i < len(pages) {
        copy = push(copy, {
            "kind": pages[i]["kind"],
            "id": pages[i]["id"],
            "name": pages[i]["name"],
            "sceneRoot": deepCopySceneNode(pages[i]["sceneRoot"])
        })
        i = i + 1
    }
    return copy
}

fn removeFirst(arr) {
    let result = []
    let i = 1
    while i < len(arr) {
        result = push(result, arr[i])
        i = i + 1
    }
    return result
}

fn removeLast(arr) {
    let result = []
    let i = 0
    while i < len(arr) - 1 {
        result = push(result, arr[i])
        i = i + 1
    }
    return result
}

pub fn setDocumentMetadata(document, key, value) {
    document["metadata"][key] = value
    return document
}

pub fn getDocumentMetadata(document, key) {
    return document["metadata"][key]
}

pub fn setDocumentName(document, name) {
    document["name"] = name
    document["metadata"]["title"] = name
    return document
}

pub fn setDocumentUnits(document, units) {
    document["units"] = units
    return document
}

pub fn getDocumentUnits(document) {
    return document["units"]
}

pub fn getNodeCount(document) {
    let count = 0
    for nodeId in document["nodes"] {
        if document["nodes"][nodeId] != null {
            count = count + 1
        }
    }
    return count
}

pub fn getLayerCount(document) {
    let count = 0
    for layerName in document["layers"] {
        if document["layers"][layerName] != null {
            count = count + 1
        }
    }
    return count
}

pub fn generateDocumentId() {
    return "doc-" + timestamp() + "-" + random()
}

pub fn generateNodeId(document) {
    document["idCounter"] = document["idCounter"] + 1
    return "node-" + document["idCounter"]
}

fn timestamp() {
    return floor(currentTime() * 1000.0)
}

fn currentTime() {
    return systemTime()
}

fn random() {
    return systemRandom()
}

fn floor(value) {
    let int = value
    if value < 0.0 && value != int {
        return int - 1
    }
    return int
}
