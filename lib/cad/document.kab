@version "1.0.0"

// CAD Document - Document management with scene tree as single source of truth
// Canonical path: import "cad/document"

import "cad/transform"
import "cad/geom"

pub fn createDocument(name, units) {
    return {
        "kind": "CADDocument",
        "id": generateDocumentId(),
        "name": name,
        "units": units,
        "version": "1.0",
        "cadVersion": "1.0",
        "profile": "drafting",
        "metadata": {
            "title": name,
            "author": "",
            "created": null,
            "modified": null,
            "description": ""
        },
        "layers": {
            "default": createLayer("default", { "r": 0.0, "g": 0.0, "b": 0.0, "a": 1.0 })
        },
        "activeLayer": "default",
        "nodes": {},
        "nodeCounter": 0,
        "idCounter": 0,
        "selection": createSelection(),
        "undoStack": [],
        "redoStack": [],
        "maxUndoSteps": 100,
        "sceneRoot": createSceneNode("root", "Root"),
        "pages": [],
        "activePage": 0
    }
}

pub fn createSceneNode(kind, name) {
    return {
        "kind": kind,
        "id": null,
        "name": name,
        "transform": createTransform(),
        "children": [],
        "parent": null,
        "visible": true,
        "locked": false,
        "opacity": 1.0
    }
}

pub fn createSceneNodeWithId(document, kind, name) {
    let node = createSceneNode(kind, name)
    node["id"] = generateNodeId(document)
    return node
}

pub fn createFrameNode(name, x, y, width, height) {
    let node = createSceneNode("Frame", name)
    node["transform"]["position"] = vec2(x, y)
    node["width"] = width
    node["height"] = height
    return node
}

pub fn createGroupNode(name) {
    return createSceneNode("Group", name)
}

pub fn createComponentInstanceNode(name, definitionId) {
    let node = createSceneNode("ComponentInstance", name)
    node["definitionId"] = definitionId
    node["overrides"] = {}
    return node
}

pub fn addSceneChild(parent, child) {
    parent["children"] = push(parent["children"], child["id"])
    child["parent"] = parent["id"]
    return parent
}

pub fn addNodeToDocument(document, node) {
    document["nodes"][node["id"]] = node
    document["nodeCounter"] = document["nodeCounter"] + 1
    return document
}

pub fn removeNodeFromDocument(document, nodeId) {
    let newNodes = {}
    for id in document["nodes"] {
        if id != nodeId {
            newNodes[id] = document["nodes"][id]
        }
    }
    document["nodes"] = newNodes
    return document
}

pub fn getNode(document, nodeId) {
    return document["nodes"][nodeId]
}

pub fn getNodeCount(document) {
    let count = 0
    for id in document["nodes"] {
        count = count + 1
    }
    return count
}

pub fn removeSceneChild(parent, childId) {
    let newChildren = []
    let i = 0
    while i < len(parent["children"]) {
        if parent["children"][i] != childId {
            newChildren = push(newChildren, parent["children"][i])
        }
        i = i + 1
    }
    parent["children"] = newChildren
    return parent
}

pub fn setSceneNodeParent(node, parentId) {
    node["parent"] = parentId
    return node
}

pub fn setSceneNodeTransform(node, transform) {
    node["transform"] = transform
    return node
}

pub fn setSceneNodeVisible(node, visible) {
    node["visible"] = visible
    return node
}

pub fn setSceneNodeLocked(node, locked) {
    node["locked"] = locked
    return node
}

pub fn setSceneNodeOpacity(node, opacity) {
    node["opacity"] = opacity
    return node
}

pub fn createPage(name) {
    return {
        "kind": "Page",
        "id": generateDocumentId(),
        "name": name,
        "sceneRoot": createSceneNode("root", "Root")
    }
}

pub fn addPage(document, page) {
    document["pages"] = push(document["pages"], page)
    return document
}

pub fn setActivePage(document, pageIndex) {
    document["activePage"] = pageIndex
    return document
}

pub fn getActivePage(document) {
    return document["pages"][document["activePage"]]
}

pub fn setDocumentProfile(document, profile) {
    document["profile"] = profile
    return document
}

pub fn getDocumentProfile(document) {
    return document["profile"]
}

pub fn createLayer(name, color) {
    return {
        "kind": "Layer",
        "name": name,
        "color": color,
        "visible": true,
        "locked": false,
        "printable": true,
        "lineWidth": 1.0,
        "lineStyle": "solid"
    }
}

pub fn createSelection() {
    return {
        "kind": "Selection",
        "entityIds": [],
        "mode": "single"
    }
}

pub fn addLayer(document, layer) {
    document["layers"][layer["name"]] = layer
    return document
}

pub fn removeLayer(document, layerName) {
    if layerName == "default" {
        return document
    }
    document["layers"][layerName] = null
    return document
}

pub fn setActiveLayer(document, layerName) {
    if document["layers"][layerName] != null {
        document["activeLayer"] = layerName
    }
    return document
}

pub fn getLayer(document, layerName) {
    return document["layers"][layerName]
}

pub fn setLayerVisible(document, layerName, visible) {
    if document["layers"][layerName] != null {
        document["layers"][layerName]["visible"] = visible
    }
    return document
}

pub fn setLayerLocked(document, layerName, locked) {
    if document["layers"][layerName] != null {
        document["layers"][layerName]["locked"] = locked
    }
    return document
}

pub fn addEntity(document, entity) {
    let entityId = "" + document["entityCounter"]
    document["entityCounter"] = document["entityCounter"] + 1
    entity["id"] = entityId
    entity["layer"] = document["activeLayer"]
    document["entities"][entityId] = entity
    return document
}

pub fn removeEntity(document, entityId) {
    document["entities"][entityId] = null
    document = removeFromSelection(document, entityId)
    return document
}

pub fn getEntity(document, entityId) {
    return document["entities"][entityId]
}

pub fn updateEntity(document, entityId, entity) {
    document["entities"][entityId] = entity
    return document
}

pub fn selectEntity(document, entityId) {
    let selection = document["selection"]
    if selection["mode"] == "single" {
        selection["entityIds"] = [entityId]
    } else {
        let found = false
        let i = 0
        while i < len(selection["entityIds"]) {
            if selection["entityIds"][i] == entityId {
                found = true
            }
            i = i + 1
        }
        if found == false {
            selection["entityIds"] = push(selection["entityIds"], entityId)
        }
    }
    document["selection"] = selection
    return document
}

pub fn deselectEntity(document, entityId) {
    let selection = document["selection"]
    let newIds = []
    let i = 0
    while i < len(selection["entityIds"]) {
        if selection["entityIds"][i] != entityId {
            newIds = push(newIds, selection["entityIds"][i])
        }
        i = i + 1
    }
    selection["entityIds"] = newIds
    document["selection"] = selection
    return document
}

fn removeFromSelection(document, entityId) {
    let selection = document["selection"]
    let newIds = []
    let i = 0
    while i < len(selection["entityIds"]) {
        if selection["entityIds"][i] != entityId {
            newIds = push(newIds, selection["entityIds"][i])
        }
        i = i + 1
    }
    selection["entityIds"] = newIds
    document["selection"] = selection
    return document
}

pub fn clearSelection(document) {
    document["selection"]["entityIds"] = []
    return document
}

pub fn selectAll(document) {
    let selection = document["selection"]
    selection["entityIds"] = []
    for entityId in document["entities"] {
        let entity = document["entities"][entityId]
        if entity != null {
            selection["entityIds"] = push(selection["entityIds"], entityId)
        }
    }
    document["selection"] = selection
    return document
}

pub fn invertSelection(document) {
    let selection = document["selection"]
    let newIds = []
    for entityId in document["entities"] {
        let entity = document["entities"][entityId]
        if entity != null {
            let selected = false
            let i = 0
            while i < len(selection["entityIds"]) {
                if selection["entityIds"][i] == entityId {
                    selected = true
                }
                i = i + 1
            }
            if selected == false {
                newIds = push(newIds, entityId)
            }
        }
    }
    selection["entityIds"] = newIds
    document["selection"] = selection
    return document
}

pub fn getSelectedCount(document) {
    return len(document["selection"]["entityIds"])
}

pub fn isSelected(document, entityId) {
    let i = 0
    while i < len(document["selection"]["entityIds"]) {
        if document["selection"]["entityIds"][i] == entityId {
            return true
        }
        i = i + 1
    }
    return false
}

pub fn setSelectionMode(document, mode) {
    document["selection"]["mode"] = mode
    return document
}

pub fn beginUndo(document, description) {
    let snapshot = createDocumentSnapshot(document)
    document["undoStack"] = push(document["undoStack"], {
        "description": description,
        "snapshot": snapshot
    })
    
    if len(document["undoStack"]) > document["maxUndoSteps"] {
        document["undoStack"] = removeFirst(document["undoStack"])
    }
    
    document["redoStack"] = []
    return document
}

pub fn undo(document) {
    if len(document["undoStack"]) == 0 {
        return document
    }
    
    let action = document["undoStack"][len(document["undoStack"]) - 1]
    document["undoStack"] = removeLast(document["undoStack"])
    
    let currentSnapshot = createDocumentSnapshot(document)
    document["redoStack"] = push(document["redoStack"], {
        "description": action["description"],
        "snapshot": currentSnapshot
    })
    
    document = restoreDocumentSnapshot(document, action["snapshot"])
    return document
}

pub fn redo(document) {
    if len(document["redoStack"]) == 0 {
        return document
    }
    
    let action = document["redoStack"][len(document["redoStack"]) - 1]
    document["redoStack"] = removeLast(document["redoStack"])
    
    let currentSnapshot = createDocumentSnapshot(document)
    document["undoStack"] = push(document["undoStack"], {
        "description": action["description"],
        "snapshot": currentSnapshot
    })
    
    document = restoreDocumentSnapshot(document, action["snapshot"])
    return document
}

pub fn canUndo(document) {
    return len(document["undoStack"]) > 0
}

pub fn canRedo(document) {
    return len(document["redoStack"]) > 0
}

pub fn clearUndoRedo(document) {
    document["undoStack"] = []
    document["redoStack"] = []
    return document
}

fn createDocumentSnapshot(document) {
    return {
        "nodes": deepCopyNodes(document["nodes"]),
        "layers": deepCopyLayers(document["layers"]),
        "nodeCounter": document["nodeCounter"],
        "idCounter": document["idCounter"],
        "selection": deepCopySelection(document["selection"]),
        "sceneRoot": deepCopySceneNode(document["sceneRoot"]),
        "pages": deepCopyPages(document["pages"]),
        "activePage": document["activePage"]
    }
}

fn restoreDocumentSnapshot(document, snapshot) {
    document["nodes"] = deepCopyNodes(snapshot["nodes"])
    document["layers"] = deepCopyLayers(snapshot["layers"])
    document["nodeCounter"] = snapshot["nodeCounter"]
    document["idCounter"] = snapshot["idCounter"]
    document["selection"] = deepCopySelection(snapshot["selection"])
    document["sceneRoot"] = deepCopySceneNode(snapshot["sceneRoot"])
    document["pages"] = deepCopyPages(snapshot["pages"])
    document["activePage"] = snapshot["activePage"]
    return document
}

fn deepCopyNodes(nodes) {
    let copy = {}
    for nodeId in nodes {
        let node = nodes[nodeId]
        if node != null {
            copy[nodeId] = deepCopyNode(node)
        }
    }
    return copy
}

fn deepCopyNode(node) {
    let copy = {}
    for key in node {
        if key == "transform" {
            copy[key] = deepCopyTransform(node["transform"])
        } else if key == "children" {
            copy[key] = node["children"]
        } else {
            copy[key] = node[key]
        }
    }
    return copy
}

fn deepCopyEntities(entities) {
    let copy = {}
    for entityId in entities {
        let entity = entities[entityId]
        if entity != null {
            copy[entityId] = deepCopyEntity(entity)
        }
    }
    return copy
}

fn deepCopyEntity(entity) {
    let copy = {}
    for key in entity {
        if key == "data" {
            copy[key] = deepCopyEntityData(entity["data"], entity["kind"])
        } else if key == "properties" {
            copy[key] = deepCopyProperties(entity["properties"])
        } else {
            copy[key] = entity[key]
        }
    }
    return copy
}

fn deepCopyEntityData(data, kind) {
    if kind == "Line" {
        return createSegment(vec2(data["p1"]["x"], data["p1"]["y"]), vec2(data["p2"]["x"], data["p2"]["y"]))
    } else if kind == "Circle" {
        return createCircle(vec2(data["center"]["x"], data["center"]["y"]), data["radius"])
    } else if kind == "Rectangle" {
        return createRect(data["x"], data["y"], data["width"], data["height"])
    } else if kind == "Polyline" {
        let clonedPoints = []
        let i = 0
        while i < len(data["points"]) {
            clonedPoints = push(clonedPoints, vec2(data["points"][i]["x"], data["points"][i]["y"]))
            i = i + 1
        }
        return createPolyline(clonedPoints, data["closed"])
    } else if kind == "Point" {
        return { "position": vec2(data["position"]["x"], data["position"]["y"]) }
    } else if kind == "Text" {
        return {
            "position": vec2(data["position"]["x"], data["position"]["y"]),
            "text": data["text"],
            "fontSize": data["fontSize"],
            "font": data["font"],
            "alignment": data["alignment"]
        }
    } else if kind == "Arc" {
        return createArc(
            vec2(data["center"]["x"], data["center"]["y"]),
            data["radius"],
            data["startAngle"],
            data["endAngle"]
        )
    }
    return data
}

fn deepCopyProperties(properties) {
    let copy = {}
    for key in properties {
        copy[key] = properties[key]
    }
    return copy
}

fn deepCopyLayers(layers) {
    let copy = {}
    for layerName in layers {
        let layer = layers[layerName]
        if layer != null {
            copy[layerName] = {
                "name": layer["name"],
                "color": layer["color"],
                "visible": layer["visible"],
                "locked": layer["locked"],
                "printable": layer["printable"],
                "lineWidth": layer["lineWidth"],
                "lineStyle": layer["lineStyle"]
            }
        }
    }
    return copy
}

fn deepCopySelection(selection) {
    return {
        "kind": selection["kind"],
        "entityIds": selection["entityIds"],
        "mode": selection["mode"]
    }
}

fn deepCopySceneNode(node) {
    let copy = {}
    for key in node {
        if key == "transform" {
            copy[key] = deepCopyTransform(node["transform"])
        } else if key == "children" {
            copy[key] = node["children"]
        } else {
            copy[key] = node[key]
        }
    }
    return copy
}

fn deepCopyTransform(transform) {
    return {
        "kind": transform["kind"],
        "id": transform["id"],
        "position": vec2(transform["position"]["x"], transform["position"]["y"]),
        "rotation": transform["rotation"],
        "scale": vec2(transform["scale"]["x"], transform["scale"]["y"]),
        "parent": transform["parent"],
        "children": transform["children"],
        "worldMatrix": transform["worldMatrix"],
        "dirty": transform["dirty"]
    }
}

fn deepCopyPages(pages) {
    let copy = []
    let i = 0
    while i < len(pages) {
        copy = push(copy, {
            "kind": pages[i]["kind"],
            "id": pages[i]["id"],
            "name": pages[i]["name"],
            "sceneRoot": deepCopySceneNode(pages[i]["sceneRoot"])
        })
        i = i + 1
    }
    return copy
}

fn removeFirst(arr) {
    let result = []
    let i = 1
    while i < len(arr) {
        result = push(result, arr[i])
        i = i + 1
    }
    return result
}

fn removeLast(arr) {
    let result = []
    let i = 0
    while i < len(arr) - 1 {
        result = push(result, arr[i])
        i = i + 1
    }
    return result
}

pub fn setDocumentMetadata(document, key, value) {
    document["metadata"][key] = value
    return document
}

pub fn getDocumentMetadata(document, key) {
    return document["metadata"][key]
}

pub fn setDocumentName(document, name) {
    document["name"] = name
    document["metadata"]["title"] = name
    return document
}

pub fn setDocumentUnits(document, units) {
    document["units"] = units
    return document
}

pub fn getDocumentUnits(document) {
    return document["units"]
}

pub fn getEntityCount(document) {
    let count = 0
    for entityId in document["entities"] {
        if document["entities"][entityId] != null {
            count = count + 1
        }
    }
    return count
}

pub fn getLayerCount(document) {
    let count = 0
    for layerName in document["layers"] {
        if document["layers"][layerName] != null {
            count = count + 1
        }
    }
    return count
}

pub fn generateDocumentId() {
    return "doc-" + timestamp() + "-" + random()
}

pub fn generateNodeId(document) {
    document["idCounter"] = document["idCounter"] + 1
    return "node-" + document["idCounter"]
}

fn timestamp() {
    return floor(currentTime() * 1000.0)
}

fn currentTime() {
    return systemTime()
}

fn random() {
    return systemRandom()
}

fn floor(value) {
    let int = value
    if value < 0.0 && value != int {
        return int - 1
    }
    return int
}

fn systemTime() {
    return 0.0
}

fn systemRandom() {
    return 0.0
}
