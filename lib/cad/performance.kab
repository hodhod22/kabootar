@version "1.0.0"

// CAD Performance - Performance optimization for large documents (10k-50k nodes)
// Features: spatial indexing, lazy evaluation, incremental updates, culling
// Canonical path: import "cad/performance"
// Target: Performance system for large-scale CAD documents

import "cad/document"
import "cad/geom"
import "cad/host"

pub fn createPerformanceMonitor() {
    return {
        "kind": "PerformanceMonitor",
        "frameTime": 0.0,
        "nodeCount": 0,
        "visibleNodeCount": 0,
        "culledNodeCount": 0,
        "cacheHitRate": 0.0
    }
}

pub fn createSpatialIndex(cellSize, bounds) {
    return {
        "kind": "SpatialIndex",
        "cellSize": cellSize,
        "bounds": bounds,
        "grid": {},
        "nodeToCells": {}
    }
}

pub fn createQuadTree(bounds, maxItems, maxDepth) {
    return {
        "kind": "QuadTree",
        "bounds": bounds,
        "maxItems": maxItems,
        "maxDepth": maxDepth,
        "depth": 0,
        "items": [],
        "children": []
    }
}

pub fn buildQuadTree(document, maxItems, maxDepth) {
    let bounds = calculateDocumentBounds(document)
    let quadTree = createQuadTree(bounds, maxItems, maxDepth)
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null && node["visible"] == true {
            let nodeBounds = getNodeBounds(node)
            quadTree = insertNodeIntoQuadTree(quadTree, nodeId, nodeBounds)
        }
    }
    
    return quadTree
}

fn insertNodeIntoQuadTree(tree, nodeId, bounds) {
    if tree["depth"] >= tree["maxDepth"] || len(tree["children"]) == 0 {
        tree["items"] = push(tree["items"], { "nodeId": nodeId, "bounds": bounds })
        
        if len(tree["items"]) > tree["maxItems"] && tree["depth"] < tree["maxDepth"] {
            tree = subdivideQuadTree(tree)
        }
        
        return tree
    }
    
    let i = 0
    while i < len(tree["children"]) {
        let child = tree["children"][i]
        if bboxIntersectsBBox(bounds, child["bounds"]) == true {
            tree["children"][i] = insertNodeIntoQuadTree(child, nodeId, bounds)
        }
        i = i + 1
    }
    
    return tree
}

fn subdivideQuadTree(tree) {
    let bounds = tree["bounds"]
    let midX = (bounds["minX"] + bounds["maxX"]) / 2.0
    let midY = (bounds["minY"] + bounds["maxY"]) / 2.0
    
    let halfWidth = (bounds["maxX"] - bounds["minX"]) / 2.0
    let halfHeight = (bounds["maxY"] - bounds["minY"]) / 2.0
    
    let nwBounds = createBBox(bounds["minX"], bounds["minY"], midX, midY)
    let neBounds = createBBox(midX, bounds["minY"], bounds["maxX"], midY)
    let swBounds = createBBox(bounds["minX"], midY, midX, bounds["maxY"])
    let seBounds = createBBox(midX, midY, bounds["maxX"], bounds["maxY"])
    
    let nw = createQuadTree(nwBounds, tree["maxItems"], tree["maxDepth"])
    let ne = createQuadTree(neBounds, tree["maxItems"], tree["maxDepth"])
    let sw = createQuadTree(swBounds, tree["maxItems"], tree["maxDepth"])
    let se = createQuadTree(seBounds, tree["maxItems"], tree["maxDepth"])
    
    nw["depth"] = tree["depth"] + 1
    ne["depth"] = tree["depth"] + 1
    sw["depth"] = tree["depth"] + 1
    se["depth"] = tree["depth"] + 1
    
    tree["children"] = [nw, ne, sw, se]
    
    let i = 0
    while i < len(tree["items"]) {
        let item = tree["items"][i]
        let j = 0
        while j < len(tree["children"]) {
            if bboxIntersectsBBox(item["bounds"], tree["children"][j]["bounds"]) == true {
                tree["children"][j] = insertNodeIntoQuadTree(tree["children"][j], item["nodeId"], item["bounds"])
            }
            j = j + 1
        }
        i = i + 1
    }
    
    tree["items"] = []
    
    return tree
}

pub fn queryQuadTree(tree, bounds) {
    let nodeIds = []
    let seen = {}
    
    if bboxIntersectsBBox(bounds, tree["bounds"]) == false {
        return nodeIds
    }
    
    let i = 0
    while i < len(tree["items"]) {
        let item = tree["items"][i]
        if bboxIntersectsBBox(bounds, item["bounds"]) == true {
            if seen[item["nodeId"]] == null {
                nodeIds = push(nodeIds, item["nodeId"])
                seen[item["nodeId"]] = true
            }
        }
        i = i + 1
    }
    
    let j = 0
    while j < len(tree["children"]) {
        let childNodeIds = queryQuadTree(tree["children"][j], bounds)
        let k = 0
        while k < len(childNodeIds) {
            if seen[childNodeIds[k]] == null {
                nodeIds = push(nodeIds, childNodeIds[k])
                seen[childNodeIds[k]] = true
            }
            k = k + 1
        }
        j = j + 1
    }
    
    return nodeIds
}

pub fn removeNodeFromQuadTree(tree, nodeId) {
    let i = 0
    while i < len(tree["items"]) {
        if tree["items"][i]["nodeId"] == nodeId {
            let before = tree["items"][0:i]
            let after = tree["items"][i + 1:]
            tree["items"] = before
            let k = 0
            while k < len(after) {
                tree["items"] = push(tree["items"], after[k])
                k = k + 1
            }
            break
        }
        i = i + 1
    }
    
    let j = 0
    while j < len(tree["children"]) {
        tree["children"][j] = removeNodeFromQuadTree(tree["children"][j], nodeId)
        j = j + 1
    }
    
    return tree
}

pub fn clearQuadTree(tree) {
    tree["items"] = []
    tree["children"] = []
    return tree
}

pub fn getQuadTreeStats(tree) {
    let totalNodes = 0
    let totalItems = 0
    let maxDepth = 0
    
    let i = 0
    while i < len(tree["items"]) {
        totalItems = totalItems + 1
        i = i + 1
    }
    
    if tree["depth"] > maxDepth {
        maxDepth = tree["depth"]
    }
    
    let j = 0
    while j < len(tree["children"]) {
        let childStats = getQuadTreeStats(tree["children"][j])
        totalNodes = totalNodes + childStats["totalNodes"] + 1
        totalItems = totalItems + childStats["totalItems"]
        if childStats["maxDepth"] > maxDepth {
            maxDepth = childStats["maxDepth"]
        }
        j = j + 1
    }
    
    return {
        "totalNodes": totalNodes + 1,
        "totalItems": totalItems,
        "maxDepth": maxDepth
    }
}

pub fn buildSpatialIndex(document, cellSize) {
    let bounds = calculateDocumentBounds(document)
    let index = createSpatialIndex(cellSize, bounds)
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null && node["visible"] == true {
            let nodeBounds = getNodeBounds(node)
            index = insertNodeIntoSpatialIndex(index, nodeId, nodeBounds)
        }
    }
    
    return index
}

fn insertNodeIntoSpatialIndex(index, nodeId, bounds) {
    let cellSize = index["cellSize"]
    let minCellX = floor(bounds["minX"] / cellSize)
    let minCellY = floor(bounds["minY"] / cellSize)
    let maxCellX = floor(bounds["maxX"] / cellSize)
    let maxCellY = floor(bounds["maxY"] / cellSize)
    
    let x = minCellX
    while x <= maxCellX {
        let y = minCellY
        while y <= maxCellY {
            let cellKey = "" + x + "," + y
            if index["grid"][cellKey] == null {
                index["grid"][cellKey] = []
            }
            index["grid"][cellKey] = push(index["grid"][cellKey], nodeId)
            y = y + 1
        }
        x = x + 1
    }
    
    return index
}

pub fn querySpatialIndex(index, bounds) {
    let cellSize = index["cellSize"]
    let minCellX = floor(bounds["minX"] / cellSize)
    let minCellY = floor(bounds["minY"] / cellSize)
    let maxCellX = floor(bounds["maxX"] / cellSize)
    let maxCellY = floor(bounds["maxY"] / cellSize)
    
    let nodeIds = []
    let seen = {}
    
    let x = minCellX
    while x <= maxCellX {
        let y = minCellY
        while y <= maxCellY {
            let cellKey = "" + x + "," + y
            let cell = index["grid"][cellKey]
            if cell != null {
                let i = 0
                while i < len(cell) {
                    let nodeId = cell[i]
                    if seen[nodeId] == null {
                        nodeIds = push(nodeIds, nodeId)
                        seen[nodeId] = true
                    }
                    i = i + 1
                }
            }
            y = y + 1
        }
        x = x + 1
    }
    
    return nodeIds
}

pub fn createRenderCache() {
    return {
        "kind": "RenderCache",
        "nodeCache": {},
        "maxCacheSize": 1000,
        "cacheHits": 0,
        "cacheMisses": 0
    }
}

pub fn createLazyLoadSystem() {
    return {
        "kind": "LazyLoadSystem",
        "loadedNodes": {},
        "pendingNodes": {},
        "priorityQueue": [],
        "maxConcurrentLoads": 5,
        "currentLoads": 0
    }
}

pub fn markNodeForLazyLoad(system, nodeId, priority) {
    if system["loadedNodes"][nodeId] == null && system["pendingNodes"][nodeId] == null {
        system["pendingNodes"][nodeId] = true
        system["priorityQueue"] = push(system["priorityQueue"], { "nodeId": nodeId, "priority": priority })
        system["priorityQueue"] = sortPriorityQueue(system["priorityQueue"])
    }
    return system
}

fn sortPriorityQueue(queue) {
    let sorted = []
    let i = 0
    while i < len(queue) {
        let item = queue[i]
        let j = 0
        while j < len(sorted) {
            if item["priority"] > sorted[j]["priority"] {
                let temp = sorted[j]
                sorted[j] = item
                item = temp
            }
            j = j + 1
        }
        sorted = push(sorted, item)
        i = i + 1
    }
    return sorted
}

pub fn processLazyLoadQueue(system) {
    if system["currentLoads"] >= system["maxConcurrentLoads"] {
        return system
    }
    
    while len(system["priorityQueue"]) > 0 && system["currentLoads"] < system["maxConcurrentLoads"] {
        let item = system["priorityQueue"][0]
        let before = system["priorityQueue"][0:0]
        let after = system["priorityQueue"][1:]
        system["priorityQueue"] = before
        let k = 0
        while k < len(after) {
            system["priorityQueue"] = push(system["priorityQueue"], after[k])
            k = k + 1
        }
        
        system["currentLoads"] = system["currentLoads"] + 1
        system["loadedNodes"][item["nodeId"]] = true
        system["pendingNodes"][item["nodeId"]] = null
    }
    
    return system
}

pub fn isNodeLoaded(system, nodeId) {
    return system["loadedNodes"][nodeId] == true
}

pub fn clearLazyLoadSystem(system) {
    system["loadedNodes"] = {}
    system["pendingNodes"] = {}
    system["priorityQueue"] = []
    system["currentLoads"] = 0
    return system
}

pub fn createMultiLevelCache() {
    return {
        "kind": "MultiLevelCache",
        "l1Cache": {},
        "l1Size": 100,
        "l2Cache": {},
        "l2Size": 1000,
        "l3Cache": {},
        "l3Size": 10000,
        "l1Hits": 0,
        "l2Hits": 0,
        "l3Hits": 0,
        "misses": 0
    }
}

pub fn getMultiLevelCache(cache, key) {
    let data = cache["l1Cache"][key]
    if data != null {
        cache["l1Hits"] = cache["l1Hits"] + 1
        return data
    }
    
    data = cache["l2Cache"][key]
    if data != null {
        cache["l2Hits"] = cache["l2Hits"] + 1
        cache["l1Cache"][key] = data
        return data
    }
    
    data = cache["l3Cache"][key]
    if data != null {
        cache["l3Hits"] = cache["l3Hits"] + 1
        cache["l2Cache"][key] = data
        return data
    }
    
    cache["misses"] = cache["misses"] + 1
    return null
}

pub fn setMultiLevelCache(cache, key, data) {
    cache["l3Cache"][key] = data
    if len(cache["l3Cache"]) > cache["l3Size"] {
        cache = evictL3Cache(cache)
    }
    cache["l2Cache"][key] = data
    if len(cache["l2Cache"]) > cache["l2Size"] {
        cache = evictL2Cache(cache)
    }
    cache["l1Cache"][key] = data
    if len(cache["l1Cache"]) > cache["l1Size"] {
        cache = evictL1Cache(cache)
    }
    return cache
}

fn evictL1Cache(cache) {
    let keys = []
    for key in cache["l1Cache"] {
        keys = push(keys, key)
    }
    if len(keys) > 0 {
        cache["l1Cache"][keys[0]] = null
    }
    return cache
}

fn evictL2Cache(cache) {
    let keys = []
    for key in cache["l2Cache"] {
        keys = push(keys, key)
    }
    if len(keys) > 0 {
        cache["l2Cache"][keys[0]] = null
    }
    return cache
}

fn evictL3Cache(cache) {
    let keys = []
    for key in cache["l3Cache"] {
        keys = push(keys, key)
    }
    if len(keys) > 0 {
        cache["l3Cache"][keys[0]] = null
    }
    return cache
}

pub fn getMultiLevelCacheStats(cache) {
    let total = cache["l1Hits"] + cache["l2Hits"] + cache["l3Hits"] + cache["misses"]
    if total == 0 {
        return { "hitRate": 0.0, "l1Rate": 0.0, "l2Rate": 0.0, "l3Rate": 0.0 }
    }
    return {
        "hitRate": (cache["l1Hits"] + cache["l2Hits"] + cache["l3Hits"]) / total,
        "l1Rate": cache["l1Hits"] / total,
        "l2Rate": cache["l2Hits"] / total,
        "l3Rate": cache["l3Hits"] / total
    }
}

pub fn getCachedRenderData(cache, nodeId) {
    let data = cache["nodeCache"][nodeId]
    if data != null {
        cache["cacheHits"] = cache["cacheHits"] + 1
        return data
    }
    cache["cacheMisses"] = cache["cacheMisses"] + 1
    return null
}

pub fn setCachedRenderData(cache, nodeId, data) {
    if len(cache["nodeCache"]) >= cache["maxCacheSize"] {
        cache = evictOldestCacheEntry(cache)
    }
    cache["nodeCache"][nodeId] = {
        "data": data,
        "timestamp": systemTime()
    }
    return cache
}

fn evictOldestCacheEntry(cache) {
    let oldestKey = null
    let oldestTime = 1e10
    
    for key in cache["nodeCache"] {
        let entry = cache["nodeCache"][key]
        if entry["timestamp"] < oldestTime {
            oldestTime = entry["timestamp"]
            oldestKey = key
        }
    }
    
    if oldestKey != null {
        let newCache = {}
        for key in cache["nodeCache"] {
            if key != oldestKey {
                newCache[key] = cache["nodeCache"][key]
            }
        }
        cache["nodeCache"] = newCache
    }
    
    return cache
}

pub fn getCacheHitRate(cache) {
    let total = cache["cacheHits"] + cache["cacheMisses"]
    if total == 0 {
        return 0.0
    }
    return cache["cacheHits"] / total
}

pub fn clearRenderCache(cache) {
    cache["nodeCache"] = {}
    cache["cacheHits"] = 0
    cache["cacheMisses"] = 0
    return cache
}

pub fn createDirtyFlagSystem() {
    return {
        "kind": "DirtyFlagSystem",
        "dirtyNodes": {},
        "dirtyLayers": {},
        "globalDirty": false
    }
}

pub fn markNodeDirty(system, nodeId) {
    system["dirtyNodes"][nodeId] = true
    system["globalDirty"] = true
    return system
}

pub fn markLayerDirty(system, layerName) {
    system["dirtyLayers"][layerName] = true
    system["globalDirty"] = true
    return system
}

pub fn markGlobalDirty(system) {
    system["globalDirty"] = true
    return system
}

pub fn clearNodeDirty(system, nodeId) {
    system["dirtyNodes"][nodeId] = null
    return system
}

pub fn clearLayerDirty(system, layerName) {
    system["dirtyLayers"][layerName] = null
    return system
}

pub fn clearAllDirty(system) {
    system["dirtyNodes"] = {}
    system["dirtyLayers"] = {}
    system["globalDirty"] = false
    return system
}

pub fn isNodeDirty(system, nodeId) {
    return system["dirtyNodes"][nodeId] == true
}

pub fn isLayerDirty(system, layerName) {
    return system["dirtyLayers"][layerName] == true
}

pub fn isGlobalDirty(system) {
    return system["globalDirty"] == true
}

pub fn createLODSystem() {
    return {
        "kind": "LODSystem",
        "levels": [
            { "distance": 0.0, "detail": 1.0 },
            { "distance": 100.0, "detail": 0.5 },
            { "distance": 500.0, "detail": 0.25 }
        ]
    }
}

pub fn getLODLevel(system, distance) {
    let i = 0
    while i < len(system["levels"]) {
        if distance < system["levels"][i]["distance"] {
            return system["levels"][i]["detail"]
        }
        i = i + 1
    }
    return system["levels"][len(system["levels"]) - 1]["detail"]
}

pub fn cullNodesByViewport(document, viewport) {
    let culledCount = 0
    let visibleCount = 0
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null {
            let bounds = getNodeBounds(node)
            if bboxIntersectsBBox(bounds, viewport) == false {
                node["culled"] = true
                culledCount = culledCount + 1
            } else {
                node["culled"] = false
                visibleCount = visibleCount + 1
            }
            document["nodes"][nodeId] = node
        }
    }
    
    return {
        "document": document,
        "culledCount": culledCount,
        "visibleCount": visibleCount
    }
}

pub fn cullNodesByDistance(document, cameraPosition, maxDistance) {
    let culledCount = 0
    let visibleCount = 0
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null {
            let pos = node["transform"]["position"]
            let dist = distance(pos, cameraPosition)
            if dist > maxDistance {
                node["culled"] = true
                culledCount = culledCount + 1
            } else {
                node["culled"] = false
                visibleCount = visibleCount + 1
            }
            document["nodes"][nodeId] = node
        }
    }
    
    return {
        "document": document,
        "culledCount": culledCount,
        "visibleCount": visibleCount
    }
}

pub fn createIncrementalRenderer() {
    return {
        "kind": "IncrementalRenderer",
        "batchSize": 100,
        "currentBatch": 0,
        "totalBatches": 0
    }
}

pub fn renderIncremental(document, renderer) {
    let batchSize = renderer["batchSize"]
    let nodeIds = []
    let count = 0
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null && node["culled"] == false {
            nodeIds = push(nodeIds, nodeId)
            count = count + 1
            if count >= batchSize {
                break
            }
        }
    }
    
    renderer["currentBatch"] = renderer["currentBatch"] + 1
    
    return {
        "nodeIds": nodeIds,
        "complete": count < batchSize,
        "renderer": renderer
    }
}

pub fn resetIncrementalRenderer(renderer) {
    renderer["currentBatch"] = 0
    return renderer
}

pub fn optimizeDocument(document) {
    let monitor = createPerformanceMonitor()
    
    monitor["nodeCount"] = getNodeCount(document)
    
    let spatialIndex = buildSpatialIndex(document, 100.0)
    
    let renderCache = createRenderCache()
    
    let dirtySystem = createDirtyFlagSystem()
    
    let lodSystem = createLODSystem()
    
    return {
        "document": document,
        "monitor": monitor,
        "spatialIndex": spatialIndex,
        "renderCache": renderCache,
        "dirtySystem": dirtySystem,
        "lodSystem": lodSystem
    }
}

fn calculateDocumentBounds(document) {
    if len(document["nodes"]) == 0 {
        return createBBox(0.0, 0.0, 1000.0, 1000.0)
    }
    
    let minX = 1e10
    let minY = 1e10
    let maxX = -1e10
    let maxY = -1e10
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null {
            let bounds = getNodeBounds(node)
            if bounds["minX"] < minX { minX = bounds["minX"] }
            if bounds["minY"] < minY { minY = bounds["minY"] }
            if bounds["maxX"] > maxX { maxX = bounds["maxX"] }
            if bounds["maxY"] > maxY { maxY = bounds["maxY"] }
        }
    }
    
    return createBBox(minX, minY, maxX, maxY)
}
