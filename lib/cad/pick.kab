@version "1.0.0"

// CAD Pick - Spatial index for picking scene nodes on click
// Features: Linear pick for now, grid/R-tree later if needed
// Canonical path: import "cad/pick"
// Uses scene nodes (not entities) as single source of truth

import "cad/geom"
import "cad/document"

pub fn createSpatialIndex() {
    return {
        "kind": "SpatialIndex",
        "type": "linear",
        "nodes": [],
        "grid": null,
        "rtree": null
    }
}

pub fn createGridSpatialIndex(cellSize, bounds) {
    return {
        "kind": "SpatialIndex",
        "type": "grid",
        "cellSize": cellSize,
        "bounds": bounds,
        "grid": {},
        "nodes": []
    }
}

pub fn buildSpatialIndex(document) {
    let index = createSpatialIndex()
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null && node["visible"] == true {
            let bounds = getNodeWorldBounds(node)
            index["nodes"] = push(index["nodes"], {
                "nodeId": nodeId,
                "bounds": bounds,
                "node": node
            })
        }
    }
    
    return index
}

pub fn buildGridSpatialIndex(document, cellSize) {
    let bounds = calculateDocumentBounds(document)
    let index = createGridSpatialIndex(cellSize, bounds)
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null && node["visible"] == true {
            let nodeBounds = getNodeWorldBounds(node)
            index = insertNodeIntoGrid(index, nodeId, nodeBounds, node)
        }
    }
    
    return index
}

fn calculateDocumentBounds(document) {
    if len(document["nodes"]) == 0 {
        return createBBox(0.0, 0.0, 1000.0, 1000.0)
    }
    
    let minX = 1e10
    let minY = 1e10
    let maxX = -1e10
    let maxY = -1e10
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null {
            let bounds = getNodeWorldBounds(node)
            if bounds["minX"] < minX {
                minX = bounds["minX"]
            }
            if bounds["minY"] < minY {
                minY = bounds["minY"]
            }
            if bounds["maxX"] > maxX {
                maxX = bounds["maxX"]
            }
            if bounds["maxY"] > maxY {
                maxY = bounds["maxY"]
            }
        }
    }
    
    return createBBox(minX, minY, maxX, maxY)
}

fn getNodeWorldBounds(node) {
    let kind = node["kind"]
    
    if kind == "Frame" {
        let pos = node["transform"]["position"]
        let worldPos = matrix2DTransformPoint(node["transform"]["worldMatrix"], pos)
        return createBBox(worldPos["x"], worldPos["y"], worldPos["x"] + node["width"], worldPos["y"] + node["height"])
    } else if kind == "Group" {
        let pos = node["transform"]["position"]
        let worldPos = matrix2DTransformPoint(node["transform"]["worldMatrix"], pos)
        return createBBox(worldPos["x"] - 10.0, worldPos["y"] - 10.0, worldPos["x"] + 10.0, worldPos["y"] + 10.0)
    } else if kind == "Component" {
        let pos = node["transform"]["position"]
        let worldPos = matrix2DTransformPoint(node["transform"]["worldMatrix"], pos)
        return createBBox(worldPos["x"] - 20.0, worldPos["y"] - 20.0, worldPos["x"] + 20.0, worldPos["y"] + 20.0)
    } else if kind == "Vector" || kind == "Shape" {
        let data = node["data"]
        if data != null && data["bounds"] != null {
            let bounds = data["bounds"]
            let minWorld = matrix2DTransformPoint(node["transform"]["worldMatrix"], vec2(bounds["minX"], bounds["minY"]))
            let maxWorld = matrix2DTransformPoint(node["transform"]["worldMatrix"], vec2(bounds["maxX"], bounds["maxY"]))
            return createBBox(minWorld["x"], minWorld["y"], maxWorld["x"], maxWorld["y"])
        }
    }
    
    return createBBox(0.0, 0.0, 0.0, 0.0)
}

fn calculateGroupBounds(group) {
    let pos = group["transform"]["position"]
    return createBBox(pos["x"], pos["y"], pos["x"] + 50.0, pos["y"] + 50.0)
}

fn insertNodeIntoGrid(index, nodeId, bounds, node) {
    let cellSize = index["cellSize"]
    let minCellX = floor(bounds["minX"] / cellSize)
    let minCellY = floor(bounds["minY"] / cellSize)
    let maxCellX = floor(bounds["maxX"] / cellSize)
    let maxCellY = floor(bounds["maxY"] / cellSize)
    
    let x = minCellX
    while x <= maxCellX {
        let y = minCellY
        while y <= maxCellY {
            let cellKey = "" + x + "," + y
            if index["grid"][cellKey] == null {
                index["grid"][cellKey] = []
            }
            index["grid"][cellKey] = push(index["grid"][cellKey], {
                "nodeId": nodeId,
                "bounds": bounds,
                "node": node
            })
            y = y + 1
        }
        x = x + 1
    }
    
    index["nodes"] = push(index["nodes"], {
        "nodeId": nodeId,
        "bounds": bounds,
        "node": node
    })
    
    return index
}

pub fn pickPoint(index, x, y, tolerance) {
    if index["type"] == "linear" {
        return pickPointLinear(index, x, y, tolerance)
    } else if index["type"] == "grid" {
        return pickPointGrid(index, x, y, tolerance)
    }
    return null
}

fn pickPointLinear(index, x, y, tolerance) {
    let pickBBox = createBBox(x - tolerance, y - tolerance, x + tolerance, y + tolerance)
    let closest = null
    let closestDist = tolerance
    
    let i = 0
    while i < len(index["nodes"]) {
        let item = index["nodes"][i]
        if bboxIntersectsBBox(item["bounds"], pickBBox) {
            let dist = distanceToNode(item["node"], x, y)
            if dist < closestDist {
                closest = item
                closestDist = dist
            }
        }
        i = i + 1
    }
    
    if closest != null {
        return closest["nodeId"]
    }
    
    return null
}

fn pickPointGrid(index, x, y, tolerance) {
    let cellSize = index["cellSize"]
    let cellX = floor(x / cellSize)
    let cellY = floor(y / cellSize)
    
    let cellKey = "" + cellX + "," + cellY
    let cellEntities = index["grid"][cellKey]
    
    if cellEntities == null {
        return null
    }
    
    let pickBBox = createBBox(x - tolerance, y - tolerance, x + tolerance, y + tolerance)
    let closest = null
    let closestDist = tolerance
    
    let i = 0
    while i < len(cellEntities) {
        let item = cellEntities[i]
        if bboxIntersectsBBox(item["bounds"], pickBBox) {
            let dist = distanceToNode(item["node"], x, y)
            if dist < closestDist {
                closest = item
                closestDist = dist
            }
        }
        i = i + 1
    }
    
    if closest != null {
        return closest["nodeId"]
    }
    
    return null
}

pub fn pickBox(index, x1, y1, x2, y2) {
    let minX = min(x1, x2)
    let maxX = max(x1, x2)
    let minY = min(y1, y2)
    let maxY = max(y1, y2)
    
    let pickBBox = createBBox(minX, minY, maxX, maxY)
    let picked = []
    
    if index["type"] == "linear" {
        let i = 0
        while i < len(index["nodes"]) {
            let item = index["nodes"][i]
            if bboxIntersectsBBox(item["bounds"], pickBBox) {
                picked = push(picked, item["nodeId"])
            }
            i = i + 1
        }
    } else if index["type"] == "grid" {
        let cellSize = index["cellSize"]
        let minCellX = floor(minX / cellSize)
        let minCellY = floor(minY / cellSize)
        let maxCellX = floor(maxX / cellSize)
        let maxCellY = floor(maxY / cellSize)
        
        let x = minCellX
        while x <= maxCellX {
            let y = minCellY
            while y <= maxCellY {
                let cellKey = "" + x + "," + y
                let cellNodes = index["grid"][cellKey]
                if cellNodes != null {
                    let j = 0
                    while j < len(cellNodes) {
                        let item = cellNodes[j]
                        if bboxIntersectsBBox(item["bounds"], pickBBox) {
                            picked = push(picked, item["nodeId"])
                        }
                        j = j + 1
                    }
                }
                y = y + 1
            }
            x = x + 1
        }
    }
    
    return picked
}

pub fn pickRay(index, origin, direction, maxDistance) {
    let picked = []
    
    let i = 0
    while i < len(index["nodes"]) {
        let item = index["nodes"][i]
        if rayIntersectsBBox(origin, direction, item["bounds"], maxDistance) {
            picked = push(picked, item["nodeId"])
        }
        i = i + 1
    }
    
    return picked
}

pub fn pickPoint(index, x, y, tolerance) {
    let point = vec2(x, y)
    let picked = []
    
    if index["type"] == "linear" {
        let i = 0
        while i < len(index["nodes"]) {
            let item = index["nodes"][i]
            if pointInBBox(point, item["bounds"], tolerance) {
                picked = push(picked, item["nodeId"])
            }
            i = i + 1
        }
    } else if index["type"] == "grid" {
        let cellSize = index["cellSize"]
        let cellX = floor(x / cellSize)
        let cellY = floor(y / cellSize)
        let cellKey = "" + cellX + "," + cellY
        let cellNodes = index["grid"][cellKey]
        if cellNodes != null {
            let j = 0
            while j < len(cellNodes) {
                let item = cellNodes[j]
                if pointInBBox(point, item["bounds"], tolerance) {
                    picked = push(picked, item["nodeId"])
                }
                j = j + 1
            }
        }
    }
    
    return picked
}

fn getNodeBoundsFromData(node) {
    let kind = node["kind"]
    let meta = node["meta"]
    
    if kind == "part" || kind == "device" || kind == "airfoil" {
        let pos = node["transform"]["position"]
        let worldPos = matrix2DTransformPoint(node["transform"]["worldMatrix"], pos)
        return createBBox(worldPos["x"] - 10.0, worldPos["y"] - 10.0, worldPos["x"] + 10.0, worldPos["y"] + 10.0)
    } else if kind == "room" {
        let pos = node["transform"]["position"]
        let worldPos = matrix2DTransformPoint(node["transform"]["worldMatrix"], pos)
        if meta != null {
            return createBBox(worldPos["x"], worldPos["y"], worldPos["x"] + meta["width"], worldPos["y"] + meta["depth"])
        }
        return createBBox(worldPos["x"], worldPos["y"], worldPos["x"] + 4.0, worldPos["y"] + 3.0)
    } else if kind == "wall" {
        if meta != null {
            return createBBox(
                min(meta["ax"], meta["bx"]),
                min(meta["ay"], meta["by"]),
                max(meta["ax"], meta["bx"]),
                max(meta["ay"], meta["by"])
            )
        }
    }
    
    return createBBox(0.0, 0.0, 0.0, 0.0)
}

fn distanceToNode(node, x, y) {
    let kind = node["kind"]
    let meta = node["meta"]
    
    if kind == "part" || kind == "device" || kind == "airfoil" {
        let pos = node["transform"]["position"]
        return vec2Distance(pos, vec2(x, y))
    } else if kind == "room" {
        let pos = node["transform"]["position"]
        return vec2Distance(pos, vec2(x, y))
    } else if kind == "wall" {
        if meta != null {
            let seg = createSegment(vec2(meta["ax"], meta["ay"]), vec2(meta["bx"], meta["by"]))
            return segmentDistanceToPoint(seg, vec2(x, y))
        }
    }
    
    return 0.0
}

fn closestPointOnRect(rect, x, y) {
    let closestX = max(rect["x"], min(x, rect["x"] + rect["width"]))
    let closestY = max(rect["y"], min(y, rect["y"] + rect["height"]))
    return vec2(closestX, closestY)
}

fn rayIntersectsBBox(origin, direction, bbox, maxDistance) {
    let tmin = -maxDistance
    let tmax = maxDistance
    
    if direction["x"] != 0.0 {
        let tx1 = (bbox["minX"] - origin["x"]) / direction["x"]
        let tx2 = (bbox["maxX"] - origin["x"]) / direction["x"]
        
        tmin = max(tmin, min(tx1, tx2))
        tmax = min(tmax, max(tx1, tx2))
    } else if origin["x"] < bbox["minX"] || origin["x"] > bbox["maxX"] {
        return false
    }
    
    if direction["y"] != 0.0 {
        let ty1 = (bbox["minY"] - origin["y"]) / direction["y"]
        let ty2 = (bbox["maxY"] - origin["y"]) / direction["y"]
        
        tmin = max(tmin, min(ty1, ty2))
        tmax = min(tmax, max(ty1, ty2))
    } else if origin["y"] < bbox["minY"] || origin["y"] > bbox["maxY"] {
        return false
    }
    
    return tmax >= tmin
}

pub fn updateSpatialIndex(index, document) {
    if index["type"] == "linear" {
        return buildSpatialIndex(document)
    } else if index["type"] == "grid" {
        return buildGridSpatialIndex(document, index["cellSize"])
    }
    return index
}

pub fn clearSpatialIndex(index) {
    if index["type"] == "grid" {
        index["grid"] = {}
    }
    index["nodes"] = []
    return index
}

pub fn getNodeCount(index) {
    return len(index["nodes"])
}

fn min(a, b) {
    return systemMin(a, b)
}

fn max(a, b) {
    return systemMax(a, b)
}
