@version "1.0.0"

// CAD Vector - Advanced vector graphics with bezier curves
// Features: bezier paths, path operations, stroke/fill, path trimming
// Canonical path: import "cad/vector"
// Target: Vector graphics engine comparable to Illustrator/Figma

import "cad/geom"

pub fn createPath() {
    return {
        "kind": "Path",
        "id": generatePathId(),
        "segments": [],
        "closed": false
    }
}

pub fn moveTo(path, x, y) {
    let segment = {
        "kind": "MoveTo",
        "x": x,
        "y": y
    }
    path["segments"] = push(path["segments"], segment)
    return path
}

pub fn lineTo(path, x, y) {
    let segment = {
        "kind": "LineTo",
        "x": x,
        "y": y
    }
    path["segments"] = push(path["segments"], segment)
    return path
}

pub fn cubicBezierTo(path, cp1x, cp1y, cp2x, cp2y, x, y) {
    let segment = {
        "kind": "CubicBezierTo",
        "cp1x": cp1x,
        "cp1y": cp1y,
        "cp2x": cp2x,
        "cp2y": cp2y,
        "x": x,
        "y": y
    }
    path["segments"] = push(path["segments"], segment)
    return path
}

pub fn quadraticBezierTo(path, cpx, cpy, x, y) {
    let segment = {
        "kind": "QuadraticBezierTo",
        "cpx": cpx,
        "cpy": cpy,
        "x": x,
        "y": y
    }
    path["segments"] = push(path["segments"], segment)
    return path
}

pub fn arcTo(path, rx, ry, rotation, largeArc, sweep, x, y) {
    let segment = {
        "kind": "ArcTo",
        "rx": rx,
        "ry": ry,
        "rotation": rotation,
        "largeArc": largeArc,
        "sweep": sweep,
        "x": x,
        "y": y
    }
    path["segments"] = push(path["segments"], segment)
    return path
}

pub fn closePath(path) {
    path["closed"] = true
    return path
}

pub fn getPathBounds(path) {
    if len(path["segments"]) == 0 {
        return createBBox(0.0, 0.0, 0.0, 0.0)
    }
    
    let minX = 1e10
    let minY = 1e10
    let maxX = -1e10
    let maxY = -1e10
    
    let i = 0
    while i < len(path["segments"]) {
        let seg = path["segments"][i]
        if seg["kind"] == "MoveTo" || seg["kind"] == "LineTo" || 
           seg["kind"] == "CubicBezierTo" || seg["kind"] == "QuadraticBezierTo" {
            if seg["x"] < minX { minX = seg["x"] }
            if seg["y"] < minY { minY = seg["y"] }
            if seg["x"] > maxX { maxX = seg["x"] }
            if seg["y"] > maxY { maxY = seg["y"] }
        }
        i = i + 1
    }
    
    return createBBox(minX, minY, maxX, maxY)
}

pub fn transformPath(path, matrix) {
    let i = 0
    while i < len(path["segments"]) {
        let seg = path["segments"][i]
        let p = vec2(seg["x"], seg["y"])
        let transformed = matrix2DTransformPoint(matrix, p)
        seg["x"] = transformed["x"]
        seg["y"] = transformed["y"]
        
        if seg["kind"] == "CubicBezierTo" {
            let cp1 = vec2(seg["cp1x"], seg["cp1y"])
            let cp2 = vec2(seg["cp2x"], seg["cp2y"])
            let tcp1 = matrix2DTransformPoint(matrix, cp1)
            let tcp2 = matrix2DTransformPoint(matrix, cp2)
            seg["cp1x"] = tcp1["x"]
            seg["cp1y"] = tcp1["y"]
            seg["cp2x"] = tcp2["x"]
            seg["cp2y"] = tcp2["y"]
        } else if seg["kind"] == "QuadraticBezierTo" {
            let cp = vec2(seg["cpx"], seg["cpy"])
            let tcp = matrix2DTransformPoint(matrix, cp)
            seg["cpx"] = tcp["x"]
            seg["cpy"] = tcp["y"]
        }
        
        i = i + 1
    }
    
    return path
}

pub fn flattenBezier(path, tolerance) {
    // Convert bezier curves to line segments for rendering
    let flatPath = createPath()
    flatPath["closed"] = path["closed"]
    
    let i = 0
    while i < len(path["segments"]) {
        let seg = path["segments"][i]
        if seg["kind"] == "MoveTo" {
            flatPath = moveTo(flatPath, seg["x"], seg["y"])
        } else if seg["kind"] == "LineTo" {
            flatPath = lineTo(flatPath, seg["x"], seg["y"])
        } else if seg["kind"] == "CubicBezierTo" {
            flatPath = flattenCubicBezier(flatPath, seg, tolerance)
        } else if seg["kind"] == "QuadraticBezierTo" {
            flatPath = flattenQuadraticBezier(flatPath, seg, tolerance)
        } else if seg["kind"] == "ArcTo" {
            flatPath = flattenArc(flatPath, seg, tolerance)
        }
        i = i + 1
    }
    
    return flatPath
}

fn flattenCubicBezier(path, seg, tolerance) {
    // De Casteljau's algorithm for flattening cubic bezier
    let steps = 10
    let x0 = getLastPoint(path)["x"]
    let y0 = getLastPoint(path)["y"]
    let x1 = seg["cp1x"]
    let y1 = seg["cp1y"]
    let x2 = seg["cp2x"]
    let y2 = seg["cp2y"]
    let x3 = seg["x"]
    let y3 = seg["y"]
    
    let t = 0.0
    let dt = 1.0 / steps
    while t <= 1.0 {
        let mt = 1.0 - t
        let mt2 = mt * mt
        let mt3 = mt2 * mt
        let t2 = t * t
        let t3 = t2 * t
        
        let bx = mt3 * x0 + 3.0 * mt2 * t * x1 + 3.0 * mt * t2 * x2 + t3 * x3
        let by = mt3 * y0 + 3.0 * mt2 * t * y1 + 3.0 * mt * t2 * y2 + t3 * y3
        
        if t > 0.0 {
            path = lineTo(path, bx, by)
        }
        
        t = t + dt
    }
    
    return path
}

fn flattenQuadraticBezier(path, seg, tolerance) {
    let steps = 10
    let x0 = getLastPoint(path)["x"]
    let y0 = getLastPoint(path)["y"]
    let x1 = seg["cpx"]
    let y1 = seg["cpy"]
    let x2 = seg["x"]
    let y2 = seg["y"]
    
    let t = 0.0
    let dt = 1.0 / steps
    while t <= 1.0 {
        let mt = 1.0 - t
        let mt2 = mt * mt
        let t2 = t * t
        
        let bx = mt2 * x0 + 2.0 * mt * t * x1 + t2 * x2
        let by = mt2 * y0 + 2.0 * mt * t * y1 + t2 * y2
        
        if t > 0.0 {
            path = lineTo(path, bx, by)
        }
        
        t = t + dt
    }
    
    return path
}

fn flattenArc(path, seg, tolerance) {
    // Simplified arc flattening
    let steps = 20
    let x0 = getLastPoint(path)["x"]
    let y0 = getLastPoint(path)["y"]
    let x1 = seg["x"]
    let y1 = seg["y"]
    
    let t = 0.0
    let dt = 1.0 / steps
    while t <= 1.0 {
        let bx = x0 + (x1 - x0) * t
        let by = y0 + (y1 - y0) * t
        
        if t > 0.0 {
            path = lineTo(path, bx, by)
        }
        
        t = t + dt
    }
    
    return path
}

fn getLastPoint(path) {
    if len(path["segments"]) == 0 {
        return vec2(0.0, 0.0)
    }
    let last = path["segments"][len(path["segments"]) - 1]
    return vec2(last["x"], last["y"])
}

fn generatePathId() {
    return "path-" + floor(systemTime() * 1000.0) + "-" + systemRandom()
}

fn floor(value) {
    let int = value
    if value < 0.0 && value != int {
        return int - 1
    }
    return int
}
