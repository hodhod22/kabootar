@version "1.0.0"

// CAD Boolean - Polygon boolean operations using Weiler-Atherton algorithm
// Features: Union, intersection, difference for polygon paths (true boolean, not bbox)
// Canonical path: import "cad/boolean"
// Target: Accurate boolean operations comparable to Clipper/CGAL

import "cad/geom"
import "cad/host"
import "cad/performance"

pub fn booleanUnion(pathA, pathB) {
    if pathA["kind"] == "Path" && pathB["kind"] == "Path" {
        let bboxA = getPathBBox(pathA)
        let bboxB = getPathBBox(pathB)
        
        if bboxIntersectsBBox(bboxA, bboxB) == false {
            return pathA
        }
        
        return polygonUnion(pathA, pathB)
    }
    return pathA
}

pub fn booleanIntersection(pathA, pathB) {
    if pathA["kind"] == "Path" && pathB["kind"] == "Path" {
        let bboxA = getPathBBox(pathA)
        let bboxB = getPathBBox(pathB)
        
        if bboxIntersectsBBox(bboxA, bboxB) == false {
            return createPath()
        }
        
        return polygonIntersection(pathA, pathB)
    }
    return pathA
}

pub fn booleanDifference(pathA, pathB) {
    if pathA["kind"] == "Path" && pathB["kind"] == "Path" {
        let bboxA = getPathBBox(pathA)
        let bboxB = getPathBBox(pathB)
        
        if bboxIntersectsBBox(bboxA, bboxB) == false {
            return pathA
        }
        
        return polygonDifference(pathA, pathB)
    }
    return pathA
}

pub fn simplifyPolygon(polygon, tolerance) {
    if len(polygon) < 3 {
        return polygon
    }
    
    let simplified = []
    simplified = push(simplified, polygon[0])
    
    let i = 1
    while i < len(polygon) - 1 {
        let prev = polygon[i - 1]
        let curr = polygon[i]
        let next = polygon[i + 1]
        
        let area = abs((prev["x"] * (curr["y"] - next["y"]) + 
                        curr["x"] * (next["y"] - prev["y"]) + 
                        next["x"] * (prev["y"] - curr["y"])) / 2.0)
        
        if area > tolerance {
            simplified = push(simplified, curr)
        }
        
        i = i + 1
    }
    
    simplified = push(simplified, polygon[len(polygon) - 1])
    
    return simplified
}

pub fn getPathBBox(path) {
    let minX = 1e10
    let minY = 1e10
    let maxX = -1e10
    let maxY = -1e10
    
    let i = 0
    while i < len(path["segments"]) {
        let seg = path["segments"][i]
        let x = seg["x"]
        let y = seg["y"]
        
        if x < minX { minX = x }
        if y < minY { minY = y }
        if x > maxX { maxX = x }
        if y > maxY { maxY = y }
        
        i = i + 1
    }
    
    return createBBox(minX, minY, maxX, maxY)
}

fn polygonUnion(pathA, pathB) {
    let polyA = pathToPolygon(pathA)
    let polyB = pathToPolygon(pathB)
    
    let result = weilerAtherton(polyA, polyB, "union")
    
    return polygonToPath(result)
}

fn polygonIntersection(pathA, pathB) {
    let polyA = pathToPolygon(pathA)
    let polyB = pathToPolygon(pathB)
    
    let result = weilerAtherton(polyA, polyB, "intersection")
    
    return polygonToPath(result)
}

fn polygonDifference(pathA, pathB) {
    let polyA = pathToPolygon(pathA)
    let polyB = pathToPolygon(pathB)
    
    let result = weilerAtherton(polyA, polyB, "difference")
    
    return polygonToPath(result)
}

fn weilerAtherton(polyA, polyB, operation) {
    let intersections = findIntersections(polyA, polyB)
    
    let labeledA = labelVertices(polyA, intersections, "A")
    let labeledB = labelVertices(polyB, intersections, "B")
    
    let result = []
    
    if operation == "union" {
        result = walkUnion(labeledA, labeledB, intersections)
    } else if operation == "intersection" {
        result = walkIntersection(labeledA, labeledB, intersections)
    } else if operation == "difference" {
        result = walkDifference(labeledA, labeledB, intersections)
    }
    
    return result
}

fn findIntersections(polyA, polyB) {
    let intersections = []
    let bboxA = getPolygonBBox(polyA)
    let bboxB = getPolygonBBox(polyB)
    
    let i = 0
    while i < len(polyA) {
        let segA = getSegment(polyA, i)
        let segBBoxA = getSegmentBBox(segA)
        
        if bboxIntersectsBBox(segBBoxA, bboxB) == false {
            i = i + 1
            continue
        }
        
        let j = 0
        while j < len(polyB) {
            let segB = getSegment(polyB, j)
            let segBBoxB = getSegmentBBox(segB)
            
            if bboxIntersectsBBox(segBBoxA, segBBoxB) == false {
                j = j + 1
                continue
            }
            
            let intersection = segmentIntersection(segA, segB)
            if intersection != null {
                intersections = push(intersections, {
                    "point": intersection,
                    "indexA": i,
                    "indexB": j,
                    "tA": 0.0,
                    "tB": 0.0
                })
            }
            j = j + 1
        }
        i = i + 1
    }
    
    return intersections
}

fn getPolygonBBox(polygon) {
    if len(polygon) == 0 {
        return createBBox(0.0, 0.0, 0.0, 0.0)
    }
    
    let minX = polygon[0]["x"]
    let minY = polygon[0]["y"]
    let maxX = polygon[0]["x"]
    let maxY = polygon[0]["y"]
    
    let i = 1
    while i < len(polygon) {
        let p = polygon[i]
        if p["x"] < minX { minX = p["x"] }
        if p["y"] < minY { minY = p["y"] }
        if p["x"] > maxX { maxX = p["x"] }
        if p["y"] > maxY { maxY = p["y"] }
        i = i + 1
    }
    
    return createBBox(minX, minY, maxX, maxY)
}

fn getSegmentBBox(seg) {
    let minX = min(seg["p1"]["x"], seg["p2"]["x"])
    let minY = min(seg["p1"]["y"], seg["p2"]["y"])
    let maxX = max(seg["p1"]["x"], seg["p2"]["x"])
    let maxY = max(seg["p1"]["y"], seg["p2"]["y"])
    return createBBox(minX, minY, maxX, maxY)
}

fn segmentIntersection(segA, segB) {
    let p1 = segA["p1"]
    let p2 = segA["p2"]
    let p3 = segB["p1"]
    let p4 = segB["p2"]
    
    let denom = (p4["y"] - p3["y"]) * (p2["x"] - p1["x"]) - (p4["x"] - p3["x"]) * (p2["y"] - p1["y"])
    
    if denom == 0.0 {
        return null
    }
    
    let ua = ((p4["x"] - p3["x"]) * (p1["y"] - p3["y"]) - (p4["y"] - p3["y"]) * (p1["x"] - p3["x"])) / denom
    let ub = ((p2["x"] - p1["x"]) * (p1["y"] - p3["y"]) - (p2["y"] - p1["y"]) * (p1["x"] - p3["x"])) / denom
    
    if ua >= 0.0 && ua <= 1.0 && ub >= 0.0 && ub <= 1.0 {
        return vec2(
            p1["x"] + ua * (p2["x"] - p1["x"]),
            p1["y"] + ua * (p2["y"] - p1["y"])
        )
    }
    
    return null
}

fn getSegment(poly, index) {
    let p1 = poly[index]
    let nextIndex = (index + 1) % len(poly)
    let p2 = poly[nextIndex]
    return { "p1": p1, "p2": p2 }
}

fn labelVertices(poly, intersections, label) {
    let labeled = []
    
    let i = 0
    while i < len(poly) {
        labeled = push(labeled, {
            "point": poly[i],
            "label": label,
            "entry": null
        })
        i = i + 1
    }
    
    let j = 0
    while j < len(intersections) {
        let intersection = intersections[j]
        let index = intersection["index" + label]
        let point = intersection["point"]
        
        let newVertex = {
            "point": point,
            "label": "intersection",
            "entry": null
        }
        
        let insertPos = index + 1
        let before = labeled[0:insertPos]
        let after = labeled[insertPos:]
        
        labeled = before
        labeled = push(labeled, newVertex)
        let k = 0
        while k < len(after) {
            labeled = push(labeled, after[k])
            k = k + 1
        }
        j = j + 1
    }
    
    return labeled
}

fn walkUnion(polyA, polyB, intersections) {
    let result = []
    let visited = {}
    
    let i = 0
    while i < len(polyA) {
        let vertex = polyA[i]
        if vertex["label"] == "intersection" && visited[vertex] == null {
            let path = walkPolygon(polyA, polyB, vertex, true)
            if len(path) > 0 {
                let k = 0
                while k < len(path) {
                    result = push(result, path[k])
                    visited[path[k]] = true
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
    
    let j = 0
    while j < len(polyB) {
        let vertex = polyB[j]
        if vertex["label"] == "intersection" && visited[vertex] == null {
            let path = walkPolygon(polyB, polyA, vertex, true)
            if len(path) > 0 {
                let k = 0
                while k < len(path) {
                    result = push(result, path[k])
                    visited[path[k]] = true
                    k = k + 1
                }
            }
        }
        j = j + 1
    }
    
    return result
}

fn walkIntersection(polyA, polyB, intersections) {
    let result = []
    let visited = {}
    
    let i = 0
    while i < len(polyA) {
        let vertex = polyA[i]
        if vertex["label"] == "intersection" && visited[vertex] == null {
            let path = walkPolygon(polyA, polyB, vertex, false)
            if len(path) > 0 {
                let k = 0
                while k < len(path) {
                    result = push(result, path[k])
                    visited[path[k]] = true
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
    
    return result
}

fn walkDifference(polyA, polyB, intersections) {
    let result = []
    let visited = {}
    
    let i = 0
    while i < len(polyA) {
        let vertex = polyA[i]
        if vertex["label"] == "A" && visited[vertex] == null {
            let path = walkPolygon(polyA, polyB, vertex, true)
            if len(path) > 0 {
                let k = 0
                while k < len(path) {
                    result = push(result, path[k])
                    visited[path[k]] = true
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
    
    return result
}

fn walkPolygon(polyA, polyB, startVertex, isEntry) {
    let path = []
    let current = startVertex
    let currentPoly = polyA
    let otherPoly = polyB
    
    let maxSteps = len(polyA) + len(polyB) + 100
    let steps = 0
    
    while steps < maxSteps {
        path = push(path, current["point"])
        
        if current["label"] == "intersection" {
            currentPoly = otherPoly
            otherPoly = polyA
            isEntry = !isEntry
        }
        
        let nextIndex = findNextVertex(currentPoly, current)
        if nextIndex == -1 {
            break
        }
        
        current = currentPoly[nextIndex]
        
        if current == startVertex {
            break
        }
        
        steps = steps + 1
    }
    
    return path
}

fn findNextVertex(poly, vertex) {
    let i = 0
    while i < len(poly) {
        if poly[i] == vertex {
            return (i + 1) % len(poly)
        }
        i = i + 1
    }
    return -1
}

fn pathToPolygon(path) {
    let polygon = []
    
    let i = 0
    while i < len(path["segments"]) {
        let seg = path["segments"][i]
        if seg["kind"] == "MoveTo" || seg["kind"] == "LineTo" || 
           seg["kind"] == "CubicBezierTo" || seg["kind"] == "QuadraticBezierTo" {
            polygon = push(polygon, vec2(seg["x"], seg["y"]))
        }
        i = i + 1
    }
    
    return polygon
}

fn polygonToPath(polygon) {
    let path = createPath()
    
    if len(polygon) == 0 {
        return path
    }
    
    path = moveTo(path, polygon[0]["x"], polygon[0]["y"])
    
    let i = 1
    while i < len(polygon) {
        path = lineTo(path, polygon[i]["x"], polygon[i]["y"])
        i = i + 1
    }
    
    path = closePath(path)
    
    return path
}
