@version "1.0.0"

// CAD Snapping - Professional snapping, guides, and grid system
// Features: grid snapping, smart guides, object snapping, guide lines
// Canonical path: import "cad/snapping"
// Target: Snapping system comparable to Figma/Photoshop/Sketch

import "cad/geom"
import "cad/document"
import "cad/host"

pub fn createSnapSystem() {
    return {
        "kind": "SnapSystem",
        "gridEnabled": true,
        "gridSize": 10.0,
        "gridMajor": 100.0,
        "smartGuidesEnabled": true,
        "objectSnappingEnabled": true,
        "endpointSnappingEnabled": true,
        "midpointSnappingEnabled": true,
        "centerSnappingEnabled": true,
        "orthoSnappingEnabled": true,
        "guides": []
    }
}

pub fn setGridSize(snapSystem, size) {
    snapSystem["gridSize"] = size
    return snapSystem
}

pub fn setGridMajor(snapSystem, major) {
    snapSystem["gridMajor"] = major
    return snapSystem
}

pub fn enableGrid(snapSystem, enabled) {
    snapSystem["gridEnabled"] = enabled
    return snapSystem
}

pub fn enableSmartGuides(snapSystem, enabled) {
    snapSystem["smartGuidesEnabled"] = enabled
    return snapSystem
}

pub fn enableObjectSnapping(snapSystem, enabled) {
    snapSystem["objectSnappingEnabled"] = enabled
    return snapSystem
}

pub fn enableEndpointSnapping(snapSystem, enabled) {
    snapSystem["endpointSnappingEnabled"] = enabled
    return snapSystem
}

pub fn enableMidpointSnapping(snapSystem, enabled) {
    snapSystem["midpointSnappingEnabled"] = enabled
    return snapSystem
}

pub fn enableCenterSnapping(snapSystem, enabled) {
    snapSystem["centerSnappingEnabled"] = enabled
    return snapSystem
}

pub fn enableOrthoSnapping(snapSystem, enabled) {
    snapSystem["orthoSnappingEnabled"] = enabled
    return snapSystem
}

pub fn snapToGrid(snapSystem, point) {
    if snapSystem["gridEnabled"] == false {
        return point
    }
    
    let size = snapSystem["gridSize"]
    let x = round(point["x"] / size) * size
    let y = round(point["y"] / size) * size
    
    return vec2(x, y)
}

pub fn snapToGridWithTolerance(snapSystem, point, tolerance) {
    if snapSystem["gridEnabled"] == false {
        return point
    }
    
    let size = snapSystem["gridSize"]
    let x = point["x"]
    let y = point["y"]
    
    let gridX = systemRound(x / size) * size
    let gridY = systemRound(y / size) * size
    
    if systemAbs(x - gridX) <= tolerance {
        x = gridX
    }
    if systemAbs(y - gridY) <= tolerance {
        y = gridY
    }
    
    return vec2(x, y)
}

pub fn findSmartGuides(snapSystem, document, point, tolerance) {
    if snapSystem["smartGuidesEnabled"] == false {
        return []
    }
    
    let guides = []
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null && node["visible"] == true && node["id"] != point["sourceId"] {
            guides = appendNodeGuides(guides, node, point, tolerance)
        }
    }
    
    return guides
}

fn appendNodeGuides(guides, node, point, tolerance) {
    let bounds = getNodeBounds(node)
    
    let centerX = (bounds["minX"] + bounds["maxX"]) / 2.0
    let centerY = (bounds["minY"] + bounds["maxY"]) / 2.0
    
    let px = point["x"]
    let py = point["y"]
    
    if systemAbs(px - bounds["minX"]) <= tolerance {
        guides = push(guides, {
            "kind": "vertical",
            "x": bounds["minX"],
            "label": "left"
        })
    }
    if systemAbs(px - bounds["maxX"]) <= tolerance {
        guides = push(guides, {
            "kind": "vertical",
            "x": bounds["maxX"],
            "label": "right"
        })
    }
    if systemAbs(px - centerX) <= tolerance {
        guides = push(guides, {
            "kind": "vertical",
            "x": centerX,
            "label": "center"
        })
    }
    if systemAbs(py - bounds["minY"]) <= tolerance {
        guides = push(guides, {
            "kind": "horizontal",
            "y": bounds["minY"],
            "label": "top"
        })
    }
    if systemAbs(py - bounds["maxY"]) <= tolerance {
        guides = push(guides, {
            "kind": "horizontal",
            "y": bounds["maxY"],
            "label": "bottom"
        })
    }
    if systemAbs(py - centerY) <= tolerance {
        guides = push(guides, {
            "kind": "horizontal",
            "y": centerY,
            "label": "center"
        })
    }
    
    return guides
}

pub fn snapToGuides(point, guides, tolerance) {
    let snapped = vec2(point["x"], point["y"])
    let snappedX = false
    let snappedY = false
    
    let i = 0
    while i < len(guides) {
        let guide = guides[i]
        if guide["kind"] == "vertical" && snappedX == false {
            if systemAbs(point["x"] - guide["x"]) <= tolerance {
                snapped["x"] = guide["x"]
                snappedX = true
            }
        } else if guide["kind"] == "horizontal" && snappedY == false {
            if systemAbs(point["y"] - guide["y"]) <= tolerance {
                snapped["y"] = guide["y"]
                snappedY = true
            }
        }
        i = i + 1
    }
    
    return snapped
}

pub fn addGuide(snapSystem, kind, value) {
    let guide = {
        "kind": kind,
        "value": value,
        "visible": true
    }
    snapSystem["guides"] = push(snapSystem["guides"], guide)
    return snapSystem
}

pub fn removeGuide(snapSystem, index) {
    let newGuides = []
    let i = 0
    while i < len(snapSystem["guides"]) {
        if i != index {
            newGuides = push(newGuides, snapSystem["guides"][i])
        }
        i = i + 1
    }
    snapSystem["guides"] = newGuides
    return snapSystem
}

pub fn clearGuides(snapSystem) {
    snapSystem["guides"] = []
    return snapSystem
}

pub fn snapToPoint(snapSystem, document, point, tolerance) {
    let result = vec2(point["x"], point["y"])
    
    if snapSystem["gridEnabled"] == true {
        result = snapToGridWithTolerance(snapSystem, result, tolerance)
    }
    
    if snapSystem["smartGuidesEnabled"] == true {
        let guides = findSmartGuides(snapSystem, document, result, tolerance)
        result = snapToGuides(result, guides, tolerance)
    }
    
    if snapSystem["objectSnappingEnabled"] == true {
        result = snapToObjects(document, result, tolerance, point["sourceId"])
    }
    
    if snapSystem["endpointSnappingEnabled"] == true {
        result = snapToEndpoints(document, result, tolerance, point["sourceId"])
    }
    
    if snapSystem["midpointSnappingEnabled"] == true {
        result = snapToMidpoints(document, result, tolerance, point["sourceId"])
    }
    
    if snapSystem["centerSnappingEnabled"] == true {
        result = snapToCenters(document, result, tolerance, point["sourceId"])
    }
    
    if snapSystem["orthoSnappingEnabled"] == true {
        result = snapToOrtho(result, tolerance)
    }
    
    return result
}

pub fn snapToObjects(document, point, tolerance, sourceId) {
    let snapped = vec2(point["x"], point["y"])
    let minDist = tolerance
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null && node["visible"] == true && node["id"] != sourceId {
            let bounds = getNodeBounds(node)
            
            let points = [
                vec2(bounds["minX"], bounds["minY"]),
                vec2(bounds["maxX"], bounds["minY"]),
                vec2(bounds["minX"], bounds["maxY"]),
                vec2(bounds["maxX"], bounds["maxY"]),
                vec2((bounds["minX"] + bounds["maxX"]) / 2.0, (bounds["minY"] + bounds["maxY"]) / 2.0)
            ]
            
            let i = 0
            while i < len(points) {
                let pt = points[i]
                let dist = vec2Distance(point, pt)
                if dist < minDist {
                    snapped = pt
                    minDist = dist
                }
                i = i + 1
            }
        }
    }
    
    return snapped
}

pub fn snapToEndpoints(document, point, tolerance, sourceId) {
    let snapped = vec2(point["x"], point["y"])
    let minDist = tolerance
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null && node["visible"] == true && node["id"] != sourceId {
            let endpoints = getNodeEndpoints(node)
            
            let i = 0
            while i < len(endpoints) {
                let pt = endpoints[i]
                let dist = vec2Distance(point, pt)
                if dist < minDist {
                    snapped = pt
                    minDist = dist
                }
                i = i + 1
            }
        }
    }
    
    return snapped
}

pub fn snapToMidpoints(document, point, tolerance, sourceId) {
    let snapped = vec2(point["x"], point["y"])
    let minDist = tolerance
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null && node["visible"] == true && node["id"] != sourceId {
            let midpoints = getNodeMidpoints(node)
            
            let i = 0
            while i < len(midpoints) {
                let pt = midpoints[i]
                let dist = vec2Distance(point, pt)
                if dist < minDist {
                    snapped = pt
                    minDist = dist
                }
                i = i + 1
            }
        }
    }
    
    return snapped
}

pub fn snapToCenters(document, point, tolerance, sourceId) {
    let snapped = vec2(point["x"], point["y"])
    let minDist = tolerance
    
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null && node["visible"] == true && node["id"] != sourceId {
            let bounds = getNodeBounds(node)
            let center = vec2(
                (bounds["minX"] + bounds["maxX"]) / 2.0,
                (bounds["minY"] + bounds["maxY"]) / 2.0
            )
            let dist = vec2Distance(point, center)
            if dist < minDist {
                snapped = center
                minDist = dist
            }
        }
    }
    
    return snapped
}

pub fn snapToOrtho(point, tolerance) {
    let snapped = vec2(point["x"], point["y"])
    
    if systemAbs(point["x"]) < tolerance {
        snapped["x"] = 0.0
    }
    if systemAbs(point["y"]) < tolerance {
        snapped["y"] = 0.0
    }
    
    return snapped
}

fn getNodeEndpoints(node) {
    let kind = node["kind"]
    let endpoints = []
    
    if kind == "Frame" || kind == "Group" || kind == "Component" {
        let bounds = getNodeBounds(node)
        endpoints = push(endpoints, vec2(bounds["minX"], bounds["minY"]))
        endpoints = push(endpoints, vec2(bounds["maxX"], bounds["minY"]))
        endpoints = push(endpoints, vec2(bounds["minX"], bounds["maxY"]))
        endpoints = push(endpoints, vec2(bounds["maxX"], bounds["maxY"]))
    } else if kind == "Vector" || kind == "Shape" {
        let data = node["data"]
        if data != null && data["segments"] != null {
            let i = 0
            while i < len(data["segments"]) {
                let seg = data["segments"][i]
                if i == 0 {
                    endpoints = push(endpoints, vec2(seg["x"], seg["y"]))
                } else if i == len(data["segments"]) - 1 {
                    endpoints = push(endpoints, vec2(seg["x"], seg["y"]))
                }
                i = i + 1
            }
        }
    }
    
    return endpoints
}

fn getNodeMidpoints(node) {
    let kind = node["kind"]
    let midpoints = []
    
    if kind == "Frame" || kind == "Group" || kind == "Component" {
        let bounds = getNodeBounds(node)
        midpoints = push(midpoints, vec2(
            (bounds["minX"] + bounds["maxX"]) / 2.0,
            bounds["minY"]
        ))
        midpoints = push(midpoints, vec2(
            (bounds["minX"] + bounds["maxX"]) / 2.0,
            bounds["maxY"]
        ))
        midpoints = push(midpoints, vec2(
            bounds["minX"],
            (bounds["minY"] + bounds["maxY"]) / 2.0
        ))
        midpoints = push(midpoints, vec2(
            bounds["maxX"],
            (bounds["minY"] + bounds["maxY"]) / 2.0
        ))
    } else if kind == "Vector" || kind == "Shape" {
        let data = node["data"]
        if data != null && data["segments"] != null {
            let i = 0
            while i < len(data["segments"]) - 1 {
                let seg1 = data["segments"][i]
                let seg2 = data["segments"][i + 1]
                let midpoint = vec2(
                    (seg1["x"] + seg2["x"]) / 2.0,
                    (seg1["y"] + seg2["y"]) / 2.0
                )
                midpoints = push(midpoints, midpoint)
                i = i + 1
            }
        }
    }
    
    return midpoints
}

pub fn getGridLines(snapSystem, viewport) {
    let lines = []
    let size = snapSystem["gridSize"]
    let major = snapSystem["gridMajor"]
    
    let minX = viewport["minX"]
    let maxX = viewport["maxX"]
    let minY = viewport["minY"]
    let maxY = viewport["maxY"]
    
    let startX = systemFloor(minX / size) * size
    let startY = systemFloor(minY / size) * size
    
    let x = startX
    while x <= maxX {
        let isMajor = (systemAbs(x) % major) == 0
        lines = push(lines, {
            "kind": "vertical",
            "x": x,
            "isMajor": isMajor
        })
        x = x + size
    }
    
    let y = startY
    while y <= maxY {
        let isMajor = (systemAbs(y) % major) == 0
        lines = push(lines, {
            "kind": "horizontal",
            "y": y,
            "isMajor": isMajor
        })
        y = y + size
    }
    
    return lines
}

pub fn getGuideLines(snapSystem) {
    return snapSystem["guides"]
}
