@version "1.0.0"

// CAD Layers - Professional layer composition system
// Features: layer hierarchy, visibility, locking, blending, masking, z-order
// Canonical path: import "cad/layers"
// Target: Layer system comparable to Figma/Photoshop/Sketch

import "cad/document"

pub fn createLayer(name) {
    return {
        "kind": "Layer",
        "id": generateLayerId(),
        "name": name,
        "visible": true,
        "locked": false,
        "opacity": 1.0,
        "blendMode": "normal",
        "mask": null,
        "children": []
    }
}

pub fn createLayerSystem() {
    return {
        "kind": "LayerSystem",
        "root": createLayer("Root"),
        "layerCounter": 1
    }
}

pub fn addLayer(parentId, layer) {
    let parent = getLayerById(parentId)
    if parent == null {
        return layer
    }
    parent["children"] = push(parent["children"], layer)
    return layer
}

