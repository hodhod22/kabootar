@version "1.0.0"

// Electrical installation CAD pillar (MIT). Commercial kit: rasmebargh.
// Uses scene nodes for devices, graph for cables
// import "cad/power"

import "cad/document"
import "cad/graph"
import "cad/geom"

pub fn createInstall(name) {
    if name == null || name == undefined { name = "install" }
    return {
        "kind": "ElInstall",
        "name": name,
        "document": createDocument(name, "mm"),
        "circuitGraph": createGraph(),
        "deviceToNodeMap": {}
    }
}

pub fn powerAddCircuit(inst, id, amps) {
    if amps == null || amps == undefined { amps = 16.0 }
    let circuitNode = createSceneNode("circuit", id)
    circuitNode["meta"] = {
        "type": "circuit",
        "amps": amps,
        "volts": 230.0
    }
    inst["document"] = addNode(inst["document"], "root", circuitNode)
    return inst
}

pub fn powerAddDevice(inst, id, circuitId, watts, position) {
    if watts == null || watts == undefined { watts = 100.0 }
    if position == null || position == undefined {
        position = vec2(0.0, 0.0)
    }
    
    let deviceNode = createSceneNode("device", id)
    deviceNode["transform"]["position"] = position
    deviceNode["meta"] = {
        "type": "device",
        "circuitId": circuitId,
        "watts": watts
    }
    
    inst["document"] = addNode(inst["document"], "root", deviceNode)
    inst["deviceToNodeMap"][id] = deviceNode["id"]
    
    return inst
}

pub fn powerAddCable(inst, fromDeviceId, toDeviceId, cableType) {
    if cableType == null || cableType == undefined { cableType = "standard" }
    
    let fromNode = findDeviceNode(inst, fromDeviceId)
    let toNode = findDeviceNode(inst, toDeviceId)
    
    if fromNode == null {
        fromNode = createNode({ "deviceId": fromDeviceId })
        inst["circuitGraph"] = addNode(inst["circuitGraph"], fromNode)
    }
    
    if toNode == null {
        toNode = createNode({ "deviceId": toDeviceId })
        inst["circuitGraph"] = addNode(inst["circuitGraph"], toNode)
    }
    
    let edge = createEdge(fromNode["id"], toNode["id"], {
        "type": "cable",
        "cableType": cableType
    })
    
    inst["circuitGraph"] = addEdge(inst["circuitGraph"], edge)
    
    return inst
}

fn findDeviceNode(inst, deviceId) {
    for nodeId in inst["circuitGraph"]["nodes"] {
        let node = inst["circuitGraph"]["nodes"][nodeId]
        if node != null && node["data"]["deviceId"] == deviceId {
            return node
        }
    }
    return null
}

pub fn powerCircuitLoadWatts(inst, circuitId) {
    let sum = 0.0
    for nodeId in inst["document"]["nodes"] {
        let node = inst["document"]["nodes"][nodeId]
        if node != null && node["kind"] == "device" && node["meta"]["circuitId"] == circuitId {
            sum = sum + node["meta"]["watts"]
        }
    }
    return sum
}

pub fn powerEstimateCurrent(watts, volts) {
    if volts == null || volts == undefined || volts == 0.0 { volts = 230.0 }
    return watts / volts
}

pub fn powerCircuitOk(inst, circuitId) {
    let rating = 16.0
    for nodeId in inst["document"]["nodes"] {
        let node = inst["document"]["nodes"][nodeId]
        if node != null && node["kind"] == "circuit" && node["meta"]["type"] == "circuit" && node["name"] == circuitId {
            rating = node["meta"]["amps"]
        }
    }
    let amps = powerEstimateCurrent(powerCircuitLoadWatts(inst, circuitId), 230.0)
    return amps <= rating
}

pub fn powerGetDocument(inst) {
    return inst["document"]
}

pub fn powerGetGraph(inst) {
    return inst["circuitGraph"]
}

pub fn powerSerialize(inst) {
    return {
        "kind": "SerializedInstall",
        "name": inst["name"],
        "document": inst["document"],
        "graph": inst["circuitGraph"],
        "deviceToNodeMap": inst["deviceToNodeMap"]
    }
}

pub fn powerDeserialize(data) {
    let inst = createInstall(data["name"])
    inst["document"] = data["document"]
    inst["circuitGraph"] = data["graph"]
    inst["deviceToNodeMap"] = data["deviceToNodeMap"]
    return inst
}
