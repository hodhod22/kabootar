@version "1.0.0"

// CAD Arch - Architectural drawings using scene nodes + graph topology
// Features: building, rooms as scene nodes, walls as graph edges, area calculations
// Canonical path: import "cad/arch"
// Uses addNode + graph only (no separate entity model)
import "cad/document"
import "cad/graph"
import "cad/geom"

pub fn createBuilding(name) {
    if name == null || name == undefined { name = "building" }
    return {
        "kind": "Building",
        "name": name,
        "document": createDocument(name, "m"),
        "wallGraph": createGraph()
    }
}

pub fn archAddRoom(building, id, w, d, position) {
    if w == null || w == undefined { w = 4.0 }
    if d == null || d == undefined { d = 3.0 }
    if position == null || position == undefined {
        position = vec2(0.0, 0.0)
    }
    
    let roomNode = createSceneNode("room", id)
    roomNode["transform"]["position"] = position
    roomNode["meta"] = {
        "type": "room",
        "width": w,
        "depth": d
    }
    
    building["document"] = addNode(building["document"], "root", roomNode)
    return building
}

pub fn archAddWall(building, id, ax, ay, bx, by) {
    let wallNode = createSceneNode("wall", id)
    wallNode["meta"] = {
        "type": "wall",
        "ax": ax,
        "ay": ay,
        "bx": bx,
        "by": by
    }
    
    building["document"] = addNode(building["document"], "root", wallNode)
    
    let fromNode = createNode({ "position": vec2(ax, ay) })
    let toNode = createNode({ "position": vec2(bx, by) })
    
    building["wallGraph"] = addNode(building["wallGraph"], fromNode)
    building["wallGraph"] = addNode(building["wallGraph"], toNode)
    
    let edge = createEdge(fromNode["id"], toNode["id"], {
        "type": "wall",
        "id": id
    })
    
    building["wallGraph"] = addEdge(building["wallGraph"], edge)
    
    return building
}

pub fn archRemoveWall(building, id) {
    let nodeId = findNodeIdByMeta(building["document"], "id", id)
    if nodeId != null {
        building["document"] = removeNode(building["document"], nodeId)
    }
    
    let wallGraph = building["wallGraph"]
    for edgeId in wallGraph["edges"] {
        let edge = wallGraph["edges"][edgeId]
        if edge != null && edge["data"]["id"] == id {
            wallGraph = removeEdge(wallGraph, edgeId)
        }
    }
    building["wallGraph"] = wallGraph
    
    return building
}

pub fn archRemoveRoom(building, id) {
    let nodeId = findNodeIdByMeta(building["document"], "id", id)
    if nodeId != null {
        building["document"] = removeNode(building["document"], nodeId)
    }
    return building
}

fn findNodeIdByMeta(document, prop, value) {
    for nodeId in document["nodes"] {
        let node = document["nodes"][nodeId]
        if node != null && node["meta"] != null && node["meta"][prop] == value {
            return nodeId
        }
    }
    return null
}

pub fn archRoomArea(roomNode) {
    if roomNode["meta"] == null {
        return 0.0
    }
    return roomNode["meta"]["width"] * roomNode["meta"]["depth"]
}

pub fn archFloorArea(building) {
    let sum = 0.0
    for nodeId in building["document"]["nodes"] {
        let node = building["document"]["nodes"][nodeId]
        if node != null && node["kind"] == "room" {
            sum = sum + archRoomArea(node)
        }
    }
    return sum
}

pub fn archGetDocument(building) {
    return building["document"]
}

pub fn archGetGraph(building) {
    return building["wallGraph"]
}

pub fn archSerialize(building) {
    return {
        "kind": "SerializedBuilding",
        "name": building["name"],
        "document": building["document"],
        "graph": building["wallGraph"]
    }
}

pub fn archDeserialize(data) {
    let building = createBuilding(data["name"])
    building["document"] = data["document"]
    building["wallGraph"] = data["graph"]
    return building
}
