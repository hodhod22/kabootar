pub fn resetStatistics(bridge) {
    bridge["statistics"] = {
        "linesDrawn": 0,
        "circlesDrawn": 0,
        "rectsDrawn": 0,
        "textDrawn": 0,
        "arcsDrawn": 0,
        "polylinesDrawn": 0
    }
    return bridge
}

pub fn getStatistics(bridge) {
    return bridge["statistics"]
}

pub fn getTotalDrawCalls(bridge) {
    let stats = bridge["statistics"]
    return stats["linesDrawn"] + stats["circlesDrawn"] + stats["rectsDrawn"] + 
           stats["textDrawn"] + stats["arcsDrawn"] + stats["polylinesDrawn"]
}

pub fn createCanvasBackend(canvas) {
    return {
        "kind": "CanvasBackend",
        "canvas": canvas,
        "context": null
    }
}

pub fn createWebGLBackend(gl) {
    return {
        "kind": "WebGLBackend",
        "gl": gl,
        "shaders": {},
        "buffers": {}
    }
}

pub fn createSVGBackend() {
    return {
        "kind": "SVGBackend",
        "svg": "",
        "elements": []
    }
}

pub fn createNullBackend() {
    return {
        "kind": "NullBackend"
    }
}

pub fn flush(bridge) {
    let backend = bridge["backend"]
    
    if backend != null {
        backend = backendFlush(backend)
        bridge["backend"] = backend
    }
    
    return bridge
}

fn backendFlush(backend) {
    return backend
}

