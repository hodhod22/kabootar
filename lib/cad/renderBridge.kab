fn drawArc(bridge, command) {
    let backend = bridge["backend"]
    
    if backend != null {
        backend = backendDrawArc(backend, command)
        bridge["backend"] = backend
    }
    
    bridge["statistics"]["arcsDrawn"] = bridge["statistics"]["arcsDrawn"] + 1
    return bridge
