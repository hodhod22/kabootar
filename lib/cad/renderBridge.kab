@version "1.0.0"

// CAD Render Bridge - Logical draw commands → actual surface (game canvas / host)
// Features: Bridge between CAD draw list and rendering backend, statistics
// Canonical path: import "cad/renderBridge"

pub fn createRenderBridge() {
    return {
        "kind": "RenderBridge",
        "backend": null,
        "statistics": {
            "linesDrawn": 0,
            "circlesDrawn": 0,
            "rectsDrawn": 0,
            "textDrawn": 0,
            "arcsDrawn": 0,
            "polylinesDrawn": 0
        }
    }
}

pub fn setRenderBackend(bridge, backend) {
    bridge["backend"] = backend
    return bridge
}

pub fn getRenderBackend(bridge) {
    return bridge["backend"]
}

pub fn executeDrawList(bridge, drawList) {
    bridge = resetStatistics(bridge)
    
    let i = 0
    while i < len(drawList) {
        let command = drawList[i]
        bridge = executeDrawCommand(bridge, command)
        i = i + 1
    }
    
    return bridge
}

pub fn executeDrawCommand(bridge, command) {
    if command["kind"] == "DrawLine" {
        bridge = drawLine(bridge, command)
    } else if command["kind"] == "DrawPolyline" {
        bridge = drawPolyline(bridge, command)
    } else if command["kind"] == "DrawCircle" {
        bridge = drawCircle(bridge, command)
    } else if command["kind"] == "DrawRect" {
        bridge = drawRect(bridge, command)
    } else if command["kind"] == "DrawText" {
        bridge = drawText(bridge, command)
    } else if command["kind"] == "DrawArc" {
        bridge = drawArc(bridge, command)
    }
    
    return bridge
}

fn drawLine(bridge, command) {
    let backend = bridge["backend"]
    
    if backend != null {
        backend = backendDrawLine(backend, command)
        bridge["backend"] = backend
    }
    
    bridge["statistics"]["linesDrawn"] = bridge["statistics"]["linesDrawn"] + 1
    return bridge
}

fn drawPolyline(bridge, command) {
    let backend = bridge["backend"]
    
    if backend != null {
        backend = backendDrawPolyline(backend, command)
        bridge["backend"] = backend
    }
    
    bridge["statistics"]["polylinesDrawn"] = bridge["statistics"]["polylinesDrawn"] + 1
    return bridge
}

