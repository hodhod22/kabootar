fn backendDrawLine(backend, command) {
    return backend
}

fn backendDrawPolyline(backend, command) {
    return backend
}

fn backendDrawCircle(backend, command) {
    return backend
}

fn backendDrawRect(backend, command) {
    return backend
}

fn backendDrawText(backend, command) {
    return backend
}

fn backendDrawArc(backend, command) {
    return backend
}

