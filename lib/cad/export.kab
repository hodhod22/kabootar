@version "1.0.0"

// CAD Export - Professional export/import for SVG, PNG, PDF
// Features: SVG export, PNG export, PDF export, SVG import
// Canonical path: import "cad/export"
// Target: Export system comparable to Figma/Photoshop/Sketch

import "cad/document"
import "cad/render"
import "cad/vector"
import "cad/host"

pub fn createExportOptions() {
    return {
        "kind": "ExportOptions",
        "format": "svg",
        "scale": 1.0,
        "dpi": 72,
        "includeBackground": false,
        "backgroundColor": { "r": 1.0, "g": 1.0, "b": 1.0, "a": 1.0 },
        "selectionOnly": false
    }
}

pub fn exportDocument(document, options) {
    let format = options["format"]
    
    if format == "svg" {
        return exportSVG(document, options)
    } else if format == "png" {
        return exportPNG(document, options)
    } else if format == "pdf" {
        return exportPDF(document, options)
    } else if format == "dxf" {
        return exportDXF(document, options)
    }
    
    return ""
}

pub fn exportSVG(document, options) {
    let svg = "<svg xmlns=\"http://www.w3.org/2000/svg\""
    svg = svg + " width=\"" + (document["width"] * options["scale"]) + "\""
    svg = svg + " height=\"" + (document["height"] * options["scale"]) + "\""
    svg = svg + " viewBox=\"0 0 " + document["width"] + " " + document["height"] + "\">"
    
    if options["includeBackground"] == true {
        let bg = options["backgroundColor"]
        svg = svg + "<rect width=\"100%\" height=\"100%\" fill=\""
        svg = svg + rgbToHex(bg["r"], bg["g"], bg["b"]) + "\" opacity=\"" + bg["a"] + "\"/>"
    }
    
    let drawList = buildDrawList(document, null)
    
    let i = 0
    while i < len(drawList["items"]) {
        let item = drawList["items"][i]
        svg = svg + exportItemToSVG(item, options)
        i = i + 1
    }
    
    svg = svg + "</svg>"
    return svg
}

fn exportItemToSVG(item, options) {
    let kind = item["kind"]
    
    if kind == "DrawFrame" {
        return exportFrameToSVG(item, options)
    } else if kind == "DrawVector" {
        return exportVectorToSVG(item, options)
    } else if kind == "DrawShape" {
        return exportShapeToSVG(item, options)
    } else if kind == "DrawText" {
        return exportTextToSVG(item, options)
    }
    
    return ""
}

fn exportFrameToSVG(item, options) {
    let transform = item["transform"]
    let x = transform["position"]["x"]
    let y = transform["position"]["y"]
    let width = item["width"]
    let height = item["height"]
    
    let svg = "<rect x=\"" + x + "\" y=\"" + y + "\""
    svg = svg + " width=\"" + width + "\" height=\"" + height + "\""
    
    if item["fill"] != null {
        svg = svg + " fill=\"" + colorToHex(item["fill"]["color"]) + "\""
        svg = svg + " opacity=\"" + item["fill"]["opacity"] + "\""
    } else {
        svg = svg + " fill=\"none\""
    }
    
    if item["stroke"] != null {
        svg = svg + " stroke=\"" + colorToHex(item["stroke"]["color"]) + "\""
        svg = svg + " stroke-width=\"" + item["stroke"]["width"] + "\""
        svg = svg + " opacity=\"" + item["stroke"]["opacity"] + "\""
    }
    
    svg = svg + "/>"
    return svg
}

fn exportVectorToSVG(item, options) {
    let data = item["data"]
    let transform = item["transform"]
    
    let svg = "<path d=\""
    
    let i = 0
    while i < len(data["segments"]) {
        let seg = data["segments"][i]
        if seg["kind"] == "MoveTo" {
            svg = svg + " M " + seg["x"] + " " + seg["y"]
        } else if seg["kind"] == "LineTo" {
            svg = svg + " L " + seg["x"] + " " + seg["y"]
        } else if seg["kind"] == "CubicBezierTo" {
            svg = svg + " C " + seg["cp1x"] + " " + seg["cp1y"]
            svg = svg + " " + seg["cp2x"] + " " + seg["cp2y"]
            svg = svg + " " + seg["x"] + " " + seg["y"]
        } else if seg["kind"] == "QuadraticBezierTo" {
            svg = svg + " Q " + seg["cpx"] + " " + seg["cpy"]
            svg = svg + " " + seg["x"] + " " + seg["y"]
        }
        i = i + 1
    }
    
    if data["closed"] == true {
        svg = svg + " Z"
    }
    
    svg = svg + "\""
    
    if item["fill"] != null {
        svg = svg + " fill=\"" + colorToHex(item["fill"]["color"]) + "\""
        svg = svg + " opacity=\"" + item["fill"]["opacity"] + "\""
    } else {
        svg = svg + " fill=\"none\""
    }
    
    if item["stroke"] != null {
        svg = svg + " stroke=\"" + colorToHex(item["stroke"]["color"]) + "\""
        svg = svg + " stroke-width=\"" + item["stroke"]["width"] + "\""
        svg = svg + " opacity=\"" + item["stroke"]["opacity"] + "\""
    }
    
    svg = svg + "/>"
    return svg
}

fn exportShapeToSVG(item, options) {
    let shapeType = item["shapeType"]
    let transform = item["transform"]
    
    let svg = ""
    
    if shapeType == "rectangle" {
        svg = "<rect x=\"" + transform["position"]["x"] + "\""
        svg = svg + " y=\"" + transform["position"]["y"] + "\""
        svg = svg + " width=\"" + item["data"]["width"] + "\""
        svg = svg + " height=\"" + item["data"]["height"] + "\""
    } else if shapeType == "ellipse" {
        svg = "<ellipse cx=\"" + (transform["position"]["x"] + item["data"]["width"] / 2.0) + "\""
        svg = svg + " cy=\"" + (transform["position"]["y"] + item["data"]["height"] / 2.0) + "\""
        svg = svg + " rx=\"" + (item["data"]["width"] / 2.0) + "\""
        svg = svg + " ry=\"" + (item["data"]["height"] / 2.0) + "\""
    } else if shapeType == "circle" {
        svg = "<circle cx=\"" + transform["position"]["x"] + "\""
        svg = svg + " cy=\"" + transform["position"]["y"] + "\""
        svg = svg + " r=\"" + item["data"]["radius"] + "\""
    }
    
    if item["fill"] != null {
        svg = svg + " fill=\"" + colorToHex(item["fill"]["color"]) + "\""
        svg = svg + " opacity=\"" + item["fill"]["opacity"] + "\""
    } else {
        svg = svg + " fill=\"none\""
    }
    
    if item["stroke"] != null {
        svg = svg + " stroke=\"" + colorToHex(item["stroke"]["color"]) + "\""
        svg = svg + " stroke-width=\"" + item["stroke"]["width"] + "\""
        svg = svg + " opacity=\"" + item["stroke"]["opacity"] + "\""
    }
    
    svg = svg + "/>"
    return svg
}

fn exportTextToSVG(item, options) {
    let transform = item["transform"]
    let text = item["text"]
    let fontSize = item["fontSize"]
    
    let svg = "<text x=\"" + transform["position"]["x"] + "\""
    svg = svg + " y=\"" + transform["position"]["y"] + "\""
    svg = svg + " font-size=\"" + fontSize + "\""
    svg = svg + " font-family=\"" + item["font"] + "\""
    
    if item["fill"] != null {
        svg = svg + " fill=\"" + colorToHex(item["fill"]["color"]) + "\""
        svg = svg + " opacity=\"" + item["fill"]["opacity"] + "\""
    }
    
    svg = svg + ">" + text + "</text>"
    return svg
}

pub fn exportPNG(document, options) {
    let svg = exportSVG(document, options)
    return "PNG export requires external renderer. SVG data: " + svg
}

pub fn exportPDF(document, options) {
    let svg = exportSVG(document, options)
    return "PDF export requires external renderer. SVG data: " + svg
}

pub fn importSVG(svgString) {
    let document = createDocument("Imported SVG", "px")
    
    let path = parseSVGPath(svgString)
    if path != null {
        let node = createSceneNode("Vector", "Imported Path")
        node["data"] = path
        document = addNode(document, document["sceneRoot"]["id"], node)
    }
    
    return document
}

fn parseSVGPath(svgString) {
    let path = createPath()
    
    let i = 0
    while i < len(svgString) {
        let char = str_slice(svgString, i, i + 1)
        
        if char == "M" {
            let coords = parseCoords(svgString, i + 1)
            path = moveTo(path, coords["x"], coords["y"])
        } else if char == "L" {
            let coords = parseCoords(svgString, i + 1)
            path = lineTo(path, coords["x"], coords["y"])
        } else if char == "C" {
            let coords = parseCoords(svgString, i + 1)
            path = cubicBezierTo(path, coords["x1"], coords["y1"], coords["x2"], coords["y2"], coords["x"], coords["y"])
        } else if char == "Q" {
            let coords = parseCoords(svgString, i + 1)
            path = quadraticBezierTo(path, coords["cx"], coords["cy"], coords["x"], coords["y"])
        } else if char == "Z" {
            path = closePath(path)
        }
        
        i = i + 1
    }
    
    return path
}

fn parseCoords(svgString, startIndex) {
    let coords = { "x": 0.0, "y": 0.0 }
    let i = startIndex
    let buffer = ""
    let coordIndex = 0
    
    while i < len(svgString) {
        let char = str_slice(svgString, i, i + 1)
        
        if char == " " || char == "," || char == "M" || char == "L" || char == "C" || char == "Q" || char == "Z" {
            if len(buffer) > 0 {
                let value = parseFloat(buffer)
                if coordIndex == 0 {
                    coords["x"] = value
                } else if coordIndex == 1 {
                    coords["y"] = value
                } else if coordIndex == 2 {
                    coords["x1"] = value
                } else if coordIndex == 3 {
                    coords["y1"] = value
                } else if coordIndex == 4 {
                    coords["x2"] = value
                } else if coordIndex == 5 {
                    coords["y2"] = value
                }
                coordIndex = coordIndex + 1
                buffer = ""
            }
            if char == "M" || char == "L" || char == "C" || char == "Q" || char == "Z" {
                break
            }
        } else {
            buffer = buffer + char
        }
        
        i = i + 1
    }
    
    return coords
}

fn colorToHex(color) {
    let r = floor(color["r"] * 255.0)
    let g = floor(color["g"] * 255.0)
    let b = floor(color["b"] * 255.0)
    return rgbToHex(r, g, b)
}

fn rgbToHex(r, g, b) {
    let hex = "#"
    hex = hex + byteToHex(r)
    hex = hex + byteToHex(g)
    hex = hex + byteToHex(b)
    return hex
}

fn byteToHex(byte) {
    let hex = ""
    let chars = "0123456789ABCDEF"
    hex = hex + str_slice(chars, floor(byte / 16.0), floor(byte / 16.0) + 1)
    hex = hex + str_slice(chars, byte % 16, (byte % 16) + 1)
    return hex
}

fn parseFloat(str) {
    let value = 0.0
    let negative = false
    let i = 0
    
    if len(str) > 0 && str_slice(str, 0, 1) == "-" {
        negative = true
        i = 1
    }
    
    while i < len(str) {
        let char = str_slice(str, i, i + 1)
        let digit = charToDigit(char)
        if digit >= 0 {
            value = value * 10.0 + digit
        }
        i = i + 1
    }
    
    if negative == true {
        value = -value
    }
    
    return value
}

fn charToDigit(char) {
    if char == "0" { return 0 }
    if char == "1" { return 1 }
    if char == "2" { return 2 }
    if char == "3" { return 3 }
    if char == "4" { return 4 }
    if char == "5" { return 5 }
    if char == "6" { return 6 }
    if char == "7" { return 7 }
    if char == "8" { return 8 }
    if char == "9" { return 9 }
    return -1
}

// DXF Export for AutoCAD Parity
pub fn exportDXF(document, options) {
    let dxf = ""
    
    dxf = dxf + "0\nSECTION\n"
    dxf = dxf + "2\nHEADER\n"
    dxf = dxf + "9\n$ACADVER\n"
    dxf = dxf + "1\nAC1015\n"
    dxf = dxf + "9\n$INSBASE\n"
    dxf = dxf + "10\n0.0\n"
    dxf = dxf + "20\n0.0\n"
    dxf = dxf + "30\n0.0\n"
    dxf = dxf + "9\n$EXTMIN\n"
    dxf = dxf + "10\n0.0\n"
    dxf = dxf + "20\n0.0\n"
    dxf = dxf + "9\n$EXTMAX\n"
    dxf = dxf + "10\n" + document["width"] + "\n"
    dxf = dxf + "20\n" + document["height"] + "\n"
    dxf = dxf + "0\nENDSEC\n"
    
    dxf = dxf + "0\nSECTION\n"
    dxf = dxf + "2\nTABLES\n"
    dxf = dxf + "0\nTABLE\n"
    dxf = dxf + "2\nLAYER\n"
    dxf = dxf + "70\n1\n"
    dxf = dxf + "0\nLAYER\n"
    dxf = dxf + "2\n0\n"
    dxf = dxf + "70\n0\n"
    dxf = dxf + "62\n7\n"
    dxf = dxf + "6\nCONTINUOUS\n"
    dxf = dxf + "0\nENDTAB\n"
    dxf = dxf + "0\nENDSEC\n"
    
    dxf = dxf + "0\nSECTION\n"
    dxf = dxf + "2\nENTITIES\n"
    
    let drawList = buildDrawList(document, null)
    
    let i = 0
    while i < len(drawList["items"]) {
        let item = drawList["items"][i]
        dxf = dxf + exportItemToDXF(item, options)
        i = i + 1
    }
    
    dxf = dxf + "0\nENDSEC\n"
    dxf = dxf + "0\nEOF\n"
    
    return dxf
}

fn exportItemToDXF(item, options) {
    let kind = item["kind"]
    
    if kind == "DrawFrame" {
        return exportFrameToDXF(item, options)
    } else if kind == "DrawVector" {
        return exportVectorToDXF(item, options)
    } else if kind == "DrawShape" {
        return exportShapeToDXF(item, options)
    } else if kind == "DrawText" {
        return exportTextToDXF(item, options)
    }
    
    return ""
}

fn exportFrameToDXF(item, options) {
    let transform = item["transform"]
    let x = transform["position"]["x"]
    let y = transform["position"]["y"]
    let width = item["width"]
    let height = item["height"]
    
    let dxf = ""
    dxf = dxf + "0\nLWPOLYLINE\n"
    dxf = dxf + "8\n0\n"
    dxf = dxf + "90\n4\n"
    dxf = dxf + "70\n1\n"
    dxf = dxf + "10\n" + x + "\n"
    dxf = dxf + "20\n" + y + "\n"
    dxf = dxf + "10\n" + (x + width) + "\n"
    dxf = dxf + "20\n" + y + "\n"
    dxf = dxf + "10\n" + (x + width) + "\n"
    dxf = dxf + "20\n" + (y + height) + "\n"
    dxf = dxf + "10\n" + x + "\n"
    dxf = dxf + "20\n" + (y + height) + "\n"
    
    return dxf
}

fn exportVectorToDXF(item, options) {
    let data = item["data"]
    let transform = item["transform"]
    
    let dxf = ""
    
    if len(data["segments"]) == 0 {
        return dxf
    }
    
    let pointCount = 0
    let i = 0
    while i < len(data["segments"]) {
        if data["segments"][i]["kind"] == "MoveTo" || data["segments"][i]["kind"] == "LineTo" {
            pointCount = pointCount + 1
        }
        i = i + 1
    }
    
    dxf = dxf + "0\nLWPOLYLINE\n"
    dxf = dxf + "8\n0\n"
    dxf = dxf + "90\n" + pointCount + "\n"
    
    if data["closed"] == true {
        dxf = dxf + "70\n1\n"
    } else {
        dxf = dxf + "70\n0\n"
    }
    
    let j = 0
    while j < len(data["segments"]) {
        let seg = data["segments"][j]
        if seg["kind"] == "MoveTo" || seg["kind"] == "LineTo" {
            dxf = dxf + "10\n" + seg["x"] + "\n"
            dxf = dxf + "20\n" + seg["y"] + "\n"
        } else if seg["kind"] == "CubicBezierTo" || seg["kind"] == "QuadraticBezierTo" {
            let flattened = flattenBezierSegment(seg, 10)
            let k = 0
            while k < len(flattened) {
                dxf = dxf + "10\n" + flattened[k]["x"] + "\n"
                dxf = dxf + "20\n" + flattened[k]["y"] + "\n"
                k = k + 1
            }
        }
        j = j + 1
    }
    
    return dxf
}

fn exportShapeToDXF(item, options) {
    let shapeType = item["shapeType"]
    let transform = item["transform"]
    
    let dxf = ""
    
    if shapeType == "rectangle" {
        let x = transform["position"]["x"]
        let y = transform["position"]["y"]
        let width = item["data"]["width"]
        let height = item["data"]["height"]
        
        dxf = dxf + "0\nLWPOLYLINE\n"
        dxf = dxf + "8\n0\n"
        dxf = dxf + "90\n4\n"
        dxf = dxf + "70\n1\n"
        dxf = dxf + "10\n" + x + "\n"
        dxf = dxf + "20\n" + y + "\n"
        dxf = dxf + "10\n" + (x + width) + "\n"
        dxf = dxf + "20\n" + y + "\n"
        dxf = dxf + "10\n" + (x + width) + "\n"
        dxf = dxf + "20\n" + (y + height) + "\n"
        dxf = dxf + "10\n" + x + "\n"
        dxf = dxf + "20\n" + (y + height) + "\n"
    } else if shapeType == "circle" {
        let x = transform["position"]["x"]
        let y = transform["position"]["y"]
        let radius = item["data"]["radius"]
        
        dxf = dxf + "0\nCIRCLE\n"
        dxf = dxf + "8\n0\n"
        dxf = dxf + "10\n" + x + "\n"
        dxf = dxf + "20\n" + y + "\n"
        dxf = dxf + "40\n" + radius + "\n"
    } else if shapeType == "ellipse" {
        let x = transform["position"]["x"] + item["data"]["width"] / 2.0
        let y = transform["position"]["y"] + item["data"]["height"] / 2.0
        let rx = item["data"]["width"] / 2.0
        let ry = item["data"]["height"] / 2.0
        
        dxf = dxf + "0\nELLIPSE\n"
        dxf = dxf + "8\n0\n"
        dxf = dxf + "10\n" + x + "\n"
        dxf = dxf + "20\n" + y + "\n"
        dxf = dxf + "11\n" + (x + rx) + "\n"
        dxf = dxf + "21\n" + y + "\n"
        dxf = dxf + "40\n" + systemAbs(rx) + "\n"
    }
    
    return dxf
}

fn exportTextToDXF(item, options) {
    let transform = item["transform"]
    let text = item["text"]
    let fontSize = item["fontSize"]
    
    let dxf = ""
    dxf = dxf + "0\nTEXT\n"
    dxf = dxf + "8\n0\n"
    dxf = dxf + "10\n" + transform["position"]["x"] + "\n"
    dxf = dxf + "20\n" + transform["position"]["y"] + "\n"
    dxf = dxf + "40\n" + fontSize + "\n"
    dxf = dxf + "1\n" + text + "\n"
    
    return dxf
}

fn flattenBezierSegment(seg, steps) {
    let points = []
    let x0 = 0.0
    let y0 = 0.0
    let x1 = 0.0
    let y1 = 0.0
    let x2 = 0.0
    let y2 = 0.0
    let x3 = 0.0
    let y3 = 0.0
    
    if seg["kind"] == "CubicBezierTo" {
        x1 = seg["cp1x"]
        y1 = seg["cp1y"]
        x2 = seg["cp2x"]
        y2 = seg["cp2y"]
        x3 = seg["x"]
        y3 = seg["y"]
    } else if seg["kind"] == "QuadraticBezierTo" {
        x1 = seg["cpx"]
        y1 = seg["cpy"]
        x2 = seg["cpx"]
        y2 = seg["cpy"]
        x3 = seg["x"]
        y3 = seg["y"]
    }
    
    let t = 0.0
    let dt = 1.0 / steps
    while t <= 1.0 {
        let mt = 1.0 - t
        let mt2 = mt * mt
        let mt3 = mt2 * mt
        let t2 = t * t
        let t3 = t2 * t
        
        let bx = mt3 * x0 + 3.0 * mt2 * t * x1 + 3.0 * mt * t2 * x2 + t3 * x3
        let by = mt3 * y0 + 3.0 * mt2 * t * y1 + 3.0 * mt * t2 * y2 + t3 * y3
        
        if t > 0.0 {
            points = push(points, vec2(bx, by))
        }
        
        t = t + dt
    }
    
    return points
}
