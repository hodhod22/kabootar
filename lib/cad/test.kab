@version "1.0.0"

// CAD Test - Smoke tests for design, drafting, and schematic profiles
// Features: Frame+layout test, line+dim test, component+graph test, serialize round-trip
// Canonical path: import "cad/test"

import "cad/document"
import "cad/layout"
import "cad/style"
import "cad/graph"
import "cad/symbol"
import "cad/serialize"
import "cad/geom"
import "cad/circuit"
import "cad/arch"
import "cad/power"
import "cad/aero"

fn assert(condition, message) {
    if condition == false {
        print("ASSERTION FAILED: " + message)
    }
}

pub fn testDesignFrameLayout() {
    let document = createDocument("Design Test", "px")
    document = setDocumentProfile(document, "design")
    
    let frame = createFrameNode("Main Frame", 100.0, 100.0, 400.0, 300.0)
    frame["layout"] = createLayout()
    frame["layout"] = setLayoutDirection(frame["layout"], "vertical")
    frame["layout"] = setLayoutPadding(frame["layout"], 20.0, 20.0, 20.0, 20.0)
    frame["layout"] = setLayoutGap(frame["layout"], 10.0)
    
    document = addNode(document, document["sceneRoot"]["id"], frame)
    
    let child1 = createFrameNode("Child 1", 0.0, 0.0, 360.0, 50.0)
    document = addNode(document, frame["id"], child1)
    
    let child2 = createFrameNode("Child 2", 0.0, 0.0, 360.0, 50.0)
    document = addNode(document, frame["id"], child2)
    
    document = documentCommit(document)
    
    let nodeCount = getNodeCount(document)
    let frameNode = getNode(document, frame["id"])
    let layout = frameNode["layout"]
    let profile = document["profile"]
    let units = document["units"]
    let epsilon = document["epsilon"]
    
    assert(nodeCount == 3, "Expected nodeCount == 3, got " + nodeCount)
    assert(layout != null, "Expected layout != null")
    assert(profile == "design", "Expected profile == 'design', got " + profile)
    assert(units == "px", "Expected units == 'px', got " + units)
    assert(epsilon == 0.5, "Expected epsilon == 0.5, got " + epsilon)
    
    return {
        "test": "Design Frame Layout",
        "passed": true,
        "nodeCount": nodeCount,
        "frameLayout": layout,
        "profile": profile,
        "units": units,
        "epsilon": epsilon
    }
}

pub fn testDraftingLineDim() {
    let document = createDocument("Drafting Test", "mm")
    document = setDocumentProfile(document, "drafting")
    
    let lineNode = createSceneNode("Vector", "Line")
    lineNode["transform"]["position"] = vec2(0.0, 0.0)
    lineNode["meta"] = {
        "type": "line",
        "start": vec2(0.0, 0.0),
        "end": vec2(100.0, 50.0)
    }
    lineNode["styleSet"] = createStyleSet()
    lineNode["styleSet"] = addStrokeToStyleSet(lineNode["styleSet"], createStroke({ "r": 0.0, "g": 0.0, "b": 0.0, "a": 1.0 }, 1.0, "butt", "miter", []))
    
    let dimNode = createSceneNode("Dimension", "Dimension")
    dimNode["transform"]["position"] = vec2(0.0, 0.0)
    dimNode["meta"] = {
        "type": "dimension",
        "start": vec2(0.0, 0.0),
        "end": vec2(100.0, 50.0),
        "offset": 10.0
    }
    dimNode["styleSet"] = createStyleSet()
    dimNode["styleSet"] = addStrokeToStyleSet(dimNode["styleSet"], createStroke({ "r": 0.5, "g": 0.5, "b": 0.5, "a": 1.0 }, 0.5, "butt", "miter", []))
    
    document = addNode(document, document["sceneRoot"]["id"], lineNode)
    document = addNode(document, document["sceneRoot"]["id"], dimNode)
    
    document = selectNode(document, lineNode["id"])
    
    document = documentCommit(document)
    
    let nodeCount = getNodeCount(document)
    let profile = document["profile"]
    let units = document["units"]
    let epsilon = document["epsilon"]
    let selectedCount = getSelectedCount(document)
    
    assert(nodeCount == 2, "Expected nodeCount == 2, got " + nodeCount)
    assert(profile == "drafting", "Expected profile == 'drafting', got " + profile)
    assert(units == "mm", "Expected units == 'mm', got " + units)
    assert(epsilon == 0.01, "Expected epsilon == 0.01, got " + epsilon)
    assert(selectedCount == 1, "Expected selectedCount == 1, got " + selectedCount)
    
    return {
        "test": "Drafting Line Dimension",
        "passed": true,
        "nodeCount": nodeCount,
        "profile": profile,
        "units": units,
        "epsilon": epsilon,
        "selectedCount": selectedCount
    }
}

pub fn testSchematicComponentGraph() {
    let document = createDocument("Schematic Test", "mm")
    document = setDocumentProfile(document, "schematic")
    
    let component = createSceneNode("Component", "R1")
    component["transform"]["position"] = vec2(50.0, 50.0)
    component["meta"] = {
        "type": "resistor",
        "symbolId": "Resistor",
        "value": 1000.0
    }
    
    document = addNode(document, document["sceneRoot"]["id"], component)
    
    let graph = createGraph()
    graph = addNode(graph, createNode({ "kind": "Port", "position": vec2(50.0, 50.0) }))
    graph = addNode(graph, createNode({ "kind": "Port", "position": vec2(100.0, 50.0) }))
    graph = addEdge(graph, createEdge(graph["nodes"][0]["id"], graph["nodes"][1]["id"], { "kind": "Wire" }))
    
    document = documentCommit(document)
    
    let nodeCount = getNodeCount(document)
    let graphNodeCount = graph["nodeCounter"]
    let graphEdgeCount = graph["edgeCounter"]
    let profile = document["profile"]
    let units = document["units"]
    let epsilon = document["epsilon"]
    
    assert(nodeCount == 1, "Expected nodeCount == 1, got " + nodeCount)
    assert(graphNodeCount == 2, "Expected graphNodeCount == 2, got " + graphNodeCount)
    assert(graphEdgeCount == 1, "Expected graphEdgeCount == 1, got " + graphEdgeCount)
    assert(profile == "schematic", "Expected profile == 'schematic', got " + profile)
    assert(units == "mm", "Expected units == 'mm', got " + units)
    assert(epsilon == 0.01, "Expected epsilon == 0.01, got " + epsilon)
    
    return {
        "test": "Schematic Component Graph",
        "passed": true,
        "nodeCount": nodeCount,
        "graphNodeCount": graphNodeCount,
        "graphEdgeCount": graphEdgeCount,
        "profile": profile,
        "units": units,
        "epsilon": epsilon
    }
}

pub fn testSerializeRoundTrip() {
    let document = createDocument("Serialize Test", "mm")
    document = setDocumentProfile(document, "drafting")
    
    let frame = createFrameNode("Test Frame", 0.0, 0.0, 100.0, 100.0)
    frame["transform"]["position"]["x"] = 50.0
    frame["transform"]["position"]["y"] = 50.0
    frame["transform"]["rotation"] = 0.5
    frame["transform"]["scale"]["x"] = 1.5
    frame["transform"]["scale"]["y"] = 1.5
    frame["styleSet"] = createStyleSet()
    frame["styleSet"] = addFillToStyleSet(frame["styleSet"], createFill({ "r": 1.0, "g": 0.0, "b": 0.0, "a": 1.0 }, 1.0))
    frame["meta"] = { "customField": "testValue" }
    
    document = addNode(document, document["sceneRoot"]["id"], frame)
    
    let child = createFrameNode("Child Frame", 0.0, 0.0, 50.0, 50.0)
    child["transform"]["position"]["x"] = 10.0
    child["transform"]["position"]["y"] = 10.0
    document = addNode(document, frame["id"], child)
    
    let originalNodeCount = getNodeCount(document)
    let originalProfile = document["profile"]
    let originalFrameId = frame["id"]
    let originalChildId = child["id"]
    let originalFrameParent = frame["parentId"]
    let originalChildParent = child["parentId"]
    let originalFramePos = frame["transform"]["position"]["x"]
    let originalChildPos = child["transform"]["position"]["x"]
    let originalMeta = frame["meta"]["customField"]
    
    let serialized = serializeDocument(document)
    
    let deserialized = deserializeDocument(serialized)
    
    let deserializedNodeCount = getNodeCount(deserialized)
    let deserializedProfile = deserialized["profile"]
    let deserializedFrame = getNode(deserialized, originalFrameId)
    let deserializedChild = getNode(deserialized, originalChildId)
    
    assert(originalNodeCount == deserializedNodeCount, "Expected originalNodeCount == deserializedNodeCount, got " + originalNodeCount + " vs " + deserializedNodeCount)
    assert(originalProfile == deserializedProfile, "Expected originalProfile == deserializedProfile, got " + originalProfile + " vs " + deserializedProfile)
    assert(deserializedFrame != null, "Expected deserializedFrame != null")
    assert(deserializedChild != null, "Expected deserializedChild != null")
    assert(deserializedFrame["parentId"] == originalFrameParent, "Expected frame parentId match, got " + deserializedFrame["parentId"] + " vs " + originalFrameParent)
    assert(deserializedChild["parentId"] == originalChildParent, "Expected child parentId match, got " + deserializedChild["parentId"] + " vs " + originalChildParent)
    assert(deserializedFrame["transform"]["position"]["x"] == originalFramePos, "Expected frame position match, got " + deserializedFrame["transform"]["position"]["x"] + " vs " + originalFramePos)
    assert(deserializedChild["transform"]["position"]["x"] == originalChildPos, "Expected child position match, got " + deserializedChild["transform"]["position"]["x"] + " vs " + originalChildPos)
    assert(deserializedFrame["meta"]["customField"] == originalMeta, "Expected meta field match, got " + deserializedFrame["meta"]["customField"] + " vs " + originalMeta)
    
    return {
        "test": "Serialize Round Trip",
        "passed": true,
        "originalNodeCount": originalNodeCount,
        "deserializedNodeCount": deserializedNodeCount,
        "originalProfile": originalProfile,
        "deserializedProfile": deserializedProfile
    }
}

pub fn runAllSmokeTests() {
    let results = []
    
    results = push(results, testDesignFrameLayout())
    results = push(results, testDraftingLineDim())
    results = push(results, testSchematicComponentGraph())
    results = push(results, testSerializeRoundTrip())
    results = push(results, testCircuitSerializeRoundTrip())
    results = push(results, testArchSerializeRoundTrip())
    results = push(results, testPowerSerializeRoundTrip())
    results = push(results, testAeroSerializeRoundTrip())
    
    let passedCount = 0
    let i = 0
    while i < len(results) {
        if results[i]["passed"] == true {
            passedCount = passedCount + 1
        }
        i = i + 1
    }
    
    return {
        "totalTests": len(results),
        "passed": passedCount,
        "failed": len(results) - passedCount,
        "results": results
    }
}

pub fn testCircuitSerializeRoundTrip() {
    let board = createBoard("Test Board")
    board = circuitAddPart(board, "R1", "R", 1000.0, vec2(10.0, 10.0))
    board = circuitAddPart(board, "R2", "R", 2000.0, vec2(30.0, 10.0))
    board = circuitAddNet(board, "net1", "R1", "R2")
    
    let originalPartCount = len(board["document"]["nodes"])
    let originalGraphEdgeCount = board["netGraph"]["edgeCounter"]
    let originalBoardName = board["name"]
    
    let serialized = circuitSerialize(board)
    let deserialized = circuitDeserialize(serialized)
    
    let deserializedPartCount = len(deserialized["document"]["nodes"])
    let deserializedGraphEdgeCount = deserialized["netGraph"]["edgeCounter"]
    let deserializedBoardName = deserialized["name"]
    
    assert(originalPartCount == deserializedPartCount, "Expected originalPartCount == deserializedPartCount, got " + originalPartCount + " vs " + deserializedPartCount)
    assert(originalGraphEdgeCount == deserializedGraphEdgeCount, "Expected originalGraphEdgeCount == deserializedGraphEdgeCount, got " + originalGraphEdgeCount + " vs " + deserializedGraphEdgeCount)
    assert(originalBoardName == deserializedBoardName, "Expected board name match, got " + originalBoardName + " vs " + deserializedBoardName)
    
    let i = 0
    while i < len(board["document"]["nodes"]) {
        let nodeId = board["document"]["nodes"][i]["id"]
        let originalNode = board["document"]["nodes"][nodeId]
        let deserializedNode = deserialized["document"]["nodes"][nodeId]
        assert(deserializedNode != null, "Expected node " + nodeId + " to exist after deserialization")
        if originalNode["meta"] != null {
            assert(deserializedNode["meta"] != null, "Expected meta to exist for node " + nodeId)
        }
        i = i + 1
    }
    
    return {
        "test": "Circuit Serialize Round Trip",
        "passed": true,
        "originalPartCount": originalPartCount,
        "deserializedPartCount": deserializedPartCount,
        "originalGraphEdgeCount": originalGraphEdgeCount,
        "deserializedGraphEdgeCount": deserializedGraphEdgeCount
    }
}

pub fn testArchSerializeRoundTrip() {
    let building = createBuilding("Test Building")
    building = archAddRoom(building, "room1", 4.0, 3.0, vec2(0.0, 0.0))
    building = archAddRoom(building, "room2", 5.0, 4.0, vec2(5.0, 0.0))
    building = archAddWall(building, "wall1", 0.0, 0.0, 5.0, 0.0)
    
    let originalRoomCount = 0
    for nodeId in building["document"]["nodes"] {
        let node = building["document"]["nodes"][nodeId]
        if node != null && node["kind"] == "room" {
            originalRoomCount = originalRoomCount + 1
        }
    }
    let originalGraphEdgeCount = building["wallGraph"]["edgeCounter"]
    let originalBuildingName = building["name"]
    
    let serialized = archSerialize(building)
    let deserialized = archDeserialize(serialized)
    
    let deserializedRoomCount = 0
    for nodeId in deserialized["document"]["nodes"] {
        let node = deserialized["document"]["nodes"][nodeId]
        if node != null && node["kind"] == "room" {
            deserializedRoomCount = deserializedRoomCount + 1
        }
    }
    let deserializedGraphEdgeCount = deserialized["wallGraph"]["edgeCounter"]
    let deserializedBuildingName = deserialized["name"]
    
    assert(originalRoomCount == deserializedRoomCount, "Expected originalRoomCount == deserializedRoomCount, got " + originalRoomCount + " vs " + deserializedRoomCount)
    assert(originalGraphEdgeCount == deserializedGraphEdgeCount, "Expected originalGraphEdgeCount == deserializedGraphEdgeCount, got " + originalGraphEdgeCount + " vs " + deserializedGraphEdgeCount)
    assert(originalBuildingName == deserializedBuildingName, "Expected building name match, got " + originalBuildingName + " vs " + deserializedBuildingName)
    
    let i = 0
    while i < len(building["document"]["nodes"]) {
        let nodeId = building["document"]["nodes"][i]["id"]
        let originalNode = building["document"]["nodes"][nodeId]
        let deserializedNode = deserialized["document"]["nodes"][nodeId]
        assert(deserializedNode != null, "Expected node " + nodeId + " to exist after deserialization")
        if originalNode["meta"] != null {
            assert(deserializedNode["meta"] != null, "Expected meta to exist for node " + nodeId)
        }
        i = i + 1
    }
    
    return {
        "test": "Arch Serialize Round Trip",
        "passed": true,
        "originalRoomCount": originalRoomCount,
        "deserializedRoomCount": deserializedRoomCount,
        "originalGraphEdgeCount": originalGraphEdgeCount,
        "deserializedGraphEdgeCount": deserializedGraphEdgeCount
    }
}

pub fn testPowerSerializeRoundTrip() {
    let install = createInstall("Test Install")
    install = powerAddCircuit(install, "circuit1", 16.0)
    install = powerAddDevice(install, "device1", "circuit1", 100.0, vec2(10.0, 10.0))
    install = powerAddDevice(install, "device2", "circuit1", 200.0, vec2(30.0, 10.0))
    
    let originalDeviceCount = 0
    for nodeId in install["document"]["nodes"] {
        let node = install["document"]["nodes"][nodeId]
        if node != null && node["kind"] == "device" {
            originalDeviceCount = originalDeviceCount + 1
        }
    }
    let originalInstallName = install["name"]
    
    let serialized = powerSerialize(install)
    let deserialized = powerDeserialize(serialized)
    
    let deserializedDeviceCount = 0
    for nodeId in deserialized["document"]["nodes"] {
        let node = deserialized["document"]["nodes"][nodeId]
        if node != null && node["kind"] == "device" {
            deserializedDeviceCount = deserializedDeviceCount + 1
        }
    }
    let deserializedInstallName = deserialized["name"]
    
    assert(originalDeviceCount == deserializedDeviceCount, "Expected originalDeviceCount == deserializedDeviceCount, got " + originalDeviceCount + " vs " + deserializedDeviceCount)
    assert(originalInstallName == deserializedInstallName, "Expected install name match, got " + originalInstallName + " vs " + deserializedInstallName)
    
    let i = 0
    while i < len(install["document"]["nodes"]) {
        let nodeId = install["document"]["nodes"][i]["id"]
        let originalNode = install["document"]["nodes"][nodeId]
        let deserializedNode = deserialized["document"]["nodes"][nodeId]
        assert(deserializedNode != null, "Expected node " + nodeId + " to exist after deserialization")
        if originalNode["meta"] != null {
            assert(deserializedNode["meta"] != null, "Expected meta to exist for node " + nodeId)
        }
        i = i + 1
    }
    
    return {
        "test": "Power Serialize Round Trip",
        "passed": true,
        "originalDeviceCount": originalDeviceCount,
        "deserializedDeviceCount": deserializedDeviceCount
    }
}

pub fn testAeroSerializeRoundTrip() {
    let model = createAeroModel("Test Model")
    model = aeroAddAirfoil(model, "airfoil1", 1.0, 1.0, vec2(0.0, 0.0))
    model = aeroAddAirfoil(model, "airfoil2", 1.5, 1.5, vec2(2.0, 0.0))
    model = aeroSetFlow(model, 50.0, 5.0, 1.225)
    
    let originalAirfoilCount = 0
    for nodeId in model["document"]["nodes"] {
        let node = model["document"]["nodes"][nodeId]
        if node != null && node["kind"] == "airfoil" {
            originalAirfoilCount = originalAirfoilCount + 1
        }
    }
    let originalFlowV = model["flow"]["v"]
    let originalModelName = model["name"]
    
    let serialized = aeroSerialize(model)
    let deserialized = aeroDeserialize(serialized)
    
    let deserializedAirfoilCount = 0
    for nodeId in deserialized["document"]["nodes"] {
        let node = deserialized["document"]["nodes"][nodeId]
        if node != null && node["kind"] == "airfoil" {
            deserializedAirfoilCount = deserializedAirfoilCount + 1
        }
    }
    let deserializedFlowV = deserialized["flow"]["v"]
    let deserializedModelName = deserialized["name"]
    
    assert(originalAirfoilCount == deserializedAirfoilCount, "Expected originalAirfoilCount == deserializedAirfoilCount, got " + originalAirfoilCount + " vs " + deserializedAirfoilCount)
    assert(originalFlowV == deserializedFlowV, "Expected originalFlowV == deserializedFlowV, got " + originalFlowV + " vs " + deserializedFlowV)
    assert(originalModelName == deserializedModelName, "Expected model name match, got " + originalModelName + " vs " + deserializedModelName)
    
    let i = 0
    while i < len(model["document"]["nodes"]) {
        let nodeId = model["document"]["nodes"][i]["id"]
        let originalNode = model["document"]["nodes"][nodeId]
        let deserializedNode = deserialized["document"]["nodes"][nodeId]
        assert(deserializedNode != null, "Expected node " + nodeId + " to exist after deserialization")
        if originalNode["meta"] != null {
            assert(deserializedNode["meta"] != null, "Expected meta to exist for node " + nodeId)
        }
        i = i + 1
    }
    
    return {
        "test": "Aero Serialize Round Trip",
        "passed": true,
        "originalAirfoilCount": originalAirfoilCount,
        "deserializedAirfoilCount": deserializedAirfoilCount,
        "originalFlowV": originalFlowV,
        "deserializedFlowV": deserializedFlowV
    }
}
