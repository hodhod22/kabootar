@version "1.0.0"

// CAD Render - Draw list generation from scene for GPU rendering
// Features: build drawList from scene, culling, layer order, selection overlay, blend modes, effects
// Canonical path: import "cad/render"
// Target: GPU-accelerated rendering engine comparable to Figma/Photoshop

import "cad/geom"
import "cad/document"
import "cad/host"

pub fn createDrawList() {
    return {
        "kind": "DrawList",
        "items": [],
        "overlayItems": []
    }
}

pub fn createBlendMode(mode) {
    return {
        "kind": "BlendMode",
        "mode": mode
    }
}

pub fn createEffect(effectType, params) {
    return {
        "kind": "Effect",
        "type": effectType,
        "params": params
    }
}

pub fn createShadowEffect(offsetX, offsetY, blur, color, opacity) {
    return createEffect("shadow", {
        "offsetX": offsetX,
        "offsetY": offsetY,
        "blur": blur,
        "color": color,
        "opacity": opacity
    })
}

pub fn createBlurEffect(radius) {
    return createEffect("blur", {
        "radius": radius
    })
}

pub fn createGlowEffect(radius, color, opacity) {
    return createEffect("glow", {
        "radius": radius,
        "color": color,
        "opacity": opacity
    })
}

pub fn createInnerShadowEffect(offsetX, offsetY, blur, color, opacity) {
    return createEffect("inner-shadow", {
        "offsetX": offsetX,
        "offsetY": offsetY,
        "blur": blur,
        "color": color,
        "opacity": opacity
    })
}

pub fn createDropShadowEffect(offsetX, offsetY, blur, spread, color, opacity) {
    return createEffect("drop-shadow", {
        "offsetX": offsetX,
        "offsetY": offsetY,
        "blur": blur,
        "spread": spread,
        "color": color,
        "opacity": opacity
    })
}

pub fn createNoiseEffect(intensity) {
    return createEffect("noise", {
        "intensity": intensity
    })
}

pub fn createDistortionEffect(amount) {
    return createEffect("distortion", {
        "amount": amount
    })
}

pub fn createGradientStop(offset, color, opacity) {
    return {
        "offset": offset,
        "color": color,
        "opacity": opacity
    }
}

pub fn createLinearGradient(x1, y1, x2, y2, stops) {
    return {
        "kind": "LinearGradient",
        "x1": x1,
        "y1": y1,
        "x2": x2,
        "y2": y2,
        "stops": stops
    }
}

pub fn createRadialGradient(cx, cy, r, fx, fy, stops) {
    return {
        "kind": "RadialGradient",
        "cx": cx,
        "cy": cy,
        "r": r,
        "fx": fx,
        "fy": fy,
        "stops": stops
    }
}

pub fn createConicGradient(cx, cy, angle, stops) {
    return {
        "kind": "ConicGradient",
        "cx": cx,
        "cy": cy,
        "angle": angle,
        "stops": stops
    }
}

// Standard blend modes (compatible with GPU rendering)
pub fn blendModeNormal() {
    return "normal"
}

pub fn blendModeMultiply() {
    return "multiply"
}

pub fn blendModeScreen() {
    return "screen"
}

pub fn blendModeOverlay() {
    return "overlay"
}

pub fn blendModeDarken() {
    return "darken"
}

pub fn blendModeLighten() {
    return "lighten"
}

pub fn blendModeColorDodge() {
    return "color-dodge"
}

pub fn blendModeColorBurn() {
    return "color-burn"
}

pub fn blendModeHardLight() {
    return "hard-light"
}

pub fn blendModeSoftLight() {
    return "soft-light"
}

pub fn blendModeDifference() {
    return "difference"
}

pub fn blendModeExclusion() {
    return "exclusion"
}

pub fn blendModeHue() {
    return "hue"
}

pub fn blendModeSaturation() {
    return "saturation"
}

pub fn blendModeColor() {
    return "color"
}

pub fn blendModeLuminosity() {
    return "luminosity"
}

pub fn setNodeBlendMode(node, mode) {
    node["blendMode"] = mode
    return node
}

pub fn setNodeGradient(node, gradient) {
    if node["styleSet"] == null {
        node["styleSet"] = createStyleSet()
    }
    let fill = createFill(gradient, 1.0)
    node["styleSet"] = addFillToStyleSet(node["styleSet"], fill)
    return node
}

pub fn setNodeLinearGradient(node, x1, y1, x2, y2, stops) {
    let gradient = createLinearGradient(x1, y1, x2, y2, stops)
    return setNodeGradient(node, gradient)
}

pub fn setNodeRadialGradient(node, cx, cy, r, fx, fy, stops) {
    let gradient = createRadialGradient(cx, cy, r, fx, fy, stops)
    return setNodeGradient(node, gradient)
}

pub fn setNodeConicGradient(node, cx, cy, angle, stops) {
    let gradient = createConicGradient(cx, cy, angle, stops)
    return setNodeGradient(node, gradient)
}

pub fn addNodeEffect(node, effect) {
    if node["effects"] == null {
        node["effects"] = []
    }
    node["effects"] = push(node["effects"], effect)
    return node
}

pub fn clearNodeEffects(node) {
    node["effects"] = []
    return node
}

pub fn buildDrawList(document, viewport) {
    let drawList = createDrawList()
    
    let sceneRoot = document["sceneRoot"]
    drawList = buildNodeDrawList(document, sceneRoot, drawList, viewport)
    
    drawList = buildSelectionOverlay(document, drawList)
    
    return drawList
}

fn buildNodeDrawList(document, node, drawList, viewport) {
    if node == null || node["visible"] == false {
        return drawList
    }
    
    if isNodeInViewport(node, viewport) == false {
        return drawList
    }
    
    drawList = addNodeToDrawList(node, drawList)
    
    let i = 0
    while i < len(node["children"]) {
        let childId = node["children"][i]
        let child = document["nodes"][childId]
        if child != null {
            drawList = buildNodeDrawList(document, child, drawList, viewport)
        }
        i = i + 1
    }
    
    return drawList
}

fn addNodeToDrawList(node, drawList) {
    let kind = node["kind"]
    
    if kind == "Frame" {
        drawList = addFrameToDrawList(node, drawList)
    } else if kind == "Group" {
        drawList = addGroupToDrawList(node, drawList)
    } else if kind == "Component" {
        drawList = addComponentToDrawList(node, drawList)
    } else if kind == "Vector" {
        drawList = addVectorToDrawList(node, drawList)
    } else if kind == "Shape" {
        drawList = addShapeToDrawList(node, drawList)
    } else if kind == "Text" {
        drawList = addTextToDrawList(node, drawList)
    } else if kind == "Dimension" {
        drawList = addDimensionToDrawList(node, drawList)
    }
    
    return drawList
}

fn addFrameToDrawList(node, drawList) {
    let item = {
        "kind": "DrawFrame",
        "nodeId": node["id"],
        "transform": node["transform"],
        "width": node["width"],
        "height": node["height"],
        "styleSet": node["styleSet"],
        "layer": node["layer"],
        "opacity": node["opacity"],
        "blendMode": node["blendMode"],
        "effects": node["effects"],
        "fill": getFillFromStyleSet(node["styleSet"]),
        "stroke": getStrokeFromStyleSet(node["styleSet"])
    }
    drawList["items"] = push(drawList["items"], item)
    return drawList
}

fn addGroupToDrawList(node, drawList) {
    let item = {
        "kind": "DrawGroup",
        "nodeId": node["id"],
        "transform": node["transform"],
        "layer": node["layer"],
        "opacity": node["opacity"]
    }
    drawList["items"] = push(drawList["items"], item)
    return drawList
}

fn addComponentToDrawList(node, drawList) {
    let item = {
        "kind": "DrawComponent",
        "nodeId": node["id"],
        "definitionId": node["definitionId"],
        "transform": node["transform"],
        "overrides": node["overrides"],
        "styleSet": node["styleSet"],
        "layer": node["layer"],
        "opacity": node["opacity"]
    }
    drawList["items"] = push(drawList["items"], item)
    return drawList
}

fn addVectorToDrawList(node, drawList) {
    let item = {
        "kind": "DrawVector",
        "nodeId": node["id"],
        "transform": node["transform"],
        "data": node["data"],
        "styleSet": node["styleSet"],
        "layer": node["layer"],
        "opacity": node["opacity"],
