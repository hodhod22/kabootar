        "kind": "Fuselage",
        "name": name,
        "length": length,
        "radius": radius,
        "position": position
    }
    model["components"] = push(model["components"], fuselage)
    return model
}

pub fn exportToOpenVSP(model) {
    let export = {
        "format": "openvsp",
        "components": model["components"],
        "settings": model["settings"],
        "aeroModel": aeroSerialize(model["aeroModel"]),
