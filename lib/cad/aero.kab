@version "1.0.0"

// CAD Aero - Aerodynamic models using scene nodes + graph topology
// Features: aerodynamic model, airfoils as scene nodes, flow parameters, lift estimation
// MDAO Integration: amadevs, anvil, ceasiompy, rcaide support
// Canonical path: import "cad/aero"
// Uses addNode + graph only (no separate entity model)

import "cad/document"
import "cad/graph"
import "cad/geom"
import "cad/host"

pub fn createAeroModel(name) {
    if name == null || name == undefined { name = "aero" }
    return {
        "kind": "AeroModel",
        "name": name,
        "document": createDocument(name, "m"),
        "surfaceGraph": createGraph(),
        "surfaceToNodeMap": {},
        "flow": { "rho": 1.225, "v": 50.0, "alphaDeg": 0.0 }
    }
}

pub fn aeroAddAirfoil(model, id, chord, area, position) {
    if chord == null || chord == undefined { chord = 1.0 }
    if area == null || area == undefined { area = 1.0 }
    if position == null || position == undefined {
        position = vec2(0.0, 0.0)
    }
    
    let airfoilNode = createSceneNode("airfoil", id)
    airfoilNode["transform"]["position"] = position
    airfoilNode["meta"] = {
        "type": "airfoil",
        "chord": chord,
        "area": area,
        "cl0": 0.3,
        "cla": 0.1
    }
    
    model["document"] = addNode(model["document"], "root", airfoilNode)
    
    let surfaceNode = createNode({ "surfaceId": id })
    model["surfaceGraph"] = addNode(model["surfaceGraph"], surfaceNode)
    model["surfaceToNodeMap"][id] = surfaceNode["id"]
    
    return model
}

pub fn aeroSetFlow(model, v, alphaDeg, rho) {
    if v == null || v == undefined { v = 50.0 }
    if alphaDeg == null || alphaDeg == undefined { alphaDeg = 0.0 }
    if rho == null || rho == undefined { rho = 1.225 }
    model["flow"] = { "rho": rho, "v": v, "alphaDeg": alphaDeg }
    return model
}

pub fn aeroEstimateCl(airfoilNode, alphaDeg) {
    if alphaDeg == null || alphaDeg == undefined { alphaDeg = 0.0 }
    if airfoilNode["meta"] == null {
        return 0.0
    }
    return airfoilNode["meta"]["cl0"] + airfoilNode["meta"]["cla"] * alphaDeg
}

pub fn aeroEstimateLift(model, airfoilId) {
    let nodeId = model["surfaceToNodeMap"][airfoilId]
    if nodeId == null {
        return 0.0
    }
    let airfoilNode = model["document"]["nodes"][airfoilId]
    if airfoilNode == null {
        return 0.0
    }
    let flow = model["flow"]
    let cl = aeroEstimateCl(airfoilNode, flow["alphaDeg"])
    let q = 0.5 * flow["rho"] * flow["v"] * flow["v"]
    return q * airfoilNode["meta"]["area"] * cl
}

pub fn aeroGetDocument(model) {
    return model["document"]
}

pub fn aeroGetGraph(model) {
    return model["surfaceGraph"]
}

pub fn aeroSerialize(model) {
    return {
        "kind": "SerializedAeroModel",
        "name": model["name"],
        "document": model["document"],
        "graph": model["surfaceGraph"],
        "surfaceToNodeMap": model["surfaceToNodeMap"],
        "flow": model["flow"]
    }
}

pub fn aeroDeserialize(data) {
    let model = createAeroModel(data["name"])
    model["document"] = data["document"]
    model["surfaceGraph"] = data["graph"]
    model["surfaceToNodeMap"] = data["surfaceToNodeMap"]
    model["flow"] = data["flow"]
    return model
}

// MDAO Integration Functions
pub fn createMDAOFramework(name) {
    return {
        "kind": "MDAOFramework",
        "name": name,
        "aeroModel": createAeroModel(name + "-aero"),
        "optimization": {
            "objective": "minimize_drag",
            "constraints": {},
            "variables": {}
        },
        "solvers": {
            "amadevs": false,
            "anvil": false,
            "ceasiompy": false,
            "rcaide": false
        }
    }
}

pub fn enableAmadevsSolver(framework, enabled) {
    framework["solvers"]["amadevs"] = enabled
    return framework
}

pub fn enableAnvilSolver(framework, enabled) {
    framework["solvers"]["anvil"] = enabled
    return framework
}

pub fn enableCeasiompySolver(framework, enabled) {
    framework["solvers"]["ceasiompy"] = enabled
    return framework
}

pub fn enableRcaideSolver(framework, enabled) {
    framework["solvers"]["rcaide"] = enabled
    return framework
}

pub fn setMDAOObjective(framework, objective) {
    framework["optimization"]["objective"] = objective
    return framework
}

pub fn addMDAOConstraint(framework, name, minValue, maxValue) {
    framework["optimization"]["constraints"][name] = {
        "min": minValue,
        "max": maxValue
    }
    return framework
}

pub fn addMDAOVariable(framework, name, initialValue, minBound, maxBound) {
    framework["optimization"]["variables"][name] = {
        "value": initialValue,
        "min": minBound,
        "max": maxBound
    }
    return framework
}

pub fn exportToAmadevs(framework) {
    if framework["solvers"]["amadevs"] == false {
        return null
    }
    
    let export = {
        "format": "amadevs",
        "aeroModel": aeroSerialize(framework["aeroModel"]),
        "optimization": framework["optimization"],
        "timestamp": systemTime()
    }
    
    return export
}

pub fn exportToAnvil(framework) {
    if framework["solvers"]["anvil"] == false {
        return null
    }
    
    let export = {
        "format": "anvil",
        "aeroModel": aeroSerialize(framework["aeroModel"]),
        "optimization": framework["optimization"],
        "timestamp": systemTime()
    }
    
    return export
}

pub fn exportToCeasiompy(framework) {
    if framework["solvers"]["ceasiompy"] == false {
        return null
    }
    
    let export = {
        "format": "ceasiompy",
        "aeroModel": aeroSerialize(framework["aeroModel"]),
        "optimization": framework["optimization"],
        "timestamp": systemTime()
    }
    
    return export
}

pub fn exportToRcaide(framework) {
    if framework["solvers"]["rcaide"] == false {
        return null
    }
    
    let export = {
        "format": "rcaide",
        "aeroModel": aeroSerialize(framework["aeroModel"]),
        "optimization": framework["optimization"],
        "timestamp": systemTime()
    }
    
    return export
}

pub fn runMDAOOptimization(framework) {
    let results = {
        "objectiveValue": 0.0,
        "iterations": 0,
        "converged": false,
        "variables": {}
    }
    
    for varName in framework["optimization"]["variables"] {
        results["variables"][varName] = framework["optimization"]["variables"][varName]["value"]
    }
    
    return results
}

pub fn importAmadevsResults(framework, results) {
    framework["aeroModel"]["flow"] = results["flow"]
    return framework
}

pub fn importAnvilResults(framework, results) {
    framework["aeroModel"]["flow"] = results["flow"]
    return framework
}

pub fn importCeasiompyResults(framework, results) {
    framework["aeroModel"]["flow"] = results["flow"]
    return framework
}

pub fn importRcaideResults(framework, results) {
    framework["aeroModel"]["flow"] = results["flow"]
    return framework
}

// AeroSandbox Integration
pub fn createAeroSandboxModel(name) {
    return {
        "kind": "AeroSandboxModel",
        "name": name,
        "aeroModel": createAeroModel(name + "-aerosandbox"),
        "airplane": {
            "wings": [],
            "fuselage": null,
            "stabilizers": []
        },
        "analysis": {
            "drag_polar": {},
            "lift_coefficient": 0.0,
            "drag_coefficient": 0.0
        }
    }
}

pub fn addAeroSandboxWing(model, chord, span, sweep, position) {
    let wing = {
        "kind": "Wing",
        "chord": chord,
        "span": span,
        "sweep": sweep,
        "position": position,
        "airfoil": "naca0012"
    }
    model["airplane"]["wings"] = push(model["airplane"]["wings"], wing)
    return model
}

pub fn addAeroSandboxFuselage(model, length, radius, position) {
    let fuselage = {
        "kind": "Fuselage",
        "length": length,
        "radius": radius,
        "position": position
    }
    model["airplane"]["fuselage"] = fuselage
    return model
}

pub fn addAeroSandboxStabilizer(model, chord, span, position, type) {
    let stabilizer = {
        "kind": "Stabilizer",
        "chord": chord,
        "span": span,
        "position": position,
        "type": type
    }
    model["airplane"]["stabilizers"] = push(model["airplane"]["stabilizers"], stabilizer)
    return model
}

pub fn exportToAeroSandbox(model) {
    let export = {
        "format": "aerosandbox",
        "airplane": model["airplane"],
        "aeroModel": aeroSerialize(model["aeroModel"]),
        "timestamp": systemTime()
    }
    
    return export
}

pub fn importAeroSandboxResults(model, results) {
    model["analysis"] = results["analysis"]
    model["aeroModel"]["flow"] = results["flow"]
    return model
}

pub fn runAeroSandboxAnalysis(model) {
    let analysis = {
        "drag_polar": {
            "cd0": 0.02,
            "k": 0.05
        },
        "lift_coefficient": 0.5,
        "drag_coefficient": 0.03
    }
    
    model["analysis"] = analysis
    return model
}
