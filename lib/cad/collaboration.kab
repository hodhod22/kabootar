@version "1.0.0"

// CAD Collaboration - Real-time collaboration for CAD documents
// Features: session management, operational transformation, conflict resolution, presence
// Canonical path: import "cad/collaboration"
// Target: Collaboration system comparable to Figma/Google Docs

import "cad/document"
import "cad/history"
import "cad/host"

pub fn createCollaborationSystem() {
    return {
        "kind": "CollaborationSystem",
        "sessionId": null,
        "users": {},
        "document": null,
        "operations": [],
        "operationIndex": 0,
        "presence": {}
    }
}

pub fn createSession(document, hostId) {
    let system = createCollaborationSystem()
    system["document"] = document
    system["sessionId"] = generateSessionId()
    system["hostId"] = hostId
    return system
}

pub fn joinSession(system, userId, userName) {
    let user = {
        "id": userId,
        "name": userName,
        "role": "editor",
        "cursor": { "position": vec2(0.0, 0.0), "visible": false },
        "selection": [],
        "color": generateUserColor()
    }
    
    system["users"][userId] = user
    system["presence"][userId] = {
        "online": true,
        "lastSeen": currentTime()
    }
    
    return system
}

pub fn leaveSession(system, userId) {
    system["users"][userId] = null
    system["presence"][userId]["online"] = false
    system["presence"][userId]["lastSeen"] = currentTime()
    return system
}

pub fn broadcastOperation(system, userId, operation) {
    let op = {
        "id": generateOperationId(),
        "userId": userId,
        "operation": operation,
        "timestamp": currentTime(),
        "index": system["operationIndex"]
    }
    
    system["operations"] = push(system["operations"], op)
    system["operationIndex"] = system["operationIndex"] + 1
    
    system["document"] = applyOperation(system["document"], operation)
    
    return system
}

pub fn receiveOperation(system, operation) {
    let op = operation
    
    if op["index"] == system["operationIndex"] {
        system["document"] = applyOperation(system["document"], op["operation"])
        system["operations"] = push(system["operations"], op)
        system["operationIndex"] = system["operationIndex"] + 1
    } else if op["index"] < system["operationIndex"] {
        system = resolveConflict(system, op)
    }
    
    return system
}

fn applyOperation(document, operation) {
    let kind = operation["kind"]
    
    if kind == "AddNode" {
        return applyAddNodeOperation(document, operation)
    } else if kind == "RemoveNode" {
        return applyRemoveNodeOperation(document, operation)
    } else if kind == "MoveNode" {
        return applyMoveNodeOperation(document, operation)
    } else if kind == "SetTransform" {
        return applySetTransformOperation(document, operation)
    } else if kind == "SetProperty" {
        return applySetPropertyOperation(document, operation)
    }
    
    return document
}

fn applyAddNodeOperation(document, operation) {
    let node = operation["node"]
    let parentId = operation["parentId"]
    document = addNode(document, parentId, node)
    return document
}

fn applyRemoveNodeOperation(document, operation) {
    let nodeId = operation["nodeId"]
    document = removeNode(document, nodeId)
    return document
}

fn applyMoveNodeOperation(document, operation) {
    let nodeId = operation["nodeId"]
    let newPosition = operation["newPosition"]
    let node = document["nodes"][nodeId]
    if node != null {
        node["transform"]["position"] = newPosition
        node["transformDirty"] = true
        document["nodes"][nodeId] = node
    }
    return document
}

fn applySetTransformOperation(document, operation) {
    let nodeId = operation["nodeId"]
    let newTransform = operation["newTransform"]
    let node = document["nodes"][nodeId]
    if node != null {
        node["transform"] = newTransform
        node["transformDirty"] = true
        document["nodes"][nodeId] = node
    }
    return document
}

fn applySetPropertyOperation(document, operation) {
    let nodeId = operation["nodeId"]
    let key = operation["key"]
    let newValue = operation["newValue"]
    let node = document["nodes"][nodeId]
    if node != null {
        node["properties"][key] = newValue
        document["nodes"][nodeId] = node
    }
    return document
}

fn resolveConflict(system, incomingOp) {
    let localOps = []
    let i = incomingOp["index"]
    while i < system["operationIndex"] {
        localOps = push(localOps, system["operations"][i])
        i = i + 1
    }
    
    let transformedOp = operationalTransform(incomingOp, localOps)
    
    system["document"] = applyOperation(system["document"], transformedOp["operation"])
    system["operations"] = push(system["operations"], transformedOp)
    system["operationIndex"] = system["operationIndex"] + 1
    
    return system
}

fn operationalTransform(op, otherOps) {
    let transformedOp = op
    
    let i = 0
    while i < len(otherOps) {
        let otherOp = otherOps[i]
        transformedOp = transformOperation(transformedOp, otherOp)
        i = i + 1
    }
    
    return transformedOp
}

fn transformOperation(op, otherOp) {
    let opKind = op["operation"]["kind"]
    let otherKind = otherOp["operation"]["kind"]
    
    if opKind == "AddNode" && otherKind == "AddNode" {
        if op["operation"]["node"]["id"] == otherOp["operation"]["node"]["id"] {
            op["operation"]["node"]["id"] = op["operation"]["node"]["id"] + "_conflict"
        }
    } else if opKind == "RemoveNode" && otherKind == "RemoveNode" {
        if op["operation"]["nodeId"] == otherOp["operation"]["nodeId"] {
            op["conflict"] = true
        }
    } else if opKind == "MoveNode" && otherKind == "MoveNode" {
        if op["operation"]["nodeId"] == otherOp["operation"]["nodeId"] {
            let offset = vec2Sub(otherOp["operation"]["newPosition"], otherOp["operation"]["oldPosition"])
            op["operation"]["newPosition"] = vec2Add(op["operation"]["newPosition"], offset)
        }
    }
    
    return op
}

pub fn updateUserCursor(system, userId, position) {
    if system["users"][userId] != null {
        system["users"][userId]["cursor"]["position"] = position
        system["users"][userId]["cursor"]["visible"] = true
    }
    return system
}

pub fn updateUserSelection(system, userId, selection) {
    if system["users"][userId] != null {
        system["users"][userId]["selection"] = selection
    }
    return system
}

pub fn updateUserPresence(system, userId, presence) {
    if system["presence"][userId] != null {
        system["presence"][userId]["online"] = presence["online"]
        system["presence"][userId]["lastSeen"] = currentTime()
    }
    return system
}

pub fn getUserList(system) {
    let users = []
    for userId in system["users"] {
        let user = system["users"][userId]
        if user != null {
            users = push(users, {
                "id": userId,
                "name": user["name"],
                "role": user["role"],
                "color": user["color"],
                "online": system["presence"][userId]["online"]
            })
        }
    }
    return users
}

pub fn createComment(userId, nodeId, text, position) {
    return {
        "kind": "Comment",
        "id": generateCommentId(),
        "userId": userId,
        "nodeId": nodeId,
        "text": text,
        "position": position,
        "timestamp": currentTime(),
        "resolved": false,
        "replies": []
    }
}

pub fn addComment(system, comment) {
    if system["comments"] == null {
        system["comments"] = []
    }
    system["comments"] = push(system["comments"], comment)
    return system
}

pub fn resolveComment(system, commentId) {
    let i = 0
    while i < len(system["comments"]) {
        if system["comments"][i]["id"] == commentId {
            system["comments"][i]["resolved"] = true
            break
        }
        i = i + 1
    }
    return system
}

pub fn addCommentReply(system, commentId, reply) {
    let i = 0
    while i < len(system["comments"]) {
        if system["comments"][i]["id"] == commentId {
            system["comments"][i]["replies"] = push(system["comments"][i]["replies"], reply)
            break
        }
        i = i + 1
    }
    return system
}

pub fn createChangeLog() {
    return {
        "kind": "ChangeLog",
        "entries": []
    }
}

pub fn addChangeEntry(log, userId, description, nodeId) {
    let entry = {
        "id": generateEntryId(),
        "userId": userId,
        "description": description,
        "nodeId": nodeId,
        "timestamp": currentTime()
    }
    log["entries"] = push(log["entries"], entry)
    return log
}

pub fn getRecentChanges(log, count) {
    let entries = log["entries"]
    let recent = []
    let start = max(0, len(entries) - count)
    let i = start
    while i < len(entries) {
        recent = push(recent, entries[i])
        i = i + 1
    }
    return recent
}

pub fn createConflictResolution(op1, op2, strategy) {
    return {
        "kind": "ConflictResolution",
        "op1": op1,
        "op2": op2,
        "strategy": strategy,
        "resolution": null
    }
}

pub fn resolveConflictAuto(resolution) {
    let strategy = resolution["strategy"]
    
    if strategy == "lastWriteWins" {
        resolution["resolution"] = resolution["op2"]
    } else if strategy == "firstWriteWins" {
        resolution["resolution"] = resolution["op1"]
    } else if strategy == "merge" {
        resolution["resolution"] = mergeOperations(resolution["op1"], resolution["op2"])
    }
    
    return resolution
}

fn mergeOperations(op1, op2) {
    let op1Kind = op1["operation"]["kind"]
    let op2Kind = op2["operation"]["kind"]
    
    if op1Kind == "MoveNode" && op2Kind == "MoveNode" {
        if op1["operation"]["nodeId"] == op2["operation"]["nodeId"] {
            let merged = op2
            merged["operation"]["oldPosition"] = op1["operation"]["oldPosition"]
            return merged
        }
    }
    
    return op2
}

pub fn exportSessionState(system) {
    return {
        "sessionId": system["sessionId"],
        "document": system["document"],
        "users": getUserList(system),
        "operationIndex": system["operationIndex"],
        "comments": system["comments"]
    }
}

pub fn importSessionState(system, state) {
    system["document"] = state["document"]
    system["operationIndex"] = state["operationIndex"]
    system["comments"] = state["comments"]
    return system
}

pub fn createPermissionSystem() {
    return {
        "kind": "PermissionSystem",
        "roles": {
            "owner": ["read", "write", "admin", "delete"],
            "editor": ["read", "write"],
            "viewer": ["read"],
            "commenter": ["read", "comment"]
        },
        "userPermissions": {}
    }
}

pub fn setUserPermission(system, userId, role) {
    system["userPermissions"][userId] = role
    return system
}

pub fn checkPermission(system, userId, action) {
    let role = system["userPermissions"][userId]
    if role == null {
        return false
    }
    
    let permissions = system["roles"][role]
    let i = 0
    while i < len(permissions) {
        if permissions[i] == action {
            return true
        }
        i = i + 1
    }
    
    return false
}

pub fn createVersionControl() {
    return {
        "kind": "VersionControl",
        "versions": [],
        "currentVersion": 0
    }
}

pub fn createVersion(document, userId, description) {
    return {
        "id": generateVersionId(),
        "document": document,
        "userId": userId,
        "description": description,
        "timestamp": currentTime()
    }
}

pub fn saveVersion(vc, version) {
    vc["versions"] = push(vc["versions"], version)
    vc["currentVersion"] = len(vc["versions"]) - 1
    return vc
}

pub function restoreVersion(vc, versionId) {
    let i = 0
    while i < len(vc["versions"]) {
        if vc["versions"][i]["id"] == versionId {
            vc["currentVersion"] = i
            return vc["versions"][i]["document"]
        }
        i = i + 1
    }
    return null
}

pub fn getVersionHistory(vc) {
    let history = []
    let i = 0
    while i < len(vc["versions"]) {
        let version = vc["versions"][i]
        history = push(history, {
            "id": version["id"],
            "userId": version["userId"],
            "description": version["description"],
            "timestamp": version["timestamp"],
            "isCurrent": i == vc["currentVersion"]
        })
        i = i + 1
    }
    return history
}

fn generateSessionId() {
    return "session-" + floor(currentTime() * 1000.0) + "-" + random()
}

fn generateOperationId() {
    return "op-" + floor(currentTime() * 1000.0) + "-" + random()
}

fn generateCommentId() {
    return "comment-" + floor(currentTime() * 1000.0) + "-" + random()
}

fn generateEntryId() {
    return "entry-" + floor(currentTime() * 1000.0) + "-" + random()
}

fn generateVersionId() {
    return "version-" + floor(currentTime() * 1000.0) + "-" + random()
}

fn generateUserColor() {
    let colors = [
        vec3(1.0, 0.0, 0.0),
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, 0.0, 1.0),
        vec3(1.0, 1.0, 0.0),
        vec3(1.0, 0.0, 1.0),
        vec3(0.0, 1.0, 1.0),
        vec3(1.0, 0.5, 0.0),
        vec3(0.5, 1.0, 0.0)
    ]
    let index = floor(random() * len(colors))
    return colors[index]
}

fn currentTime() {
    return systemTime()
}

fn random() {
    return systemRandom()
}

fn floor(value) {
    return systemFloor(value)
}

fn max(a, b) {
    return systemMax(a, b)
}

fn vec2(x, y) {
    return { "x": x, "y": y }
}

fn vec2Sub(a, b) {
    return vec2(a["x"] - b["x"], a["y"] - b["y"])
}

fn vec2Add(a, b) {
    return vec2(a["x"] + b["x"], a["y"] + b["y"])
}

fn vec3(x, y, z) {
    return { "x": x, "y": y, "z": z }
}
