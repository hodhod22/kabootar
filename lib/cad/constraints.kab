@version "1.0.0"

// CAD Constraints - Full constraint solver for CAD/CAM
// Features: geometric constraints, parametric constraints, solver engine
// Canonical path: import "cad/constraints"
// Target: Constraint system comparable to AutoCAD/SolidWorks

import "cad/document"
import "cad/geom"

pub fn createConstraintSystem() {
    return {
        "kind": "ConstraintSystem",
        "constraints": [],
        "constraintCounter": 0,
        "solver": {
            "kind": "Solver",
            "maxIterations": 100,
            "tolerance": 0.001
        }
    }
}

pub fn addConstraint(system, constraint) {
    constraint["id"] = system["constraintCounter"]
    system["constraintCounter"] = system["constraintCounter"] + 1
    system["constraints"] = push(system["constraints"], constraint)
    return system
}

pub fn removeConstraint(system, constraintId) {
    let newConstraints = []
    let i = 0
    while i < len(system["constraints"]) {
        if system["constraints"][i]["id"] != constraintId {
            newConstraints = push(newConstraints, system["constraints"][i])
        }
        i = i + 1
    }
    system["constraints"] = newConstraints
    return system
}

pub fn createHorizontalConstraint(nodeId) {
    return {
        "kind": "Horizontal",
        "nodeId": nodeId,
        "enabled": true
    }
}

pub fn createVerticalConstraint(nodeId) {
    return {
        "kind": "Vertical",
        "nodeId": nodeId,
        "enabled": true
    }
}

pub fn createFixedLengthConstraint(nodeId, length) {
    return {
        "kind": "FixedLength",
        "nodeId": nodeId,
        "length": length,
        "enabled": true
    }
}

pub fn createFixedAngleConstraint(nodeId, angle) {
    return {
        "kind": "FixedAngle",
        "nodeId": nodeId,
        "angle": angle,
        "enabled": true
    }
}

pub fn createCoincidentConstraint(nodeId1, nodeId2) {
    return {
        "kind": "Coincident",
        "nodeId1": nodeId1,
        "nodeId2": nodeId2,
        "enabled": true
    }
}

pub fn createParallelConstraint(nodeId1, nodeId2) {
    return {
        "kind": "Parallel",
        "nodeId1": nodeId1,
        "nodeId2": nodeId2,
        "enabled": true
    }
}

pub fn createPerpendicularConstraint(nodeId1, nodeId2) {
    return {
        "kind": "Perpendicular",
        "nodeId1": nodeId1,
        "nodeId2": nodeId2,
        "enabled": true
    }
}

pub fn createTangentConstraint(nodeId1, nodeId2) {
    return {
        "kind": "Tangent",
        "nodeId1": nodeId1,
        "nodeId2": nodeId2,
        "enabled": true
    }
}

pub fn createEqualLengthConstraint(nodeId1, nodeId2) {
    return {
        "kind": "EqualLength",
        "nodeId1": nodeId1,
        "nodeId2": nodeId2,
        "enabled": true
    }
}

pub fn createEqualAngleConstraint(nodeId1, nodeId2) {
    return {
        "kind": "EqualAngle",
        "nodeId1": nodeId1,
        "nodeId2": nodeId2,
        "enabled": true
    }
}

pub fn createDistanceConstraint(nodeId1, nodeId2, distance) {
    return {
        "kind": "Distance",
        "nodeId1": nodeId1,
        "nodeId2": nodeId2,
        "distance": distance,
        "enabled": true
    }
}

pub fn createAngleConstraint(nodeId1, nodeId2, angle) {
    return {
        "kind": "Angle",
        "nodeId1": nodeId1,
        "nodeId2": nodeId2,
        "angle": angle,
        "enabled": true
    }
}

pub fn solveConstraints(document, system) {
    let maxIterations = system["solver"]["maxIterations"]
    let tolerance = system["solver"]["tolerance"]
    
    let iteration = 0
    let converged = false
    
    while iteration < maxIterations && converged == false {
        let totalError = 0.0
        
        let i = 0
        while i < len(system["constraints"]) {
            let constraint = system["constraints"][i]
            if constraint["enabled"] == true {
                let result = evaluateConstraint(document, constraint)
                document = result["document"]
                totalError = totalError + result["error"]
            }
            i = i + 1
        }
        
        if totalError < tolerance {
            converged = true
        }
        
        iteration = iteration + 1
    }
    
    return {
        "document": document,
        "converged": converged,
        "iterations": iteration
    }
}

fn evaluateConstraint(document, constraint) {
    let kind = constraint["kind"]
    
    if kind == "Horizontal" {
        return evaluateHorizontalConstraint(document, constraint)
    } else if kind == "Vertical" {
        return evaluateVerticalConstraint(document, constraint)
    } else if kind == "FixedLength" {
        return evaluateFixedLengthConstraint(document, constraint)
    } else if kind == "FixedAngle" {
        return evaluateFixedAngleConstraint(document, constraint)
    } else if kind == "Coincident" {
        return evaluateCoincidentConstraint(document, constraint)
    } else if kind == "Parallel" {
        return evaluateParallelConstraint(document, constraint)
    } else if kind == "Perpendicular" {
        return evaluatePerpendicularConstraint(document, constraint)
    } else if kind == "EqualLength" {
        return evaluateEqualLengthConstraint(document, constraint)
    } else if kind == "Distance" {
        return evaluateDistanceConstraint(document, constraint)
    }
    
    return { "document": document, "error": 0.0 }
}

fn evaluateHorizontalConstraint(document, constraint) {
    let nodeId = constraint["nodeId"]
    let node = document["nodes"][nodeId]
    
    if node == null {
        return { "document": document, "error": 0.0 }
    }
    
    let pos = node["transform"]["position"]
    let error = abs(pos["y"] - 0.0)
    
    node["transform"]["position"]["y"] = 0.0
    node["transformDirty"] = true
    document["nodes"][nodeId] = node
    
    return { "document": document, "error": error }
}

fn evaluateVerticalConstraint(document, constraint) {
    let nodeId = constraint["nodeId"]
    let node = document["nodes"][nodeId]
    
    if node == null {
        return { "document": document, "error": 0.0 }
    }
    
    let pos = node["transform"]["position"]
    let error = abs(pos["x"] - 0.0)
    
    node["transform"]["position"]["x"] = 0.0
    node["transformDirty"] = true
    document["nodes"][nodeId] = node
    
    return { "document": document, "error": error }
}

fn evaluateFixedLengthConstraint(document, constraint) {
    let nodeId = constraint["nodeId"]
    let targetLength = constraint["length"]
    let node = document["nodes"][nodeId]
    
    if node == null {
        return { "document": document, "error": 0.0 }
    }
    
    let pos = node["transform"]["position"]
    let currentLength = distance(vec2(0.0, 0.0), pos)
    let error = abs(currentLength - targetLength)
    
    if currentLength > 0.0 {
        let scale = targetLength / currentLength
        node["transform"]["position"]["x"] = node["transform"]["position"]["x"] * scale
        node["transform"]["position"]["y"] = node["transform"]["position"]["y"] * scale
        node["transformDirty"] = true
        document["nodes"][nodeId] = node
    }
    
    return { "document": document, "error": error }
}

fn evaluateFixedAngleConstraint(document, constraint) {
    let nodeId = constraint["nodeId"]
    let targetAngle = constraint["angle"]
    let node = document["nodes"][nodeId]
    
    if node == null {
        return { "document": document, "error": 0.0 }
    }
    
    let currentAngle = node["transform"]["rotation"]
    let error = abs(currentAngle - targetAngle)
    
    node["transform"]["rotation"] = targetAngle
    node["transformDirty"] = true
    document["nodes"][nodeId] = node
    
    return { "document": document, "error": error }
}

fn evaluateCoincidentConstraint(document, constraint) {
    let nodeId1 = constraint["nodeId1"]
    let nodeId2 = constraint["nodeId2"]
    let node1 = document["nodes"][nodeId1]
    let node2 = document["nodes"][nodeId2]
    
    if node1 == null || node2 == null {
        return { "document": document, "error": 0.0 }
    }
    
    let pos1 = node1["transform"]["position"]
    let pos2 = node2["transform"]["position"]
    let midpoint = vec2((pos1["x"] + pos2["x"]) / 2.0, (pos1["y"] + pos2["y"]) / 2.0)
    let error = distance(pos1, pos2)
    
    node1["transform"]["position"] = midpoint
    node2["transform"]["position"] = midpoint
    node1["transformDirty"] = true
    node2["transformDirty"] = true
    document["nodes"][nodeId1] = node1
    document["nodes"][nodeId2] = node2
    
    return { "document": document, "error": error }
}

fn evaluateParallelConstraint(document, constraint) {
    let nodeId1 = constraint["nodeId1"]
    let nodeId2 = constraint["nodeId2"]
    let node1 = document["nodes"][nodeId1]
    let node2 = document["nodes"][nodeId2]
    
    if node1 == null || node2 == null {
        return { "document": document, "error": 0.0 }
    }
    
    let angle1 = node1["transform"]["rotation"]
    let angle2 = node2["transform"]["rotation"]
    let error = abs(angle1 - angle2)
    
    node2["transform"]["rotation"] = angle1
    node2["transformDirty"] = true
    document["nodes"][nodeId2] = node2
    
    return { "document": document, "error": error }
}

fn evaluatePerpendicularConstraint(document, constraint) {
    let nodeId1 = constraint["nodeId1"]
    let nodeId2 = constraint["nodeId2"]
    let node1 = document["nodes"][nodeId1]
    let node2 = document["nodes"][nodeId2]
    
    if node1 == null || node2 == null {
        return { "document": document, "error": 0.0 }
    }
    
    let angle1 = node1["transform"]["rotation"]
    let targetAngle = angle1 + 1.5708
    let angle2 = node2["transform"]["rotation"]
    let error = abs(angle2 - targetAngle)
    
    node2["transform"]["rotation"] = targetAngle
    node2["transformDirty"] = true
    document["nodes"][nodeId2] = node2
    
    return { "document": document, "error": error }
}

fn evaluateEqualLengthConstraint(document, constraint) {
    let nodeId1 = constraint["nodeId1"]
    let nodeId2 = constraint["nodeId2"]
    let node1 = document["nodes"][nodeId1]
    let node2 = document["nodes"][nodeId2]
    
    if node1 == null || node2 == null {
        return { "document": document, "error": 0.0 }
    }
    
    let pos1 = node1["transform"]["position"]
    let pos2 = node2["transform"]["position"]
    let length1 = distance(vec2(0.0, 0.0), pos1)
    let length2 = distance(vec2(0.0, 0.0), pos2)
    let avgLength = (length1 + length2) / 2.0
    let error = abs(length1 - length2)
    
    if length1 > 0.0 {
        let scale1 = avgLength / length1
        node1["transform"]["position"]["x"] = node1["transform"]["position"]["x"] * scale1
        node1["transform"]["position"]["y"] = node1["transform"]["position"]["y"] * scale1
    }
    
    if length2 > 0.0 {
        let scale2 = avgLength / length2
        node2["transform"]["position"]["x"] = node2["transform"]["position"]["x"] * scale2
        node2["transform"]["position"]["y"] = node2["transform"]["position"]["y"] * scale2
    }
    
    node1["transformDirty"] = true
    node2["transformDirty"] = true
    document["nodes"][nodeId1] = node1
    document["nodes"][nodeId2] = node2
    
    return { "document": document, "error": error }
}

fn evaluateDistanceConstraint(document, constraint) {
    let nodeId1 = constraint["nodeId1"]
    let nodeId2 = constraint["nodeId2"]
    let targetDistance = constraint["distance"]
    let node1 = document["nodes"][nodeId1]
    let node2 = document["nodes"][nodeId2]
    
    if node1 == null || node2 == null {
        return { "document": document, "error": 0.0 }
    }
    
    let pos1 = node1["transform"]["position"]
    let pos2 = node2["transform"]["position"]
    let currentDistance = distance(pos1, pos2)
    let error = abs(currentDistance - targetDistance)
    
    if currentDistance > 0.0 {
        let scale = targetDistance / currentDistance
        let dx = pos2["x"] - pos1["x"]
        let dy = pos2["y"] - pos1["y"]
        node2["transform"]["position"]["x"] = pos1["x"] + dx * scale
        node2["transform"]["position"]["y"] = pos1["y"] + dy * scale
        node2["transformDirty"] = true
        document["nodes"][nodeId2] = node2
    }
    
    return { "document": document, "error": error }
}

pub fn enableConstraint(system, constraintId) {
    let i = 0
    while i < len(system["constraints"]) {
        if system["constraints"][i]["id"] == constraintId {
            system["constraints"][i]["enabled"] = true
            break
        }
        i = i + 1
    }
    return system
}

pub fn disableConstraint(system, constraintId) {
    let i = 0
    while i < len(system["constraints"]) {
        if system["constraints"][i]["id"] == constraintId {
            system["constraints"][i]["enabled"] = false
            break
        }
        i = i + 1
    }
    return system
}

pub fn clearConstraints(system) {
    system["constraints"] = []
    return system
}

pub fn getConstraintCount(system) {
    return len(system["constraints"])
}

pub fn getEnabledConstraintCount(system) {
    let count = 0
    let i = 0
    while i < len(system["constraints"]) {
        if system["constraints"][i]["enabled"] == true {
            count = count + 1
        }
        i = i + 1
    }
    return count
}
