// F10: Kab-native images declare a stable calling ABI per target.
// import "kab/aot_abi"; do not import other kab/aot* leaves.

pub fn aotAbiOk(target, abi) {
    if target == "x64" {
        return abi == "win64"
    }
    if target == "arm64" {
        return abi == "aapcs64"
    }
    return false
}
