// SH17 deepen: translate+store for loop-neg template. import "kab/jit_wr_loop_neg"
// Do not grow jit_wr_loop_not.kab.

import "kab/jit_patch_loop_neg"
import "kab/jit_mm_loop_neg"
import "kab/jit_mm_store_loop_neg"
import "kab/jit_loop_neg"

pub fn jitWrLoopNegOk(bytes, n) {
    if jitPatchLoopNegOk(bytes, n) == false {
        return false
    }
    let pid = jitMmLoopNegPid()
    let virt = jitMmLoopNegVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopNeg(bytes, n)
    if w != jitLoopNegLen() {
        return false
    }
    return true
}
