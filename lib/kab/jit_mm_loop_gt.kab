// SH17 deepen: loop-gt guest mmap args. import "kab/jit_mm_loop_gt"
// Do not grow jit_mm_loop_lt.kab. Separate virt slot from loop-lt.

import "kab/jit_loop_gt"

pub fn jitMmLoopGtPid() {
    return 1
}

pub fn jitMmLoopGtVirt() {
    return 548864
}

pub fn jitMmLoopGtLen() {
    return 4096
}

pub fn jitMmLoopGtProt() {
    return 7
}

pub fn jitOsMmapLoopGtOk(nBytes, kind, n, k) {
    if jitLoopGtOk(n, k) == false {
        return false
    }
    if nBytes != jitLoopGtLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopGtLen() != 4096 {
        return false
    }
    if jitMmLoopGtProt() != 7 {
        return false
    }
    return true
}
