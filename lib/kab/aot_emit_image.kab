// F10: emit a first Kab-native image: plan plus return stub.
// import "kab/aot_emit_image"; do not import other kab/aot* leaves.

pub fn aotEmitImage(target) {
    if target == "x64" {
        return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret"
    }
    if target == "arm64" {
        return "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret"
    }
    return ""
}
