// SH20: collections count off std_colindex.kab. import "kab/std_colcount"
// Do not grow std_colindex.kab. stdHostDeleteOk stays false.

pub fn stdColCount(p, x) {
    let n = len(p)
    let i = 0
    let c = 0
    while i < n {
        if p[i] == x {
            c = c + 1
        }
        i = i + 1
    }
    return c
}
