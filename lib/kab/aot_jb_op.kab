// F10: first Kab-native images emit a documented jb opcode for the return register.
// import "kab/aot_jb_op"; do not import other kab/aot* leaves.

pub fn aotJbOp(target) {
    if target == "x64" {
        return "7200"
    }
    if target == "arm64" {
        return "54000003"
    }
    return ""
}
