// SH17 deepen: loop-and guest mmap args. import "kab/jit_mm_loop_and"
// Do not grow jit_mm_loop_mod.kab. Separate virt slot from loop-mod.

import "kab/jit_loop_and"

pub fn jitMmLoopAndPid() {
    return 1
}

pub fn jitMmLoopAndVirt() {
    return 458752
}

pub fn jitMmLoopAndLen() {
    return 4096
}

pub fn jitMmLoopAndProt() {
    return 7
}

pub fn jitOsMmapLoopAndOk(nBytes, kind, n, mask) {
    if jitLoopAndOk(n, mask) == false {
        return false
    }
    if nBytes != jitLoopAndLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopAndLen() != 4096 {
        return false
    }
    if jitMmLoopAndProt() != 7 {
        return false
    }
    return true
}
