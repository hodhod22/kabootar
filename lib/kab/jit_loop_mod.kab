// SH17 deepen: i64 loopN + mod-imm template. import "kab/jit_loop_mod"
// Do not grow jit_loop_div.kab. Magic L + count N + mod R + ret; os_mm_call returns N%R.

import "kab/jit_loop_n"

pub fn jitLoopModRMax() {
    return 64
}

pub fn jitLoopModROk(n, r) {
    if r <= 0 {
        return false
    }
    if r > jitLoopModRMax() {
        return false
    }
    if r >= n {
        return false
    }
    return true
}

pub fn jitLoopModOk(n, r) {
    if jitLoopNOk(n) == false {
        return false
    }
    if jitLoopModROk(n, r) == false {
        return false
    }
    return true
}

pub fn jitLoopModRax(n, r) {
    return n % r
}

pub fn jitLoopModLen() {
    return jitLoopNLen()
}

/// Loop marker 76, count n, add/sub/mul/div 0, mod r, ret — simulated guest rax=n%r.
pub fn jitEmitI64LoopModN(n, r) {
    let b = []
    b = push(b, 76)
    b = push(b, n)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, r)
    b = push(b, 195)
    return b
}
