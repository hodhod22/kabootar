// F10: loader accepts only a documented first-image jg opcode.
// import "kab/aot_load_jg"; do not import other kab/aot* leaves.

pub fn aotLoadJgOk(op, target) {
    if target == "x64" {
        return op == "7f00"
    }
    if target == "arm64" {
        return op == "5400000c"
    }
    return false
}
