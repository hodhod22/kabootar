// SH19 capstone: full AOT chain plus all host delete gates closed. import "kab/load/load_aot_capstone"
// Do not grow load_aot_chain.kab. nollAotReady stays false; do not delete src/.

import "kab/load/load_aot_chain"
import "kab/gc/gc_host"
import "kab/noll/noll_host"

pub fn loadAotCapstoneNativeName() {
    return loadAotChainNativeName()
}

/// True when the GC host delete gate is satisfied (production evidence) and
/// every other SH19–SH27 host delete gate is still closed.
pub fn loadAotCapstoneGatesClosed() {
    if gcHostDeleteOk() == false {
        return false
    }
    return nollPendingHostGatesClosed()
}

/// Full load_aot chain plus all host delete gates still closed.
pub fn loadAotCapstoneOk(nBytes) {
    if loadAotChainOk(nBytes) == false {
        return false
    }
    return loadAotCapstoneGatesClosed()
}
