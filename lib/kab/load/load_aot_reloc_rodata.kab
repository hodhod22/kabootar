// SH19 deepen: AOT rodata/data reloc apply off text offset chain. import "kab/load/load_aot_reloc_rodata"
// Do not grow load_aot_reloc_text_at.kab. Host main.rs stays until rodata apply smoke completes.
// Nested call args must be locals first — module-scope binding quirk.

import "kab/load/load_aot_reloc_text_at"
import "kab/aot/aot_load_image"

pub fn loadAotRelocRodataWordPlan() {
    return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|sym:rodata:0:kstr:x64|relocs:reloc:rodata:0:0:kstr:x64|relocword:0010000000000000"
}
    10|
pub fn loadAotRelocRodataHexPlan() {
    return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|0010000000000000|data:rw|code:x64:ret|sym:rodata:0:kstr:x64|relocs:reloc:rodata:0:0:kstr:x64"
}

pub fn loadAotRelocDataWordPlan() {
    return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|sym:data:0:g0:x64|relocs:reloc:data:0:0:g0:x64|relocword:0010000000000000"
}

pub fn loadAotRelocDataHexPlan() {
    20|    return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|0010000000000000|code:x64:ret|sym:data:0:g0:x64|relocs:reloc:data:0:0:g0:x64"
}

pub fn loadAotRelocRodataDataPlan() {
    return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|0010000000000000|data:rw|0010000000000000|code:x64:ret|syms:sym:rodata:0:kstr:x64;sym:data:0:g0:x64|relocs:reloc:rodata:0:0:kstr:x64;reloc:data:0:0:g0:x64"
}

/// Text offset apply plus rodata relocated word validates.
pub fn loadAotRelocRodataWordOk(nBytes) {
    if loadAotRelocTextAt40Ok(nBytes) == false {
    30|        return false
    }
    let plan = loadAotRelocRodataWordPlan()
    let target = loadAotTarget()
    return aotLoadImageWithRelocWordRodataOk(plan, target)
}

/// Rodata word plus rodata hex section validates.
pub fn loadAotRelocRodataHexOk(nBytes) {
    if loadAotRelocRodataWordOk(nBytes) == false {
    40|        return false
    }
    let plan = loadAotRelocRodataHexPlan()
    let target = loadAotTarget()
    return aotLoadImageWithRelocRodataHexOk(plan, target)
}

/// Rodata hex plus data relocated word validates.
pub fn loadAotRelocDataWordOk(nBytes) {
    if loadAotRelocRodataHexOk(nBytes) == false {
    50|        return false
    }
    let plan = loadAotRelocDataWordPlan()
    let target = loadAotTarget()
    return aotLoadImageWithRelocWordDataOk(plan, target)
}

/// Data word plus data hex section validates.
pub fn loadAotRelocDataHexOk(nBytes) {
    if loadAotRelocDataWordOk(nBytes) == false {
    60|        return false
    }
    let plan = loadAotRelocDataHexPlan()
    let target = loadAotTarget()
    return aotLoadImageWithRelocDataHexOk(plan, target)
}

/// Rodata and data hex sections both validate.
pub fn loadAotRelocRodataDataOk(nBytes) {
    if loadAotRelocDataHexOk(nBytes) == false {
    70|        return false
    }
    let plan = loadAotRelocRodataDataPlan()
    let target = loadAotTarget()
    return aotLoadImageWithRelocRodataDataHexOk(plan, target)
}
