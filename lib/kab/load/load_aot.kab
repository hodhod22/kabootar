// SH19 deepen: bootstrap AOT load policy off load.kab. import "kab/load/load_aot"
// Do not grow load.kab. Host main.rs stays until AOT bootstrap smoke completes.
// Nested call args (foo(bar(), baz())) must be locals first — module-scope binding quirk.

import "kab/load"
import "kab/load/load_img"
import "kab/aot/aot_load_image"
import "kab/noll/noll_aot"

pub fn loadAotTarget() {
    10|    return "x64"
}

pub fn loadAotImagePlan() {
    return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|sym:text:32:main:x64|reloc:text:32:0:main:x64"
}

/// True when image name + native plan validate and AOT delete-gate is still closed.
pub fn loadAotBootstrapOk(nBytes) {
    if loadReady(nBytes) == false {
    20|        return false
    }
    if loadImageName() != "compiler.kbcb" {
        return false
    }
    if nollAotReady() {
        return false
    }
    let plan = loadAotImagePlan()
    let target = loadAotTarget()
    30|    return aotLoadImageOk(plan, target)
}
