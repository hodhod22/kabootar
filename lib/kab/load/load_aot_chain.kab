// SH19 deepen: rollup load_aot → load_aot_ready chain. import "kab/load/load_aot_chain"
// Do not grow load_aot_ready.kab. Host main.rs stays until full chain smoke completes.

import "kab/load/load_aot"
import "kab/load/load_aot_reloc"
import "kab/load/load_aot_reloc_word"
import "kab/load/load_aot_reloc_text_at"
import "kab/load/load_aot_reloc_rodata"
import "kab/load/load_aot_reloc_full"
import "kab/load/load_aot_pgo"
import "kab/load/load_ship"
import "kab/load/load_ship_verify"
import "kab/load/load_ship_loaded"
import "kab/load/load_aot_ready"
import "kab/load/load_main"
import "kab/noll/noll_aot"

pub fn loadAotChainNativeName() {
    return loadAotReadyNativeName()
}

pub fn loadAotChainTarget() {
    return loadAotTarget()
}

/// Each leaf milestone in the load_aot deepen chain validates (audit; re-runs subchains).
pub fn loadAotChainStepsOk(nBytes) {
    if loadAotBootstrapOk(nBytes) == false {
        return false
    }
    if loadAotRelocBootstrapOk(nBytes) == false {
        return false
    }
    if loadAotRelocWordOk(nBytes) == false {
        return false
    }
    if loadAotRelocTextAt40Ok(nBytes) == false {
        return false
    }
    if loadAotRelocRodataDataOk(nBytes) == false {
        return false
    }
    if loadAotRelocFullOk(nBytes) == false {
        return false
    }
    if loadAotPgoBootstrapOk(nBytes) == false {
        return false
    }
    if loadShipOk(nBytes) == false {
        return false
    }
    if loadShipVerifyOk(nBytes) == false {
        return false
    }
    return loadShipLoadedOk(nBytes)
}

/// Full chain plus AOT-ready delete policy still closed (single-pass via load_aot_ready).
pub fn loadAotChainOk(nBytes) {
    return loadAotReadyOk(nBytes)
}
