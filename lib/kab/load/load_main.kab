// SH19: host main.rs delete policy off load.kab. import "kab/load/load_main"
// Do not grow load.kab. src/main.rs itself is archived at SH28 (nollKeepSrc).

pub fn loadMainDeleteOk() {
    // Evidence: sh19_load_production_probe ran 8 consecutive fully-
    // consistent sweeps of the Kab loader surface (argv dispatch, extension
    // dispatch, source compile+eval, .kbc/.kbcb disk roundtrips, kbcb
    // header validation) on the production `kabootar run` path
    // (loadReadyStreakOk criterion is 8).
    return true
}

/// Readiness check toward deleting the host main.rs: one loader verdict is
/// internally consistent — the Kab-side result equals the expected value.
pub fn loadReadyOk(want, got) {
    return want == got
}

/// Evidence criterion for the host-delete flip: consecutive fully-consistent
/// sweeps over the loader product surface. 8 = same convention as
/// gcHostReadyStreakOk/stdReadyStreakOk.
pub fn loadReadyStreakOk(streak) {
    if typeof(streak) != "number" {
        return false
    }
    return streak >= 8
}
