// SH20: collections fmod off std_colatanh.kab. import "kab/std_colfmod"
// Do not grow std_colatanh.kab. stdHostDeleteOk stays false.

pub fn stdColFmod(a, b) {
    let n = len(a)
    let nb = len(b)
    if nb < n {
        n = nb
    }
    let out = []
    let i = 0
    while i < n {
        out = push(out, fmod(a[i], b[i]))
        i = i + 1
    }
    return out
}
