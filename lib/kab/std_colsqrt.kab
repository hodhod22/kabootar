// SH20: collections sqrt off std_colpow.kab. import "kab/std_colsqrt"
// Do not grow std_colpow.kab. stdHostDeleteOk stays false.

pub fn stdColSqrt(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, sqrt(a[i]))
        i = i + 1
    }
    return out
}
