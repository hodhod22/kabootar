// SH17 deepen: guest store for loop-mod template. import "kab/jit_mm_store_loop_mod"
// Do not grow jit_mm_store_loop_div.kab.

import "kab/jit_mm_loop_mod"
import "kab/jit_loop_mod"

pub fn jitMmStoreLoopMod(bytes, n, r) {
    if jitLoopModOk(n, r) == false {
        return 0
    }
    if len(bytes) != jitLoopModLen() {
        return 0
    }
    let pid = jitMmLoopModPid()
    let virt = jitMmLoopModVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
