// SH17 deepen: loop-ge guest mmap args. import "kab/jit_mm_loop_ge"
// Do not grow jit_mm_loop_le.kab. Separate virt slot from loop-le.

import "kab/jit_loop_ge"

pub fn jitMmLoopGePid() {
    return 1
}

pub fn jitMmLoopGeVirt() {
    return 565248
}

pub fn jitMmLoopGeLen() {
    return 4096
}

pub fn jitMmLoopGeProt() {
    return 7
}

pub fn jitOsMmapLoopGeOk(nBytes, kind, n, k) {
    if jitLoopGeOk(n, k) == false {
        return false
    }
    if nBytes != jitLoopGeLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopGeLen() != 4096 {
        return false
    }
    if jitMmLoopGeProt() != 7 {
        return false
    }
    return true
}
