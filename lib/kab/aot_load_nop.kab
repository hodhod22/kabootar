// F10: loader accepts only a documented first-image nop opcode.
// import "kab/aot_load_nop"; do not import other kab/aot* leaves.

pub fn aotLoadNopOk(op, target) {
    if target == "x64" {
        return op == "90"
    }
    if target == "arm64" {
        return op == "d503201f"
    }
    return false
}
