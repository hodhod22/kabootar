// SH17 deepen: validate i64 loop-gt template. import "kab/jit_patch_loop_gt"
// Do not grow jit_patch_loop_lt.kab.

import "kab/jit_loop_gt"
import "kab/jit_check"

pub fn jitPatchLoopGtOk(bytes, n, k) {
    if jitLoopGtOk(n, k) == false {
        return false
    }
    let tpl = jitEmitI64LoopGtN(n, k)
    if len(bytes) != jitLoopGtLen() {
        return false
    }
    if len(tpl) != jitLoopGtLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
