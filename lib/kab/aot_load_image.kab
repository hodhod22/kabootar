// F10: loader validates a first Kab-native image (plan plus return stub).
// import "kab/aot_load_image"; do not import other kab/aot* leaves.

pub fn aotLoadImageOk(image, target) {
    if target == "x64" {
        if image == "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|sym:text:32:main:x64|reloc:text:32:0:main:x64" {
            return true
        }
        return image == "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|sym:text:32:main:x64|reloc:text:32:8:main:x64"
    }
    if target == "arm64" {
        if image == "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|sym:text:32:main:arm64|reloc:text:32:0:main:arm64" {
            return true
        }
        return image == "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|sym:text:32:main:arm64|reloc:text:32:8:main:arm64"
    }
    return false
}

