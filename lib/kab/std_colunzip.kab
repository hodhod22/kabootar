// SH20: collections unzip off std_colzip.kab. import "kab/std_colunzip"
// Do not grow std_colzip.kab. stdHostDeleteOk stays false.

pub fn stdColUnzip(z) {
    let left = []
    let right = []
    let n = len(z)
    let i = 0
    while i < n {
        let row = z[i]
        left = push(left, row[0])
        right = push(right, row[1])
        i = i + 1
    }
    let out = []
    out = push(out, left)
    out = push(out, right)
    return out
}
