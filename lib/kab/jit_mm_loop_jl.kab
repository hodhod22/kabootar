// SH17 deepen: loop-jl guest mmap args. import "kab/jit_mm_loop_jl"
// Do not grow jit_mm_loop_jmp.kab. Separate virt slot from loop-jmp.

import "kab/jit_loop_jl"

pub fn jitMmLoopJlPid() {
    return 1
}

pub fn jitMmLoopJlVirt() {
    return 606208
}

pub fn jitMmLoopJlLen() {
    return 4096
}

pub fn jitMmLoopJlProt() {
    return 7
}

pub fn jitOsMmapLoopJlOk(nBytes, kind, n, k) {
    if jitLoopJlOk(n, k) == false {
        return false
    }
    if nBytes != jitLoopJlLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopJlLen() != 4096 {
        return false
    }
    if jitMmLoopJlProt() != 7 {
        return false
    }
    return true
}
