// SH17 deepen: guest store for loop-neg template. import "kab/jit_mm_store_loop_neg"
// Do not grow jit_mm_store_loop_not.kab.

import "kab/jit_mm_loop_neg"
import "kab/jit_loop_neg"

pub fn jitMmStoreLoopNeg(bytes, n) {
    if jitLoopNegOk(n) == false {
        return 0
    }
    if len(bytes) != jitLoopNegLen() {
        return 0
    }
    let pid = jitMmLoopNegPid()
    let virt = jitMmLoopNegVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
