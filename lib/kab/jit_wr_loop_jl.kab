// SH17 deepen: translate+store for loop-jl template. import "kab/jit_wr_loop_jl"
// Do not grow jit_wr_loop_jmp.kab.

import "kab/jit_patch_loop_jl"
import "kab/jit_mm_loop_jl"
import "kab/jit_mm_store_loop_jl"
import "kab/jit_loop_jl"

pub fn jitWrLoopJlOk(bytes, n, k) {
    if jitPatchLoopJlOk(bytes, n, k) == false {
        return false
    }
    let pid = jitMmLoopJlPid()
    let virt = jitMmLoopJlVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopJl(bytes, n, k)
    if w != jitLoopJlLen() {
        return false
    }
    return true
}
