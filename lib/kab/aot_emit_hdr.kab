// F10: emit a stable Kab-native image header for a supported target.
// import "kab/aot_emit_hdr"; do not import other kab/aot* leaves.

pub fn aotEmitHeader(target) {
    if target == "x64" {
        return "kabootar-native/1:x64"
    }
    if target == "arm64" {
        return "kabootar-native/1:arm64"
    }
    return ""
}
