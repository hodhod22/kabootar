// SH17 deepen: i64 loopN + sub-imm template. import "kab/jit_loop_sub"
// Do not grow jit_loop_add.kab. Magic L + count N + sub S + ret; os_mm_call returns N-S.

import "kab/jit_loop_n"

pub fn jitLoopSubSMax() {
    return 64
}

pub fn jitLoopSubSOk(n, s) {
    if s <= 0 {
        return false
    }
    if s > jitLoopSubSMax() {
        return false
    }
    if s >= n {
        return false
    }
    return true
}

pub fn jitLoopSubOk(n, s) {
    if jitLoopNOk(n) == false {
        return false
    }
    if jitLoopSubSOk(n, s) == false {
        return false
    }
    return true
}

pub fn jitLoopSubRax(n, s) {
    return n - s
}

pub fn jitLoopSubLen() {
    return jitLoopNLen()
}

/// Loop marker 76, count n, add 0, sub s, pad, ret — simulated guest rax=n-s.
pub fn jitEmitI64LoopSubN(n, s) {
    let b = []
    b = push(b, 76)
    b = push(b, n)
    b = push(b, 0)
    b = push(b, s)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 195)
    return b
}
