// SH18 deepen: concurrent mark under repeated load frames. import "kab/gc_concurrent"
// Do not grow gc_stress.kab. Mark slices each frame without host GC heap.

import "kab/gc_stress"
import "kab/gc_load"
import "kab/gc"
import "kab/gc_bar"

pub fn gcConcurrentMarkDepth() {
    return 2
}

/// Concurrent mark slices gray objects within frame budget after write barrier.
pub fn gcConcurrentMarkOk(live) {
    if gcWriteBarrier(1, 2) == false {
        return false
    }
    let depth = gcConcurrentMarkDepth()
    let budget = gcFrameBudgetMs()
    let g0 = live + depth
    let g1 = gcLoadMarkStep(g0, budget)
    if g1 != live + depth - 1 {
        return false
    }
    let g2 = gcLoadMarkStep(g1, budget)
    if g2 != live {
        return false
    }
    return true
}

/// Stress cycles plus concurrent mark pass under frame budget.
pub fn gcConcurrentOk(live) {
    if gcStressCyclesOk(live) == false {
        return false
    }
    return gcConcurrentMarkOk(live)
}
