// SH17 deepen: loop-and wr+run+call pipeline. import "kab/jit_call_loop_and"
// Do not grow jit_call_loop_mod.kab.

import "kab/jit_wr_loop_and"
import "kab/jit_run_loop_and"
import "kab/jit_mm_call_loop_and"
import "kab/jit_loop_and"

pub fn jitCallLoopAndOk(base, kind, n, mask, bytes) {
    if jitLoopAndOk(n, mask) == false {
        return false
    }
    if jitWrLoopAndOk(bytes, n, mask) == false {
        return false
    }
    if jitRunLoopAndOk(base, kind, bytes, n, mask) == false {
        return false
    }
    let rax = jitMmCallLoopAnd(bytes, n, mask)
    if rax != jitLoopAndRax(n, mask) {
        return false
    }
    return true
}
