// SH20: collections find-last off std_colfind.kab. import "kab/std_colrfind"
// Do not grow std_colfind.kab. stdHostDeleteOk stays false.

pub fn stdColFindLast(p, x) {
    let n = len(p)
    let i = n
    while i > 0 {
        i = i - 1
        if p[i] == x {
            return p[i]
        }
    }
    return 0 - 1
}
