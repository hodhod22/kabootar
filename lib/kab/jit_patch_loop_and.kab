// SH17 deepen: validate i64 loop-and template. import "kab/jit_patch_loop_and"
// Do not grow jit_patch_loop_mod.kab.

import "kab/jit_loop_and"
import "kab/jit_check"

pub fn jitPatchLoopAndOk(bytes, n, mask) {
    if jitLoopAndOk(n, mask) == false {
        return false
    }
    let tpl = jitEmitI64LoopAndN(n, mask)
    if len(bytes) != jitLoopAndLen() {
        return false
    }
    if len(tpl) != jitLoopAndLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
