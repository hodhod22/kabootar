// F10: loader accepts only RX text plus one then add then nop then return.
// import "kab/aot_load_text"; do not import other kab/aot* leaves.

pub fn aotLoadTextOk(text, target) {
    if target == "x64" {
        return text == "text:rx|b80100000001c090c3"
    }
    if target == "arm64" {
        return text == "text:rx|d28000208b000000d503201fd65f03c0"
    }
    return false
}
