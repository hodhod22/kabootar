// F10: loader accepts only RX text plus a documented return opcode.
// import "kab/aot_load_text"; do not import other kab/aot* leaves.

pub fn aotLoadTextOk(text, target) {
    if target == "x64" {
        return text == "text:rx|c3"
    }
    if target == "arm64" {
        return text == "text:rx|d65f03c0"
    }
    return false
}
