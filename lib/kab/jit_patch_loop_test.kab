// SH17 deepen: validate i64 loop-test template. import "kab/jit_patch_loop_test"
// Do not grow jit_patch_loop_ge.kab.

import "kab/jit_loop_test"
import "kab/jit_check"

pub fn jitPatchLoopTestOk(bytes, n, k) {
    if jitLoopTestOk(n, k) == false {
        return false
    }
    let tpl = jitEmitI64LoopTestN(n, k)
    if len(bytes) != jitLoopTestLen() {
        return false
    }
    if len(tpl) != jitLoopTestLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
