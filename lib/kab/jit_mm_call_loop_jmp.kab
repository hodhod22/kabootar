// SH17 deepen: guest call for loop-jmp template. import "kab/jit_mm_call_loop_jmp"
// Do not grow jit_mm_call_loop_jne.kab.

import "kab/jit_mm_loop_jmp"
import "kab/jit_loop_jmp"

pub fn jitMmCallLoopJmp(bytes, n, k) {
    if jitLoopJmpOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopJmpLen() {
        return 0
    }
    let pid = jitMmLoopJmpPid()
    let virt = jitMmLoopJmpVirt()
    let rax = os_mm_call(pid, virt)
    if rax != jitLoopJmpRax(n, k) {
        return 0
    }
    return rax
}
