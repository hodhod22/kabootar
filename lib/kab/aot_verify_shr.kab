// F10: native image filename and shr opcode must agree.
// import "kab/aot_verify_shr"; do not import other kab/aot* leaves.

pub fn aotVerifyShrOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "d1e8"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "d341fc00"
    }
    return false
}
