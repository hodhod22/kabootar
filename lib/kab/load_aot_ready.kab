// SH19 deepen: AOT-ready policy off full ship/load chain. import "kab/load_aot_ready"
// Do not grow load_ship_loaded.kab. nollAotReady stays false until host src/ delete is safe.

import "kab/load_ship"
import "kab/load_ship_loaded"
import "kab/load_main"
import "kab/noll_aot"
import "kab/noll_keep"

pub fn loadAotReadyNativeName() {
    return loadShipNativeName()
}

/// True while nollAotReady is still closed (must stay false before src/ delete).
pub fn loadAotReadyGateClosed() {
    if nollAotReady() {
        return false
    }
    return true
}

/// Full loaded cycles pass; AOT-ready and main delete gates still closed; src/ kept.
pub fn loadAotReadyOk(nBytes) {
    if loadShipLoadedOk(nBytes) == false {
        return false
    }
    if loadAotReadyGateClosed() == false {
        return false
    }
    if nollKeepSrc() == false {
        return false
    }
    return loadMainDeleteOk() == false
}
