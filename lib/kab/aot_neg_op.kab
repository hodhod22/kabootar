// F10: first Kab-native images emit a documented neg opcode for the return register.
// import "kab/aot_neg_op"; do not import other kab/aot* leaves.

pub fn aotNegOp(target) {
    if target == "x64" {
        return "f7d8"
    }
    if target == "arm64" {
        return "cb0003e0"
    }
    return ""
}
