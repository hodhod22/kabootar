// SH17 deepen: guest store for loop-le template. import "kab/jit_mm_store_loop_le"
// Do not grow jit_mm_store_loop_gt.kab.

import "kab/jit_mm_loop_le"
import "kab/jit_loop_le"

pub fn jitMmStoreLoopLe(bytes, n, k) {
    if jitLoopLeOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopLeLen() {
        return 0
    }
    let pid = jitMmLoopLePid()
    let virt = jitMmLoopLeVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
