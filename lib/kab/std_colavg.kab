// SH20: collections average off std_colprod.kab. import "kab/std_colavg"
// Do not grow std_colprod.kab. stdHostDeleteOk stays false.

pub fn stdColAvg(p) {
    let n = len(p)
    if n == 0 {
        return 0
    }
    let s = 0
    let i = 0
    while i < n {
        s = s + p[i]
        i = i + 1
    }
    return s / n
}
