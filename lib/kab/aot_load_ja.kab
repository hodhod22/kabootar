// F10: loader accepts only a documented first-image ja opcode.
// import "kab/aot_load_ja"; do not import other kab/aot* leaves.

pub fn aotLoadJaOk(op, target) {
    if target == "x64" {
        return op == "7700"
    }
    if target == "arm64" {
        return op == "54000008"
    }
    return false
}
