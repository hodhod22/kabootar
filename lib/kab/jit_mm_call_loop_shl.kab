// SH17 deepen: guest call for loop-shl template. import "kab/jit_mm_call_loop_shl"
// Do not grow jit_mm_call_loop_xor.kab.

import "kab/jit_mm_loop_shl"
import "kab/jit_loop_shl"

pub fn jitMmCallLoopShl(bytes, n, sh) {
    if jitLoopShlOk(n, sh) == false {
        return 0
    }
    if len(bytes) != jitLoopShlLen() {
        return 0
    }
    let pid = jitMmLoopShlPid()
    let virt = jitMmLoopShlVirt()
    let rax = os_mm_call(pid, virt)
    if rax != jitLoopShlRax(n, sh) {
        return 0
    }
    return rax
}
