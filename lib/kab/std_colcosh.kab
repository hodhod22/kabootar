// SH20: collections cosh off std_colsinh.kab. import "kab/std_colcosh"
// Do not grow std_colsinh.kab. stdHostDeleteOk stays false.

pub fn stdColCosh(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, cosh(a[i]))
        i = i + 1
    }
    return out
}
