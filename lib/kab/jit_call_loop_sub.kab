// SH17 deepen: loop-sub wr+run+call pipeline. import "kab/jit_call_loop_sub"
// Do not grow jit_call_loop_add.kab.

import "kab/jit_wr_loop_sub"
import "kab/jit_run_loop_sub"
import "kab/jit_mm_call_loop_sub"
import "kab/jit_loop_sub"

pub fn jitCallLoopSubOk(base, kind, n, s, bytes) {
    if jitLoopSubOk(n, s) == false {
        return false
    }
    if jitWrLoopSubOk(bytes, n, s) == false {
        return false
    }
    if jitRunLoopSubOk(base, kind, bytes, n, s) == false {
        return false
    }
    let r = jitMmCallLoopSub(bytes, n, s)
    if r != jitLoopSubRax(n, s) {
        return false
    }
    return true
}
