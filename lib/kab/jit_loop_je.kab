// SH17 deepen: i64 loopN + je template. import "kab/jit_loop_je"
// Do not grow jit_loop_test.kab. Magic 92 + n + k + ret; os_mm_call returns 1 iff n==k.

import "kab/jit_loop_n"

pub fn jitLoopJeKMax() {
    return 64
}

pub fn jitLoopJeKOk(k) {
    if k <= 0 {
        return false
    }
    if k > jitLoopJeKMax() {
        return false
    }
    return true
}

pub fn jitLoopJeOk(n, k) {
    if jitLoopNOk(n) == false {
        return false
    }
    if jitLoopJeKOk(k) == false {
        return false
    }
    return true
}

pub fn jitLoopJeRax(n, k) {
    if n == k {
        return 1
    }
    return 0
}

pub fn jitLoopJeLen() {
    return jitLoopNLen()
}

/// Loop marker 92, count n, rhs k, pad, ret — simulated guest rax=1 iff n==k (je taken).
pub fn jitEmitI64LoopJeN(n, k) {
    let b = []
    b = push(b, 92)
    b = push(b, n)
    b = push(b, k)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 195)
    return b
}
