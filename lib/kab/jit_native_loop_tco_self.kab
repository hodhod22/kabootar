// F8 deepen: native i64-loop + TCO self-recursion. import "kab/jit_native_loop_tco_self"
// Do not grow jit_native_loop_tco.kab. Known self-call required for frame reuse.

import "kab/jit_native_loop_tco"
import "kab/jit_tco_self"

pub fn jitNativeLoopTcoSelfOk(nPhi, nInv, nDup, nGuard, kind, marked, same, n) {
    if jitNativeLoopTcoOk(nPhi, nInv, nDup, nGuard, kind, marked, n) == false {
        return false
    }
    if jitTcoSelfOk(same) == false {
        return false
    }
    return true
}
