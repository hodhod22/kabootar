// SH20: collections pop off std_colpush.kab. import "kab/std_colpop"
// Do not grow std_colpush.kab. stdHostDeleteOk stays false.
// Rebuild without last slot via push; do not use object_array_pop.

pub fn stdColPop(p) {
    let n = len(p)
    if n == 0 {
        return p
    }
    let out = []
    let i = 0
    let last = n - 1
    while i < last {
        out = push(out, p[i])
        i = i + 1
    }
    return out
}
