// SH17 deepen: translate+store for loop-jge template. import "kab/jit_wr_loop_jge"
// Do not grow jit_wr_loop_jg.kab.

import "kab/jit_patch_loop_jge"
import "kab/jit_mm_loop_jge"
import "kab/jit_mm_store_loop_jge"
import "kab/jit_loop_jge"

pub fn jitWrLoopJgeOk(bytes, n, k) {
    if jitPatchLoopJgeOk(bytes, n, k) == false {
        return false
    }
    let pid = jitMmLoopJgePid()
    let virt = jitMmLoopJgeVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopJge(bytes, n, k)
    if w != jitLoopJgeLen() {
        return false
    }
    return true
}
