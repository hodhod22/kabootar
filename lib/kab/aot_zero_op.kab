// F10: first Kab-native images emit a documented integer-zero opcode for the return register.
// import "kab/aot_zero_op"; do not import other kab/aot* leaves.

pub fn aotZeroOp(target) {
    if target == "x64" {
        return "31c0"
    }
    if target == "arm64" {
        return "aa1f03e0"
    }
    return ""
}
