// SH17 deepen: loop-eq guest mmap args. import "kab/jit_mm_loop_eq"
// Do not grow jit_mm_loop_neg.kab. Separate virt slot from loop-neg.

import "kab/jit_loop_eq"

pub fn jitMmLoopEqPid() {
    return 1
}

pub fn jitMmLoopEqVirt() {
    return 524288
}

pub fn jitMmLoopEqLen() {
    return 4096
}

pub fn jitMmLoopEqProt() {
    return 7
}

pub fn jitOsMmapLoopEqOk(nBytes, kind, n, k) {
    if jitLoopEqOk(n, k) == false {
        return false
    }
    if nBytes != jitLoopEqLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopEqLen() != 4096 {
        return false
    }
    if jitMmLoopEqProt() != 7 {
        return false
    }
    return true
}
