// SH17 deepen: mmap+exec policy for loop-jl template. import "kab/jit_run_loop_jl"
// Do not grow jit_run_loop_jmp.kab.

import "kab/jit_mmap_loop"
import "kab/jit_np"
import "kab/jit_exec"
import "kab/jit_mm_loop_jl"
import "kab/jit_patch_loop_jl"
import "kab/jit_loop_jl"

pub fn jitRunLoopJlOk(base, kind, bytes, n, k) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopJlOk(bytes, n, k) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopJlOk(nb, kind, n, k) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
