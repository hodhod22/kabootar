// F10: persisted layout bytes must match first native RX/R/RW concatenation.
// import "kab/aot_loaded_layout"; do not import other kab/aot* leaves.

pub fn aotLoadedLayoutOk(layout) {
    if layout == "text:rx|c3||rodata:r|00||data:rw|00" {
        return true
    }
    if layout == "text:rx|d65f03c0||rodata:r|00||data:rw|00" {
        return true
    }
    return false
}
