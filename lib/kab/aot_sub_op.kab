// F10: first Kab-native images emit a documented sub opcode for the return register.
// import "kab/aot_sub_op"; do not import other kab/aot* leaves.

pub fn aotSubOp(target) {
    if target == "x64" {
        return "29c0"
    }
    if target == "arm64" {
        return "cb000000"
    }
    return ""
}
