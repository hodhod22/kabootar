// SH17 deepen: i64 loopN + ge template. import "kab/jit_loop_ge"
// Do not grow jit_loop_le.kab. Magic Z + n + k + ret; os_mm_call returns 1 iff n>=k.

import "kab/jit_loop_n"

pub fn jitLoopGeKMax() {
    return 64
}

pub fn jitLoopGeKOk(k) {
    if k <= 0 {
        return false
    }
    if k > jitLoopGeKMax() {
        return false
    }
    return true
}

pub fn jitLoopGeOk(n, k) {
    if jitLoopNOk(n) == false {
        return false
    }
    if jitLoopGeKOk(k) == false {
        return false
    }
    return true
}

pub fn jitLoopGeRax(n, k) {
    if n > k {
        return 1
    }
    if n == k {
        return 1
    }
    return 0
}

pub fn jitLoopGeLen() {
    return jitLoopNLen()
}

/// Loop marker 90, count n, rhs k, pad, ret — simulated guest rax=1 iff n>=k.
pub fn jitEmitI64LoopGeN(n, k) {
    let b = []
    b = push(b, 90)
    b = push(b, n)
    b = push(b, k)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 195)
    return b
}
