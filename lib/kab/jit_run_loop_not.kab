// SH17 deepen: mmap+exec policy for loop-not template. import "kab/jit_run_loop_not"
// Do not grow jit_run_loop_ushr.kab.

import "kab/jit_mmap_loop"
import "kab/jit_np"
import "kab/jit_exec"
import "kab/jit_mm_loop_not"
import "kab/jit_patch_loop_not"
import "kab/jit_loop_not"

pub fn jitRunLoopNotOk(base, kind, bytes, n) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopNotOk(bytes, n) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopNotOk(nb, kind, n) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
