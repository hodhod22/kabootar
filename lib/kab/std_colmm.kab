// SH20: collections mat-mul off std_colmv.kab. import "kab/std_colmm"
// Do not grow std_colmv.kab. stdHostDeleteOk stays false.

import "kab/std_coltr"
import "kab/std_colmv"

pub fn stdColMatMul(a, b) {
    let bt = stdColTranspose(b)
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        let row = a[i]
        out = push(out, stdColMatVec(bt, row))
        i = i + 1
    }
    return out
}
