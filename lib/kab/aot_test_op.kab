// F10: first Kab-native images emit a documented test opcode for the return register.
// import "kab/aot_test_op"; do not import other kab/aot* leaves.

pub fn aotTestOp(target) {
    if target == "x64" {
        return "85c0"
    }
    if target == "arm64" {
        return "ea00001f"
    }
    return ""
}
