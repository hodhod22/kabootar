// SH20: collections dot off std_colrshp.kab. import "kab/std_coldot"
// Do not grow std_colrshp.kab. stdHostDeleteOk stays false.

pub fn stdColDot(a, b) {
    let na = len(a)
    let nb = len(b)
    let n = na
    if nb < n {
        n = nb
    }
    let s = 0
    let i = 0
    while i < n {
        s = s + a[i] * b[i]
        i = i + 1
    }
    return s
}
