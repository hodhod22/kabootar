// SH17 deepen: loopN guest mmap args. import "kab/jit_mm_loop_n"
// Do not grow jit_mm_loop.kab. Separate virt slot from loop8.

import "kab/jit_loop_n"

pub fn jitMmLoopNPid() {
    return 1
}

pub fn jitMmLoopNVirt() {
    return 409600
}

pub fn jitMmLoopNLen() {
    return 4096
}

pub fn jitMmLoopNProt() {
    return 7
}

pub fn jitOsMmapLoopNOk(nBytes, kind, n) {
    if jitLoopNOk(n) == false {
        return false
    }
    if nBytes != jitLoopNLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopNLen() != 4096 {
        return false
    }
    if jitMmLoopNProt() != 7 {
        return false
    }
    return true
}
