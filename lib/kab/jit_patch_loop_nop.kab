// SH17 deepen: validate i64 loop-nop template. import "kab/jit_patch_loop_nop"
// Do not grow jit_patch_loop_jge.kab.

import "kab/jit_loop_nop"
import "kab/jit_check"

pub fn jitPatchLoopNopOk(bytes, n, k) {
    if jitLoopNopOk(n, k) == false {
        return false
    }
    let tpl = jitEmitI64LoopNopN(n, k)
    if len(bytes) != jitLoopNopLen() {
        return false
    }
    if len(tpl) != jitLoopNopLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
