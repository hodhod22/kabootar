// SH17 deepen: translate+store for loopN template. import "kab/jit_wr_loop_n"
// Do not grow jit_wr_loop.kab.

import "kab/jit_patch_loop_n"
import "kab/jit_mm_loop_n"
import "kab/jit_mm_store_loop_n"
import "kab/jit_loop_n"

pub fn jitWrLoopNOk(bytes, n) {
    if jitPatchLoopNOk(bytes, n) == false {
        return false
    }
    let pid = jitMmLoopNPid()
    let virt = jitMmLoopNVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopN(bytes, n)
    if w != jitLoopNLen() {
        return false
    }
    return true
}
