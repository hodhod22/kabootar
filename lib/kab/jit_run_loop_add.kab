// SH17 deepen: mmap+exec policy for loop-add template. import "kab/jit_run_loop_add"
// Do not grow jit_run_loop_n.kab.

import "kab/jit_mmap_loop"
import "kab/jit_np"
import "kab/jit_exec"
import "kab/jit_mm_loop_add"
import "kab/jit_patch_loop_add"
import "kab/jit_loop_add"

pub fn jitRunLoopAddOk(base, kind, bytes, n, k) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopAddOk(bytes, n, k) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopAddOk(nb, kind, n, k) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
