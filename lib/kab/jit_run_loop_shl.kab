// SH17 deepen: mmap+exec policy for loop-shl template. import "kab/jit_run_loop_shl"
// Do not grow jit_run_loop_xor.kab.

import "kab/jit_mmap_loop"
import "kab/jit_np"
import "kab/jit_exec"
import "kab/jit_mm_loop_shl"
import "kab/jit_patch_loop_shl"
import "kab/jit_loop_shl"

pub fn jitRunLoopShlOk(base, kind, bytes, n, sh) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopShlOk(bytes, n, sh) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopShlOk(nb, kind, n, sh) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
