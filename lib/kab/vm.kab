@version "1.0.0"

// H6e hard path: Kab VM first; host bytecode_run_kbc only as soft fallback.
// KABOOTAR_VM=kab-only → Rust eval_program calls evalKbcKabOnly (no host VM).
// KEEP <=~7 top-level pub fn.

import "kab/boot"
import "self_host/deserialize"
import "self_host/vm"
import "self_host/compile"

let kabVmRunPrefer = true
let kabVmRunCached = false
let kabVmRunOk = false

fn refreshKabVmRunOk() {
    kabVmRunOk = kabVmCoreOk()
    kabVmRunCached = true
}

fn kabVmCoreOk() {
    let n = evalSourceKabVm("return 40 + 2")
    let callOk = evalSourceKabVm("fn add(a, b) { return a + b }; return add(1, 2)") == 3
    let nativeOk = evalSourceKabVm("return len([1, 2, 3])") == 3
    let classOk = evalSourceKabVm("class Box { fn init(n) { this.n = n } } return Box(7).n") == 7
    let arithOk = evalSourceKabVm("return 3 * 4 + 2") == 14
    let unaryOk = evalSourceKabVm("return !false && -3 + 5 == 2") == true
    let orOk = evalSourceKabVm("return false || 9") == 9
    return n == 42 && callOk && nativeOk && classOk && arithOk && unaryOk && orOk
}

fn tryKabVm(kbc) {
    let bc = deserializeKbc(kbc)
    return runModule(bc)
}

/// Prefer Kab VM for `run_file` / evalKbc when pipeline is ok.
pub fn preferKabVmRun() {
    kabVmRunPrefer = true
    return true
}

/// Policy gate (Rust `eval_program` calls this once per process).
pub fn kabVmRunEnabled() {
    if !kabVmRunPrefer {
        return false
    }
    if !kabVmRunCached {
        refreshKabVmRunOk()
    }
    return kabVmRunOk
}

/// Kab-only `.kbc` run — no host VM fallback (H6e / KABOOTAR_VM=kab-only).
pub fn evalKbcKabOnly(kbc) {
    let s = "" + kbc
    if len(s) > 262144 {
        throw "evalKbcKabOnly: .kbc exceeds 256KB"
    }
    return tryKabVm(kbc)
}

/// Run `.kbc` — Kab VM when possible.
/// Healthy prefer path: kab-only (no `bytecode_run_kbc`). Soft fallback only while probe cold/failed.
pub fn evalKbc(kbc) {
    let s = "" + kbc
    if len(s) > 262144 {
        return bytecode_run_kbc(kbc)
    }
    if kabVmRunPrefer {
        if !kabVmRunCached {
            refreshKabVmRunOk()
        }
        if kabVmRunOk {
            return tryKabVm(kbc)
        }
    }
    let kab = null
    let err = null
    try {
        kab = tryKabVm(kbc)
    } catch (e) {
        err = e
    }
    if err == null {
        return kab
    }
    return bytecode_run_kbc(kbc)
}

/// Kab-only: compile IR + runModule (no host VM).
pub fn evalSourceKabVm(source) {
    return runModule(compileIr(source))
}

pub fn evalKbcPipelineOk() {
    let n = evalKbcKabOnly(bootCompile("return 40 + 2"))
    return n == 42 && isBytecode(bootCompile("return 1"))
}

pub fn evalKabVmPipelineOk() {
    let core = kabVmCoreOk()
    let objOk = evalSourceKabVm("let o = { \"x\": 7 }; return o[\"x\"]") == 7
    let arrOk = evalSourceKabVm("let a = [10, 20]; return a[1]") == 20
    let ifOk = evalSourceKabVm("if 1 < 2 { return 9 } else { return 0 }") == 9
    let classOk = evalKbcKabOnly(bootCompile("class Box { fn init(n) { this.n = n } } return Box(7).n")) == 7
    let kbcPath = evalKbcKabOnly(bootCompile("return 21 + 21")) == 42
    let arithKbc = evalKbcKabOnly(bootCompile("return (2 * 3) ** 2 + 1")) == 37
    let unaryKbc = evalKbcKabOnly(bootCompile("return !false")) == true
    return core && objOk && arrOk && ifOk && classOk && kbcPath && arithKbc && unaryKbc
}
