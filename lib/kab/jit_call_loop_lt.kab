// SH17 deepen: loop-lt wr+run+call pipeline. import "kab/jit_call_loop_lt"
// Do not grow jit_call_loop_ne.kab.

import "kab/jit_wr_loop_lt"
import "kab/jit_run_loop_lt"
import "kab/jit_mm_call_loop_lt"
import "kab/jit_loop_lt"

pub fn jitCallLoopLtOk(base, kind, n, k, bytes) {
    if jitLoopLtOk(n, k) == false {
        return false
    }
    if jitWrLoopLtOk(bytes, n, k) == false {
        return false
    }
    if jitRunLoopLtOk(base, kind, bytes, n, k) == false {
        return false
    }
    let rax = jitMmCallLoopLt(bytes, n, k)
    if rax != jitLoopLtRax(n, k) {
        return false
    }
    return true
}
