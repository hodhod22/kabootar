// SH17 deepen: i64 loopN + jg template. import "kab/jit_loop_jg"
// Do not grow jit_loop_jle.kab. Magic 97 + n + k + ret; os_mm_call returns 1 iff n>k.

import "kab/jit_loop_n"

pub fn jitLoopJgKMax() {
    return 64
}

pub fn jitLoopJgKOk(k) {
    if k <= 0 {
        return false
    }
    if k > jitLoopJgKMax() {
        return false
    }
    return true
}

pub fn jitLoopJgOk(n, k) {
    if jitLoopNOk(n) == false {
        return false
    }
    if jitLoopJgKOk(k) == false {
        return false
    }
    return true
}

pub fn jitLoopJgRax(n, k) {
    if n > k {
        return 1
    }
    return 0
}

pub fn jitLoopJgLen() {
    return jitLoopNLen()
}

/// Loop marker 97, count n, rhs k, pad, ret — simulated guest rax=1 iff n>k (jg taken).
pub fn jitEmitI64LoopJgN(n, k) {
    let b = []
    b = push(b, 97)
    b = push(b, n)
    b = push(b, k)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 195)
    return b
}
