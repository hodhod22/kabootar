// SH17 deepen: guest call for loop-div template. import "kab/jit_mm_call_loop_div"
// Do not grow jit_mm_call_loop_mul.kab.

import "kab/jit_mm_loop_div"
import "kab/jit_loop_div"

pub fn jitMmCallLoopDiv(bytes, n, d) {
    if jitLoopDivOk(n, d) == false {
        return 0
    }
    if len(bytes) != jitLoopDivLen() {
        return 0
    }
    let pid = jitMmLoopDivPid()
    let virt = jitMmLoopDivVirt()
    let r = os_mm_call(pid, virt)
    if r != jitLoopDivRax(n, d) {
        return 0
    }
    return r
}
