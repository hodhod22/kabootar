// SH17 deepen: translate+store for loop-ge template. import "kab/jit_wr_loop_ge"
// Do not grow jit_wr_loop_le.kab.

import "kab/jit_patch_loop_ge"
import "kab/jit_mm_loop_ge"
import "kab/jit_mm_store_loop_ge"
import "kab/jit_loop_ge"

pub fn jitWrLoopGeOk(bytes, n, k) {
    if jitPatchLoopGeOk(bytes, n, k) == false {
        return false
    }
    let pid = jitMmLoopGePid()
    let virt = jitMmLoopGeVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopGe(bytes, n, k)
    if w != jitLoopGeLen() {
        return false
    }
    return true
}
