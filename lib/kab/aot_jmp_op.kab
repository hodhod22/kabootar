// F10: first Kab-native images emit a documented jmp opcode for the return register.
// import "kab/aot_jmp_op"; do not import other kab/aot* leaves.

pub fn aotJmpOp(target) {
    if target == "x64" {
        return "e900000000"
    }
    if target == "arm64" {
        return "14000000"
    }
    return ""
}
