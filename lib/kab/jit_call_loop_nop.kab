// SH17 deepen: loop-nop wr+run+call pipeline. import "kab/jit_call_loop_nop"
// Do not grow jit_call_loop_jge.kab.

import "kab/jit_wr_loop_nop"
import "kab/jit_run_loop_nop"
import "kab/jit_mm_call_loop_nop"
import "kab/jit_loop_nop"

pub fn jitCallLoopNopOk(base, kind, n, k, bytes) {
    if jitLoopNopOk(n, k) == false {
        return false
    }
    if jitWrLoopNopOk(bytes, n, k) == false {
        return false
    }
    if jitRunLoopNopOk(base, kind, bytes, n, k) == false {
        return false
    }
    let rax = jitMmCallLoopNop(bytes, n, k)
    if rax != jitLoopNopRax(n, k) {
        return false
    }
    return true
}
