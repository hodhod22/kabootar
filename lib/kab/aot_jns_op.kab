// F10: first Kab-native images emit a documented jns opcode for the return register.
// import "kab/aot_jns_op"; do not import other kab/aot* leaves.

pub fn aotJnsOp(target) {
    if target == "x64" {
        return "7900"
    }
    if target == "arm64" {
        return "54000005"
    }
    return ""
}
