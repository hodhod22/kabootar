// F10: native image is shippable only when name, payload, and target agree.
// import "kab/aot_ship_native"; do not import other kab/aot* leaves.

pub fn aotShipNativeOk(name, image, target) {
    if target == "x64" {
        return name == "kabootar-x64.kbn" && image == "kabootar-native/1|x64||text:rx|b80100000001c090c3||rodata:r|00||data:rw|00"
    }
    if target == "arm64" {
        return name == "kabootar-arm64.kbn" && image == "kabootar-native/1|arm64||text:rx|d28000208b000000d503201fd65f03c0||rodata:r|00||data:rw|00"
    }
    return false
}
