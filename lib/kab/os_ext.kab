// SH21: path ext leaf off os_base.kab. import "kab/os_ext"
// Do not grow os_base.kab. kabOsHostDeleteOk stays false.

import "kab/os_base"

pub fn kabOsExt(path) {
    let name = kabOsBase(path)
    let n = len(name)
    let i = n
    while i > 0 {
        i = i - 1
        let ch = str_slice(name, i, i + 1)
        if ch == "." {
            return str_slice(name, i, n)
        }
    }
    return ""
}
