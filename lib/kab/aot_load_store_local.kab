// F10: loader accepts only a documented first-image frame-local store.
// import "kab/aot_load_store_local"; do not import other kab/aot* leaves.

pub fn aotLoadStoreLocalOk(op, target) {
    if target == "x64" {
        return op == "488945f8"
    }
    if target == "arm64" {
        return op == "a00b00f9"
    }
    return false
}
