// F10: loader accepts only a documented first-image jne opcode.
// import "kab/aot_load_jne"; do not import other kab/aot* leaves.

pub fn aotLoadJneOk(op, target) {
    if target == "x64" {
        return op == "7500"
    }
    if target == "arm64" {
        return op == "54000001"
    }
    return false
}
