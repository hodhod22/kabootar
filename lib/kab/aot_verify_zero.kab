// F10: native image filename and integer-zero opcode must agree.
// import "kab/aot_verify_zero"; do not import other kab/aot* leaves.

pub fn aotVerifyZeroOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "31c0"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "aa1f03e0"
    }
    return false
}
