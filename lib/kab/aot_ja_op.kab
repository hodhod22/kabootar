// F10: first Kab-native images emit a documented ja opcode for the return register.
// import "kab/aot_ja_op"; do not import other kab/aot* leaves.

pub fn aotJaOp(target) {
    if target == "x64" {
        return "7700"
    }
    if target == "arm64" {
        return "54000008"
    }
    return ""
}
