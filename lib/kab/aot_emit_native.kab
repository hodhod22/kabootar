// F10: first native images emit plan prefix plus concatenated section payloads.
// import "kab/aot_emit_native"; do not import other kab/aot* leaves.

pub fn aotEmitNative(target) {
    if target == "x64" {
        return "kabootar-native/1|x64||text:rx|c3||rodata:r|00||data:rw|00"
    }
    if target == "arm64" {
        return "kabootar-native/1|arm64||text:rx|d65f03c0||rodata:r|00||data:rw|00"
    }
    return ""
}
