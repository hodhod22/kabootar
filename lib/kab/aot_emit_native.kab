// F10: first native images emit plan prefix plus one-add-sub-mul-div-and-or-shl-shr-not-xor-neg-cmp-test-je-jne-jl-jle-jg-jge-ja-jae-jb-jbe-js-jns-nop-ret section payloads.
// import "kab/aot_emit_native"; do not import other kab/aot* leaves.

pub fn aotEmitNative(target) {
    if target == "x64" {
        return "kabootar-native/1|x64||text:rx|b80100000001c029c00fafc0f7f821c009c0d1e0d1e8f7d033c0f7d839c085c0740075007c007e007f007d007700730072007600780079007a007b0070007100e90000000050584883ec104883c4104889d84889c3554889e5e80000000090c3||rodata:r|00||data:rw|00"
    }
    if target == "arm64" {
        return "kabootar-native/1|arm64||text:rx|||rodata:r|00||data:rw|00"
    }
    return ""
}
