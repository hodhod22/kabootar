    10|
/// Rodata/data apply plus full text+rodata+data hex image validates.
pub fn loadAotRelocFullOk(nBytes) {
    if loadAotRelocRodataDataOk(nBytes) == false {
        return false
    }
    let plan = loadAotRelocFullPlan()
    let target = loadAotTarget()
    return aotLoadImageWithRelocTextRodataDataHexOk(plan, target)
}
