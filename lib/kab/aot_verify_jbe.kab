// F10: native image filename and jbe opcode must agree.
// import "kab/aot_verify_jbe"; do not import other kab/aot* leaves.

pub fn aotVerifyJbeOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "7600"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "54000009"
    }
    return false
}
