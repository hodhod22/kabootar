// F10: native image filename and concatenated layout payload must agree.
// import "kab/aot_verify_layout"; do not import other kab/aot* leaves.

pub fn aotVerifyLayoutOk(name, layout) {
    if name == "kabootar-x64.kbn" {
        return layout == "text:rx|b80100000001c029c00fafc0f7f821c009c0d1e0d1e8f7d033c0f7d839c085c0740075007c007e007f007d0090c3||rodata:r|00||data:rw|00"
    }
    if name == "kabootar-arm64.kbn" {
        return layout == "text:rx|d28000208b000000cb0000009b007c009ac00c008a000000aa000000d37ff800d341fc00aa2003e0ca000000cb0003e0eb00001fea00001f54000000540000015400000b5400000d5400000c5400000ad503201fd65f03c0||rodata:r|00||data:rw|00"
    }
    return false
}
