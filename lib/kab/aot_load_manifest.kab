// F10: loader accepts only a target-qualified Kab-native manifest.
// import "kab/aot_load_manifest"; do not import other kab/aot* leaves.

pub fn aotLoadManifestOk(manifest, target) {
    if target == "x64" {
        return manifest == "kabootar-native/1|x64|text:rx|rodata:r|data:rw"
    }
    if target == "arm64" {
        return manifest == "kabootar-native/1|arm64|text:rx|rodata:r|data:rw"
    }
    return false
}
