// F10: first Kab-native images emit a documented shr opcode for the return register.
// import "kab/aot_shr_op"; do not import other kab/aot* leaves.

pub fn aotShrOp(target) {
    if target == "x64" {
        return "d1e8"
    }
    if target == "arm64" {
        return "d341fc00"
    }
    return ""
}
