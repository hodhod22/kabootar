// F10: first Kab-native text sections carry RX plus one then add then sub then mul then div then and then or then shl then shr then not then xor then neg then cmp then test then je then jne then jl then jle then nop then return.
// import "kab/aot_emit_text"; do not import other kab/aot* leaves.

pub fn aotEmitText(target) {
    if target == "x64" {
        return "text:rx|b80100000001c029c00fafc0f7f821c009c0d1e0d1e8f7d033c0f7d839c085c0740075007c007e007f007d0090c3"
    }
    if target == "arm64" {
        return "text:rx|d28000208b000000cb0000009b007c009ac00c008a000000aa000000d37ff800d341fc00aa2003e0ca000000cb0003e0eb00001fea00001f54000000540000015400000b5400000d5400000c5400000ad503201fd65f03c0"
    }
    return ""
}
