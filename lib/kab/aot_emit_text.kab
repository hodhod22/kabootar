// F10: first Kab-native text sections carry RX plus one then add then sub then mul then div then and then or then shl then shr then not then xor then neg then cmp then test then je then jne then jl then jle then jg then jge then ja then jae then jb then jbe then js then jns then nop then return.
// import "kab/aot_emit_text"; do not import other kab/aot* leaves.

pub fn aotEmitText(target) {
    if target == "x64" {
        return "text:rx|b80100000001c029c00fafc0f7f821c009c0d1e0d1e8f7d033c0f7d839c085c0740075007c007e007f007d007700730072007600780079007a007b0070007100e90000000050584883ec104883c4104889d84889c3554889e5e80000000090c3"
    }
    if target == "arm64" {
        return "text:rx|"
    }
    return ""
}
