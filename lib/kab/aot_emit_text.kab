// F10: first Kab-native text sections carry RX plus one then add then nop then return.
// import "kab/aot_emit_text"; do not import other kab/aot* leaves.

pub fn aotEmitText(target) {
    if target == "x64" {
        return "text:rx|b80100000001c090c3"
    }
    if target == "arm64" {
        return "text:rx|d28000208b000000d503201fd65f03c0"
    }
    return ""
}
