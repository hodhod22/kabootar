// SH17 deepen: mmap+exec policy for loop-and template. import "kab/jit_run_loop_and"
// Do not grow jit_run_loop_mod.kab.

import "kab/jit_mmap_loop"
import "kab/jit_np"
import "kab/jit_exec"
import "kab/jit_mm_loop_and"
import "kab/jit_patch_loop_and"
import "kab/jit_loop_and"

pub fn jitRunLoopAndOk(base, kind, bytes, n, mask) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopAndOk(bytes, n, mask) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopAndOk(nb, kind, n, mask) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
