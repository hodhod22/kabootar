// F10: first Kab-native images emit a documented and opcode for the return register.
// import "kab/aot_and_op"; do not import other kab/aot* leaves.

pub fn aotAndOp(target) {
    if target == "x64" {
        return "21c0"
    }
    if target == "arm64" {
        return "8a000000"
    }
    return ""
}
