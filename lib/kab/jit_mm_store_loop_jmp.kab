// SH17 deepen: guest store for loop-jmp template. import "kab/jit_mm_store_loop_jmp"
// Do not grow jit_mm_store_loop_jne.kab.

import "kab/jit_mm_loop_jmp"
import "kab/jit_loop_jmp"

pub fn jitMmStoreLoopJmp(bytes, n, k) {
    if jitLoopJmpOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopJmpLen() {
        return 0
    }
    let pid = jitMmLoopJmpPid()
    let virt = jitMmLoopJmpVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
