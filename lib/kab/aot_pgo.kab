// F10: PGO hit threshold for AOT. import "kab/aot_pgo"
// Do not import kab/aot or kab/jit.

pub fn aotPgoOk(nHits) {
    if nHits >= 8 {
        return true
    }
    return false
}

// F10: emit a warmed native image only when the PGO hit threshold is met.
pub fn aotPgoWarmImage(nHits, target) {
    if aotPgoOk(nHits) == false {
        return ""
    }
    if target == "x64" {
        return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|pgo:8"
    }
    if target == "arm64" {
        return "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|pgo:8"
    }
    return ""
}

// F10: emit a warmed native image only when PGO hits and fingerprint are both present.
pub fn aotPgoWarmImageWithFp(nHits, fp, target) {
    if aotPgoOk(nHits) == false {
        return ""
    }
    if len(fp) == 0 {
        return ""
    }
    if target == "x64" {
        return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|pgo:8|fp:" + fp
    }
    if target == "arm64" {
        return "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|pgo:8|fp:" + fp
    }
    return ""
}

// F10: emit a warmed native image only when PGO, fingerprint, and cold-start budget agree.
pub fn aotPgoWarmImageWithFpCold(nHits, fp, ms, target) {
    if aotPgoOk(nHits) == false {
        return ""
    }
    if len(fp) == 0 {
        return ""
    }
    if ms > 100 {
        return ""
    }
    if target == "x64" {
        return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|pgo:8|fp:" + fp + "|cold:100"
    }
    if target == "arm64" {
        return "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|pgo:8|fp:" + fp + "|cold:100"
    }
    return ""
}

// F10: emit a warmed native image only when PGO, fingerprint, cold-start, and steady-state budgets agree.
pub fn aotPgoWarmImageWithFpColdSs(nHits, fp, coldMs, ssMs, target) {
    if aotPgoOk(nHits) == false {
        return ""
    }
    if len(fp) == 0 {
        return ""
    }
    if coldMs > 100 {
        return ""
    }
    if ssMs > 16 {
        return ""
    }
    if target == "x64" {
        return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|pgo:8|fp:" + fp + "|cold:100|ss:16"
    }
    if target == "arm64" {
        return "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|pgo:8|fp:" + fp + "|cold:100|ss:16"
    }
    return ""
}

// F10: emit a warmed native image with PGO budgets plus sym/reloc records.
pub fn aotPgoWarmImageWithFpColdSsSymReloc(nHits, fp, coldMs, ssMs, target) {
    if aotPgoOk(nHits) == false {
        return ""
    }
    if len(fp) == 0 {
        return ""
    }
    if coldMs > 100 {
        return ""
    }
    if ssMs > 16 {
        return ""
    }
    if target == "x64" {
        return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|pgo:8|fp:" + fp + "|cold:100|ss:16|sym:text:32:main:x64|reloc:text:32:0:main:x64"
    }
    if target == "arm64" {
        return "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|pgo:8|fp:" + fp + "|cold:100|ss:16|sym:text:32:main:arm64|reloc:text:32:0:main:arm64"
    }
    return ""
}
