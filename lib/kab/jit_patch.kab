// SH17 deepen: validate i64 inc+ret template before exec. import "kab/jit_patch"
// Do not grow jit.kab. Uses jit_check + jitEmitI64IncRet bytes only.

import "kab/jit"
import "kab/jit_check"

/// True when bytes match jitEmitI64IncRet() and end with RET (0xC3).
pub fn jitPatchIncRetOk(bytes) {
    let tpl = jitEmitI64IncRet()
    if len(bytes) != 6 {
        return false
    }
    if len(tpl) != 6 {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if bytes[3] != tpl[3] {
        return false
    }
    if bytes[4] != tpl[4] {
        return false
    }
    if jitByteIsRet(bytes[5]) == false {
        return false
    }
    return bytes[5] == tpl[5]
}
