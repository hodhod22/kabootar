// SH17 deepen: mmap+exec policy for loop-jmp template. import "kab/jit_run_loop_jmp"
// Do not grow jit_run_loop_jne.kab.

import "kab/jit_mmap_loop"
import "kab/jit_np"
import "kab/jit_exec"
import "kab/jit_mm_loop_jmp"
import "kab/jit_patch_loop_jmp"
import "kab/jit_loop_jmp"

pub fn jitRunLoopJmpOk(base, kind, bytes, n, k) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopJmpOk(bytes, n, k) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopJmpOk(nb, kind, n, k) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
