// F10: loader accepts only R rodata plus a documented zero stub.
// import "kab/aot_load_rodata"; do not import other kab/aot* leaves.

pub fn aotLoadRodataOk(rodata, target) {
    if target == "x64" {
        return rodata == "rodata:r|00"
    }
    if target == "arm64" {
        return rodata == "rodata:r|00"
    }
    return false
}
