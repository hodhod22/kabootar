// F10: first Kab-native images emit a documented branch when the first frame local is zero.
// import "kab/aot_branch_local_zero_op"; do not import other kab/aot* leaves.

pub fn aotBranchLocalZeroOp(target) {
    if target == "x64" {
        return "48837df8007400"
    }
    if target == "arm64" {
        return "a00b40f91f0000f154000000"
    }
    return ""
}
