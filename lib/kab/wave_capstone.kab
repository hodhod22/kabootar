// SH17–SH19 wave capstone: GC + AOT capstones plus all host gates closed. import "kab/wave_capstone"
// Do not grow gc_capstone.kab or load_aot_capstone.kab. All delete gates stay false.

import "kab/gc/gc_capstone"
import "kab/load/load_aot_capstone"
import "kab/noll/noll_aot"
import "kab/noll/noll_keep"
import "kab/noll/noll_host"

pub fn waveCapstoneLiveGray() {
    return gcCapstoneLiveGray()
}

pub fn waveCapstoneNativeName() {
    return loadAotCapstoneNativeName()
}

pub fn waveCapstoneBytes() {
    return 4096
}

/// True when every SH19–SH27 host delete gate is still closed.
pub fn waveCapstoneGatesClosed() {
    return nollAllHostGatesClosed()
}

/// GC capstone plus AOT capstone; all delete gates still closed; src/ kept.
pub fn waveCapstoneOk(live, nBytes) {
    if gcCapstoneOk(live) == false {
        return false
    }
    if loadAotCapstoneOk(nBytes) == false {
        return false
    }
    if nollAotReady() {
        return false
    }
    if nollKeepSrc() == false {
        return false
    }
    return waveCapstoneGatesClosed()
}
