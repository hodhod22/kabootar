// SH20: collections exp off std_collog10.kab. import "kab/std_colexp"
// Do not grow std_collog10.kab. stdHostDeleteOk stays false.

pub fn stdColExp(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, exp(a[i]))
        i = i + 1
    }
    return out
}
