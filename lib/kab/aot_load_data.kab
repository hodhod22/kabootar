// F10: loader accepts only RW data plus a documented zero stub.
// import "kab/aot_load_data"; do not import other kab/aot* leaves.

pub fn aotLoadDataOk(data, target) {
    if target == "x64" {
        return data == "data:rw|00"
    }
    if target == "arm64" {
        return data == "data:rw|00"
    }
    return false
}
