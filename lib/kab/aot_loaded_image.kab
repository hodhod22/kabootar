// F10: persisted image bytes must match a first Kab-native image.
// import "kab/aot_loaded_image"; do not import other kab/aot* leaves.

pub fn aotLoadedImageOk(image) {
    if image == "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret" {
        return true
    }
    if image == "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret" {
        return true
    }
    return false
}
