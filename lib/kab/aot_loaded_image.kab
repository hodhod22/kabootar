// F10: persisted image bytes must match a first Kab-native image.
// import "kab/aot_loaded_image"; do not import other kab/aot* leaves.

pub fn aotLoadedImageOk(image) {
    if image == "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|sym:text:32:main:x64|reloc:text:32:0:main:x64" {
        return true
    }
    if image == "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|sym:text:32:main:x64|reloc:text:32:8:main:x64" {
        return true
    }
    if image == "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|syms:sym:text:0:_start:x64;sym:text:32:main:x64|relocs:reloc:text:32:0:main:x64;reloc:text:32:8:main:x64" {
        return true
    }
    if image == "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|sym:text:32:main:arm64|reloc:text:32:0:main:arm64" {
        return true
    }
    if image == "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|sym:text:32:main:arm64|reloc:text:32:8:main:arm64" {
        return true
    }
    if image == "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|syms:sym:text:0:_start:arm64;sym:text:32:main:arm64|relocs:reloc:text:32:0:main:arm64;reloc:text:32:8:main:arm64" {
        return true
