// SH17 deepen: translate+store for loop-xor template. import "kab/jit_wr_loop_xor"
// Do not grow jit_wr_loop_or.kab.

import "kab/jit_patch_loop_xor"
import "kab/jit_mm_loop_xor"
import "kab/jit_mm_store_loop_xor"
import "kab/jit_loop_xor"

pub fn jitWrLoopXorOk(bytes, n, mask) {
    if jitPatchLoopXorOk(bytes, n, mask) == false {
        return false
    }
    let pid = jitMmLoopXorPid()
    let virt = jitMmLoopXorVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopXor(bytes, n, mask)
    if w != jitLoopXorLen() {
        return false
    }
    return true
}
