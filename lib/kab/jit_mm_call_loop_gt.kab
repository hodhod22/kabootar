// SH17 deepen: guest call for loop-gt template. import "kab/jit_mm_call_loop_gt"
// Do not grow jit_mm_call_loop_lt.kab.

import "kab/jit_mm_loop_gt"
import "kab/jit_loop_gt"

pub fn jitMmCallLoopGt(bytes, n, k) {
    if jitLoopGtOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopGtLen() {
        return 0
    }
    let pid = jitMmLoopGtPid()
    let virt = jitMmLoopGtVirt()
    let rax = os_mm_call(pid, virt)
    if rax != jitLoopGtRax(n, k) {
        return 0
    }
    return rax
}
