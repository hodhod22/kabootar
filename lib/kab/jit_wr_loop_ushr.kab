// SH17 deepen: translate+store for loop-ushr template. import "kab/jit_wr_loop_ushr"
// Do not grow jit_wr_loop_shr.kab.

import "kab/jit_patch_loop_ushr"
import "kab/jit_mm_loop_ushr"
import "kab/jit_mm_store_loop_ushr"
import "kab/jit_loop_ushr"

pub fn jitWrLoopUshrOk(bytes, n, sh) {
    if jitPatchLoopUshrOk(bytes, n, sh) == false {
        return false
    }
    let pid = jitMmLoopUshrPid()
    let virt = jitMmLoopUshrVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopUshr(bytes, n, sh)
    if w != jitLoopUshrLen() {
        return false
    }
    return true
}
