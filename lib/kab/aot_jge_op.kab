// F10: first Kab-native images emit a documented jge opcode for the return register.
// import "kab/aot_jge_op"; do not import other kab/aot* leaves.

pub fn aotJgeOp(target) {
    if target == "x64" {
        return "7d00"
    }
    if target == "arm64" {
        return "5400000a"
    }
    return ""
}
