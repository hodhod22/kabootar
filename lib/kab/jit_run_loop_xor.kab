// SH17 deepen: mmap+exec policy for loop-xor template. import "kab/jit_run_loop_xor"
// Do not grow jit_run_loop_or.kab.

import "kab/jit_mmap_loop"
import "kab/jit_np"
import "kab/jit_exec"
import "kab/jit_mm_loop_xor"
import "kab/jit_patch_loop_xor"
import "kab/jit_loop_xor"

pub fn jitRunLoopXorOk(base, kind, bytes, n, mask) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopXorOk(bytes, n, mask) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopXorOk(nb, kind, n, mask) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
