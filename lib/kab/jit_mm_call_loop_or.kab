// SH17 deepen: guest call for loop-or template. import "kab/jit_mm_call_loop_or"
// Do not grow jit_mm_call_loop_and.kab.

import "kab/jit_mm_loop_or"
import "kab/jit_loop_or"

pub fn jitMmCallLoopOr(bytes, n, mask) {
    if jitLoopOrOk(n, mask) == false {
        return 0
    }
    if len(bytes) != jitLoopOrLen() {
        return 0
    }
    let pid = jitMmLoopOrPid()
    let virt = jitMmLoopOrVirt()
    let rax = os_mm_call(pid, virt)
    if rax != jitLoopOrRax(n, mask) {
        return 0
    }
    return rax
}
