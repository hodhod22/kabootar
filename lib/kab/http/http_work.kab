// F14 deepen: workers plus host-HTTP drop gate. import "kab/http/http_work"
// Do not grow work.kab or http_host.kab. httpHostDeleteOk stays false. No live serve.

import "kab/work"
import "kab/http/http_host"

pub fn httpWorkDropOk(n, isManual, debugChecks, workers, wantDelete) {
    if workParOk(n, isManual, debugChecks, workers) == false {
        return false
    }
    if wantDelete != httpHostDeleteOk() {
        return false
    }
    return true
}
