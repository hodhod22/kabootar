// SH24: pure HTTP/1.1 helpers (no crypto) for Kab HTTP client and stdlib.
// import "kab/http/http_util"

pub fn httpIsHttps(url) {
    return str_includes(url, "https://")
}

pub fn httpAppend(o, s) {
    let n = o["n"]
    let i = 0
    while i < len(s) {
        o["" + n] = char_code_at(s, i) & 255
        n = n + 1
        i = i + 1
    }
    o["n"] = n
    return o
}

pub fn httpAppendCrLf(o) {
    let n = o["n"]
    o["" + n] = 13
    o["" + (n + 1)] = 10
    o["n"] = n + 2
    return o
}

pub fn httpAppendHeader(o, name, value) {
    o = httpAppend(o, name)
    o = httpAppend(o, ": ")
    o = httpAppend(o, value)
    return httpAppendCrLf(o)
}

pub fn httpHostFromHttps(url) {
    let i = 8
    while i < len(url) {
        if char_code_at(url, i) == 47 {
            return str_slice(url, 8, i)
        }
        i = i + 1
    }
    return str_slice(url, 8, len(url))
}

pub fn httpHostName(auth) {
    let i = 0
    while i < len(auth) {
        if char_code_at(auth, i) == 58 {
            return str_slice(auth, 0, i)
        }
        i = i + 1
    }
    return auth
}

pub fn httpIsLoopbackHost(host) {
    if host == "127.0.0.1" {
        return true
    }
    if host == "localhost" {
        return true
    }
    return false
}

pub fn httpPortFromHttps(url) {
    let auth = httpHostFromHttps(url)
    let i = 0
    while i < len(auth) {
        if char_code_at(auth, i) == 58 {
            let v = 0
            let j = i + 1
            while j < len(auth) {
                let d = char_code_at(auth, j) - 48
                if d < 0 {
                    return v
                }
                if d > 9 {
                    return v
                }
                v = v * 10 + d
                j = j + 1
            }
            return v
        }
        i = i + 1
    }
    return 443
}

pub fn httpPathFromHttps(url) {
    let i = 8
    while i < len(url) {
        if char_code_at(url, i) == 47 {
            return str_slice(url, i, len(url))
        }
        i = i + 1
    }
    return "/"
}

pub fn httpFetchTarget(method, url) {
    if method == "CONNECT" {
        return httpHostFromHttps(url)
    }
    return httpPathFromHttps(url)
}

pub fn httpBuildGet(host, path) {
    return httpBuildRead("GET", host, path)
}

pub fn httpBuildRead(method, host, path) {
    let o = {}
    o["n"] = 0
    o = httpAppend(o, method)
    o = httpAppend(o, " ")
    o = httpAppend(o, path)
    o = httpAppend(o, " HTTP/1.1")
    o = httpAppendCrLf(o)
    o = httpAppendHeader(o, "Host", host)
    o = httpAppendCrLf(o)
    return o
}

pub fn httpBuildReadAuth(method, host, path, token) {
    let o = {}
    o["n"] = 0
    o = httpAppend(o, method)
    o = httpAppend(o, " ")
    o = httpAppend(o, path)
    o = httpAppend(o, " HTTP/1.1")
    o = httpAppendCrLf(o)
    o = httpAppendHeader(o, "Host", host)
    o = httpAppendHeader(o, "User-Agent", "kab/1")
    o = httpAppendHeader(o, "Authorization", "Bearer " + token)
    o = httpAppendCrLf(o)
    return o
}

pub fn httpBuildGetAuthHdr(host, path, auth) {
    let o = {}
    o["n"] = 0
    o = httpAppend(o, "GET")
    o = httpAppend(o, " ")
    o = httpAppend(o, path)
    o = httpAppend(o, " HTTP/1.1")
    o = httpAppendCrLf(o)
    o = httpAppendHeader(o, "Host", host)
    o = httpAppendHeader(o, "Authorization", auth)
    o = httpAppendCrLf(o)
    return o
}

pub fn httpBuildGetCookieHdr(host, path, cookie) {
    let o = {}
    o["n"] = 0
    o = httpAppend(o, "GET")
    o = httpAppend(o, " ")
    o = httpAppend(o, path)
    o = httpAppend(o, " HTTP/1.1")
    o = httpAppendCrLf(o)
    o = httpAppendHeader(o, "Host", host)
    o = httpAppendHeader(o, "Cookie", cookie)
    o = httpAppendCrLf(o)
    return o
}

pub fn httpBuildGetProxyAuthHdr(host, path, proxyAuth) {
    let o = {}
    o["n"] = 0
    o = httpAppend(o, "GET")
    o = httpAppend(o, " ")
    o = httpAppend(o, path)
    o = httpAppend(o, " HTTP/1.1")
    o = httpAppendCrLf(o)
    o = httpAppendHeader(o, "Host", host)
    o = httpAppendHeader(o, "Proxy-Authorization", proxyAuth)
    o = httpAppendCrLf(o)
    return o
}

pub fn httpDec(n) {
    if n == 0 {
        return "0"
    }
    let s = ""
    let x = n
    while x > 0 {
        let d = x - (((x / 10) | 0) * 10)
        s = from_char_code(48 + d) + s
        x = (x / 10) | 0
    }
    return s
}

pub fn httpBuildPost(host, path, body, ctype) {
    return httpBuildWrite("POST", host, path, body, ctype)
}

pub fn httpBuildWrite(method, host, path, body, ctype) {
    let o = {}
    o["n"] = 0
    o = httpAppend(o, method)
    o = httpAppend(o, " ")
    o = httpAppend(o, path)
    o = httpAppend(o, " HTTP/1.1")
    o = httpAppendCrLf(o)
    o = httpAppend(o, "Host: ")
    o = httpAppend(o, host)
    o = httpAppendCrLf(o)
    o = httpAppend(o, "Content-Type: ")
    o = httpAppend(o, ctype)
    o = httpAppendCrLf(o)
    o = httpAppend(o, "Content-Length: ")
    o = httpAppend(o, httpDec(len(body)))
    o = httpAppendCrLf(o)
    o = httpAppendCrLf(o)
    o = httpAppend(o, body)
    return o
}

pub fn httpBuildFetchReq(method, host, path, body, headers) {
    if method == "GET" {
        if body != "" {
            return false
        }
        let au = headers["Authorization"]
        if au {
            return httpBuildGetAuthHdr(host, path, au)
        }
        let ck = headers["Cookie"]
        if ck {
            return httpBuildGetCookieHdr(host, path, ck)
        }
        let pa = headers["Proxy-Authorization"]
        if pa {
            return httpBuildGetProxyAuthHdr(host, path, pa)
        }
        return httpBuildGet(host, path)
    }
    if method == "DELETE" {
        if body != "" {
            return false
        }
        return httpBuildRead("DELETE", host, path)
    }
    if method == "HEAD" {
        if body != "" {
            return false
        }
        return httpBuildRead("HEAD", host, path)
    }
    if method == "OPTIONS" {
        if body != "" {
            return false
        }
        return httpBuildRead("OPTIONS", host, path)
    }
    if method == "TRACE" {
        if body != "" {
            return false
        }
        return httpBuildRead("TRACE", host, path)
    }
    if method == "CONNECT" {
        if body != "" {
            return false
        }
        return httpBuildRead("CONNECT", host, path)
    }
    if method != "POST" {
        if method != "PUT" {
            if method != "PATCH" {
                return false
            }
        }
    }
    let ctype = headers["Content-Type"]
    if ctype == undefined || ctype == null {
        ctype = "application/x-www-form-urlencoded"
    }
    return httpBuildWrite(method, host, path, body, ctype)
}

// Response helpers

pub fn httpStrToBytes(s) {
    let o = {}
    o["n"] = 0
    let i = 0
    while i < len(s) {
        o["" + o["n"]] = char_code_at(s, i) & 255
        o["n"] = o["n"] + 1
        i = i + 1
    }
    return o
}

pub fn httpBytesToStr(o) {
    let s = ""
    let i = 0
    let n = o["n"]
    while i < n {
        s = s + from_char_code(o["" + i] & 255)
        i = i + 1
    }
    return s
}

pub fn httpSlice(o, start, n) {
    let out = {}
    let i = 0
    while i < n {
        out["" + i] = o["" + (start + i)] & 255
        i = i + 1
    }
    out["n"] = n
    return out
}

pub fn httpAsciiFold(c) {
    let b = c & 255
    if b >= 65 {
        if b <= 90 {
            return b + 32
        }
    }
    return b
}

pub fn httpHeaderNameEq(pt, start, end, name) {
    if end - start != len(name) {
        return false
    }
    let i = 0
    while i < len(name) {
        if httpAsciiFold(pt["" + (start + i)]) != httpAsciiFold(char_code_at(name, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

pub fn httpHeaderValue(pt, name) {
    let i = 0
    let n = pt["n"]
    while i < n {
        let line = i
        while i < n {
            if (pt["" + i] & 255) == 10 {
                break
            }
            i = i + 1
        }
        let end = i
        let lineEnd = end
        if lineEnd > line {
            if (pt["" + (lineEnd - 1)] & 255) == 13 {
                lineEnd = lineEnd - 1
            }
        }
        let colon = line
        while colon < lineEnd {
            if (pt["" + colon] & 255) == 58 {
                break
            }
            colon = colon + 1
        }
        if colon < lineEnd {
            if httpHeaderNameEq(pt, line, colon, name) {
                let value = colon + 1
                while value < lineEnd {
                    let c = pt["" + value] & 255
                    if c != 32 {
                        if c != 9 {
                            return str_slice(httpBytesToStr(pt), value, lineEnd)
                        }
                    }
                    value = value + 1
                }
                return ""
            }
        }
        if i >= n {
            return ""
        }
        i = i + 1
    }
    return ""
}

pub fn httpHdrLower(s) {
    let out = ""
    let i = 0
    while i < len(s) {
        out = out + from_char_code(httpAsciiFold(char_code_at(s, i)))
        i = i + 1
    }
    return out
}

pub fn httpHdrObj(pt) {
    let raw = httpBytesToStr(pt)
    let out = {}
    let i = 0
    let n = pt["n"]
    let first = true
    while i < n {
        let line = i
        while i < n {
            if (pt["" + i] & 255) == 10 {
                break
            }
            i = i + 1
        }
        let end = i
        let lineEnd = end
        if lineEnd > line {
            if (pt["" + (lineEnd - 1)] & 255) == 13 {
                lineEnd = lineEnd - 1
            }
        }
        if lineEnd == line {
            break
        }
        if first == true {
            first = false
            if i < n {
                i = i + 1
            }
            continue
        }
        let colon = line
        while colon < lineEnd {
            if (pt["" + colon] & 255) == 58 {
                break
            }
            colon = colon + 1
        }
        if colon < lineEnd {
            let name = httpHdrLower(str_slice(raw, line, colon))
            let value = colon + 1
            while value < lineEnd {
                let c = pt["" + value] & 255
                if c != 32 {
                    if c != 9 {
                        break
                    }
                }
                value = value + 1
            }
            out[name] = str_slice(raw, value, lineEnd)
        }
        if i >= n {
            break
        }
        i = i + 1
    }
    return out
}

pub fn httpStatusCode(pt) {
    let i = 0
    let n = pt["n"]
    while i < n {
        if (pt["" + i] & 255) == 32 {
            let a = (pt["" + (i + 1)] & 255) - 48
            let b = (pt["" + (i + 2)] & 255) - 48
            let c = (pt["" + (i + 3)] & 255) - 48
            return a * 100 + b * 10 + c
        }
        i = i + 1
    }
    return 0
}

pub fn httpRespBody(pt) {
    let i = 0
    let n = pt["n"]
    while i + 3 < n {
        if (pt["" + i] & 255) == 13 {
            if (pt["" + (i + 1)] & 255) == 10 {
                if (pt["" + (i + 2)] & 255) == 13 {
                    if (pt["" + (i + 3)] & 255) == 10 {
                        return httpSlice(pt, i + 4, n - (i + 4))
                    }
                }
            }
        }
        i = i + 1
    }
    return httpSlice(pt, 0, 0)
}
