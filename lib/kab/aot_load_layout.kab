// F10: loader accepts only concatenated RX text, R rodata, and RW data.
// import "kab/aot_load_layout"; do not import other kab/aot* leaves.

pub fn aotLoadLayoutOk(layout, target) {
    if target == "x64" {
        return layout == "text:rx|b80100000001c090c3||rodata:r|00||data:rw|00"
    }
    if target == "arm64" {
        return layout == "text:rx|d28000208b000000d503201fd65f03c0||rodata:r|00||data:rw|00"
    }
    return false
}
