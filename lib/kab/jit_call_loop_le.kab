// SH17 deepen: loop-le wr+run+call pipeline. import "kab/jit_call_loop_le"
// Do not grow jit_call_loop_gt.kab.

import "kab/jit_wr_loop_le"
import "kab/jit_run_loop_le"
import "kab/jit_mm_call_loop_le"
import "kab/jit_loop_le"

pub fn jitCallLoopLeOk(base, kind, n, k, bytes) {
    if jitLoopLeOk(n, k) == false {
        return false
    }
    if jitWrLoopLeOk(bytes, n, k) == false {
        return false
    }
    if jitRunLoopLeOk(base, kind, bytes, n, k) == false {
        return false
    }
    let rax = jitMmCallLoopLe(bytes, n, k)
    if rax != jitLoopLeRax(n, k) {
        return false
    }
    return true
}
