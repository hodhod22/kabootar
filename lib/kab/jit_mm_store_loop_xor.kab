// SH17 deepen: guest store for loop-xor template. import "kab/jit_mm_store_loop_xor"
// Do not grow jit_mm_store_loop_or.kab.

import "kab/jit_mm_loop_xor"
import "kab/jit_loop_xor"

pub fn jitMmStoreLoopXor(bytes, n, mask) {
    if jitLoopXorOk(n, mask) == false {
        return 0
    }
    if len(bytes) != jitLoopXorLen() {
        return 0
    }
    let pid = jitMmLoopXorPid()
    let virt = jitMmLoopXorVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
