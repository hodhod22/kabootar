import "kab/load_aot_reloc_full"
import "kab/aot_load_image"

pub fn loadAotPgoHits() {
    return 8
}
    10|
pub fn loadAotPgoWarmPlan() {
    return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|pgo:8"
}

pub fn loadAotPgoWarmFpPlan() {
    return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|pgo:8|fp:abc"
}

pub fn loadAotPgoWarmFpColdPlan() {
    20|    return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|pgo:8|fp:abc|cold:100"
}

pub fn loadAotPgoWarmFpColdSsPlan() {
    return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|pgo:8|fp:abc|cold:100|ss:16"
}

pub fn loadAotPgoSymRelocPlan() {
    return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|pgo:8|fp:abc|cold:100|ss:16|sym:text:32:main:x64|reloc:text:32:0:main:x64"
}
    30|
/// Full reloc image plus PGO hit threshold validates.
pub fn loadAotPgoWarmOk(nBytes) {
    if loadAotRelocFullOk(nBytes) == false {
        return false
    }
    let plan = loadAotPgoWarmPlan()
    let target = loadAotTarget()
    return aotLoadImageWithPgoWarmOk(plan, target)
}
    40|
