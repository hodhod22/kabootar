    70|
/// PGO budgets plus sym/reloc records validate — ship-ready gate.
pub fn loadAotPgoBootstrapOk(nBytes) {
    if loadAotPgoWarmFpColdSsOk(nBytes) == false {
        return false
    }
    let plan = loadAotPgoSymRelocPlan()
    let target = loadAotTarget()
    return aotLoadImageWithPgoWarmFpColdSsSymRelocOk(plan, target)
}
