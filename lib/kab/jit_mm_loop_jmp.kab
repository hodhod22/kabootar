// SH17 deepen: loop-jmp guest mmap args. import "kab/jit_mm_loop_jmp"
// Do not grow jit_mm_loop_jne.kab. Separate virt slot from loop-jne.

import "kab/jit_loop_jmp"

pub fn jitMmLoopJmpPid() {
    return 1
}

pub fn jitMmLoopJmpVirt() {
    return 598016
}

pub fn jitMmLoopJmpLen() {
    return 4096
}

pub fn jitMmLoopJmpProt() {
    return 7
}

pub fn jitOsMmapLoopJmpOk(nBytes, kind, n, k) {
    if jitLoopJmpOk(n, k) == false {
        return false
    }
    if nBytes != jitLoopJmpLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopJmpLen() != 4096 {
        return false
    }
    if jitMmLoopJmpProt() != 7 {
        return false
    }
    return true
}
