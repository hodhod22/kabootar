// F10: loader accepts only a documented first-image return-to-argument move.
// import "kab/aot_load_move_ret"; do not import other kab/aot* leaves.

pub fn aotLoadMoveRetOk(op, target) {
    if target == "x64" {
        return op == "4889c3"
    }
    if target == "arm64" {
        return op == "e10300aa"
    }
    return false
}
