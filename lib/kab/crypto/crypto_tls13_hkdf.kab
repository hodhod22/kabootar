// SH23: TLS 1.3 HKDF-Extract / Expand / Expand-Label (RFC 5869 + RFC 8446).
// Do not grow crypto_tls13.kab. Host rustls remains skuld.

import "kab/crypto/crypto_hmac_eval"
import "kab/crypto/crypto_tls_prf"
import "kab/crypto/crypto_tls_hs"

pub fn tls13EmptyObj() {
    let o = {}
    o["n"] = 0
    return o
}

pub fn tls13HashZeros() {
    let o = {}
    let i = 0
    while i < 32 {
        o["" + i] = 0
        i = i + 1
    }
    o["n"] = 32
    return o
}

pub fn tls13HkdfExtract(salt, ikm) {
    return hmacDigestToObj(hmacSha256WordsObj(salt, ikm))
}

pub fn tls13HkdfExpand(prk, info, nOut) {
    let out = {}
    let n = 0
    let prev = tls13EmptyObj()
    let i = 1
    while n < nOut {
        let cat = tlsConcatObj(prev, info)
        let ctr = {}
        ctr["0"] = i
        ctr["n"] = 1
        prev = hmacDigestToObj(hmacSha256WordsObj(prk, tlsConcatObj(cat, ctr)))
        let j = 0
        while j < 32 {
            if n < nOut {
                out["" + n] = prev["" + j] & 255
                n = n + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    out["n"] = nOut
    return out
}

pub fn tls13HkdfExpandLabel(secret, label, ctx, nOut) {
    let lab = hmacStrBytes("tls13 " + label)
    let info = {}
    info["0"] = (nOut / 256) | 0
    info["1"] = nOut & 255
    info["2"] = lab["n"] & 255
    info["n"] = 3
    info = tlsConcatObj(info, lab)
    let clen = {}
    clen["0"] = ctx["n"] & 255
    clen["n"] = 1
    info = tlsConcatObj(info, clen)
    if ctx["n"] > 0 {
        info = tlsConcatObj(info, ctx)
    }
    return tls13HkdfExpand(secret, info, nOut)
}

/// RFC 5869 SHA-256 test case 1 (PRK + first 32 of OKM).
pub fn tls13HkdfEvalOk() {
    let ikm = tlsHexToObj("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    let salt = tlsHexToObj("000102030405060708090a0b0c")
    let info = tlsHexToObj("f0f1f2f3f4f5f6f7f8f9")
    let prk = tls13HkdfExtract(salt, ikm)
    if tlsObjHex(prk) != "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5" {
        return false
    }
    let okm = tls13HkdfExpand(prk, info, 32)
    if tlsObjHex(okm) != "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf" {
        return false
    }
    return true
}
