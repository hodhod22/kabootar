// SH23: Kab TLS 1.3 leaf CN UTF8 bytes vs rustls P-256 peer.
// Do not grow crypto_tls13_peer_utf8.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_cn"
import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_root"

pub fn tls13PeerCnExpected() {
    return [114, 99, 103, 101, 110, 32, 115, 101, 108, 102, 32, 115, 105, 103, 110, 101, 100, 32, 99, 101, 114, 116]
}

pub fn tls13PeerCnBytes(bytes, value) {
    if value == false || value["tag"] != 12 {
        return false
    }
    let expected = tls13PeerCnExpected()
    if value["len"] != 22 {
        return false
    }
    let i = 0
    while i < 22 {
        if (bytes["" + (value["body"] + i)] & 255) != expected[i] {
            return false
        }
        i = i + 1
    }
    return true
}

pub fn tls13PeerCnUtf8Value(bytes, attr) {
    if attr == false || attr["tag"] != 48 {
        return false
    }
    let oid = cryptoDerTlv(bytes, attr["body"])
    if tls13PeerCnOid(bytes, oid) != true {
        return false
    }
    let value = cryptoDerTlv(bytes, oid["end"])
    if value == false || value["end"] != attr["end"] {
        return false
    }
    return value
}

pub fn tls13PeerCnbName(bytes, name) {
    if name == false || name["tag"] != 48 {
        return false
    }
    let i = name["body"]
    while i < name["end"] {
        let rdn = cryptoDerTlv(bytes, i)
        if rdn == false || rdn["tag"] != 49 {
            return false
        }
        let j = rdn["body"]
        while j < rdn["end"] {
            let attr = cryptoDerTlv(bytes, j)
            if attr == false {
                return false
            }
            let value = tls13PeerCnUtf8Value(bytes, attr)
            if tls13PeerCnBytes(bytes, value) == true {
                return true
            }
            j = attr["end"]
        }
        i = rdn["end"]
    }
    return false
}

pub fn tls13PeerCnbEvalOk(port) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false {
        tcp_close(s["sock"])
        return false
    }
    let der = tls13PeerCertDer(s["cert"])
    tcp_close(s["sock"])
    if der == false {
        return false
    }
    let outer = cryptoDerTlv(der, 0)
    if outer == false || outer["tag"] != 48 || outer["end"] != der["n"] {
        return false
    }
    let tbs = cryptoDerTlv(der, outer["body"])
    if tbs == false || tbs["tag"] != 48 {
        return false
    }
    let first = cryptoDerTlv(der, tbs["body"])
    if first == false {
        return false
    }
    let serialOff = tbs["body"]
    if first["tag"] == 160 {
        serialOff = first["end"]
    }
    let serial = cryptoDerTlv(der, serialOff)
    if serial == false || serial["tag"] != 2 {
        return false
    }
    let innerAlg = cryptoDerTlv(der, serial["end"])
    if innerAlg == false || innerAlg["tag"] != 48 {
        return false
    }
    let issuer = cryptoDerTlv(der, innerAlg["end"])
    if issuer == false || issuer["tag"] != 48 {
        return false
    }
    let validity = cryptoDerTlv(der, issuer["end"])
    if validity == false || validity["tag"] != 48 {
        return false
    }
    let subject = cryptoDerTlv(der, validity["end"])
    return tls13PeerCnbName(der, subject)
}
