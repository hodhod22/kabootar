// SH23: Kab TLS 1.3 SAN iPAddress length 12 rejected vs rustls P-256 peer.
// Do not grow crypto_tls13_peer_n11.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_n11"
import "kab/crypto/crypto_tls13_peer_san"
import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_root"

pub fn tls13PeerSanN12Loop(bytes, san) {
    if san == false || san["tag"] != 48 || san["body"] >= san["end"] {
        return false
    }
    let i = san["body"]
    let n = 0
    while i < san["end"] {
        let name = cryptoDerTlv(bytes, i)
        if name == false {
            return false
        }
        if name["tag"] == 136 {
            return false
        }
        if name["tag"] == 134 {
            return false
        }
        if name["tag"] == 133 {
            return false
        }
        if name["tag"] == 132 {
            return false
        }
        if name["tag"] == 131 {
            return false
        }
        if name["tag"] == 130 {
            return false
        }
        if name["tag"] == 129 {
            return false
        }
        if name["tag"] == 160 {
            return false
        }
        if name["tag"] != 135 {
            return false
        }
        if name["len"] == 0 {
            return false
        }
        if name["len"] == 1 {
            return false
        }
        if name["len"] == 2 {
            return false
        }
        if name["len"] == 3 {
            return false
        }
        if name["len"] == 5 {
            return false
        }
        if name["len"] == 6 {
            return false
        }
        if name["len"] == 7 {
            return false
        }
        if name["len"] == 8 {
            return false
        }
        if name["len"] == 9 {
            return false
        }
        if name["len"] == 11 {
            return false
        }
        if name["len"] == 12 {
            return false
        }
        if name["len"] == 16 {
            return false
        }
        if name["len"] != 4 {
            return false
        }
        if (bytes["" + name["body"]] & 255) != 127 {
            return false
        }
        if (bytes["" + (name["body"] + 1)] & 255) != 0 {
            return false
        }
        if (bytes["" + (name["body"] + 2)] & 255) != 0 {
            return false
        }
        if (bytes["" + (name["body"] + 3)] & 255) != 1 {
            return false
        }
        if (bytes["" + name["body"]] & 240) == 224 {
            return false
        }
        if (bytes["" + name["body"]] & 255) == 0 {
            if (bytes["" + (name["body"] + 1)] & 255) == 0 {
                if (bytes["" + (name["body"] + 2)] & 255) == 0 {
                    if (bytes["" + (name["body"] + 3)] & 255) == 0 {
                        return false
                    }
                }
            }
        }
        if (bytes["" + name["body"]] & 255) == 255 {
            if (bytes["" + (name["body"] + 1)] & 255) == 255 {
                if (bytes["" + (name["body"] + 2)] & 255) == 255 {
                    if (bytes["" + (name["body"] + 3)] & 255) == 255 {
                        return false
                    }
                }
            }
        }
        if (bytes["" + name["body"]] & 255) == 169 {
            if (bytes["" + (name["body"] + 1)] & 255) == 254 {
                return false
            }
        }
        if (bytes["" + name["body"]] & 255) == 10 {
            return false
        }
        if (bytes["" + name["body"]] & 255) == 172 {
            if (bytes["" + (name["body"] + 1)] & 240) == 16 {
                return false
            }
        }
        if (bytes["" + name["body"]] & 255) == 192 {
            if (bytes["" + (name["body"] + 1)] & 255) == 168 {
                return false
            }
        }
        if (bytes["" + name["body"]] & 255) == 100 {
            if (bytes["" + (name["body"] + 1)] & 192) == 64 {
                return false
            }
        }
        if (bytes["" + name["body"]] & 255) == 192 {
            if (bytes["" + (name["body"] + 1)] & 255) == 0 {
                if (bytes["" + (name["body"] + 2)] & 255) == 2 {
                    return false
                }
            }
        }
        if (bytes["" + name["body"]] & 255) == 198 {
            if (bytes["" + (name["body"] + 1)] & 255) == 51 {
                if (bytes["" + (name["body"] + 2)] & 255) == 100 {
                    return false
                }
            }
        }
        if (bytes["" + name["body"]] & 255) == 203 {
            if (bytes["" + (name["body"] + 1)] & 255) == 0 {
                if (bytes["" + (name["body"] + 2)] & 255) == 113 {
                    return false
                }
            }
        }
        if (bytes["" + name["body"]] & 255) == 198 {
            if (bytes["" + (name["body"] + 1)] & 254) == 18 {
                return false
            }
        }
        if (bytes["" + name["body"]] & 255) == 192 {
            if (bytes["" + (name["body"] + 1)] & 255) == 0 {
                if (bytes["" + (name["body"] + 2)] & 255) == 0 {
                    return false
                }
            }
        }
        if (bytes["" + name["body"]] & 255) == 192 {
            if (bytes["" + (name["body"] + 1)] & 255) == 88 {
                if (bytes["" + (name["body"] + 2)] & 255) == 99 {
                    return false
                }
            }
        }
        if (bytes["" + name["body"]] & 240) == 240 {
            return false
        }
        if (bytes["" + name["body"]] & 255) == 0 {
            return false
        }
        if (bytes["" + name["body"]] & 255) == 192 {
            if (bytes["" + (name["body"] + 1)] & 255) == 31 {
                if (bytes["" + (name["body"] + 2)] & 255) == 196 {
                    return false
                }
            }
        }
        if (bytes["" + name["body"]] & 255) == 192 {
            if (bytes["" + (name["body"] + 1)] & 255) == 52 {
                if (bytes["" + (name["body"] + 2)] & 255) == 193 {
                    return false
                }
            }
        }
        if (bytes["" + name["body"]] & 255) == 192 {
            if (bytes["" + (name["body"] + 1)] & 255) == 175 {
                if (bytes["" + (name["body"] + 2)] & 255) == 48 {
                    return false
                }
            }
        }
        if (bytes["" + name["body"]] & 255) == 255 {
            return false
        }
        n = n + 1
        i = name["end"]
    }
    return n == 1
}

pub fn tls13PeerN12Extn(bytes, extn) {
    if extn == false || extn["tag"] != 48 {
        return false
    }
    let oid = cryptoDerTlv(bytes, extn["body"])
    if tls13PeerSanOid(bytes, oid) != true {
        return false
    }
    let next = cryptoDerTlv(bytes, oid["end"])
    if next == false {
        return false
    }
    if next["tag"] == 1 {
        next = cryptoDerTlv(bytes, next["end"])
        if next == false {
            return false
        }
    }
    if next["tag"] != 4 || next["end"] != extn["end"] {
        return false
    }
    let san = cryptoDerTlv(bytes, next["body"])
    if san == false || san["tag"] != 48 || san["end"] != next["end"] {
        return false
    }
    return tls13PeerSanN12Loop(bytes, san)
}

pub fn tls13PeerN12Exts(bytes, exts) {
    if exts == false || exts["tag"] != 48 {
        return false
    }
    let i = exts["body"]
    while i < exts["end"] {
        let extn = cryptoDerTlv(bytes, i)
        if extn == false {
            return false
        }
        if tls13PeerN12Extn(bytes, extn) == true {
            return true
        }
        i = extn["end"]
    }
    return false
}

pub fn tls13PeerN12AfterSpki(bytes, tbs, spki) {
    let i = spki["end"]
    while i < tbs["end"] {
        let item = cryptoDerTlv(bytes, i)
        if item == false {
            return false
        }
        if item["tag"] == 163 {
            let inner = cryptoDerTlv(bytes, item["body"])
            if inner == false || inner["end"] != item["end"] {
                return false
            }
            return tls13PeerN12Exts(bytes, inner)
        }
        i = item["end"]
    }
    return false
}

pub fn tls13PeerN12EvalOk(port) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false {
        tcp_close(s["sock"])
        return false
    }
    let der = tls13PeerCertDer(s["cert"])
    tcp_close(s["sock"])
    if der == false {
        return false
    }
    let outer = cryptoDerTlv(der, 0)
    if outer == false || outer["tag"] != 48 || outer["end"] != der["n"] {
        return false
    }
    let tbs = cryptoDerTlv(der, outer["body"])
    if tbs == false || tbs["tag"] != 48 {
        return false
    }
    let first = cryptoDerTlv(der, tbs["body"])
    if first == false {
        return false
    }
    let serialOff = tbs["body"]
    if first["tag"] == 160 {
        serialOff = first["end"]
    }
    let serial = cryptoDerTlv(der, serialOff)
    if serial == false || serial["tag"] != 2 {
        return false
    }
    let innerAlg = cryptoDerTlv(der, serial["end"])
    if innerAlg == false || innerAlg["tag"] != 48 {
        return false
    }
    let issuer = cryptoDerTlv(der, innerAlg["end"])
    if issuer == false || issuer["tag"] != 48 {
        return false
    }
    let validity = cryptoDerTlv(der, issuer["end"])
    if validity == false || validity["tag"] != 48 {
        return false
    }
    let subject = cryptoDerTlv(der, validity["end"])
    if subject == false || subject["tag"] != 48 {
        return false
    }
    let spki = cryptoDerTlv(der, subject["end"])
    if spki == false || spki["tag"] != 48 {
        return false
    }
    return tls13PeerN12AfterSpki(der, tbs, spki)
}