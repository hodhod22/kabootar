// SH23: Parameterized Kab TLS 1.3 SAN iPAddress length rejection vs rustls P-256 peer.
// Replaces the growing family of near-identical crypto_tls13_peer_n*.kab files:
// a single validator parameterized on the invalid iPAddress length under test.
// Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_san_gen"
import "kab/crypto/crypto_tls13_peer_san"
import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_root"

// Loop: every SAN name must be iPAddress tag 135; badLen entries are rejected;
// all other entries must be valid 127.0.0.1/4 per the generalized validator.
pub fn tls13PeerSanNLenLoop(bytes, san, badLen) {
    if san == false || san["tag"] != 48 || san["body"] >= san["end"] {
        return false
    }
    let i = san["body"]
    let n = 0
    while i < san["end"] {
        let name = cryptoDerTlv(bytes, i)
        if name == false {
            return false
        }
        if name["tag"] != 135 {
            return false
        }
        if name["len"] == badLen {
            return false
        }
        if tls13PeerSanValidateIp4(bytes, name) != true {
            return false
        }
        n = n + 1
        i = name["end"]
    }
    return n == 1
}

pub fn tls13PeerNLenExtn(bytes, extn, badLen) {
    if extn == false || extn["tag"] != 48 {
        return false
    }
    let oid = cryptoDerTlv(bytes, extn["body"])
    if tls13PeerSanOid(bytes, oid) != true {
        return false
    }
    let next = cryptoDerTlv(bytes, oid["end"])
    if next == false {
        return false
    }
    if next["tag"] == 1 {
        next = cryptoDerTlv(bytes, next["end"])
        if next == false {
            return false
        }
    }
    if next["tag"] != 4 || next["end"] != extn["end"] {
        return false
    }
    let san = cryptoDerTlv(bytes, next["body"])
    if san == false || san["tag"] != 48 || san["end"] != next["end"] {
        return false
    }
    return tls13PeerSanNLenLoop(bytes, san, badLen)
}

pub fn tls13PeerNLenExts(bytes, exts, badLen) {
    if exts == false || exts["tag"] != 48 {
        return false
    }
    let i = exts["body"]
    while i < exts["end"] {
        let extn = cryptoDerTlv(bytes, i)
        if extn == false {
            return false
        }
        if tls13PeerNLenExtn(bytes, extn, badLen) == true {
            return true
        }
        i = extn["end"]
    }
    return false
}

pub fn tls13PeerNLenAfterSpki(bytes, tbs, spki, badLen) {
    let i = spki["end"]
    while i < tbs["end"] {
        let item = cryptoDerTlv(bytes, i)
        if item == false {
            return false
        }
        if item["tag"] == 163 {
            let inner = cryptoDerTlv(bytes, item["body"])
            if inner == false || inner["end"] != item["end"] {
                return false
            }
            return tls13PeerNLenExts(bytes, inner, badLen)
        }
        i = item["end"]
    }
    return false
}

// Evaluate: connect to rustls peer, parse cert chain, verify SAN iPAddress.
// badLen: iPAddress length that must be rejected (e.g. 11, 12, 13, 14, 15, 16).
pub fn tls13PeerNLenEvalOk(port, badLen) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false {
        tcp_close(s["sock"])
        return false
    }
    let der = tls13PeerCertDer(s["cert"])
    tcp_close(s["sock"])
    if der == false {
        return false
    }
    let outer = cryptoDerTlv(der, 0)
    if outer == false || outer["tag"] != 48 || outer["end"] != der["n"] {
        return false
    }
    let tbs = cryptoDerTlv(der, outer["body"])
    if tbs == false || tbs["tag"] != 48 {
        return false
    }
    let first = cryptoDerTlv(der, tbs["body"])
    if first == false {
        return false
    }
    let serialOff = tbs["body"]
    if first["tag"] == 160 {
        serialOff = first["end"]
    }
    let serial = cryptoDerTlv(der, serialOff)
    if serial == false || serial["tag"] != 2 {
        return false
    }
    let innerAlg = cryptoDerTlv(der, serial["end"])
    if innerAlg == false || innerAlg["tag"] != 48 {
        return false
    }
    let issuer = cryptoDerTlv(der, innerAlg["end"])
    if issuer == false || issuer["tag"] != 48 {
        return false
    }
    let validity = cryptoDerTlv(der, issuer["end"])
    if validity == false || validity["tag"] != 48 {
        return false
    }
    let subject = cryptoDerTlv(der, validity["end"])
    if subject == false || subject["tag"] != 48 {
        return false
    }
    let spki = cryptoDerTlv(der, subject["end"])
    if spki == false || spki["tag"] != 48 {
        return false
    }
    return tls13PeerNLenAfterSpki(der, tbs, spki, badLen)
}