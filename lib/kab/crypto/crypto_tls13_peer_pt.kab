// SH23: Kab TLS 1.3 leaf SPKI uncompressed P-256 point vs rustls peer.
// Do not grow crypto_tls13_peer_p256.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_p256"
import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_root"

pub fn tls13PeerPtOk(bytes, spki) {
    if tls13PeerSpkiP256Ok(bytes, spki) != true {
        return false
    }
    let alg = cryptoDerTlv(bytes, spki["body"])
    let bits = cryptoDerTlv(bytes, alg["end"])
    if bits == false || bits["tag"] != 3 || bits["len"] != 66 {
        return false
    }
    if bits["end"] != spki["end"] {
        return false
    }
    if (bytes["" + bits["body"]] & 255) != 0 {
        return false
    }
    return (bytes["" + (bits["body"] + 1)] & 255) == 4
}

pub fn tls13PeerPtEvalOk(port) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false {
        tcp_close(s["sock"])
        return false
    }
    let der = tls13PeerCertDer(s["cert"])
    tcp_close(s["sock"])
    if der == false {
        return false
    }
    let outer = cryptoDerTlv(der, 0)
    if outer == false || outer["tag"] != 48 || outer["end"] != der["n"] {
        return false
    }
    let tbs = cryptoDerTlv(der, outer["body"])
    if tbs == false || tbs["tag"] != 48 {
        return false
    }
    let first = cryptoDerTlv(der, tbs["body"])
    if first == false {
        return false
    }
    let serialOff = tbs["body"]
    if first["tag"] == 160 {
        serialOff = first["end"]
    }
    let serial = cryptoDerTlv(der, serialOff)
    if serial == false || serial["tag"] != 2 {
        return false
    }
    let innerAlg = cryptoDerTlv(der, serial["end"])
    if innerAlg == false || innerAlg["tag"] != 48 {
        return false
    }
    let issuer = cryptoDerTlv(der, innerAlg["end"])
    if issuer == false || issuer["tag"] != 48 {
        return false
    }
    let validity = cryptoDerTlv(der, issuer["end"])
    if validity == false || validity["tag"] != 48 {
        return false
    }
    let subject = cryptoDerTlv(der, validity["end"])
    if subject == false || subject["tag"] != 48 {
        return false
    }
    let spki = cryptoDerTlv(der, subject["end"])
    return tls13PeerPtOk(der, spki)
}
