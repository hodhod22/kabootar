// SH23: Kab TLS 1.3 Certificate message all-certs walk vs rustls P-256 peer.
// Iterates every certificate entry in the TLS Certificate message and verifies
// each DER is a well-formed SEQUENCE of { tbsCertificate, sigAlg, sigBits }.
// Do not grow crypto_tls13_peer_chain.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_root"

// Extract one cert DER from the chain list body, returning {der, nextOff} or false.
pub fn tls13PeerChainDerAt(bytes, off, end) {
    if off + 3 > end {
        return false
    }
    let certLen = ((bytes["" + off] << 16) | (bytes["" + (off + 1)] << 8) | bytes["" + (off + 2)]) & 16777215
    if off + 3 + certLen > end {
        return false
    }
    if certLen < 1 {
        return false
    }
    let der = {}
    let i = 0
    while i < certLen {
        der["" + i] = bytes["" + (off + 3 + i)] & 255
        i = i + 1
    }
    der["n"] = certLen
    let o = {}
    o["der"] = der
    o["nextOff"] = off + 3 + certLen
    return o
}

// Validate one cert's inner X.509 structure.
pub fn tls13PeerChainCertOk(der) {
    let outer = cryptoDerTlv(der, 0)
    if outer == false || outer["tag"] != 48 || outer["end"] != der["n"] {
        return false
    }
    let tbs = cryptoDerTlv(der, outer["body"])
    if tbs == false || tbs["tag"] != 48 {
        return false
    }
    let alg = cryptoDerTlv(der, tbs["end"])
    if alg == false || alg["tag"] != 48 {
        return false
    }
    let sig = cryptoDerTlv(der, alg["end"])
    if sig == false || sig["tag"] != 3 {
        return false
    }
    return sig["end"] == outer["end"]
}

// Iterate all certs in a TLS Certificate message body.
pub fn tls13PeerChainAllOk(message) {
    let body = tlsHsParseOne(message, 11)
    if body == false || body["n"] < 4 {
        return false
    }
    let ctxLen = body["0"] & 255
    if 1 + ctxLen + 3 > body["n"] {
        return false
    }
    let listOff = 1 + ctxLen
    let listLen = ((body["" + listOff] << 16) | (body["" + (listOff + 1)] << 8) | body["" + (listOff + 2)]) & 16777215
    if listOff + 3 + listLen != body["n"] {
        return false
    }
    let i = listOff + 3
    let finish = listOff + 3 + listLen
    let n = 0
    while i < finish {
        let r = tls13PeerChainDerAt(body, i, finish)
        if r == false {
            return false
        }
        if tls13PeerChainCertOk(r["der"]) != true {
            return false
        }
        n = n + 1
        i = r["nextOff"]
    }
    if i != finish {
        return false
    }
    return n >= 1
}

pub fn tls13PeerChainAllEvalOk(port) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false {
        tcp_close(s["sock"])
        return false
    }
    let ok = tls13PeerChainAllOk(s["cert"])
    tcp_close(s["sock"])
    return ok
}