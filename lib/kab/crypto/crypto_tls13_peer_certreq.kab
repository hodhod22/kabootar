// SH23: Kab TLS 1.3 CertificateRequest absent check vs rustls P-256 peer.
// Verifies server does not request client certificate (no CertificateRequest).
// Do not grow crypto_tls13_peer_crl.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_tls_hs"

pub fn tls13PeerCertReqEvalOk(port) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    // If we got ServerHello, EncryptedExtensions, Certificate, CertificateVerify,
    // Finished without CertificateRequest, the server did not request client auth.
    if s["cert"] == false || s["cv"] == false {
        tcp_close(s["sock"])
        return false
    }
    tcp_close(s["sock"])
    return true
}