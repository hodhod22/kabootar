// SH23: Kab TLS 1.3 leaf CN no uppercase vs rustls P-256 peer.
// Do not grow crypto_tls13_peer_pun.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_pun"
import "kab/crypto/crypto_tls13_peer_cnb"
import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_root"

pub fn tls13PeerCnNoUpc(bytes, value) {
    if value == false || value["tag"] != 12 || value["len"] < 1 {
        return false
    }
    let i = 0
    while i < value["len"] {
        let b = bytes["" + (value["body"] + i)] & 255
        if b >= 65 && b <= 90 {
            return false
        }
        i = i + 1
    }
    return true
}

pub fn tls13PeerUpcName(bytes, name) {
    if name == false || name["tag"] != 48 {
        return false
    }
    let i = name["body"]
    while i < name["end"] {
        let rdn = cryptoDerTlv(bytes, i)
        if rdn == false || rdn["tag"] != 49 {
            return false
        }
        let j = rdn["body"]
        while j < rdn["end"] {
            let attr = cryptoDerTlv(bytes, j)
            if attr == false {
                return false
            }
            let value = tls13PeerCnUtf8Value(bytes, attr)
            if tls13PeerCnNoUpc(bytes, value) == true {
                return true
            }
            j = attr["end"]
        }
        i = rdn["end"]
    }
    return false
}

pub fn tls13PeerUpcEvalOk(port) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false {
        tcp_close(s["sock"])
        return false
    }
    let der = tls13PeerCertDer(s["cert"])
    tcp_close(s["sock"])
    if der == false {
        return false
    }
    let outer = cryptoDerTlv(der, 0)
    if outer == false || outer["tag"] != 48 || outer["end"] != der["n"] {
        return false
    }
    let tbs = cryptoDerTlv(der, outer["body"])
    if tbs == false || tbs["tag"] != 48 {
        return false
    }
    let first = cryptoDerTlv(der, tbs["body"])
    if first == false {
        return false
    }
    let serialOff = tbs["body"]
    if first["tag"] == 160 {
        serialOff = first["end"]
    }
    let serial = cryptoDerTlv(der, serialOff)
    if serial == false || serial["tag"] != 2 {
        return false
    }
    let innerAlg = cryptoDerTlv(der, serial["end"])
    if innerAlg == false || innerAlg["tag"] != 48 {
        return false
    }
    let issuer = cryptoDerTlv(der, innerAlg["end"])
    if issuer == false || issuer["tag"] != 48 {
        return false
    }
    let validity = cryptoDerTlv(der, issuer["end"])
    if validity == false || validity["tag"] != 48 {
        return false
    }
    let subject = cryptoDerTlv(der, validity["end"])
    return tls13PeerUpcName(der, subject)
}
