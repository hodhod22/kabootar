// SH23: Kab TLS 1.2 ClientHello against a rustls TLS 1.2 peer (no sess["server"]).
// Do not import crypto_tls_live. Host rustls remains skuld.

import "kab/crypto/crypto_tls_hs"
import "kab/crypto/crypto_tls_prf"
import "kab/crypto/crypto_hmac_eval"

/// Named-curve ServerKeyExchange from a rustls TLS 1.2 peer (X25519 or secp256r1).
pub fn tlsPeerParseSke(message) {
    let body = tlsHsParseOne(message, 12)
    if body == false || body["n"] < 8 {
        return false
    }
    if (body["0"] & 255) != 3 {
        return false
    }
    let group = ((body["1"] << 8) | body["2"]) & 65535
    let pubLen = body["3"] & 255
    if pubLen < 1 {
        return false
    }
    if 4 + pubLen + 4 > body["n"] {
        return false
    }
    if group == 29 {
        if pubLen != 32 {
            return false
        }
    } else {
        if group != 23 {
            return false
        }
        if pubLen != 65 {
            return false
        }
        if (body["4"] & 255) != 4 {
            return false
        }
    }
    let sigOff = 4 + pubLen
    let sigAlg = ((body["" + sigOff] << 8) | body["" + (sigOff + 1)]) & 65535
    if sigAlg != 1027 {
        if sigAlg != 1025 {
            return false
        }
    }
    let sigLen = ((body["" + (sigOff + 2)] << 8) | body["" + (sigOff + 3)]) & 65535
    if sigLen < 1 || sigOff + 4 + sigLen != body["n"] {
        return false
    }
    let publicKey = {}
    let i = 0
    while i < pubLen {
        publicKey["" + i] = body["" + (4 + i)] & 255
        i = i + 1
    }
    publicKey["n"] = pubLen
    return { publicKey: publicKey, group: group, signatureLength: sigLen }
}

/// Skip rustls NewSessionTicket handshake records, then read ChangeCipherSpec.
pub fn tlsPeerReadCcs(sock) {
    let k = 0
    while k < 8 {
        let head = tlsHsReadBytesExact(sock, 5)
        if head == false {
            return false
        }
        let typ = head["0"] & 255
        let size = ((head["3"] << 8) | head["4"]) & 65535
        if size < 1 || size > 16384 {
            return false
        }
        let payload = tlsHsReadBytesExact(sock, size)
        if payload == false {
            return false
        }
        if typ == 20 {
            if size != 1 {
                return false
            }
            if (payload["0"] & 255) != 1 {
                return false
            }
            return true
        }
        if typ != 22 {
            return false
        }
        k = k + 1
    }
    return false
}

/// Connect, write ClientHello, parse rustls ServerHello through ServerHelloDone.
pub fn tlsPeerHelloEvalOk(port) {
    let clientRandom = hmacStrBytes("CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC")
    let clientHello = tlsHsWrap(
        1,
        tlsConcatObj(
            tlsHexToObj("0303"),
            tlsConcatObj(
                clientRandom,
                tlsHexToObj("000004009cc02b0100001d000a00040002001d000b00020100000d0006000404010403ff01000100")
            )
        )
    )
    let sock = tcp_connect("127.0.0.1", port)
    if sock == false {
        return false
    }
    tcp_write_bytes(sock, tlsRecordHs(clientHello))
    let buf = {}
    buf["n"] = 0
    let receivedServer = tlsHsReadNextHs(sock, buf)
    if receivedServer == false {
        tcp_close(sock)
        return false
    }
    let parsed = tlsHsParseServerHello(receivedServer)
    if parsed == false {
        tcp_close(sock)
        return false
    }
    if parsed["cipher"] != 49195 {
        tcp_close(sock)
        return false
    }
    let receivedCert = tlsHsReadNextHs(sock, buf)
    if receivedCert == false {
        tcp_close(sock)
        return false
    }
    let cert = tlsHsParseCertificate(receivedCert)
    if cert == false {
        tcp_close(sock)
        return false
    }
    if cert["n"] < 64 {
        tcp_close(sock)
        return false
    }
    if (cert["0"] & 255) != 48 {
        tcp_close(sock)
        return false
    }
    let receivedSke = tlsHsReadNextHs(sock, buf)
    if receivedSke == false {
        tcp_close(sock)
        return false
    }
    let ske = tlsPeerParseSke(receivedSke)
    if ske == false {
        tcp_close(sock)
        return false
    }
    let receivedDone = tlsHsReadNextHs(sock, buf)
    tcp_close(sock)
    if receivedDone == false {
        return false
    }
    if (receivedDone["0"] & 255) != 14 {
        return false
    }
    let doneBody = tlsHsParseOne(receivedDone, 14)
    if doneBody == false {
        return false
    }
    if doneBody["n"] != 0 {
        return false
    }
    return true
}
