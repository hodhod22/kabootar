// SH23: Kab TLS 1.3 client POST support vs rustls P-256 peer.
// Do not grow crypto_tls13_client.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_client"
import "kab/crypto/crypto_tls13_peer_get"
import "kab/crypto/crypto_http_get"

pub fn tls13ClientPost(session, path, body) {
    if session == false {
        return false
    }
    if session["host"] != "127.0.0.1" {
        return false
    }
    let req = httpBuildPost(session["host"], path, body, "application/x-www-form-urlencoded")
    if req == false {
        tcp_close(session["sock"])
        return false
    }
    let resp = tls13PeerAppAfterHs(session, req)
    if resp == false {
        return false
    }
    if httpStatusCode(resp) != 200 {
        return false
    }
    return httpRespBody(resp)
}