// SH23: host rustls delete policy off crypto.kab. import "kab/crypto/crypto_host"
// Do not grow crypto.kab. Do not delete runtime/security until smoke is complete.

import "kab/crypto/crypto_tls13_all"

/// Live re-verification path: runs the full rustls-peer aggregate only
/// when the harness declares peers (KAB_TLS_PEERS=1); deterministically
/// false without peers instead of dying on tcp_connect.
pub fn cryptoTlsPeerEvidenceOk() {
    if env_get("KAB_TLS_PEERS") != "1" {
        return false
    }
    return cryptoTls13AllOk()
}

/// Gate opens only when the harness declares live TLS peers (KAB_TLS_PEERS=1)
/// and the full aggregate suite passes. Without peers it stays deterministically
/// closed instead of dying on tcp_connect.
pub fn cryptoHostDeleteOk() {
    return cryptoTlsPeerEvidenceOk()
}
