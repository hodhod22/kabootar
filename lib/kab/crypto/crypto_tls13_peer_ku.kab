// SH23: Kab TLS 1.3 leaf keyUsage digitalSignature vs rustls P-256 peer.
// Do not grow crypto_tls13_peer_time.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_root"

pub fn tls13PeerKuOid(bytes, oid) {
    if oid == false || oid["tag"] != 6 || oid["len"] != 3 {
        return false
    }
    if (bytes["" + oid["body"]] & 255) != 85 {
        return false
    }
    if (bytes["" + (oid["body"] + 1)] & 255) != 29 {
        return false
    }
    return (bytes["" + (oid["body"] + 2)] & 255) == 15
}

pub fn tls13PeerKuBits(bytes, bits) {
    if bits == false || bits["tag"] != 3 || bits["len"] < 2 {
        return false
    }
    let unused = bytes["" + bits["body"]] & 255
    if unused > 7 {
        return false
    }
    let first = bytes["" + (bits["body"] + 1)] & 255
    return (first & 128) == 128
}

pub fn tls13PeerKuExtn(bytes, extn) {
    if extn == false || extn["tag"] != 48 {
        return false
    }
    let oid = cryptoDerTlv(bytes, extn["body"])
    if tls13PeerKuOid(bytes, oid) != true {
        return false
    }
    let next = cryptoDerTlv(bytes, oid["end"])
    if next == false {
        return false
    }
    if next["tag"] == 1 {
        next = cryptoDerTlv(bytes, next["end"])
        if next == false {
            return false
        }
    }
    if next["tag"] != 4 || next["end"] != extn["end"] {
        return false
    }
    let bits = cryptoDerTlv(bytes, next["body"])
    if bits == false || bits["end"] != next["end"] {
        return false
    }
    return tls13PeerKuBits(bytes, bits)
}

pub fn tls13PeerKuExts(bytes, exts) {
    if exts == false || exts["tag"] != 48 {
        return false
    }
    let i = exts["body"]
    while i < exts["end"] {
        let extn = cryptoDerTlv(bytes, i)
        if extn == false {
            return false
        }
        if tls13PeerKuExtn(bytes, extn) == true {
            return true
        }
        i = extn["end"]
    }
    return false
}

pub fn tls13PeerKuAfterSpki(bytes, tbs, spki) {
    let i = spki["end"]
    while i < tbs["end"] {
        let item = cryptoDerTlv(bytes, i)
        if item == false {
            return false
        }
        if item["tag"] == 163 {
            let inner = cryptoDerTlv(bytes, item["body"])
            if inner == false || inner["end"] != item["end"] {
                return false
            }
            return tls13PeerKuExts(bytes, inner)
        }
        i = item["end"]
    }
    return false
}

pub fn tls13PeerKuEvalOk(port) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false {
        tcp_close(s["sock"])
        return false
    }
    let der = tls13PeerCertDer(s["cert"])
    tcp_close(s["sock"])
    if der == false {
        return false
    }
    let outer = cryptoDerTlv(der, 0)
    if outer == false || outer["tag"] != 48 || outer["end"] != der["n"] {
        return false
    }
    let tbs = cryptoDerTlv(der, outer["body"])
    if tbs == false || tbs["tag"] != 48 {
        return false
    }
    let first = cryptoDerTlv(der, tbs["body"])
    if first == false {
        return false
    }
    let serialOff = tbs["body"]
    if first["tag"] == 160 {
        serialOff = first["end"]
    }
    let serial = cryptoDerTlv(der, serialOff)
    if serial == false || serial["tag"] != 2 {
        return false
    }
    let innerAlg = cryptoDerTlv(der, serial["end"])
    if innerAlg == false || innerAlg["tag"] != 48 {
        return false
    }
    let issuer = cryptoDerTlv(der, innerAlg["end"])
    if issuer == false || issuer["tag"] != 48 {
        return false
    }
    let validity = cryptoDerTlv(der, issuer["end"])
    if validity == false || validity["tag"] != 48 {
        return false
    }
    let subject = cryptoDerTlv(der, validity["end"])
    if subject == false || subject["tag"] != 48 {
        return false
    }
    let spki = cryptoDerTlv(der, subject["end"])
    if spki == false || spki["tag"] != 48 {
        return false
    }
    return tls13PeerKuAfterSpki(der, tbs, spki)
}
