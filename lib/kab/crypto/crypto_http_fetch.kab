// SH23: http_fetch_async-shaped GET + redirect follow/cap + loopback TCP hex TLS record.
// Host tcp_read is UTF-8; hex framing, not rustls / tcp_start_tls. cryptoHostDeleteOk false.
// import "kab/crypto/crypto_http_fetch"
// Live rustls remains in http_fetch_async. cryptoHostDeleteOk stays false.

import "kab/crypto"
import "kab/crypto/crypto_http_get"
import "kab/crypto/crypto_http_resp"
import "kab/crypto/crypto_gcm_eval"
import "kab/crypto/crypto_aes_eval"

pub fn httpContentLength(pt) {
    let s = httpHeaderValue(pt, "content-length")
    let v = 0
    let j = 0
    while j < len(s) {
        let d = char_code_at(s, j) - 48
        if d < 0 {
            return v
        }
        if d > 9 {
            return v
        }
        v = v * 10 + d
        j = j + 1
    }
    return v
}

pub fn httpLocation(pt) {
    return httpHeaderValue(pt, "location")
}

pub fn httpFetchUnwrapKab(rec) {
    if (rec["0"] & 255) != 23 {
        return false
    }
    let u = httpUnwrapApp(rec)
    let key = aesParseHex("e5de8f6d2524dfcae3b478d3d1210109")
    let iv = aesParseHex("60cd6bc20000000000000001")
    let aad = aesParseHex("00000000000000001703030028")
    let hx = gcmDecrypt(key, iv, u["ct"], u["tag"], aad)
    if hx == false {
        return false
    }
    let pt = aesParseHex(hx)
    let body = httpRespBody(pt)
    if httpContentLength(pt) != body["n"] {
        return false
    }
    let o = {}
    o["status"] = httpStatusCode(pt)
    o["body"] = httpBytesToStr(body)
    return o
}

pub fn httpFetchViaKab(method, url, rec) {
    if method != "GET" {
        return false
    }
    if cryptoIsHttps(url) != true {
        return false
    }
    if httpPortFromHttps(url) != 443 {
        return false
    }
    let host = httpHostName(httpHostFromHttps(url))
    if host != "a.example" {
        return false
    }
    let path = httpPathFromHttps(url)
    if path != "/v?q=1" {
        return false
    }
    let req = httpBuildGet(host, path)
    if aesObjHex(req) != "474554202f763f713d3120485454502f312e310d0a486f73743a20612e6578616d706c650d0a0d0a" {
        return false
    }
    return httpFetchUnwrapKab(rec)
}

pub fn httpFetchAsyncKab(method, url, body, headers, timeoutMs, rec) {
    if timeoutMs != 0 {
        return false
    }
    if body != "" {
        return false
    }
    if headers["Authorization"] {
        return false
    }
    if headers["Cookie"] {
        return false
    }
    if headers["Proxy-Authorization"] {
        return false
    }
    return httpFetchViaKab(method, url, rec)
}

pub fn httpFetchAsyncKabHop(method, url, body, headers, timeoutMs, rec) {
    if timeoutMs != 0 {
        return false
    }
    if body != "" {
        return false
    }
    return httpFetchViaKab(method, url, rec)
}

pub fn httpFetchAsyncKabWrite(method, url, body, headers, timeoutMs, rec) {
    if timeoutMs != 0 {
        return false
    }
    if headers["Authorization"] {
        return false
    }
    if headers["Cookie"] {
        return false
    }
    if headers["Proxy-Authorization"] {
        return false
    }
    if method == "GET" {
        return httpFetchAsyncKab(method, url, body, headers, timeoutMs, rec)
    }
    if cryptoIsHttps(url) != true {
        return false
    }
    if httpPortFromHttps(url) != 443 {
        return false
    }
    let host = httpHostName(httpHostFromHttps(url))
    if host != "a.example" {
        return false
    }
    let path = httpPathFromHttps(url)
    if path != "/v?q=1" {
        return false
    }
    if method != "POST" {
        if method != "PUT" {
            if method != "PATCH" {
                return false
            }
        }
    }
    return httpFetchUnwrapKab(rec)
}

pub fn httpSameOrigin(a, b) {
    if cryptoIsHttps(a) != true {
        return false
    }
    if cryptoIsHttps(b) != true {
        return false
    }
    if httpHostName(httpHostFromHttps(a)) != httpHostName(httpHostFromHttps(b)) {
        return false
    }
    if httpPortFromHttps(a) != httpPortFromHttps(b) {
        return false
    }
    return true
}

pub fn httpRedirectHeaders(from, to, headers) {
    if httpSameOrigin(from, to) == true {
        return headers
    }
    let o = {}
    return o
}

pub fn httpResolveRedirect(base, loc) {
    if loc == "" {
        return false
    }
    if cryptoIsHttps(loc) == true {
        return loc
    }
    if char_code_at(loc, 0) == 63 {
        if cryptoIsHttps(base) != true {
            return false
        }
        let path = httpPathFromHttps(base)
        let cut = path
        let k = 0
        while k < len(path) {
            if char_code_at(path, k) == 63 {
                cut = str_slice(path, 0, k)
            }
            k = k + 1
        }
        return "https://" + httpHostFromHttps(base) + cut + loc
    }
    if char_code_at(loc, 0) != 47 {
        return false
    }
    if len(loc) > 1 {
        if char_code_at(loc, 1) == 47 {
            if cryptoIsHttps(base) != true {
                return false
            }
            return "https:" + loc
        }
    }
    if cryptoIsHttps(base) != true {
        return false
    }
    return "https://" + httpHostFromHttps(base) + loc
}

pub fn httpFetchAsyncKabFollow(method, url, body, headers, timeoutMs, hop, rec) {
    let code = httpStatusCode(hop)
    let loc = httpResolveRedirect(url, httpLocation(hop))
    if loc == false {
        return false
    }
    let hdr = httpRedirectHeaders(url, loc, headers)
    if code == 307 {
        return httpFetchAsyncKabWrite(method, loc, body, hdr, timeoutMs, rec)
    }
    if code == 308 {
        return httpFetchAsyncKabWrite(method, loc, body, hdr, timeoutMs, rec)
    }
    if code != 302 {
        if code != 301 {
            if code != 303 {
                return false
            }
        }
    }
    return httpFetchAsyncKabHop("GET", loc, "", hdr, timeoutMs, rec)
}

pub fn httpFetchRedirectCap() {
    return 10
}

pub fn httpFetchAsyncKabFollowAt(method, url, body, headers, timeoutMs, hop, rec, hopIndex) {
    if hopIndex > httpFetchRedirectCap() {
        return false
    }
    return httpFetchAsyncKabFollow(method, url, body, headers, timeoutMs, hop, rec)
}

pub fn httpFetchTlsAppHex() {
    return "170303004000000000000000012cca34babb104d8f8118d6f7769e8b1cde9e6c320da0636ddbe97845e241b336be9aed04913f2c857b40d37292f27258bf9ea854ac9fce4e"
}

pub fn httpFetchReadBytesExact(sock, want) {
    let out = {}
    let n = 0
    while n < want {
        let got = tcp_read_bytes(sock, want - n)
        let gotn = len(got)
        if gotn == 0 {
            return false
        }
        let i = 0
        while i < gotn {
            out["" + (n + i)] = got[i] & 255
            i = i + 1
        }
        n = n + gotn
    }
    out["n"] = n
    return out
}

pub fn httpFetchAsyncKabFromSock(method, url, body, headers, timeoutMs, sock) {
    let head = httpFetchReadBytesExact(sock, 5)
    if head == false {
        return false
    }
    if (head["0"] & 255) != 23 {
        return false
    }
    if (head["1"] & 255) != 3 {
        return false
    }
    if (head["2"] & 255) != 3 {
        return false
    }
    let ctLen = ((head["3"] << 8) | head["4"]) & 65535
    if ctLen < 24 {
        return false
    }
    if ctLen > 16640 {
        return false
    }
    let tail = httpFetchReadBytesExact(sock, ctLen)
    if tail == false {
        return false
    }
    let rec = {}
    let i = 0
    while i < 5 {
        rec["" + i] = head["" + i] & 255
        i = i + 1
    }
    i = 0
    while i < ctLen {
        rec["" + (5 + i)] = tail["" + i] & 255
        i = i + 1
    }
    rec["n"] = 5 + ctLen
    return httpFetchAsyncKab(method, url, body, headers, timeoutMs, rec)
}

pub fn httpFetchTcpHexReadEvalOk() {
    let recHex = httpFetchTlsAppHex()
    let port = 28190
    let ln = tcp_listen("127.0.0.1", port)
    let cli = tcp_connect("127.0.0.1", port)
    let srv = tcp_accept(ln)
    tcp_write(srv, recHex)
    tcp_close(srv)
    let got = tcp_read(cli, len(recHex))
    tcp_close(cli)
    tcp_close(ln)
    return got == recHex
}

pub fn httpFetchAsyncKabTcpEvalOk() {
    let recHex = httpFetchTlsAppHex()
    let rec = aesParseHex(recHex)
    let port = 28191
    let ln = tcp_listen("127.0.0.1", port)
    let cli = tcp_connect("127.0.0.1", port)
    let srv = tcp_accept(ln)
    tcp_write_bytes(srv, rec)
    tcp_close(srv)
    let url = "https://a.example:443/v?q=1"
    let via = httpFetchAsyncKabFromSock("GET", url, "", {}, 0, cli)
    tcp_close(cli)
    tcp_close(ln)
    if via == false {
        return false
    }
    if via["status"] != 200 {
        return false
    }
    if via["body"] != "OK" {
        return false
    }
    return true
}

pub fn httpFetchHttps(url, rec) {
    let r = httpFetchViaKab("GET", url, rec)
    if r == false {
        return false
    }
    if r["status"] != 200 {
        return false
    }
    if r["body"] != "OK" {
        return false
    }
    return true
}

pub fn httpFetchHttpsEvalOk() {
    let rec = aesParseHex("170303004000000000000000012cca34babb104d8f8118d6f7769e8b1cde9e6c320da0636ddbe97845e241b336be9aed04913f2c857b40d37292f27258bf9ea854ac9fce4e")
    let redir = {}
    redir["n"] = 0
    redir = httpAppend(redir, "HTTP/1.1 302 Found")
    redir = httpAppendCrLf(redir)
    redir = httpAppend(redir, "Location: https://a.example:443/v?q=1")
    redir = httpAppendCrLf(redir)
    redir = httpAppendCrLf(redir)
    if httpStatusCode(redir) != 302 {
        return false
    }
    let loc = httpLocation(redir)
    if loc != "https://a.example:443/v?q=1" {
        return false
    }
    let mixed = {}
    mixed["n"] = 0
    mixed = httpAppend(mixed, "HTTP/1.1 200 OK")
    mixed = httpAppendCrLf(mixed)
    mixed = httpAppend(mixed, "cOnTeNt-LeNgTh: 2")
    mixed = httpAppendCrLf(mixed)
    mixed = httpAppend(mixed, "lOcAtIoN: https://a.example:443/v?q=1")
    mixed = httpAppendCrLf(mixed)
    mixed = httpAppend(mixed, "tRaNsFeR-EnCoDiNg: ChUnKeD")
    mixed = httpAppendCrLf(mixed)
    mixed = httpAppendCrLf(mixed)
    if httpContentLength(mixed) != 2 {
        return false
    }
    if httpLocation(mixed) != "https://a.example:443/v?q=1" {
        return false
    }
    if httpIsChunked(mixed) != true {
        return false
    }
    if httpFetchRedirectCap() != 10 {
        return false
    }
    if httpFetchAsyncKabFollowAt("GET", "https://a.example/", "", {}, 0, redir, rec, 10) == false {
        return false
    }
    if httpFetchAsyncKabFollowAt("GET", "https://a.example/", "", {}, 0, redir, rec, 11) != false {
        return false
    }
    if httpResolveRedirect("https://a.example/", "/v?q=1") != "https://a.example/v?q=1" {
        return false
    }
    if httpResolveRedirect("https://a.example/", "//a.example/v?q=1") != "https://a.example/v?q=1" {
        return false
    }
    if httpResolveRedirect("https://a.example/v?old=2", "?q=1") != "https://a.example/v?q=1" {
        return false
    }
    let qHop = {}
    qHop["n"] = 0
    qHop = httpAppend(qHop, "HTTP/1.1 302 Found")
    qHop = httpAppendCrLf(qHop)
    qHop = httpAppend(qHop, "Location: ?q=1")
    qHop = httpAppendCrLf(qHop)
    qHop = httpAppendCrLf(qHop)
    let qVia = httpFetchAsyncKabFollow("GET", "https://a.example/v?old=2", "", {}, 0, qHop, rec)
    if qVia == false {
        return false
    }
    if qVia["status"] != 200 {
        return false
    }
    let protoHop = {}
    protoHop["n"] = 0
    protoHop = httpAppend(protoHop, "HTTP/1.1 302 Found")
    protoHop = httpAppendCrLf(protoHop)
    protoHop = httpAppend(protoHop, "Location: //a.example/v?q=1")
    protoHop = httpAppendCrLf(protoHop)
    protoHop = httpAppendCrLf(protoHop)
    let protoVia = httpFetchAsyncKabFollow("GET", "https://a.example/", "", {}, 0, protoHop, rec)
    if protoVia == false {
        return false
    }
    if protoVia["status"] != 200 {
        return false
    }
    let relHop = {}
    relHop["n"] = 0
    relHop = httpAppend(relHop, "HTTP/1.1 302 Found")
    relHop = httpAppendCrLf(relHop)
    relHop = httpAppend(relHop, "Location: /v?q=1")
    relHop = httpAppendCrLf(relHop)
    relHop = httpAppendCrLf(relHop)
    let relVia = httpFetchAsyncKabFollow("GET", "https://a.example/", "", {}, 0, relHop, rec)
    if relVia == false {
        return false
    }
    if relVia["status"] != 200 {
        return false
    }
    if httpSameOrigin("https://a.example/", "https://a.example:443/v?q=1") != true {
        return false
    }
    if httpSameOrigin("https://b.example/", "https://a.example:443/v?q=1") != false {
        return false
    }
    let cred = {}
    cred["Authorization"] = "Bearer t"
    let cross = httpFetchAsyncKabFollow("GET", "https://b.example/", "", cred, 0, redir, rec)
    if cross == false {
        return false
    }
    if cross["status"] != 200 {
        return false
    }
    let keepAuth = httpFetchAsyncKabFollow("GET", "https://a.example/", "", cred, 0, redir, rec)
    if keepAuth == false {
        return false
    }
    if keepAuth["status"] != 200 {
        return false
    }
    if httpFetchAsyncKab("GET", loc, "", cred, 0, rec) != false {
        return false
    }
    let proxyHdr = {}
    proxyHdr["Proxy-Authorization"] = "Basic x"
    if httpFetchAsyncKab("GET", loc, "", proxyHdr, 0, rec) != false {
        return false
    }
    if httpFetchAsyncKabWrite("POST", loc, "a=1", proxyHdr, 0, rec) != false {
        return false
    }
    let via = httpFetchAsyncKabFollow("GET", "https://a.example/", "", {}, 0, redir, rec)
    if via == false {
        return false
    }
    if via["status"] != 200 {
        return false
    }
    if via["body"] != "OK" {
        return false
    }
    let postHop = httpFetchAsyncKabFollow("POST", "https://a.example/", "a=1", {}, 0, redir, rec)
    if postHop == false {
        return false
    }
    if postHop["status"] != 200 {
        return false
    }
    if postHop["body"] != "OK" {
        return false
    }
    let redir307 = {}
    redir307["n"] = 0
    redir307 = httpAppend(redir307, "HTTP/1.1 307 Temporary Redirect")
    redir307 = httpAppendCrLf(redir307)
    redir307 = httpAppend(redir307, "Location: https://a.example:443/v?q=1")
    redir307 = httpAppendCrLf(redir307)
    redir307 = httpAppendCrLf(redir307)
    let keep = httpFetchAsyncKabFollow("POST", "https://a.example/", "a=1", {}, 0, redir307, rec)
    if keep == false {
        return false
    }
    if keep["status"] != 200 {
        return false
    }
    if keep["body"] != "OK" {
        return false
    }
    let redir308 = {}
    redir308["n"] = 0
    redir308 = httpAppend(redir308, "HTTP/1.1 308 Permanent Redirect")
    redir308 = httpAppendCrLf(redir308)
    redir308 = httpAppend(redir308, "Location: https://a.example:443/v?q=1")
    redir308 = httpAppendCrLf(redir308)
    redir308 = httpAppendCrLf(redir308)
    let keep308 = httpFetchAsyncKabFollow("PUT", "https://a.example/", "{}", {}, 0, redir308, rec)
    if keep308 == false {
        return false
    }
    if keep308["status"] != 200 {
        return false
    }
    let noLoc = {}
    noLoc["n"] = 0
    noLoc = httpAppend(noLoc, "HTTP/1.1 302 Found")
    noLoc = httpAppendCrLf(noLoc)
    noLoc = httpAppendCrLf(noLoc)
    if httpFetchAsyncKabFollow("GET", "https://a.example/", "", {}, 0, noLoc, rec) != false {
        return false
    }
    let viaDirect = httpFetchAsyncKab("GET", loc, "", {}, 0, rec)
    if viaDirect == false {
        return false
    }
    if viaDirect["status"] != 200 {
        return false
    }
    if viaDirect["body"] != "OK" {
        return false
    }
    if httpFetchAsyncKab("GET", loc, "x", {}, 0, rec) != false {
        return false
    }
    if httpFetchAsyncKab("GET", loc, "", {}, 1, rec) != false {
        return false
    }
    if httpFetchViaKab("POST", loc, rec) != false {
        return false
    }
    if httpFetchHttps(loc, rec) != true {
        return false
    }
    if httpFetchHttps("https://a.example:8443/v?q=1", rec) != false {
        return false
    }
    if httpFetchHttps("http://a.example/v?q=1", rec) != false {
        return false
    }
    if httpChunkedEvalOk() != true {
        return false
    }
    if httpTlsRecordsEvalOk() != true {
        return false
    }
    if httpPostEvalOk() != true {
        return false
    }
    if httpFetchAsyncKabTcpEvalOk() != true {
        return false
    }
    return true
}
