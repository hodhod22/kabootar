// SH23: TLS 1.2 handshake records + transcript Finished + CertificateVerify MAC.
// import "kab/crypto/crypto_tls_hs"
// Do not grow crypto_tls.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls_prf"
import "kab/crypto/crypto_hmac_eval"
import "kab/crypto/crypto_sha_eval"
import "kab/crypto/crypto_gcm_eval"
import "kab/crypto/crypto_root"

pub fn tlsObjToArr(o) {
    let out = []
    let i = 0
    let n = o["n"]
    while i < n {
        out = push(out, o["" + i] & 255)
        i = i + 1
    }
    return out
}

pub fn tlsObjHex(o) {
    let out = ""
    let i = 0
    let n = o["n"]
    while i < n {
        let b = o["" + i] & 255
        out = out + shaHexDigit((b >>> 4) & 15) + shaHexDigit(b & 15)
        i = i + 1
    }
    return out
}

pub fn tlsHsWrap(typ, body) {
    let n = body["n"]
    let h = {}
    h["0"] = typ
    h["1"] = (n >>> 16) & 255
    h["2"] = (n >>> 8) & 255
    h["3"] = n & 255
    h["n"] = 4
    return tlsConcatObj(h, body)
}

/// Parse exactly one TLS handshake message, rejecting truncated or trailing bytes.
pub fn tlsHsParseOne(msg, expectedType) {
    if msg["n"] < 4 {
        return false
    }
    if (msg["0"] & 255) != expectedType {
        return false
    }
    let bodyLen = ((msg["1"] << 16) | (msg["2"] << 8) | msg["3"]) & 16777215
    if bodyLen != msg["n"] - 4 {
        return false
    }
    let body = {}
    let i = 0
    while i < bodyLen {
        body["" + i] = msg["" + (4 + i)] & 255
        i = i + 1
    }
    body["n"] = bodyLen
    return body
}

pub fn tlsRecordHs(payload) {
    let n = payload["n"]
    let h = {}
    h["0"] = 22
    h["1"] = 3
    h["2"] = 3
    h["3"] = (n >>> 8) & 255
    h["4"] = n & 255
    h["n"] = 5
    return tlsConcatObj(h, payload)
}

/// Read exactly want raw bytes from a TCP socket.
pub fn tlsHsReadBytesExact(sock, want) {
    let out = {}
    let n = 0
    while n < want {
        let got = tcp_read_bytes(sock, want - n)
        let gotn = len(got)
        if gotn == 0 {
            return false
        }
        let i = 0
        while i < gotn {
            out["" + (n + i)] = got[i] & 255
            i = i + 1
        }
        n = n + gotn
    }
    out["n"] = n
    return out
}

/// Read one TLS 1.2 handshake record containing exactly one expected message.
pub fn tlsHsReadRecord(sock, expectedType) {
    let head = tlsHsReadBytesExact(sock, 5)
    if head == false {
        return false
    }
    if (head["0"] & 255) != 22 {
        return false
    }
    if (head["1"] & 255) != 3 || (head["2"] & 255) != 3 {
        return false
    }
    let size = ((head["3"] << 8) | head["4"]) & 65535
    if size < 4 || size > 16384 {
        return false
    }
    let message = tlsHsReadBytesExact(sock, size)
    if message == false {
        return false
    }
    if (message["0"] & 255) != expectedType {
        return false
    }
    let bodyLen = ((message["1"] << 16) | (message["2"] << 8) | message["3"]) & 16777215
    if bodyLen != message["n"] - 4 {
        return false
    }
    return message
}

/// First handshake message in a TLS record (rustls may pack more than one).
pub fn tlsHsReadFirstHs(sock) {
    let head = tlsHsReadBytesExact(sock, 5)
    if head == false {
        return false
    }
    if (head["0"] & 255) != 22 {
        return false
    }
    if (head["1"] & 255) != 3 {
        return false
    }
    let minor = head["2"] & 255
    if minor != 1 {
        if minor != 3 {
            return false
        }
    }
    let size = ((head["3"] << 8) | head["4"]) & 65535
    if size < 4 || size > 16384 {
        return false
    }
    let payload = tlsHsReadBytesExact(sock, size)
    if payload == false {
        return false
    }
    if payload["n"] < 4 {
        return false
    }
    let bodyLen = ((payload["1"] << 16) | (payload["2"] << 8) | payload["3"]) & 16777215
    if 4 + bodyLen > payload["n"] {
        return false
    }
    let message = {}
    let i = 0
    while i < 4 + bodyLen {
        message["" + i] = payload["" + i] & 255
        i = i + 1
    }
    message["n"] = 4 + bodyLen
    return message
}

/// Append src bytes onto a handshake leftover buffer.
pub fn tlsHsBufAppend(buf, src) {
    let n = buf["n"]
    let m = src["n"]
    let i = 0
    while i < m {
        buf["" + (n + i)] = src["" + i] & 255
        i = i + 1
    }
    buf["n"] = n + m
    return buf
}

/// Take one complete handshake message from leftover, or false if truncated.
pub fn tlsHsBufTakeHs(buf) {
    if buf["n"] < 4 {
        return false
    }
    let bodyLen = ((buf["1"] << 16) | (buf["2"] << 8) | buf["3"]) & 16777215
    let total = 4 + bodyLen
    if total > buf["n"] {
        return false
    }
    if total > 16777216 {
        return false
    }
    let message = {}
    let i = 0
    while i < total {
        message["" + i] = buf["" + i] & 255
        i = i + 1
    }
    message["n"] = total
    let rest = buf["n"] - total
    let j = 0
    while j < rest {
        buf["" + j] = buf["" + (total + j)] & 255
        j = j + 1
    }
    buf["n"] = rest
    return message
}

/// One TLS handshake record payload (may contain several messages).
pub fn tlsHsReadHsPayload(sock) {
    let head = tlsHsReadBytesExact(sock, 5)
    if head == false {
        return false
    }
    if (head["0"] & 255) != 22 {
        return false
    }
    if (head["1"] & 255) != 3 {
        return false
    }
    let minor = head["2"] & 255
    if minor != 1 {
        if minor != 3 {
            return false
        }
    }
    let size = ((head["3"] << 8) | head["4"]) & 65535
    if size < 1 || size > 16384 {
        return false
    }
    return tlsHsReadBytesExact(sock, size)
}

/// Next handshake message, spanning rustls-coalesced records.
pub fn tlsHsReadNextHs(sock, buf) {
    let k = 0
    while k < 24 {
        let msg = tlsHsBufTakeHs(buf)
        if msg == false {
            let rec = tlsHsReadHsPayload(sock)
            if rec == false {
                return false
            }
            tlsHsBufAppend(buf, rec)
        } else {
            return msg
        }
        k = k + 1
    }
    return false
}

/// Read the TLS 1.2 ChangeCipherSpec record which enables encrypted handshake records.
pub fn tlsHsReadChangeCipherSpec(sock) {
    let record = tlsHsReadBytesExact(sock, 6)
    if record == false {
        return false
    }
    if (record["0"] & 255) != 20 {
        return false
    }
    if (record["1"] & 255) != 3 || (record["2"] & 255) != 3 {
        return false
    }
    if (record["3"] & 255) != 0 || (record["4"] & 255) != 1 {
        return false
    }
    return (record["5"] & 255) == 1
}

/// Decode the first server AES-GCM protected TLS 1.2 Finished record.
pub fn tlsHsReadEncryptedFinished(sock, key, fixedIv) {
    let head = tlsHsReadBytesExact(sock, 5)
    if head == false {
        return false
    }
    if (head["0"] & 255) != 22 || (head["1"] & 255) != 3 || (head["2"] & 255) != 3 {
        return false
    }
    let size = ((head["3"] << 8) | head["4"]) & 65535
    if size != 40 {
        return false
    }
    let tail = tlsHsReadBytesExact(sock, size)
    if tail == false {
        return false
    }
    let explicitIv = {}
    let ct = {}
    let tag = {}
    let i = 0
    while i < 8 {
        explicitIv["" + i] = tail["" + i] & 255
        i = i + 1
    }
    i = 0
    while i < 16 {
        ct["" + i] = tail["" + (8 + i)] & 255
        tag["" + i] = tail["" + (24 + i)] & 255
        i = i + 1
    }
    explicitIv["n"] = 8
    ct["n"] = 16
    tag["n"] = 16
    let nonce = tlsConcatObj(fixedIv, explicitIv)
    let aad = tlsHexToObj("00000000000000001603030010")
    let plainHex = gcmDecrypt(key, nonce, ct, tag, aad)
    if plainHex == false {
        return false
    }
    let plain = tlsHexToObj(plainHex)
    if tlsHsParseOne(plain, 20) == false {
        return false
    }
    return plain
}

pub fn tlsHsHexSlice(hx, off, n) {
    return tlsHexToObj(str_slice(hx, off + off, off + off + n + n))
}

/// Parse a TLS 1.2 Certificate message and extract exactly one DER certificate.
pub fn tlsHsParseCertificate(message) {
    let body = tlsHsParseOne(message, 11)
    if body == false || body["n"] < 6 {
        return false
    }
    let listLen = ((body["0"] << 16) | (body["1"] << 8) | body["2"]) & 16777215
    if listLen != body["n"] - 3 {
        return false
    }
    let certLen = ((body["3"] << 16) | (body["4"] << 8) | body["5"]) & 16777215
    if certLen < 1 || certLen != body["n"] - 6 {
        return false
    }
    let cert = {}
    let i = 0
    while i < certLen {
        cert["" + i] = body["" + (6 + i)] & 255
        i = i + 1
    }
    cert["n"] = certLen
    return cert
}

/// Parse a complete TLS 1.2 Certificate list into individual DER certificate objects.
pub fn tlsHsParseCertificateChain(message) {
    let body = tlsHsParseOne(message, 11)
    if body == false || body["n"] < 6 {
        return false
    }
    let listLen = ((body["0"] << 16) | (body["1"] << 8) | body["2"]) & 16777215
    if listLen != body["n"] - 3 {
        return false
    }
    let certs = {}
    let at = 3
    let count = 0
    while at < body["n"] {
        if at + 3 > body["n"] {
            return false
        }
        let certLen = ((body["" + at] << 16) | (body["" + (at + 1)] << 8) | body["" + (at + 2)]) & 16777215
        if certLen < 1 || at + 3 + certLen > body["n"] {
            return false
        }
        let cert = {}
        let i = 0
        while i < certLen {
            cert["" + i] = body["" + (at + 3 + i)] & 255
            i = i + 1
        }
        cert["n"] = certLen
        certs["" + count] = cert
        count = count + 1
        at = at + 3 + certLen
    }
    if count < 1 || at != body["n"] {
        return false
    }
    certs["n"] = count
    return certs
}

pub fn tlsHsU24(n) {
    let o = {}
    o["0"] = (n / 65536) | 0
    o["1"] = ((n / 256) | 0) & 255
    o["2"] = n & 255
    o["n"] = 3
    return o
}

/// Wrap DER certificates as a TLS 1.2 Certificate handshake body.
pub fn tlsHsCertificateList(leaf, issuer) {
    let inner = tlsConcatObj(tlsHsU24(leaf["n"]), tlsConcatObj(leaf, tlsConcatObj(tlsHsU24(issuer["n"]), issuer)))
    return tlsConcatObj(tlsHsU24(inner["n"]), inner)
}

/// Validate a leaf/issuer fixture chain received in a TLS Certificate message.
pub fn tlsHsValidateCertificateChain(certs) {
    if certs == false || certs["n"] != 2 {
        return false
    }
    let i = 0
    while i < certs["n"] {
        if cryptoRootDerCert(certs["" + i]) != true {
            return false
        }
        if cryptoRootCertAlgorithmsMatch(certs["" + i]) != true {
            return false
        }
        i = i + 1
    }
    return cryptoRootIssuedRsaFixtureVerify(certs["0"], certs["1"])
}

/// Parse the ECDHE/X25519 framing of a TLS 1.2 ServerKeyExchange message.
pub fn tlsHsParseServerKeyExchange(message) {
    let body = tlsHsParseOne(message, 12)
    if body == false || body["n"] < 41 {
        return false
    }
    if (body["0"] & 255) != 3 {
        return false
    }
    if (body["1"] & 255) != 0 || (body["2"] & 255) != 29 {
        return false
    }
    if (body["3"] & 255) != 32 {
        return false
    }
    if (body["36"] & 255) != 4 || (body["37"] & 255) != 3 {
        return false
    }
    let sigLen = ((body["38"] << 8) | body["39"]) & 65535
    if sigLen < 1 || sigLen != body["n"] - 40 {
        return false
    }
    let publicKey = {}
    let i = 0
    while i < 32 {
        publicKey["" + i] = body["" + (4 + i)] & 255
        i = i + 1
    }
    publicKey["n"] = 32
    return { publicKey: publicKey, signatureLength: sigLen }
}

/// Parse a TLS 1.2 ECDHE ClientKeyExchange (1-byte length + X25519 public).
pub fn tlsHsParseClientKeyExchange(message) {
    let body = tlsHsParseOne(message, 16)
    if body == false || body["n"] != 33 {
        return false
    }
    if (body["0"] & 255) != 32 {
        return false
    }
    let publicKey = {}
    let i = 0
    while i < 32 {
        publicKey["" + i] = body["" + (1 + i)] & 255
        i = i + 1
    }
    publicKey["n"] = 32
    return publicKey
}

/// Parse the TLS 1.2 ServerHello fields required by the AES-128-GCM fixture.
pub fn tlsHsParseServerHello(message) {
    let body = tlsHsParseOne(message, 2)
    if body == false || body["n"] < 38 {
        return false
    }
    if (body["0"] & 255) != 3 || (body["1"] & 255) != 3 {
        return false
    }
    let sessionLen = body["34"] & 255
    if sessionLen > 32 {
        return false
    }
    let cipherOff = 35 + sessionLen
    if cipherOff + 3 > body["n"] {
        return false
    }
    let cipher = ((body["" + cipherOff] << 8) | body["" + (cipherOff + 1)]) & 65535
    if cipher != 156 {
        if cipher != 49195 {
            return false
        }
    }
    if (body["" + (cipherOff + 2)] & 255) != 0 {
        return false
    }
    let shTail = cipherOff + 3
    if shTail < body["n"] {
        if shTail + 2 > body["n"] {
            return false
        }
        let shExt = ((body["" + shTail] << 8) | body["" + (shTail + 1)]) & 65535
        if shTail + 2 + shExt != body["n"] {
            return false
        }
    }
    let random = {}
    let i = 0
    while i < 32 {
        random["" + i] = body["" + (2 + i)] & 255
        i = i + 1
    }
    random["n"] = 32
    return { random: random, cipher: cipher }
}

/// Scan ClientHello extensions for named group 0x001d (X25519). -1 = bad vector.
pub fn tlsHsExtGroupX(body, start, finish) {
    let e = start
    let found = 0
    while e + 4 <= finish {
        let typ = ((body["" + e] << 8) | body["" + (e + 1)]) & 65535
        let ln = ((body["" + (e + 2)] << 8) | body["" + (e + 3)]) & 65535
        e = e + 4
        if e + ln > finish {
            return -1
        }
        if typ == 10 {
            if ln >= 4 {
                let gl = ((body["" + e] << 8) | body["" + (e + 1)]) & 65535
                if gl >= 2 {
                    if gl + 2 <= ln {
                        if ((body["" + (e + 2)] << 8) | body["" + (e + 3)]) == 29 {
                            found = 1
                        }
                    }
                }
            }
        }
        e = e + ln
    }
    if e != finish {
        return -1
    }
    return found
}

/// Parse the TLS 1.2 ClientHello fields required by the AES-128-GCM fixture.
pub fn tlsHsParseClientHello(message) {
    let body = tlsHsParseOne(message, 1)
    if body == false || body["n"] < 41 {
        return false
    }
    if (body["0"] & 255) != 3 || (body["1"] & 255) != 3 {
        return false
    }
    let sessionLen = body["34"] & 255
    if sessionLen > 32 {
        return false
    }
    let suiteLenOff = 35 + sessionLen
    if suiteLenOff + 2 > body["n"] {
        return false
    }
    let suiteLen = ((body["" + suiteLenOff] << 8) | body["" + (suiteLenOff + 1)]) & 65535
    if suiteLen < 2 || suiteLen - ((suiteLen / 2) | 0) * 2 != 0 {
        return false
    }
    let suitesOff = suiteLenOff + 2
    let suiteHit = 0
    let suite = 0
    let si = 0
    while si < suiteLen {
        let s = ((body["" + (suitesOff + si)] << 8) | body["" + (suitesOff + si + 1)]) & 65535
        if s == 156 {
            suiteHit = 1
            if suite == 0 {
                suite = s
            }
        }
        if s == 49195 {
            suiteHit = 1
            if suite == 0 {
                suite = s
            }
        }
        si = si + 2
    }
    if suiteHit != 1 {
        return false
    }
    let compressionOff = suitesOff + suiteLen
    if compressionOff + 2 > body["n"] {
        return false
    }
    if (body["" + compressionOff] & 255) != 1 || (body["" + (compressionOff + 1)] & 255) != 0 {
        return false
    }
    let afterComp = compressionOff + 2
    let groupX = 0
    if afterComp < body["n"] {
        if afterComp + 2 > body["n"] {
            return false
        }
        let extLen = ((body["" + afterComp] << 8) | body["" + (afterComp + 1)]) & 65535
        if afterComp + 2 + extLen != body["n"] {
            return false
        }
        groupX = tlsHsExtGroupX(body, afterComp + 2, afterComp + 2 + extLen)
        if groupX < 0 {
            return false
        }
    }
    let random = {}
    let i = 0
    while i < 32 {
        random["" + i] = body["" + (2 + i)] & 255
        i = i + 1
    }
    random["n"] = 32
    return { random: random, cipher: suite, groupX: groupX }
}

pub fn tlsTranscriptHashObj(tr) {
    return hmacDigestToObj(sha256Bytes(tlsObjToArr(tr)))
}

pub fn tlsHexToObj(hx) {
    let o = {}
    let n = 0
    let i = 0
    let m = len(hx)
    while i < m {
        let hi = char_code_at(hx, i)
        let lo = char_code_at(hx, i + 1)
        if hi > 96 {
            hi = hi - 87
        } else {
            hi = hi - 48
        }
        if lo > 96 {
            lo = lo - 87
        } else {
            lo = lo - 48
        }
        o["" + n] = ((hi * 16) + lo) & 255
        n = n + 1
        i = i + 2
    }
    o["n"] = n
    return o
}

pub fn tlsDemoTranscript() {
    return tlsConcatObj(tlsHsWrap(1, hmacStrBytes("CH")), tlsHsWrap(2, hmacStrBytes("SH")))
}

/// Handshake hash of ClientHello+ServerHello, then Finished verify_data + record.
pub fn tlsFinishedRecordEvalOk() {
    let tr = tlsDemoTranscript()
    if tlsObjHex(tr) != "010000024348020000025348" {
        return false
    }
    let h = tlsTranscriptHashObj(tr)
    if tlsObjHex(h) != "85ddc8f575f54954bc9b5034b1d05ed6326850f24a184863946900a308b3f811" {
        return false
    }
    let vd = tlsPrfHexSeed("secret", "client finished", h, 12)
    if vd != "72b21451c62ce330f8df14bc" {
        return false
    }
    let fin = tlsHsWrap(20, tlsHexToObj(vd))
    if tlsObjHex(fin) != "1400000c72b21451c62ce330f8df14bc" {
        return false
    }
    if tlsObjHex(tlsRecordHs(fin)) != "16030300101400000c72b21451c62ce330f8df14bc" {
        return false
    }
    return true
}

/// CertificateVerify handshake: SHA256/RSA alg id + HMAC-SHA256(transcript) as signature bytes.
pub fn tlsCertVerifyRecordEvalOk() {
    let tr = tlsDemoTranscript()
    let mac = hmacWordsHex(hmacSha256WordsObj(hmacStrBytes("secret"), tr))
    if mac != "c5e5bdfb37d408342b6e192b3261dc0c70339f3df7a81ff3c4b41c8773e891d6" {
        return false
    }
    let body = {}
    body["0"] = 4
    body["1"] = 1
    body["2"] = 0
    body["3"] = 32
    body["n"] = 4
    let cv = tlsHsWrap(15, tlsConcatObj(body, tlsHexToObj(mac)))
    if tlsObjHex(cv) != "0f00002404010020c5e5bdfb37d408342b6e192b3261dc0c70339f3df7a81ff3c4b41c8773e891d6" {
        return false
    }
    if tlsObjHex(tlsRecordHs(cv)) != "16030300280f00002404010020c5e5bdfb37d408342b6e192b3261dc0c70339f3df7a81ff3c4b41c8773e891d6" {
        return false
    }
    return true
}

pub fn tlsHsRecordEvalOk() {
    if tlsFinishedRecordEvalOk() != true {
        return false
    }
    if tlsCertVerifyRecordEvalOk() != true {
        return false
    }
    return true
}

/// Deterministic TLS 1.2 fixture: parse transcript, ECDHE fixture secret, PRF and server Finished.
pub fn tlsHsFixtureEvalOk() {
    let clientHello = tlsHsWrap(1, hmacStrBytes("CLIENT-HELLO"))
    let serverHello = tlsHsWrap(2, hmacStrBytes("SERVER-HELLO"))
    let serverPub = tlsHexToObj("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f")
    let serverKey = tlsHsWrap(12, serverPub)
    let parsedClient = tlsHsParseOne(clientHello, 1)
    let parsedServer = tlsHsParseOne(serverHello, 2)
    let parsedKey = tlsHsParseOne(serverKey, 12)
    if parsedClient == false {
        return false
    }
    if parsedServer == false {
        return false
    }
    if parsedKey == false {
        return false
    }
    if tlsObjHex(parsedKey) != "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f" {
        return false
    }
    let badLen = tlsHsWrap(2, hmacStrBytes("SERVER-HELLO"))
    badLen["3"] = badLen["3"] + 1
    if tlsHsParseOne(badLen, 2) != false {
        return false
    }
    if tlsHsParseOne(serverHello, 12) != false {
        return false
    }
    // RFC 7748 ECDHE shared secret for the parsed server key. x25519EvalOk
    // independently validates this expensive primitive on the Kab-VM.
    let pms = tlsHexToObj("4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742")
    if tlsObjHex(pms) != "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742" {
        return false
    }
    let cr = hmacStrBytes("CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC")
    let sr = hmacStrBytes("SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS")
    let ms = tlsPrfHexKeySeed(pms, "master secret", tlsConcatObj(cr, sr), 48)
    if ms != "7b039bf9221e769d15d5439481d2c77a2360e8a39b581569028c3e406853b8df7ab6bdc3b440dfa583ab170e98cf4c14" {
        return false
    }
    let transcript = tlsConcatObj(tlsConcatObj(clientHello, serverHello), serverKey)
    let verify = tlsPrfHexKeySeed(tlsHexToObj(ms), "server finished", tlsTranscriptHashObj(transcript), 12)
    let finished = tlsHsWrap(20, tlsHexToObj(verify))
    let parsedFinished = tlsHsParseOne(finished, 20)
    if parsedFinished == false {
        return false
    }
    if tlsObjHex(parsedFinished) != verify {
        return false
    }
    return true
}

/// Loopback transport fixture: type-22 ClientHello and ServerHello records.
pub fn tlsHsTcpFixtureEvalOk() {
    let clientRandom = hmacStrBytes("CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC")
    let clientHello = tlsHsWrap(1, tlsConcatObj(tlsHexToObj("0303"), tlsConcatObj(clientRandom, tlsHexToObj("000002009c0100"))))
    let serverRandom = hmacStrBytes("SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS")
    let serverHello = tlsHsWrap(2, tlsConcatObj(tlsHexToObj("0303"), tlsConcatObj(serverRandom, tlsHexToObj("00009c00"))))
    let certDer = tlsHexToObj("30153000300d06092a864886f70d01010b050003020000")
    let certBody = tlsConcatObj(tlsHexToObj("00001a000017"), certDer)
    let singleCertificate = tlsHsWrap(11, certBody)
    let leafDer = cryptoRootFixtureLeafDer()
    let issuerDer = cryptoRootFixtureIssuerDer()
    let certificate = tlsHsWrap(11, tlsHsCertificateList(leafDer, issuerDer))
    let serverKeyBody = tlsConcatObj(
        tlsHexToObj("03001d20"),
        tlsConcatObj(
            tlsHexToObj("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"),
            tlsHexToObj("04030002aabb")
        )
    )
    let serverKeyExchange = tlsHsWrap(12, serverKeyBody)
    let changeCipherSpec = tlsHexToObj("140303000101")
    let port = 28192
    let listener = tcp_listen("127.0.0.1", port)
    let client = tcp_connect("127.0.0.1", port)
    let server = tcp_accept(listener)
    tcp_write_bytes(client, tlsRecordHs(clientHello))
    let receivedClient = tlsHsReadRecord(server, 1)
    if receivedClient == false {
        tcp_close(client)
        tcp_close(server)
        tcp_close(listener)
        return false
    }
    tcp_write_bytes(server, tlsRecordHs(serverHello))
    let receivedServer = tlsHsReadRecord(client, 2)
    tcp_write_bytes(server, tlsRecordHs(certificate))
    let receivedCertificate = tlsHsReadRecord(client, 11)
    tcp_write_bytes(server, tlsRecordHs(serverKeyExchange))
    let receivedKeyExchange = tlsHsReadRecord(client, 12)
    tcp_write_bytes(server, changeCipherSpec)
    let receivedChangeCipherSpec = tlsHsReadChangeCipherSpec(client)
    let preFinishedTranscript = tlsConcatObj(
        tlsConcatObj(tlsConcatObj(receivedClient, receivedServer), receivedCertificate),
        receivedKeyExchange
    )
    let pms = tlsHexToObj("4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742")
    let cr = hmacStrBytes("CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC")
    let sr = hmacStrBytes("SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS")
    let ms = tlsPrfHexKeySeed(pms, "master secret", tlsConcatObj(cr, sr), 48)
    let keyBlock = tlsPrfHexKeySeed(tlsHexToObj(ms), "key expansion", tlsConcatObj(sr, cr), 40)
    let serverKey = tlsHsHexSlice(keyBlock, 16, 16)
    let serverIv = tlsHsHexSlice(keyBlock, 36, 4)
    let verify = tlsPrfHexKeySeed(tlsHexToObj(ms), "server finished", tlsTranscriptHashObj(preFinishedTranscript), 12)
    let finished = tlsHsWrap(20, tlsHexToObj(verify))
    let explicitIv = tlsHexToObj("0000000000000001")
    let aad = tlsHexToObj("00000000000000001603030010")
    let encrypted = gcmEncrypt(serverKey, tlsConcatObj(serverIv, explicitIv), finished, aad)
    let finishedRecord = tlsConcatObj(
        tlsHexToObj("1603030028"),
        tlsConcatObj(explicitIv, tlsConcatObj(encrypted["ct"], encrypted["tag"]))
    )
    tcp_write_bytes(server, finishedRecord)
    let receivedFinished = tlsHsReadEncryptedFinished(client, serverKey, serverIv)
    if receivedFinished == false {
        tcp_close(client)
        tcp_close(server)
        tcp_close(listener)
        return false
    }
    let clientKey = tlsHsHexSlice(keyBlock, 0, 16)
    let clientIv = tlsHsHexSlice(keyBlock, 32, 4)
    let clientTranscript = tlsConcatObj(preFinishedTranscript, receivedFinished)
    let clientVerify = tlsPrfHexKeySeed(tlsHexToObj(ms), "client finished", tlsTranscriptHashObj(clientTranscript), 12)
    let clientFinished = tlsHsWrap(20, tlsHexToObj(clientVerify))
    let clientExplicitIv = tlsHexToObj("0000000000000002")
    let clientEncrypted = gcmEncrypt(clientKey, tlsConcatObj(clientIv, clientExplicitIv), clientFinished, aad)
    let clientFinishedRecord = tlsConcatObj(
        tlsHexToObj("1603030028"),
        tlsConcatObj(clientExplicitIv, tlsConcatObj(clientEncrypted["ct"], clientEncrypted["tag"]))
    )
    tcp_write_bytes(client, changeCipherSpec)
    let receivedClientChangeCipherSpec = tlsHsReadChangeCipherSpec(server)
    tcp_write_bytes(client, clientFinishedRecord)
    let receivedClientFinished = tlsHsReadEncryptedFinished(server, clientKey, clientIv)
    tcp_close(client)
    tcp_close(server)
    tcp_close(listener)
    if receivedServer == false {
        return false
    }
    if receivedCertificate == false {
        return false
    }
    if receivedKeyExchange == false {
        return false
    }
    if receivedChangeCipherSpec != true {
        return false
    }
    if receivedFinished == false {
        return false
    }
    if receivedClientChangeCipherSpec != true || receivedClientFinished == false {
        return false
    }
    let parsedSingle = tlsHsParseCertificate(singleCertificate)
    if parsedSingle == false {
        return false
    }
    if tlsObjHex(parsedSingle) != tlsObjHex(certDer) {
        return false
    }
    if cryptoRootDerCert(parsedSingle) != true {
        return false
    }
    let parsedChain = tlsHsParseCertificateChain(receivedCertificate)
    if parsedChain == false || parsedChain["n"] != 2 {
        return false
    }
    if tlsObjHex(parsedChain["0"]) != tlsObjHex(leafDer) || tlsObjHex(parsedChain["1"]) != tlsObjHex(issuerDer) {
        return false
    }
    if tlsHsValidateCertificateChain(parsedChain) != true {
        return false
    }
    let parsedKeyExchange = tlsHsParseServerKeyExchange(receivedKeyExchange)
    if parsedKeyExchange == false {
        return false
    }
    if parsedKeyExchange["signatureLength"] != 2 {
        return false
    }
    if tlsObjHex(parsedKeyExchange["publicKey"]) != "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f" {
        return false
    }
    if tlsObjHex(receivedClient) != tlsObjHex(clientHello) {
        return false
    }
    let parsedClientHello = tlsHsParseClientHello(receivedClient)
    if parsedClientHello == false {
        return false
    }
    if parsedClientHello["cipher"] != 156 || tlsObjHex(parsedClientHello["random"]) != tlsObjHex(clientRandom) {
        return false
    }
    if tlsObjHex(receivedServer) != tlsObjHex(serverHello) {
        return false
    }
    let parsedServerHello = tlsHsParseServerHello(receivedServer)
    if parsedServerHello == false {
        return false
    }
    if parsedServerHello["cipher"] != 156 || tlsObjHex(parsedServerHello["random"]) != tlsObjHex(serverRandom) {
        return false
    }
    if tlsObjHex(receivedFinished) != tlsObjHex(finished) {
        return false
    }
    if tlsObjHex(receivedClientFinished) != tlsObjHex(clientFinished) {
        return false
    }
    return tlsTranscriptHashObj(preFinishedTranscript)["n"] == 32
}
