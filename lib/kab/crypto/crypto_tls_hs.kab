// SH23: TLS 1.2 handshake records + transcript Finished + CertificateVerify MAC.
// import "kab/crypto/crypto_tls_hs"
// Do not grow crypto_tls.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls_prf"
import "kab/crypto/crypto_hmac_eval"
import "kab/crypto/crypto_sha_eval"
import "kab/crypto/crypto_gcm_eval"

pub fn tlsObjToArr(o) {
    let out = []
    let i = 0
    let n = o["n"]
    while i < n {
        out = push(out, o["" + i] & 255)
        i = i + 1
    }
    return out
}

pub fn tlsObjHex(o) {
    let out = ""
    let i = 0
    let n = o["n"]
    while i < n {
        let b = o["" + i] & 255
        out = out + shaHexDigit((b >>> 4) & 15) + shaHexDigit(b & 15)
        i = i + 1
    }
    return out
}

pub fn tlsHsWrap(typ, body) {
    let n = body["n"]
    let h = {}
    h["0"] = typ
    h["1"] = (n >>> 16) & 255
    h["2"] = (n >>> 8) & 255
    h["3"] = n & 255
    h["n"] = 4
    return tlsConcatObj(h, body)
}

/// Parse exactly one TLS handshake message, rejecting truncated or trailing bytes.
pub fn tlsHsParseOne(msg, expectedType) {
    if msg["n"] < 4 {
        return false
    }
    if (msg["0"] & 255) != expectedType {
        return false
    }
    let bodyLen = ((msg["1"] << 16) | (msg["2"] << 8) | msg["3"]) & 16777215
    if bodyLen != msg["n"] - 4 {
        return false
    }
    let body = {}
    let i = 0
    while i < bodyLen {
        body["" + i] = msg["" + (4 + i)] & 255
        i = i + 1
    }
    body["n"] = bodyLen
    return body
}

pub fn tlsRecordHs(payload) {
    let n = payload["n"]
    let h = {}
    h["0"] = 22
    h["1"] = 3
    h["2"] = 3
    h["3"] = (n >>> 8) & 255
    h["4"] = n & 255
    h["n"] = 5
    return tlsConcatObj(h, payload)
}

/// Read exactly want raw bytes from a TCP socket.
pub fn tlsHsReadBytesExact(sock, want) {
    let out = {}
    let n = 0
    while n < want {
        let got = tcp_read_bytes(sock, want - n)
        let gotn = len(got)
        if gotn == 0 {
            return false
        }
        let i = 0
        while i < gotn {
            out["" + (n + i)] = got[i] & 255
            i = i + 1
        }
        n = n + gotn
    }
    out["n"] = n
    return out
}

/// Read one TLS 1.2 handshake record containing exactly one expected message.
pub fn tlsHsReadRecord(sock, expectedType) {
    let head = tlsHsReadBytesExact(sock, 5)
    if head == false {
        return false
    }
    if (head["0"] & 255) != 22 {
        return false
    }
    if (head["1"] & 255) != 3 || (head["2"] & 255) != 3 {
        return false
    }
    let size = ((head["3"] << 8) | head["4"]) & 65535
    if size < 4 || size > 16384 {
        return false
    }
    let message = tlsHsReadBytesExact(sock, size)
    if message == false {
        return false
    }
    if tlsHsParseOne(message, expectedType) == false {
        return false
    }
    return message
}

/// Read the TLS 1.2 ChangeCipherSpec record which enables encrypted handshake records.
pub fn tlsHsReadChangeCipherSpec(sock) {
    let record = tlsHsReadBytesExact(sock, 6)
    if record == false {
        return false
    }
    if (record["0"] & 255) != 20 {
        return false
    }
    if (record["1"] & 255) != 3 || (record["2"] & 255) != 3 {
        return false
    }
    if (record["3"] & 255) != 0 || (record["4"] & 255) != 1 {
        return false
    }
    return (record["5"] & 255) == 1
}

/// Decode the first server AES-GCM protected TLS 1.2 Finished record.
pub fn tlsHsReadEncryptedFinished(sock, key, fixedIv) {
    let head = tlsHsReadBytesExact(sock, 5)
    if head == false {
        return false
    }
    if (head["0"] & 255) != 22 || (head["1"] & 255) != 3 || (head["2"] & 255) != 3 {
        return false
    }
    let size = ((head["3"] << 8) | head["4"]) & 65535
    if size != 40 {
        return false
    }
    let tail = tlsHsReadBytesExact(sock, size)
    if tail == false {
        return false
    }
    let explicitIv = {}
    let ct = {}
    let tag = {}
    let i = 0
    while i < 8 {
        explicitIv["" + i] = tail["" + i] & 255
        i = i + 1
    }
    i = 0
    while i < 16 {
        ct["" + i] = tail["" + (8 + i)] & 255
        tag["" + i] = tail["" + (24 + i)] & 255
        i = i + 1
    }
    explicitIv["n"] = 8
    ct["n"] = 16
    tag["n"] = 16
    let nonce = tlsConcatObj(fixedIv, explicitIv)
    let aad = tlsHexToObj("00000000000000001603030010")
    let plainHex = gcmDecrypt(key, nonce, ct, tag, aad)
    if plainHex == false {
        return false
    }
    let plain = tlsHexToObj(plainHex)
    if tlsHsParseOne(plain, 20) == false {
        return false
    }
    return plain
}

pub fn tlsHsHexSlice(hx, off, n) {
    return tlsHexToObj(str_slice(hx, off + off, off + off + n + n))
}

/// Parse a TLS 1.2 Certificate message and extract exactly one DER certificate.
pub fn tlsHsParseCertificate(message) {
    let body = tlsHsParseOne(message, 11)
    if body == false || body["n"] < 6 {
        return false
    }
    let listLen = ((body["0"] << 16) | (body["1"] << 8) | body["2"]) & 16777215
    if listLen != body["n"] - 3 {
        return false
    }
    let certLen = ((body["3"] << 16) | (body["4"] << 8) | body["5"]) & 16777215
    if certLen < 1 || certLen != body["n"] - 6 {
        return false
    }
    let cert = {}
    let i = 0
    while i < certLen {
        cert["" + i] = body["" + (6 + i)] & 255
        i = i + 1
    }
    cert["n"] = certLen
    return cert
}

/// Parse the ECDHE/X25519 framing of a TLS 1.2 ServerKeyExchange message.
pub fn tlsHsParseServerKeyExchange(message) {
    let body = tlsHsParseOne(message, 12)
    if body == false || body["n"] < 41 {
        return false
    }
    if (body["0"] & 255) != 3 {
        return false
    }
    if (body["1"] & 255) != 0 || (body["2"] & 255) != 29 {
        return false
    }
    if (body["3"] & 255) != 32 {
        return false
    }
    if (body["36"] & 255) != 4 || (body["37"] & 255) != 3 {
        return false
    }
    let sigLen = ((body["38"] << 8) | body["39"]) & 65535
    if sigLen < 1 || sigLen != body["n"] - 40 {
        return false
    }
    let publicKey = {}
    let i = 0
    while i < 32 {
        publicKey["" + i] = body["" + (4 + i)] & 255
        i = i + 1
    }
    publicKey["n"] = 32
    return { publicKey: publicKey, signatureLength: sigLen }
}

pub fn tlsTranscriptHashObj(tr) {
    return hmacDigestToObj(sha256Bytes(tlsObjToArr(tr)))
}

pub fn tlsHexToObj(hx) {
    let o = {}
    let n = 0
    let i = 0
    let m = len(hx)
    while i < m {
        let hi = char_code_at(hx, i)
        let lo = char_code_at(hx, i + 1)
        if hi > 96 {
            hi = hi - 87
        } else {
            hi = hi - 48
        }
        if lo > 96 {
            lo = lo - 87
        } else {
            lo = lo - 48
        }
        o["" + n] = ((hi * 16) + lo) & 255
        n = n + 1
        i = i + 2
    }
    o["n"] = n
    return o
}

pub fn tlsDemoTranscript() {
    return tlsConcatObj(tlsHsWrap(1, hmacStrBytes("CH")), tlsHsWrap(2, hmacStrBytes("SH")))
}

/// Handshake hash of ClientHello+ServerHello, then Finished verify_data + record.
pub fn tlsFinishedRecordEvalOk() {
    let tr = tlsDemoTranscript()
    if tlsObjHex(tr) != "010000024348020000025348" {
        return false
    }
    let h = tlsTranscriptHashObj(tr)
    if tlsObjHex(h) != "85ddc8f575f54954bc9b5034b1d05ed6326850f24a184863946900a308b3f811" {
        return false
    }
    let vd = tlsPrfHexSeed("secret", "client finished", h, 12)
    if vd != "72b21451c62ce330f8df14bc" {
        return false
    }
    let fin = tlsHsWrap(20, tlsHexToObj(vd))
    if tlsObjHex(fin) != "1400000c72b21451c62ce330f8df14bc" {
        return false
    }
    if tlsObjHex(tlsRecordHs(fin)) != "16030300101400000c72b21451c62ce330f8df14bc" {
        return false
    }
    return true
}

/// CertificateVerify handshake: SHA256/RSA alg id + HMAC-SHA256(transcript) as signature bytes.
pub fn tlsCertVerifyRecordEvalOk() {
    let tr = tlsDemoTranscript()
    let mac = hmacWordsHex(hmacSha256WordsObj(hmacStrBytes("secret"), tr))
    if mac != "c5e5bdfb37d408342b6e192b3261dc0c70339f3df7a81ff3c4b41c8773e891d6" {
        return false
    }
    let body = {}
    body["0"] = 4
    body["1"] = 1
    body["2"] = 0
    body["3"] = 32
    body["n"] = 4
    let cv = tlsHsWrap(15, tlsConcatObj(body, tlsHexToObj(mac)))
    if tlsObjHex(cv) != "0f00002404010020c5e5bdfb37d408342b6e192b3261dc0c70339f3df7a81ff3c4b41c8773e891d6" {
        return false
    }
    if tlsObjHex(tlsRecordHs(cv)) != "16030300280f00002404010020c5e5bdfb37d408342b6e192b3261dc0c70339f3df7a81ff3c4b41c8773e891d6" {
        return false
    }
    return true
}

pub fn tlsHsRecordEvalOk() {
    if tlsFinishedRecordEvalOk() != true {
        return false
    }
    if tlsCertVerifyRecordEvalOk() != true {
        return false
    }
    return true
}

/// Deterministic TLS 1.2 fixture: parse transcript, ECDHE fixture secret, PRF and server Finished.
pub fn tlsHsFixtureEvalOk() {
    let clientHello = tlsHsWrap(1, hmacStrBytes("CLIENT-HELLO"))
    let serverHello = tlsHsWrap(2, hmacStrBytes("SERVER-HELLO"))
    let serverPub = tlsHexToObj("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f")
    let serverKey = tlsHsWrap(12, serverPub)
    let parsedClient = tlsHsParseOne(clientHello, 1)
    let parsedServer = tlsHsParseOne(serverHello, 2)
    let parsedKey = tlsHsParseOne(serverKey, 12)
    if parsedClient == false {
        return false
    }
    if parsedServer == false {
        return false
    }
    if parsedKey == false {
        return false
    }
    if tlsObjHex(parsedKey) != "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f" {
        return false
    }
    let badLen = tlsHsWrap(2, hmacStrBytes("SERVER-HELLO"))
    badLen["3"] = badLen["3"] + 1
    if tlsHsParseOne(badLen, 2) != false {
        return false
    }
    if tlsHsParseOne(serverHello, 12) != false {
        return false
    }
    // RFC 7748 ECDHE shared secret for the parsed server key. x25519EvalOk
    // independently validates this expensive primitive on the Kab-VM.
    let pms = tlsHexToObj("4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742")
    if tlsObjHex(pms) != "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742" {
        return false
    }
    let cr = hmacStrBytes("CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC")
    let sr = hmacStrBytes("SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS")
    let ms = tlsPrfHexKeySeed(pms, "master secret", tlsConcatObj(cr, sr), 48)
    if ms != "7b039bf9221e769d15d5439481d2c77a2360e8a39b581569028c3e406853b8df7ab6bdc3b440dfa583ab170e98cf4c14" {
        return false
    }
    let transcript = tlsConcatObj(tlsConcatObj(clientHello, serverHello), serverKey)
    let verify = tlsPrfHexKeySeed(tlsHexToObj(ms), "server finished", tlsTranscriptHashObj(transcript), 12)
    let finished = tlsHsWrap(20, tlsHexToObj(verify))
    let parsedFinished = tlsHsParseOne(finished, 20)
    if parsedFinished == false {
        return false
    }
    if tlsObjHex(parsedFinished) != verify {
        return false
    }
    return true
}

/// Loopback transport fixture: type-22 ClientHello and ServerHello records.
pub fn tlsHsTcpFixtureEvalOk() {
    let clientHello = tlsHsWrap(1, hmacStrBytes("CH"))
    let serverHello = tlsHsWrap(2, hmacStrBytes("SH"))
    let certDer = tlsHexToObj("30153000300d06092a864886f70d01010b050003020000")
    let certBody = tlsConcatObj(tlsHexToObj("00001a000017"), certDer)
    let certificate = tlsHsWrap(11, certBody)
    let serverKeyBody = tlsConcatObj(
        tlsHexToObj("03001d20"),
        tlsConcatObj(
            tlsHexToObj("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"),
            tlsHexToObj("04030002aabb")
        )
    )
    let serverKeyExchange = tlsHsWrap(12, serverKeyBody)
    let changeCipherSpec = tlsHexToObj("140303000101")
    let port = 28192
    let listener = tcp_listen("127.0.0.1", port)
    let client = tcp_connect("127.0.0.1", port)
    let server = tcp_accept(listener)
    tcp_write_bytes(client, tlsRecordHs(clientHello))
    let receivedClient = tlsHsReadRecord(server, 1)
    if receivedClient == false {
        tcp_close(client)
        tcp_close(server)
        tcp_close(listener)
        return false
    }
    tcp_write_bytes(server, tlsRecordHs(serverHello))
    let receivedServer = tlsHsReadRecord(client, 2)
    tcp_write_bytes(server, tlsRecordHs(certificate))
    let receivedCertificate = tlsHsReadRecord(client, 11)
    tcp_write_bytes(server, tlsRecordHs(serverKeyExchange))
    let receivedKeyExchange = tlsHsReadRecord(client, 12)
    tcp_write_bytes(server, changeCipherSpec)
    let receivedChangeCipherSpec = tlsHsReadChangeCipherSpec(client)
    let preFinishedTranscript = tlsConcatObj(
        tlsConcatObj(tlsConcatObj(receivedClient, receivedServer), receivedCertificate),
        receivedKeyExchange
    )
    let pms = tlsHexToObj("4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742")
    let cr = hmacStrBytes("CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC")
    let sr = hmacStrBytes("SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS")
    let ms = tlsPrfHexKeySeed(pms, "master secret", tlsConcatObj(cr, sr), 48)
    let keyBlock = tlsPrfHexKeySeed(tlsHexToObj(ms), "key expansion", tlsConcatObj(sr, cr), 40)
    let serverKey = tlsHsHexSlice(keyBlock, 16, 16)
    let serverIv = tlsHsHexSlice(keyBlock, 36, 4)
    let verify = tlsPrfHexKeySeed(tlsHexToObj(ms), "server finished", tlsTranscriptHashObj(preFinishedTranscript), 12)
    let finished = tlsHsWrap(20, tlsHexToObj(verify))
    let explicitIv = tlsHexToObj("0000000000000001")
    let aad = tlsHexToObj("00000000000000001603030010")
    let encrypted = gcmEncrypt(serverKey, tlsConcatObj(serverIv, explicitIv), finished, aad)
    let finishedRecord = tlsConcatObj(
        tlsHexToObj("1603030028"),
        tlsConcatObj(explicitIv, tlsConcatObj(encrypted["ct"], encrypted["tag"]))
    )
    tcp_write_bytes(server, finishedRecord)
    let receivedFinished = tlsHsReadEncryptedFinished(client, serverKey, serverIv)
    tcp_close(client)
    tcp_close(server)
    tcp_close(listener)
    if receivedServer == false {
        return false
    }
    if receivedCertificate == false {
        return false
    }
    if receivedKeyExchange == false {
        return false
    }
    if receivedChangeCipherSpec != true {
        return false
    }
    if receivedFinished == false {
        return false
    }
    let parsedCert = tlsHsParseCertificate(receivedCertificate)
    if parsedCert == false {
        return false
    }
    if tlsObjHex(parsedCert) != tlsObjHex(certDer) {
        return false
    }
    let parsedKeyExchange = tlsHsParseServerKeyExchange(receivedKeyExchange)
    if parsedKeyExchange == false {
        return false
    }
    if parsedKeyExchange["signatureLength"] != 2 {
        return false
    }
    if tlsObjHex(parsedKeyExchange["publicKey"]) != "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f" {
        return false
    }
    if tlsObjHex(receivedClient) != tlsObjHex(clientHello) {
        return false
    }
    if tlsObjHex(receivedServer) != tlsObjHex(serverHello) {
        return false
    }
    if tlsObjHex(receivedFinished) != tlsObjHex(finished) {
        return false
    }
    return tlsTranscriptHashObj(preFinishedTranscript)["n"] == 32
}
