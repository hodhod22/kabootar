// SH23: generic Kab TLS 1.3 client for any loopback https URL.
// Imports http_fetch and binds gTls13GenericFetch.
// Do not grow crypto_tls13_client_fetch.kab. Host rustls remains skuld.

import "kab/http/http_fetch"
import "kab/crypto/crypto_tls13_client"

pub fn tls13GenericUrlPort(url) {
    let hostEnd = -1
    let i = 8
    while i < len(url) {
        if url[i] == "/" {
            hostEnd = i
            break
        }
        i = i + 1
    }
    if hostEnd == -1 {
        hostEnd = len(url)
    }
    let hostPort = str_slice(url, 8, hostEnd)
    let colon = -1
    i = 0
    while i < len(hostPort) {
        if hostPort[i] == ":" {
            colon = i
            break
        }
        i = i + 1
    }
    if colon == -1 {
        return false
    }
    let p = 0
    i = colon + 1
    while i < len(hostPort) {
        let c = char_code_at(hostPort, i)
        if c < 48 || c > 57 {
            return false
        }
        p = p * 10 + (c - 48)
        i = i + 1
    }
    return p
}

pub fn tls13GenericHost(url) {
    let hostEnd = -1
    let i = 8
    while i < len(url) {
        if url[i] == "/" {
            hostEnd = i
            break
        }
        i = i + 1
    }
    if hostEnd == -1 {
        hostEnd = len(url)
    }
    let hostPort = str_slice(url, 8, hostEnd)
    let colon = -1
    i = 0
    while i < len(hostPort) {
        if hostPort[i] == ":" {
            colon = i
            break
        }
        i = i + 1
    }
    if colon == -1 {
        return false
    }
    return str_slice(hostPort, 0, colon)
}

pub fn tls13ClientGenericFetch(method, url, body, headers, timeoutMs) {
    if timeoutMs != 0 {
        return false
    }
    let host = tls13GenericHost(url)
    if host == false {
        return false
    }
    let port = tls13GenericUrlPort(url)
    if port == false {
        return false
    }
    if host != "127.0.0.1" && host != "localhost" {
        return false
    }
    let s = tls13ClientConnect(host, port)
    if s == false {
        return false
    }
    let path = httpFetchTarget(method, url)
    let req = httpBuildFetchReq(method, host, path, body, headers)
    if req == false {
        tcp_close(s["sock"])
        return false
    }
    let resp = tls13PeerAppAfterHs(s, req)
    if resp == false {
        return false
    }
    if httpStatusCode(resp) != 200 {
        return false
    }
    let o = {}
    o["status"] = 200
    o["body"] = httpBytesToStr(httpRespBody(resp))
    o["headers"] = httpHdrObj(resp)
    return o
}

httpBindTls13GenericFetch(tls13ClientGenericFetch)