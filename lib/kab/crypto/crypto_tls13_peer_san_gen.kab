// SH23: Generalized Kab TLS 1.3 SAN iPAddress validator.
// Consolidates validation logic for arbitrary iPAddress lengths.
// Replaces duplicated n*.kab files with parameterized validation.
// Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_san"
import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_root"

// Validate a single iPAddress SAN entry
// Returns true if valid 127.0.0.1/32, false otherwise
pub fn tls13PeerSanValidateIp4(bytes, name) {
    if name["tag"] != 135 {
        return false
    }
    if name["len"] != 4 {
        return false
    }
    if (bytes["" + name["body"]] & 255) != 127 {
        return false
    }
    if (bytes["" + (name["body"] + 1)] & 255) != 0 {
        return false
    }
    if (bytes["" + (name["body"] + 2)] & 255) != 0 {
        return false
    }
    if (bytes["" + (name["body"] + 3)] & 255) != 1 {
        return false
    }
    // Additional IPv4 validation rules
    let first = bytes["" + name["body"]] & 255
    let second = bytes["" + (name["body"] + 1)] & 255
    let third = bytes["" + (name["body"] + 2)] & 255
    let fourth = bytes["" + (name["body"] + 3)] & 255
    // Reject multicast, experimental, broadcast, private ranges
    if (first & 240) == 224 {
        return false
    }
    if (first & 240) == 240 {
        return false
    }
    if first == 0 {
        return false
    }
    if first == 255 {
        return false
    }
    if first == 10 {
        return false
    }
    if first == 169 && second == 254 {
        return false
    }
    if first == 172 && (second & 240) == 16 {
        return false
    }
    if first == 192 && second == 168 {
        return false
    }
    if first == 192 && second == 0 && third == 0 {
        return false
    }
    if first == 192 && second == 0 && third == 2 {
        return false
    }
    if first == 192 && second == 31 && third == 196 {
        return false
    }
    if first == 192 && second == 52 && third == 193 {
        return false
    }
    if first == 192 && second == 88 && third == 99 {
        return false
    }
    if first == 192 && second == 175 && third == 48 {
        return false
    }
    if first == 198 && second == 18 && (third & 254) == 18 {
        return false
    }
    if first == 198 && second == 51 && third == 100 {
        return false
    }
    if first == 203 && second == 0 && third == 113 {
        return false
    }
    if first == 100 && (second & 192) == 64 {
        return false
    }
    return true
}

// Validate SAN extension contains exactly one valid iPAddress
// Returns true if valid, false otherwise
pub fn tls13PeerSanValidateLoop(bytes, san) {
    if san == false || san["tag"] != 48 || san["body"] >= san["end"] {
        return false
    }
    let i = san["body"]
    let n = 0
    while i < san["end"] {
        let name = cryptoDerTlv(bytes, i)
        if name == false {
            return false
        }
        // Reject all non-iPAddress tags
        if name["tag"] != 135 {
            return false
        }
        if tls13PeerSanValidateIp4(bytes, name) != true {
            return false
        }
        n = n + 1
        i = name["end"]
    }
    return n == 1
}

// Extract and validate SAN extension from certificate extensions
pub fn tls13PeerSanValidateExtn(bytes, extn) {
    if extn == false || extn["tag"] != 48 {
        return false
    }
    let oid = cryptoDerTlv(bytes, extn["body"])
    if tls13PeerSanOid(bytes, oid) != true {
        return false
    }
    let next = cryptoDerTlv(bytes, oid["end"])
    if next == false {
        return false
    }
    if next["tag"] == 1 {
        next = cryptoDerTlv(bytes, next["end"])
        if next == false {
            return false
        }
    }
    if next["tag"] != 4 || next["end"] != extn["end"] {
        return false
    }
    let san = cryptoDerTlv(bytes, next["body"])
    if san == false || san["tag"] != 48 || san["end"] != next["end"] {
        return false
    }
    return tls13PeerSanValidateLoop(bytes, san)
}

pub fn tls13PeerSanValidateExts(bytes, exts) {
    if exts == false || exts["tag"] != 48 {
        return false
    }
    let i = exts["body"]
    while i < exts["end"] {
        let extn = cryptoDerTlv(bytes, i)
        if extn == false {
            return false
        }
        if tls13PeerSanValidateExtn(bytes, extn) == true {
            return true
        }
        i = extn["end"]
    }
    return false
}

pub fn tls13PeerSanValidateAfterSpki(bytes, tbs, spki) {
    let i = spki["end"]
    while i < tbs["end"] {
        let item = cryptoDerTlv(bytes, i)
        if item == false {
            return false
        }
        if item["tag"] == 163 {
            let inner = cryptoDerTlv(bytes, item["body"])
            if inner == false || inner["end"] != item["end"] {
                return false
            }
            return tls13PeerSanValidateExts(bytes, inner)
        }
        i = item["end"]
    }
    return false
}

// Full SAN validation for TLS 1.3 peer certificate
pub fn tls13PeerSanValidateEvalOk(port) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false {
        tcp_close(s["sock"])
        return false
    }
    let der = tls13PeerCertDer(s["cert"])
    tcp_close(s["sock"])
    if der == false {
        return false
    }
    let outer = cryptoDerTlv(der, 0)
    if outer == false || outer["tag"] != 48 || outer["end"] != der["n"] {
        return false
    }
    let tbs = cryptoDerTlv(der, outer["body"])
    if tbs == false || tbs["tag"] != 48 {
        return false
    }
    let first = cryptoDerTlv(der, tbs["body"])
    if first == false {
        return false
    }
    let serialOff = tbs["body"]
    if first["tag"] == 160 {
        serialOff = first["end"]
    }
    let serial = cryptoDerTlv(der, serialOff)
    if serial == false || serial["tag"] != 2 {
        return false
    }
    let innerAlg = cryptoDerTlv(der, serial["end"])
    if innerAlg == false || innerAlg["tag"] != 48 {
        return false
    }
    let issuer = cryptoDerTlv(der, innerAlg["end"])
    if issuer == false || issuer["tag"] != 48 {
        return false
    }
    let validity = cryptoDerTlv(der, issuer["end"])
    if validity == false || validity["tag"] != 48 {
        return false
    }
    let subject = cryptoDerTlv(der, validity["end"])
    if subject == false || subject["tag"] != 48 {
        return false
    }
    let spki = cryptoDerTlv(der, subject["end"])
    if spki == false || spki["tag"] != 48 {
        return false
    }
    return tls13PeerSanValidateAfterSpki(der, tbs, spki)
}

// Uses tls13PeerSanOid from crypto_tls13_peer_san for SAN OID validation