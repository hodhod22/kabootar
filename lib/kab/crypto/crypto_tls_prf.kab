// SH23: TLS 1.2 PRF / Finished verify_data (RFC 5246 P_SHA256).
// import "kab/crypto/crypto_tls_prf"
// Do not grow crypto_tls.kab. Host rustls remains skuld.

import "kab/crypto/crypto_hmac_eval"

pub fn tlsConcatObj(a, b) {
    let o = {}
    let n = 0
    let i = 0
    let an = a["n"]
    while i < an {
        o["" + n] = a["" + i]
        n = n + 1
        i = i + 1
    }
    let j = 0
    let bn = b["n"]
    while j < bn {
        o["" + n] = b["" + j]
        n = n + 1
        j = j + 1
    }
    o["n"] = n
    return o
}

pub fn tlsPrfHex(secret, label, seed, nOut) {
    let sec = hmacStrBytes(secret)
    let seedAll = tlsConcatObj(hmacStrBytes(label), hmacStrBytes(seed))
    let a = seedAll
    let out = ""
    let want = nOut + nOut
    while len(out) < want {
        a = hmacDigestToObj(hmacSha256WordsObj(sec, a))
        let chunk = hmacSha256WordsObj(sec, tlsConcatObj(a, seedAll))
        out = out + hmacWordsHex(chunk)
    }
    return str_slice(out, 0, want)
}

/// First 32 bytes of PRF(secret, "master secret", seed).
pub fn tlsPrfEvalOk() {
    if tlsPrfHex("secret", "master secret", "seed", 32) != "5ea239aa2f6949c46c18bd3dccb71942d3809fa40fcf19c661430a9fd8abcf6a" {
        return false
    }
    return true
}

/// TLS 1.2 verify_data is PRF(..., "client finished", handshake_hash)[0:12].
pub fn tlsFinishedEvalOk() {
    if tlsPrfHex("secret", "client finished", "seed", 12) != "c79297217fb31cd6f9405954" {
        return false
    }
    return true
}

pub fn tlsHandshakeEvalOk() {
    if tlsPrfEvalOk() != true {
        return false
    }
    if tlsFinishedEvalOk() != true {
        return false
    }
    return true
}
