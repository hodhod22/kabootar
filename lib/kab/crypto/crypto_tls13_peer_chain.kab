// SH23: Kab TLS 1.3 Certificate chain structure vs rustls P-256 peer.
// Do not grow crypto_tls13_peer_crt.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_root"

// Returns count of certificates in the TLS Certificate message, or false on parse error.
pub fn tls13PeerChainCount(message) {
    let body = tlsHsParseOne(message, 11)
    if body == false || body["n"] < 4 {
        return false
    }
    let ctxLen = body["0"] & 255
    if 1 + ctxLen + 3 > body["n"] {
        return false
    }
    let listOff = 1 + ctxLen
    let listLen = ((body["" + listOff] << 16) | (body["" + (listOff + 1)] << 8) | body["" + (listOff + 2)]) & 16777215
    if listOff + 3 + listLen != body["n"] {
        return false
    }
    let i = listOff + 3
    let end = listOff + 3 + listLen
    let n = 0
    while i < end {
        if i + 3 > end {
            return false
        }
        let certLen = ((body["" + i] << 16) | (body["" + (i + 1)] << 8) | body["" + (i + 2)]) & 16777215
        if i + 3 + certLen > end {
            return false
        }
        n = n + 1
        i = i + 3 + certLen
    }
    if i != end {
        return false
    }
    return n
}

// Evaluate: open connection, get cert message, verify chain has at least one certificate.
pub fn tls13PeerChainEvalOk(port) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false {
        tcp_close(s["sock"])
        return false
    }
    let n = tls13PeerChainCount(s["cert"])
    tcp_close(s["sock"])
    if n == false {
        return false
    }
    return n >= 1
}

// Evaluate: verify cert chain length matches expected.
pub fn tls13PeerChainLenOk(port, expected) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false {
        tcp_close(s["sock"])
        return false
    }
    let n = tls13PeerChainCount(s["cert"])
    tcp_close(s["sock"])
    if n == false {
        return false
    }
    return n == expected
}