// SH23: Kab TLS 1.3 leaf authorityKeyIdentifier vs rustls P-256 peer.
// Do not grow crypto_tls13_peer_ski.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_root"

pub fn tls13PeerAkiOid(bytes, oid) {
    if oid == false || oid["tag"] != 6 || oid["len"] != 3 {
        return false
    }
    if (bytes["" + oid["body"]] & 255) != 85 {
        return false
    }
    if (bytes["" + (oid["body"] + 1)] & 255) != 29 {
        return false
    }
    return (bytes["" + (oid["body"] + 2)] & 255) == 35
}

pub fn tls13PeerSkiOid2(bytes, oid) {
    if oid == false || oid["tag"] != 6 || oid["len"] != 3 {
        return false
    }
    if (bytes["" + oid["body"]] & 255) != 85 {
        return false
    }
    if (bytes["" + (oid["body"] + 1)] & 255) != 29 {
        return false
    }
    return (bytes["" + (oid["body"] + 2)] & 255) == 14
}

pub fn tls13PeerExtOctet(bytes, extn) {
    if extn == false || extn["tag"] != 48 {
        return false
    }
    let oid = cryptoDerTlv(bytes, extn["body"])
    if oid == false {
        return false
    }
    let next = cryptoDerTlv(bytes, oid["end"])
    if next == false {
        return false
    }
    if next["tag"] == 1 {
        next = cryptoDerTlv(bytes, next["end"])
        if next == false {
            return false
        }
    }
    if next["tag"] != 4 || next["end"] != extn["end"] {
        return false
    }
    return { oid: oid, val: next }
}

pub fn tls13PeerSkiKeyId(bytes, extn) {
    let wrap = tls13PeerExtOctet(bytes, extn)
    if wrap == false || tls13PeerSkiOid2(bytes, wrap["oid"]) != true {
        return false
    }
    let ki = cryptoDerTlv(bytes, wrap["val"]["body"])
    if ki == false || ki["tag"] != 4 || ki["end"] != wrap["val"]["end"] {
        return false
    }
    if ki["len"] < 1 || ki["len"] > 20 {
        return false
    }
    return ki
}

pub fn tls13PeerAkiKeyId(bytes, extn) {
    let wrap = tls13PeerExtOctet(bytes, extn)
    if wrap == false || tls13PeerAkiOid(bytes, wrap["oid"]) != true {
        return false
    }
    let seq = cryptoDerTlv(bytes, wrap["val"]["body"])
    if seq == false || seq["tag"] != 48 || seq["end"] != wrap["val"]["end"] {
        return false
    }
    let kid = cryptoDerTlv(bytes, seq["body"])
    if kid == false || kid["tag"] != 128 {
        return false
    }
    if kid["len"] < 1 || kid["len"] > 20 {
        return false
    }
    return kid
}

pub fn tls13PeerKeyIdEqual(bytes, a, b) {
    if a == false || b == false || a["len"] != b["len"] {
        return false
    }
    let i = 0
    while i < a["len"] {
        if (bytes["" + (a["body"] + i)] & 255) != (bytes["" + (b["body"] + i)] & 255) {
            return false
        }
        i = i + 1
    }
    return true
}

pub fn tls13PeerAkiExts(bytes, exts) {
    if exts == false || exts["tag"] != 48 {
        return false
    }
    let ski = false
    let aki = false
    let i = exts["body"]
    while i < exts["end"] {
        let extn = cryptoDerTlv(bytes, i)
        if extn == false {
            return false
        }
        let s = tls13PeerSkiKeyId(bytes, extn)
        if s != false {
            ski = s
        }
        let a = tls13PeerAkiKeyId(bytes, extn)
        if a != false {
            aki = a
        }
        i = extn["end"]
    }
    return tls13PeerKeyIdEqual(bytes, ski, aki)
}

pub fn tls13PeerAkiAfterSpki(bytes, tbs, spki) {
    let i = spki["end"]
    while i < tbs["end"] {
        let item = cryptoDerTlv(bytes, i)
        if item == false {
            return false
        }
        if item["tag"] == 163 {
            let inner = cryptoDerTlv(bytes, item["body"])
            if inner == false || inner["end"] != item["end"] {
                return false
            }
            return tls13PeerAkiExts(bytes, inner)
        }
        i = item["end"]
    }
    return false
}

pub fn tls13PeerAkiEvalOk(port) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false {
        tcp_close(s["sock"])
        return false
    }
    let der = tls13PeerCertDer(s["cert"])
    tcp_close(s["sock"])
    if der == false {
        return false
    }
    let outer = cryptoDerTlv(der, 0)
    if outer == false || outer["tag"] != 48 || outer["end"] != der["n"] {
        return false
    }
    let tbs = cryptoDerTlv(der, outer["body"])
    if tbs == false || tbs["tag"] != 48 {
        return false
    }
    let first = cryptoDerTlv(der, tbs["body"])
    if first == false {
        return false
    }
    let serialOff = tbs["body"]
    if first["tag"] == 160 {
        serialOff = first["end"]
    }
    let serial = cryptoDerTlv(der, serialOff)
    if serial == false || serial["tag"] != 2 {
        return false
    }
    let innerAlg = cryptoDerTlv(der, serial["end"])
    if innerAlg == false || innerAlg["tag"] != 48 {
        return false
    }
    let issuer = cryptoDerTlv(der, innerAlg["end"])
    if issuer == false || issuer["tag"] != 48 {
        return false
    }
    let validity = cryptoDerTlv(der, issuer["end"])
    if validity == false || validity["tag"] != 48 {
        return false
    }
    let subject = cryptoDerTlv(der, validity["end"])
    if subject == false || subject["tag"] != 48 {
        return false
    }
    let spki = cryptoDerTlv(der, subject["end"])
    if spki == false || spki["tag"] != 48 {
        return false
    }
    return tls13PeerAkiAfterSpki(der, tbs, spki)
}
