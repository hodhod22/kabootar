// SH23: bind high-level Kab TLS 1.3 client into http_fetch for rustls-peer :28296.
// Uses crypto_tls13_client's connect+get instead of the lower-level peer_get.
// Cheap smokes import only kab/http/http_fetch. cryptoHostDeleteOk stays false.

import "kab/http/http_fetch"
import "kab/crypto/crypto_tls13_client"

pub fn tls13ClientFetch(method, url, body, headers, timeoutMs) {
    if timeoutMs != 0 {
        return false
    }
    if len(url) < 8 {
        return false
    }
    if str_slice(url, 0, 8) != "https://" {
        return false
    }
    if httpPortFromHttps(url) != 28296 {
        return false
    }
    let host = httpHostName(httpHostFromHttps(url))
    if httpIsLoopbackHost(host) != true {
        return false
    }
    let s = tls13ClientConnect(host, 28296)
    if s == false {
        return false
    }
    let resp = tls13ClientGet(s, httpFetchTarget(method, url))
    tcp_close(s["sock"])
    if resp == false {
        return false
    }
    let o = {}
    o["status"] = 200
    o["body"] = httpBytesToStr(resp)
    o["headers"] = {}
    return o
}

httpBindTls13PeerFetch(tls13ClientFetch)