// SH23: Kab TLS 1.3 peer cert pin consistency vs rustls P-256 peer.
// Two consecutive connections to the same peer must return the same DER certificate.
// Do not grow crypto_tls13_peer_chain.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"

pub fn tls13PeerPinEqual(a, b) {
    if a == false || b == false {
        return false
    }
    if a["n"] != b["n"] {
        return false
    }
    let i = 0
    while i < a["n"] {
        if (a["" + i] & 255) != (b["" + i] & 255) {
            return false
        }
        i = i + 1
    }
    return true
}

pub fn tls13PeerPinEvalOk(port) {
    let s1 = tls13PeerHsClientOpen(port)
    if s1 == false {
        return false
    }
    if s1["cert"] == false {
        tcp_close(s1["sock"])
        return false
    }
    let der1 = tls13PeerCertDer(s1["cert"])
    tcp_close(s1["sock"])
    if der1 == false {
        return false
    }
    let s2 = tls13PeerHsClientOpen(port)
    if s2 == false {
        return false
    }
    if s2["cert"] == false {
        tcp_close(s2["sock"])
        return false
    }
    let der2 = tls13PeerCertDer(s2["cert"])
    tcp_close(s2["sock"])
    if der2 == false {
        return false
    }
    return tls13PeerPinEqual(der1, der2)
}