// SH23: Kab TLS 1.3 leaf Validity notBefore/notAfter vs rustls P-256 peer.
// Do not grow crypto_tls13_peer_san.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_root"

pub fn tls13PeerTimeDigit(bytes, off) {
    let b = bytes["" + off] & 255
    if b < 48 || b > 57 {
        return false
    }
    return b - 48
}

pub fn tls13PeerTimePair(bytes, off) {
    let hi = tls13PeerTimeDigit(bytes, off)
    let lo = tls13PeerTimeDigit(bytes, off + 1)
    if hi == false || lo == false {
        return false
    }
    return hi * 10 + lo
}

pub fn tls13PeerTimePacked(bytes, t) {
    if t == false {
        return false
    }
    let y = 0
    let i = t["body"]
    if t["tag"] == 23 {
        if t["len"] != 13 {
            return false
        }
        let yy = tls13PeerTimePair(bytes, i)
        if yy == false {
            return false
        }
        if yy < 50 {
            y = 2000 + yy
        } else {
            y = 1900 + yy
        }
        i = i + 2
    } else {
        if t["tag"] != 24 || t["len"] != 15 {
            return false
        }
        let c = tls13PeerTimePair(bytes, i)
        let yy = tls13PeerTimePair(bytes, i + 2)
        if c == false || yy == false {
            return false
        }
        y = c * 100 + yy
        i = i + 4
    }
    let mo = tls13PeerTimePair(bytes, i)
    let d = tls13PeerTimePair(bytes, i + 2)
    let h = tls13PeerTimePair(bytes, i + 4)
    let mi = tls13PeerTimePair(bytes, i + 6)
    let s = tls13PeerTimePair(bytes, i + 8)
    if mo == false || d == false || h == false || mi == false || s == false {
        return false
    }
    if (bytes["" + (i + 10)] & 255) != 90 {
        return false
    }
    if mo < 1 || mo > 12 || d < 1 || d > 31 {
        return false
    }
    if h > 23 || mi > 59 || s > 59 {
        return false
    }
    return y * 10000000000 + mo * 100000000 + d * 1000000 + h * 10000 + mi * 100 + s
}

pub fn tls13PeerValidityOk(bytes, validity) {
    if validity == false || validity["tag"] != 48 {
        return false
    }
    let nb = cryptoDerTlv(bytes, validity["body"])
    if nb == false {
        return false
    }
    let na = cryptoDerTlv(bytes, nb["end"])
    if na == false || na["end"] != validity["end"] {
        return false
    }
    let a = tls13PeerTimePacked(bytes, nb)
    let b = tls13PeerTimePacked(bytes, na)
    if a == false || b == false {
        return false
    }
    return a < b
}

pub fn tls13PeerTimeEvalOk(port) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false {
        tcp_close(s["sock"])
        return false
    }
    let der = tls13PeerCertDer(s["cert"])
    tcp_close(s["sock"])
    if der == false {
        return false
    }
    let outer = cryptoDerTlv(der, 0)
    if outer == false || outer["tag"] != 48 || outer["end"] != der["n"] {
        return false
    }
    let tbs = cryptoDerTlv(der, outer["body"])
    if tbs == false || tbs["tag"] != 48 {
        return false
    }
    let first = cryptoDerTlv(der, tbs["body"])
    if first == false {
        return false
    }
    let serialOff = tbs["body"]
    if first["tag"] == 160 {
        serialOff = first["end"]
    }
    let serial = cryptoDerTlv(der, serialOff)
    if serial == false || serial["tag"] != 2 {
        return false
    }
    let innerAlg = cryptoDerTlv(der, serial["end"])
    if innerAlg == false || innerAlg["tag"] != 48 {
        return false
    }
    let issuer = cryptoDerTlv(der, innerAlg["end"])
    if issuer == false || issuer["tag"] != 48 {
        return false
    }
    let validity = cryptoDerTlv(der, issuer["end"])
    return tls13PeerValidityOk(der, validity)
}
