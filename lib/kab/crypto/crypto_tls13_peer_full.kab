// SH23: Kab TLS 1.3 full peer handshake vs rustls P-256 peer.
// Composite gate: ECDSA CertificateVerify + leaf trust + chain structure.
// Do not grow crypto_tls13_peer_ecdsa.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_tls13_peer_ecdsa"
import "kab/crypto/crypto_tls13_peer_trust"
import "kab/crypto/crypto_tls13_peer_chainall"

pub fn tls13PeerFullEvalOk(port) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false || s["cv"] == false {
        tcp_close(s["sock"])
        return false
    }
    let der = tls13PeerCertDer(s["cert"])
    if der == false {
        tcp_close(s["sock"])
        return false
    }
    // Chain structure: all certs well-formed
    if tls13PeerChainAllOk(s["cert"]) != true {
        tcp_close(s["sock"])
        return false
    }
    // Leaf trust gate
    if tls13PeerTrustDerOk(der) != true {
        tcp_close(s["sock"])
        return false
    }
    // ECDSA CertificateVerify
    let pt = tls13PeerP256Point(der)
    let cv = tls13PeerCvParse(s["cv"])
    let tr = tls13PeerTrBeforeCv(s["tr"], s["cv"])
    tcp_close(s["sock"])
    if pt == false || cv == false || tr == false {
        return false
    }
    if cv["scheme"] != 1027 {
        return false
    }
    let rs = tls13PeerEcdsaSig(cv["sig"])
    if rs == false {
        return false
    }
    let hash = tls13PeerCvSignedHash(tr)
    return ecdsaP256Verify(hash, rs["r"], rs["s"], pt["x"], pt["y"])
}