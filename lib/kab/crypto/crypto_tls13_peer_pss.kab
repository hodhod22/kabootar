// SH23: Kab TLS 1.3 RSA-PSS SHA-256 verify of CertificateVerify vs rustls RSA peer.
// Do not grow crypto_tls13_peer_cv.kab. Host rustls remains skuld.

import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_rsa_pss"
import "kab/crypto/crypto_root"
import "kab/crypto/crypto_tls_hs"
import "kab/crypto/crypto_sha_eval"
import "kab/crypto/crypto_hmac_eval"
import "kab/crypto/crypto_tls_prf"

pub fn tls13PeerPssSlice(bytes, start, n) {
    let o = {}
    let i = 0
    while i < n {
        o["" + i] = bytes["" + (start + i)] & 255
        i = i + 1
    }
    o["n"] = n
    return o
}

pub fn tls13PeerPssTrBeforeCv(tr, cv) {
    if tr == false || cv == false {
        return false
    }
    if tr["n"] < cv["n"] {
        return false
    }
    let n = tr["n"] - cv["n"]
    let i = 0
    while i < cv["n"] {
        if (tr["" + (n + i)] & 255) != (cv["" + i] & 255) {
            return false
        }
        i = i + 1
    }
    return tls13PeerPssSlice(tr, 0, n)
}

pub fn tls13PeerPssSignedHash(tr) {
    let pad = {}
    let i = 0
    while i < 64 {
        pad["" + i] = 32
        i = i + 1
    }
    pad["n"] = 64
    let ctx = hmacStrBytes("TLS 1.3, server CertificateVerify")
    let z = {}
    z["0"] = 0
    z["n"] = 1
    let th = tlsTranscriptHashObj(tr)
    let content = tlsConcatObj(tlsConcatObj(tlsConcatObj(pad, ctx), z), th)
    return hmacDigestToObj(sha256Bytes(tlsObjToArr(content)))
}

pub fn tls13PeerDerIntBytes(bytes, tlv) {
    if tlv == false || tlv["tag"] != 2 {
        return false
    }
    let start = tlv["body"]
    let n = tlv["len"]
    if n < 1 {
        return false
    }
    if (bytes["" + start] & 255) == 0 {
        if n < 2 {
            return false
        }
        start = start + 1
        n = n - 1
    }
    return tls13PeerPssSlice(bytes, start, n)
}

pub fn tls13PeerRsaSpki(der) {
    let spki = cryptoRootTbsSpki(der)
    if spki == false {
        return false
    }
    let mod = tls13PeerDerIntBytes(der, spki["modulus"])
    let exp = tls13PeerDerIntBytes(der, spki["exponent"])
    if mod == false || exp == false {
        return false
    }
    if exp["n"] != 3 {
        return false
    }
    if (exp["0"] & 255) != 1 {
        return false
    }
    if (exp["1"] & 255) != 0 {
        return false
    }
    if (exp["2"] & 255) != 1 {
        return false
    }
    return mod
}

pub fn tls13PeerPssEvalOk(port) {
    let s = tls13PeerHsClientOpen(port)
    if s == false {
        return false
    }
    if s["cert"] == false || s["cv"] == false {
        tcp_close(s["sock"])
        return false
    }
    let der = tls13PeerCertDer(s["cert"])
    if der == false {
        tcp_close(s["sock"])
        return false
    }
    let mod = tls13PeerRsaSpki(der)
    let cv = tls13PeerCvParse(s["cv"])
    let tr = tls13PeerPssTrBeforeCv(s["tr"], s["cv"])
    tcp_close(s["sock"])
    if mod == false || cv == false || tr == false {
        return false
    }
    if cv["scheme"] != 2052 {
        return false
    }
    let sig = cv["sig"]
    if sig["n"] != mod["n"] {
        return false
    }
    let nl = ((mod["n"] + 1) / 2) | 0
    let n = rsaVFromBe(mod, nl)
    let sInt = rsaVFromBe(sig, nl)
    let emInt = rsaVPow65537(sInt, n, nl)
    let em = rsaVToBe(emInt, mod["n"])
    if (em["0"] & 128) != 0 {
        return false
    }
    let hash = tls13PeerPssSignedHash(tr)
    return rsaPssVerifySha256(em, hash)
}
