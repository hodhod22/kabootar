// SH23: authenticated Kab TLS 1.3 live client. Before any application data is
// sent the server must prove possession of its certificate key: chain structure,
// leaf checks, ECDSA P-256 CertificateVerify over the transcript, and the leaf
// DER must equal a pin (trust-on-first-use when pin == false). Host rustls remains skuld.
// import "kab/crypto/crypto_tls13_live_auth"

import "kab/crypto/crypto_tls13_live"
import "kab/crypto/crypto_tls13_peer_fin"
import "kab/crypto/crypto_tls13_peer_get"
import "kab/crypto/crypto_tls13_peer_cv"
import "kab/crypto/crypto_tls13_peer_ecdsa"
import "kab/crypto/crypto_tls13_peer_trust"
import "kab/crypto/crypto_tls13_peer_chainall"
import "kab/crypto/crypto_tls13_peer_pin"
import "kab/crypto/crypto_ecdsa_verify"
import "kab/crypto/crypto_http_get"
import "kab/crypto/crypto_http_resp"
import "kab/http/http_util"

pub fn tls13LiveAuthDer(s) {
    if s["cert"] == false || s["cv"] == false {
        return false
    }
    let der = tls13PeerCertDer(s["cert"])
    if der == false {
        return false
    }
    if tls13PeerChainAllOk(s["cert"]) != true {
        return false
    }
    if tls13PeerTrustDerOk(der) != true {
        return false
    }
    let pt = tls13PeerP256Point(der)
    let cv = tls13PeerCvParse(s["cv"])
    let tr = tls13PeerTrBeforeCv(s["tr"], s["cv"])
    if pt == false || cv == false || tr == false {
        return false
    }
    if cv["scheme"] != 1027 {
        return false
    }
    let rs = tls13PeerEcdsaSig(cv["sig"])
    if rs == false {
        return false
    }
    if ecdsaP256Verify(tls13PeerCvSignedHash(tr), rs["r"], rs["s"], pt["x"], pt["y"]) != true {
        return false
    }
    return der
}

pub fn tls13LiveGetPinned(port, path, pin) {
    let s = tls13LiveHsOpen(port)
    if s == false {
        return false
    }
    let der = tls13LiveAuthDer(s)
    if der == false {
        tcp_close(s["sock"])
        return false
    }
    if pin != false {
        if tls13PeerPinEqual(der, pin) != true {
            tcp_close(s["sock"])
            return false
        }
    }
    let resp = tls13PeerAppAfterHs(s, httpBuildGet("127.0.0.1", path))
    if resp == false {
        return false
    }
    let o = {}
    o["status"] = httpStatusCode(resp)
    o["body"] = httpBytesToStr(httpRespBody(resp))
    o["pin"] = der
    return o
}

pub fn tls13LiveAuthEvalOk(port, otherPort) {
    let a = tls13LiveGetPinned(port, "/v?q=1", false)
    if a == false || a["status"] != 200 || a["body"] != "OK" {
        return false
    }
    let b = tls13LiveGetPinned(port, "/v?q=2", a["pin"])
    if b == false || b["status"] != 200 || b["body"] != "OK" {
        return false
    }
    let c = tls13LiveGetPinned(otherPort, "/v?q=3", false)
    if c == false || c["status"] != 200 || c["body"] != "OK" {
        return false
    }
    if tls13PeerPinEqual(c["pin"], a["pin"]) == true {
        return false
    }
    if tls13LiveGetPinned(otherPort, "/v?q=4", a["pin"]) != false {
        return false
    }
    return true
}
