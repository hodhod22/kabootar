/// SH23: TLS 1.3 key schedule (RFC 8446 §7.1) i Kab — Early → Handshake →
/// Master secret, c/s handshake- och application-traffic secrets, exporter-
/// och resumption-master, Finished verify_data och record-öppning (AEAD) av
/// en komplett TLS 1.3-record. KAT mot RFC 8448 §3 (Simple 1-RTT).
import "kab/crypto/crypto_tls13_hkdf"
import "kab/crypto/crypto_tls13_hs"
import "kab/crypto/crypto_tls13_gcm"
import "kab/crypto/crypto_tls13_keyupd"
import "kab/crypto/crypto_x25519_eval"
import "kab/crypto/crypto_hmac_eval"
import "kab/crypto/crypto_sha_eval"
import "kab/crypto/crypto_tls_hs"
import "kab/crypto/crypto_tls_prf"
import "kab/crypto/crypto_gcm_eval"

/// Derive-Secret(secret, label, transcript-hash) för SHA-256.
pub fn tls13KsDeriveSecret(secret, label, th) {
    return tls13HkdfExpandLabel(secret, label, th, 32)
}

/// Early → Handshake → Master utan PSK (IKM = 0^32 för early och master).
pub fn tls13KeySchedule(ecdhe) {
    let emptyHash = hmacDigestToObj(sha256Bytes([]))
    let zeros = tls13HashZeros()
    let ks = {}
    ks["emptyHash"] = emptyHash
    ks["early"] = tls13HkdfExtract(zeros, zeros)
    ks["hsDerived"] = tls13KsDeriveSecret(ks["early"], "derived", emptyHash)
    ks["hs"] = tls13HkdfExtract(ks["hsDerived"], ecdhe)
    ks["msDerived"] = tls13KsDeriveSecret(ks["hs"], "derived", emptyHash)
    ks["master"] = tls13HkdfExtract(ks["msDerived"], zeros)
    return ks
}

/// Handshake traffic secrets över transcript-hash(ClientHello..ServerHello).
pub fn tls13KsHsTraffic(ks, thHello) {
    ks["cHs"] = tls13KsDeriveSecret(ks["hs"], "c hs traffic", thHello)
    ks["sHs"] = tls13KsDeriveSecret(ks["hs"], "s hs traffic", thHello)
    return ks
}

/// Application traffic + exporter över transcript-hash(ClientHello..server Finished).
pub fn tls13KsApTraffic(ks, thSrvFin) {
    ks["cAp"] = tls13KsDeriveSecret(ks["master"], "c ap traffic", thSrvFin)
    ks["sAp"] = tls13KsDeriveSecret(ks["master"], "s ap traffic", thSrvFin)
    ks["exp"] = tls13KsDeriveSecret(ks["master"], "exp master", thSrvFin)
    return ks
}

/// Resumption master över transcript-hash(ClientHello..client Finished).
pub fn tls13KsResMaster(ks, thCliFin) {
    ks["res"] = tls13KsDeriveSecret(ks["master"], "res master", thCliFin)
    return ks
}

/// Finished verify_data = HMAC(finished_key, transcript-hash).
pub fn tls13FinishedVd(baseSecret, th) {
    let finKey = tls13HkdfExpandLabel(baseSecret, "finished", tls13EmptyObj(), 32)
    return hmacDigestToObj(hmacSha256WordsObj(finKey, th))
}

/// Öppna en komplett TLS 1.3-record (5-byte header + ct + tag) → inner plaintext
/// (med avslutande content type), eller false vid fel header/AEAD-fel.
pub fn tls13OpenRecord(key, iv, seq, rec) {
    let n = rec["n"]
    if n < 22 {
        return false
    }
    if (rec["0"] & 255) != 23 || (rec["1"] & 255) != 3 || (rec["2"] & 255) != 3 {
        return false
    }
    let size = ((rec["3"] << 8) | rec["4"]) & 65535
    if size + 5 != n || size < 17 {
        return false
    }
    let head = {}
    let i = 0
    while i < 5 {
        head["" + i] = rec["" + i] & 255
        i = i + 1
    }
    head["n"] = 5
    let ctLen = size - 16
    let ct = {}
    i = 0
    while i < ctLen {
        ct["" + i] = rec["" + (5 + i)] & 255
        i = i + 1
    }
    ct["n"] = ctLen
    let tag = {}
    i = 0
    while i < 16 {
        tag["" + i] = rec["" + (5 + ctLen + i)] & 255
        i = i + 1
    }
    tag["n"] = 16
    let plainHex = gcmDecrypt(key, tls13Nonce(iv, seq), ct, tag, head)
    if plainHex == false {
        return false
    }
    return tlsHexToObj(plainHex)
}

/// RFC 8448 §3 KAT: ECDHE, parse CH/SH, hela key schedule, nycklar/IV,
/// server+client Finished, öppna serverns krypterade handshake-flight och
/// klientens Finished-record, samt avvisa en manipulerad record.
pub fn tls13KsRfc8448EvalOk() {
    let ch = tlsHexToObj("")
    let sh = tlsHexToObj("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304")
    if tls13ParseClientHello(ch) == false {
        return false
    }
    let shp = tls13ParseServerHello(sh)
    if shp == false {
        return false
    }
    let ecdhe = x25519(tlsHexToObj("49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005"), tlsHexToObj("c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f"))
    if tlsObjHex(ecdhe) != "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d" {
        return false
    }
    let ks = tls13KeySchedule(ecdhe)
    if tlsObjHex(ks["early"]) != "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a" {
        return false
    }
    if tlsObjHex(ks["hsDerived"]) != "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba" {
        return false
    }
    if tlsObjHex(ks["hs"]) != "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac" {
        return false
    }
    if tlsObjHex(ks["msDerived"]) != "43de77e0c77713859a944db9db2590b53190a65b3ee2e4f12dd7a0bb7ce254b4" {
        return false
    }
    if tlsObjHex(ks["master"]) != "18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919" {
        return false
    }
    let th1 = tlsTranscriptHashObj(tlsConcatObj(ch, sh))
    if tlsObjHex(th1) != "860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8" {
        return false
    }
    tls13KsHsTraffic(ks, th1)
    if tlsObjHex(ks["cHs"]) != "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21" {
        return false
    }
    if tlsObjHex(ks["sHs"]) != "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38" {
        return false
    }
    let sk = tls13TrafficKeys(ks["sHs"])
    let ck = tls13TrafficKeys(ks["cHs"])
    if tlsObjHex(sk["key"]) != "3fce516009c21727d0f2e4e86ee403bc" {
        return false
    }
    if tlsObjHex(sk["iv"]) != "5d313eb2671276ee13000b30" {
        return false
    }
    if tlsObjHex(ck["key"]) != "dbfaa693d1762c5b666af5d950258d01" {
        return false
    }
    if tlsObjHex(ck["iv"]) != "5bd3c71b836e0b76bb73265f" {
        return false
    }
    let ee = tlsHexToObj("080000240022000a00140012001d00170018001901000101010201030104001c0002400100000000")
    let cert = tlsHexToObj("")
    let cv = tlsHexToObj("0f000084080400805a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3")
    let trCv = tlsConcatObj(tlsConcatObj(tlsConcatObj(tlsConcatObj(ch, sh), ee), cert), cv)
    let sVd = tls13FinishedVd(ks["sHs"], tlsTranscriptHashObj(trCv))
    if tlsObjHex(sVd) != "9b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718" {
        return false
    }
    let sFin = tlsHsWrap(20, sVd)
    if tlsObjHex(sFin) != "140000209b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718" {
        return false
    }
    let flight = tlsConcatObj(tlsConcatObj(tlsConcatObj(ee, cert), cv), sFin)
    let srec = tlsHexToObj("")
    let spt = tls13OpenRecord(sk["key"], sk["iv"], 0, srec)
    if spt == false {
        return false
    }
    let sHsPlain = tls13StripInner(spt)
    if sHsPlain == false {
        return false
    }
    if tlsObjHex(sHsPlain) != tlsObjHex(flight) {
        return false
    }
    let bad = tlsHexToObj("")
    bad["40"] = (bad["40"] ^ 1) & 255
    if tls13OpenRecord(sk["key"], sk["iv"], 0, bad) != false {
        return false
    }
    if tls13OpenRecord(sk["key"], sk["iv"], 1, srec) != false {
        return false
    }
    let trSf = tlsConcatObj(trCv, sFin)
    let th2 = tlsTranscriptHashObj(trSf)
    if tlsObjHex(th2) != "9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13" {
        return false
    }
    tls13KsApTraffic(ks, th2)
    if tlsObjHex(ks["cAp"]) != "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5" {
        return false
    }
    if tlsObjHex(ks["sAp"]) != "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643" {
        return false
    }
    if tlsObjHex(ks["exp"]) != "fe22f881176eda18eb8f44529e6792c50c9a3f89452f68d8ae311b4309d3cf50" {
        return false
    }
    let sak = tls13TrafficKeys(ks["sAp"])
    let cak = tls13TrafficKeys(ks["cAp"])
    if tlsObjHex(sak["key"]) != "9f02283b6c9c07efc26bb9f2ac92e356" {
        return false
    }
    if tlsObjHex(sak["iv"]) != "cf782b88dd83549aadf1e984" {
        return false
    }
    if tlsObjHex(cak["key"]) != "17422dda596ed5d9acd890e3c63f5051" {
        return false
    }
    if tlsObjHex(cak["iv"]) != "5b78923dee08579033e523d9" {
        return false
    }
    let cVd = tls13FinishedVd(ks["cHs"], th2)
    if tlsObjHex(cVd) != "a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61" {
        return false
    }
    let cFin = tlsHsWrap(20, cVd)
    if tlsObjHex(cFin) != "14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61" {
        return false
    }
    let crec = tlsHexToObj("170303003575ec4dc238cce60b298044a71e219c56cc77b0517fe9b93c7a4bfc44d87f38f80338ac98fc46deb384bd1caeacab6867d726c40546")
    let cpt = tls13OpenRecord(ck["key"], ck["iv"], 0, crec)
    if cpt == false {
        return false
    }
    let cHsPlain = tls13StripInner(cpt)
    if cHsPlain == false {
        return false
    }
    if tlsObjHex(cHsPlain) != tlsObjHex(cFin) {
        return false
    }
    let th3 = tlsTranscriptHashObj(tlsConcatObj(trSf, cFin))
    if tlsObjHex(th3) != "209145a96ee8e2a122ff810047cc952684658d6049e86429426db87c54ad143d" {
        return false
    }
    tls13KsResMaster(ks, th3)
    if tlsObjHex(ks["res"]) != "7df235f2031d2a051287d02b0241b0bfdaf86cc856231f2d5aba46c434ec196c" {
        return false
    }
    return true
}
