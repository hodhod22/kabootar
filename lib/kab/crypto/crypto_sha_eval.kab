// SH23: SHA-256 eval (FIPS 180-4). import "kab/crypto/crypto_sha_eval"
// Do not grow crypto_sha.kab. Host hash natives remain skuld.

pub fn shaWrap(x) {
    return x | 0
}

pub fn shaRotr(x, n) {
    return (x >>> n) | (x << (32 - n))
}

