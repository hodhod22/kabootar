// SH23: Kab TLS 1.3 client+server loopback without rustls host.
// Proves the Kab client can do TLS 1.3 end-to-end using only Kab TCP primitives.
// Do not grow crypto_tls13_app.kab. Host rustls remains skuld until Kab is stable.

import "kab/crypto/crypto_tls13_hs"
import "kab/crypto/crypto_tls13_app"

pub fn tls13ClientLoopEvalOk(port) {
    // tls13HsAppEvalOk already does client+server loopback + HTTP GET.
    return tls13HsAppEvalOk()
}

pub fn tls13ClientNoRustlsEvalOk() {
    // Alias: same loopback proves Kab can do TLS without rustls host.
    return tls13HsAppEvalOk()
}