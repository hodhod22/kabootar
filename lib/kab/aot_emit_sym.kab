// F10: serialize the first symbol-table record for a Kab-native image payload.
// Do not import other kab/aot* leaves. Symbol serialization stays in Kab.

pub fn aotEmitSymbol(target) {
    if target == "x64" {
        return "sym:text:32:main:x64"
    }
    if target == "arm64" {
        return "sym:text:32:main:arm64"
    }
    return ""
}
