// SH17 deepen: validate i64 loop8 template. import "kab/jit_patch_loop"
// Do not grow jit_loop.kab.

import "kab/jit_loop"
import "kab/jit_check"

pub fn jitPatchLoopOk(bytes) {
    let tpl = jitEmitI64Loop8()
    if len(bytes) != 8 {
        return false
    }
    if len(tpl) != 8 {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
