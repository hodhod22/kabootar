// SH28: aggregate host delete policy off noll.kab. import "kab/noll/noll_host"
// Do not grow noll.kab. All SH19–SH27 gates must stay false before src/ delete.

import "kab/load/load_main"
import "kab/gc/gc_host"
import "kab/std/std_host"
import "kab/os/os_host"
import "kab/sql/sql_host"
import "kab/crypto/crypto_host"
import "kab/http/http_host"
import "kab/cli/cli_host"
import "kab/sci/sci_host"
import "kab/ui/ui_host"

pub fn nollHostDeleteOk() {
    return false
}

/// True when every SH19–SH27 delete gate is still closed (all false).
/// Honestly false now: loadMainDeleteOk, gcHostDeleteOk,
/// kabOsHostDeleteOk, cliHostDeleteOk, stdHostDeleteOk,
/// sqlHostDeleteOk, httpHostDeleteOk, cryptoHostDeleteOk,
/// sciHostDeleteOk and uiHostDeleteOk flipped after production
/// evidence — the host-deletion phase has begun.
/// Use nollPendingHostGatesClosed for the remaining gates.
pub fn nollAllHostGatesClosed() {
    if nollPendingHostGatesClosed() == false {
        return false
    }
    if loadMainDeleteOk() {
        return false
    }
    if kabOsHostDeleteOk() {
        return false
    }
    if sqlHostDeleteOk() {
        return false
    }
    if gcHostDeleteOk() {
        return false
    }
    if cliHostDeleteOk() {
        return false
    }
    if stdHostDeleteOk() {
        return false
    }
    if httpHostDeleteOk() {
        return false
    }
    if cryptoHostDeleteOk() {
        return false
    }
    if sciHostDeleteOk() {
        return false
    }
    if uiHostDeleteOk() {
        return false
    }
    return true
}

/// True when every SH19–SH27 delete gate not yet satisfied by production
/// evidence is still closed (all false). All of load, gc, os, cli, std,
/// sql, http, crypto (KAB_TLS_PEERS aggregate passed), sci and ui are
/// satisfied today — no pending SH19–SH27 gates remain. SH28 stays
/// blocked on nollHostDeleteOk.
pub fn nollPendingHostGatesClosed() {
    return true
}
