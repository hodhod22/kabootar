// SH28: rustc is still the process — policy "rustc-not-process" is false.
// import "kab/noll/noll_rustc"
// Audit: target/release/kabootar is produced by `cargo build --release` —
// no rustc-free artifact path exists yet (needs the AOT-compiled binary or
// a pinned release asset). The Kab runtime itself still lives in src/*.rs
// as the host interpreter; Kab-native VM/compiler exists and bootstraps
// (dag seeds regenerated by the Kab compiler), but the OS process entry
// point is Rust. Do not grow noll_cargo.kab. Do not delete src/.
// nollAotReady stays false.

pub fn nollRustcNotProcess() {
    return false
}
