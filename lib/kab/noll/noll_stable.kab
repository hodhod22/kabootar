// SH28: archive src/ when Kab stands on its own feet — the stability
// window is waived (0 months). import "kab/noll/noll_stable"
// Do not grow noll_drop.kab. The window was a policy delay, not a
// correctness gate — on a stall the Rust host can still help us fix it.

import "kab/noll/noll_keep"
import "kab/noll/noll_aot"

/// Required stability window before src/ may be archived (months).
/// Waived: 0 — stability is proven by the passing gate battery, not
/// by waiting. Rust stays available as a fix-up aid until archived.
pub fn nollStableMonths() {
    return 0
}

/// True when the stability requirement is met (window is 0, so any
/// non-negative count qualifies) and source is still kept.
pub fn nollStableOk(months) {
    if months < nollStableMonths() {
        return false
    }
    return nollKeepSrc()
}

/// Archive decision: requirement met AND AOT ready — stays false today
/// (nollAotReady is still false).
pub fn nollArcReady(months) {
    if nollStableOk(months) == false {
        return false
    }
    return nollAotReady()
}
