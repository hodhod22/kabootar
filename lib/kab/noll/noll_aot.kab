// can replace rustc as the bootstrap producer. Flip criteria, in order:
//   1. image carries real machine code run by a real OS process;
//   2. the emitted image covers the full Kabootar surface (compiler+VM),
//      not only fused op templates;
//   3. rustc leaves the build+CI path (nollRustcNotProcess, nollRustcCiGone);
//   4. 6-month stability window on Kab's own feet (nollStableOk).

pub fn nollAotReady() {
    return false
}
