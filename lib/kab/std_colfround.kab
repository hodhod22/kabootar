// SH20: collections fround off std_colclz32.kab. import "kab/std_colfround"
// Do not grow std_colclz32.kab. stdHostDeleteOk stays false.

pub fn stdColFround(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, fround(a[i]))
        i = i + 1
    }
    return out
}
