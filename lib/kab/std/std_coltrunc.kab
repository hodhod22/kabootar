// SH20: collections trunc off std_colround.kab. import "kab/std/std_coltrunc"
// Do not grow std_colround.kab. stdHostDeleteOk stays false.

pub fn stdColTrunc(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, trunc(a[i]))
        i = i + 1
    }
    return out
}
