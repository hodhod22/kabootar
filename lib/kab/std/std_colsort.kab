// SH20: collections sort off std_colmode.kab. import "kab/std/std_colsort"
// Do not grow std_colmode.kab. stdHostDeleteOk stays false.
// Merge sort O(n log n). object_array_push builds in place — bare push() copies.

fn msMerge(a, b) {
    let out = { "a": [] }
    let i = 0
    let j = 0
    let na = len(a)
    let nb = len(b)
    while i < na && j < nb {
        if b[j] < a[i] {
            object_array_push(out, "a", b[j])
            j = j + 1
        } else {
            object_array_push(out, "a", a[i])
            i = i + 1
        }
    }
    while i < na {
        object_array_push(out, "a", a[i])
        i = i + 1
    }
    while j < nb {
        object_array_push(out, "a", b[j])
        j = j + 1
    }
    return out["a"]
}

fn msSortRange(p, lo, hi) {
    if hi - lo <= 1 {
        let out = { "a": [] }
        if hi > lo {
            object_array_push(out, "a", p[lo])
        }
        return out["a"]
    }
    let mid = lo + (hi - lo) / 2
    let left = msSortRange(p, lo, mid)
    let right = msSortRange(p, mid, hi)
    return msMerge(left, right)
}

pub fn stdColSort(p) {
    let sorted = msSortRange(p, 0, len(p))
    return sorted
}
