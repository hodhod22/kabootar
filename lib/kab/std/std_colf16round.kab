// SH20: collections f16round off std_colfround.kab. import "kab/std/std_colf16round"
// Do not grow std_colfround.kab. stdHostDeleteOk stays false.

pub fn stdColF16round(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, f16round(a[i]))
        i = i + 1
    }
    return out
}
