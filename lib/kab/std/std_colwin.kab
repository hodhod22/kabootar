// SH20: collections window off std_colslice.kab. import "kab/std/std_colwin"
// Do not grow std_colslice.kab. stdHostDeleteOk stays false.

import "kab/std/std_colslice"

pub fn stdColWindow(p, k) {
    let n = len(p)
    let out = []
    if k < 1 {
        return out
    }
    if k > n {
        return out
    }
    let i = 0
    let last = n - k
    while i <= last {
        out = push(out, stdColSlice(p, i, i + k))
        i = i + 1
    }
    return out
}
