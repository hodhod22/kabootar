// SH20: collections repeat off std_colclone.kab. import "kab/std/std_colrepeat"
// Do not grow std_colclone.kab. stdHostDeleteOk flipped true (production evidence).

import "kab/std/std_colclone"
import "kab/std/std_colconcat"

pub fn stdColRepeat(p, k) {
    let out = []
    let i = 0
    while i < k {
        out = stdColConcat(out, stdColClone(p))
        i = i + 1
    }
    return out
}
