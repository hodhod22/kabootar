// SH20: collections hypot off std_colatan2.kab. import "kab/std/std_colhypot"
// Do not grow std_colatan2.kab. stdHostDeleteOk stays false.

pub fn stdColHypot(a, b) {
    let n = len(a)
    let nb = len(b)
    if nb < n {
        n = nb
    }
    let out = []
    let i = 0
    while i < n {
        out = push(out, hypot(a[i], b[i]))
        i = i + 1
    }
    return out
}
