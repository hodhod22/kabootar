// SH20: collections ceil off std_colfloor.kab. import "kab/std/std_colceil"
// Do not grow std_colfloor.kab. stdHostDeleteOk flipped true (production evidence).

pub fn stdColCeil(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, ceil(a[i]))
        i = i + 1
    }
    return out
}
