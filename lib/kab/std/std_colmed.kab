// SH20: collections median off std_colavg.kab. import "kab/std/std_colmed"
// Do not grow std_colavg.kab. stdHostDeleteOk stays false.
// Sorting lives in std_colsort (merge sort, rebuild via push; no index-slot assign).

import "kab/std/std_colsort"

pub fn stdColMedian(p) {
    let n = len(p)
    if n == 0 {
        return 0
    }
    let sorted = stdColSort(p)
    let mid = n / 2
    if mid + mid == n {
        return (sorted[mid - 1] + sorted[mid]) / 2
    }
    return sorted[mid]
}
