// SH20: JSON parse/stringify in Kab. import "kab/std/std_json_codec"
// Do not grow std_json.kab. Host json_parse remains skuld.
// Strings slice whole runs between escapes — no per-char concat.

fn jpSkip(st) {
    let s = st["s"]
    let i = st["i"]
    let n = len(s)
    let i0 = i
    while i < n {
        let c = char_code_at(s, i)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            break
        }
    }
    if i != i0 {
        st["i"] = i
    }
}

fn jpNeed(st, ch) {
    jpSkip(st)
    let s = st["s"]
    let i = st["i"]
    if i >= len(s) {
        throw "stdJsonParse truncated"
    }
    if char_code_at(s, i) != ch {
        throw "stdJsonParse expected char"
    }
    st["i"] = i + 1
}

fn jpNull(st) {
    let i = st["i"]
    if str_slice(st["s"], i, i + 4) != "null" {
        throw "stdJsonParse null"
    }
    st["i"] = i + 4
    return null
}

fn jpTrue(st) {
    let i = st["i"]
    if str_slice(st["s"], i, i + 4) != "true" {
        throw "stdJsonParse true"
    }
    st["i"] = i + 4
    return true
}

fn jpFalse(st) {
    let i = st["i"]
    if str_slice(st["s"], i, i + 5) != "false" {
        throw "stdJsonParse false"
    }
    st["i"] = i + 5
    return false
}

fn jpNum(st) {
    let s = st["s"]
    let n = len(s)
    let i = st["i"]
    let start = i
    if char_code_at(s, i) == 45 {
        i = i + 1
    }
    if i >= n {
        throw "stdJsonParse number"
    }
    let d = char_code_at(s, i)
    if d < 48 || d > 57 {
        throw "stdJsonParse number"
    }
    while i < n {
        d = char_code_at(s, i)
        if d < 48 || d > 57 {
            break
        }
        i = i + 1
    }
    st["i"] = i
    return parse_int(str_slice(s, start, i))
}

fn jpStr(st) {
    jpNeed(st, 34)
    let s = st["s"]
    let n = len(s)
    let i = st["i"]
    let q = from_char_code(34)
    let bs = from_char_code(92)
    let out = ""
    let run = i
    while true {
        let qpos = str_index_of(s, q, i)
        let bpos = str_index_of(s, bs, i)
        if qpos < 0 {
            throw "stdJsonParse string"
        }
        if bpos < 0 || qpos < bpos {
            st["i"] = qpos + 1
            return out + str_slice(s, run, qpos)
        }
        out = out + str_slice(s, run, bpos)
        let e = bpos + 1
        if e >= n {
            throw "stdJsonParse string escape"
        }
        let ec = char_code_at(s, e)
        if ec == 34 {
            out = out + q
        } else {
            if ec == 92 {
                out = out + bs
            } else {
                throw "stdJsonParse string escape"
            }
        }
        i = e + 1
        run = i
    }
}

fn jpArr(st) {
    jpNeed(st, 91)
    jpSkip(st)
    let s = st["s"]
    let n = len(s)
    let acc = { "a": [] }
    if st["i"] < n {
        if char_code_at(s, st["i"]) == 93 {
            st["i"] = st["i"] + 1
            return acc["a"]
        }
    }
    while true {
        object_array_push(acc, "a", jpVal(st))
        jpSkip(st)
        let i = st["i"]
        if i >= n {
            throw "stdJsonParse array"
        }
        let c = char_code_at(s, i)
        if c == 93 {
            st["i"] = i + 1
            return acc["a"]
        }
        if c != 44 {
            throw "stdJsonParse array comma"
        }
        st["i"] = i + 1
    }
}

fn jpObj(st) {
    jpNeed(st, 123)
    jpSkip(st)
    let s = st["s"]
    let n = len(s)
    let o = {}
    if st["i"] < n {
        if char_code_at(s, st["i"]) == 125 {
            st["i"] = st["i"] + 1
            return o
        }
    }
    while true {
        let k = jpStr(st)
        jpNeed(st, 58)
        o[k] = jpVal(st)
        jpSkip(st)
        let i = st["i"]
        if i >= n {
            throw "stdJsonParse object"
        }
        let c = char_code_at(s, i)
        if c == 125 {
            st["i"] = i + 1
            return o
        }
        if c != 44 {
            throw "stdJsonParse object comma"
        }
        st["i"] = i + 1
        jpSkip(st)
    }
}

fn jpVal(st) {
    jpSkip(st)
    let s = st["s"]
    if st["i"] >= len(s) {
        throw "stdJsonParse eof"
    }
    let c = char_code_at(s, st["i"])
    if c == 34 {
        return jpStr(st)
    }
    if c == 123 {
        return jpObj(st)
    }
    if c == 91 {
        return jpArr(st)
    }
    if c == 110 {
        return jpNull(st)
    }
    if c == 116 {
        return jpTrue(st)
    }
    if c == 102 {
        return jpFalse(st)
    }
    return jpNum(st)
}

pub fn stdJsonParse(s) {
    let st = { "s": "" + s, "i": 0 }
    let v = jpVal(st)
    jpSkip(st)
    if st["i"] != len(st["s"]) {
        throw "stdJsonParse trailing"
    }
    return v
}

fn jqStr(s) {
    let q = from_char_code(34)
    let bs = from_char_code(92)
    let src = "" + s
    let n = len(src)
    let i = 0
    let run = 0
    let parts = { "a": [q] }
    while i < n {
        let qpos = str_index_of(src, q, i)
        let bpos = str_index_of(src, bs, i)
        let nxt = n
        if qpos >= 0 {
            nxt = qpos
        }
        if bpos >= 0 && bpos < nxt {
            nxt = bpos
        }
        if nxt == n {
            break
        }
        object_array_push(parts, "a", str_slice(src, run, nxt))
        if qpos == nxt {
            object_array_push(parts, "a", bs + q)
        } else {
            object_array_push(parts, "a", bs + bs)
        }
        i = nxt + 1
        run = i
    }
    object_array_push(parts, "a", str_slice(src, run, n))
    object_array_push(parts, "a", q)
    return array_join(parts["a"], "")
}

pub fn stdJsonStringify(v) {
    if v == null {
        return "null"
    }
    if v == true {
        return "true"
    }
    if v == false {
        return "false"
    }
    let t = typeof(v)
    if t == "number" {
        return "" + v
    }
    if t == "string" {
        return jqStr(v)
    }
    if t == "array" {
        let parts = { "a": ["["] }
        let i = 0
        let n = len(v)
        while i < n {
            if i > 0 {
                object_array_push(parts, "a", ",")
            }
            object_array_push(parts, "a", stdJsonStringify(v[i]))
            i = i + 1
        }
        object_array_push(parts, "a", "]")
        return array_join(parts["a"], "")
    }
    let ks = keys(v)
    let parts = { "a": ["{"] }
    let i = 0
    let n = len(ks)
    while i < n {
        if i > 0 {
            object_array_push(parts, "a", ",")
        }
        object_array_push(parts, "a", jqStr(ks[i]))
        object_array_push(parts, "a", ":")
        object_array_push(parts, "a", stdJsonStringify(v[ks[i]]))
        i = i + 1
    }
    object_array_push(parts, "a", "}")
    return array_join(parts["a"], "")
}

/// Parse object JSON, add into field, stringify+parse still holds the original field.
pub fn stdJsonEvalOk() {
    let q = from_char_code(34)
    let src = "{" + q + "n" + q + ":40}"
    let o = stdJsonParse(src)
    if o["n"] + 2 != 42 {
        return false
    }
    let o2 = stdJsonParse(stdJsonStringify(o))
    if o2["n"] != 40 {
        return false
    }
    return true
}
