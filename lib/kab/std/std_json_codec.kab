// SH20: JSON parse/stringify in Kab. import "kab/std/std_json_codec"
// Do not grow std_json.kab. Host json_parse remains skuld.

fn jpSkip(st) {
    let s = st["s"]
    let i = st["i"]
    let n = len(s)
    while i < n {
        let c = char_code_at(s, i)
        if c == 32 {
            i = i + 1
        } else {
            if c == 9 {
                i = i + 1
            } else {
                if c == 10 {
                    i = i + 1
                } else {
                    if c == 13 {
                        i = i + 1
                    } else {
                        st["i"] = i
                        return
                    }
                }
            }
        }
    }
    st["i"] = i
}

fn jpNeed(st, ch) {
    jpSkip(st)
    let s = st["s"]
    if st["i"] >= len(s) {
        throw "stdJsonParse truncated"
    }
    if char_code_at(s, st["i"]) != ch {
        throw "stdJsonParse expected char"
    }
    st["i"] = st["i"] + 1
}

fn jpNull(st) {
    let s = st["s"]
    let i = st["i"]
    if str_slice(s, i, i + 4) != "null" {
        throw "stdJsonParse null"
    }
    st["i"] = i + 4
    return null
}

fn jpTrue(st) {
    let s = st["s"]
    let i = st["i"]
    if str_slice(s, i, i + 4) != "true" {
        throw "stdJsonParse true"
    }
    st["i"] = i + 4
    return true
}

fn jpFalse(st) {
    let s = st["s"]
    let i = st["i"]
    if str_slice(s, i, i + 5) != "false" {
        throw "stdJsonParse false"
    }
    st["i"] = i + 5
    return false
}

fn jpNum(st) {
    let s = st["s"]
    let i = st["i"]
    let n = len(s)
    let start = i
    if char_code_at(s, i) == 45 {
        i = i + 1
    }
    if i >= n {
        throw "stdJsonParse number"
    }
    let d = char_code_at(s, i)
    if d < 48 {
        throw "stdJsonParse number"
    }
    if d > 57 {
        throw "stdJsonParse number"
    }
    while i < n {
        d = char_code_at(s, i)
        if d < 48 {
            break
        }
        if d > 57 {
            break
        }
        i = i + 1
    }
    st["i"] = i
    return parse_int(str_slice(s, start, i))
}

fn jpStr(st) {
    let s = st["s"]
    jpNeed(st, 34)
    let i = st["i"]
    let n = len(s)
    let out = ""
    while i < n {
        let c = char_code_at(s, i)
        if c == 34 {
            st["i"] = i + 1
            return out
        }
        if c == 92 {
            i = i + 1
            if i >= n {
                throw "stdJsonParse string escape"
            }
            let e = char_code_at(s, i)
            if e == 34 {
                out = out + from_char_code(34)
            } else {
                if e == 92 {
                    out = out + from_char_code(92)
                } else {
                    throw "stdJsonParse string escape"
                }
            }
            i = i + 1
        } else {
            out = out + str_slice(s, i, i + 1)
            i = i + 1
        }
    }
    throw "stdJsonParse string"
}

fn jpArr(st) {
    jpNeed(st, 91)
    jpSkip(st)
    let acc = []
    if st["i"] < len(st["s"]) {
        if char_code_at(st["s"], st["i"]) == 93 {
            st["i"] = st["i"] + 1
            return acc
        }
    }
    while true {
        acc = push(acc, jpVal(st))
        jpSkip(st)
        if st["i"] >= len(st["s"]) {
            throw "stdJsonParse array"
        }
        let c = char_code_at(st["s"], st["i"])
        if c == 93 {
            st["i"] = st["i"] + 1
            return acc
        }
        if c != 44 {
            throw "stdJsonParse array comma"
        }
        st["i"] = st["i"] + 1
    }
}

fn jpObj(st) {
    jpNeed(st, 123)
    jpSkip(st)
    let o = {}
    if st["i"] < len(st["s"]) {
        if char_code_at(st["s"], st["i"]) == 125 {
            st["i"] = st["i"] + 1
            return o
        }
    }
    while true {
        let k = jpStr(st)
        jpNeed(st, 58)
        o[k] = jpVal(st)
        jpSkip(st)
        if st["i"] >= len(st["s"]) {
            throw "stdJsonParse object"
        }
        let c = char_code_at(st["s"], st["i"])
        if c == 125 {
            st["i"] = st["i"] + 1
            return o
        }
        if c != 44 {
            throw "stdJsonParse object comma"
        }
        st["i"] = st["i"] + 1
        jpSkip(st)
    }
}

fn jpVal(st) {
    jpSkip(st)
    if st["i"] >= len(st["s"]) {
        throw "stdJsonParse eof"
    }
    let c = char_code_at(st["s"], st["i"])
    if c == 110 {
        return jpNull(st)
    }
    if c == 116 {
        return jpTrue(st)
    }
    if c == 102 {
        return jpFalse(st)
    }
    if c == 34 {
        return jpStr(st)
    }
    if c == 91 {
        return jpArr(st)
    }
    if c == 123 {
        return jpObj(st)
    }
    return jpNum(st)
}

pub fn stdJsonParse(s) {
    let st = { "s": "" + s, "i": 0 }
    let v = jpVal(st)
    jpSkip(st)
    if st["i"] != len(st["s"]) {
        throw "stdJsonParse trailing"
    }
    return v
}

fn jqStr(s) {
    let q = from_char_code(34)
    let out = q
    let i = 0
    let n = len("" + s)
    while i < n {
        let c = char_code_at(s, i)
        if c == 34 {
            out = out + from_char_code(92) + q
        } else {
            if c == 92 {
                out = out + from_char_code(92) + from_char_code(92)
            } else {
                out = out + str_slice(s, i, i + 1)
            }
        }
        i = i + 1
    }
    return out + q
}

pub fn stdJsonStringify(v) {
    if v == null {
        return "null"
    }
    if v == true {
        return "true"
    }
    if v == false {
        return "false"
    }
    if typeof(v) == "number" {
        return "" + v
    }
    if typeof(v) == "string" {
        return jqStr(v)
    }
    if typeof(v) == "array" {
        let out = "["
        let i = 0
        while i < len(v) {
            if i > 0 {
                out = out + ","
            }
            out = out + stdJsonStringify(v[i])
            i = i + 1
        }
        return out + "]"
    }
    let ks = keys(v)
    let out = "{"
    let i = 0
    while i < len(ks) {
        if i > 0 {
            out = out + ","
        }
        out = out + jqStr(ks[i]) + ":" + stdJsonStringify(v[ks[i]])
        i = i + 1
    }
    return out + "}"
}

/// Parse object JSON, add into field, stringify+parse still holds the original field.
pub fn stdJsonEvalOk() {
    let q = from_char_code(34)
    let src = "{" + q + "n" + q + ":40}"
    let o = stdJsonParse(src)
    if o["n"] + 2 != 42 {
        return false
    }
    let o2 = stdJsonParse(stdJsonStringify(o))
    if o2["n"] != 40 {
        return false
    }
    return true
}
