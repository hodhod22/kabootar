// SH20: collections rest off std_collast.kab. import "kab/std/std_colrest"
// Do not grow std_collast.kab. stdHostDeleteOk flipped true (production evidence).

pub fn stdColRest(p) {
    let n = len(p)
    let out = []
    let i = 1
    while i < n {
        out = push(out, p[i])
        i = i + 1
    }
    return out
}
