// SH20: collections atan2 off std_colatan.kab. import "kab/std/std_colatan2"
// Do not grow std_colatan.kab. stdHostDeleteOk stays false.

pub fn stdColAtan2(y, x) {
    let n = len(y)
    let nx = len(x)
    if nx < n {
        n = nx
    }
    let out = []
    let i = 0
    while i < n {
        out = push(out, atan2(y[i], x[i]))
        i = i + 1
    }
    return out
}
