// SH20: collections sin off std_colexp.kab. import "kab/std/std_colsin"
// Do not grow std_colexp.kab. stdHostDeleteOk stays false.

pub fn stdColSin(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, sin(a[i]))
        i = i + 1
    }
    return out
}
