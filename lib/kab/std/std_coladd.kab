// SH20: collections add off std_colscale.kab. import "kab/std/std_coladd"
// Do not grow std_colscale.kab. stdHostDeleteOk stays false.

pub fn stdColAdd(a, b) {
    let n = len(a)
    let nb = len(b)
    if nb < n {
        n = nb
    }
    let out = []
    let i = 0
    while i < n {
        out = push(out, a[i] + b[i])
        i = i + 1
    }
    return out
}
