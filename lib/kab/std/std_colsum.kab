// SH20: collections sum off std_colrange.kab. import "kab/std/std_colsum"
// Do not grow std_colrange.kab. stdHostDeleteOk flipped true (production evidence).

pub fn stdColSum(p) {
    let s = 0
    let n = len(p)
    let i = 0
    while i < n {
        s = s + p[i]
        i = i + 1
    }
    return s
}
