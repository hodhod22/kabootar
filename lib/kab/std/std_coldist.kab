// SH20: collections L2-distance off std_colrej.kab. import "kab/std/std_coldist"
// Do not grow std_colrej.kab. stdHostDeleteOk stays false.

pub fn stdColDist(a, b) {
    let s = 0
    let n = len(a)
    let nb = len(b)
    if nb < n {
        n = nb
    }
    let i = 0
    while i < n {
        let d = a[i] - b[i]
        s = s + d * d
        i = i + 1
    }
    return sqrt(s)
}
