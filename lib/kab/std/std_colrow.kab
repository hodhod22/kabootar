// SH20: collections row off std_coltrc.kab. import "kab/std/std_colrow"
// Do not grow std_coltrc.kab. stdHostDeleteOk stays false.

pub fn stdColRow(rows, i) {
    let n = len(rows)
    if i < 0 {
        return []
    }
    if i >= n {
        return []
    }
    let row = rows[i]
    let out = []
    let j = 0
    let w = len(row)
    while j < w {
        out = push(out, row[j])
        j = j + 1
    }
    return out
}
