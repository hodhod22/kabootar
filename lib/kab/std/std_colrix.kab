// SH20: collections rindex off std_colrfind.kab. import "kab/std/std_colrix"
// Do not grow std_colrfind.kab. stdHostDeleteOk stays false.

pub fn stdColRIndex(p, x) {
    let n = len(p)
    let i = n
    while i > 0 {
        i = i - 1
        if p[i] == x {
            return i
        }
    }
    return 0 - 1
}
