// SH20: collections log10 off std_collog2.kab. import "kab/std/std_collog10"
// Do not grow std_collog2.kab. stdHostDeleteOk stays false.

pub fn stdColLog10(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, log10(a[i]))
        i = i + 1
    }
    return out
}
