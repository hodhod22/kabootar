// SH20: collections cbrt off std_colhypot.kab. import "kab/std/std_colcbrt"
// Do not grow std_colhypot.kab. stdHostDeleteOk flipped true (production evidence).

pub fn stdColCbrt(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, cbrt(a[i]))
        i = i + 1
    }
    return out
}
