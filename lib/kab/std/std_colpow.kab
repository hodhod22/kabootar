// SH20: collections hadamard pow off std_colmod.kab. import "kab/std/std_colpow"
// Do not grow std_colmod.kab. stdHostDeleteOk stays false.

pub fn stdColPow(a, b) {
    let n = len(a)
    let nb = len(b)
    if nb < n {
        n = nb
    }
    let out = []
    let i = 0
    while i < n {
        let r = 1
        let base = a[i]
        let e = b[i]
        let j = 0
        while j < e {
            r = r * base
            j = j + 1
        }
        out = push(out, r)
        i = i + 1
    }
    return out
}
