// SH20: collections imul off std_colcbrt.kab. import "kab/std/std_colimul"
// Do not grow std_colcbrt.kab. stdHostDeleteOk stays false.

pub fn stdColImul(a, b) {
    let n = len(a)
    let nb = len(b)
    if nb < n {
        n = nb
    }
    let out = []
    let i = 0
    while i < n {
        out = push(out, imul(a[i], b[i]))
        i = i + 1
    }
    return out
}
