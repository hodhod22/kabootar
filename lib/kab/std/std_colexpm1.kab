// SH20: collections expm1 off std_collog1p.kab. import "kab/std/std_colexpm1"
// Do not grow std_collog1p.kab. stdHostDeleteOk stays false.

pub fn stdColExpm1(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, expm1(a[i]))
        i = i + 1
    }
    return out
}
