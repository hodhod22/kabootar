// SH17 deepen: loop-neg guest mmap args. import "kab/jit_mm_loop_neg"
// Do not grow jit_mm_loop_not.kab. Separate virt slot from loop-not.

import "kab/jit_loop_neg"

pub fn jitMmLoopNegPid() {
    return 1
}

pub fn jitMmLoopNegVirt() {
    return 516096
}

pub fn jitMmLoopNegLen() {
    return 4096
}

pub fn jitMmLoopNegProt() {
    return 7
}

pub fn jitOsMmapLoopNegOk(nBytes, kind, n) {
    if jitLoopNegOk(n) == false {
        return false
    }
    if nBytes != jitLoopNegLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopNegLen() != 4096 {
        return false
    }
    if jitMmLoopNegProt() != 7 {
        return false
    }
    return true
}
