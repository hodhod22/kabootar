// F10: native image filename and return opcode must agree.
// import "kab/aot_verify_ret"; do not import other kab/aot* leaves.

pub fn aotVerifyRetOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "c3"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "d65f03c0"
    }
    return false
}
