// SH17 deepen: mmap+exec policy for loop-ge template. import "kab/jit_run_loop_ge"
// Do not grow jit_run_loop_le.kab.

import "kab/jit_mmap_loop"
import "kab/jit_np"
import "kab/jit_exec"
import "kab/jit_mm_loop_ge"
import "kab/jit_patch_loop_ge"
import "kab/jit_loop_ge"

pub fn jitRunLoopGeOk(base, kind, bytes, n, k) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopGeOk(bytes, n, k) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopGeOk(nb, kind, n, k) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
