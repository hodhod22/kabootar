// SH17 deepen: guest store for loop-je template. import "kab/jit_mm_store_loop_je"
// Do not grow jit_mm_store_loop_test.kab.

import "kab/jit_mm_loop_je"
import "kab/jit_loop_je"

pub fn jitMmStoreLoopJe(bytes, n, k) {
    if jitLoopJeOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopJeLen() {
        return 0
    }
    let pid = jitMmLoopJePid()
    let virt = jitMmLoopJeVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
