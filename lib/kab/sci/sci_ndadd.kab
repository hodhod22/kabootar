// SH26: nd elementwise add kernel off sci_nd.kab. import "kab/sci/sci_ndadd"
// Do not grow sci_nd.kab. Host GPU remains syscall skuld.

pub fn sciNdAdd(a, b) {
    let n = len(a)
    let nb = len(b)
    if nb < n {
        n = nb
    }
    let out = []
    let i = 0
    while i < n {
        out = push(out, a[i] + b[i])
        i = i + 1
    }
    return out
}
