// SH26: FFT size gate off sci.kab. import "kab/sci/sci_fft"
// Do not grow sci.kab. Host FFT remains skuld.

pub fn sciFftPow2(n) {
    if n == 1 {
        return true
    }
    if n == 2 {
        return true
    }
    if n == 4 {
        return true
    }
    if n == 8 {
        return true
    }
    return false
}
