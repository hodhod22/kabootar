// F10: loader accepts only a documented first-image and opcode.
// import "kab/aot_load_and"; do not import other kab/aot* leaves.

pub fn aotLoadAndOk(op, target) {
    if target == "x64" {
        return op == "21c0"
    }
    if target == "arm64" {
        return op == "8a000000"
    }
    return false
}
