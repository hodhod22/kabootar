// F10: first Kab-native images emit a documented jne opcode for the return register.
// import "kab/aot_jne_op"; do not import other kab/aot* leaves.

pub fn aotJneOp(target) {
    if target == "x64" {
        return "7500"
    }
    if target == "arm64" {
        return "54000001"
    }
    return ""
}
