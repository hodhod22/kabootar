// F10: native image filename and pop opcode must agree.
// import "kab/aot_verify_pop"; do not import other kab/aot* leaves.

pub fn aotVerifyPopOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "58"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "e00741f8"
    }
    return false
}
