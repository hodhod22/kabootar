// F10: first Kab-native images emit a documented js opcode for the return register.
// import "kab/aot_js_op"; do not import other kab/aot* leaves.

pub fn aotJsOp(target) {
    if target == "x64" {
        return "7800"
    }
    if target == "arm64" {
        return "54000004"
    }
    return ""
}
