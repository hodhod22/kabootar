// SH20: collections mat-vec off std_coldot.kab. import "kab/std_colmv"
// Do not grow std_coldot.kab. stdHostDeleteOk stays false.

import "kab/std_coldot"

pub fn stdColMatVec(m, v) {
    let n = len(m)
    let out = []
    let i = 0
    while i < n {
        let row = m[i]
        out = push(out, stdColDot(row, v))
        i = i + 1
    }
    return out
}
