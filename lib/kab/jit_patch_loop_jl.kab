// SH17 deepen: validate i64 loop-jl template. import "kab/jit_patch_loop_jl"
// Do not grow jit_patch_loop_jmp.kab.

import "kab/jit_loop_jl"
import "kab/jit_check"

pub fn jitPatchLoopJlOk(bytes, n, k) {
    if jitLoopJlOk(n, k) == false {
        return false
    }
    let tpl = jitEmitI64LoopJlN(n, k)
    if len(bytes) != jitLoopJlLen() {
        return false
    }
    if len(tpl) != jitLoopJlLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
