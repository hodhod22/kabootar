// SH17 deepen: translate+store for loop-jg template. import "kab/jit_wr_loop_jg"
// Do not grow jit_wr_loop_jle.kab.

import "kab/jit_patch_loop_jg"
import "kab/jit_mm_loop_jg"
import "kab/jit_mm_store_loop_jg"
import "kab/jit_loop_jg"

pub fn jitWrLoopJgOk(bytes, n, k) {
    if jitPatchLoopJgOk(bytes, n, k) == false {
        return false
    }
    let pid = jitMmLoopJgPid()
    let virt = jitMmLoopJgVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopJg(bytes, n, k)
    if w != jitLoopJgLen() {
        return false
    }
    return true
}
