// SH17 deepen: guest call for loop-shr template. import "kab/jit_mm_call_loop_shr"
// Do not grow jit_mm_call_loop_shl.kab.

import "kab/jit_mm_loop_shr"
import "kab/jit_loop_shr"

pub fn jitMmCallLoopShr(bytes, n, sh) {
    if jitLoopShrOk(n, sh) == false {
        return 0
    }
    if len(bytes) != jitLoopShrLen() {
        return 0
    }
    let pid = jitMmLoopShrPid()
    let virt = jitMmLoopShrVirt()
    let rax = os_mm_call(pid, virt)
    if rax != jitLoopShrRax(n, sh) {
        return 0
    }
    return rax
}
