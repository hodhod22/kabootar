// SH17 deepen: loop-add guest mmap args. import "kab/jit_mm_loop_add"
// Do not grow jit_mm_loop_n.kab. Separate virt slot from loopN.

import "kab/jit_loop_add"

pub fn jitMmLoopAddPid() {
    return 1
}

pub fn jitMmLoopAddVirt() {
    return 417792
}

pub fn jitMmLoopAddLen() {
    return 4096
}

pub fn jitMmLoopAddProt() {
    return 7
}

pub fn jitOsMmapLoopAddOk(nBytes, kind, n, k) {
    if jitLoopAddOk(n, k) == false {
        return false
    }
    if nBytes != jitLoopAddLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopAddLen() != 4096 {
        return false
    }
    if jitMmLoopAddProt() != 7 {
        return false
    }
    return true
}
