// SH17 deepen: validate i64 loop-sub template. import "kab/jit_patch_loop_sub"
// Do not grow jit_patch_loop_add.kab.

import "kab/jit_loop_sub"
import "kab/jit_check"

pub fn jitPatchLoopSubOk(bytes, n, s) {
    if jitLoopSubOk(n, s) == false {
        return false
    }
    let tpl = jitEmitI64LoopSubN(n, s)
    if len(bytes) != jitLoopSubLen() {
        return false
    }
    if len(tpl) != jitLoopSubLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if bytes[3] != tpl[3] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
