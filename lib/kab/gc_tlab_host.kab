// F11 deepen: TLAB pause plus host-GC drop gate. import "kab/gc_tlab_host"
// Do not grow gc_tlab_pause.kab or gc_host.kab. gcHostDeleteOk stays false.

import "kab/gc_tlab_pause"
import "kab/gc_host"

pub fn gcTlabHostDropOk(workers, used, cap, pauseMs, wantDelete) {
    if gcTlabPauseOk(workers, used, cap, pauseMs) == false {
        return false
    }
    if wantDelete != gcHostDeleteOk() {
        return false
    }
    return true
}
