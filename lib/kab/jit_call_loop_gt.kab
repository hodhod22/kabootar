// SH17 deepen: loop-gt wr+run+call pipeline. import "kab/jit_call_loop_gt"
// Do not grow jit_call_loop_lt.kab.

import "kab/jit_wr_loop_gt"
import "kab/jit_run_loop_gt"
import "kab/jit_mm_call_loop_gt"
import "kab/jit_loop_gt"

pub fn jitCallLoopGtOk(base, kind, n, k, bytes) {
    if jitLoopGtOk(n, k) == false {
        return false
    }
    if jitWrLoopGtOk(bytes, n, k) == false {
        return false
    }
    if jitRunLoopGtOk(base, kind, bytes, n, k) == false {
        return false
    }
    let rax = jitMmCallLoopGt(bytes, n, k)
    if rax != jitLoopGtRax(n, k) {
        return false
    }
    return true
}
