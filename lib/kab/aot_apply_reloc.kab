    }
    if target == "arm64" {
        if table == "relocs:reloc:text:32:0:main:arm64;reloc:text:32:8:main:arm64" {
            return base + 32 + 8
        }
        return -1
    }
    return -1
}

// F10: materialize the canonical relocated 64-bit word as little-endian image bytes.
pub fn aotApplyRelocTableWordHex(table, base, target) {
    if base != 4096 {
        return ""
    }
    if target == "x64" {
        if table == "relocs:reloc:text:32:0:main:x64;reloc:text:32:8:main:x64" {
            return "2810000000000000"
        }
        return ""
    }
    if target == "arm64" {
        if table == "relocs:reloc:text:32:0:main:arm64;reloc:text:32:8:main:arm64" {
            return "2810000000000000"
        }
        return ""
    }
    return ""
}

// F10: little-endian hex of the addend-0 patched address (4128 at base 4096).
pub fn aotApplyRelocTableWordHexAt32(table, base, target) {
    if base != 4096 {
        return ""
    }
    if target == "x64" {
        if table == "relocs:reloc:text:32:0:main:x64;reloc:text:32:8:main:x64" {
            return "2010000000000000"
        }
        return ""
    }
    if target == "arm64" {
        if table == "relocs:reloc:text:32:0:main:arm64;reloc:text:32:8:main:arm64" {
            return "2010000000000000"
        }
        return ""
    }
    return ""
}

// F10: little-endian hex of the addend-8 patched address (4136 at base 4096).
pub fn aotApplyRelocTableWordHexAt40(table, base, target) {
    if base != 4096 {
        return ""
    }
    if target == "x64" {
        if table == "relocs:reloc:text:32:0:main:x64;reloc:text:32:8:main:x64" {
