// F10: patched address of the rodata relocation (section offset 0, addend 0 → base + 0).
pub fn aotApplyRelocTableAddressRodata(table, base, target) {
    if base < 0 {
        return -1
    }
    if target == "x64" {
        if table == "relocs:reloc:rodata:0:0:kstr:x64" {
            return base + 0
        }
        return -1
    }
    if target == "arm64" {
        if table == "relocs:reloc:rodata:0:0:kstr:arm64" {
            return base + 0
        }
        return -1
    }
    return -1
}
