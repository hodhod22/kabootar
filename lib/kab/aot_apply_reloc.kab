        }
        return ""
    }
    return ""
}

// F10: write the relocated 64-bit word onto a combined-table native image.
pub fn aotApplyRelocTableToImage(image, table, base, target) {
    if base != 4096 {
        return ""
    }
    if target == "x64" {
        if table != "relocs:reloc:text:32:0:main:x64;reloc:text:32:8:main:x64" {
            return ""
        }
        if image != "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|syms:sym:text:0:_start:x64;sym:text:32:main:x64|relocs:reloc:text:32:0:main:x64;reloc:text:32:8:main:x64" {
            return ""
        }
        return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|syms:sym:text:0:_start:x64;sym:text:32:main:x64|relocs:reloc:text:32:0:main:x64;reloc:text:32:8:main:x64|relocword:2810000000000000"
    }
    if target == "arm64" {
        if table != "relocs:reloc:text:32:0:main:arm64;reloc:text:32:8:main:arm64" {
            return ""
        }
        if image != "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|syms:sym:text:0:_start:arm64;sym:text:32:main:arm64|relocs:reloc:text:32:0:main:arm64;reloc:text:32:8:main:arm64" {
            return ""
        }
        return "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|syms:sym:text:0:_start:arm64;sym:text:32:main:arm64|relocs:reloc:text:32:0:main:arm64;reloc:text:32:8:main:arm64|relocword:2810000000000000"
    }
    return ""
}

// F10: write the relocated 64-bit word into the return-stub machine-code hex.
pub fn aotApplyRelocTableToText(code, table, base, target) {
    if base != 4096 {
        return ""
    }
    if target == "x64" {
        if table != "relocs:reloc:text:32:0:main:x64;reloc:text:32:8:main:x64" {
            return ""
        }
        if code != "code:x64:ret" {
            return ""
        }
        return "code:x64:c3:2810000000000000"
    }
    if target == "arm64" {
        if table != "relocs:reloc:text:32:0:main:arm64;reloc:text:32:8:main:arm64" {
            return ""
        }
        if code != "code:arm64:ret" {
            return ""
        }
        return "code:arm64:d65f03c0:2810000000000000"
    }
    return ""
}

