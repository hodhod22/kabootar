// F10: native image filename and first-image bytes must agree.
// import "kab/aot_verify_full"; do not import other kab/aot* leaves.

pub fn aotVerifyFullOk(name, image) {
    if name == "kabootar-x64.kbn" {
        return image == "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret"
    }
    if name == "kabootar-arm64.kbn" {
        return image == "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret"
    }
    return false
}
