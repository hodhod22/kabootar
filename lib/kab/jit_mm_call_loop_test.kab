// SH17 deepen: guest call for loop-test template. import "kab/jit_mm_call_loop_test"
// Do not grow jit_mm_call_loop_ge.kab.

import "kab/jit_mm_loop_test"
import "kab/jit_loop_test"

pub fn jitMmCallLoopTest(bytes, n, k) {
    if jitLoopTestOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopTestLen() {
        return 0
    }
    let pid = jitMmLoopTestPid()
    let virt = jitMmLoopTestVirt()
    let rax = os_mm_call(pid, virt)
    if rax != jitLoopTestRax(n, k) {
        return 0
    }
    return rax
}
