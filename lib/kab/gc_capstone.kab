// SH18 capstone: full GC chain plus host delete gates closed. import "kab/gc_capstone"
// Do not grow gc_chain.kab. gcHostDeleteOk stays false.

import "kab/gc_chain"
import "kab/gc_host"
import "kab/noll_host"

pub fn gcCapstoneLiveGray() {
    return gcChainLiveGray()
}

/// True when GC host delete gate and all SH19–SH27 gates are still closed.
pub fn gcCapstoneGatesClosed() {
    if gcHostDeleteOk() {
        return false
    }
    return nollAllHostGatesClosed()
}

/// Full GC chain plus all host delete gates still closed.
pub fn gcCapstoneOk(live) {
    if gcChainOk(live) == false {
        return false
    }
    return gcCapstoneGatesClosed()
}
