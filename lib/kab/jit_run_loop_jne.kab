// SH17 deepen: mmap+exec policy for loop-jne template. import "kab/jit_run_loop_jne"
// Do not grow jit_run_loop_je.kab.

import "kab/jit_mmap_loop"
import "kab/jit_np"
import "kab/jit_exec"
import "kab/jit_mm_loop_jne"
import "kab/jit_patch_loop_jne"
import "kab/jit_loop_jne"

pub fn jitRunLoopJneOk(base, kind, bytes, n, k) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopJneOk(bytes, n, k) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopJneOk(nb, kind, n, k) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
