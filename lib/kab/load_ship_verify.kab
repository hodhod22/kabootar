// SH19 deepen: ship plus verify/load round-trip off PGO bootstrap. import "kab/load_ship_verify"
// Do not grow load_ship.kab. Host main.rs stays until ship verify smoke completes.
// Nested call args must be locals first — module-scope binding quirk.

import "kab/load_ship"
import "kab/load_aot_pgo"
import "kab/aot_verify_full"
import "kab/aot_loaded_image"
import "kab/aot_load_image"

    10|/// Shippable PGO image verifies, loads, and re-verifies.
pub fn loadShipVerifyOk(nBytes) {
    if loadShipOk(nBytes) == false {
        return false
    }
    let name = loadShipNativeName()
    let plan = loadAotPgoSymRelocPlan()
    let target = loadAotTarget()
    if aotVerifyFullOk(name, plan) == false {
    20|        return false
    }
    if aotLoadedImageOk(plan) == false {
        return false
    }
    if aotLoadImageWithPgoWarmFpColdSsSymRelocOk(plan, target) == false {
        return false
    }
    return aotVerifyFullOk(name, plan)
}
