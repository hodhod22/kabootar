// F10: native image filename and sub opcode must agree.
// import "kab/aot_verify_sub"; do not import other kab/aot* leaves.

pub fn aotVerifySubOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "29c0"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "cb000000"
    }
    return false
}
