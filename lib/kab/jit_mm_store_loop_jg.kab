// SH17 deepen: guest store for loop-jg template. import "kab/jit_mm_store_loop_jg"
// Do not grow jit_mm_store_loop_jle.kab.

import "kab/jit_mm_loop_jg"
import "kab/jit_loop_jg"

pub fn jitMmStoreLoopJg(bytes, n, k) {
    if jitLoopJgOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopJgLen() {
        return 0
    }
    let pid = jitMmLoopJgPid()
    let virt = jitMmLoopJgVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
