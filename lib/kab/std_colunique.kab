// SH20: collections unique off std_colflat.kab. import "kab/std_colunique"
// Do not grow std_colflat.kab. stdHostDeleteOk stays false.

import "kab/std_colcontains"

pub fn stdColUnique(p) {
    let out = []
    let n = len(p)
    let i = 0
    while i < n {
        let x = p[i]
        if stdColContains(out, x) == false {
            out = push(out, x)
        }
        i = i + 1
    }
    return out
}
