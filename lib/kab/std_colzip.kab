// SH20: collections zip off std_coldrop.kab. import "kab/std_colzip"
// Do not grow std_coldrop.kab. stdHostDeleteOk stays false.

pub fn stdColZip(a, b) {
    let na = len(a)
    let nb = len(b)
    let n = na
    if nb < n {
        n = nb
    }
    let out = []
    let i = 0
    while i < n {
        let pair = []
        pair = push(pair, a[i])
        pair = push(pair, b[i])
        out = push(out, pair)
        i = i + 1
    }
    return out
}
