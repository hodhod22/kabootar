// SH20: collections hadamard mul off std_colsub.kab. import "kab/std_colmul"
// Do not grow std_colsub.kab. stdHostDeleteOk stays false.

pub fn stdColMul(a, b) {
    let n = len(a)
    let nb = len(b)
    if nb < n {
        n = nb
    }
    let out = []
    let i = 0
    while i < n {
        out = push(out, a[i] * b[i])
        i = i + 1
    }
    return out
}
