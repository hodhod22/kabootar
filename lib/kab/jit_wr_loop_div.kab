// SH17 deepen: translate+store for loop-div template. import "kab/jit_wr_loop_div"
// Do not grow jit_wr_loop_mul.kab.

import "kab/jit_patch_loop_div"
import "kab/jit_mm_loop_div"
import "kab/jit_mm_store_loop_div"
import "kab/jit_loop_div"

pub fn jitWrLoopDivOk(bytes, n, d) {
    if jitPatchLoopDivOk(bytes, n, d) == false {
        return false
    }
    let pid = jitMmLoopDivPid()
    let virt = jitMmLoopDivVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopDiv(bytes, n, d)
    if w != jitLoopDivLen() {
        return false
    }
    return true
}
