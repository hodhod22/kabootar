// SH17 deepen: loop-jg wr+run+call pipeline. import "kab/jit_call_loop_jg"
// Do not grow jit_call_loop_jle.kab.

import "kab/jit_wr_loop_jg"
import "kab/jit_run_loop_jg"
import "kab/jit_mm_call_loop_jg"
import "kab/jit_loop_jg"

pub fn jitCallLoopJgOk(base, kind, n, k, bytes) {
    if jitLoopJgOk(n, k) == false {
        return false
    }
    if jitWrLoopJgOk(bytes, n, k) == false {
        return false
    }
    if jitRunLoopJgOk(base, kind, bytes, n, k) == false {
        return false
    }
    let rax = jitMmCallLoopJg(bytes, n, k)
    if rax != jitLoopJgRax(n, k) {
        return false
    }
    return true
}
