// SH17 deepen: validate i64 loopN template. import "kab/jit_patch_loop_n"
// Do not grow jit_patch_loop.kab.

import "kab/jit_loop_n"
import "kab/jit_check"

pub fn jitPatchLoopNOk(bytes, n) {
    if jitLoopNOk(n) == false {
        return false
    }
    let tpl = jitEmitI64LoopN(n)
    if len(bytes) != jitLoopNLen() {
        return false
    }
    if len(tpl) != jitLoopNLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
