// SH20: collections hadamard mod off std_colclamp.kab. import "kab/std_colmod"
// Do not grow std_colclamp.kab. stdHostDeleteOk stays false.

pub fn stdColMod(a, b) {
    let n = len(a)
    let nb = len(b)
    if nb < n {
        n = nb
    }
    let out = []
    let i = 0
    while i < n {
        out = push(out, a[i] % b[i])
        i = i + 1
    }
    return out
}
