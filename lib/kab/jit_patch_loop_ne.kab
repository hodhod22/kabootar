// SH17 deepen: validate i64 loop-ne template. import "kab/jit_patch_loop_ne"
// Do not grow jit_patch_loop_eq.kab.

import "kab/jit_loop_ne"
import "kab/jit_check"

pub fn jitPatchLoopNeOk(bytes, n, k) {
    if jitLoopNeOk(n, k) == false {
        return false
    }
    let tpl = jitEmitI64LoopNeN(n, k)
    if len(bytes) != jitLoopNeLen() {
        return false
    }
    if len(tpl) != jitLoopNeLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
