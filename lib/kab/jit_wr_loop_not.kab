// SH17 deepen: translate+store for loop-not template. import "kab/jit_wr_loop_not"
// Do not grow jit_wr_loop_ushr.kab.

import "kab/jit_patch_loop_not"
import "kab/jit_mm_loop_not"
import "kab/jit_mm_store_loop_not"
import "kab/jit_loop_not"

pub fn jitWrLoopNotOk(bytes, n) {
    if jitPatchLoopNotOk(bytes, n) == false {
        return false
    }
    let pid = jitMmLoopNotPid()
    let virt = jitMmLoopNotVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopNot(bytes, n)
    if w != jitLoopNotLen() {
        return false
    }
    return true
}
