// SH17 deepen: i64 loopN + eq template. import "kab/jit_loop_eq"
// Do not grow jit_loop_neg.kab. Magic U + n + k + ret; os_mm_call returns 1 iff n==k.

import "kab/jit_loop_n"

pub fn jitLoopEqKMax() {
    return 64
}

pub fn jitLoopEqKOk(k) {
    if k <= 0 {
        return false
    }
    if k > jitLoopEqKMax() {
        return false
    }
    return true
}

pub fn jitLoopEqOk(n, k) {
    if jitLoopNOk(n) == false {
        return false
    }
    if jitLoopEqKOk(k) == false {
        return false
    }
    return true
}

pub fn jitLoopEqRax(n, k) {
    if n == k {
        return 1
    }
    return 0
}

pub fn jitLoopEqLen() {
    return jitLoopNLen()
}

/// Loop marker 85, count n, rhs k, pad, ret — simulated guest rax=1 iff n==k.
pub fn jitEmitI64LoopEqN(n, k) {
    let b = []
    b = push(b, 85)
    b = push(b, n)
    b = push(b, k)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 195)
    return b
}
