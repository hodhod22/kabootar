// SH17 deepen: mmap+exec policy for loop-jg template. import "kab/jit_run_loop_jg"
// Do not grow jit_run_loop_jle.kab.

import "kab/jit_mmap_loop"
import "kab/jit_np"
import "kab/jit_exec"
import "kab/jit_mm_loop_jg"
import "kab/jit_patch_loop_jg"
import "kab/jit_loop_jg"

pub fn jitRunLoopJgOk(base, kind, bytes, n, k) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopJgOk(bytes, n, k) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopJgOk(nb, kind, n, k) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
