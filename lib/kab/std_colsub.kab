// SH20: collections sub off std_coladd.kab. import "kab/std_colsub"
// Do not grow std_coladd.kab. stdHostDeleteOk stays false.

pub fn stdColSub(a, b) {
    let n = len(a)
    let nb = len(b)
    if nb < n {
        n = nb
    }
    let out = []
    let i = 0
    while i < n {
        out = push(out, a[i] - b[i])
        i = i + 1
    }
    return out
}
