// SH17 deepen: mmap+exec policy for loop-nop template. import "kab/jit_run_loop_nop"
// Do not grow jit_run_loop_jge.kab.

import "kab/jit_mmap_loop"
import "kab/jit_np"
import "kab/jit_exec"
import "kab/jit_mm_loop_nop"
import "kab/jit_patch_loop_nop"
import "kab/jit_loop_nop"

pub fn jitRunLoopNopOk(base, kind, bytes, n, k) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopNopOk(bytes, n, k) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopNopOk(nb, kind, n, k) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
