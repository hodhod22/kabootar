// SH28: aggregate host delete policy off noll.kab. import "kab/noll_host"
// Do not grow noll.kab. All SH19–SH27 gates must stay false before src/ delete.

import "kab/load_main"
import "kab/gc_host"
import "kab/std_host"
import "kab/os_host"
import "kab/sql_host"
import "kab/crypto_host"
import "kab/http_host"
import "kab/cli_host"
import "kab/sci_host"
import "kab/ui_host"

pub fn nollHostDeleteOk() {
    return false
}

/// True when every SH19–SH27 delete gate is still closed (all false).
pub fn nollAllHostGatesClosed() {
    if loadMainDeleteOk() {
        return false
    }
    if gcHostDeleteOk() {
        return false
    }
    if stdHostDeleteOk() {
        return false
    }
    if kabOsHostDeleteOk() {
        return false
    }
    if sqlHostDeleteOk() {
        return false
    }
    if cryptoHostDeleteOk() {
        return false
    }
    if httpHostDeleteOk() {
        return false
    }
    if cliHostDeleteOk() {
        return false
    }
    if sciHostDeleteOk() {
        return false
    }
    if uiHostDeleteOk() {
        return false
    }
    return true
}
