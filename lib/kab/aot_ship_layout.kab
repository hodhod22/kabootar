// F10: layout is shippable only when name, payload, and target agree.
// import "kab/aot_ship_layout"; do not import other kab/aot* leaves.

pub fn aotShipLayoutOk(name, layout, target) {
    if target == "x64" {
        return name == "kabootar-x64.kbn" && layout == "text:rx|b80100000001c090c3||rodata:r|00||data:rw|00"
    }
    if target == "arm64" {
        return name == "kabootar-arm64.kbn" && layout == "text:rx|d28000208b000000d503201fd65f03c0||rodata:r|00||data:rw|00"
    }
    return false
}
