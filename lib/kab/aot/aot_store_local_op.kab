// F10: first Kab-native images emit a documented return-register store to a frame local.
// import "kab/aot/aot_store_local_op"; do not import other kab/aot* leaves.

pub fn aotStoreLocalOp(target) {
    if target == "x64" {
        return "488945f8"
    }
    if target == "arm64" {
        return "a00b00f9"
    }
    return ""
}
