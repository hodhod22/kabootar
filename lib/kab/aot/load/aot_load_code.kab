// F10: loader accepts only a target-qualified first-image return stub.
// import "kab/aot/aot_load_code"; do not import other kab/aot* leaves.

pub fn aotLoadCodeOk(code, target) {
    if target == "x64" {
        return code == "code:x64:ret"
    }
    if target == "arm64" {
        return code == "code:arm64:ret"
    }
    return false
}
