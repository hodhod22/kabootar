// F10: loader accepts only a documented first-image jmp opcode.
// import "kab/aot/aot_load_jmp"; do not import other kab/aot* leaves.

pub fn aotLoadJmpOk(op, target) {
    if target == "x64" {
        return op == "e900000000"
    }
    if target == "arm64" {
        return op == "14000000"
    }
    return false
}
