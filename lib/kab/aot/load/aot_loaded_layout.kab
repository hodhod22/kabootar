// F10: persisted layout bytes must match first native RX/R/RW concatenation.
// import "kab/aot/aot_loaded_layout"; do not import other kab/aot* leaves.

pub fn aotLoadedLayoutOk(layout) {
    if layout == "text:rx|b80100000001c029c00fafc0f7f821c009c0d1e0d1e8f7d033c0f7d839c085c0740075007c007e007f007d007700730072007600780079007a007b0070007100e90000000050584883ec104883c4104889d84889c3554889e5e80000000090488945f8488345f801488345f8ff48837df80048837df800740048837df8007500488b45f8c9c3||rodata:r|00||data:rw|00" {
        return true
    }
    if layout == "text:rx|||rodata:r|00||data:rw|00" {
        return true
    }
    return false
}
