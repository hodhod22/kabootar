// F10: loader accepts only a documented first-image jl opcode.
// import "kab/aot/aot_load_jl"; do not import other kab/aot* leaves.

pub fn aotLoadJlOk(op, target) {
    if target == "x64" {
        return op == "7c00"
    }
    if target == "arm64" {
        return op == "5400000b"
    }
    return false
}
