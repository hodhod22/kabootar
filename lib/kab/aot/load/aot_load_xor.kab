// F10: loader accepts only a documented first-image xor opcode.
// import "kab/aot/aot_load_xor"; do not import other kab/aot* leaves.

pub fn aotLoadXorOk(op, target) {
    if target == "x64" {
        return op == "33c0"
    }
    if target == "arm64" {
        return op == "ca000000"
    }
    return false
}
