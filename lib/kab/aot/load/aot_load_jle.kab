// F10: loader accepts only a documented first-image jle opcode.
// import "kab/aot/aot_load_jle"; do not import other kab/aot* leaves.

pub fn aotLoadJleOk(op, target) {
    if target == "x64" {
        return op == "7e00"
    }
    if target == "arm64" {
        return op == "5400000d"
    }
    return false
}
