// F10: native image filename and nop opcode must agree.
// import "kab/aot/aot_verify_nop"; do not import other kab/aot* leaves.

pub fn aotVerifyNopOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "90"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "d503201f"
    }
    return false
}
