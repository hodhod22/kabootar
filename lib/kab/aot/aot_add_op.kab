// F10: first Kab-native images emit a documented add opcode for the return register.
// import "kab/aot/aot_add_op"; do not import other kab/aot* leaves.

pub fn aotAddOp(target) {
    if target == "x64" {
        return "01c0"
    }
    if target == "arm64" {
        return "8b000000"
    }
    return ""
}
