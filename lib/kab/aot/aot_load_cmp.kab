// F10: loader accepts only a documented first-image cmp opcode.
// import "kab/aot/aot_load_cmp"; do not import other kab/aot* leaves.

pub fn aotLoadCmpOk(op, target) {
    if target == "x64" {
        return op == "39c0"
    }
    if target == "arm64" {
        return op == "eb00001f"
    }
    return false
}
