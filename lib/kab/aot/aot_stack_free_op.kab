// F10: first Kab-native images emit a documented 16-byte stack-release opcode.
// import "kab/aot/aot_stack_free_op"; do not import other kab/aot* leaves.

pub fn aotStackFreeOp(target) {
    if target == "x64" {
        return "4883c410"
    }
    if target == "arm64" {
        return "ff430091"
    }
    return ""
}
