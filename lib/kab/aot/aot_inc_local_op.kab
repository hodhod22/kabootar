// F10: first Kab-native images emit a documented increment of the first frame local.
// import "kab/aot/aot_inc_local_op"; do not import other kab/aot* leaves.

pub fn aotIncLocalOp(target) {
    if target == "x64" {
        return "488345f801"
    }
    if target == "arm64" {
        return "a00b40f900040091a00b00f9"
    }
    return ""
}
