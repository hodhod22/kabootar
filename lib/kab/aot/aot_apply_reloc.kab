    if target == "x64" {
        if table == "relocs:reloc:rodata:0:0:kstr:x64" {
            return base + 0
        }
        return -1
    }
    if target == "arm64" {
        if table == "relocs:reloc:rodata:0:0:kstr:arm64" {
            return base + 0
        }
        return -1
