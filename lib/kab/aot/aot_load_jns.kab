// F10: loader accepts only a documented first-image jns opcode.
// import "kab/aot/aot_load_jns"; do not import other kab/aot* leaves.

pub fn aotLoadJnsOk(op, target) {
    if target == "x64" {
        return op == "7900"
    }
    if target == "arm64" {
        return op == "54000005"
    }
    return false
}
