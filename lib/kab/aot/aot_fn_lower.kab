                ["store", scratch + 1],
                ["store", scratch + 2],
                ["load", scratch + 2],
                ["is_smi"],
                ["jnz", "@trap"],
                ["load", scratch + 2],
                ["const", 8],
                ["mod"],
                ["const", 1],
                ["eq"],
                ["jz", "@trap"],
                ["load", scratch + 2],
                ["htag"],
                ["tconst", 5],
                ["eq"],
                ["jz", "@rec"],
                ["load", scratch + 1],
                ["is_smi"],
                ["jz", "@trap"],
                ["load", scratch + 2],
                ["load", scratch + 1],
                ["load", scratch + 6],
                ["aset"],
                ["jmp", "@end"],
                ["label", "rec"],
                ["load", scratch + 2],
                ["htag"],
                ["tconst", 10],
                ["eq"],
                ["jz", "@trap"],
                ["load", scratch + 1],
                ["is_smi"],
                ["jnz", "@trap"],
                ["load", scratch + 1],
                ["const", 8],
                ["mod"],
                ["const", 1],
                ["eq"],
                ["jz", "@trap"],
                ["load", scratch + 1],
                ["htag"],
                ["tconst", 4],
                ["eq"],
                ["jz", "@trap"]
            ]
            let isk = aotKidSeq(["load", scratch + 1], scratch + 9, scratch + 10, scratch + 11)
            let isi0 = 0
            while isi0 < len(isk) {
                iss = push(iss, isk[isi0])
                isi0 = isi0 + 1
            }
            let isb = aotOsetSeq(["load", scratch + 9], bump, limit, scratch)
            let isi = 0
