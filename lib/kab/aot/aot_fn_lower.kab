            // Region hit → bare jmp (reason stays on the stack for
            // catchStart's store_local); miss → tag-13 marker + ret.
            let tsq = aotThrowSeq(clo["owner"]["tryRegions"], i, bump, limit, scratch + 8)
            let tn = len(out)
            out = aotLowerAsm(out, aotSeqTag(tsq["seq"], "h" + i))
            if tsq["catch"] >= 0 {
                fixups = push(fixups, [tn + tsq["jpos"], tsq["catch"]])
            }
        } else if tv1 && name == "in" {
            out = aotLowerAsm(out, aotSeqTag(aotInSeq(scratch), "in" + i))
        } else if tv1 && name == "await" {
            // await_all of a value that is not a pending task is that value.
            // The image has no microtask queue, so a pending task still traps
            // only when the program actually calls the host scheduler. A
            // settled value stays on the stack.
        } else if tv1 && name == "yield" {
            // One suspension: the yielded value is the function result.
            // A later resume would need a saved ip in the image; self-host
            // emit of yield* does not use this opcode for that.
            out = push(out, ["ret"])
        } else if tv1 && name == "yield_star" {
            // Host opcode. Self-host emit already expands yield* into
            // iterator_step + yield before this lowerer runs. When the
            // opcode is still present, delegate an array: the first
            // element is the suspension value. An empty array pushes
            // undefined, matching a finished iterator's completion.
            out = aotLowerAsm(out, aotSeqTag(aotYieldStarSeq(scratch), "ys" + i))
        } else if name == "return" {
            out = push(out, ["ret"])
        } else if name == "pop" {
            out = push(out, ["pop"])
        } else if tv1 && name == "dup" {
            out = push(out, ["dup"])
        } else if tv1 && name == "swap" {
            out = push(out, ["swap"])
        } else if name == "halt" {
            // Module top-level terminator — the entry's ret covers it.
        } else {
            return aotLowerReject("unsupported op '" + name + "' @" + i)
        }
        i = i + 1
    }
    // Jumps may target len(ops) — running off the end is the VM's
    // implicit `return undefined` (try/catch emits `jmp` to end past
    // the catch handler). Map it to a landing pad that returns
    // tagged-undefined in tv1 (raw 0 in the i64 domain).
    ipMap = push(ipMap, len(out))
    if tv1 {
        out = push(out, ["tundef"])
        out = push(out, ["ret"])
    } else {
        out = push(out, ["const", 0])
        out = push(out, ["ret"])
    }
    let j = 0
    while j < len(fixups) {
        let f = fixups[j]
        let t = f[1]
        if t < 0 || t > len(ops) {
            return aotLowerReject("jump target out of range @" + t)
        }
        out[f[0]][1] = ipMap[t]
        j = j + 1
    }
    return { "ok": true, "ops": out }
}

/// Lower a whole compileIr module into the aotX64EmitFns input shape:
/// {"ok": true, "fns": [{name, locals, arity, ops}…]} with the module main
/// as fns[0], or {"ok": false, "reason"} on the first out-of-domain fn.
/// `tv1` selects the tagged domain — one extra global slot (bump pointer)
/// is reserved at index nglobals, main gets a hbase/gstore prologue, and
/// every fn reserves two scratch locals for index/make_array lowering.
fn aotLowerModuleMode(bc, tv1, heapQ) {
    if typeof(bc) != "object" || bc == null || bc["ops"] == undefined || bc["functions"] == undefined {
        return aotLowerReject("not a compileIr module record")
    }
    let ng = len(bc["globals"])
    let bump = ng
    let xtra = 0
    if tv1 {
        // sc/sc1 numeric temps + record temps (obj/slots/i/n/val/tmp/
        // right/2m/cursor/exc) + builtin lowering (obj_array_push nests
        // kid-hash + slot-scan + push-copy — deepest at s+12) + new_
        // instance arg temps (s+8..s+21) + calln/callv spill slots at
        // s+24.. (up to 15 extras); lowered sequences are self-contained
        // per op, so one shared scratch block suffices.
        xtra = 40
    }
    let bcf = bc["functions"]
    let nf = len(bcf)
    // Closure pass 1: image index = main(0) + module fns(1..nf) + every
    // arrow record reachable from main/fn arrow arrays (depth-first) +
    // wrapper fns for fn-valued globals (found by the want-scan below).
    let arecs = []
    let next = 1 + nf
    if tv1 {
        if bc["arrows"] != undefined && len(bc["arrows"]) > 0 {
            let rr = aotCloAssign(bc["arrows"], next, arecs)
            next = rr["next"]
            arecs = rr["acc"]
        }
        let ai2 = 0
        while ai2 < nf {
            let sub2 = bcf[ai2]["arrows"]
            if sub2 != undefined && len(sub2) > 0 {
                let rr2 = aotCloAssign(sub2, next, arecs)
                next = rr2["next"]
                arecs = rr2["acc"]
            }
            ai2 = ai2 + 1
        }
        // Method bodies can hold arrows too — same depth-first sweep.
        if bc["classes"] != undefined {
            let ci4 = 0
            while ci4 < len(bc["classes"]) {
                let ms4 = bc["classes"][ci4]["methods"]
                if ms4 != undefined {
                    let mj4 = 0
                    while mj4 < len(ms4) {
                        let sub4 = ms4[mj4]["arrows"]
                        if sub4 != undefined && len(sub4) > 0 {
                            let rr4 = aotCloAssign(sub4, next, arecs)
                            next = rr4["next"]
                            arecs = rr4["acc"]
                        }
                        mj4 = mj4 + 1
                    }
                }
                ci4 = ci4 + 1
            }
        }
    }
    // Wanted wrappers: fn-valued global loads not fused into callN.
    let want = []
    if tv1 {
        want = aotCloWant(bc["ops"], bc, want)
        let wi2 = 0
        while wi2 < nf {
            want = aotCloWant(bcf[wi2]["ops"], bc, want)
            wi2 = wi2 + 1
        }
        let wi3 = 0
        while wi3 < len(arecs) {
            want = aotCloWant(arecs[wi3]["ops"], bc, want)
            wi3 = wi3 + 1
        }
        if bc["classes"] != undefined {
            let ci5 = 0
            while ci5 < len(bc["classes"]) {
                let ms5 = bc["classes"][ci5]["methods"]
                if ms5 != undefined {
                    let mj5 = 0
                    while mj5 < len(ms5) {
                        want = aotCloWant(ms5[mj5]["ops"], bc, want)
                        mj5 = mj5 + 1
                    }
                }
                ci5 = ci5 + 1
            }
        }
    }
    let wmap = {}
    let wj = 0
    while wj < len(want) {
        wmap["" + want[wj]] = next
        next = next + 1
        wj = wj + 1
    }
    // Class methods: each gets an image fn (local0 = this ← receiver)
    // plus a bound-method wrapper (tag-6 cell cap0 = receiver → reload +
    // tail-call). mmeth/mwrap map "ci$sym" → image indices.
    let mmeth = {}
    let mwrap = {}
    let mrecs = []
    let wrecs = []
    if tv1 && bc["classes"] != undefined {
        let ci6 = 0
        while ci6 < len(bc["classes"]) {
            let ms6 = bc["classes"][ci6]["methods"]
            if ms6 != undefined {
                let mj6 = 0
                while mj6 < len(ms6) {
                    let mk6 = "" + ci6 + "$" + ms6[mj6]["sym"]
                    mmeth[mk6] = next
                    next = next + 1
                    mrecs = push(mrecs, { "ci": ci6, "m": ms6[mj6], "img": mmeth[mk6], "cls": bc["classes"][ci6]["sym"] })
                    mj6 = mj6 + 1
                }
            }
            ci6 = ci6 + 1
        }
        let wi8 = 0
        while wi8 < len(mrecs) {
            let mr8 = mrecs[wi8]
            let mk8 = "" + mr8["ci"] + "$" + mr8["m"]["sym"]
            mwrap[mk8] = next
            wrecs = push(wrecs, { "img": next, "mImg": mr8["img"], "np": len(mr8["m"]["params"]), "sym": mr8["cls"] + "$" + mr8["m"]["sym"] })
            next = next + 1
            wi8 = wi8 + 1
        }
    }
    // callv candidates: every arrow + wrapper index in the image.
    let cands = []
    let ck2 = 1 + nf
    while ck2 < next {
        cands = push(cands, ck2)
        ck2 = ck2 + 1
    }
    let mainClo = { "owner": bc, "cands": cands, "wmap": wmap, "mmeth": mmeth, "mwrap": mwrap, "lshift": 0 }
    let mainR = aotLowerOps(bc["ops"], bc, tv1, bump, ng + 1, 0, mainClo)
    if mainR["ok"] == false {
        return aotLowerReject("main: " + mainR["reason"])
    }
    // NOTE: record field access returns a deep copy in the VM — keep one
    // fetched array (`rawOps`) and mutate/reuse its elements, or the
    // jump shift below would edit a copy that is never pushed.
    let rawOps = mainR["ops"]
    let mainOps = rawOps
    if tv1 {
        // Bump+limit seed: heap starts past globals + the two slots;
        // every jump target shifts by the prepended prologue+init ops.
        let initOps = []
        if bc["enums"] != undefined {
            // Enum namespaces install into their global slots before
            // any user ops run — the same thing the VM session does
            // (S["globals"][gi] = {vmEnumNs:1, typeName, variants}).
            let eii = 0
            while eii < len(bc["enums"]) {
                let en = bc["enums"][eii]
                let gi = -1
                let gn2 = 0
                while gn2 < ng {
                    if bc["globals"][gn2] == en["sym"] {
                        gi = gn2
                    }
                    gn2 = gn2 + 1
                }
                if gi >= 0 {
                    initOps = aotLowerAsm(initOps, aotSeqTag(aotEnumNsSeq(en, bump, ng + 1, 0), "e" + eii))
                    initOps = push(initOps, ["gstore", gi])
                }
                eii = eii + 1
            }
        }
        let prolen = 4 + len(initOps)
        let si = 0
        while si < len(rawOps) {
            let sn = rawOps[si][0]
            if sn == "jmp" || sn == "jz" || sn == "jnz" || sn == "jsmi" || sn == "jnsmi" {
                rawOps[si][1] = rawOps[si][1] + prolen
            }
            si = si + 1
        }
        mainOps = [["hbase", bump + 2], ["gstore", bump], ["hlimit", bump + 2 + heapQ], ["gstore", bump + 1]]
        let ei2 = 0
        while ei2 < len(initOps) {
            // initOps internal jumps resolve in initOps-local space —
            // they land at mainOps index 4+, so shift by the prologue.
            let iop = initOps[ei2]
            let isn = iop[0]
            if isn == "jmp" || isn == "jz" || isn == "jnz" || isn == "jsmi" || isn == "jnsmi" {
                iop[1] = iop[1] + 4
            }
            mainOps = push(mainOps, iop)
            ei2 = ei2 + 1
        }
        let mi = 0
        while mi < len(rawOps) {
            mainOps = push(mainOps, rawOps[mi])
            mi = mi + 1
        }
    }
    let fns = [{ "name": "main", "locals": xtra, "arity": 0, "ops": mainOps }]
    let i = 0
    while i < len(bcf) {
        let f = bcf[i]
        let fclo = { "owner": f, "cands": cands, "wmap": wmap, "mmeth": mmeth, "mwrap": mwrap, "lshift": 0 }
        let r = aotLowerOps(f["ops"], bc, tv1, bump, ng + 1, len(f["locals"]), fclo)
        if r["ok"] == false {
            return aotLowerReject(f["sym"] + ": " + r["reason"])
        }
        fns = push(fns, {
            "name": f["sym"],
            "locals": len(f["locals"]) + xtra,
            "arity": len(f["params"]),
            "ops": r["ops"]
        })
        i = i + 1
    }
    // Arrow bodies: lowered with the cell convention — local 0 = the
    // closure cell (rcx), params shifted +1, `this` seeded with the
    // cell itself, captures loaded out of the cell via hload. Their
    // own ops shift +1 local (cell occupies slot 0); the prologue
    // insertion shifts jump targets by 2 + 3*ncap.
    let aj = 0
    while aj < len(arecs) {
        let ar = arecs[aj]
        let np = len(ar["params"])
        let ncap = len(ar["locals"]) - np - 1
        let aclo = { "owner": ar, "cands": cands, "wmap": wmap, "mmeth": mmeth, "mwrap": mwrap, "lshift": 1 }
        let ar2 = aotLowerOps(ar["ops"], bc, tv1, bump, ng + 1, 1 + len(ar["locals"]), aclo)
        if ar2["ok"] == false {
            return aotLowerReject(ar["sym"] + ": " + ar2["reason"])
        }
        let aops = ar2["ops"]
        let prolen = 2 + 3 * ncap
        let sj = 0
        while sj < len(aops) {
            let sn2 = aops[sj][0]
            if sn2 == "jmp" || sn2 == "jz" || sn2 == "jnz" || sn2 == "jsmi" || sn2 == "jnsmi" {
                aops[sj][1] = aops[sj][1] + prolen
            }
            sj = sj + 1
        }
        let pro = [["load", 0], ["store", np + 1]]
        let ck3 = 0
        while ck3 < ncap {
            pro = push(pro, ["load", 0])
            pro = push(pro, ["hload", 16 + 8 * ck3])
            pro = push(pro, ["store", np + 2 + ck3])
            ck3 = ck3 + 1
        }
        let mj = 0
        while mj < len(aops) {
            pro = push(pro, aops[mj])
            mj = mj + 1
        }
        fns = push(fns, {
            "name": ar["sym"],
            "locals": 1 + len(ar["locals"]) + xtra,
            "arity": 1 + np,
            "ops": pro
        })
        aj = aj + 1
    }
    // Wrappers for fn-valued globals: cell convention, ignore the cell —
    // reload the real params and tail-call the module fn directly.
    wj = 0
    while wj < len(want) {
        let wfi = want[wj]
        let wf = bcf[wfi]
        let wnp = len(wf["params"])
        let wops = []
        let wk = 0
        while wk < wnp {
            wops = push(wops, ["load", 1 + wk])
            wk = wk + 1
        }
        if wnp > 20 {
            return aotLowerReject("fn-value wrapper arity > 20: " + wf["sym"])
        }
        wops = push(wops, aotCallOpN(wnp, wfi + 1, 1 + wnp))
        wops = push(wops, ["ret"])
        fns = push(fns, {
            "name": wf["sym"] + "$clo",
            "locals": 1 + wnp + 16,
            "arity": 1 + wnp,
            "ops": wops
        })
        wj = wj + 1
    }
    // Class method bodies: lowered like module fns but arity np+1 —
    // the receiver is arg0 → local0 ("this"/"self"), params 1..np.
    let mi3 = 0
    while mi3 < len(mrecs) {
        let mr9 = mrecs[mi3]
        let m9 = mr9["m"]
        let mnp = len(m9["params"])
        if mnp + 1 > 20 {
            return aotLowerReject("method arity > 19 (receiver included): " + mr9["cls"] + "." + m9["sym"])
        }
        let mclo = { "owner": m9, "cands": cands, "wmap": wmap, "mmeth": mmeth, "mwrap": mwrap, "lshift": 0 }
        let mres = aotLowerOps(m9["ops"], bc, tv1, bump, ng + 1, len(m9["locals"]), mclo)
        if mres["ok"] == false {
            return aotLowerReject(mr9["cls"] + "." + m9["sym"] + ": " + mres["reason"])
        }
        fns = push(fns, {
            "name": mr9["cls"] + "$" + m9["sym"],
            "locals": len(m9["locals"]) + xtra,
            "arity": 1 + mnp,
            "ops": mres["ops"]
        })
        mi3 = mi3 + 1
    }
    // Bound-method wrappers: arg0 = the tag-6 cell → cap0 (receiver) at
    // +16, then the real params — tail-call the method image.
    let wi9 = 0
    while wi9 < len(wrecs) {
        let wr9 = wrecs[wi9]
        let wnp2 = wr9["np"]
        let wops2 = [["load", 0], ["hload", 16]]
        let wk2 = 0
        while wk2 < wnp2 {
            wops2 = push(wops2, ["load", 1 + wk2])
            wk2 = wk2 + 1
        }
        wops2 = push(wops2, aotCallOpN(1 + wnp2, wr9["mImg"], 1 + wnp2))
        wops2 = push(wops2, ["ret"])
        fns = push(fns, {
            "name": wr9["sym"] + "$clo",
            "locals": 1 + wnp2 + 16,
            "arity": 1 + wnp2,
            "ops": wops2
        })
        wi9 = wi9 + 1
    }
    let ngOut = ng
    if tv1 {
        ngOut = ng + 2
    }
    return { "ok": true, "fns": fns, "nglobals": ngOut }
}

/// i64 domain (aot-i64v1) — the original behaviour.
pub fn aotFnLowerModule(bc) {
    return aotLowerModuleMode(bc, false, 0)
}

/// Tagged domain (aot-tv1) — every stack value is a tagged word; arrays
/// are heap cells, index ops use aget/aset, `x.length` uses hlen.
pub fn aotFnLowerModuleTv1(bc, heapQ) {
    return aotLowerModuleMode(bc, true, heapQ)
}
