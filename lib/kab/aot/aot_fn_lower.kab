            uq = aotSeqCat(uq, [["jz", "@trap"]])
            uq = aotSeqCat(uq, aotSeqTag(aotOgetSlotSeq(["tconst", aotStrKid("fields")], scratch, scratch + 3, scratch + 7), "b"))
            uq = aotSeqCat(uq, [["jz", "@trap"]])
            uq = aotSeqCat(uq, aotSeqTag(aotTagIsSeq(["load", scratch + 7], 5), "c"))
            uq = aotSeqCat(uq, [
