            // str-cell key (tag 4) → dynamic member scan by kid;
            // anything else → undefined (VM: missing member/index).
            let ig = []
            if name == "index_get_local" {
                ig = push(ig, ["store", scratch + 1])
                ig = push(ig, ["load", arg + clo["lshift"]])
                ig = push(ig, ["store", scratch + 2])
            } else if name == "index_get_global" {
                ig = push(ig, ["store", scratch + 1])
                ig = push(ig, ["gload", arg])
                ig = push(ig, ["store", scratch + 2])
            } else {
                ig = push(ig, ["store", scratch + 1])
                ig = push(ig, ["store", scratch + 2])
