                ["load", scratch],
                ["hload", 8],
                ["jmp", "@uend"],
                ["label", "utrap"],
                ["trap"],
                ["label", "uend"]
            ])))
        } else if tv1 && name == "result_question" {
            // `?` on Result: Ok → inner v; Err → the cell itself stays;
            // anything else traps (VM throws "? requires Result").
            let rq = [
                ["store", scratch]
            ]
            rq = aotSeqCat(rq, aotSeqTag(aotSumIsSeq(["load", scratch], 786434), "q1"))
            rq = aotSeqCat(rq, [
                ["jz", "@qchk"],
                ["load", scratch],
                ["hload", 8],
                ["jmp", "@qend"],
                ["label", "qchk"]
            ])
            rq = aotSeqCat(rq, aotSeqTag(aotSumIsSeq(["load", scratch], 786435), "q2"))
            rq = aotSeqCat(rq, [
                ["jz", "@qtrap"],
                ["load", scratch],
                ["jmp", "@qend"],
                ["label", "qtrap"],
                ["trap"],
                ["label", "qend"]
            ])
            out = aotLowerAsm(out, rq)
        } else if tv1 && name == "match_fail" {
            // VM throws "No matching pattern" — honest trap.
            out = push(out, ["trap"])
        } else if tv1 && (name == "jump_unless_array" || name == "jump_unless_object") {
            // Peek semantics like jump_unless_option_*: tag check only.
            let jt = 5
            if name == "jump_unless_object" {
                jt = 10
            }
            out = push(out, ["store", scratch])
            out = push(out, ["load", scratch])
            out = aotLowerAsm(out, aotSeqTag(aotTagIsSeq(["load", scratch], jt), "a"))
            out = push(out, ["jz", -1])
            fixups = push(fixups, [len(out) - 1, i + 1 + arg])
        } else if tv1 && name == "jump_unless_object_empty" {
            // "Empty" = tag-10 record whose slots cell has no pairs.
            out = push(out, ["store", scratch])
            out = push(out, ["load", scratch])
            let oe = aotSeqTag(aotTagIsSeq(["load", scratch], 10), "a")
            oe = aotSeqCat(oe, [
                ["jz", "@no"],
                ["load", scratch],
                ["hload", 8],
                ["hlen"],
                ["tconst", 0],
                ["eq"],
                ["jmp", "@done"],
                ["label", "no"],
                ["const", 0],
                ["label", "done"]
            ])
            out = aotLowerAsm(out, oe)
            out = push(out, ["jz", -1])
            fixups = push(fixups, [len(out) - 1, i + 1 + arg])
        } else if tv1 && name == "jump_unless_has_member" {
            let hkey = bc["constants"][arg]
            if typeof(hkey) != "string" {
                return aotLowerReject("jump_unless_has_member const not a string @" + i)
            }
            let hmoff = o["arg2"]
            if hmoff == undefined {
                hmoff = 0
            }
            out = push(out, ["store", scratch])
            out = push(out, ["load", scratch])
            let hm = aotSeqTag(aotTagIsSeq(["load", scratch], 10), "a")
            hm = aotSeqCat(hm, [["jz", "@no"]])
            hm = aotSeqCat(hm, aotSeqTag(aotOgetSlotSeq(["tconst", aotStrKid(hkey)], scratch, scratch + 3, scratch + 6), "b"))
            hm = aotSeqCat(hm, [
