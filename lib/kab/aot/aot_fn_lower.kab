            let gk2 = bc["constants"][arg]
            if typeof(gk2) != "string" {
                return aotLowerReject("member_set const not a string @" + i)
            }
            out = aotLowerOsetTv1(out, gk2, bump, limit, scratch)
        } else if tv1 && name == "make_object" {
            out = aotLowerOmakeTv1(out, arg, bump, limit, scratch)
        } else if tv1 && name == "merge_object" {
            out = aotLowerOmergeTv1(out, bump, limit, scratch)
        } else if tv1 && name == "object_rest" {
            out = aotLowerOrestTv1(out, arg, bump, limit, scratch)
