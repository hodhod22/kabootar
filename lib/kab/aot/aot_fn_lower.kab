            ev = aotSeqCat(ev, [["jz", "@no"]])
            ev = aotSeqCat(ev, aotSeqTag(aotEnumVariantSeq(etn, evr, scratch), "b"))
            ev = aotSeqCat(ev, [
                ["jmp", "@done"],
                ["label", "no"],
                ["const", 0],
                ["label", "done"]
