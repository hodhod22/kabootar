fn aotLowerOps(ops, bc, tv1, bump, limit, scratch, clo) {
    let out = []
    let ipMap = []
    let fixups = []
    let i = 0
    while i < len(ops) {
        ipMap = push(ipMap, len(out))
        let o = ops[i]
        let name = o["op"]
        let arg = o["arg"]
        if name == "const" {
            let v = bc["constants"][arg]
            if tv1 {
                // Float consts → fmk (emitter derives IEEE-754 halves
                // from op[4] via aotF64Halves). Integer consts → tconst
                // in the sext-imm32 window, tconst64 (movabs) up to the
                // Kab-exact range 2^52.
                let csq = aotConstTv1Seq(v, bump, limit)
                if csq["ok"] == false {
                    return aotLowerReject(csq["reason"] + " @" + i)
                }
                let cci = 0
                while cci < len(csq["seq"]) {
                    out = push(out, csq["seq"][cci])
                    cci = cci + 1
                }
            } else {
                if typeof(v) != "number" || v % 1 != 0 || v < -2147483648 || v > 2147483647 {
                    return aotLowerReject("const not i32 @" + i)
                }
