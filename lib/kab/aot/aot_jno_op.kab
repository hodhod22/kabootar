// F10: first Kab-native images emit a documented jno opcode for the return register.
// import "kab/aot/aot_jno_op"; do not import other kab/aot* leaves.

pub fn aotJnoOp(target) {
    if target == "x64" {
        return "7100"
    }
    if target == "arm64" {
        return "54000007"
    }
    return ""
}
