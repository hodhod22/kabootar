// F10: a native image is sealable only with a valid header, RX text, and entry.
// import "kab/aot/aot_seal"; do not import other kab/aot* leaves.

pub fn aotSealOk(header, textMode, entry, imageSize) {
    if header != "kabootar-native/1" {
        return false
    }
    if textMode != "rx" {
        return false
    }
    if entry < 0 {
        return false
    }
    if entry >= imageSize {
        return false
    }
    return true
}
