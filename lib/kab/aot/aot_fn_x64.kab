// SH28: whole-function AOT — a two-pass emitter that turns an op array
// (["const",n], ["load",i], ["store",i], ["acc_add",i] (local[i] += pop),
// ["add"|"sub"|"mul"|"div"|"mod"], ["neg"|"not"|"bit_not"],
// ["lt"|"le"|"gt"|"ge"|"eq"|"ne"], ["jmp",t], ["jz",t], ["jnz",t],
// ["call0"|"call"|"call2"|"call3"|"call4",fi], ["gload",g]|["gstore",g]|
// ["acc_add_g",g] (module-global slot g via the r12 data base),
// ["pop"], ["ret"],
// aot-tv1 tagged-value ops (docs/AOT-VALUES.md):
//   ["tag"] (pop raw i64 → push SMI v<<1), ["untag"] (pop SMI → push sar 1),
//   ["is_smi"] (pop → push RAW 1 when bit0==0 else 0),
//   ["jsmi",t]|["jnsmi",t] (pop, test bit0, jz/jnz — type dispatch),
//   ["tconst",v] (push tagged SMI literal, tag folded at emit),
//   ["tnull"|"tundef"|"tfalse"|"ttrue"] (push tagged immediate:
//     (subtag<<3)|3 → null=3, undef=11, false=19, true=27),
//   ["tadd"|"tsub"|"tneg"|"tmul"|"tdiv"|"tmod"] (SMI arithmetic on tagged
//     operands — tadd/tsub/tneg are bit-identical to the raw ops since
//     <<1 is add/sub/neg-linear; tmul untags one operand, tdiv/tmod untag
//     both, idiv with the same zero-check trap, then retag)) into
// REAL x86-64 bytes, then wraps them in a kabootar-native/1 image with one
// sym per function. import "kab/aot/aot_fn_x64"
//
// VALUE REPRESENTATION (decision, aot-i64v1): every stack slot, local and
// argument is a raw untagged i64 qword. Dynamic Kab Values (strings,
// arrays, objects, heap cells) are deliberately OUT of scope for v1 — they
// need a tagged/pointer repr plus a native heap, which is the
// nollAotReady criterion-2 work that follows. The honest domain is
// "typed i64 functions"; anything wider refuses at emit, never silently.
//
// TAGGED LAYOUT (aot-tv1): qword bit0==0 → SMI, value = sar(qword,1)
// (i63); bit0==1 → non-immediate: (v&3)==1 is a heap pointer
// (addr = v&~1) and (v&3)==3 is an immediate (v>>3 subtag: 0 null,
// 1 undef, 2 false, 3 true). Signed cmp ops (eq/ne/lt/le/gt/ge) are
// tag-transparent for SMIs since <<1 preserves signed order — they are
// shared across both domains and double as ptr identity. is_smi pushes
// a RAW 0/1 flag (not a tagged bool) — immediates arrive via ttrue/
// tfalse. tag/untag is the typed↔dynamic boundary op.
//
// PRIVATE CALL CONVENTION: arg1..arg4 in rcx, rdx, r8, r9, result in
// rax — identical on both host ABIs (rcx..r9 are exactly win64's first
// four arg regs, and all CALLER-SAVED on win64+SysV, so intra-image
// calls never touch callee-saved state — an earlier rdi/rsi convention
// corrupted the host caller's saved regs and ret:jumped wild on
// return). The image ENTRY (fns[0]) normalizes once: win64 already
// delivers arg1/arg2 in rcx/rdx (arg2 = the data-page pointer — which
// is exactly the image ABI's second argument, so it is handed through
// unmodified); sysv moves rdi→rcx / rsi→rdx. Entry arity is <= 2: the
// host ABI only supplies two arguments.
//
// GLOBALS BASE: r12 is callee-saved on both ABIs, so EVERY fn pushes it
// in its prologue and restores it in ret; when any fn uses gload/gstore
// the ENTRY copies the data-page pointer (arg2) into r12 once, and it
// survives every call untouched. gload/gstore addressing is
// [r12 + g*8] — the g-th module global's i64 slot in the RW data page.
//
// FRAME LAYOUT: push rbp; mov rbp,rsp; sub rsp,locals*8 (imm8 ≤127, else
// imm32); then arg spill: local i lives at [rbp-8*(i+1)] (disp8 ≤128 else
// disp32). Locals 0..arity-1 are seeded from rcx/rdx.
//
// DOMAIN GUARDS (emit refuses, returns []):
//   locals 0..=64 (0 → no sub-rsp; module mains have no frame need);
//   arity 0..=2 (extend by adding r8/r9/… spill rows);
//   arity <= locals; every fn's last op is "ret" (no fallthrough into the
//   next fn's bytes); const |v| <= 2147483647 (sext imm32); jump/call
//   targets must be valid op/fn indices; op names outside the table → [].

import "kab/aot/aot_x64"
import "kab/aot/aot_gc"

/// IEEE-754 halves of a Kab f64 → [lo32, hi32] as SIGNED i32s (ready for
/// x64PushSImm32). Kab cannot reinterpret f64 bits, so this extracts them
/// arithmetically: sign via 1/v (-0), NaN canonicalized, inf/zero
/// special-cased, exponent by power-of-two scaling, 52 fraction bits by
/// successive doubling — every step is exact in binary FP (x2, /2 and
/// integer subtract within 2^53 never round).
pub fn aotF64Halves(v) {
    if v != v {
        return [0, 2146959360]
    }
    let sign = 0
    // -0 vs +0 is indistinguishable in Kab f64 (and 1/0 would trap), so
    // only the strict negative test is safe here.
    if v < 0 {
        sign = 1
    }
    let a = v
    if a < 0 {
        a = 0 - a
    }
    let sgn = 0
    if sign == 1 {
        sgn = -2147483648
    }
    if a == 0 {
        return [0, sgn]
    }
    if a / 2 == a {
        return [0, sgn + 2146435072]
    }
    let e = 0
    while a >= 2 {
        a = a / 2
        e = e + 1
    }
    while a < 1 {
        a = a * 2
        e = e - 1
    }
    let frac = 0
    let biased = e + 1023
    if biased <= 0 {
        // Subnormal: mantissa = a * 2^(e+1074) — an exact integer ≤ 2^52.
        biased = 0
        let sh = e + 1074
        let k = 0
        while k < sh {
            a = a * 2
            k = k + 1
        }
        frac = a
    } else {
        let m = a - 1
        let k = 0
        while k < 52 {
            m = m * 2
            frac = frac * 2
            if m >= 1 {
                frac = frac + 1
                m = m - 1
            }
            k = k + 1
        }
    }
    let flo = frac % 4294967296
    let fhi = (frac - flo) / 4294967296
    let hi32 = sgn + biased * 1048576 + fhi
    let lo32 = flo
    if lo32 >= 2147483648 {
        lo32 = lo32 - 4294967296
    }
    return [lo32, hi32]
}

/// Bytes-per-op, used by pass 1 to fix label offsets. -1 = unsupported op
/// (emit must refuse). Disp sizes: slot offset <= 128 → disp8 forms (5B
/// load/store), wider → disp32 forms (8B).
/// op byte-length; `nl` = enclosing fn's locals count (gcollect/hcalloc
/// spill sequences are proportional to it). Pass 0 when nl is unknown —
/// collect ops then return -1 rather than lie about their size.
// Op-name → fixed byte length for every op whose encoding doesn't
// depend on operands. Record lookup replaces a ~60-deep if-chain —
// this function runs several times per machine op (offsets, aotFnOk,
// emit audit) and dominated interpreted emit time on real images.
let AOT_LEN_FIXED = {
    "const": 8, "add": 6, "sub": 6, "mul": 7, "div": 15, "mod": 18,
    "neg": 5, "bit_not": 5, "not": 11,
    "lt": 12, "le": 12, "gt": 12, "ge": 12, "eq": 12, "ne": 12,
    "jmp": 5, "jz": 10, "jnz": 10,
    "pop": 1, "dup": 5, "swap": 4, "tag": 5, "untag": 5, "is_smi": 10,
    "jsmi": 9, "jnsmi": 9,
    "tconst": 8, "tnull": 8, "tundef": 8, "tfalse": 8, "ttrue": 8,
    "tconst64": 11, "tadd": 6, "tsub": 6, "tneg": 5, "tmul": 10,
    "tdiv": 24, "tmod": 27,
    "tband": 17, "tbor": 17, "tbxor": 17, "tbnot": 13,
    "tshl": 20, "tshr": 20, "tushr": 20, "tpow": 49,
    "hloadx": 15, "hstorex": 15, "hlen": 17, "htag": 21,
    "hloadb": 12, "hstoreb": 11, "aget": 16, "aset": 22,
    "const64": 11, "hkid": 16,
    "feq": 28, "flt": 28, "fle": 28, "fne": 35, "fgt": 26, "fge": 26,
    "trap": 2, "ret": 5
}

// Hot variable-length ops — name → small kind code.
let AOT_LEN_VARHOT = {
    "load": 1, "store": 1, "acc_add": 1,
    "gload": 2, "gstore": 2, "acc_add_g": 2,
    "hbase": 3, "hlimit": 3,
    "hload": 4, "hstore": 4,
    "call0": 5, "call": 6, "call2": 7, "call3": 8, "call4": 9
}

// Base lengths for call0..call4 before callee-arity padding. When the
// callee declares more params than the call supplies, the emit side
// writes `mov rX, 11` (tagged undefined) into each missing arg reg —
// 7 bytes each — matching the VM's missing-arg-is-undefined rule.
let AOT_LEN_CALLBASE = [6, 7, 8, 10, 12]

// Missing-arg pad count for a direct call: callee arity beyond the
// supplied arg count, capped at the 4 register slots. `fa` is the fn
// arity table; undefined/oob → 0 (validation reports the bounds error).
fn aotCallPadN(fa, t, want) {
    if fa == undefined || t < 0 || t >= len(fa) {
        return 0
    }
    let ca = fa[t]
    if ca > 4 {
        ca = 4
    }
    if ca > want {
        return ca - want
    }
    return 0
}

// Emit `mov argreg_p, 11` — tagged undefined for one missing arg.
// Positions: 1=rcx 2=rdx 3=r8 4=r9 (49 prefix for r8/r9).
fn aotX64PadArg(b, p) {
    if p == 1 {
        b = push(b, 72)
        b = push(b, 199)
        b = push(b, 193)
    } else if p == 2 {
        b = push(b, 72)
        b = push(b, 199)
        b = push(b, 194)
    } else if p == 3 {
        b = push(b, 73)
        b = push(b, 199)
        b = push(b, 192)
    } else {
        b = push(b, 73)
        b = push(b, 199)
        b = push(b, 193)
    }
    b = push(b, 11)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    return b
}

pub fn aotFnOpLen(op, nl, fa) {
    let name = op[0]
    let fx = AOT_LEN_FIXED[name]
    if fx != undefined {
        return fx
    }
    let vk = AOT_LEN_VARHOT[name]
    if vk != undefined {
        if vk >= 5 {
            // call0..call4: [name, fi] — pad = min(arity,4) - want.
            if len(op) < 2 {
                return -1
            }
            let cbase = AOT_LEN_CALLBASE[vk - 5]
            return cbase + 7 * aotCallPadN(fa, op[1], vk - 5)
        }
        if len(op) < 2 {
            return -1
        }
        if vk == 1 {
            if 8 * (op[1] + 1) <= 128 {
                return 5
            }
            return 8
        }
        if vk == 2 {
            if 8 * (op[1] + 1) <= 128 {
                return 6
            }
            return 9
        }
        if vk == 3 {
            if 8 * op[1] + 8 <= 128 {
                return 6
            }
            return 9
        }
        if op[1] <= 127 {
            return 10
        }
        return 13
    }
    // Cold variable-length ops keep the original name chain.
    // Arity guard: malformed ops must return -1, not deref undefined
    // operands (e.g. ["halloc", -1] is a reject, not a VM crash).
    let olen = len(op)
    if name == "halloc" || name == "fadd" || name == "fsub" || name == "fmul" || name == "fdiv" || name == "fcast" || name == "fmod" {
        if olen < 3 {
            return -1
        }
    }
    if name == "smk" {
        if olen < 5 {
            return -1
        }
    }
    if name == "fmk" {
        if olen < 5 {
            return -1
        }
    }
    if name == "mkclo" {
        if olen < 5 {
            return -1
        }
    }
    if name == "callv" {
        if olen < 3 {
            return -1
        }
        if op[1] > 3 && olen < 4 {
            return -1
        }
    }
    if name == "calln" {
        if olen < 4 {
            return -1
        }
    }
    if name == "gcollect" {
        if olen < 5 {
            return -1
        }
    }
    if name == "hcalloc" {
        if olen < 6 {
            return -1
        }
    }
    if name == "load" || name == "store" || name == "acc_add" || name == "gload" || name == "gstore" || name == "acc_add_g" || name == "hbase" || name == "hlimit" || name == "hload" || name == "hstore" {
        if olen < 2 {
            return -1
        }
    }
    if name == "const" {
        return 8
    }
    if name == "load" || name == "store" || name == "acc_add" {
        if 8 * (op[1] + 1) <= 128 {
            return 5
        }
        return 8
    }
    if name == "add" || name == "sub" {
        return 6
    }
    if name == "mul" {
        return 7
    }
    if name == "div" {
        return 15
    }
    if name == "mod" {
        return 18
    }
    if name == "neg" || name == "bit_not" {
        return 5
    }
    if name == "not" {
        return 11
    }
    if name == "gload" || name == "gstore" || name == "acc_add_g" {
        if 8 * (op[1] + 1) <= 128 {
            return 6
        }
        return 9
    }
    if name == "lt" || name == "le" || name == "gt" || name == "ge" {
        return 12
    }
    if name == "eq" || name == "ne" {
        return 12
    }
    if name == "jmp" {
        return 5
    }
    if name == "jz" || name == "jnz" {
        return 10
    }
    if name == "call" {
        return 7
    }
    if name == "call2" {
        return 8
    }
    if name == "call3" {
        return 10
    }
    if name == "call4" {
        return 12
    }
    if name == "call0" {
        return 6
    }
    if name == "calln" {
        // ["calln", fi, n, scr] — direct call with n >= 5 args: extra
        // args a5..a_n pop into scratch locals scr..scr+n-5, a4..a1 pop
        // into r9/r8/rdx/rcx, the extras push back (a_n first so a5
        // lands topmost → [rsp+8] at callee entry), E8 rel32,
        // add rsp,8*(n-4) caller cleanup, push rax.
        let cna = op[2]
        let cnk = 0
        // add rsp: imm8 while 8*(n-4) <= 127 (n <= 19), imm32 at n = 20.
        let cnn = 6 + 5 + 4 + 1
        if 8 * (cna - 4) > 127 {
            cnn = cnn + 3
        }
        while cnk < cna - 4 {
            cnn = cnn + 1 + aotX64LocalLen(op[3] + cnk)
            cnn = cnn + aotX64LocalLen(op[3] + cnk) + 1
            cnk = cnk + 1
        }
        return cnn
    }
    if name == "pop" {
        return 1
    }
    if name == "dup" {
        // 48 8B 04 24 mov rax,[rsp] + 50 push rax = 5.
        return 5
    }
    if name == "swap" {
        // 58 pop rax; 5A pop rdx; 52 push rdx; 50 push rax = 4.
        return 4
    }
    if name == "tag" || name == "untag" {
        return 5
    }
    if name == "is_smi" {
        return 10
    }
    if name == "jsmi" || name == "jnsmi" {
        // pop(1) + test al,1(2) + jcc rel32(6) = 9 — one byte shorter
        // than jz/jnz which use the 3-byte test rax,rax form.
        return 9
    }
    if name == "tconst" || name == "tnull" || name == "tundef" || name == "tfalse" || name == "ttrue" {
        return 8
    }
    if name == "tconst64" {
        return 11
    }
    if name == "tadd" || name == "tsub" {
        return 6
    }
    if name == "tneg" {
        return 5
    }
    if name == "tmul" {
        return 10
    }
    if name == "tdiv" {
        return 24
    }
    if name == "tmod" {
        return 27
    }
    // tv1 bitwise: detag both (sar 1), 32-bit op, sign-extend, retag.
    if name == "tband" || name == "tbor" || name == "tbxor" {
        // pop rbx;pop rax;sar rbx,1;sar rax,1;<op> eax,ebx;
        // movsxd rax,eax;shl rax,1;push = 1+1+3+3+2+3+3+1.
        return 17
    }
    if name == "tbnot" {
        // pop rax;sar rax,1;not eax;movsxd rax,eax;shl rax,1;push.
        return 13
    }
    if name == "tshl" || name == "tshr" || name == "tushr" {
        // pop rcx;sar rcx,1;pop rax;sar rax,1;and ecx,31;
        // <sh> eax,cl;movsxd rax,eax;shl rax,1;push.
        return 20
    }
    if name == "tpow" {
        // pop rcx;pop rax;sar rcx,1;sar rax,1;test rcx,rcx;jns+2;ud2;
        // mov rdx,rax;mov eax,1;loop{test rcx,rcx;jz+13;imul rax,rdx;
        // jno+2;ud2;dec rcx;jmp-18};shl rax,1;jno+2;ud2;push.
        // head 23 + loop 18 + tail 8 = 49.
        return 49
    }
    if name == "hbase" || name == "hlimit" {
        if 8 * op[1] + 8 <= 128 {
            return 6
        }
        return 9
    }
    if name == "halloc" {
        // ["halloc", bump, limit] — bump check against the limit slot.
        // bump slot: 2 r12-accesses (+3 each disp32); limit: 1 (+3).
        let an = 38
        if 8 * op[1] + 8 > 128 {
            an = an + 6
        }
        if 8 * op[2] + 8 > 128 {
            an = an + 3
        }
        return an
    }
    if name == "hload" || name == "hstore" {
        if op[1] <= 127 {
            return 10
        }
        return 13
    }
    if name == "hloadx" || name == "hstorex" {
        return 15
    }
    if name == "hlen" {
        return 17
    }
    if name == "htag" {
        return 21
    }
    if name == "hloadb" {
        return 12
    }
    if name == "hstoreb" {
        return 11
    }
    if name == "aget" {
        return 16
    }
    if name == "aset" {
        return 22
    }
    if name == "const64" {
        return 11
    }
    if name == "fmk" {
        // ["fmk", bump, limit, bits, fval] — bump: 2 r12-accesses (+3
        // each disp32); limit: 1 (+3).
        let mkn = 56
        if 8 * op[1] + 8 > 128 {
            mkn = mkn + 6
        }
        if 8 * op[2] + 8 > 128 {
            mkn = mkn + 3
        }
        return mkn
    }
    if name == "fadd" || name == "fsub" || name == "fmul" || name == "fdiv" {
        // ["f<op>", bump, limit] — same r12-access counts as halloc.
        let fan = 67
        if 8 * op[1] + 8 > 128 {
            fan = fan + 6
        }
        if 8 * op[2] + 8 > 128 {
            fan = fan + 3
        }
        return fan
    }
    if name == "fcast" {
        // ["fcast", bump, limit] — pop/sar/cvtsi2sd (9) + alloc tail (48:
        // movq [rdx+8],xmm0 is 6B).
        let cn = 57
        if 8 * op[1] + 8 > 128 {
            cn = cn + 6
        }
        if 8 * op[2] + 8 > 128 {
            cn = cn + 3
        }
        return cn
    }
    if name == "fmod" {
        // ["fmod", bump, limit] — SSE prologue (42: movsd/divsd reg-reg
        // are 4B) + alloc tail (47: movsd [rdx+8],xmm0 is 5B).
        let mn2 = 89
        if 8 * op[1] + 8 > 128 {
            mn2 = mn2 + 6
        }
        if 8 * op[2] + 8 > 128 {
            mn2 = mn2 + 3
        }
        return mn2
    }
    if name == "hkid" {
        // ["hkid"] — pop; and; mov; shr 32; shl 1; push.
        return 16
    }
    if name == "smk" {
        // ["smk", bump, limit, text, kid] — alloc prologue + hdr movabs
        // store + per-byte C6 stores + or/push tail.
        let sl2 = len(op[3])
        let sq2 = 1 + (sl2 + 7) / 8
        let bigBump = 8 * op[1] + 8 > 128
        let bigLim = 8 * op[2] + 8 > 128
        let bigSize = sq2 * 8 > 127
        let smn = 5
        if bigBump {
            smn = smn + 3
        }
        smn = smn + 4
        if bigSize {
            smn = smn + 3
        }
        smn = smn + 5
        if bigLim {
            smn = smn + 3
        }
        smn = smn + 4
        smn = smn + 5
        if bigBump {
            smn = smn + 3
        }
        smn = smn + 3 + 4
        if bigSize {
            smn = smn + 3
        }
        smn = smn + 13
        let sb2 = 0
        while sb2 < (sq2 - 1) * 8 {
            if 8 + sb2 <= 127 {
                smn = smn + 4
            } else {
                smn = smn + 7
            }
            sb2 = sb2 + 1
        }
        return smn + 5
    }
    if name == "feq" || name == "flt" || name == "fle" {
        // pop rdx; pop rcx; untag×2; movsd xmm0,[rcx+8]; xor eax,eax;
        // ucomisd xmm0,[rdx+8]; jp +3; setcc al; push rax
        return 28
    }
    if name == "fne" {
        // same + setne/jmp/mov eax,1 unordered→true path
        return 35
    }
    if name == "fgt" || name == "fge" {
        // no jp needed — unordered sets CF|ZF which seta/setae reject
        return 26
    }
    if name == "mkclo" {
        // ["mkclo", bump, limit, fnidx, ncap] — bound-checked alloc of a
        // closure cell [hdr | fnidx | cap…]: pops ncap tagged words.
        // Base 50B (disp8/imm8 forms): mov rcx,[bump](5) + add(4) +
        // cmp[limit](5) + jbe/ud2(4) + mov[bump],rcx(5) + mov rdx,rcx(3)
        // + sub rdx,sz(4) + mov[rdx],hdr(7) + mov[rdx+8],fi(8) +
        // or rdx,1(4) + push rdx(1).
        let mn = 50
        // bump slot: 2 r12-accesses (+3 each when disp32); limit: 1 (+3).
        if 8 * op[1] + 8 > 128 {
            mn = mn + 6
        }
        if 8 * op[2] + 8 > 128 {
            mn = mn + 3
        }
        // sz = 8*(2+ncap) as imm8 needs sz <= 127 → ncap <= 15; else +6
        // (both add and sub grow to imm32 forms).
        if 8 * (2 + op[4]) > 127 {
            mn = mn + 6
        }
        // Each captured word: pop rax(1) + mov [rdx+16+8i],rax (4|7) —
        // disp8 is signed so offset 128 already needs the 7B form.
        let ci = 0
        while ci < op[4] {
            if 16 + 8 * ci < 128 {
                mn = mn + 5
            } else {
                mn = mn + 8
            }
            ci = ci + 1
        }
        return mn
    }
    if name == "callv" {
        // ["callv", nargs, [fi…]] — indirect call through a closure cell:
        // pops args into the private arg regs (shifted — rcx carries the
        // cell), rejects SMIs via test/jnz/ud2, loads the raw fn index
        // from cell+8 and dispatches over a cmp/jne chain (call rel32
        // per candidate); ud2 when the index matches none.
        let vn = 1 + 3 + 2 + 2 + 3 + 4 + 4 + 2 + 1
        let na = op[1]
        if na <= 3 {
            // Cumulative reg pops live in the na<=3 branch — the na>3
            // spill block pops all three regs itself (counted below).
            if na > 0 {
                vn = vn + 1
            }
            if na > 1 {
                vn = vn + 2
            }
            if na > 2 {
                vn = vn + 2
            }
        }
        if na > 3 {
            // Extra args a4..a_n spill: pop→store scratch (na-3),
            // pop r9/r8/rdx (5B), reload→push, then add rsp caller
            // cleanup (4B imm8 / 7B imm32 — na=19 → 128 bytes).
            let vk2 = 0
            while vk2 < na - 3 {
                vn = vn + 1 + aotX64LocalLen(op[3] + vk2)
                vn = vn + aotX64LocalLen(op[3] + vk2) + 1
                vk2 = vk2 + 1
            }
            vn = vn + 5 + 4
            if 8 * (na - 3) > 127 {
                vn = vn + 3
            }
        }
        let vi = 0
        while vi < len(op[2]) {
            // cmp r10,imm8 (4B) or cmp r10,imm32 (7B) + jne + call + jmp.
            if op[2][vi] > 127 {
                vn = vn + 7 + 2 + 5 + 5
            } else {
                vn = vn + 4 + 2 + 5 + 5
            }
            vi = vi + 1
        }
        return vn
    }
    if name == "trap" {
        // 0F 0B ud2 — honest fault for out-of-domain operands.
        return 2
    }
    if name == "gcollect" {
        // ["gcollect", bump, lo, rb, nspill] — spill(nl,nspill) +
        // collect-call + reload (spill and reload are the same size).
        let gl = 2 * aotX64GcSpillLen(nl, op[3], op[4])
        return gl + aotX64GcCallLen(8 * op[1])
    }
    if name == "hcalloc" {
        // ["hcalloc", bump, limit, lo, rb, nspill] — head check
        // (pop+shl+ld+add+cmp+jbe = 14+ld+cmp), scratch save, spill,
        // call, reload, retry (ld-scratch+ld-bump+add+cmp+jbe+ud2),
        // alloc tail (st-bump + rdx tail 11B).
        let hn = 14 + aotX64R12LdLen(8 * op[1]) + aotX64R12LdLen(8 * op[2])
        hn = hn + aotX64R12StLen(8 * (op[4] + nl + op[5]))
        hn = hn + 2 * aotX64GcSpillLen(nl, op[4], op[5])
        hn = hn + aotX64GcCallLen(8 * op[1])
        hn = hn + aotX64R12LdLen(8 * (op[4] + nl + op[5]))
        hn = hn + aotX64R12LdLen(8 * op[1]) + 3 + aotX64R12LdLen(8 * op[2]) + 6 + 2
        hn = hn + aotX64R12StLen(8 * op[1]) + 11
        return hn
    }
    if name == "ret" {
        // pop rax; leave; pop r12; ret — r12 restore is unconditional
        // (every fn saves r12 in its prologue).
        return 5
    }
    return -1
}

/// Prologue length: push r12 (2 — unconditional: r12 is the callee-saved
/// globals base, saved by every fn so the host's r12 survives) + push rbp
/// (1) + mov rbp,rsp (3) + sub rsp (4 imm8 or 7 imm32) + arg spill 4B per
/// arity + entry normalization (sysv only: mov rcx,rdi 3B for arg1 +
/// mov rdx,rsi 3B for arg2 — win64 needs none since the private
/// convention already IS rcx/rdx) + entry globals-base load (3B) when
/// the module uses data globals.
pub fn aotFnProLen(nlocals, arity, isEntry, abi, needR12) {
    let n = 6
    if nlocals > 0 {
        if nlocals * 8 <= 127 {
            n = n + 4
        } else {
            n = n + 7
        }
    }
    // Arg spill: locals 0..3 seed from the arg regs; locals 4..arity-1
    // are caller stack args — each costs a positive-disp load +
    // local store ([rbp+24+8*(i-4)] → [rbp-8*(i+1)]).
    let pa = 0
    while pa < arity && pa < 4 {
        n = n + aotX64LocalLen(pa)
        pa = pa + 1
    }
    while pa < arity {
        n = n + aotX64LdPosLen(24 + 8 * (pa - 4)) + aotX64LocalLen(pa)
        pa = pa + 1
    }
    if isEntry && abi == "sysv" {
        n = n + arity * 3
    }
    if isEntry && needR12 {
        n = n + 3
    }
    return n
}

/// Emit the prologue (+ entry ABI normalization when isEntry).
pub fn aotFnPro(b, nlocals, arity, isEntry, abi, needR12) {
    // 41 54 push r12 — first, so it sits ABOVE saved rbp at [rbp+8] and
    // leave+pop r12 restores it. 55 push rbp; 48 89 E5 mov rbp,rsp.
    b = push(b, 65)
    b = push(b, 84)
    b = push(b, 85)
    b = push(b, 72)
    b = push(b, 137)
    b = push(b, 229)
    if nlocals > 0 {
        if nlocals * 8 <= 127 {
            // 48 83 EC ib = sub rsp,imm8.
            b = push(b, 72)
            b = push(b, 131)
            b = push(b, 236)
            b = push(b, nlocals * 8)
        } else {
            // 48 81 EC imm32 = sub rsp,imm32.
            b = push(b, 72)
            b = push(b, 129)
            b = push(b, 236)
            b = x64PushImm32(b, nlocals * 8)
        }
    }
    // Entry normalization: host ABI arg1/arg2 land in rdi/rsi on sysv —
    // copy them into the private rcx/rdx convention before the spill.
    // win64 already delivers them in rcx/rdx (rdx = the data-page pointer,
    // which doubles as the image ABI's arg2) so no moves are needed there.
    if isEntry && abi == "sysv" {
        if arity >= 1 {
            // 48 89 F9 = mov rcx,rdi.
            b = push(b, 72)
            b = push(b, 137)
            b = push(b, 249)
        }
        if arity >= 2 {
            // 48 89 F2 = mov rdx,rsi.
            b = push(b, 72)
            b = push(b, 137)
            b = push(b, 242)
        }
    }
    // Globals base: when the module touches data globals the entry loads
    // the data-page pointer (host arg2) into callee-saved r12 — win64 rdx
    // (49 89 D4 mov r12,rdx), sysv rsi (49 89 F4 mov r12,rsi).
    if isEntry && needR12 {
        b = push(b, 73)
        b = push(b, 137)
        if abi == "win64" {
            b = push(b, 212)
        } else {
            b = push(b, 244)
        }
    }
    // Spill private arg regs into local slots: rcx→local0 (48 89 4D ..),
    // rdx→local1 (48 89 55 ..), r8→local2 (4C 89 45 ..), r9→local3
    // (4C 89 4D ..). disp8 or disp32.
    if arity >= 1 {
        b = aotFnStoreReg(b, 0, 77)
    }
    if arity >= 2 {
        b = aotFnStoreReg(b, 1, 85)
    }
    if arity >= 3 {
        b = aotFnStoreRegH(b, 2, 69)
    }
    if arity >= 4 {
        b = aotFnStoreRegH(b, 3, 77)
    }
    // Stack args (calln/callv spill convention): local i≥4 sits at
    // [rbp+24+8*(i-4)] — entry rsp+8, then +8 for pushed r12 and +8 for
    // pushed rbp. Seed each into its local slot.
    let si = 4
    while si < arity {
        b = aotX64LdPos(b, 24 + 8 * (si - 4))
        b = aotFnStoreReg(b, si, 69)
        si = si + 1
    }
    return b
}

/// Byte length of one `mov r?,[rbp-8*(i+1)]` / `mov [rbp-…],r?` local
/// access — disp8 (4B) when 8*(i+1)<=128 else disp32 (7B).
fn aotX64LocalLen(i) {
    if 8 * (i + 1) <= 128 {
        return 4
    }
    return 7
}

/// mov rax, [rbp + off] — positive-disp load (stack args above the
/// saved rbp); 48 8B 45 ib / 48 8B 85 d32.
fn aotX64LdPos(b, off) {
    b = push(b, 72)
    b = push(b, 139)
    if off <= 127 {
        b = push(b, 69)
        b = push(b, off)
    } else {
        b = push(b, 133)
        b = x64PushSImm32(b, off)
    }
    return b
}

fn aotX64LdPosLen(off) {
    if off <= 127 {
        return 4
    }
    return 7
}

/// mov [rbp - 8*(i+1)], <reg> — modrm is 0x45/0x85 + reg*8 encoding; the
/// caller passes the modrm byte (rax=0x45, rcx=0x4D, rdx=0x55 bases are
/// disp8; we recompute for disp32 by adding 0x40).
fn aotFnStoreReg(b, i, modrm8) {
    let off = 8 * (i + 1)
    b = push(b, 72)
    b = push(b, 137)
    if off <= 128 {
        b = push(b, modrm8)
        let d = 256 - off
        b = push(b, d)
    } else {
        b = push(b, modrm8 + 64)
        b = x64PushSImm32(b, 0 - off)
    }
    return b
}

/// mov [rbp - 8*(i+1)], <r8/r9> — same modrm pattern as aotFnStoreReg
/// but with REX.R set (0x4C): the modrm reg field selects the high
/// register — r8 → base 0x45, r9 → base 0x4D.
fn aotFnStoreRegH(b, i, modrm8) {
    let off = 8 * (i + 1)
    b = push(b, 76)
    b = push(b, 137)
    if off <= 128 {
        b = push(b, modrm8)
        let d = 256 - off
        b = push(b, d)
    } else {
        b = push(b, modrm8 + 64)
        b = x64PushSImm32(b, 0 - off)
    }
    return b
}

/// mov rax, [rbp - 8*(i+1)] then push rax — load local i.
fn aotFnLoadLocal(b, i) {
    let off = 8 * (i + 1)
    b = push(b, 72)
    b = push(b, 139)
    if off <= 128 {
        // 48 8B 45 d8 = mov rax,[rbp+disp8].
        b = push(b, 69)
        b = push(b, 256 - off)
    } else {
        // 48 8B 85 disp32.
        b = push(b, 133)
        b = x64PushSImm32(b, 0 - off)
    }
    b = push(b, 80)
    return b
}

/// pop rax; mov [rbp - 8*(i+1)], rax — store local i.
fn aotFnStoreLocal(b, i) {
    b = push(b, 88)
    return aotFnStoreReg(b, i, 69)
}

/// mov <reg>, [r12+off] — reg rax(0)/rcx(1)/rdx(2); disp8 when
/// off+8 <= 128 (same convention as gload). Length helper below.
fn aotX64R12Ld(b, off, reg) {
    b = push(b, 73)
    b = push(b, 139)
    if off + 8 <= 128 {
        b = push(b, 68 + reg * 8)
        b = push(b, 36)
        b = push(b, off)
    } else {
        b = push(b, 132 + reg * 8)
        b = push(b, 36)
        b = x64PushSImm32(b, off)
    }
    return b
}

fn aotX64R12LdLen(off) {
    if off + 8 <= 128 {
        return 5
    }
    return 8
}

/// mov [r12+off], <reg> — same modrm pattern as aotX64R12Ld.
fn aotX64R12St(b, off, reg) {
    b = push(b, 73)
    b = push(b, 137)
    if off + 8 <= 128 {
        b = push(b, 68 + reg * 8)
        b = push(b, 36)
        b = push(b, off)
    } else {
        b = push(b, 132 + reg * 8)
        b = push(b, 36)
        b = x64PushSImm32(b, off)
    }
    return b
}

fn aotX64R12StLen(off) {
    if off + 8 <= 128 {
        return 5
    }
    return 8
}

/// mov rax, [rbp-8*(i+1)] — local slot load without the push.
fn aotX64RbpLd(b, i) {
    let off = 8 * (i + 1)
    b = push(b, 72)
    b = push(b, 139)
    if off <= 128 {
        b = push(b, 69)
        b = push(b, 256 - off)
    } else {
        b = push(b, 133)
        b = x64PushSImm32(b, 0 - off)
    }
    return b
}

fn aotX64RbpLen(i) {
    if 8 * (i + 1) <= 128 {
        return 4
    }
    return 7
}

/// Root-protocol spill: locals → data[rb..rb+nl), top nsp stack
/// values → data[rb+nl..rb+nl+nsp). `dir` selects store (spill) or
/// load (reload — stack values re-pushed deepest-first).
fn aotX64GcSpill(b, nl, rb, nsp, dir) {
    let j = 0
    if dir == 0 {
        while j < nsp {
            b = push(b, 88)
            b = aotX64R12St(b, (rb + nl + j) * 8, 0)
            j = j + 1
        }
    }
    let k = 0
    while k < nl {
        if dir == 0 {
            b = aotX64RbpLd(b, k)
            b = aotX64R12St(b, (rb + k) * 8, 0)
        } else {
            b = aotX64R12Ld(b, (rb + k) * 8, 0)
            b = aotFnStoreReg(b, k, 69)
        }
        k = k + 1
    }
    if dir == 1 {
        let j2 = nsp
        while j2 > 0 {
            j2 = j2 - 1
            b = aotX64R12Ld(b, (rb + nl + j2) * 8, 0)
            b = push(b, 80)
        }
    }
    return b
}

fn aotX64GcSpillLen(nl, rb, nsp) {
    let n = 0
    let j = 0
    while j < nsp {
        n = n + 1 + aotX64R12StLen((rb + nl + j) * 8)
        j = j + 1
    }
    let k = 0
    while k < nl {
        n = n + aotX64RbpLen(k) + aotX64R12StLen((rb + k) * 8)
        k = k + 1
    }
    return n
}

/// Load the __gc_collect args and call it: rcx = top qword index
/// (([r12+bump]-r12)/8), edx = lo, r8d = rc, r9 = r12 (dbase); then
/// convert rax (new top index) back to an address into [r12+bump].
/// Length = 2*r12acc(bump) + 33: sub(3) shr(4) mov edx(5) mov r8d(6)
/// mov r9(3) call(5) shl(4) add(3).
fn aotX64GcCallLen(bumpOff) {
    return aotX64R12LdLen(bumpOff) + aotX64R12StLen(bumpOff) + 33
}

fn aotX64GcCall(b, bump, lo, rc, gcIdx, fnOffs, bOff) {
    let bumpOff = 8 * bump
    b = aotX64R12Ld(b, bumpOff, 1)
    // 4C 29 E1 sub rcx,r12; 48 C1 E9 03 shr rcx,3 — addr → qword idx.
    b = push(b, 76)
    b = push(b, 41)
    b = push(b, 225)
    b = push(b, 72)
    b = push(b, 193)
    b = push(b, 233)
    b = push(b, 3)
    // BA i32 mov edx,lo; 41 B8 i32 mov r8d,rc.
    b = push(b, 186)
    b = x64PushImm32(b, lo)
    b = push(b, 65)
    b = push(b, 184)
    b = x64PushImm32(b, rc)
    // 4D 89 E1 mov r9,r12 — dbase.
    b = push(b, 77)
    b = push(b, 137)
    b = push(b, 225)
    // E8 rel32 — len(b) is the absolute offset of the rel32 field.
    b = push(b, 232)
    b = x64PushSImm32(b, fnOffs[gcIdx] - (len(b) + bOff + 4))
    // 48 C1 E0 03 shl rax,3; 4C 01 E0 add rax,r12 — idx → addr.
    b = push(b, 72)
    b = push(b, 193)
    b = push(b, 224)
    b = push(b, 3)
    b = push(b, 76)
    b = push(b, 1)
    b = push(b, 224)
    b = aotX64R12St(b, bumpOff, 0)
    return b
}

/// Binary op helpers: pop rcx (rhs), pop rax (lhs), combine, push rax.
fn aotFnBinop(b, kind) {
    b = push(b, 89)
    b = push(b, 88)
    if kind == "add" {
        // 48 01 C8 = add rax,rcx.
        b = push(b, 72)
        b = push(b, 1)
        b = push(b, 200)
    }
    if kind == "sub" {
        // 48 29 C8 = sub rax,rcx.
        b = push(b, 72)
        b = push(b, 41)
        b = push(b, 200)
    }
    if kind == "mul" {
        // 48 0F AF C1 = imul rax,rcx.
        b = push(b, 72)
        b = push(b, 15)
        b = push(b, 175)
        b = push(b, 193)
    }
    b = push(b, 80)
    return b
}

/// setcc byte for a predicate name (signed; matches aotX64Setcc magics).
fn aotFnSetcc(name) {
    if name == "eq" {
        return 148
    }
    if name == "ne" {
        return 149
    }
    if name == "lt" {
        return 156
    }
    if name == "gt" {
        return 159
    }
    if name == "le" {
        return 158
    }
    if name == "ge" {
        return 157
    }
    return 0
}

/// Predicate op: pop rcx, pop rax, cmp rax,rcx, setCC al, movzx eax,al,
/// push rax — pushes 1/0. cmp rax,rcx computes lhs-rhs so signed setcc
/// reads lhs vs rhs directly.
fn aotFnCmp(b, name) {
    b = push(b, 89)
    b = push(b, 88)
    // 48 39 C8 = cmp rax,rcx.
    b = push(b, 72)
    b = push(b, 57)
    b = push(b, 200)
    // 0F <setcc> C0; 0F B6 C0 movzx.
    b = push(b, 15)
    b = push(b, aotFnSetcc(name))
    b = push(b, 192)
    b = push(b, 15)
    b = push(b, 182)
    b = push(b, 192)
    b = push(b, 80)
    return b
}

/// Pass 1: byte offset of every op in a fn body (base = the fn's start
/// offset inside the combined image). Returns [] on any unknown op.
pub fn aotFnOpOffsets(ops, base, nl, fa) {
    let offs = []
    let cur = base
    let i = 0
    while i < len(ops) {
        let l = aotFnOpLen(ops[i], nl, fa)
        if l < 0 {
            return []
        }
        offs = push(offs, cur)
        cur = cur + l
        i = i + 1
    }
    return offs
}

/// Emit one fn body. `offs` are the per-op byte offsets; `fnOffs` are the
/// start offsets of all fns in the image (for call rel32). `nl` is the
/// fn's locals count (collect spill size); `gcIdx` is the appended
/// __gc_collect fn index (gcollect/hcalloc ops — always present when
/// such ops exist since aotX64EmitFns appends the collector).
// Emit dispatch table — name -> branch code. One record lookup
// replaces the long string-compare chain per op; ops missing
// from the table fall through untouched (same as before).
let AOT_EMIT_CODE = {
    "const": 1, "load": 2, "store": 3, "acc_add": 4, "add": 5,
    "sub": 5, "mul": 5, "div": 6, "mod": 6, "neg": 7,
    "bit_not": 8, "not": 9, "acc_add_g": 10, "gload": 11, "gstore": 12,
    "lt": 13, "le": 13, "gt": 13, "ge": 13, "eq": 13,
    "ne": 13, "jmp": 14, "jz": 15, "jnz": 15, "call": 16,
    "call2": 17, "call0": 18, "call3": 19, "call4": 20, "calln": 21,
    "pop": 22, "dup": 23, "swap": 24, "tag": 25, "untag": 26,
    "is_smi": 27, "jsmi": 28, "jnsmi": 28, "tconst": 29, "tconst64": 30,
    "tnull": 31, "tundef": 31, "tfalse": 31, "ttrue": 31, "tadd": 32,
    "tsub": 32, "tneg": 33, "tmul": 34, "tdiv": 35, "tmod": 35,
    "tband": 36, "tbor": 36, "tbxor": 36, "tbnot": 37, "tshl": 38,
    "tshr": 38, "tushr": 38, "tpow": 39, "hbase": 40, "hlimit": 40,
    "halloc": 41, "hload": 42, "hstore": 43, "hloadx": 44, "hstorex": 45,
    "hlen": 46, "htag": 47, "hloadb": 48, "hstoreb": 49, "aget": 50,
    "aset": 51, "const64": 52, "fmk": 53, "hkid": 54, "smk": 55,
    "fcast": 56, "fadd": 57, "fsub": 57, "fmul": 57, "fdiv": 57,
    "fmod": 58, "feq": 59, "fne": 59, "flt": 59, "fle": 59,
    "fgt": 59, "fge": 59, "mkclo": 60, "callv": 61, "trap": 62,
    "gcollect": 63, "hcalloc": 64, "ret": 65
}

// i0..i1 lets a driver emit an op range into a fresh byte buffer (chunked
// emit of huge fns); bOff is the absolute image offset that len(b) counts
// from — absolute-position uses (audit, gc call rel32) add it back so both
// whole-image (bOff=0) and staged per-fn (bOff=fnOffs/chunk offs) emit agree.
pub fn aotFnEmitOps(b, ops, offs, fnOffs, nl, gcIdx, fa, i0, i1, bOff) {
    let i = i0
    while i < i1 {
        let op = ops[i]
        let name = op[0]
        let ek = AOT_EMIT_CODE[name]
        if ek == 1 {
            // 48 C7 C0 imm32 = mov rax, sext imm32 (honest i64 sign); push.
            b = push(b, 72)
            b = push(b, 199)
            b = push(b, 192)
            b = x64PushSImm32(b, op[1])
            b = push(b, 80)
        } else if ek == 2 {
            b = aotFnLoadLocal(b, op[1])
        } else if ek == 3 {
            b = aotFnStoreLocal(b, op[1])
        } else if ek == 4 {
            // 58 pop rax; 48 01 45 d8 add [rbp+disp], rax — local += rhs.
            b = push(b, 88)
            let aoff = 8 * (op[1] + 1)
            b = push(b, 72)
            b = push(b, 1)
            if aoff <= 128 {
                b = push(b, 69)
                b = push(b, 256 - aoff)
            } else {
                b = push(b, 133)
                b = x64PushSImm32(b, 0 - aoff)
            }
        } else if ek == 5 {
            b = aotFnBinop(b, name)
        } else if ek == 6 {
            // 59 pop rcx (divisor); 58 pop rax; 48 85 C9 test rcx,rcx;
            // 75 02 jnz +2; 0F 0B ud2 — divide-by-zero TRAPS (SIGILL):
            // Kab throws "Integer division by zero" but the native i64
            // domain has no error channel — a hard stop is honest, a
            // silent wrong answer is not. 48 99 cqo; 48 F7 F9 idiv rcx
            // → rax=quot, rdx=rem.
            b = push(b, 89)
            b = push(b, 88)
            b = push(b, 72)
            b = push(b, 133)
            b = push(b, 201)
            b = push(b, 117)
            b = push(b, 2)
            b = push(b, 15)
            b = push(b, 11)
            b = push(b, 72)
            b = push(b, 153)
            b = push(b, 72)
            b = push(b, 247)
            b = push(b, 249)
            if name == "mod" {
                // 48 89 D0 = mov rax,rdx — take the remainder.
                b = push(b, 72)
                b = push(b, 137)
                b = push(b, 208)
            }
            b = push(b, 80)
        } else if ek == 7 {
