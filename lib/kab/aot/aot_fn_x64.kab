            }
            b = push(b, 72)
            b = push(b, 131)
            b = push(b, 193)
            b = push(b, 16)
            b = push(b, 73)
            b = push(b, 59)
            if mol + 8 <= 128 {
                b = push(b, 76)
                b = push(b, 36)
                b = push(b, mol)
            } else {
                b = push(b, 140)
                b = push(b, 36)
                b = x64PushSImm32(b, mol)
            }
            b = push(b, 118)
            b = push(b, 2)
            b = push(b, 15)
            b = push(b, 11)
            b = push(b, 73)
            b = push(b, 137)
            if mof + 8 <= 128 {
                b = push(b, 76)
                b = push(b, 36)
                b = push(b, mof)
            } else {
                b = push(b, 140)
                b = push(b, 36)
                b = x64PushSImm32(b, mof)
            }
            b = push(b, 72)
            b = push(b, 137)
            b = push(b, 202)
            b = push(b, 72)
            b = push(b, 131)
            b = push(b, 234)
            b = push(b, 16)
            b = push(b, 72)
            b = push(b, 199)
            b = push(b, 2)
            b = x64PushSImm32(b, 65537)
            b = push(b, 242)
            b = push(b, 15)
            b = push(b, 17)
            b = push(b, 66)
            b = push(b, 8)
            b = push(b, 72)
            b = push(b, 131)
            b = push(b, 202)
            b = push(b, 1)
            b = push(b, 82)
        } else if ek == 59 {
            // [lptr, rptr] → raw 0/1 compare on the f64 payloads.
            // ucomisd sets CF/ZF/PF; unordered (NaN) sets all three.
            // eq/le/lt/fne reject or accept unordered via a jp branch;
            // gt/ge are naturally false on unordered.
            b = push(b, 90)
            b = push(b, 89)
            b = push(b, 72)
            b = push(b, 131)
            b = push(b, 226)
            b = push(b, 254)
            b = push(b, 72)
            b = push(b, 131)
            b = push(b, 225)
            b = push(b, 254)
            b = push(b, 242)
            b = push(b, 15)
            b = push(b, 16)
            b = push(b, 65)
            b = push(b, 8)
            b = push(b, 49)
            b = push(b, 192)
            b = push(b, 102)
            b = push(b, 15)
            b = push(b, 46)
            b = push(b, 66)
            b = push(b, 8)
            if name == "fne" {
                // jp +5 → mov eax,1; setne al; jmp +5; mov eax,1; push
                b = push(b, 122)
                b = push(b, 5)
                b = push(b, 15)
                b = push(b, 149)
                b = push(b, 192)
                b = push(b, 235)
                b = push(b, 5)
                b = push(b, 184)
                b = push(b, 1)
                b = push(b, 0)
                b = push(b, 0)
                b = push(b, 0)
            } else {
                let cc = 148
                if name == "flt" {
                    cc = 146
                }
                if name == "fle" {
                    cc = 150
                }
                if name == "fgt" {
                    cc = 151
                }
                if name == "fge" {
                    cc = 147
                }
                if name == "fgt" || name == "fge" {
                    b = push(b, 15)
                    b = push(b, cc)
                    b = push(b, 192)
                } else {
                    // unordered → 0: jp +3 over the setcc
                    b = push(b, 122)
                    b = push(b, 3)
                    b = push(b, 15)
                    b = push(b, cc)
                    b = push(b, 192)
                }
            }
            b = push(b, 80)
        } else if ek == 60 {
            // ["mkclo", bump, limit, fnidx, ncap] — closure cell
            // [hdr=tag6<<16|(1+ncap) | fnidx(raw) | cap0..capN]: bound-
            // checked bump alloc, then the ncap tagged words are popped
            // into payload slots top-down (last pushed = highest slot).
            let cbump = 8 * op[1]
            let clim = 8 * op[2]
            let csz = 8 * (2 + op[4])
            b = push(b, 73)
            b = push(b, 139)
            if cbump + 8 <= 128 {
                b = push(b, 76)
                b = push(b, 36)
                b = push(b, cbump)
            } else {
                b = push(b, 140)
                b = push(b, 36)
                b = x64PushSImm32(b, cbump)
            }
            b = push(b, 72)
            if csz <= 127 {
                b = push(b, 131)
                b = push(b, 193)
                b = push(b, csz)
            } else {
                b = push(b, 129)
                b = push(b, 193)
                b = x64PushSImm32(b, csz)
            }
            b = push(b, 73)
            b = push(b, 59)
            if clim + 8 <= 128 {
                b = push(b, 76)
                b = push(b, 36)
                b = push(b, clim)
            } else {
                b = push(b, 140)
                b = push(b, 36)
                b = x64PushSImm32(b, clim)
            }
            b = push(b, 118)
            b = push(b, 2)
            b = push(b, 15)
            b = push(b, 11)
            b = push(b, 73)
            b = push(b, 137)
            if cbump + 8 <= 128 {
                b = push(b, 76)
                b = push(b, 36)
                b = push(b, cbump)
            } else {
                b = push(b, 140)
                b = push(b, 36)
                b = x64PushSImm32(b, cbump)
            }
            b = push(b, 72)
            b = push(b, 137)
            b = push(b, 202)
            b = push(b, 72)
            if csz <= 127 {
                b = push(b, 131)
                b = push(b, 234)
                b = push(b, csz)
            } else {
                b = push(b, 129)
                b = push(b, 234)
                b = x64PushSImm32(b, csz)
            }
            // 48 C7 02 i32 = mov [rdx], hdr; 48 C7 42 08 i32 = [rdx+8], fi.
            b = push(b, 72)
            b = push(b, 199)
            b = push(b, 2)
            b = x64PushSImm32(b, 6 * 65536 + 1 + op[4])
            b = push(b, 72)
            b = push(b, 199)
            b = push(b, 66)
            b = push(b, 8)
            b = x64PushSImm32(b, op[3])
            let ci = op[4]
            while ci > 0 {
                ci = ci - 1
                b = push(b, 88)
                let coff = 16 + 8 * ci
                b = push(b, 72)
                if coff < 128 {
                    b = push(b, 137)
                    b = push(b, 66)
                    b = push(b, coff)
                } else {
                    b = push(b, 137)
                    b = push(b, 130)
                    b = x64PushSImm32(b, coff)
                }
            }
            b = push(b, 72)
            b = push(b, 131)
            b = push(b, 202)
            b = push(b, 1)
            b = push(b, 82)
        } else if ek == 61 {
            // ["callv", nargs, [fi…]] — callee cell sits on TOP of the
            // stack (compileIr evaluates args first, callee last): pop
            // the cell → rcx (hidden arg0), then args → r9/r8/rdx.
            // fnidx = [cell+8] raw; cmp/jne chain to a direct call per
            // candidate; ud2 on SMI callee or unknown index.
            let vna = op[1]
            b = push(b, 89)
            if vna > 3 {
                // Args a4..a_n spill to scratch locals (op[3] base):
                // pop top-down (scr+0 = a_n), pop regs a3..a1, then push
                // the extras back a_n..a_4 so a4 lands topmost → callee
                // reads local i≥4 at [rbp+24+8*(i-4)].
                let vs3 = op[3]
                let vk3 = 0
                while vk3 < vna - 3 {
                    b = push(b, 88)
                    b = aotFnStoreReg(b, vs3 + vk3, 69)
                    vk3 = vk3 + 1
                }
                b = push(b, 65)
                b = push(b, 89)
                b = push(b, 65)
                b = push(b, 88)
                b = push(b, 90)
                vk3 = 0
                while vk3 < vna - 3 {
                    b = aotFnLoadLocal(b, vs3 + vk3)
                    vk3 = vk3 + 1
                }
            }
            if vna <= 3 {
                // Cumulative register pops: a3→r9, a2→r8, a1→rdx (the
                // na>3 spill block already popped all three itself).
                if vna >= 3 {
                    b = push(b, 65)
                    b = push(b, 89)
                }
                if vna >= 2 {
                    b = push(b, 65)
                    b = push(b, 88)
                }
                if vna >= 1 {
                    b = push(b, 90)
                }
            }
            // F6 C1 01 test cl,1; 75 02 jnz +2; 0F 0B ud2 — SMI callee
            // traps honestly instead of dereferencing a small int.
            b = push(b, 246)
            b = push(b, 193)
            b = push(b, 1)
            b = push(b, 117)
            b = push(b, 2)
            b = push(b, 15)
            b = push(b, 11)
            // 48 89 C8 mov rax,rcx — the cell stays TAGGED in rcx so the
            // callee sees a proper heap value as its arg0/`this`; the
            // untagged copy in rax only serves the fnidx load. fnidx goes
            // to r10 — NOT rsi: rsi is callee-saved on win64 and the host
            // caller relies on it surviving the call (clobbering it
            // corrupts the Rust frame → stack overflow).
            b = push(b, 72)
            b = push(b, 137)
            b = push(b, 200)
            b = push(b, 72)
            b = push(b, 131)
            b = push(b, 224)
            b = push(b, 254)
            // 4C 8B 50 08 = mov r10,[rax+8].
            b = push(b, 76)
            b = push(b, 139)
            b = push(b, 80)
            b = push(b, 8)
            // csz = bytes emitted so far inside this op.
            let csz = 0
            if vna > 3 {
                let ck4 = 0
                while ck4 < vna - 3 {
                    csz = csz + 1 + aotX64LocalLen(op[3] + ck4)
                    ck4 = ck4 + 1
                }
                csz = csz + 5
                ck4 = 0
                while ck4 < vna - 3 {
                    csz = csz + aotX64LocalLen(op[3] + ck4) + 1
                    ck4 = ck4 + 1
                }
            }
            if vna <= 3 {
                if vna >= 3 {
                    csz = csz + 2
                }
                if vna >= 2 {
                    csz = csz + 2
                }
                if vna >= 1 {
                    csz = csz + 1
                }
            }
            csz = csz + 1 + 3 + 2 + 2 + 3 + 4 + 4
            let vfi = op[2]
            // Candidates >= 128 need the cmp r10,imm32 form (19B per
            // block vs 16B for imm8) — accumulate, stride isn't fixed.
            let ctot = 0
            let vk5 = 0
            while vk5 < len(vfi) {
                if vfi[vk5] > 127 {
                    ctot = ctot + 19
                } else {
                    ctot = ctot + 16
                }
                vk5 = vk5 + 1
            }
            let voff = csz
            let vj = 0
            while vj < len(vfi) {
                let cand = vfi[vj]
                if cand > 127 {
                    // 49 81 FA id cmp r10,imm32.
                    b = push(b, 73)
                    b = push(b, 129)
                    b = push(b, 250)
                    b = x64PushSImm32(b, cand)
                    voff = voff + 7
                } else {
                    // 49 83 FA ib cmp r10,imm8.
                    b = push(b, 73)
                    b = push(b, 131)
                    b = push(b, 250)
                    b = push(b, cand)
                    voff = voff + 4
                }
                // 75 0A jne +10; E8 rel32; E9 rel32 → done (skips the
                // rest + the trailing ud2).
                b = push(b, 117)
                b = push(b, 10)
                b = push(b, 232)
                voff = voff + 2
                let callEnd = offs[i] + voff + 5
                b = x64PushSImm32(b, fnOffs[cand] - callEnd)
                voff = voff + 5
                b = push(b, 233)
                let doneOff = offs[i] + csz + ctot + 2
                b = x64PushSImm32(b, doneOff - (offs[i] + voff + 5))
                voff = voff + 5
                vj = vj + 1
            }
            b = push(b, 15)
            b = push(b, 11)
            if vna > 3 {
                // add rsp — pop the caller-owned stack args (a4..a_n)
                // after the callee returns: 48 83 C4 ib while the total
                // fits imm8, else 48 81 C4 imm32 (na = 19 → 128 bytes).
                if 8 * (vna - 3) <= 127 {
                    b = push(b, 72)
                    b = push(b, 131)
                    b = push(b, 196)
                    b = push(b, 8 * (vna - 3))
                } else {
                    b = push(b, 72)
                    b = push(b, 129)
                    b = push(b, 196)
                    b = x64PushSImm32(b, 8 * (vna - 3))
                }
            }
            b = push(b, 80)
        } else if ek == 62 {
            b = push(b, 15)
            b = push(b, 11)
        } else if ek == 63 {
            // ["gcollect", bump, lo, rb, nspill] — the root protocol:
            // spill the top nspill stack values and all nl locals into
            // the data-page root area at [rb..rc), call __gc_collect
            // (top idx, lo, rc, r12-dbase), store the returned new top
            // as an address in the bump slot, reload roots.
            b = aotX64GcSpill(b, nl, op[3], op[4], 0)
            b = aotX64GcCall(b, op[1], op[2], op[3] + nl + op[4], gcIdx, fnOffs, bOff)
            b = aotX64GcSpill(b, nl, op[3], op[4], 1)
        } else if ek == 64 {
            // ["hcalloc", bump, limit, lo, rb, nspill] — bound-checked
            // bump-alloc with collect-on-overflow. Fast path identical
            // to halloc; over the limit: stash the byte count in the
            // scratch slot above the root area, collect, retry, ud2
            // only when the heap is STILL full.
            let rb2 = op[4]
            let nsp2 = op[5]
            let scr = (rb2 + nl + nsp2) * 8
            // pop rax (nw); shl rax,3; rcx = [bump]; rcx += rax;
            // cmp rcx,[limit]; 0F 86 rel32 jbe → ALLOC.
            b = push(b, 88)
            b = push(b, 72)
            b = push(b, 193)
            b = push(b, 224)
            b = push(b, 3)
            b = aotX64R12Ld(b, 8 * op[1], 1)
            b = push(b, 72)
            b = push(b, 1)
            b = push(b, 193)
            // 49 3B 4C 24 d8 / 49 3B 8C 24 d32 = cmp rcx,[r12+limit].
            b = push(b, 73)
            b = push(b, 59)
            if 8 * op[2] + 8 <= 128 {
                b = push(b, 76)
                b = push(b, 36)
                b = push(b, 8 * op[2])
            } else {
                b = push(b, 140)
                b = push(b, 36)
                b = x64PushSImm32(b, 8 * op[2])
            }
            b = push(b, 15)
            b = push(b, 134)
            let hcc = len(b)
            b = x64PushSImm32(b, 0)
            // slow path — stash nw bytes above the root area, collect.
            b = aotX64R12St(b, scr, 0)
            b = aotX64GcSpill(b, nl, rb2, nsp2, 0)
            b = aotX64GcCall(b, op[1], op[3], rb2 + nl + nsp2, gcIdx, fnOffs, bOff)
            b = aotX64GcSpill(b, nl, rb2, nsp2, 1)
            // retry: rax = nw bytes; rcx = new bump; rcx += rax; cmp;
            // 0F 86 rel32 jbe → ALLOC; else ud2.
            b = aotX64R12Ld(b, scr, 0)
            b = aotX64R12Ld(b, 8 * op[1], 1)
            b = push(b, 72)
            b = push(b, 1)
            b = push(b, 193)
            b = push(b, 73)
            b = push(b, 59)
            if 8 * op[2] + 8 <= 128 {
                b = push(b, 76)
                b = push(b, 36)
                b = push(b, 8 * op[2])
            } else {
                b = push(b, 140)
                b = push(b, 36)
                b = x64PushSImm32(b, 8 * op[2])
            }
            b = push(b, 15)
            b = push(b, 134)
            let hcc2 = len(b)
            b = x64PushSImm32(b, 0)
            b = push(b, 15)
            b = push(b, 11)
            // ALLOC — patch both jbe rel32s to land here: mov [bump],rcx
            // (store the winning candidate); rdx = rcx - rax | 1; push.
            let alc = len(b)
            let rel1 = alc - hcc - 4
            b[hcc] = rel1 % 256
            b[hcc + 1] = (rel1 / 256) % 256
            b[hcc + 2] = (rel1 / 65536) % 256
            b[hcc + 3] = (rel1 / 16777216) % 256
            let rel2 = alc - hcc2 - 4
            b[hcc2] = rel2 % 256
            b[hcc2 + 1] = (rel2 / 256) % 256
            b[hcc2 + 2] = (rel2 / 65536) % 256
            b[hcc2 + 3] = (rel2 / 16777216) % 256
            b = aotX64R12St(b, 8 * op[1], 1)
            b = push(b, 72)
            b = push(b, 137)
            b = push(b, 202)
            b = push(b, 72)
            b = push(b, 41)
            b = push(b, 194)
            b = push(b, 72)
            b = push(b, 131)
            b = push(b, 202)
            b = push(b, 1)
            b = push(b, 82)
        } else if ek == 65 {
            // 58 pop rax; C9 leave; 41 5C pop r12; C3 ret — r12 was
            // pushed first in the prologue so it sits above saved rbp.
            b = push(b, 88)
            b = push(b, 201)
            b = push(b, 65)
            b = push(b, 92)
            b = push(b, 195)
        }
        // Length audit: emitted bytes for this op must equal the declared
        // aotFnOpLen — a drift here shifts every later op so jump rel32s
        // land mid-instruction (silent corruption, not a clean reject).
        // The offset table already encodes every op's length, so the
        // audit reads it as a diff instead of a third aotFnOpLen call.
        let emittedLen = len(b) + bOff - offs[i]
        let wantLen = 0
        if i + 1 < len(ops) {
            wantLen = offs[i + 1] - offs[i]
        } else {
            wantLen = aotFnOpLen(op, nl, fa)
        }
        if emittedLen != wantLen {
            throw "aot-x64 op length mismatch " + name + " @" + i + " emit=" + emittedLen + " decl=" + wantLen
        }
        i = i + 1
    }
    return b
}

// Ops that need the globals-base register (r12) — the entry loads the
// data-page pointer into it when any of these appear.
let AOT_NEED_R12 = {
    "gload": 1, "gstore": 1, "acc_add_g": 1, "hbase": 1, "hlimit": 1,
    "halloc": 1, "mkclo": 1, "fmk": 1, "fadd": 1, "fsub": 1, "fmul": 1,
    "fdiv": 1, "fcast": 1, "fmod": 1, "smk": 1, "gcollect": 1, "hcalloc": 1
}

// aotFnOk per-op check tables — name → code replaces a ~15-deep
// string-compare chain per machine op.
// needarg: these names must have op[1] present (len(op) >= 2).
let AOT_OK_NEEDARG = {
    "const": 1, "tconst": 1, "tconst64": 1, "load": 1, "store": 1,
    "acc_add": 1, "gload": 1, "gstore": 1, "acc_add_g": 1,
    "hbase": 1, "hlimit": 1, "hload": 1, "hstore": 1,
    "jmp": 1, "jz": 1, "jnz": 1, "jsmi": 1, "jnsmi": 1
}
// check codes: 1=const 2=tconst 3=tconst64 4=local-slot 5=global-slot
// 6=heap-slot1 7=halloc(1+2) 8=fop-bump/limit 9=smk 10=mkclo
// 11=callv 12=calln 13=gcollect 14=hcalloc 15=jump-target.
let AOT_OK_CHECK = {
    "const": 1, "tconst": 2, "tconst64": 3,
    "load": 4, "store": 4, "acc_add": 4,
    "gload": 5, "gstore": 5, "acc_add_g": 5,
    "hbase": 6, "hlimit": 6, "hload": 6, "hstore": 6,
    "halloc": 7,
    "fmk": 8, "fadd": 8, "fsub": 8, "fmul": 8, "fdiv": 8,
    "fcast": 8, "fmod": 8,
    "smk": 9, "mkclo": 10, "callv": 11, "calln": 12,
    "gcollect": 13, "hcalloc": 14,
    "jmp": 15, "jz": 15, "jnz": 15, "jsmi": 15, "jnsmi": 15
}

/// Validate a fn record: {ops, locals, arity, name} within the v1 domain.
pub fn aotFnOk(f, fa) {
    let ops = f["ops"]
    if len(ops) == 0 {
        return false
    }
    let nlocals = f["locals"]
    let arity = f["arity"]
    // 4096 locals = 32KiB frame — disp32 paths cover offsets far beyond
    // the disp8 window, so the cap is a sanity bound, not an encoding
    // one. Real lowered module mains exceed 256 (lexer_scan hits 264).
    if nlocals < 0 || nlocals > 4096 {
        return false
    }
    // Private convention: args 1..4 in rcx/rdx/r8/r9, args 5+ spill to
    // the caller's frame (calln/callv stack-arg convention — local i≥4
    // reads [rbp+24+8*(i-4)]). Cap at 20 keeps the caller-side
    // add-rsp,imm8 cleanup in range. The ENTRY cap of 2 (the host ABI
    // only supplies two args) is enforced by aotX64EmitFns.
    if arity < 0 || arity > 20 || arity > nlocals {
        return false
    }
    let last = ops[len(ops) - 1]
    if last[0] != "ret" {
        return false
    }
    let i = 0
    while i < len(ops) {
        let op = ops[i]
        if aotFnOpLen(op, nlocals, fa) < 0 {
            return false
        }
        let name = op[0]
        // Same arity guard as aotFnOpLen for the operand reads below.
        if len(op) < 2 {
            if AOT_OK_NEEDARG[name] == 1 {
                return false
            }
        }
        let ck = AOT_OK_CHECK[name]
        if ck == 1 {
            if op[1] < -2147483648 || op[1] > 2147483647 {
                return false
            }
        } else if ck == 2 {
            // tagged = v<<1 must fit sext imm32 → |v| <= 0x3FFFFFFF.
            if op[1] < -1073741824 || op[1] > 1073741823 {
                return false
            }
        } else if ck == 3 {
            // movabs path — Kab integers are exact only to 2^53, so the
            // tagged value v<<1 must stay inside |v| <= 2^52.
            if op[1] < -4503599627370496 || op[1] > 4503599627370496 {
                return false
            }
        } else if ck == 4 {
            if op[1] < 0 || op[1] >= nlocals {
                return false
            }
        } else if ck == 5 {
            if op[1] < 0 {
                return false
            }
        } else if ck == 6 {
            if op[1] < 0 {
                return false
            }
        } else if ck == 7 {
            // halloc: op[1] and op[2] both checked.
            if op[1] < 0 {
                return false
            }
            if op[2] == undefined || op[2] < 0 {
                return false
            }
        } else if ck == 8 {
            // fmk/fadd/fsub/fmul/fdiv/fcast/fmod: bump/limit operands.
            if op[2] == undefined || op[2] < 0 {
                return false
            }
        } else if ck == 9 {
            // ["smk", bump, limit, text, kid] — string payload + interned
            // kid slot; bump/limit must be non-negative global slots.
            if op[1] == undefined || op[1] < 0 || op[2] == undefined || op[2] < 0 {
                return false
            }
            if typeof(op[3]) != "string" || typeof(op[4]) != "number" || op[4] < 0 || op[4] >= 1048576 {
                return false
            }
        } else if ck == 10 {
            if op[3] == undefined || op[3] < 0 || op[4] == undefined || op[4] < 0 {
                return false
            }
        } else if ck == 11 {
            // op[1] = nargs (rcx is the cell; a4+ spill via op[3]=scr).
            // 19 = callee arity 20 minus the hidden cell arg.
            if op[1] == undefined || op[1] < 0 || op[1] > 19 {
                return false
            }
            if op[1] > 3 {
                // Scratch region scr..scr+na-4 must fit in the frame.
                if len(op) < 4 || op[3] == undefined || op[3] < 0 || op[3] + op[1] - 3 > nlocals {
                    return false
                }
            }
            if op[2] == undefined || typeof(op[2]) != "array" {
                return false
            }
            let vci = 0
            while vci < len(op[2]) {
                // imm32 compare covers large images; the emit pass
                // range-checks candidates against the fn table.
                if op[2][vci] < 0 || op[2][vci] > 1073741823 {
                    return false
                }
                vci = vci + 1
            }
        } else if ck == 12 {
            // ["calln", fi, n, scr] — n>=5; scr..scr+n-5 must fit.
            if len(op) < 4 || op[2] == undefined || op[2] < 5 || op[2] > 20 {
                return false
            }
            if op[3] == undefined || op[3] < 0 || op[3] + op[2] - 4 > nlocals {
                return false
            }
        } else if ck == 13 {
            // ["gcollect", bump, lo, rb, nspill] — the root area
            // [rb, rb+nlocals+nspill) must fit below the heap base.
            if len(op) < 5 || op[1] < 0 || op[2] < 0 || op[3] < 0 || op[4] < 0 {
                return false
            }
            if op[3] + nlocals + op[4] > op[2] {
                return false
            }
        } else if ck == 14 {
            // ["hcalloc", bump, limit, lo, rb, nspill] — same root-area
            // check plus one scratch slot for the byte count.
            if len(op) < 6 || op[1] < 0 || op[2] < 0 || op[3] < 0 || op[4] < 0 || op[5] < 0 {
                return false
            }
            if op[4] + nlocals + op[5] + 1 > op[3] {
                return false
            }
        } else if ck == 15 {
            if op[1] < 0 || op[1] >= len(ops) {
                return false
            }
        }
        i = i + 1
    }
    return true
}

/// Two-pass emit of a whole image worth of fns. `fns` is an array of
/// {ops, locals, arity, name}; fns[0] is the entry (_start). `abi` is the
/// host abi tag ("win64"/"sysv") — it only changes the entry prologue.
/// Returns {code, fnOffs, total} or []-equivalent {} on domain miss…
/// honestly: returns {"code": []} when any fn fails validation.
pub fn aotX64EmitFns(fns, abi) {
    if abi != "win64" && abi != "sysv" {
        return { "code": [] }
    }
    if len(fns) == 0 {
        return { "code": [] }
    }
    // needR12: any gload/gstore/heap/collect op anywhere → the entry
    // loads the data-page pointer into callee-saved r12 (and every fn
    // already preserves it). needGc: any collect op → append the
    // synthesized __gc_collect fn (emitted by the same op language).
    let needR12 = false
    let needGc = false
    let gi = 0
    while gi < len(fns) {
        let gops = fns[gi]["ops"]
        let gj = 0
        while gj < len(gops) {
            let gn = gops[gj][0]
            if AOT_NEED_R12[gn] == 1 {
                needR12 = true
            }
            if gn == "gcollect" || gn == "hcalloc" {
                needGc = true
            }
            gj = gj + 1
        }
        gi = gi + 1
    }
    let gcIdx = -1
    if needGc {
        fns = push(fns, aotGcSynthFn())
        gcIdx = len(fns) - 1
    }
    // The entry's args arrive across the host ABI: only two exist —
    // arg2 IS the data-page pointer.
    if fns[0]["arity"] > 2 {
        return { "code": [] }
    }
    // Callee-arity table: a call with fewer args than the callee's
    // declared params pads the missing arg regs with tagged undefined
    // (VM semantics), which changes the emitted op length.
    let fa = []
    let fai = 0
    while fai < len(fns) {
        fa = push(fa, fns[fai]["arity"])
        fai = fai + 1
    }
    // Pass 1a: per-fn op offsets + fn start offsets.
    let fnOffs = []
    let allOffs = []
    let cur = 0
    let fi = 0
    while fi < len(fns) {
        let f = fns[fi]
        if aotFnOk(f, fa) == false {
            println("emit reject: aotFnOk " + f["name"])
            return { "code": [] }
        }
        let isEntry = fi == 0
        let pro = aotFnProLen(f["locals"], f["arity"], isEntry, abi, needR12)
        cur = cur + pro
        let offs = aotFnOpOffsets(f["ops"], cur, f["locals"], fa)
        if len(offs) == 0 {
            println("emit reject: offsets " + f["name"])
            return { "code": [] }
        }
        allOffs = push(allOffs, offs)
        let lastOp = f["ops"][len(f["ops"]) - 1]
        cur = offs[len(offs) - 1] + aotFnOpLen(lastOp, f["locals"], fa)
        fnOffs = push(fnOffs, offs[0] - pro)
        fi = fi + 1
    }

    // Validate call targets now that fn count is known — target index AND
    // the callee's declared arity must match the callN arg count.
    let fi2 = 0
    while fi2 < len(fns) {
        let ops2 = fns[fi2]["ops"]
        let j = 0
        while j < len(ops2) {
            let n2 = ops2[j][0]
            let want = -1
            if n2 == "call0" {
                want = 0
            } else if n2 == "call" {
                want = 1
            } else if n2 == "call2" {
                want = 2
            } else if n2 == "call3" {
                want = 3
            } else if n2 == "call4" {
                want = 4
            }
            if want >= 0 {
                let t = ops2[j][1]
                if t < 0 || t >= len(fns) {
                    println("emit reject: call target " + fns[fi2]["name"] + " -> " + t)
                    return { "code": [] }
                }
                // Missing args pad to tagged undefined in the emit —
                // legal when the callee's arity stays within the four
                // register slots. Extra args (want > arity) are dropped,
                // also matching the VM.
                let ctar = fns[t]["arity"]
                if ctar > want && ctar > 4 {
                    println("emit reject: arity " + fns[fi2]["name"] + " -> " + fns[t]["name"] + " want=" + want + " got=" + ctar)
                    return { "code": [] }
                }
            }
            if n2 == "calln" {
                let t2 = ops2[j][1]
                if t2 < 0 || t2 >= len(fns) {
                    println("emit reject: calln target " + fns[fi2]["name"] + " -> " + t2)
                    return { "code": [] }
                }
                // Fewer supplied args than callee params would leave
                // stack-arg slots unpadded — reject; extras are dropped.
                if fns[t2]["arity"] > ops2[j][2] {
                    println("emit reject: calln arity " + fns[fi2]["name"] + " -> " + fns[t2]["name"])
                    return { "code": [] }
                }
            }
            if n2 == "callv" {
                let cands2 = ops2[j][2]
                let ci9 = 0
                while ci9 < len(cands2) {
                    if cands2[ci9] < 0 || cands2[ci9] >= len(fns) {
                        println("emit reject: callv cand " + fns[fi2]["name"] + " -> " + cands2[ci9])
                        return { "code": [] }
                    }
                    ci9 = ci9 + 1
                }
            }
            j = j + 1
        }
        fi2 = fi2 + 1
    }
    // Pass 2: emit.
    let b = []
    let fi3 = 0
    while fi3 < len(fns) {
        let f = fns[fi3]
        b = aotFnPro(b, f["locals"], f["arity"], fi3 == 0, abi, needR12)
        b = aotFnEmitOps(b, f["ops"], allOffs[fi3], fnOffs, f["locals"], gcIdx, fa, 0, len(f["ops"]), 0)
        fi3 = fi3 + 1
    }
    return { "code": b, "fnOffs": fnOffs, "total": cur }
}
