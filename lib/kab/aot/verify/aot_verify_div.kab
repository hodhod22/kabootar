// F10: native image filename and div opcode must agree.
// import "kab/aot/aot_verify_div"; do not import other kab/aot* leaves.

pub fn aotVerifyDivOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "f7f8"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "9ac00c00"
    }
    return false
}
