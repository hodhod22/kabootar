// F10: native image filename and cmp opcode must agree.
// import "kab/aot/aot_verify_cmp"; do not import other kab/aot* leaves.

pub fn aotVerifyCmpOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "39c0"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "eb00001f"
    }
    return false
}
