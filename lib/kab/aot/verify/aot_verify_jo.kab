// F10: native image filename and jo opcode must agree.
// import "kab/aot/aot_verify_jo"; do not import other kab/aot* leaves.

pub fn aotVerifyJoOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "7000"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "54000006"
    }
    return false
}
