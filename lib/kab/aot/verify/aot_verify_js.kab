// F10: native image filename and js opcode must agree.
// import "kab/aot/aot_verify_js"; do not import other kab/aot* leaves.

pub fn aotVerifyJsOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "7800"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "54000004"
    }
    return false
}
