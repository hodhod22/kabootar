// F10: native image filename and push opcode must agree.
// import "kab/aot/aot_verify_push"; do not import other kab/aot* leaves.

pub fn aotVerifyPushOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "50"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "e00f1ff8"
    }
    return false
}
