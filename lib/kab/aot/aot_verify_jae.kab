// F10: native image filename and jae opcode must agree.
// import "kab/aot/aot_verify_jae"; do not import other kab/aot* leaves.

pub fn aotVerifyJaeOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "7300"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "54000002"
    }
    return false
}
