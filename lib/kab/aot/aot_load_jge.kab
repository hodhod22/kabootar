// F10: loader accepts only a documented first-image jge opcode.
// import "kab/aot/aot_load_jge"; do not import other kab/aot* leaves.

pub fn aotLoadJgeOk(op, target) {
    if target == "x64" {
        return op == "7d00"
    }
    if target == "arm64" {
        return op == "5400000a"
    }
    return false
}
