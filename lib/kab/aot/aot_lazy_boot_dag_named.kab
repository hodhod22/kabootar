// F10 deepen: named lazy AOT boot-DAG. import "kab/aot/aot_lazy_boot_dag_named"
// Do not grow aot_lazy_boot_dag.kab. Boot entry name required; not the remainder JIT kind.

import "kab/aot/aot_lazy_boot_dag"

pub fn aotLazyBootDagNamedOk(ms, remKind, nHits, nPhi, nInv, nDup, nGuard, kind, marked, same, nLive, nBytes, n, na, nb, nBoot, nRest, nMods, bootName) {
    if aotLazyBootDagOk(ms, remKind, nHits, nPhi, nInv, nDup, nGuard, kind, marked, same, nLive, nBytes, n, na, nb, nBoot, nRest, nMods) == false {
        return false
    }
    if len(bootName) == 0 {
        return false
    }
    if bootName == remKind {
        return false
    }
    return true
}
