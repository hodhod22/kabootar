// F10: first Kab-native images emit a documented xor opcode for the return register.
// import "kab/aot/aot_xor_op"; do not import other kab/aot* leaves.

pub fn aotXorOp(target) {
    if target == "x64" {
        return "33c0"
    }
    if target == "arm64" {
        return "ca000000"
    }
    return ""
}
