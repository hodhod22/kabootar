// F10: native image filename and jno opcode must agree.
// import "kab/aot/aot_verify_jno"; do not import other kab/aot* leaves.

pub fn aotVerifyJnoOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "7100"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "54000007"
    }
    return false
}
