// F10: native image filename and jne opcode must agree.
// import "kab/aot/aot_verify_jne"; do not import other kab/aot* leaves.

pub fn aotVerifyJneOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "7500"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "54000001"
    }
    return false
}
