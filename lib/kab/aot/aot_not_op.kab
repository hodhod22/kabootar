// F10: first Kab-native images emit a documented not opcode for the return register.
// import "kab/aot/aot_not_op"; do not import other kab/aot* leaves.

pub fn aotNotOp(target) {
    if target == "x64" {
        return "f7d0"
    }
    if target == "arm64" {
        return "aa2003e0"
    }
    return ""
}
