// F10: first Kab-native images emit a documented jbe opcode for the return register.
// import "kab/aot/aot_jbe_op"; do not import other kab/aot* leaves.

pub fn aotJbeOp(target) {
    if target == "x64" {
        return "7600"
    }
    if target == "arm64" {
        return "54000009"
    }
    return ""
}
