// F10: native image filename and frame-exit epilogue must agree.
// import "kab/aot/aot_verify_frame_exit"; do not import other kab/aot* leaves.

pub fn aotVerifyFrameExitOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "c9"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "fd7bc1a8"
    }
    return false
}
