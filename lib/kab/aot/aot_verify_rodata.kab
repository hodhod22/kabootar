// F10: native image filename and R rodata payload must agree.
// import "kab/aot/aot_verify_rodata"; do not import other kab/aot* leaves.

pub fn aotVerifyRodataOk(name, rodata) {
    if name == "kabootar-x64.kbn" {
        return rodata == "rodata:r|00"
    }
    if name == "kabootar-arm64.kbn" {
        return rodata == "rodata:r|00"
    }
    return false
}
