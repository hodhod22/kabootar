// F10: verify the manifest and filename agree for a first Kab-native image.
// import "kab/aot/aot_verify_image"; do not import other kab/aot* leaves.

pub fn aotVerifyImageOk(name, manifest) {
    if name == "kabootar-x64.kbn" {
        return manifest == "kabootar-native/1|x64|text:rx|rodata:r|data:rw"
    }
    if name == "kabootar-arm64.kbn" {
        return manifest == "kabootar-native/1|arm64|text:rx|rodata:r|data:rw"
    }
    return false
}
