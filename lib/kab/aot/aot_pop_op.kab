// F10: first Kab-native images emit a documented pop-return-register opcode.
// import "kab/aot/aot_pop_op"; do not import other kab/aot* leaves.

pub fn aotPopOp(target) {
    if target == "x64" {
        return "58"
    }
    if target == "arm64" {
        return "e00741f8"
    }
    return ""
}
