// F10: native image filename and not opcode must agree.
// import "kab/aot/aot_verify_not"; do not import other kab/aot* leaves.

pub fn aotVerifyNotOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "f7d0"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "aa2003e0"
    }
    return false
}
