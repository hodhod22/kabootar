// F10: loader accepts only a documented first-image call opcode.
// import "kab/aot/aot_load_call"; do not import other kab/aot* leaves.

pub fn aotLoadCallOk(op, target) {
    if target == "x64" {
        return op == "e800000000"
    }
    if target == "arm64" {
        return op == "94000000"
    }
    return false
}
