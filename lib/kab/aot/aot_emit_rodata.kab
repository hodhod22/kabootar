// F10: first Kab-native rodata sections carry R plus a zero stub.
// import "kab/aot/aot_emit_rodata"; do not import other kab/aot* leaves.

pub fn aotEmitRodata(target) {
    if target == "x64" {
        return "rodata:r|00"
    }
    if target == "arm64" {
        return "rodata:r|00"
    }
    return ""
}
