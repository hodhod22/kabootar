// F10: R rodata is shippable only when name, payload, and target agree.
// import "kab/aot/aot_ship_rodata"; do not import other kab/aot* leaves.

pub fn aotShipRodataOk(name, rodata, target) {
    if target == "x64" {
        return name == "kabootar-x64.kbn" && rodata == "rodata:r|00"
    }
    if target == "arm64" {
        return name == "kabootar-arm64.kbn" && rodata == "rodata:r|00"
    }
    return false
}
