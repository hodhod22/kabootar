// F10: native image filename and call opcode must agree.
// import "kab/aot/aot_verify_call"; do not import other kab/aot* leaves.

pub fn aotVerifyCallOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "e800000000"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "94000000"
    }
    return false
}
