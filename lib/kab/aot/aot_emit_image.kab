// F10: emit a native image carrying text, rodata, and data relocation tables.
pub fn aotEmitImageWithRelocTableTextRodataData(target) {
    if target == "x64" {
        return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|syms:sym:text:0:_start:x64;sym:text:32:main:x64;sym:rodata:0:kstr:x64;sym:data:0:g0:x64|relocs:reloc:text:32:0:main:x64;reloc:text:32:8:main:x64;reloc:rodata:0:0:kstr:x64;reloc:data:0:0:g0:x64"
    }
    if target == "arm64" {
        return "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|syms:sym:text:0:_start:arm64;sym:text:32:main:arm64;sym:rodata:0:kstr:arm64;sym:data:0:g0:arm64|relocs:reloc:text:32:0:main:arm64;reloc:text:32:8:main:arm64;reloc:rodata:0:0:kstr:arm64;reloc:data:0:0:g0:arm64"
    }
