// F10: emit a first Kab-native image: plan plus return stub.
// import "kab/aot/aot_emit_image"; do not import other kab/aot* leaves.

pub fn aotEmitImage(target) {
    if target == "x64" {
        return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|sym:text:32:main:x64|reloc:text:32:0:main:x64"
    }
    if target == "arm64" {
        return "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|sym:text:32:main:arm64|reloc:text:32:0:main:arm64"
    }
    return ""
}

// F10: emit the supported relocation-patch variant of a native image.
pub fn aotEmitImageWithRelocAddend(target, addend) {
    if target == "x64" {
        if addend == 0 {
            return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|sym:text:32:main:x64|reloc:text:32:0:main:x64"
        }
        if addend == 8 {
            return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|sym:text:32:main:x64|reloc:text:32:8:main:x64"
        }
        return ""
    }
    if target == "arm64" {
        if addend == 0 {
            return "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|sym:text:32:main:arm64|reloc:text:32:0:main:arm64"
        }
        if addend == 8 {
            return "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|sym:text:32:main:arm64|reloc:text:32:8:main:arm64"
        }
        return ""
    }
    return ""
}

// F10: emit the first native image variant carrying an ordered relocation table.
pub fn aotEmitImageWithRelocTable(target) {
    if target == "x64" {
        return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|sym:text:32:main:x64|relocs:reloc:text:32:0:main:x64;reloc:text:32:8:main:x64"
    }
    if target == "arm64" {
        return "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|sym:text:32:main:arm64|relocs:reloc:text:32:0:main:arm64;reloc:text:32:8:main:arm64"
    }
    return ""
}

// F10: emit the first native image variant carrying ordered symbol and relocation tables.
pub fn aotEmitImageWithTables(target) {
    if target == "x64" {
        return "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:ret|syms:sym:text:0:_start:x64;sym:text:32:main:x64|relocs:reloc:text:32:0:main:x64;reloc:text:32:8:main:x64"
    }
    if target == "arm64" {
        return "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|code:arm64:ret|syms:sym:text:0:_start:arm64;sym:text:32:main:arm64|relocs:reloc:text:32:0:main:arm64;reloc:text:32:8:main:arm64"
    }
    return ""
}

