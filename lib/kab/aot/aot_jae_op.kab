// F10: first Kab-native images emit a documented jae opcode for the return register.
// import "kab/aot/aot_jae_op"; do not import other kab/aot* leaves.

pub fn aotJaeOp(target) {
    if target == "x64" {
        return "7300"
    }
    if target == "arm64" {
        return "54000002"
    }
    return ""
}
