// F10: first Kab-native images emit a documented call opcode for the return register.
// import "kab/aot/aot_call_op"; do not import other kab/aot* leaves.

pub fn aotCallOp(target) {
    if target == "x64" {
        return "e800000000"
    }
    if target == "arm64" {
        return "94000000"
    }
    return ""
}
