// F10: loader accepts only a documented first-image push opcode.
// import "kab/aot/aot_load_push"; do not import other kab/aot* leaves.

pub fn aotLoadPushOk(op, target) {
    if target == "x64" {
        return op == "50"
    }
    if target == "arm64" {
        return op == "e00f1ff8"
    }
    return false
}
