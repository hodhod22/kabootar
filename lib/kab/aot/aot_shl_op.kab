// F10: first Kab-native images emit a documented shl opcode for the return register.
// import "kab/aot/aot_shl_op"; do not import other kab/aot* leaves.

pub fn aotShlOp(target) {
    if target == "x64" {
        return "d1e0"
    }
    if target == "arm64" {
        return "d37ff800"
    }
    return ""
}
