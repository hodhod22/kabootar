// F10: first Kab-native images emit a documented or opcode for the return register.
// import "kab/aot/aot_or_op"; do not import other kab/aot* leaves.

pub fn aotOrOp(target) {
    if target == "x64" {
        return "09c0"
    }
    if target == "arm64" {
        return "aa000000"
    }
    return ""
}
