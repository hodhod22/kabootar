// F10: first Kab-native images emit a documented branch when the first frame local is nonzero.
// import "kab/aot/aot_branch_local_nonzero_op"; do not import other kab/aot* leaves.

pub fn aotBranchLocalNonzeroOp(target) {
    if target == "x64" {
        return "48837df8007500"
    }
    if target == "arm64" {
        return "a00b40f91f0000f154000001"
    }
    return ""
}
