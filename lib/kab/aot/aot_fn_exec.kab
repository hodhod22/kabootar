// SH28: exec legs for whole-function AOT — emit an op-array program via
// aot_fn_x64, wrap it in a kabootar-native/1 image (one sym per fn), run
// the bytes on the real CPU in-process, and compare rax against the Kab
// mirror interpreter over the SAME op array. import "kab/aot/aot_fn_exec"

import "kab/aot/aot_fn_x64"
import "kab/aot/aot_native"
import "kab/aot/aot_exec"
import "kab/aot/aot_gc"

/// Mirror: interpret fn `fi` of `fns` with args a1..a4 over the op array —
/// the reference semantics the emitted bytes must reproduce. i64 domain.
/// `gl` is the module-globals array (gload/gstore slots) shared across
/// calls; [] when the program has no data globals. `hp` is the shared
/// aot-tv1 heap — a PRE-SIZED qword array (push copies in Kab, so growth
/// would not propagate across calls); a tagged ptr encodes
/// qword-index*8|1 — the mirror's equivalent of the native bump-pointer
/// address in the data page.
/// GC root protocol, mirror side — copy globals + locals + the top
/// `nsp` stack values into the unified root area hp[0..rc) matching
/// the native spill layout: [globals 0..rb | locals rb..rb+nl |
/// stack rb+nl..rc). Returns {"hp","rc"} — hp is copied at call
/// boundaries so the mutated array must come back.
fn aotFnGcSpill(hp, gl, locals, st, rb, nsp) {
    let r = 0
    while r < rb {
        hp[r] = gl[r]
        r = r + 1
    }
    let nl = len(locals)
    let k = 0
    while k < nl {
        let lv = locals[k]
        if lv == undefined {
            lv = 0
        }
        hp[rb + k] = lv
        k = k + 1
    }
    let j = 0
    while j < nsp {
        hp[rb + nl + j] = st[len(st) - 1 - j]
        j = j + 1
    }
    return { "hp": hp, "rc": rb + nl + nsp }
}

/// GC root restore — copy the rewritten root area back into globals,
/// locals, and the top `nsp` stack slots (Kab copies arrays, so all
/// three return through the record).
fn aotFnGcRoots(hp, gl, locals, st, rb, nsp) {
    let r = 0
    while r < rb {
        gl[r] = hp[r]
        r = r + 1
    }
    let nl = len(locals)
    let k = 0
    while k < nl {
        locals[k] = hp[rb + k]
        k = k + 1
    }
    let j = 0
    while j < nsp {
        st[len(st) - 1 - j] = hp[rb + nl + j]
        j = j + 1
    }
    return { "gl": gl, "locals": locals, "st": st }
}

/// Public for GC/audit probes: run fn `fi` and get the mutated state
/// back — {v, gl, hp} since Kab copies arrays at call boundaries.
pub fn aotFnRunG(fns, fi, a1, a2, a3, a4, gl, hp, xs) {
    let f = fns[fi]
    let ops = f["ops"]
    let locals = []
    let i = 0
    while i < f["locals"] {
        locals = push(locals, 0)
        i = i + 1
    }
    if f["arity"] >= 1 {
        locals[0] = a1
    }
    if f["arity"] >= 2 {
        locals[1] = a2
    }
    if f["arity"] >= 3 {
        locals[2] = a3
    }
    if f["arity"] >= 4 {
        locals[3] = a4
    }
    // Stack-arg slots (calln/callv spill convention): caller extras
    // arrive in the rest array — local i≥4 takes xs[i-4].
    let xi = 0
    while xi < len(xs) && 4 + xi < f["locals"] {
        locals[4 + xi] = xs[xi]
        xi = xi + 1
    }
    let st = []
    let ip = 0
    while ip < len(ops) {
        let op = ops[ip]
        let name = op[0]
        if name == "const" {
            st = push(st, op[1])
        }
        if name == "load" {
            st = push(st, locals[op[1]])
        }
        if name == "store" {
            locals[op[1]] = st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
        }
        if name == "pop" {
            st = slice(st, 0, len(st) - 1)
        }
        if name == "dup" {
            let dtop = st[len(st) - 1]
            st = push(st, dtop)
        }
        if name == "swap" {
            let swa = st[len(st) - 1]
            st[len(st) - 1] = st[len(st) - 2]
            st[len(st) - 2] = swa
        }
        // aot-tv1 tagged ops — same bit-level semantics as the emitter.
        if name == "tag" {
            st[len(st) - 1] = st[len(st) - 1] * 2
        }
        if name == "untag" {
            st[len(st) - 1] = st[len(st) - 1] / 2
        }
        if name == "is_smi" {
            let sv = st[len(st) - 1]
            if sv - (sv / 2) * 2 == 0 {
                st[len(st) - 1] = 1
            } else {
                st[len(st) - 1] = 0
            }
        }
        if name == "tconst" || name == "tconst64" {
            st = push(st, op[1] * 2)
        }
        if name == "tnull" {
            st = push(st, 3)
        }
        if name == "tundef" {
            st = push(st, 11)
        }
        if name == "tfalse" {
            st = push(st, 19)
        }
        if name == "ttrue" {
            st = push(st, 27)
        }
        if name == "tadd" || name == "tsub" || name == "tmul" || name == "tdiv" || name == "tmod" {
            let tr = st[len(st) - 1]
            let tl = st[len(st) - 2]
            st = slice(st, 0, len(st) - 2)
            if name == "tadd" {
                st = push(st, tl + tr)
            }
            if name == "tsub" {
                st = push(st, tl - tr)
            }
            if name == "tmul" {
                st = push(st, tl * (tr / 2))
            }
            if name == "tdiv" {
                st = push(st, (tl / 2) / (tr / 2) * 2)
            }
            if name == "tmod" {
                st = push(st, (tl / 2) % (tr / 2) * 2)
            }
        }
        if name == "tneg" {
            st[len(st) - 1] = 0 - st[len(st) - 1]
        }
        // aot-tv1 bitwise: Kab's & | ^ ~ << >> >>> already carry the
        // JS i32 semantics the host VM implements (to_int32 on operands,
        // i32 result sign-extended to Number) — mirror: detag (÷2),
        // apply the Kab op, retag (×2). Non-SMI never reaches these
        // ops: the lowerer emits them only behind is_smi dispatch.
        if name == "tband" || name == "tbor" || name == "tbxor" || name == "tshl" || name == "tshr" || name == "tushr" {
            let br = st[len(st) - 1] / 2
            let bl = st[len(st) - 2] / 2
            st = slice(st, 0, len(st) - 2)
            if name == "tband" {
                st = push(st, (bl & br) * 2)
            }
            if name == "tbor" {
                st = push(st, (bl | br) * 2)
            }
            if name == "tbxor" {
                st = push(st, (bl ^ br) * 2)
            }
            if name == "tshl" {
                st = push(st, (bl << br) * 2)
            }
            if name == "tshr" {
                st = push(st, (bl >> br) * 2)
            }
            if name == "tushr" {
                st = push(st, (bl >>> br) * 2)
            }
        }
        if name == "tbnot" {
            st[len(st) - 1] = (~(st[len(st) - 1] / 2)) * 2
        }
        // aot-tv1 pow: detagged i64 loop matching the native op —
        // exp<0 throws (native ud2; host eval_pow would give Float,
        // no fpow op exists), i64 overflow and results past the SMI
        // range (|r| ≥ 2^62) throw the same way.
        if name == "tpow" {
            let pe = st[len(st) - 1] / 2
            let pb = st[len(st) - 2] / 2
            st = slice(st, 0, len(st) - 2)
            if pe < 0 {
                throw "aot-tv1 tpow: negative exponent"
            }
            let pr = 1
            let pi = 0
            while pi < pe {
                let pn = pr * pb
                if pb != 0 && pn / pb != pr {
                    throw "aot-tv1 tpow: i64 overflow"
                }
                pr = pn
                pi = pi + 1
            }
            if pr >= 4611686018427387904 || pr <= -4611686018427387904 {
                throw "aot-tv1 tpow: result out of SMI range"
            }
            st = push(st, pr * 2)
        }
        // aot-tv1 heap: hbase pushes the heap-start "address" (qword
        // index 0 — the native side emits r12 + ng*8); halloc bumps the
        // bump-pointer global by nw qwords and pushes the tagged ptr
        // (index*8|1); hload/hstore index hp in qwords.
        if name == "hbase" {
            // Heap start = qword slot op[1] in the unified data space
            // (native: r12+8*slot — same index semantics).
            st = push(st, op[1])
        }
        if name == "hlimit" {
            // Heap bound as a qword count from the data-space origin —
            // in bump units (native pushes r12+8n, an address).
            st = push(st, op[1])
        }
        if name == "halloc" {
            // ["halloc", bump, limit] — bound-checked bump: newtop over
            // the limit slot throws (native: ud2). Same check, same
            // operand meaning — the bump slot is a qword index here.
            let nw = st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
            let oldTop = gl[op[1]]
            if oldTop + nw > gl[op[2]] {
                throw "aot-tv1 halloc over heap limit"
            }
            gl[op[1]] = oldTop + nw
            st = push(st, oldTop * 8 + 1)
        }
        if name == "mkclo" {
            // ["mkclo", bump, limit, fi, ncap] — closure cell
            // [hdr=tag6<<16|(1+ncap) | fi(raw) | cap…]; caps popped
            // top-down like the native side.
            let mnc = op[4]
            let mto = gl[op[1]]
            if mto + 2 + mnc > gl[op[2]] {
                throw "aot-tv1 mkclo over heap limit"
            }
            gl[op[1]] = mto + 2 + mnc
            hp[mto] = 6 * 65536 + 1 + mnc
            hp[mto + 1] = op[3]
            let mk = mnc
            while mk > 0 {
                mk = mk - 1
                hp[mto + 2 + mk] = st[len(st) - 1]
                st = slice(st, 0, len(st) - 1)
            }
            st = push(st, mto * 8 + 1)
        }
        if name == "callv" {
            // ["callv", n, [fi…]] — callee cell on TOP (args pushed
            // first, callee last): pop the cell, then the args; the cell
            // lands in a1 (hidden arg0), params in a2..a4, extras (a4+)
            // go through the rest array like the native stack spill.
            let cn = op[1]
            let ccell = st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
            let cav = []
            let ck = 0
            while ck < cn {
                cav = push(cav, st[len(st) - 1])
                st = slice(st, 0, len(st) - 1)
                ck = ck + 1
            }
            if ccell % 2 == 0 {
                throw "aot-tv1 callv: callee is not a heap cell"
            }
            let cidx = hp[(ccell - 1) / 8 + 1]
            let cmatch = -1
            let cj = 0
            while cj < len(op[2]) {
                if op[2][cj] == cidx {
                    cmatch = cidx
                }
                cj = cj + 1
            }
            if cmatch < 0 {
                throw "aot-tv1 callv: closure fn index out of image"
            }
            // cav[k] = a_{n-k}: a1..a3 → named slots, a4..a_n → rest.
            let crest = []
            let ck2 = 0
            while ck2 < cn - 3 {
                crest = push(crest, cav[cn - 4 - ck2])
                ck2 = ck2 + 1
            }
            let ca1 = 0
            let ca2 = 0
            let ca3 = 0
            if cn > 0 {
                ca1 = cav[cn - 1]
            }
            if cn > 1 {
                ca2 = cav[cn - 2]
            }
            if cn > 2 {
                ca3 = cav[cn - 3]
            }
            let crr = aotFnRunG(fns, cmatch, ccell, ca1, ca2, ca3, gl, hp, crest)
            gl = crr["gl"]
            hp = crr["hp"]
            st = push(st, crr["v"])
        }
        if name == "calln" {
            // ["calln", fi, n, scr] — n>=5 direct call: pop args
            // top-down (cav[k]=a_{n-k}), first four into the named
            // slots, a5..a_n through the rest array.
            let cnn = op[2]
            let cnav = []
            let cnk = 0
            while cnk < cnn {
                cnav = push(cnav, st[len(st) - 1])
                st = slice(st, 0, len(st) - 1)
                cnk = cnk + 1
            }
            let cnrest = []
            let cnk2 = 0
            while cnk2 < cnn - 4 {
                cnrest = push(cnrest, cnav[cnn - 5 - cnk2])
                cnk2 = cnk2 + 1
            }
            let cnrr = aotFnRunG(fns, op[1], cnav[cnn - 1], cnav[cnn - 2], cnav[cnn - 3], cnav[cnn - 4], gl, hp, cnrest)
            gl = cnrr["gl"]
            hp = cnrr["hp"]
            st = push(st, cnrr["v"])
        }
        if name == "hcalloc" {
            // ["hcalloc", bump, limit, lo, rb, nspill] — bump-alloc with
            // collect-on-overflow: over the limit → spill roots + run
            // the synthesized collector + retry; still over → throw
            // (native: ud2). Contract identical to the native emit.
            let hnw = st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
            let hot = gl[op[1]]
            if hot + hnw <= gl[op[2]] {
                gl[op[1]] = hot + hnw
                st = push(st, hot * 8 + 1)
            } else {
                let hrc = aotFnGcSpill(hp, gl, locals, st, op[4], op[5])
                hp = hrc["hp"]
                let hrr = aotFnRunG([aotGcSynthFn()], 0, gl[op[1]], op[3], hrc["rc"], 0, [], hp, [])
                hp = hrr["hp"]
                let hnt = hrr["v"]
                let hback = aotFnGcRoots(hp, gl, locals, st, op[4], op[5])
                gl = hback["gl"]
                locals = hback["locals"]
                st = hback["st"]
                gl[op[1]] = hnt
                if hnt + hnw > gl[op[2]] {
                    throw "aot-tv1 hcalloc over heap limit after gc"
                }
                gl[op[1]] = hnt + hnw
                st = push(st, hnt * 8 + 1)
            }
        }
        if name == "gcollect" {
            // ["gcollect", bump, lo, rb, nspill] — the SAME algorithm
            // the native image runs: roots are copied into hp[0..rc)
            // (globals, then spilled locals, then the top nspill stack
            // values), the synthesized __gc_collect runs through
            // aotFnRunG on the identical op array the x64 emitter
            // emits (dbase=0 in index space), and rewritten roots are
            // copied back. bump is restored from the return value.
            let gsp = aotFnGcSpill(hp, gl, locals, st, op[3], op[4])
            hp = gsp["hp"]
            let gr2 = aotFnRunG([aotGcSynthFn()], 0, gl[op[1]], op[2], gsp["rc"], 0, [], hp, [])
            hp = gr2["hp"]
            let gback = aotFnGcRoots(hp, gl, locals, st, op[3], op[4])
            gl = gback["gl"]
            locals = gback["locals"]
            st = gback["st"]
            gl[op[1]] = gr2["v"]
        }
        if name == "hload" {
            let hp2 = st[len(st) - 1]
            st[len(st) - 1] = hp[(hp2 - 1) / 8 + op[1] / 8]
        }
        if name == "hstore" {
            let hv = st[len(st) - 1]
            let hp3 = st[len(st) - 2]
            st = slice(st, 0, len(st) - 2)
            hp[(hp3 - 1) / 8 + op[1] / 8] = hv
        }
        if name == "hloadx" {
            // [ptr, idx] → hp[(ptr-1)/8 + idx]
            let xi = st[len(st) - 1]
            let xp = st[len(st) - 2]
            st = slice(st, 0, len(st) - 2)
            st = push(st, hp[(xp - 1) / 8 + xi])
        }
        if name == "hstorex" {
            // [ptr, idx, val] → hp[(ptr-1)/8 + idx] = val
            let xv = st[len(st) - 1]
            let xi2 = st[len(st) - 2]
            let xp2 = st[len(st) - 3]
            st = slice(st, 0, len(st) - 3)
            hp[(xp2 - 1) / 8 + xi2] = xv
        }
        if name == "hlen" {
            // [ptr] → tagged len field of the header qword (lo16 << 1).
            let lp = st[len(st) - 1]
            st[len(st) - 1] = (hp[(lp - 1) / 8] % 65536) * 2
        }
        if name == "htag" {
            // [ptr] → tagged tag byte of the header ((hdr>>16)&0xFF << 1).
            let tp = st[len(st) - 1]
            st[len(st) - 1] = ((hp[(tp - 1) / 8] / 65536) % 256) * 2
        }
        if name == "hloadb" {
            // [ptr, bidx] → raw byte at ptr+8+bidx (payload is byte-serial
            // little-endian inside qwords).
            let bi = st[len(st) - 1]
            let bp = st[len(st) - 2]
            st = slice(st, 0, len(st) - 2)
            let qw = hp[(bp - 1) / 8 + 1 + bi / 8]
            let bsh = 1
            let bk = 0
            while bk < bi % 8 {
                bsh = bsh * 256
                bk = bk + 1
            }
            st = push(st, (qw / bsh) % 256)
        }
        if name == "hstoreb" {
            // [ptr, bidx, val] → hp qword at (ptr-1)/8+1+bidx/8 with byte
            // bidx%8 replaced by val&0xFF.
            let bv = st[len(st) - 1]
            let bi2 = st[len(st) - 2]
            let bp2 = st[len(st) - 3]
            st = slice(st, 0, len(st) - 3)
            let qi = (bp2 - 1) / 8 + 1 + bi2 / 8
            let bsh2 = 1
            let bk2 = 0
            while bk2 < bi2 % 8 {
                bsh2 = bsh2 * 256
                bk2 = bk2 + 1
            }
            let oldq = hp[qi]
            hp[qi] = oldq - ((oldq / bsh2) % 256) * bsh2 + (bv % 256) * bsh2
        }
        if name == "hkid" {
            // [strptr] → tagged kid (hdr >> 32, tagged). The str cell
            // header carries the interned member-key id in bits 32+.
            let kp = st[len(st) - 1]
            let kh = hp[(kp - 1) / 8]
            let kk = (kh - (kh % 4294967296)) / 4294967296
            st[len(st) - 1] = kk * 2
        }
        if name == "smk" {
            // ["smk", bump, limit, text, kid] — bound-checked alloc of
            // 1+ceil(len/8) qwords: hdr = kid<<32 | 4<<16 | len, payload
            // = char bytes packed LE per qword (same view hloadb reads;
            // byte lanes 6-7 are below f64 precision — comparisons use
            // kid, never payload bytes).
            let ss = op[3]
            let ssl = len(ss)
            let ssq = 1 + (ssl + 7) / 8
            let sst = gl[op[1]]
            if sst + ssq > gl[op[2]] {
                throw "aot-tv1 smk over heap limit"
            }
            gl[op[1]] = sst + ssq
            hp[sst] = op[4] * 4294967296 + 262144 + ssl
            let sbi = 0
            while sbi < ssl {
                let sqi = sst + 1 + (sbi - (sbi % 8)) / 8
                let sbsh = 1
                let sbk2 = 0
                while sbk2 < sbi % 8 {
                    sbsh = sbsh * 256
                    sbk2 = sbk2 + 1
                }
                hp[sqi] = hp[sqi] + (char_code_at(ss, sbi) % 256) * sbsh
                sbi = sbi + 1
            }
            st = push(st, sst * 8 + 1)
        }
        if name == "aget" {
            // [ptr, tidx] → element k=tidx/2 at qword (p-1)/8 + 1 + k.
            let ai = st[len(st) - 1]
            let ap = st[len(st) - 2]
            st = slice(st, 0, len(st) - 2)
            st = push(st, hp[(ap - 1) / 8 + 1 + ai / 2])
        }
        if name == "aset" {
            // [ptr, tidx, val] → element k=tidx/2; pushes [ptr, val] —
            // index_set pushes container+val (value semantics writeback).
            let av = st[len(st) - 1]
            let ai2 = st[len(st) - 2]
            let ap2 = st[len(st) - 3]
            st = slice(st, 0, len(st) - 3)
            hp[(ap2 - 1) / 8 + 1 + ai2 / 2] = av
            st = push(st, ap2)
            st = push(st, av)
        }
        if name == "const64" {
            st = push(st, op[1])
        }
        if name == "fmk" {
            // ["fmk", bump, limit, bits, fval] — bound-checked; mirror
            // keeps the Kab float in op[4] (Kab cannot reinterpret f64
            // bits); native stores op[3].
            let fo = gl[op[1]]
            if fo + 2 > gl[op[2]] {
                throw "aot-tv1 fmk over heap limit"
            }
            gl[op[1]] = fo + 2
            hp[fo] = 65537
            hp[fo + 1] = op[4]
            st = push(st, fo * 8 + 1)
        }
        if name == "fcast" {
            // ["fcast", bump, limit] — pop a tagged SMI, push a Float
            // cell (mirror keeps the Kab float v/2 in the payload).
            let fc = st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
            let ffo = gl[op[1]]
            if ffo + 2 > gl[op[2]] {
                throw "aot-tv1 fcast over heap limit"
            }
            gl[op[1]] = ffo + 2
            hp[ffo] = 65537
            hp[ffo + 1] = fc / 2
            st = push(st, ffo * 8 + 1)
        }
        if name == "fadd" || name == "fsub" || name == "fmul" || name == "fdiv" || name == "fmod" {
            // ["f<op>", bump, limit] — [lptr, rptr] → bound-checked new
            // float cell (lp OP rp) via the bump slot. fmod is Kab % —
            // truncating fmod, same as the roundsd-trunc emit.
            let fr = st[len(st) - 1]
            let fl = st[len(st) - 2]
            st = slice(st, 0, len(st) - 2)
            let flv = hp[(fl - 1) / 8 + 1]
            let frv = hp[(fr - 1) / 8 + 1]
            let fres = 0
            if name == "fadd" {
                fres = flv + frv
            }
            if name == "fsub" {
                fres = flv - frv
            }
            if name == "fmul" {
                fres = flv * frv
            }
            if name == "fdiv" {
                fres = flv / frv
            }
            if name == "fmod" {
                fres = flv % frv
            }
            let fo2 = gl[op[1]]
            if fo2 + 2 > gl[op[2]] {
                throw "aot-tv1 f<op> over heap limit"
            }
            gl[op[1]] = fo2 + 2
            hp[fo2] = 65537
            hp[fo2 + 1] = fres
            st = push(st, fo2 * 8 + 1)
        }
        if name == "feq" || name == "fne" || name == "flt" || name == "fle" || name == "fgt" || name == "fge" {
            let cr = st[len(st) - 1]
            let cl = st[len(st) - 2]
            st = slice(st, 0, len(st) - 2)
            let clv = hp[(cl - 1) / 8 + 1]
            let crv = hp[(cr - 1) / 8 + 1]
            let cres = 0
            if name == "feq" {
                if clv == crv {
                    cres = 1
                }
            }
            if name == "fne" {
                if clv != crv {
                    cres = 1
                }
            }
            if name == "flt" {
                if clv < crv {
                    cres = 1
                }
            }
            if name == "fle" {
                if clv <= crv {
                    cres = 1
                }
            }
            if name == "fgt" {
                if clv > crv {
                    cres = 1
                }
            }
            if name == "fge" {
                if clv >= crv {
                    cres = 1
                }
            }
            st = push(st, cres)
        }
        if name == "trap" {
            throw "aot-tv1 trap: operands out of domain"
        }
        if name == "acc_add" {
            locals[op[1]] = locals[op[1]] + st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
        }
        if name == "gload" {
            st = push(st, gl[op[1]])
        }
        if name == "gstore" {
            gl[op[1]] = st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
        }
        if name == "acc_add_g" {
            gl[op[1]] = gl[op[1]] + st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
        }
        if name == "add" || name == "sub" || name == "mul" || name == "div" || name == "mod" {
            let r = st[len(st) - 1]
            let l = st[len(st) - 2]
            st = slice(st, 0, len(st) - 2)
            if name == "add" {
                st = push(st, l + r)
            }
            if name == "sub" {
                st = push(st, l - r)
            }
            if name == "mul" {
                st = push(st, l * r)
            }
            if name == "div" {
                st = push(st, l / r)
            }
            if name == "mod" {
                st = push(st, l % r)
            }
        }
        if name == "neg" || name == "bit_not" || name == "not" {
            let u = st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
            if name == "neg" {
                st = push(st, 0 - u)
            }
            if name == "bit_not" {
                st = push(st, ~u)
            }
            if name == "not" {
                if u == 0 {
                    st = push(st, 1)
                } else {
                    st = push(st, 0)
                }
            }
        }
        if name == "lt" || name == "le" || name == "gt" || name == "ge" || name == "eq" || name == "ne" {
            let r2 = st[len(st) - 1]
            let l2 = st[len(st) - 2]
            st = slice(st, 0, len(st) - 2)
            let t = false
            if name == "lt" {
                t = l2 < r2
            }
            if name == "le" {
                t = l2 <= r2
            }
            if name == "gt" {
                t = l2 > r2
            }
            if name == "ge" {
                t = l2 >= r2
            }
            if name == "eq" {
                t = l2 == r2
            }
            if name == "ne" {
                t = l2 != r2
            }
            if t {
                st = push(st, 1)
            } else {
                st = push(st, 0)
            }
        }
        if name == "jmp" {
            ip = op[1]
        } else {
            if name == "jz" {
                let v = st[len(st) - 1]
                st = slice(st, 0, len(st) - 1)
                if v == 0 {
                    ip = op[1]
                } else {
                    ip = ip + 1
                }
            } else {
                if name == "jnz" || name == "jsmi" || name == "jnsmi" {
                    let v2 = st[len(st) - 1]
                    st = slice(st, 0, len(st) - 1)
                    let taken = false
                    if name == "jnz" {
                        if v2 != 0 {
                            taken = true
                        }
                    }
                    // bit0==0 → SMI (v - (v/2)*2 == 0 even for negatives)
                    let smi = v2 - (v2 / 2) * 2 == 0
                    if name == "jsmi" {
                        taken = smi
                    }
                    if name == "jnsmi" {
                        taken = smi == false
                    }
                    if taken {
                        ip = op[1]
                    } else {
                        ip = ip + 1
                    }
                } else {
                    // Every nested call returns {v, gl, hp} — Kab arrays
                    // copy at call boundaries, so callee heap/global
                    // mutations only propagate via the returned record.
                    if name == "call" {
                        let a = st[len(st) - 1]
                        st = slice(st, 0, len(st) - 1)
                        let r1 = aotFnRunG(fns, op[1], a, 0, 0, 0, gl, hp, [])
                        gl = r1["gl"]
                        hp = r1["hp"]
                        st = push(st, r1["v"])
                        ip = ip + 1
                    } else {
                        if name == "call0" {
                            let r0 = aotFnRunG(fns, op[1], 0, 0, 0, 0, gl, hp, [])
                            gl = r0["gl"]
                            hp = r0["hp"]
                            st = push(st, r0["v"])
                            ip = ip + 1
                        } else {
                            if name == "call2" {
                                let b2 = st[len(st) - 1]
                                let a2v = st[len(st) - 2]
                                st = slice(st, 0, len(st) - 2)
                                let r2 = aotFnRunG(fns, op[1], a2v, b2, 0, 0, gl, hp, [])
                                gl = r2["gl"]
                                hp = r2["hp"]
                                st = push(st, r2["v"])
                                ip = ip + 1
                            } else {
                                if name == "call3" {
                                    let c3 = st[len(st) - 1]
                                    let b3 = st[len(st) - 2]
                                    let a3v = st[len(st) - 3]
                                    st = slice(st, 0, len(st) - 3)
                                    let r3 = aotFnRunG(fns, op[1], a3v, b3, c3, 0, gl, hp, [])
                                    gl = r3["gl"]
                                    hp = r3["hp"]
                                    st = push(st, r3["v"])
                                    ip = ip + 1
                                } else {
                                    if name == "call4" {
                                        let d4 = st[len(st) - 1]
                                        let c4 = st[len(st) - 2]
                                        let b4 = st[len(st) - 3]
                                        let a4v = st[len(st) - 4]
                                        st = slice(st, 0, len(st) - 4)
                                        let r4 = aotFnRunG(fns, op[1], a4v, b4, c4, d4, gl, hp, [])
                                        gl = r4["gl"]
                                        hp = r4["hp"]
                                        st = push(st, r4["v"])
                                        ip = ip + 1
                                    } else {
                                        if name == "ret" {
                                            return { "v": st[len(st) - 1], "gl": gl, "hp": hp }
                                        }
                                        ip = ip + 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return { "v": 0, "gl": gl, "hp": hp }
}

/// Compatibility wrapper — no data globals.
fn aotFnRun(fns, fi, a1, a2) {
    return aotFnRunG(fns, fi, a1, a2, 0, 0, [], [], [])["v"]
}

/// Mirror of the entry fn: aotFnRunG(fns, 0, arg, 0, 0, 0, [], [], []).
/// aotFnRunG returns {v, gl, hp} — the mutated state arrays travel back
/// explicitly since Kab copies arrays at call boundaries.
pub fn aotFnMirror(fns, arg) {
    return aotFnRunG(fns, 0, arg, 0, 0, 0, [], [], [])["v"]
}

/// Mirror of the entry fn with `ng` zeroed module-global slots —
/// the gload/gstore reference semantics.
pub fn aotFnMirrorG(fns, arg, ng) {
    let gl = []
    let i = 0
    while i < ng {
        gl = push(gl, 0)
        i = i + 1
    }
    return aotFnRunG(fns, 0, arg, 0, 0, 0, gl, [], [])["v"]
}

/// Mirror of the entry fn with `ng` globals AND an `hq`-qword heap —
/// the hbase/halloc/hload/hstore reference semantics.
pub fn aotFnMirrorH(fns, arg, ng, hq) {
    let gl = []
    let i = 0
    while i < ng {
        gl = push(gl, 0)
        i = i + 1
    }
    let hp = []
    let j = 0
    while j < hq {
        hp = push(hp, 0)
        j = j + 1
    }
    return aotFnRunG(fns, 0, arg, 0, 0, 0, gl, hp, [])["v"]
}

/// State-returning mirror — the heap-audit/GC entry point: full
/// {v, gl, hp} after the entry fn (Kab copies arrays at call
/// boundaries, so the post-run heap must travel back explicitly).
pub fn aotFnMirrorHS(fns, arg, ng, hq) {
    let gl = []
    let i = 0
    while i < ng {
        gl = push(gl, 0)
        i = i + 1
    }
    let hp = []
    let j = 0
    while j < hq {
        hp = push(hp, 0)
        j = j + 1
    }
    return aotFnRunG(fns, 0, arg, 0, 0, 0, gl, hp, [])
}

/// kabootar-native/1 image for an emitted fn set — one sym per fn
/// (entry fn is _start at its own offset; callees get named syms).
pub fn aotFnImageEmit(fns) {
    let abi = aotNativeHostAbi()
    let r = aotX64EmitFns(fns, abi)
    let code = r["code"]
    if len(code) == 0 {
        return ""
    }
    let offs = r["fnOffs"]
    let syms = "syms:"
    let i = 0
    while i < len(fns) {
        let nm = fns[i]["name"]
        if i == 0 {
            nm = "_start"
        }
        syms = syms + "sym:text:" + offs[i] + ":" + nm + ":x64"
        if i + 1 < len(fns) {
            syms = syms + ";"
        }
        i = i + 1
    }
    return "kabootar-native/1|x64|abi:" + abi + "|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:" + aotHexEncode(code) + "|" + syms
}

/// Same image but with an image-carried `data_hex` payload — mapped RW
/// by the exec path and handed to the entry as ABI arg2 (the globals
/// base the emitted r12 convention reads). `data` is a byte array, e.g.
/// nglobals*8 zeros for module-global i64 slots.
pub fn aotFnImageEmitData(fns, data) {
    let image = aotFnImageEmit(fns)
    if image == "" || len(data) == 0 {
        return image
    }
    let abi = aotNativeHostAbi()
    let r = aotX64EmitFns(fns, abi)
    let code = r["code"]
    let offs = r["fnOffs"]
    let syms = "syms:"
    let i = 0
    while i < len(fns) {
        let nm = fns[i]["name"]
        if i == 0 {
            nm = "_start"
        }
        syms = syms + "sym:text:" + offs[i] + ":" + nm + ":x64"
        if i + 1 < len(fns) {
            syms = syms + ";"
        }
        i = i + 1
    }
    return "kabootar-native/1|x64|abi:" + abi + "|entry:0|page:4096|text:rx|rodata:r|data:rw|data_hex:" + aotHexEncode(data) + "|code:x64:" + aotHexEncode(code) + "|" + syms
}

/// In-process native leg: emit → wrap → persist → reload → decode →
/// os_native_exec(code, arg) on the real CPU; rax must equal the Kab
/// mirror over the same ops.
pub fn aotFnExecOk(path, fns, arg) {
    let image = aotFnImageEmit(fns)
    if image == "" {
        return false
    }
    os_write(path, image)
    let back = os_read(path)
    if back != image {
        return false
    }
    let bytes = aotEntryCodeBytes(back)
    let abi = aotNativeHostAbi()
    let r = aotX64EmitFns(fns, abi)
    if len(bytes) != r["total"] {
        return false
    }
    return os_native_exec(bytes, arg) == aotFnMirror(fns, arg)
}
