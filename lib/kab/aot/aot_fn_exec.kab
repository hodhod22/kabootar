// SH28: exec legs for whole-function AOT — emit an op-array program via
// aot_fn_x64, wrap it in a kabootar-native/1 image (one sym per fn), run
// the bytes on the real CPU in-process, and compare rax against the Kab
// mirror interpreter over the SAME op array. import "kab/aot/aot_fn_exec"

import "kab/aot/aot_fn_x64"
import "kab/aot/aot_native"
import "kab/aot/aot_exec"

/// Mirror: interpret fn `fi` of `fns` with args a1..a4 over the op array —
/// the reference semantics the emitted bytes must reproduce. i64 domain.
/// `gl` is the module-globals array (gload/gstore slots) shared across
/// calls; [] when the program has no data globals.
fn aotFnRunG(fns, fi, a1, a2, a3, a4, gl) {
    let f = fns[fi]
    let ops = f["ops"]
    let locals = []
    let i = 0
    while i < f["locals"] {
        locals = push(locals, 0)
        i = i + 1
    }
    if f["arity"] >= 1 {
        locals[0] = a1
    }
    if f["arity"] >= 2 {
        locals[1] = a2
    }
    if f["arity"] >= 3 {
        locals[2] = a3
    }
    if f["arity"] >= 4 {
        locals[3] = a4
    }
    let st = []
    let ip = 0
    while ip < len(ops) {
        let op = ops[ip]
        let name = op[0]
        if name == "const" {
            st = push(st, op[1])
        }
        if name == "load" {
            st = push(st, locals[op[1]])
        }
        if name == "store" {
            locals[op[1]] = st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
        }
        if name == "pop" {
            st = slice(st, 0, len(st) - 1)
        }
        if name == "acc_add" {
            locals[op[1]] = locals[op[1]] + st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
        }
        if name == "gload" {
            st = push(st, gl[op[1]])
        }
        if name == "gstore" {
            gl[op[1]] = st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
        }
        if name == "acc_add_g" {
            gl[op[1]] = gl[op[1]] + st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
        }
        if name == "add" || name == "sub" || name == "mul" || name == "div" || name == "mod" {
            let r = st[len(st) - 1]
            let l = st[len(st) - 2]
            st = slice(st, 0, len(st) - 2)
            if name == "add" {
                st = push(st, l + r)
            }
            if name == "sub" {
                st = push(st, l - r)
            }
            if name == "mul" {
                st = push(st, l * r)
            }
            if name == "div" {
                st = push(st, l / r)
            }
            if name == "mod" {
                st = push(st, l % r)
            }
        }
        if name == "neg" || name == "bit_not" || name == "not" {
            let u = st[len(st) - 1]
            st = slice(st, 0, len(st) - 1)
            if name == "neg" {
                st = push(st, 0 - u)
            }
            if name == "bit_not" {
                st = push(st, ~u)
            }
            if name == "not" {
                if u == 0 {
                    st = push(st, 1)
                } else {
                    st = push(st, 0)
                }
            }
        }
        if name == "lt" || name == "le" || name == "gt" || name == "ge" || name == "eq" || name == "ne" {
            let r2 = st[len(st) - 1]
            let l2 = st[len(st) - 2]
            st = slice(st, 0, len(st) - 2)
            let t = false
            if name == "lt" {
                t = l2 < r2
            }
            if name == "le" {
                t = l2 <= r2
            }
            if name == "gt" {
                t = l2 > r2
            }
            if name == "ge" {
                t = l2 >= r2
            }
            if name == "eq" {
                t = l2 == r2
            }
            if name == "ne" {
                t = l2 != r2
            }
            if t {
                st = push(st, 1)
            } else {
                st = push(st, 0)
            }
        }
        if name == "jmp" {
            ip = op[1]
        } else {
            if name == "jz" {
                let v = st[len(st) - 1]
                st = slice(st, 0, len(st) - 1)
                if v == 0 {
                    ip = op[1]
                } else {
                    ip = ip + 1
                }
            } else {
                if name == "jnz" {
                    let v2 = st[len(st) - 1]
                    st = slice(st, 0, len(st) - 1)
                    if v2 != 0 {
                        ip = op[1]
                    } else {
                        ip = ip + 1
                    }
                } else {
                    if name == "call" {
                        let a = st[len(st) - 1]
                        st = slice(st, 0, len(st) - 1)
                        st = push(st, aotFnRunG(fns, op[1], a, 0, 0, 0, gl))
                        ip = ip + 1
                    } else {
                        if name == "call0" {
                            st = push(st, aotFnRunG(fns, op[1], 0, 0, 0, 0, gl))
                            ip = ip + 1
                        } else {
                            if name == "call2" {
                                let b2 = st[len(st) - 1]
                                let a2v = st[len(st) - 2]
                                st = slice(st, 0, len(st) - 2)
                                st = push(st, aotFnRunG(fns, op[1], a2v, b2, 0, 0, gl))
                                ip = ip + 1
                            } else {
                                if name == "call3" {
                                    let c3 = st[len(st) - 1]
                                    let b3 = st[len(st) - 2]
                                    let a3v = st[len(st) - 3]
                                    st = slice(st, 0, len(st) - 3)
                                    st = push(st, aotFnRunG(fns, op[1], a3v, b3, c3, 0, gl))
                                    ip = ip + 1
                                } else {
                                    if name == "call4" {
                                        let d4 = st[len(st) - 1]
                                        let c4 = st[len(st) - 2]
                                        let b4 = st[len(st) - 3]
                                        let a4v = st[len(st) - 4]
                                        st = slice(st, 0, len(st) - 4)
                                        st = push(st, aotFnRunG(fns, op[1], a4v, b4, c4, d4, gl))
                                        ip = ip + 1
                                    } else {
                                        if name == "ret" {
                                            return st[len(st) - 1]
                                        }
                                        ip = ip + 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return 0
}

/// Compatibility wrapper — no data globals.
fn aotFnRun(fns, fi, a1, a2) {
    return aotFnRunG(fns, fi, a1, a2, 0, 0, [])
}

/// Mirror of the entry fn: aotFnRunG(fns, 0, arg, 0, 0, 0, []).
pub fn aotFnMirror(fns, arg) {
    return aotFnRunG(fns, 0, arg, 0, 0, 0, [])
}

/// Mirror of the entry fn with `ng` zeroed module-global slots —
/// the gload/gstore reference semantics.
pub fn aotFnMirrorG(fns, arg, ng) {
    let gl = []
    let i = 0
    while i < ng {
        gl = push(gl, 0)
        i = i + 1
    }
    return aotFnRunG(fns, 0, arg, 0, 0, 0, gl)
}

/// kabootar-native/1 image for an emitted fn set — one sym per fn
/// (entry fn is _start at its own offset; callees get named syms).
pub fn aotFnImageEmit(fns) {
    let abi = aotNativeHostAbi()
    let r = aotX64EmitFns(fns, abi)
    let code = r["code"]
    if len(code) == 0 {
        return ""
    }
    let offs = r["fnOffs"]
    let syms = "syms:"
    let i = 0
    while i < len(fns) {
        let nm = fns[i]["name"]
        if i == 0 {
            nm = "_start"
        }
        syms = syms + "sym:text:" + offs[i] + ":" + nm + ":x64"
        if i + 1 < len(fns) {
            syms = syms + ";"
        }
        i = i + 1
    }
    return "kabootar-native/1|x64|abi:" + abi + "|entry:0|page:4096|text:rx|rodata:r|data:rw|code:x64:" + aotHexEncode(code) + "|" + syms
}

/// Same image but with an image-carried `data_hex` payload — mapped RW
/// by the exec path and handed to the entry as ABI arg2 (the globals
/// base the emitted r12 convention reads). `data` is a byte array, e.g.
/// nglobals*8 zeros for module-global i64 slots.
pub fn aotFnImageEmitData(fns, data) {
    let image = aotFnImageEmit(fns)
    if image == "" || len(data) == 0 {
        return image
    }
    let abi = aotNativeHostAbi()
    let r = aotX64EmitFns(fns, abi)
    let code = r["code"]
    let offs = r["fnOffs"]
    let syms = "syms:"
    let i = 0
    while i < len(fns) {
        let nm = fns[i]["name"]
        if i == 0 {
            nm = "_start"
        }
        syms = syms + "sym:text:" + offs[i] + ":" + nm + ":x64"
        if i + 1 < len(fns) {
            syms = syms + ";"
        }
        i = i + 1
    }
    return "kabootar-native/1|x64|abi:" + abi + "|entry:0|page:4096|text:rx|rodata:r|data:rw|data_hex:" + aotHexEncode(data) + "|code:x64:" + aotHexEncode(code) + "|" + syms
}

/// In-process native leg: emit → wrap → persist → reload → decode →
/// os_native_exec(code, arg) on the real CPU; rax must equal the Kab
/// mirror over the same ops.
pub fn aotFnExecOk(path, fns, arg) {
    let image = aotFnImageEmit(fns)
    if image == "" {
        return false
    }
    os_write(path, image)
    let back = os_read(path)
    if back != image {
        return false
    }
    let bytes = aotEntryCodeBytes(back)
    let abi = aotNativeHostAbi()
    let r = aotX64EmitFns(fns, abi)
    if len(bytes) != r["total"] {
        return false
    }
    return os_native_exec(bytes, arg) == aotFnMirror(fns, arg)
}
