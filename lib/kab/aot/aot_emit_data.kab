// F10: first Kab-native data sections carry RW plus a zero stub.
// import "kab/aot/aot_emit_data"; do not import other kab/aot* leaves.

pub fn aotEmitData(target) {
    if target == "x64" {
        return "data:rw|00"
    }
    if target == "arm64" {
        return "data:rw|00"
    }
    return ""
}
