// F10: native image filename and frame-local store must agree.
// import "kab/aot/aot_verify_store_local"; do not import other kab/aot* leaves.

pub fn aotVerifyStoreLocalOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "488945f8"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "a00b00f9"
    }
    return false
}
