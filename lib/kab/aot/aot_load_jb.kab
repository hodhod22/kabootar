// F10: loader accepts only a documented first-image jb opcode.
// import "kab/aot/aot_load_jb"; do not import other kab/aot* leaves.

pub fn aotLoadJbOk(op, target) {
    if target == "x64" {
        return op == "7200"
    }
    if target == "arm64" {
        return op == "54000003"
    }
    return false
}
