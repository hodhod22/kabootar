// SH17 deepen: translate+store for loop-mod template. import "kab/jit_wr_loop_mod"
// Do not grow jit_wr_loop_div.kab.

import "kab/jit_patch_loop_mod"
import "kab/jit_mm_loop_mod"
import "kab/jit_mm_store_loop_mod"
import "kab/jit_loop_mod"

pub fn jitWrLoopModOk(bytes, n, r) {
    if jitPatchLoopModOk(bytes, n, r) == false {
        return false
    }
    let pid = jitMmLoopModPid()
    let virt = jitMmLoopModVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopMod(bytes, n, r)
    if w != jitLoopModLen() {
        return false
    }
    return true
}
