// SH21: path basename leaf off os_join.kab. import "kab/os/os_base"
// Do not grow os_join.kab. kabOsHostDeleteOk stays false.

pub fn kabOsBase(path) {
    let n = len(path)
    if n < 1 {
        return path
    }
    let i = n
    while i > 0 {
        i = i - 1
        let ch = str_slice(path, i, i + 1)
        if ch == "/" {
            return str_slice(path, i + 1, n)
        }
    }
    return path
}
