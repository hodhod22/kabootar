// SH21: path norm leaf off os_dn.kab. import "kab/os_norm"
// Do not grow os_dn.kab. kabOsHostDeleteOk stays false.

pub fn kabOsNorm(path) {
    let n = len(path)
    let out = ""
    let prev = ""
    let i = 0
    while i < n {
        let ch = str_slice(path, i, i + 1)
        if ch == "/" {
            if prev != "/" {
                out = out + ch
            }
        }
        if ch != "/" {
            out = out + ch
        }
        prev = ch
        i = i + 1
    }
    return out
}
