// SH20: collections column off std_colrow.kab. import "kab/std_colcol"
// Do not grow std_colrow.kab. stdHostDeleteOk stays false.

pub fn stdColCol(rows, c) {
    let n = len(rows)
    let out = []
    if c < 0 {
        return out
    }
    let i = 0
    while i < n {
        let row = rows[i]
        let w = len(row)
        if c < w {
            out = push(out, row[c])
        }
        i = i + 1
    }
    return out
}
