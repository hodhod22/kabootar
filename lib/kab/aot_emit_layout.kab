// F10: first native layouts concatenate RX one-add-sub-mul-div-and-or-shl-shr-not-xor-neg-cmp-test-je-jne-jl-jle-jg-jge-ja-jae-jb-jbe-js-jns-nop-ret text, R rodata, and RW data.
// import "kab/aot_emit_layout"; do not import other kab/aot* leaves.

pub fn aotEmitLayout(target) {
    if target == "x64" {
        return "text:rx|b80100000001c029c00fafc0f7f821c009c0d1e0d1e8f7d033c0f7d839c085c0740075007c007e007f007d007700730072007600780079007a007b0070007100e90000000050584883ec104883c4104889d84889c3554889e5e80000000090488945f8488345f801488345f8ff48837df80048837df800740048837df8007500488b45f8c9c3||rodata:r|00||data:rw|00"
    }
    if target == "arm64" {
        return "text:rx|||rodata:r|00||data:rw|00"
    }
    return ""
}
