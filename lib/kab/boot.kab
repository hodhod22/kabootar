@version "1.0.0"

// H6e: language bootstrap / compile policy in Kab. import "kab/boot"
// Rust remains the process loader + VM; product compile policy prefers self_host.
// KEEP <=~8 top-level fn (policy lives here; loader only mirrors).

import "self_host/compile"
import "self_host/lexer"
import "self_host/lexer_defs"

let preferSelfHost = true

pub fn preferSelfHostCompile() {
    preferSelfHost = true
    return true
}

pub fn selfHostPreferred() {
    return preferSelfHost
}

/// Self-hosted lexer entry (Kabootar source → tokens).
pub fn bootTokenize(source) {
    return tokenize(source)
}

/// Self-hosted compile entry (Kabootar source → .kbc text).
pub fn bootCompile(source) {
    return compile(source)
}

/// True when text starts with the committed .kbc header (not a 3-char prefix).
pub fn isBytecode(kbc) {
    let s = "" + kbc
    if len(s) < 18 {
        return false
    }
    return str_index_of(s, "kabootar-bytecode/1") == 0
}

/// Compile source and check that the result looks like committed .kbc.
pub fn bootCompileAndCheck(source) {
    let kbc = bootCompile(source)
    return isBytecode(kbc) && len("" + kbc) > 20
}

/// Canonical bootstrap probe: tokenize + compile sample → valid .kbc.
pub fn bootPipelineOk() {
    let src = "let n = 10" + CHAR_NL + "return n + 32"
    let toks = bootTokenize(src)
    let kbc = bootCompile(src)
    return preferSelfHost && len(toks) > 3 && isBytecode(kbc) && len(kbc) > 30
}

/// H6e compile-attempt policy (loader mirrors: skip-list empty, 64KiB source cap).
/// `shouldSelfHost`: `a` is source length (path unused while skip-list is empty).
pub fn bootPolicy(key, a) {
    if key == "skip" {
        return "attempt-all"
    }
    if key == "maxBytes" {
        return 65536
    }
    if key == "prefer" {
        return "self-host-only"
    }
    if key == "appRustFallback" {
        return false
    }
    if key == "shouldSelfHost" {
        if a <= 0 {
            return false
        }
        if a > 65536 {
            return false
        }
        return true
    }
    return null
}
