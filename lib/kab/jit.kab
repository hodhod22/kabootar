/// Simple pow function (simplified for constant powers)
pub fn jitEmitI64PowRet() {
    let b = []
    b = push(b, 72)  // Placeholder for pow implementation
    b = push(b, 199)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 195) // ret
    return b
}

/// mov rax, [rsp+offset]; mov [rsp+offset], 0; ret  — take local then return.
pub fn jitEmitI64TakeLocalRet(offset) {
    let b = []
    b = push(b, 72)  // mov rax, [rsp+offset] (placeholder)
    b = push(b, 137)
    b = push(b, 72)  // mov [rsp+offset], 0 (placeholder)
    b = push(b, 133)
    b = push(b, 195) // ret
    return b
}

/// mov rax, [global+offset]; mov [global+offset], 0; ret  — take global then return.
