/// cmp rax, rbx; sete al; movzx eax, al; ret  — i64 eq then return.
pub fn jitEmitI64EqRet() {
    let b = []
    b = push(b, 72)  // cmp rax, rbx
    b = push(b, 61)
    b = push(b, 199)
    b = push(b, 15)  // sete al
    b = push(b, 148)
    b = push(b, 192)
    b = push(b, 15)  // movzx eax, al
    b = push(b, 184)
    b = push(b, 192)
    b = push(b, 195) // ret
    return b
}

