    let b = []
    b = push(b, 72)  // mov rax, [global+offset] (placeholder)
    b = push(b, 137)
    b = push(b, 72)  // mov [global+offset], 0 (placeholder)
    b = push(b, 137)
    b = push(b, 195) // ret
    return b
}

/// rwx map kind; guest mmap args live in kab/jit/jit_mm (os_mm_mmap deepen).
pub fn jitMapKind() {
    return "rwx"
}

pub fn jitIncLen() {
    return 6
}

pub fn jitOpLen(name) {
    if name == "acc_add_local" {
        return 6
    }
    if name == "add" {
        return 3
    }
    if name == "sub" {
        return 3
    }
    if name == "mul" {
        return 3
    }
    if name == "div" {
        return 5
    }
    if name == "mod" {
        return 5
    }
    if name == "const" {
        return 10
    }
    if name == "load_local" {
        return 10
    }
    if name == "store_local" {
        return 10
    }
    if name == "load_global" {
        return 10
    }
    if name == "store_global" {
        return 10
    }
    if name == "ret" {
        return 1
    }
    if name == "neg" {
        return 3
    }
    if name == "eq" {
        return 4
    }
    if name == "ne" {
        return 4
    }
    if name == "lt" {
        return 4
    }
    if name == "gt" {
        return 4
    }
    if name == "le" {
        return 4
    }
    if name == "ge" {
        return 4
    }
    if name == "and" {
        return 4
    }
    if name == "or" {
        return 4
    }
    if name == "not" {
        return 3
    }
    if name == "pop" {
        return 1
    }
    if name == "dup" {
        return 2
    }
    if name == "bit_and" {
        return 3
    }
    if name == "bit_or" {
        return 3
    }
    if name == "bit_xor" {
        return 3
    }
    if name == "shl" {
        return 3
    }
    if name == "shr" {
        return 3
    }
    if name == "bit_not" {
        return 3
    }
    if name == "pow" {
        return 20
    }
    if name == "take_local" {
        return 10
    }
    if name == "take_global" {
        return 10
    }
    return 0
}

pub fn jitEmitOp(name) {
    if name == "acc_add_local" {
        return jitEmitI64IncRet()
    }
    if name == "add" {
        return jitEmitI64AddRet()
    }
    if name == "sub" {
        return jitEmitI64SubRet()
    }
    if name == "mul" {
        return jitEmitI64MulRet()
    }
    if name == "div" {
        return jitEmitI64DivRet()
    }
    if name == "mod" {
        return jitEmitI64ModRet()
    }
    if name == "const" {
        return jitEmitI64ConstRet(0)
    }
    if name == "load_local" {
        return jitEmitI64LoadLocalRet(0)
    }
    if name == "store_local" {
        return jitEmitI64StoreLocalRet(0)
    }
    if name == "load_global" {
        return jitEmitI64LoadGlobalRet(0)
    }
    if name == "store_global" {
        return jitEmitI64StoreGlobalRet(0)
    }
    if name == "ret" {
        return jitEmitRet()
    }
    if name == "neg" {
        return jitEmitI64NegRet()
    }
    if name == "eq" {
        return jitEmitI64EqRet()
    }
    if name == "ne" {
        return jitEmitI64NeRet()
    }
    if name == "lt" {
        return jitEmitI64LtRet()
    }
    if name == "gt" {
        return jitEmitI64GtRet()
    }
    if name == "le" {
        return jitEmitI64LeRet()
    }
    if name == "ge" {
        return jitEmitI64GeRet()
    }
    if name == "and" {
        return jitEmitI64AndRet()
    }
    if name == "or" {
        return jitEmitI64OrRet()
    }
    if name == "not" {
        return jitEmitI64NotRet()
    }
    if name == "pop" {
        return jitEmitPop()
    }
    if name == "dup" {
        return jitEmitDup()
    }
    if name == "bit_and" {
        return jitEmitI64BitAndRet()
    }
    if name == "bit_or" {
        return jitEmitI64BitOrRet()
    }
    if name == "bit_xor" {
        return jitEmitI64BitXorRet()
    }
    if name == "shl" {
        return jitEmitI64ShlRet()
    }
    if name == "shr" {
        return jitEmitI64ShrRet()
    }
    if name == "bit_not" {
        return jitEmitI64BitNotRet()
    }
    if name == "pow" {
        return jitEmitI64PowRet()
    }
    if name == "take_local" {
        return jitEmitI64TakeLocalRet(0)
    }
    if name == "take_global" {
        return jitEmitI64TakeGlobalRet(0)
    }
    return []
}
