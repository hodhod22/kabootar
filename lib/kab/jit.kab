// SH17: x64 i64 JIT planner stubs.
// import "kab/jit"

let X64_RET = 195

// acc_add_local op is the canonical i64 loop seed.
/// True only for a non-empty array of op-name strings (legality lives in
/// jit_from_ops; this gate rejects garbage before planning).
pub fn jitCanCompile(ops) {
    if typeof(ops) != "array" {
        return false
    }
    if len(ops) <= 0 {
        return false
    }
    let i = 0
    while i < len(ops) {
        if typeof(ops[i]) != "string" {
            return false
        }
        i = i + 1
    }
    return true
}

pub fn jitGprCount() {
    return 16
}

pub fn jitMapKind(kind) {
    return kind
}

pub fn jitIncLen() {
    return 6
}

pub fn jitThreshold() {
    return 8
}

pub fn jitEmitRet(out) {
    return push(out, X64_RET)
}

/// xor eax,eax; add eax,1; ret — the 6-byte guest inc+ret the MMU executes.
pub fn jitEmitI64IncRet() {
    let t = []
    t = push(t, 49)
    t = push(t, 192)
    t = push(t, 131)
    t = push(t, 192)
    t = push(t, 1)
    return jitEmitRet(t)
}
