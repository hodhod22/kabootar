// SH17: Kab JIT subset. import "kab/jit"
// x64 templates (bytes). Map policy is rwx; host mmap/exec is still a deepen.

pub fn jitGprCount(nLocals) {
    return nLocals + 1
}

pub fn jitCanCompile(ops) {
    // Accept both string and array for compatibility
    if len(ops) > 0 {
        return true
    }
    return false
}

pub fn jitOpOk(name) {
    if name == "acc_add_local" {
        return true
    }
    if name == "add" {
        return true
    }
    if name == "sub" {
        return true
    }
    if name == "mul" {
        return true
    }
    if name == "div" {
        return true
    }
    if name == "mod" {
        return true
    }
    if name == "const" {
        return true
    }
    if name == "load_local" {
        return true
    }
    if name == "store_local" {
        return true
    }
    if name == "load_global" {
        return true
    }
    if name == "store_global" {
        return true
    }
    if name == "ret" {
        return true
    }
    if name == "neg" {
        return true
    }
    if name == "eq" {
        return true
    }
    if name == "ne" {
        return true
    }
    if name == "lt" {
        return true
    }
    if name == "gt" {
        return true
    }
    if name == "le" {
        return true
    }
    if name == "ge" {
        return true
    }
    if name == "and" {
        return true
    }
    if name == "or" {
        return true
    }
    if name == "not" {
        return true
    }
    if name == "pop" {
        return true
    }
    if name == "dup" {
        return true
    }
    if name == "bit_and" {
        return true
    }
    if name == "bit_or" {
        return true
    }
    if name == "bit_xor" {
        return true
    }
    if name == "shl" {
        return true
    }
    if name == "shr" {
        return true
    }
    if name == "bit_not" {
        return true
    }
    if name == "pow" {
        return true
    }
    if name == "take_local" {
        return true
    }
    if name == "take_global" {
        return true
    }
    return false
}

pub fn jitThreshold() {
    return 8
}

pub fn jitEmitRet() {
    let b = []
    b = push(b, 195)
    return b
}

/// xor eax,eax; add eax,1; ret  — i64 AccAdd +1 then return.
pub fn jitEmitI64IncRet() {
    let b = []
    b = push(b, 49)
    b = push(b, 192)
    b = push(b, 131)
    b = push(b, 192)
    b = push(b, 1)
    b = push(b, 195)
    return b
}

/// add rax, rbx; ret  — i64 Add then return.
pub fn jitEmitI64AddRet() {
    let b = []
    b = push(b, 72)  // add rax, rbx
    b = push(b, 219)
    b = push(b, 195) // ret
    return b
}

