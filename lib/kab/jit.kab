    b = push(b, 72)  // idiv rbx
    b = push(b, 247)
    b = push(b, 243)
    b = push(b, 72)  // mov rax, rdx (remainder)
    b = push(b, 137)
    b = push(b, 210)
    b = push(b, 195) // ret
    return b
}

