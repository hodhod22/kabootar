/// cqo; idiv rbx; ret  — i64 Div then return.
pub fn jitEmitI64DivRet() {
    let b = []
    b = push(b, 153) // cqo
    b = push(b, 247)
    b = push(b, 247) // idiv rbx
    b = push(b, 211)
    b = push(b, 195) // ret
    return b
}

