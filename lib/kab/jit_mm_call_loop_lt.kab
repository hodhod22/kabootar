// SH17 deepen: guest call for loop-lt template. import "kab/jit_mm_call_loop_lt"
// Do not grow jit_mm_call_loop_ne.kab.

import "kab/jit_mm_loop_lt"
import "kab/jit_loop_lt"

pub fn jitMmCallLoopLt(bytes, n, k) {
    if jitLoopLtOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopLtLen() {
        return 0
    }
    let pid = jitMmLoopLtPid()
    let virt = jitMmLoopLtVirt()
    let rax = os_mm_call(pid, virt)
    if rax != jitLoopLtRax(n, k) {
        return 0
    }
    return rax
}
