// SH20: collections acosh off std_colasinh.kab. import "kab/std_colacosh"
// Do not grow std_colasinh.kab. stdHostDeleteOk stays false.

pub fn stdColAcosh(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, acosh(a[i]))
        i = i + 1
    }
    return out
}
