// SH17 deepen: translate+store for loop-nop template. import "kab/jit_wr_loop_nop"
// Do not grow jit_wr_loop_jge.kab.

import "kab/jit_patch_loop_nop"
import "kab/jit_mm_loop_nop"
import "kab/jit_mm_store_loop_nop"
import "kab/jit_loop_nop"

pub fn jitWrLoopNopOk(bytes, n, k) {
    if jitPatchLoopNopOk(bytes, n, k) == false {
        return false
    }
    let pid = jitMmLoopNopPid()
    let virt = jitMmLoopNopVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopNop(bytes, n, k)
    if w != jitLoopNopLen() {
        return false
    }
    return true
}
