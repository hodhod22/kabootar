// SH17 deepen: guest store for loop-ne template. import "kab/jit_mm_store_loop_ne"
// Do not grow jit_mm_store_loop_eq.kab.

import "kab/jit_mm_loop_ne"
import "kab/jit_loop_ne"

pub fn jitMmStoreLoopNe(bytes, n, k) {
    if jitLoopNeOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopNeLen() {
        return 0
    }
    let pid = jitMmLoopNePid()
    let virt = jitMmLoopNeVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
