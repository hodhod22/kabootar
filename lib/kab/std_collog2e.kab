// SH20: collections log2e off std_colln10.kab. import "kab/std_collog2e"
// Do not grow std_colln10.kab. stdHostDeleteOk stays false.

pub fn stdColLog2e(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, log2e())
        i = i + 1
    }
    return out
}
