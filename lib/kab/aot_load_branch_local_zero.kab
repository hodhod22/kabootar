// F10: loader accepts only a documented first-image local-zero branch.
// import "kab/aot_load_branch_local_zero"; do not import other kab/aot* leaves.

pub fn aotLoadBranchLocalZeroOk(op, target) {
    if target == "x64" {
        return op == "48837df8007400"
    }
    if target == "arm64" {
        return op == "a00b40f91f0000f154000000"
    }
    return false
}
