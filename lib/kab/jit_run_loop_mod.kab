// SH17 deepen: mmap+exec policy for loop-mod template. import "kab/jit_run_loop_mod"
// Do not grow jit_run_loop_div.kab.

import "kab/jit_mmap_loop"
import "kab/jit_np"
import "kab/jit_exec"
import "kab/jit_mm_loop_mod"
import "kab/jit_patch_loop_mod"
import "kab/jit_loop_mod"

pub fn jitRunLoopModOk(base, kind, bytes, n, r) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopModOk(bytes, n, r) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopModOk(nb, kind, n, r) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
