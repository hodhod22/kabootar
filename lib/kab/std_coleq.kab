// SH20: collections eq off std_colunique.kab. import "kab/std_coleq"
// Do not grow std_colunique.kab. stdHostDeleteOk stays false.

pub fn stdColEq(a, b) {
    let na = len(a)
    let nb = len(b)
    if na != nb {
        return false
    }
    let i = 0
    while i < na {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    return true
}
