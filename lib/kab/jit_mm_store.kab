// SH17 deepen: guest MMU store via os_mm_store. import "kab/jit_mm_store"
// Do not grow jit_wr.kab. Writes template bytes after mmap+translate policy.

import "kab/jit_mm"

/// Store 6-byte inc+ret template at jitMmVirt; returns bytes written or 0.
pub fn jitMmStoreIncRet(bytes) {
    if len(bytes) != 6 {
        return 0
    }
    let pid = jitMmPid()
    let virt = jitMmVirt()
    let n = os_mm_store(pid, virt, bytes)
    return n
}
