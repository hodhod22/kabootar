// SH17 deepen: guest call for loop-jl template. import "kab/jit_mm_call_loop_jl"
// Do not grow jit_mm_call_loop_jmp.kab.

import "kab/jit_mm_loop_jl"
import "kab/jit_loop_jl"

pub fn jitMmCallLoopJl(bytes, n, k) {
    if jitLoopJlOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopJlLen() {
        return 0
    }
    let pid = jitMmLoopJlPid()
    let virt = jitMmLoopJlVirt()
    let rax = os_mm_call(pid, virt)
    if rax != jitLoopJlRax(n, k) {
        return 0
    }
    return rax
}
