// SH17 deepen: loop-add wr+run+call pipeline. import "kab/jit_call_loop_add"
// Do not grow jit_call_loop_n.kab.

import "kab/jit_wr_loop_add"
import "kab/jit_run_loop_add"
import "kab/jit_mm_call_loop_add"
import "kab/jit_loop_add"

pub fn jitCallLoopAddOk(base, kind, n, k, bytes) {
    if jitLoopAddOk(n, k) == false {
        return false
    }
    if jitWrLoopAddOk(bytes, n, k) == false {
        return false
    }
    if jitRunLoopAddOk(base, kind, bytes, n, k) == false {
        return false
    }
    let r = jitMmCallLoopAdd(bytes, n, k)
    if r != jitLoopAddRax(n, k) {
        return false
    }
    return true
}
