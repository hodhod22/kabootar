// F10: emit a stable first Kab-native image manifest.
// import "kab/aot_emit_manifest"; do not import other kab/aot* leaves.

pub fn aotEmitManifest(target) {
    if target == "x64" {
        return "kabootar-native/1|x64|text:rx|rodata:r|data:rw"
    }
    if target == "arm64" {
        return "kabootar-native/1|arm64|text:rx|rodata:r|data:rw"
    }
    return ""
}
