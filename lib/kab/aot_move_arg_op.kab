// F10: first Kab-native images emit a documented argument-to-return-register move.
// import "kab/aot_move_arg_op"; do not import other kab/aot* leaves.

pub fn aotMoveArgOp(target) {
    if target == "x64" {
        return "4889d8"
    }
    if target == "arm64" {
        return "e00301aa"
    }
    return ""
}
