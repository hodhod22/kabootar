// SH18 deepen: free-list sweep with byte accounting. import "kab/gc/gc_sweep"
// Do not grow gc_mark.kab. White objects' bytes return to the free list.

import "kab/gc/gc_member"

/// Sweep: total bytes reclaimed from white (unmarked) objects.
pub fn gcSweepFreeBytes(objects, marked, sizeEach) {
    let free = 0
    let i = 0
    while i < len(objects) {
        if gcIsMarked(marked, objects[i]) == false {
            free = free + sizeEach
        }
        i = i + 1
    }
    return free
}

/// Gate: freed bytes equal wantFree exactly.
pub fn gcSweepBytesOk(objects, marked, sizeEach, wantFree) {
    return gcSweepFreeBytes(objects, marked, sizeEach) == wantFree
}
