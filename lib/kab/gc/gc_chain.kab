// SH18 deepen: rollup gc_load → gc_capstone chain. import "kab/gc/gc_chain"
// Do not grow gc_capstone.kab. gcHostDeleteOk stays false until chain smoke completes.

import "kab/gc/gc_load"
import "kab/gc/gc_stress"
import "kab/gc/gc_concurrent"
import "kab/gc/gc_concurrent_stress"
import "kab/gc/gc_deep"
import "kab/gc/gc_deep2"
import "kab/gc/gc_deep3"
import "kab/gc/gc_deep4"
import "kab/gc/gc_host"

pub fn gcChainLiveGray() {
    return 2
}

/// Each leaf milestone in the GC deepen chain validates (audit; re-runs subchains).
pub fn gcChainStepsOk(live) {
    if gcLoadBumpOk() == false {
        return false
    }
    if gcLoadCycleOk(live) == false {
        return false
    }
    if gcLoadFramesOk(live) == false {
        return false
    }
    if gcStressCyclesOk(live) == false {
        return false
    }
    if gcConcurrentOk(live) == false {
        return false
    }
    return gcConcurrentStressOk(live)
}

/// Full GC deepen chain validates (single-pass via gc_concurrent_stress).
pub fn gcChainOk(live) {
    return gcConcurrentStressOk(live)
}

/// Deep chain: full chain + tricolor/incr/rem/copy/sweep/@manual leaves.
pub fn gcChainDeepOk(live) {
    if gcChainOk(live) == false {
        return false
    }
    return gcDeepOk()
}

/// Deep-2 chain: deep chain + tenuring/card-scan/safepoint leaves.
pub fn gcChainDeep2Ok(live) {
    if gcChainDeepOk(live) == false {
        return false
    }
    return gcDeep2Ok()
}

/// Deep-3 chain: deep-2 chain + compaction/LOS/free-list leaves.
pub fn gcChainDeep3Ok(live) {
    if gcChainDeep2Ok(live) == false {
        return false
    }
    return gcDeep3Ok()
}

/// Deep-4 chain: deep-3 chain + roots/pacing/weak leaves.
pub fn gcChainDeep4Ok(live) {
    if gcChainDeep3Ok(live) == false {
        return false
    }
    return gcDeep4Ok()
}
