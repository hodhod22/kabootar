// SH18 deepen: safepoint polls — collect only when every thread has parked.
// import "kab/gc/gc_safe"
// Do not grow gc.kab. A poll site fires every pollEvery allocs; a collect runs
// iff all mutator threads are parked at a safepoint.

/// True when an alloc index hits a poll site (every `pollEvery`-th alloc).
pub fn gcSafePollFires(at, pollEvery) {
    if pollEvery <= 0 {
        return false
    }
    return at % pollEvery == 0
}

/// A collect may start only when all `threads` are parked at a safepoint.
pub fn gcSafeCollectOk(parked, threads) {
    if threads <= 0 {
        return false
    }
    return parked == threads
}

/// Gate: `allocs` allocations fire a poll every `pollEvery`; each poll requests
/// a collect that runs iff `parked`/`threads` allows. True when the number of
/// collects that ran equals `wantCollects`.
pub fn gcSafeRunOk(allocs, pollEvery, parked, threads, wantCollects) {
    if allocs <= 0 {
        return false
    }
    if pollEvery <= 0 {
        return false
    }
    let collects = 0
    let i = 1
    while i <= allocs {
        if gcSafePollFires(i, pollEvery) {
            if gcSafeCollectOk(parked, threads) {
                collects = collects + 1
            }
        }
        i = i + 1
    }
    return collects == wantCollects
}
