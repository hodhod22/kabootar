// SH18 capstone: full GC chain plus host delete gates closed. import "kab/gc/gc_capstone"
// Do not grow gc_chain.kab. gcHostDeleteOk stays false.

import "kab/gc/gc_chain"
import "kab/gc/gc_host"
import "kab/noll/noll_host"

pub fn gcCapstoneLiveGray() {
    return gcChainLiveGray()
}

/// True when GC host delete gate and all SH19–SH27 gates are still closed.
pub fn gcCapstoneGatesClosed() {
    if gcHostDeleteOk() {
        return false
    }
    return nollAllHostGatesClosed()
}

/// Full GC chain plus all host delete gates still closed.
pub fn gcCapstoneOk(live) {
    if gcChainOk(live) == false {
        return false
    }
    return gcCapstoneGatesClosed()
}

/// Full GC capstone including the deep leaves (tricolor/incr/rem/copy/sweep/
/// @manual) — host delete gates still closed.
pub fn gcCapstoneDeepOk(live) {
    if gcChainDeepOk(live) == false {
        return false
    }
    return gcCapstoneGatesClosed()
}

/// Full GC capstone including the deep-2 leaves (tenuring/card-scan/safepoint)
/// — host delete gates still closed.
pub fn gcCapstoneDeep2Ok(live) {
    if gcChainDeep2Ok(live) == false {
        return false
    }
    return gcCapstoneGatesClosed()
}

