// SH18: nursery promote off the gc.kab leaf. import "kab/gc/gc_prom"

pub fn gcPromote(used, cap) {
    if used > cap {
        return used - cap
    }
    return 0
}

/// Promote objects from nursery to old generation
pub fn gcPromoteObjects(objects, start, end) {
    let promoted = []
    let i = start
    while i < end {
        if i < len(objects) {
            promoted = push(promoted, objects[i])
        }
        i = i + 1
    }
    return promoted
}

/// Check if object should be promoted based on age
pub fn gcShouldPromote(age, threshold) {
    if age >= threshold {
        return true
    }
    return false
}

/// Get promotion threshold (e.g., objects surviving N cycles)
pub fn gcPromoteThreshold() {
    return 2
}
