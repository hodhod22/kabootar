// SH18 deepen: tenuring — survivors age each nursery cycle; promote at threshold.
// import "kab/gc/gc_age"
// Do not grow gc_prom.kab. ages[] is parallel to objects[]; age counts cycles.

import "kab/gc/gc_prom"
import "kab/gc/gc_member"

/// Bump the age of every marked (surviving) object; dead objects never age.
pub fn gcAgeBump(ages, objects, marked) {
    let i = 0
    while i < len(objects) {
        if gcIsMarked(marked, objects[i]) {
            ages[i] = ages[i] + 1
        }
        i = i + 1
    }
    return ages
}

/// True when an object survived enough cycles to leave the nursery.
pub fn gcAgeReady(age) {
    return gcShouldPromote(age, gcPromoteThreshold())
}

/// Gate: after `cycles` survived cycles every marked object reaches the
/// promotion threshold, unmarked stay at age 0, and `wantPromoted` promote.
pub fn gcAgeCyclesOk(objects, marked, cycles, wantPromoted) {
    if cycles <= 0 {
        return false
    }
    let ages = []
    let i = 0
    while i < len(objects) {
        ages = push(ages, 0)
        i = i + 1
    }
    let c = 0
    while c < cycles {
        ages = gcAgeBump(ages, objects, marked)
        c = c + 1
    }
    let promoted = 0
    i = 0
    while i < len(objects) {
        if gcIsMarked(marked, objects[i]) {
            if gcAgeReady(ages[i]) == false {
                return false
            }
            promoted = promoted + 1
        }
        if gcIsMarked(marked, objects[i]) == false {
            if ages[i] != 0 {
                return false
            }
        }
        i = i + 1
    }
    return promoted == wantPromoted
}
