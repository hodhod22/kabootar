// SH18 deepen: repeated concurrent mark under load stress. import "kab/gc/gc_concurrent_stress"
// Do not grow gc_concurrent.kab. Three concurrent passes without host GC heap.

import "kab/gc/gc_concurrent"

pub fn gcConcurrentStressCycleCount() {
    return 3
}

/// Run three consecutive gcConcurrentOk passes at the same `live` gray target.
pub fn gcConcurrentStressOk(live) {
    if gcConcurrentOk(live) == false {
        return false
    }
    if gcConcurrentOk(live) == false {
        return false
    }
    if gcConcurrentOk(live) == false {
        return false
    }
    return true
}
