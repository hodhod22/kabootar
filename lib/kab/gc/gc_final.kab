// SH18 deepen 5: finalizer queue — dead objects with a finalizer run before
// their bytes return to the free list. import "kab/gc/gc_final"
// Do not grow gc_sweep.kab. A finalizer never resurrects: the object still sweeps.

import "kab/gc/gc_member"
import "kab/gc/gc_sweep"

/// Dead objects with a finalizer, in order — the finalizer queue.
pub fn gcFinalQueue(objects, marked, finals) {
    let q = []
    let i = 0
    while i < len(objects) {
        if gcIsMarked(marked, objects[i]) == false {
            if gcIsMarked(finals, objects[i]) {
                q = push(q, objects[i])
            }
        }
        i = i + 1
    }
    return q
}

/// Gate: exactly the dead-with-finalizer are queued, then the sweep still
/// reclaims every dead object's bytes — finalizer or not.
pub fn gcFinalOk(objects, marked, finals, sizeEach, wantQueue, wantFree) {
    let q = gcFinalQueue(objects, marked, finals)
    if len(q) != wantQueue {
        return false
    }
    return gcSweepBytesOk(objects, marked, sizeEach, wantFree)
}
