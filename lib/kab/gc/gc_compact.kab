// SH18 deepen 3: sliding compaction — live objects pack low preserving order.
// import "kab/gc/gc_compact"
// Do not grow gc_copy.kab. Unlike semi-space evac, compaction keeps old-space
// order and computes a forwarding slot per live object.

import "kab/gc/gc_member"

/// Forwarding table: live object at slot i slides to the count of live objects
/// before it; dead objects get -1.
pub fn gcCompactFwd(objects, marked) {
    let fwd = []
    let top = 0
    let i = 0
    while i < len(objects) {
        if gcIsMarked(marked, objects[i]) {
            fwd = push(fwd, top)
            top = top + 1
        }
        if gcIsMarked(marked, objects[i]) == false {
            fwd = push(fwd, -1)
        }
        i = i + 1
    }
    return fwd
}

/// Gate: live objects occupy slots 0..wantTop contiguously, each new slot is
/// not above its old slot, and dead objects forward to -1.
pub fn gcCompactOk(objects, marked, wantTop) {
    let fwd = gcCompactFwd(objects, marked)
    let seen = 0
    let i = 0
    while i < len(fwd) {
        if gcIsMarked(marked, objects[i]) {
            if fwd[i] != seen {
                return false
            }
            if fwd[i] > i {
                return false
            }
            seen = seen + 1
        }
        if gcIsMarked(marked, objects[i]) == false {
            if fwd[i] != -1 {
                return false
            }
        }
        i = i + 1
    }
    return seen == wantTop
}
