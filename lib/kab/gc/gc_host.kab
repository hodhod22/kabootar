// SH18/F11: host GC delete policy off gc.kab. import "kab/gc/gc_host"
// Do not grow gc.kab. Do not delete host GC until Kab nursery+mark smoke is complete.

pub fn gcHostDeleteOk() {
    return false
}

/// Readiness check toward deleting the host GC path: one collect cycle is
/// internally consistent — every marked inst was counted live, every dead
/// inst was reclaimed, and the root set is a subset of the marked set.
/// The VM records this per cycle as S["gcHostReady"]; the delete gate stays
/// false until the Kab path has held ready across real workloads.
pub fn gcHostReadyOk(roots, marked, live, dead, reclaimed) {
    if marked != live {
        return false
    }
    if dead != reclaimed {
        return false
    }
    return roots <= marked
}

/// Evidence criterion for the host-delete flip: the VM accumulates
/// consecutive internally-consistent collect cycles in
/// S["gcHostReadyStreak"]. 8 = two full rotations of the VM's
/// major-every-4 cadence (vGcMajorEvery — evidence spanning both minor
/// and major cycles, not just a lucky minor). gcHostDeleteOk still
/// returns false: this is the *check the flip will consult*, not the
/// flip itself.
pub fn gcHostReadyStreakOk(streak) {
    if typeof(streak) != "number" {
        return false
    }
    return streak >= 8
}
