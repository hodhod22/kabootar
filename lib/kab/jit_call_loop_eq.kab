// SH17 deepen: loop-eq wr+run+call pipeline. import "kab/jit_call_loop_eq"
// Do not grow jit_call_loop_neg.kab.

import "kab/jit_wr_loop_eq"
import "kab/jit_run_loop_eq"
import "kab/jit_mm_call_loop_eq"
import "kab/jit_loop_eq"

pub fn jitCallLoopEqOk(base, kind, n, k, bytes) {
    if jitLoopEqOk(n, k) == false {
        return false
    }
    if jitWrLoopEqOk(bytes, n, k) == false {
        return false
    }
    if jitRunLoopEqOk(base, kind, bytes, n, k) == false {
        return false
    }
    let rax = jitMmCallLoopEq(bytes, n, k)
    if rax != jitLoopEqRax(n, k) {
        return false
    }
    return true
}
