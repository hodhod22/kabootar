// F11 deepen: TLAB promote pause histogram. import "kab/gc_tlab_pause"
// Do not grow gc_tlab_nursery.kab or gc.kab. Pause stays gcFrameBudgetMs (16).

import "kab/gc_tlab_nursery"
import "kab/gc"

pub fn gcTlabPauseOk(workers, used, cap, pauseMs) {
    if gcTlabNurseryOk(workers, used, cap) == false {
        return false
    }
    if pauseMs != gcFrameBudgetMs() {
        return false
    }
    return true
}
