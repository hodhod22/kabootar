// SH20: collections tanh off std_colcosh.kab. import "kab/std_coltanh"
// Do not grow std_colcosh.kab. stdHostDeleteOk stays false.

pub fn stdColTanh(a) {
    let n = len(a)
    let out = []
    let i = 0
    while i < n {
        out = push(out, tanh(a[i]))
        i = i + 1
    }
    return out
}
