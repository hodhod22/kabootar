// SH17 deepen: loop-shl guest mmap args. import "kab/jit_mm_loop_shl"
// Do not grow jit_mm_loop_xor.kab. Separate virt slot from loop-xor.

import "kab/jit_loop_shl"

pub fn jitMmLoopShlPid() {
    return 1
}

pub fn jitMmLoopShlVirt() {
    return 483328
}

pub fn jitMmLoopShlLen() {
    return 4096
}

pub fn jitMmLoopShlProt() {
    return 7
}

pub fn jitOsMmapLoopShlOk(nBytes, kind, n, sh) {
    if jitLoopShlOk(n, sh) == false {
        return false
    }
    if nBytes != jitLoopShlLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopShlLen() != 4096 {
        return false
    }
    if jitMmLoopShlProt() != 7 {
        return false
    }
    return true
}
