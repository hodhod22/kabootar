// SH17 deepen: mmap+exec policy for loop-neg template. import "kab/jit/jit_run_loop_neg"
// Do not grow jit_run_loop_not.kab.

import "kab/jit/jit_mmap_loop"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm_loop_neg"
import "kab/jit/jit_patch_loop_neg"
import "kab/jit/jit_loop_neg"

pub fn jitRunLoopNegOk(base, kind, bytes, n) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopNegOk(bytes, n) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopNegOk(nb, kind, n) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
