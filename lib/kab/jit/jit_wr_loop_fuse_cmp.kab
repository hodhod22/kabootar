// SH17 deepen: translate+store for fused cmp+branch template.
// import "kab/jit/jit_wr_loop_fuse_cmp"
// Do not grow jit_wr_loop_fuse.kab.

import "kab/jit/jit_patch_loop_fuse_cmp"
import "kab/jit/jit_mm_loop_fuse_cmp"
import "kab/jit/jit_mm_store_loop_fuse_cmp"
import "kab/jit/jit_fuse_cmp"

pub fn jitWrLoopFuseCmpOk(bytes, magic, n, k) {
    if jitPatchLoopFuseCmpOk(bytes, magic, n, k) == false {
        return false
    }
    let pid = jitMmLoopFuseCmpPid()
    let virt = jitMmLoopFuseCmpVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopFuseCmp(bytes, magic, n, k)
    if w != jitFuseCmpLen() {
        return false
    }
    return true
}
