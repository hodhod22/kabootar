// SH17 deepen: loop-xor guest mmap args. import "kab/jit/jit_mm_loop_xor"
// Do not grow jit_mm_loop_or.kab. Separate virt slot from loop-or.

import "kab/jit/jit_loop_xor"

pub fn jitMmLoopXorPid() {
    return 1
}

pub fn jitMmLoopXorVirt() {
    return 475136
}

pub fn jitMmLoopXorLen() {
    return 4096
}

pub fn jitMmLoopXorProt() {
    return 7
}

pub fn jitOsMmapLoopXorOk(nBytes, kind, n, mask) {
    if jitLoopXorOk(n, mask) == false {
        return false
    }
    if nBytes != jitLoopXorLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopXorLen() != 4096 {
        return false
    }
    if jitMmLoopXorProt() != 7 {
        return false
    }
    return true
}
