// SH17 widen: ops-driven arith3 fusion — the left-assoc chain
// const/const/const/op/op/ret lowers to ONE guest arith3 template
// (magic 107). Covers the real shape `return a OP b OP c` (arity 3) that
// the fixed 6-param L-chain cannot. import "kab/jit/jit_from_ops_arith3"
// Do not grow jit_from_ops_bits.kab.

import "kab/jit"
import "kab/jit/jit_from_ops"
import "kab/jit/jit_arith3"
import "kab/jit/jit_mm_loop_arith3"
import "kab/jit/jit_call_loop_arith3"

/// True when ops are exactly the fusible arith3 chain
/// const/const/const/op/op/ret with both ops in add/sub/mul/div/mod.
pub fn jitArith3OpsOk(ops) {
    if typeof(ops) != "array" {
        return false
    }
    if len(ops) != 6 {
        return false
    }
    if ops[0] != "const" {
        return false
    }
    if ops[1] != "const" {
        return false
    }
    if ops[2] != "const" {
        return false
    }
    if jitArith3Code(ops[3]) == 0 {
        return false
    }
    if jitArith3Code(ops[4]) == 0 {
        return false
    }
    if ops[5] != "ret" {
        return false
    }
    return true
}

/// Compile a fusible arith3 chain into one guest template and exec it in
/// the guest MMU; true when guest rax matches jitArith3Rax.
pub fn jitFromOpsArith3Ok(ops, a, b, c) {
    if jitCanCompile(ops) == false {
        return false
    }
    if jitArith3OpsOk(ops) == false {
        return false
    }
    let i = 0
    while i < len(ops) {
        if jitOpOk(ops[i]) == false {
            return false
        }
        i = i + 1
    }
    let o1 = jitArith3Code(ops[3])
    let o2 = jitArith3Code(ops[4])
    if jitArith3Ok(a, b, c, o1, o2) == false {
        return false
    }
    let base = os_mm_mmap(jitMmLoopArith3Pid(), jitMmLoopArith3Virt(), jitMmLoopArith3Len(), jitMmLoopArith3Prot())
    let bytes = jitEmitI64Arith3(a, b, c, o1, o2)
    return jitCallLoopArith3Ok(base, "rwx", a, b, c, o1, o2, bytes)
}
