// SH17 widen: mmap+exec policy for loop-pow template. import
// "kab/jit/jit_run_loop_pow". Do not grow jit_run_loop_mod.kab.

import "kab/jit/jit_mmap_loop"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm_loop_pow"
import "kab/jit/jit_patch_loop_pow"
import "kab/jit/jit_loop_pow"

pub fn jitRunLoopPowOk(base, kind, bytes, n, k) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopPowOk(bytes, n, k) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopPowOk(nb, kind, n, k) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
