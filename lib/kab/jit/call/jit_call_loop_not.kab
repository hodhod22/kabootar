// SH17 deepen: loop-not wr+run+call pipeline. import "kab/jit/jit_call_loop_not"
// Do not grow jit_call_loop_ushr.kab.

import "kab/jit/jit_wr_loop_not"
import "kab/jit/jit_run_loop_not"
import "kab/jit/jit_mm_call_loop_not"
import "kab/jit/jit_loop_not"

pub fn jitCallLoopNotOk(base, kind, n, bytes) {
    if jitLoopNotOk(n) == false {
        return false
    }
    if jitWrLoopNotOk(bytes, n) == false {
        return false
    }
    if jitRunLoopNotOk(base, kind, bytes, n) == false {
        return false
    }
    let rax = jitMmCallLoopNot(bytes, n)
    if rax != jitLoopNotRax(n) {
        return false
    }
    return true
}
