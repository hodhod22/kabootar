// SH17 deepen: loop-jmp wr+run+call pipeline. import "kab/jit/jit_call_loop_jmp"
// Do not grow jit_call_loop_jne.kab.

import "kab/jit/jit_wr_loop_jmp"
import "kab/jit/jit_run_loop_jmp"
import "kab/jit/jit_mm_call_loop_jmp"
import "kab/jit/jit_loop_jmp"

pub fn jitCallLoopJmpOk(base, kind, n, k, bytes) {
    if jitLoopJmpOk(n, k) == false {
        return false
    }
    if jitWrLoopJmpOk(bytes, n, k) == false {
        return false
    }
    if jitRunLoopJmpOk(base, kind, bytes, n, k) == false {
        return false
    }
    let rax = jitMmCallLoopJmp(bytes, n, k)
    if rax != jitLoopJmpRax(n, k) {
        return false
    }
    return true
}
