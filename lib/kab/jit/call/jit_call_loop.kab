// SH17 deepen: loop8 wr+run+call pipeline. import "kab/jit/jit_call_loop"
// Do not grow jit_call.kab.

import "kab/jit/jit_wr_loop"
import "kab/jit/jit_run_loop"
import "kab/jit/jit_mm_call_loop"
import "kab/jit/jit_loop"

pub fn jitCallLoopOk(base, kind, bytes) {
    if jitWrLoopOk(bytes) == false {
        return false
    }
    if jitRunLoopOk(base, kind, bytes) == false {
        return false
    }
    let r = jitMmCallLoop(bytes)
    if r != jitLoopRax() {
        return false
    }
    return true
}
