// SH17 deepen: guest call for loop-add template. import "kab/jit/jit_mm_call_loop_add"
// Do not grow jit_mm_call_loop_n.kab.

import "kab/jit/jit_mm_loop_add"
import "kab/jit/jit_loop_add"

pub fn jitMmCallLoopAdd(bytes, n, k) {
    if jitLoopAddOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopAddLen() {
        return 0
    }
    let pid = jitMmLoopAddPid()
    let virt = jitMmLoopAddVirt()
    let r = os_mm_call(pid, virt)
    if r != jitLoopAddRax(n, k) {
        return 0
    }
    return r
}
