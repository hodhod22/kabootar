// SH17 deepen: loop-le guest mmap args. import "kab/jit/jit_mm_loop_le"
// Do not grow jit_mm_loop_gt.kab. Separate virt slot from loop-gt.

import "kab/jit/jit_loop_le"

pub fn jitMmLoopLePid() {
    return 1
}

pub fn jitMmLoopLeVirt() {
    return 557056
}

pub fn jitMmLoopLeLen() {
    return 4096
}

pub fn jitMmLoopLeProt() {
    return 7
}

pub fn jitOsMmapLoopLeOk(nBytes, kind, n, k) {
    if jitLoopLeOk(n, k) == false {
        return false
    }
    if nBytes != jitLoopLeLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopLeLen() != 4096 {
        return false
    }
    if jitMmLoopLeProt() != 7 {
        return false
    }
    return true
}
