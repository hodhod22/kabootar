// SH17 deepen: value mirror for jit_from_ops_any — jitFromOpsAnyExecOk
// returns bool (it validates guest rax against the Kab mirror); callers
// that need the call RESULT compute it here after exec validated it.
// import "kab/jit/jit_from_ops_any_val"

import "kab/jit/jit_from_ops_any"
import "kab/jit/jit_from_ops_fuse_cmp"
import "kab/jit/jit_fuse"
import "kab/jit/jit_fuse_cmp"
import "kab/jit/jit_f64"
import "kab/jit/jit_bits"
import "kab/jit/jit_arith3"
import "kab/jit/jit_arith4"

/// Kab mirror of the guest result for a validated exec — same kind dispatch
/// as jitFromOpsAnyExecOk. undefined when ops have no fusible shape.
pub fn jitFromOpsAnyVal(ops, n, k, s, m, d, r) {
    let kind = jitFuseKind(ops)
    if kind == 1 {
        return jitFuseRax(n, k, s, m, d, r)
    }
    if kind == 2 {
        return jitFuseCmpRax(n, k, jitFuseCmpTarget(ops))
    }
    if kind == 3 {
        return jitF64Rax(n, k, jitF64Magic(ops[2]))
    }
    if kind == 5 {
        if len(ops) == 3 {
            return jitBitsRax(n, 0, jitBitsMagic(ops[1]))
        }
        return jitBitsRax(n, k, jitBitsMagic(ops[2]))
    }
    if kind == 6 {
        return jitArith3Rax(n, k, s, jitArith3Code(ops[3]), jitArith3Code(ops[4]))
    }
    if kind == 7 {
        return jitArith4Rax(n, k, s, m, jitArith4Code(ops[4]), jitArith4Code(ops[5]), jitArith4Code(ops[6]))
    }
    return undefined
}
