// SH17 widen: loop-pow guest mmap args. import "kab/jit/jit_mm_loop_pow"
// Do not grow jit_mm_loop_mod.kab. Separate virt slot from loop-mod.

import "kab/jit/jit_loop_pow"

pub fn jitMmLoopPowPid() {
    return 1
}

pub fn jitMmLoopPowVirt() {
    return 696320
}

pub fn jitMmLoopPowLen() {
    return 4096
}

pub fn jitMmLoopPowProt() {
    return 7
}

pub fn jitOsMmapLoopPowOk(nBytes, kind, n, k) {
    if jitLoopPowOk(n, k) == false {
        return false
    }
    if nBytes != jitLoopPowLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopPowLen() != 4096 {
        return false
    }
    if jitMmLoopPowProt() != 7 {
        return false
    }
    return true
}
