// SH17 deepen: loop-div wr+run+call pipeline. import "kab/jit/jit_call_loop_div"
// Do not grow jit_call_loop_mul.kab.

import "kab/jit/jit_wr_loop_div"
import "kab/jit/jit_run_loop_div"
import "kab/jit/jit_mm_call_loop_div"
import "kab/jit/jit_loop_div"

pub fn jitCallLoopDivOk(base, kind, n, d, bytes) {
    if jitLoopDivOk(n, d) == false {
        return false
    }
    if jitWrLoopDivOk(bytes, n, d) == false {
        return false
    }
    if jitRunLoopDivOk(base, kind, bytes, n, d) == false {
        return false
    }
    let r = jitMmCallLoopDiv(bytes, n, d)
    if r != jitLoopDivRax(n, d) {
        return false
    }
    return true
}
