// SH17 deepen: fused-chain wr+run+call pipeline. import "kab/jit/jit_call_loop_fuse"
// Do not grow jit_call_loop_mod.kab.

import "kab/jit/jit_wr_loop_fuse"
import "kab/jit/jit_run_loop_fuse"
import "kab/jit/jit_mm_call_loop_fuse"
import "kab/jit/jit_fuse"

pub fn jitCallLoopFuseOk(base, kind, n, k, s, m, d, r, bytes) {
    if jitFuseOk(n, k, s, m, d, r) == false {
        return false
    }
    if jitWrLoopFuseOk(bytes, n, k, s, m, d, r) == false {
        return false
    }
    if jitRunLoopFuseOk(base, kind, bytes, n, k, s, m, d, r) == false {
        return false
    }
    let res = jitMmCallLoopFuse(bytes, n, k, s, m, d, r)
    if res != jitFuseRax(n, k, s, m, d, r) {
        return false
    }
    return true
}
