// SH17 deepen: loop-sub guest mmap args. import "kab/jit/jit_mm_loop_sub"
// Do not grow jit_mm_loop_add.kab. Separate virt slot from loop-add.

import "kab/jit/jit_loop_sub"

pub fn jitMmLoopSubPid() {
    return 1
}

pub fn jitMmLoopSubVirt() {
    return 425984
}

pub fn jitMmLoopSubLen() {
    return 4096
}

pub fn jitMmLoopSubProt() {
    return 7
}

pub fn jitOsMmapLoopSubOk(nBytes, kind, n, s) {
    if jitLoopSubOk(n, s) == false {
        return false
    }
    if nBytes != jitLoopSubLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopSubLen() != 4096 {
        return false
    }
    if jitMmLoopSubProt() != 7 {
        return false
    }
    return true
}
