// SH17 deepen: fused cmp+branch wr+run+call pipeline.
// import "kab/jit/jit_call_loop_fuse_cmp"
// Do not grow jit_call_loop_fuse.kab.

import "kab/jit/jit_wr_loop_fuse_cmp"
import "kab/jit/jit_run_loop_fuse_cmp"
import "kab/jit/jit_mm_call_loop_fuse_cmp"
import "kab/jit/jit_fuse_cmp"

pub fn jitCallLoopFuseCmpOk(base, kind, magic, n, k, bytes) {
    if jitFuseCmpMagicOk(magic) == false {
        return false
    }
    if jitFuseCmpOk(n, k) == false {
        return false
    }
    if jitWrLoopFuseCmpOk(bytes, magic, n, k) == false {
        return false
    }
    if jitRunLoopFuseCmpOk(base, kind, bytes, magic, n, k) == false {
        return false
    }
    let res = jitMmCallLoopFuseCmp(bytes, magic, n, k)
    if res != jitFuseCmpRax(n, k, magic) {
        return false
    }
    return true
}
