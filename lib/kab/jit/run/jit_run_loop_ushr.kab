// SH17 deepen: mmap+exec policy for loop-ushr template. import "kab/jit/jit_run_loop_ushr"
// Do not grow jit_run_loop_shr.kab.

import "kab/jit/jit_mmap_loop"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm_loop_ushr"
import "kab/jit/jit_patch_loop_ushr"
import "kab/jit/jit_loop_ushr"

pub fn jitRunLoopUshrOk(base, kind, bytes, n, sh) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopUshrOk(bytes, n, sh) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopUshrOk(nb, kind, n, sh) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
