// SH17 deepen: mmap+exec policy for loop-je template. import "kab/jit/jit_run_loop_je"
// Do not grow jit_run_loop_test.kab.

import "kab/jit/jit_mmap_loop"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm_loop_je"
import "kab/jit/jit_patch_loop_je"
import "kab/jit/jit_loop_je"

pub fn jitRunLoopJeOk(base, kind, bytes, n, k) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopJeOk(bytes, n, k) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopJeOk(nb, kind, n, k) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
