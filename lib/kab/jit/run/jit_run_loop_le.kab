// SH17 deepen: mmap+exec policy for loop-le template. import "kab/jit/jit_run_loop_le"
// Do not grow jit_run_loop_gt.kab.

import "kab/jit/jit_mmap_loop"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm_loop_le"
import "kab/jit/jit_patch_loop_le"
import "kab/jit/jit_loop_le"

pub fn jitRunLoopLeOk(base, kind, bytes, n, k) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopLeOk(bytes, n, k) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopLeOk(nb, kind, n, k) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
