// SH17 deepen: mmap+exec policy for loop-mul template. import "kab/jit/jit_run_loop_mul"
// Do not grow jit_run_loop_sub.kab.

import "kab/jit/jit_mmap_loop"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm_loop_mul"
import "kab/jit/jit_patch_loop_mul"
import "kab/jit/jit_loop_mul"

pub fn jitRunLoopMulOk(base, kind, bytes, n, m) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopMulOk(bytes, n, m) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopMulOk(nb, kind, n, m) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
