// SH17 deepen: unified fusion dispatcher. import "kab/jit/jit_from_ops_any"
// Do not grow jit_from_ops_simd.kab. Picks the right lowering per shape:
// arith fuse, cmp+branch fuse, f64 fuse, SIMD fuse, or cold (interpreted).

import "kab/jit"
import "kab/jit/jit_from_ops"
import "kab/jit/jit_from_ops_fuse"
import "kab/jit/jit_from_ops_fuse_cmp"
import "kab/jit/jit_from_ops_f64"
import "kab/jit/jit_from_ops_simd"
import "kab/jit/jit_from_ops_bits"
import "kab/jit/jit_from_ops_arith3"
import "kab/jit/jit_from_ops_arith4"
import "kab/jit/jit_mod"
import "kab/jit/jit_from_ops_mod"
import "kab/jit/jit_pow"
import "kab/jit/jit_from_ops_pow"

/// 1 = arith fuse, 2 = cmp+branch fuse, 3 = f64 fuse, 4 = SIMD fuse,
/// 5 = bits/unary fuse, 6 = arith3 fuse, 7 = arith4 fuse, 8 = mod fuse,
/// 9 = pow fuse, 0 = no fusible shape.
pub fn jitFuseKind(ops) {
    if jitFuseOpsOk(ops) {
        return 1
    }
    if jitFuseCmpOpsOk(ops) {
        return 2
    }
    if jitF64OpsOk(ops) {
        return 3
    }
    if jitSimdOpsOk(ops) {
        return 4
    }
    if jitBitsOpsOk(ops) {
        return 5
    }
    if jitArith3OpsOk(ops) {
        return 6
    }
    if jitArith4OpsOk(ops) {
        return 7
    }
    if jitModOpsOk(ops) {
        return 8
    }
    if jitPowOpsOk(ops) {
        return 9
    }
    return 0
}

/// Unified exec for i64/f64 shapes: dispatch to the matching fused pipeline;
/// cold shapes return false (no code emitted — stays in the Kab-VM).
pub fn jitFromOpsAnyExecOk(ops, n, k, s, m, d, r) {
    let kind = jitFuseKind(ops)
    if kind == 1 {
        return jitFromOpsFuseOk(ops, n, k, s, m, d, r)
    }
    if kind == 2 {
        return jitFromOpsFuseCmpOk(ops, n, k)
    }
    if kind == 3 {
        return jitFromOpsF64Ok(ops, n, k)
    }
    if kind == 5 {
        return jitFromOpsBitsOk(ops, n, k)
    }
    if kind == 6 {
        return jitFromOpsArith3Ok(ops, n, k, s)
    }
    if kind == 7 {
        return jitFromOpsArith4Ok(ops, n, k, s, m)
    }
    if kind == 8 {
        return jitFromOpsModOk(ops, n, k)
    }
    if kind == 9 {
        return jitFromOpsPowOk(ops, n, k)
    }
    return false
}

/// SIMD variant of the dispatcher exec — 2-lane operands a,b.
pub fn jitFromOpsAnySimdExecOk(ops, a0, a1, b0, b1) {
    if jitFuseKind(ops) != 4 {
        return false
    }
    return jitFromOpsSimdOk(ops, a0, a1, b0, b1)
}
