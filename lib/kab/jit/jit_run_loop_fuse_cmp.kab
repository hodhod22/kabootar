// SH17 deepen: mmap+exec policy for fused cmp+branch template.
// import "kab/jit/jit_run_loop_fuse_cmp"
// Do not grow jit_run_loop_fuse.kab.

import "kab/jit/jit_mmap_loop"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm_loop_fuse_cmp"
import "kab/jit/jit_patch_loop_fuse_cmp"
import "kab/jit/jit_fuse_cmp"

pub fn jitRunLoopFuseCmpOk(base, kind, bytes, magic, n, k) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopFuseCmpOk(bytes, magic, n, k) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopFuseCmpOk(nb, kind, magic, n, k) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
