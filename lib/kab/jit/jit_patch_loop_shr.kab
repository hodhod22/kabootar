// SH17 deepen: validate i64 loop-shr template. import "kab/jit/jit_patch_loop_shr"
// Do not grow jit_patch_loop_shl.kab.

import "kab/jit/jit_loop_shr"
import "kab/jit/jit_check"

pub fn jitPatchLoopShrOk(bytes, n, sh) {
    if jitLoopShrOk(n, sh) == false {
        return false
    }
    let tpl = jitEmitI64LoopShrN(n, sh)
    if len(bytes) != jitLoopShrLen() {
        return false
    }
    if len(tpl) != jitLoopShrLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
