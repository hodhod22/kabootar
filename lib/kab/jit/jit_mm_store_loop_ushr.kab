// SH17 deepen: guest store for loop-ushr template. import "kab/jit/jit_mm_store_loop_ushr"
// Do not grow jit_mm_store_loop_shr.kab.

import "kab/jit/jit_mm_loop_ushr"
import "kab/jit/jit_loop_ushr"

pub fn jitMmStoreLoopUshr(bytes, n, sh) {
    if jitLoopUshrOk(n, sh) == false {
        return 0
    }
    if len(bytes) != jitLoopUshrLen() {
        return 0
    }
    let pid = jitMmLoopUshrPid()
    let virt = jitMmLoopUshrVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
