// SH17 widen: arith3 wr+run+call pipeline.
// import "kab/jit/jit_call_loop_arith3"
// Do not grow jit_call_loop_f64.kab.

import "kab/jit/jit_wr_loop_arith3"
import "kab/jit/jit_run_loop_arith3"
import "kab/jit/jit_mm_call_loop_arith3"
import "kab/jit/jit_arith3"

pub fn jitCallLoopArith3Ok(base, kind, a, b, c, o1, o2, bytes) {
    if jitArith3Ok(a, b, c, o1, o2) == false {
        return false
    }
    if jitWrLoopArith3Ok(bytes, a, b, c, o1, o2) == false {
        return false
    }
    if jitRunLoopArith3Ok(base, kind, bytes, a, b, c, o1, o2) == false {
        return false
    }
    let res = jitMmCallLoopArith3(bytes, a, b, c, o1, o2)
    if res != jitArith3Rax(a, b, c, o1, o2) {
        return false
    }
    return true
}
