// SH17 deepen: guest call for loop-jle template. import "kab/jit/jit_mm_call_loop_jle"
// Do not grow jit_mm_call_loop_jl.kab.

import "kab/jit/jit_mm_loop_jle"
import "kab/jit/jit_loop_jle"

pub fn jitMmCallLoopJle(bytes, n, k) {
    if jitLoopJleOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopJleLen() {
        return 0
    }
    let pid = jitMmLoopJlePid()
    let virt = jitMmLoopJleVirt()
    let rax = os_mm_call(pid, virt)
    if rax != jitLoopJleRax(n, k) {
        return 0
    }
    return rax
}
