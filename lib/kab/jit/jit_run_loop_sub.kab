// SH17 deepen: mmap+exec policy for loop-sub template. import "kab/jit/jit_run_loop_sub"
// Do not grow jit_run_loop_add.kab.

import "kab/jit/jit_mmap_loop"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm_loop_sub"
import "kab/jit/jit_patch_loop_sub"
import "kab/jit/jit_loop_sub"

pub fn jitRunLoopSubOk(base, kind, bytes, n, s) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopSubOk(bytes, n, s) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopSubOk(nb, kind, n, s) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
