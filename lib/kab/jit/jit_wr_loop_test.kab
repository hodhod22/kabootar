// SH17 deepen: translate+store for loop-test template. import "kab/jit/jit_wr_loop_test"
// Do not grow jit_wr_loop_ge.kab.

import "kab/jit/jit_patch_loop_test"
import "kab/jit/jit_mm_loop_test"
import "kab/jit/jit_mm_store_loop_test"
import "kab/jit/jit_loop_test"

pub fn jitWrLoopTestOk(bytes, n, k) {
    if jitPatchLoopTestOk(bytes, n, k) == false {
        return false
    }
    let pid = jitMmLoopTestPid()
    let virt = jitMmLoopTestVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopTest(bytes, n, k)
    if w != jitLoopTestLen() {
        return false
    }
    return true
}
