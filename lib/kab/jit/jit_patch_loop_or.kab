// SH17 deepen: validate i64 loop-or template. import "kab/jit/jit_patch_loop_or"
// Do not grow jit_patch_loop_and.kab.

import "kab/jit/jit_loop_or"
import "kab/jit/jit_check"

pub fn jitPatchLoopOrOk(bytes, n, mask) {
    if jitLoopOrOk(n, mask) == false {
        return false
    }
    let tpl = jitEmitI64LoopOrN(n, mask)
    if len(bytes) != jitLoopOrLen() {
        return false
    }
    if len(tpl) != jitLoopOrLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
