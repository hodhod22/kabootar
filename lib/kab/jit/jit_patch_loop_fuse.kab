// SH17 deepen: validate fused-chain template. import "kab/jit/jit_patch_loop_fuse"
// Do not grow jit_patch_loop_mod.kab. All 6 imm slots carry fused operands.

import "kab/jit/jit_fuse"
import "kab/jit/jit_check"

pub fn jitPatchLoopFuseOk(bytes, n, k, s, m, d, r) {
    if jitFuseOk(n, k, s, m, d, r) == false {
        return false
    }
    let tpl = jitEmitI64Fuse(n, k, s, m, d, r)
    if len(bytes) != jitFuseLen() {
        return false
    }
    if len(tpl) != jitFuseLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if bytes[3] != tpl[3] {
        return false
    }
    if bytes[4] != tpl[4] {
        return false
    }
    if bytes[5] != tpl[5] {
        return false
    }
    if bytes[6] != tpl[6] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
