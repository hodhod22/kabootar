// SH17 deepen: translate+store for loop-jle template. import "kab/jit/jit_wr_loop_jle"
// Do not grow jit_wr_loop_jl.kab.

import "kab/jit/jit_patch_loop_jle"
import "kab/jit/jit_mm_loop_jle"
import "kab/jit/jit_mm_store_loop_jle"
import "kab/jit/jit_loop_jle"

pub fn jitWrLoopJleOk(bytes, n, k) {
    if jitPatchLoopJleOk(bytes, n, k) == false {
        return false
    }
    let pid = jitMmLoopJlePid()
    let virt = jitMmLoopJleVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopJle(bytes, n, k)
    if w != jitLoopJleLen() {
        return false
    }
    return true
}
