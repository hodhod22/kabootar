// SH17 deepen: translate+store for loop-shr template. import "kab/jit/jit_wr_loop_shr"
// Do not grow jit_wr_loop_shl.kab.

import "kab/jit/jit_patch_loop_shr"
import "kab/jit/jit_mm_loop_shr"
import "kab/jit/jit_mm_store_loop_shr"
import "kab/jit/jit_loop_shr"

pub fn jitWrLoopShrOk(bytes, n, sh) {
    if jitPatchLoopShrOk(bytes, n, sh) == false {
        return false
    }
    let pid = jitMmLoopShrPid()
    let virt = jitMmLoopShrVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopShr(bytes, n, sh)
    if w != jitLoopShrLen() {
        return false
    }
    return true
}
