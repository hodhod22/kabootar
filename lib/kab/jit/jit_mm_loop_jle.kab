// SH17 deepen: loop-jle guest mmap args. import "kab/jit/jit_mm_loop_jle"
// Do not grow jit_mm_loop_jl.kab. Separate virt slot from loop-jl.

import "kab/jit/jit_loop_jle"

pub fn jitMmLoopJlePid() {
    return 1
}

pub fn jitMmLoopJleVirt() {
    return 614400
}

pub fn jitMmLoopJleLen() {
    return 4096
}

pub fn jitMmLoopJleProt() {
    return 7
}

pub fn jitOsMmapLoopJleOk(nBytes, kind, n, k) {
    if jitLoopJleOk(n, k) == false {
        return false
    }
    if nBytes != jitLoopJleLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopJleLen() != 4096 {
        return false
    }
    if jitMmLoopJleProt() != 7 {
        return false
    }
    return true
}
