// SH17 deepen: translate+store for loop-sub template. import "kab/jit/jit_wr_loop_sub"
// Do not grow jit_wr_loop_add.kab.

import "kab/jit/jit_patch_loop_sub"
import "kab/jit/jit_mm_loop_sub"
import "kab/jit/jit_mm_store_loop_sub"
import "kab/jit/jit_loop_sub"

pub fn jitWrLoopSubOk(bytes, n, s) {
    if jitPatchLoopSubOk(bytes, n, s) == false {
        return false
    }
    let pid = jitMmLoopSubPid()
    let virt = jitMmLoopSubVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopSub(bytes, n, s)
    if w != jitLoopSubLen() {
        return false
    }
    return true
}
