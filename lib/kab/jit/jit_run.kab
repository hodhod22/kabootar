// SH17 deepen: mmap + patch + exec policy for inc+ret. import "kab/jit/jit_run"
// Do not grow jit.kab. Guest page via os_mm_mmap; no host code emit in Rust.

import "kab/jit/jit_mmap"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm"
import "kab/jit/jit_patch"

/// After os_mm_mmap(base>0): patch template, then allow exec on one rwx page.
pub fn jitRunIncRetOk(base, kind, bytes) {
    if base <= 0 {
        return false
    }
    if jitPatchIncRetOk(bytes) == false {
        return false
    }
    let n = len(bytes)
    if jitMmapOk(n, kind) == false {
        return false
    }
    if jitOsMmapOk(n, kind) == false {
        return false
    }
    let pages = jitPagesFor(n)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
