// SH17 deepen: mmap+exec policy for loop-or template. import "kab/jit/jit_run_loop_or"
// Do not grow jit_run_loop_and.kab.

import "kab/jit/jit_mmap_loop"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm_loop_or"
import "kab/jit/jit_patch_loop_or"
import "kab/jit/jit_loop_or"

pub fn jitRunLoopOrOk(base, kind, bytes, n, mask) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopOrOk(bytes, n, mask) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopOrOk(nb, kind, n, mask) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
