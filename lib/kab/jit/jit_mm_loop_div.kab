// SH17 deepen: loop-div guest mmap args. import "kab/jit/jit_mm_loop_div"
// Do not grow jit_mm_loop_mul.kab. Separate virt slot from loop-mul.

import "kab/jit/jit_loop_div"

pub fn jitMmLoopDivPid() {
    return 1
}

pub fn jitMmLoopDivVirt() {
    return 442368
}

pub fn jitMmLoopDivLen() {
    return 4096
}

pub fn jitMmLoopDivProt() {
    return 7
}

pub fn jitOsMmapLoopDivOk(nBytes, kind, n, d) {
    if jitLoopDivOk(n, d) == false {
        return false
    }
    if nBytes != jitLoopDivLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopDivLen() != 4096 {
        return false
    }
    if jitMmLoopDivProt() != 7 {
        return false
    }
    return true
}
