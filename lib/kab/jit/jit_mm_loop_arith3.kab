// SH17 widen: arith3 guest mmap args. import "kab/jit/jit_mm_loop_arith3"
// Do not grow jit_mm_loop_f64.kab. Separate virt slot for arith3 exec.

import "kab/jit/jit_arith3"

pub fn jitMmLoopArith3Pid() {
    return 1
}

pub fn jitMmLoopArith3Virt() {
    return 679936
}

pub fn jitMmLoopArith3Len() {
    return 4096
}

pub fn jitMmLoopArith3Prot() {
    return 7
}

pub fn jitOsMmapLoopArith3Ok(nBytes, kind, a, b, c, o1, o2) {
    if jitArith3Ok(a, b, c, o1, o2) == false {
        return false
    }
    if nBytes != jitArith3Len() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopArith3Len() != 4096 {
        return false
    }
    if jitMmLoopArith3Prot() != 7 {
        return false
    }
    return true
}
