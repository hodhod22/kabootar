// SH17 deepen: i64 loopN + jmp template. import "kab/jit/jit_loop_jmp"
// Do not grow jit_loop_jne.kab. Magic 94 + n + k + ret; os_mm_call returns 1 (jmp taken).

import "kab/jit/jit_loop_n"

pub fn jitLoopJmpKMax() {
    return 64
}

pub fn jitLoopJmpKOk(k) {
    if k <= 0 {
        return false
    }
    if k > jitLoopJmpKMax() {
        return false
    }
    return true
}

pub fn jitLoopJmpOk(n, k) {
    if jitLoopNOk(n) == false {
        return false
    }
    if jitLoopJmpKOk(k) == false {
        return false
    }
    return true
}

pub fn jitLoopJmpRax(n, k) {
    if jitLoopJmpOk(n, k) == false {
        return 0
    }
    return 1
}

pub fn jitLoopJmpLen() {
    return jitLoopNLen()
}

/// Loop marker 94, count n, rhs k, pad, ret — simulated guest rax=1 (unconditional jmp).
pub fn jitEmitI64LoopJmpN(n, k) {
    let b = []
    b = push(b, 94)
    b = push(b, n)
    b = push(b, k)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 195)
    return b
}
