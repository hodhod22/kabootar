// SH17 deepen: guest MMU write policy for inc+ret template. import "kab/jit/jit_wr"
// Do not grow jit_run.kab. Translate then os_mm_store; no host patch in Rust.

import "kab/jit/jit_patch"
import "kab/jit/jit_mm"
import "kab/jit/jit_mm_store"

/// True when template bytes translate and store into the mapped rwx page.
pub fn jitWrIncRetOk(bytes) {
    if jitPatchIncRetOk(bytes) == false {
        return false
    }
    let pid = jitMmPid()
    let virt = jitMmVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p5 = os_mm_translate(pid, virt + 5)
    if p5 <= 0 {
        return false
    }
    let n = jitMmStoreIncRet(bytes)
    if n != 6 {
        return false
    }
    return true
}
