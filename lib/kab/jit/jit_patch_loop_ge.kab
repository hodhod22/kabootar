// SH17 deepen: validate i64 loop-ge template. import "kab/jit/jit_patch_loop_ge"
// Do not grow jit_patch_loop_le.kab.

import "kab/jit/jit_loop_ge"
import "kab/jit/jit_check"

pub fn jitPatchLoopGeOk(bytes, n, k) {
    if jitLoopGeOk(n, k) == false {
        return false
    }
    let tpl = jitEmitI64LoopGeN(n, k)
    if len(bytes) != jitLoopGeLen() {
        return false
    }
    if len(tpl) != jitLoopGeLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
