// SH17 deepen: validate i64 loop-jge template. import "kab/jit/jit_patch_loop_jge"
// Do not grow jit_patch_loop_jg.kab.

import "kab/jit/jit_loop_jge"
import "kab/jit/jit_check"

pub fn jitPatchLoopJgeOk(bytes, n, k) {
    if jitLoopJgeOk(n, k) == false {
        return false
    }
    let tpl = jitEmitI64LoopJgeN(n, k)
    if len(bytes) != jitLoopJgeLen() {
        return false
    }
    if len(tpl) != jitLoopJgeLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
