// SH17 deepen: validate i64 loop-div template. import "kab/jit/jit_patch_loop_div"
// Do not grow jit_patch_loop_mul.kab.

import "kab/jit/jit_loop_div"
import "kab/jit/jit_check"

pub fn jitPatchLoopDivOk(bytes, n, d) {
    if jitLoopDivOk(n, d) == false {
        return false
    }
    let tpl = jitEmitI64LoopDivN(n, d)
    if len(bytes) != jitLoopDivLen() {
        return false
    }
    if len(tpl) != jitLoopDivLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if bytes[3] != tpl[3] {
        return false
    }
    if bytes[4] != tpl[4] {
        return false
    }
    if bytes[5] != tpl[5] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
