// SH17 deepen: mmap+exec policy for fused-chain template. import "kab/jit/jit_run_loop_fuse"
// Do not grow jit_run_loop_mod.kab.

import "kab/jit/jit_mmap_loop"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm_loop_fuse"
import "kab/jit/jit_patch_loop_fuse"
import "kab/jit/jit_fuse"

pub fn jitRunLoopFuseOk(base, kind, bytes, n, k, s, m, d, r) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopFuseOk(bytes, n, k, s, m, d, r) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopFuseOk(nb, kind, n, k, s, m, d, r) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
