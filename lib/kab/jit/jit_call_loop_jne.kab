// SH17 deepen: loop-jne wr+run+call pipeline. import "kab/jit/jit_call_loop_jne"
// Do not grow jit_call_loop_je.kab.

import "kab/jit/jit_wr_loop_jne"
import "kab/jit/jit_run_loop_jne"
import "kab/jit/jit_mm_call_loop_jne"
import "kab/jit/jit_loop_jne"

pub fn jitCallLoopJneOk(base, kind, n, k, bytes) {
    if jitLoopJneOk(n, k) == false {
        return false
    }
    if jitWrLoopJneOk(bytes, n, k) == false {
        return false
    }
    if jitRunLoopJneOk(base, kind, bytes, n, k) == false {
        return false
    }
    let rax = jitMmCallLoopJne(bytes, n, k)
    if rax != jitLoopJneRax(n, k) {
        return false
    }
    return true
}
