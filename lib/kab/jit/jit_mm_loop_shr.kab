// SH17 deepen: loop-shr guest mmap args. import "kab/jit/jit_mm_loop_shr"
// Do not grow jit_mm_loop_shl.kab. Separate virt slot from loop-shl.

import "kab/jit/jit_loop_shr"

pub fn jitMmLoopShrPid() {
    return 1
}

pub fn jitMmLoopShrVirt() {
    return 491520
}

pub fn jitMmLoopShrLen() {
    return 4096
}

pub fn jitMmLoopShrProt() {
    return 7
}

pub fn jitOsMmapLoopShrOk(nBytes, kind, n, sh) {
    if jitLoopShrOk(n, sh) == false {
        return false
    }
    if nBytes != jitLoopShrLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopShrLen() != 4096 {
        return false
    }
    if jitMmLoopShrProt() != 7 {
        return false
    }
    return true
}
