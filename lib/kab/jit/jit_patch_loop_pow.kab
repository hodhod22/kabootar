// SH17 widen: validate i64 loop-pow template. import
// "kab/jit/jit_patch_loop_pow". Do not grow jit_patch_loop_mod.kab.

import "kab/jit/jit_loop_pow"
import "kab/jit/jit_check"

pub fn jitPatchLoopPowOk(bytes, n, k) {
    if jitLoopPowOk(n, k) == false {
        return false
    }
    let tpl = jitEmitI64LoopPowN(n, k)
    if len(bytes) != jitLoopPowLen() {
        return false
    }
    if len(tpl) != jitLoopPowLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if bytes[3] != tpl[3] {
        return false
    }
    if bytes[4] != tpl[4] {
        return false
    }
    if bytes[5] != tpl[5] {
        return false
    }
    if bytes[6] != tpl[6] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
