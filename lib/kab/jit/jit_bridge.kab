// SH17 deepen: bridge between Rust runtime and Kab-JIT. import "kab/jit/jit_bridge"
// Provides functions that Rust can call to use Kab-JIT templates without host Cranelift.

import "kab/jit"
import "kab/jit/jit_run"
import "kab/jit/jit_mm"

/// Check if a function can be JIT-compiled by Kab-JIT (Rust callable).
pub fn jitBridgeCanCompile(opcodeNames) {
    let n = len(opcodeNames)
    if n == 0 {
        return false
    }
    // Check if all opcodes are supported
    let i = 0
    while i < n {
        let name = opcodeNames[i]
        if jitOpOk(name) == false {
            return false
        }
        i = i + 1
    }
    return true
}

/// Emit native code for a sequence of opcodes (Rust callable).
pub fn jitBridgeEmit(opcodeNames) {
    let result = []
    let n = len(opcodeNames)
    let i = 0
    while i < n {
        let name = opcodeNames[i]
        let bytes = jitEmitOp(name)
        let j = 0
        while j < len(bytes) {
            result = push(result, bytes[j])
            j = j + 1
        }
        i = i + 1
    }
    return result
}

/// Get total byte length for opcode sequence (Rust callable).
pub fn jitBridgeTotalLen(opcodeNames) {
    let total = 0
    let n = len(opcodeNames)
    let i = 0
    while i < n {
        let name = opcodeNames[i]
        total = total + jitOpLen(name)
        i = i + 1
    }
    return total
}

/// Validate that emitted bytes match expected policy (Rust callable).
pub fn jitBridgeValidate(bytes, expectedLen) {
    if len(bytes) != expectedLen {
        return false
    }
    // Ensure bytes end with RET
    if len(bytes) == 0 {
        return false
    }
    let last = bytes[len(bytes) - 1]
    if last != 195 {  // 0xC3 = RET
        return false
    }
    return true
}

/// Get JIT policy parameters for mmap (Rust callable).
pub fn jitBridgeGetMmapPolicy() {
    return [jitMmPid(), jitMmVirt(), jitMmLen(), jitMmProt()]
}

/// Check if mmap args match JIT policy (Rust callable).
pub fn jitBridgeCheckMmap(pid, virt, len, prot) {
    if pid != jitMmPid() {
        return false
    }
    if virt != jitMmVirt() {
        return false
    }
    if len != jitMmLen() {
        return false
    }
    if prot != jitMmProt() {
        return false
    }
    return true
}

/// Get required page count for given byte length (Rust callable).
pub fn jitBridgePagesFor(byteLen) {
    let pageSize = 4096
    if byteLen <= pageSize {
        return 1
    }
    return ((byteLen + pageSize - 1) / pageSize)
}

/// Complete JIT pipeline check (Rust callable).
pub fn jitBridgePipelineOk(opcodeNames) {
    if jitBridgeCanCompile(opcodeNames) == false {
        return false
    }
    let bytes = jitBridgeEmit(opcodeNames)
    let expectedLen = jitBridgeTotalLen(opcodeNames)
    if jitBridgeValidate(bytes, expectedLen) == false {
        return false
    }
    let pages = jitBridgePagesFor(expectedLen)
    if pages == 0 {
        return false
    }
    return true
}