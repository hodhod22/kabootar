// SH17 deepen: loop-mod guest mmap args. import "kab/jit/jit_mm_loop_mod"
// Do not grow jit_mm_loop_div.kab. Separate virt slot from loop-div.

import "kab/jit/jit_loop_mod"

pub fn jitMmLoopModPid() {
    return 1
}

pub fn jitMmLoopModVirt() {
    return 450560
}

pub fn jitMmLoopModLen() {
    return 4096
}

pub fn jitMmLoopModProt() {
    return 7
}

pub fn jitOsMmapLoopModOk(nBytes, kind, n, r) {
    if jitLoopModOk(n, r) == false {
        return false
    }
    if nBytes != jitLoopModLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopModLen() != 4096 {
        return false
    }
    if jitMmLoopModProt() != 7 {
        return false
    }
    return true
}
