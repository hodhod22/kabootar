// SH17 deepen: i64 loopN + ne template. import "kab/jit/jit_loop_ne"
// Do not grow jit_loop_eq.kab. Magic V + n + k + ret; os_mm_call returns 1 iff n!=k.

import "kab/jit/jit_loop_n"

pub fn jitLoopNeKMax() {
    return 64
}

pub fn jitLoopNeKOk(k) {
    if k <= 0 {
        return false
    }
    if k > jitLoopNeKMax() {
        return false
    }
    return true
}

pub fn jitLoopNeOk(n, k) {
    if jitLoopNOk(n) == false {
        return false
    }
    if jitLoopNeKOk(k) == false {
        return false
    }
    return true
}

pub fn jitLoopNeRax(n, k) {
    if n != k {
        return 1
    }
    return 0
}

pub fn jitLoopNeLen() {
    return jitLoopNLen()
}

/// Loop marker 86, count n, rhs k, pad, ret — simulated guest rax=1 iff n!=k.
pub fn jitEmitI64LoopNeN(n, k) {
    let b = []
    b = push(b, 86)
    b = push(b, n)
    b = push(b, k)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 0)
    b = push(b, 195)
    return b
}
