// SH17 deepen: validate i64 loop-shl template. import "kab/jit/jit_patch_loop_shl"
// Do not grow jit_patch_loop_xor.kab.

import "kab/jit/jit_loop_shl"
import "kab/jit/jit_check"

pub fn jitPatchLoopShlOk(bytes, n, sh) {
    if jitLoopShlOk(n, sh) == false {
        return false
    }
    let tpl = jitEmitI64LoopShlN(n, sh)
    if len(bytes) != jitLoopShlLen() {
        return false
    }
    if len(tpl) != jitLoopShlLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
