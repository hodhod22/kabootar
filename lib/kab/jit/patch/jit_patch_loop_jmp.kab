// SH17 deepen: validate i64 loop-jmp template. import "kab/jit/jit_patch_loop_jmp"
// Do not grow jit_patch_loop_jne.kab.

import "kab/jit/jit_loop_jmp"
import "kab/jit/jit_check"

pub fn jitPatchLoopJmpOk(bytes, n, k) {
    if jitLoopJmpOk(n, k) == false {
        return false
    }
    let tpl = jitEmitI64LoopJmpN(n, k)
    if len(bytes) != jitLoopJmpLen() {
        return false
    }
    if len(tpl) != jitLoopJmpLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
