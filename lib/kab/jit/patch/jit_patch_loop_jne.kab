// SH17 deepen: validate i64 loop-jne template. import "kab/jit/jit_patch_loop_jne"
// Do not grow jit_patch_loop_je.kab.

import "kab/jit/jit_loop_jne"
import "kab/jit/jit_check"

pub fn jitPatchLoopJneOk(bytes, n, k) {
    if jitLoopJneOk(n, k) == false {
        return false
    }
    let tpl = jitEmitI64LoopJneN(n, k)
    if len(bytes) != jitLoopJneLen() {
        return false
    }
    if len(tpl) != jitLoopJneLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
