// SH17 deepen: validate i64 loop-ushr template. import "kab/jit/jit_patch_loop_ushr"
// Do not grow jit_patch_loop_shr.kab.

import "kab/jit/jit_loop_ushr"
import "kab/jit/jit_check"

pub fn jitPatchLoopUshrOk(bytes, n, sh) {
    if jitLoopUshrOk(n, sh) == false {
        return false
    }
    let tpl = jitEmitI64LoopUshrN(n, sh)
    if len(bytes) != jitLoopUshrLen() {
        return false
    }
    if len(tpl) != jitLoopUshrLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
