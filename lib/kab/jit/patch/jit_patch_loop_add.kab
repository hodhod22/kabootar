// SH17 deepen: validate i64 loop-add template. import "kab/jit/jit_patch_loop_add"
// Do not grow jit_patch_loop_n.kab.

import "kab/jit/jit_loop_add"
import "kab/jit/jit_check"

pub fn jitPatchLoopAddOk(bytes, n, k) {
    if jitLoopAddOk(n, k) == false {
        return false
    }
    let tpl = jitEmitI64LoopAddN(n, k)
    if len(bytes) != jitLoopAddLen() {
        return false
    }
    if len(tpl) != jitLoopAddLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
