// SH17 deepen: mmap+exec policy for f64 template.
// import "kab/jit/jit_run_loop_f64"
// Do not grow jit_run_loop_fuse_cmp.kab.

import "kab/jit/jit_mmap_loop"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm_loop_f64"
import "kab/jit/jit_patch_loop_f64"
import "kab/jit/jit_f64"

pub fn jitRunLoopF64Ok(base, kind, bytes, magic, n, k) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopF64Ok(bytes, magic, n, k) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopF64Ok(nb, kind, magic, n, k) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
