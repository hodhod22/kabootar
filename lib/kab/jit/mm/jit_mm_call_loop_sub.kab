// SH17 deepen: guest call for loop-sub template. import "kab/jit/jit_mm_call_loop_sub"
// Do not grow jit_mm_call_loop_add.kab.

import "kab/jit/jit_mm_loop_sub"
import "kab/jit/jit_loop_sub"

pub fn jitMmCallLoopSub(bytes, n, s) {
    if jitLoopSubOk(n, s) == false {
        return 0
    }
    if len(bytes) != jitLoopSubLen() {
        return 0
    }
    let pid = jitMmLoopSubPid()
    let virt = jitMmLoopSubVirt()
    let r = os_mm_call(pid, virt)
    if r != jitLoopSubRax(n, s) {
        return 0
    }
    return r
}
