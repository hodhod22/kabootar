// SH17 deepen: guest call for loop-mod template. import "kab/jit/jit_mm_call_loop_mod"
// Do not grow jit_mm_call_loop_div.kab.

import "kab/jit/jit_mm_loop_mod"
import "kab/jit/jit_loop_mod"

pub fn jitMmCallLoopMod(bytes, n, r) {
    if jitLoopModOk(n, r) == false {
        return 0
    }
    if len(bytes) != jitLoopModLen() {
        return 0
    }
    let pid = jitMmLoopModPid()
    let virt = jitMmLoopModVirt()
    let rax = os_mm_call(pid, virt)
    if rax != jitLoopModRax(n, r) {
        return 0
    }
    return rax
}
