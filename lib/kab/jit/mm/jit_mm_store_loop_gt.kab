// SH17 deepen: guest store for loop-gt template. import "kab/jit/jit_mm_store_loop_gt"
// Do not grow jit_mm_store_loop_lt.kab.

import "kab/jit/jit_mm_loop_gt"
import "kab/jit/jit_loop_gt"

pub fn jitMmStoreLoopGt(bytes, n, k) {
    if jitLoopGtOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopGtLen() {
        return 0
    }
    let pid = jitMmLoopGtPid()
    let virt = jitMmLoopGtVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
