// SH17 deepen: loop-jg guest mmap args. import "kab/jit/jit_mm_loop_jg"
// Do not grow jit_mm_loop_jle.kab. Separate virt slot from loop-jle.

import "kab/jit/jit_loop_jg"

pub fn jitMmLoopJgPid() {
    return 1
}

pub fn jitMmLoopJgVirt() {
    return 622592
}

pub fn jitMmLoopJgLen() {
    return 4096
}

pub fn jitMmLoopJgProt() {
    return 7
}

pub fn jitOsMmapLoopJgOk(nBytes, kind, n, k) {
    if jitLoopJgOk(n, k) == false {
        return false
    }
    if nBytes != jitLoopJgLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopJgLen() != 4096 {
        return false
    }
    if jitMmLoopJgProt() != 7 {
        return false
    }
    return true
}
