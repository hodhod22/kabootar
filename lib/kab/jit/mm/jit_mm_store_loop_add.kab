// SH17 deepen: guest store for loop-add template. import "kab/jit/jit_mm_store_loop_add"
// Do not grow jit_mm_store_loop_n.kab.

import "kab/jit/jit_mm_loop_add"
import "kab/jit/jit_loop_add"

pub fn jitMmStoreLoopAdd(bytes, n, k) {
    if jitLoopAddOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopAddLen() {
        return 0
    }
    let pid = jitMmLoopAddPid()
    let virt = jitMmLoopAddVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
