// SH17 deepen: guest store for loop-ge template. import "kab/jit/jit_mm_store_loop_ge"
// Do not grow jit_mm_store_loop_le.kab.

import "kab/jit/jit_mm_loop_ge"
import "kab/jit/jit_loop_ge"

pub fn jitMmStoreLoopGe(bytes, n, k) {
    if jitLoopGeOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopGeLen() {
        return 0
    }
    let pid = jitMmLoopGePid()
    let virt = jitMmLoopGeVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
