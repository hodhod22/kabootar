// SH17 deepen: guest store for loop-jge template. import "kab/jit/jit_mm_store_loop_jge"
// Do not grow jit_mm_store_loop_jg.kab.

import "kab/jit/jit_mm_loop_jge"
import "kab/jit/jit_loop_jge"

pub fn jitMmStoreLoopJge(bytes, n, k) {
    if jitLoopJgeOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopJgeLen() {
        return 0
    }
    let pid = jitMmLoopJgePid()
    let virt = jitMmLoopJgeVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
