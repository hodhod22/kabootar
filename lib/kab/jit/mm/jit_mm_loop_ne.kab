// SH17 deepen: loop-ne guest mmap args. import "kab/jit/jit_mm_loop_ne"
// Do not grow jit_mm_loop_eq.kab. Separate virt slot from loop-eq.

import "kab/jit/jit_loop_ne"

pub fn jitMmLoopNePid() {
    return 1
}

pub fn jitMmLoopNeVirt() {
    return 532480
}

pub fn jitMmLoopNeLen() {
    return 4096
}

pub fn jitMmLoopNeProt() {
    return 7
}

pub fn jitOsMmapLoopNeOk(nBytes, kind, n, k) {
    if jitLoopNeOk(n, k) == false {
        return false
    }
    if nBytes != jitLoopNeLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopNeLen() != 4096 {
        return false
    }
    if jitMmLoopNeProt() != 7 {
        return false
    }
    return true
}
