// SH17 deepen: guest store for loopN template. import "kab/jit/jit_mm_store_loop_n"
// Do not grow jit_mm_store_loop.kab.

import "kab/jit/jit_mm_loop_n"
import "kab/jit/jit_loop_n"

pub fn jitMmStoreLoopN(bytes, n) {
    if jitLoopNOk(n) == false {
        return 0
    }
    if len(bytes) != jitLoopNLen() {
        return 0
    }
    let pid = jitMmLoopNPid()
    let virt = jitMmLoopNVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
