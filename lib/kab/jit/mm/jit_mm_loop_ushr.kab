// SH17 deepen: loop-ushr guest mmap args. import "kab/jit/jit_mm_loop_ushr"
// Do not grow jit_mm_loop_shr.kab. Separate virt slot from loop-shr.

import "kab/jit/jit_loop_ushr"

pub fn jitMmLoopUshrPid() {
    return 1
}

pub fn jitMmLoopUshrVirt() {
    return 499712
}

pub fn jitMmLoopUshrLen() {
    return 4096
}

pub fn jitMmLoopUshrProt() {
    return 7
}

pub fn jitOsMmapLoopUshrOk(nBytes, kind, n, sh) {
    if jitLoopUshrOk(n, sh) == false {
        return false
    }
    if nBytes != jitLoopUshrLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopUshrLen() != 4096 {
        return false
    }
    if jitMmLoopUshrProt() != 7 {
        return false
    }
    return true
}
