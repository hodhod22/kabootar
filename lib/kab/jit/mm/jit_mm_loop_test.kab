// SH17 deepen: loop-test guest mmap args. import "kab/jit/jit_mm_loop_test"
// Do not grow jit_mm_loop_ge.kab. Separate virt slot from loop-ge.

import "kab/jit/jit_loop_test"

pub fn jitMmLoopTestPid() {
    return 1
}

pub fn jitMmLoopTestVirt() {
    return 573440
}

pub fn jitMmLoopTestLen() {
    return 4096
}

pub fn jitMmLoopTestProt() {
    return 7
}

pub fn jitOsMmapLoopTestOk(nBytes, kind, n, k) {
    if jitLoopTestOk(n, k) == false {
        return false
    }
    if nBytes != jitLoopTestLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopTestLen() != 4096 {
        return false
    }
    if jitMmLoopTestProt() != 7 {
        return false
    }
    return true
}
