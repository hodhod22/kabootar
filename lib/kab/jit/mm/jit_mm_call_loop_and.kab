// SH17 deepen: guest call for loop-and template. import "kab/jit/jit_mm_call_loop_and"
// Do not grow jit_mm_call_loop_mod.kab.

import "kab/jit/jit_mm_loop_and"
import "kab/jit/jit_loop_and"

pub fn jitMmCallLoopAnd(bytes, n, mask) {
    if jitLoopAndOk(n, mask) == false {
        return 0
    }
    if len(bytes) != jitLoopAndLen() {
        return 0
    }
    let pid = jitMmLoopAndPid()
    let virt = jitMmLoopAndVirt()
    let rax = os_mm_call(pid, virt)
    if rax != jitLoopAndRax(n, mask) {
        return 0
    }
    return rax
}
