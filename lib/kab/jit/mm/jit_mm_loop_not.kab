// SH17 deepen: loop-not guest mmap args. import "kab/jit/jit_mm_loop_not"
// Do not grow jit_mm_loop_ushr.kab. Separate virt slot from loop-ushr.

import "kab/jit/jit_loop_not"

pub fn jitMmLoopNotPid() {
    return 1
}

pub fn jitMmLoopNotVirt() {
    return 507904
}

pub fn jitMmLoopNotLen() {
    return 4096
}

pub fn jitMmLoopNotProt() {
    return 7
}

pub fn jitOsMmapLoopNotOk(nBytes, kind, n) {
    if jitLoopNotOk(n) == false {
        return false
    }
    if nBytes != jitLoopNotLen() {
        return false
    }
    if kind != "rwx" {
        return false
    }
    if jitMmLoopNotLen() != 4096 {
        return false
    }
    if jitMmLoopNotProt() != 7 {
        return false
    }
    return true
}
