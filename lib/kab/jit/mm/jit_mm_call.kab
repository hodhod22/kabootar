// SH17 deepen: guest MMU call via os_mm_call. import "kab/jit/jit_mm_call"
// Do not grow jit_call.kab. Simulated rax after inc+ret template is stored.

import "kab/jit/jit_mm"

/// Call guest entry at jitMmVirt; returns simulated rax (1) or 0 on failure.
pub fn jitMmCallIncRet(bytes) {
    if len(bytes) != 6 {
        return 0
    }
    let pid = jitMmPid()
    let virt = jitMmVirt()
    let r = os_mm_call(pid, virt)
    if r != 1 {
        return 0
    }
    return r
}
