// SH17 deepen: guest store for loop-eq template. import "kab/jit/jit_mm_store_loop_eq"
// Do not grow jit_mm_store_loop_neg.kab.

import "kab/jit/jit_mm_loop_eq"
import "kab/jit/jit_loop_eq"

pub fn jitMmStoreLoopEq(bytes, n, k) {
    if jitLoopEqOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopEqLen() {
        return 0
    }
    let pid = jitMmLoopEqPid()
    let virt = jitMmLoopEqVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
