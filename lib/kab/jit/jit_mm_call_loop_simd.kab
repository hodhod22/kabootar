// SH17 deepen: guest call for SIMD template.
// import "kab/jit/jit_mm_call_loop_simd"
// Do not grow jit_mm_call_loop_f64.kab.

import "kab/jit/jit_mm_loop_simd"
import "kab/jit/jit_simd_op"

pub fn jitMmCallLoopSimd(bytes, magic, a0, a1, b0, b1) {
    if jitSimdMagicOk(magic) == false {
        return 0
    }
    if jitSimdLanesOk(a0, a1, b0, b1) == false {
        return 0
    }
    if len(bytes) != jitSimdOpLen() {
        return 0
    }
    let pid = jitMmLoopSimdPid()
    let virt = jitMmLoopSimdVirt()
    let res = os_mm_call(pid, virt)
    if res != jitSimdRax(a0, a1, b0, b1, magic) {
        return 0
    }
    return res
}
