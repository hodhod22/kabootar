// SH17 deepen: validate i64 loop-xor template. import "kab/jit/jit_patch_loop_xor"
// Do not grow jit_patch_loop_or.kab.

import "kab/jit/jit_loop_xor"
import "kab/jit/jit_check"

pub fn jitPatchLoopXorOk(bytes, n, mask) {
    if jitLoopXorOk(n, mask) == false {
        return false
    }
    let tpl = jitEmitI64LoopXorN(n, mask)
    if len(bytes) != jitLoopXorLen() {
        return false
    }
    if len(tpl) != jitLoopXorLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
