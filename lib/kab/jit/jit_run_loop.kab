// SH17 deepen: mmap+exec policy for loop8 template. import "kab/jit/jit_run_loop"
// Do not grow jit_run.kab.

import "kab/jit/jit_mmap_loop"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm_loop"
import "kab/jit/jit_patch_loop"
import "kab/jit/jit_loop"

pub fn jitRunLoopOk(base, kind, bytes) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopOk(bytes) == false {
        return false
    }
    let n = len(bytes)
    if jitMmapLoopOk(n, kind) == false {
        return false
    }
    if jitOsMmapLoopOk(n, kind) == false {
        return false
    }
    let pages = jitPagesFor(n)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
