// SH17 deepen: guest call for loop-jge template. import "kab/jit/jit_mm_call_loop_jge"
// Do not grow jit_mm_call_loop_jg.kab.

import "kab/jit/jit_mm_loop_jge"
import "kab/jit/jit_loop_jge"

pub fn jitMmCallLoopJge(bytes, n, k) {
    if jitLoopJgeOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopJgeLen() {
        return 0
    }
    let pid = jitMmLoopJgePid()
    let virt = jitMmLoopJgeVirt()
    let rax = os_mm_call(pid, virt)
    if rax != jitLoopJgeRax(n, k) {
        return 0
    }
    return rax
}
