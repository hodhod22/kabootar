// SH17 deepen: validate i64 loop-lt template. import "kab/jit/jit_patch_loop_lt"
// Do not grow jit_patch_loop_ne.kab.

import "kab/jit/jit_loop_lt"
import "kab/jit/jit_check"

pub fn jitPatchLoopLtOk(bytes, n, k) {
    if jitLoopLtOk(n, k) == false {
        return false
    }
    let tpl = jitEmitI64LoopLtN(n, k)
    if len(bytes) != jitLoopLtLen() {
        return false
    }
    if len(tpl) != jitLoopLtLen() {
        return false
    }
    if bytes[0] != tpl[0] {
        return false
    }
    if bytes[1] != tpl[1] {
        return false
    }
    if bytes[2] != tpl[2] {
        return false
    }
    if jitByteIsRet(bytes[7]) == false {
        return false
    }
    return bytes[7] == tpl[7]
}
