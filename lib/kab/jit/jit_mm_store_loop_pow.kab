// SH17 widen: guest store for loop-pow template. import
// "kab/jit/jit_mm_store_loop_pow". Do not grow jit_mm_store_loop_mod.kab.

import "kab/jit/jit_mm_loop_pow"
import "kab/jit/jit_loop_pow"

pub fn jitMmStoreLoopPow(bytes, n, k) {
    if jitLoopPowOk(n, k) == false {
        return 0
    }
    if len(bytes) != jitLoopPowLen() {
        return 0
    }
    let pid = jitMmLoopPowPid()
    let virt = jitMmLoopPowVirt()
    let w = os_mm_store(pid, virt, bytes)
    return w
}
