// SH17 deepen: translate+store for loop-je template. import "kab/jit/jit_wr_loop_je"
// Do not grow jit_wr_loop_test.kab.

import "kab/jit/jit_patch_loop_je"
import "kab/jit/jit_mm_loop_je"
import "kab/jit/jit_mm_store_loop_je"
import "kab/jit/jit_loop_je"

pub fn jitWrLoopJeOk(bytes, n, k) {
    if jitPatchLoopJeOk(bytes, n, k) == false {
        return false
    }
    let pid = jitMmLoopJePid()
    let virt = jitMmLoopJeVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopJe(bytes, n, k)
    if w != jitLoopJeLen() {
        return false
    }
    return true
}
