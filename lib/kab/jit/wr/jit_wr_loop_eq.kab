// SH17 deepen: translate+store for loop-eq template. import "kab/jit/jit_wr_loop_eq"
// Do not grow jit_wr_loop_neg.kab.

import "kab/jit/jit_patch_loop_eq"
import "kab/jit/jit_mm_loop_eq"
import "kab/jit/jit_mm_store_loop_eq"
import "kab/jit/jit_loop_eq"

pub fn jitWrLoopEqOk(bytes, n, k) {
    if jitPatchLoopEqOk(bytes, n, k) == false {
        return false
    }
    let pid = jitMmLoopEqPid()
    let virt = jitMmLoopEqVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopEq(bytes, n, k)
    if w != jitLoopEqLen() {
        return false
    }
    return true
}
