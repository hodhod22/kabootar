// SH17 deepen: translate+store for loop-jne template. import "kab/jit/jit_wr_loop_jne"
// Do not grow jit_wr_loop_je.kab.

import "kab/jit/jit_patch_loop_jne"
import "kab/jit/jit_mm_loop_jne"
import "kab/jit/jit_mm_store_loop_jne"
import "kab/jit/jit_loop_jne"

pub fn jitWrLoopJneOk(bytes, n, k) {
    if jitPatchLoopJneOk(bytes, n, k) == false {
        return false
    }
    let pid = jitMmLoopJnePid()
    let virt = jitMmLoopJneVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopJne(bytes, n, k)
    if w != jitLoopJneLen() {
        return false
    }
    return true
}
