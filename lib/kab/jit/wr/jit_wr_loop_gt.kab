// SH17 deepen: translate+store for loop-gt template. import "kab/jit/jit_wr_loop_gt"
// Do not grow jit_wr_loop_lt.kab.

import "kab/jit/jit_patch_loop_gt"
import "kab/jit/jit_mm_loop_gt"
import "kab/jit/jit_mm_store_loop_gt"
import "kab/jit/jit_loop_gt"

pub fn jitWrLoopGtOk(bytes, n, k) {
    if jitPatchLoopGtOk(bytes, n, k) == false {
        return false
    }
    let pid = jitMmLoopGtPid()
    let virt = jitMmLoopGtVirt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopGt(bytes, n, k)
    if w != jitLoopGtLen() {
        return false
    }
    return true
}
