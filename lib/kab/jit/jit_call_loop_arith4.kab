// SH17 widen: arith4 wr+run+call pipeline.
// import "kab/jit/jit_call_loop_arith4"
// Do not grow jit_call_loop_arith3.kab.

import "kab/jit/jit_wr_loop_arith4"
import "kab/jit/jit_run_loop_arith4"
import "kab/jit/jit_mm_call_loop_arith4"
import "kab/jit/jit_arith4"

pub fn jitCallLoopArith4Ok(base, kind, a, b, c, d, o1, o2, o3, bytes) {
    if jitArith4Ok(a, b, c, d, o1, o2, o3) == false {
        return false
    }
    if jitWrLoopArith4Ok(bytes, a, b, c, d, o1, o2, o3) == false {
        return false
    }
    if jitRunLoopArith4Ok(base, kind, bytes, a, b, c, d, o1, o2, o3) == false {
        return false
    }
    let res = jitMmCallLoopArith4(bytes, a, b, c, d, o1, o2, o3)
    if res != jitArith4Rax(a, b, c, d, o1, o2, o3) {
        return false
    }
    return true
}
