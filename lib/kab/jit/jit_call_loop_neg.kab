// SH17 deepen: loop-neg wr+run+call pipeline. import "kab/jit/jit_call_loop_neg"
// Do not grow jit_call_loop_not.kab.

import "kab/jit/jit_wr_loop_neg"
import "kab/jit/jit_run_loop_neg"
import "kab/jit/jit_mm_call_loop_neg"
import "kab/jit/jit_loop_neg"

pub fn jitCallLoopNegOk(base, kind, n, bytes) {
    if jitLoopNegOk(n) == false {
        return false
    }
    if jitWrLoopNegOk(bytes, n) == false {
        return false
    }
    if jitRunLoopNegOk(base, kind, bytes, n) == false {
        return false
    }
    let rax = jitMmCallLoopNeg(bytes, n)
    if rax != jitLoopNegRax(n) {
        return false
    }
    return true
}
