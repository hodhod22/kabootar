// SH17 widen: mmap+exec policy for arith3 template.
// import "kab/jit/jit_run_loop_arith3"
// Do not grow jit_run_loop_f64.kab.

import "kab/jit/jit_mmap_loop"
import "kab/jit/jit_np"
import "kab/jit/jit_exec"
import "kab/jit/jit_mm_loop_arith3"
import "kab/jit/jit_patch_loop_arith3"
import "kab/jit/jit_arith3"

pub fn jitRunLoopArith3Ok(base, kind, bytes, a, b, c, o1, o2) {
    if base <= 0 {
        return false
    }
    if jitPatchLoopArith3Ok(bytes, a, b, c, o1, o2) == false {
        return false
    }
    let nb = len(bytes)
    if jitMmapLoopOk(nb, kind) == false {
        return false
    }
    if jitOsMmapLoopArith3Ok(nb, kind, a, b, c, o1, o2) == false {
        return false
    }
    let pages = jitPagesFor(nb)
    if jitExecOk(pages, kind) == false {
        return false
    }
    return true
}
