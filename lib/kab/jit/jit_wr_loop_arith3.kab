// SH17 widen: translate+store for arith3 template.
// import "kab/jit/jit_wr_loop_arith3"
// Do not grow jit_wr_loop_f64.kab.

import "kab/jit/jit_patch_loop_arith3"
import "kab/jit/jit_mm_loop_arith3"
import "kab/jit/jit_mm_store_loop_arith3"
import "kab/jit/jit_arith3"

pub fn jitWrLoopArith3Ok(bytes, a, b, c, o1, o2) {
    if jitPatchLoopArith3Ok(bytes, a, b, c, o1, o2) == false {
        return false
    }
    let pid = jitMmLoopArith3Pid()
    let virt = jitMmLoopArith3Virt()
    let p0 = os_mm_translate(pid, virt)
    if p0 <= 0 {
        return false
    }
    let p7 = os_mm_translate(pid, virt + 7)
    if p7 <= 0 {
        return false
    }
    let w = jitMmStoreLoopArith3(bytes, a, b, c, o1, o2)
    if w != jitArith3Len() {
        return false
    }
    return true
}
