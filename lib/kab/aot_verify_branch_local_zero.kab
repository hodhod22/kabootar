// F10: native image filename and local-zero branch must agree.
// import "kab/aot_verify_branch_local_zero"; do not import other kab/aot* leaves.

pub fn aotVerifyBranchLocalZeroOk(name, op) {
    if name == "kabootar-x64.kbn" {
        return op == "48837df8007400"
    }
    if name == "kabootar-arm64.kbn" {
        return op == "a00b40f91f0000f154000000"
    }
    return false
}
