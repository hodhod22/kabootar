// SH18 deepen: multi-frame bump + cycle under frame budget. import "kab/gc_load"
// Do not grow gc.kab or gc_cycle.kab. Simulates load without host GC heap.

import "kab/gc"
import "kab/gc_cycle"
import "kab/gc_bar"

/// One gray object per frame-budget tick (local; avoids gc_conc import binding in module).
pub fn gcLoadMarkStep(gray, budgetMs) {
    if budgetMs <= 0 {
        return gray
    }
    if gray <= 0 {
        return 0
    }
    return gray - 1
}

/// One full nursery fill bump triggers collect predicate.
pub fn gcLoadBumpOk() {
    let cap = gcNurseryCap()
    let u = gcBump(0, cap)
    return gcNeedCollect(u, cap)
}

/// Nursery cycle after cap fill; `live` bytes survive promote+sweep.
pub fn gcLoadCycleOk(live) {
    let cap = gcNurseryCap()
    return gcNurseryCycleOk(cap, 8, live)
}

/// Bump→cycle, then mark slices each within 16ms frame budget until `live` gray left.
pub fn gcLoadFramesOk(live) {
    if gcLoadCycleOk(live) == false {
        return false
    }
    if gcWriteBarrier(1, 2) == false {
        return false
    }
    let budget = gcFrameBudgetMs()
    let g1 = gcLoadMarkStep(4, budget)
    if g1 <= live {
        return false
    }
    let g2 = gcLoadMarkStep(g1, budget)
    if g2 != live {
        return false
    }
    return true
}
