@version "1.0.0"

// kOS visual polish (G12.5). import "kos/theme"
// CSS polish subset — not full GPU blur.

import "kss"
import "kdom/document"

pub fn applyKosTheme(shell) {
    let css = toCss({
        ".kos-desktop": {
            "border-radius": "0",
            "background": "#f0f2f5",
            "color": "#202124"
        },
        ".kos-taskbar": {
            "border-radius": "12px",
            "box-shadow": "0 2px 8px rgba(0,0,0,0.12)",
            "background": "#ffffff"
        },
        ".kos-window": {
            "border-radius": "12px",
            "box-shadow": "0 8px 24px rgba(0,0,0,0.18)",
            "background": "#ffffff"
        },
        ".kos-window-active": {
            "box-shadow": "0 12px 32px rgba(0,0,0,0.22)"
        }
    })
    kss(css)
    if shell != null && shell != undefined {
        query(shell, "#kos-desktop")
    }
    return shell
}
