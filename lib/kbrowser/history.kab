@version "1.0.0"

// H6c deepen: tab + history session policy in Kab. import "kbrowser/history"
// Page I/O still via kb_* natives; session stack lives in Kab.
// KEEP <=~7 top-level fn. Mutators always return session (Kab CoW writeback).

/// New browser session with one tab at `url`.
pub fn createSession(url) {
    let u = "" + url
    return {
        "tabs": [{ "id": 1, "url": u, "title": "Tab" }],
        "active": 0,
        "nextId": 2,
        "history": [u],
        "pos": 0,
        "moved": false
    }
}

pub fn currentUrl(session) {
    return session["history"][session["pos"]]
}

pub fn sessionNavigate(session, url) {
    let u = "" + url
    let hist = session["history"]
    let pos = session["pos"]
    let next = []
    let i = 0
    while i <= pos {
        next = push(next, hist[i])
        i = i + 1
    }
    next = push(next, u)
    session["history"] = next
    session["pos"] = len(next) - 1
    let tabs = session["tabs"]
    let ai = session["active"]
    let tab = tabs[ai]
    tab["url"] = u
    tabs[ai] = tab
    session["tabs"] = tabs
    session["moved"] = true
    return session
}

pub fn sessionBack(session) {
    let pos = session["pos"]
    if pos <= 0 {
        session["moved"] = false
        return session
    }
    session["pos"] = pos - 1
    let u = session["history"][session["pos"]]
    let tabs = session["tabs"]
    let ai = session["active"]
    let tab = tabs[ai]
    tab["url"] = u
    tabs[ai] = tab
    session["tabs"] = tabs
    session["moved"] = true
    return session
}

pub fn sessionForward(session) {
    let hist = session["history"]
    let pos = session["pos"]
    if pos + 1 >= len(hist) {
        session["moved"] = false
        return session
    }
    session["pos"] = pos + 1
    let u = hist[session["pos"]]
    let tabs = session["tabs"]
    let ai = session["active"]
    let tab = tabs[ai]
    tab["url"] = u
    tabs[ai] = tab
    session["tabs"] = tabs
    session["moved"] = true
    return session
}

pub fn sessionOpenTab(session, url) {
    let u = "" + url
    let id = session["nextId"]
    session["nextId"] = id + 1
    let tabs = session["tabs"]
    tabs = push(tabs, { "id": id, "url": u, "title": "Tab" })
    session["tabs"] = tabs
    session["active"] = len(tabs) - 1
    session["history"] = [u]
    session["pos"] = 0
    session["moved"] = true
    return session
}

pub fn sessionCloseTab(session, tabIndex) {
    let tabs = session["tabs"]
    if tabIndex < 0 || tabIndex >= len(tabs) {
        session["moved"] = false
        return session
    }
    
    let newTabs = []
    let i = 0
    while i < len(tabs) {
        if i != tabIndex {
            newTabs = push(newTabs, tabs[i])
        }
        i = i + 1
    }
    
    if len(newTabs) == 0 {
        newTabs = push(newTabs, { "id": 1, "url": "kabootar://home", "title": "Home" })
        session["nextId"] = 2
        session["active"] = 0
        session["history"] = ["kabootar://home"]
        session["pos"] = 0
    } else {
        if session["active"] >= len(newTabs) {
            session["active"] = len(newTabs) - 1
        }
        let activeTab = newTabs[session["active"]]
        session["history"] = [activeTab["url"]]
        session["pos"] = 0
    }
    
    session["tabs"] = newTabs
    session["moved"] = true
    return session
}

pub fn sessionSwitchTab(session, tabIndex) {
    let tabs = session["tabs"]
    if tabIndex < 0 || tabIndex >= len(tabs) {
        session["moved"] = false
        return session
    }
    
    let tab = tabs[tabIndex]
    session["active"] = tabIndex
    session["history"] = [tab["url"]]
    session["pos"] = 0
    session["moved"] = true
    return session
}

pub fn sessionTabCount(session) {
    return len(session["tabs"])
}
