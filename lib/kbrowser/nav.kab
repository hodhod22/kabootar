@version "1.0.0"

// H6c delete-gate: Kab session is source of truth; kb_navigate loads/paints only.
// import "kbrowser/nav"
// KEEP <=~7 top-level fn.

import "kbrowser/history"
import "kbrowser/session"
import "kbrowser/load_policy"
import "kbrowser/theme"

let navSession = null

// SH27 delete-gate: install Kab product-policy hooks on the host render slot —
// home-page DOM via theme.homePage, page titles via load_policy.titleFromUrl.
// Host keeps fetch/parse/paint; these decide content, not how to fetch it.
kb_set_home_provider(homePage)
kb_set_title_provider(titleFromUrl)

// Requested fetch-mode preference ("auto" | "kabootar" | "host") — Kab owns the
// preference; load_policy.effectiveMode resolves the per-URL fetch mode.
let navModePref = "auto"

// KB-H2: Kab load_policy picks the fetch mode; the host's effective_mode
// mirror (and its Auto retry in load_page) stays as fallback only.
fn navApplyMode(url) {
    kb_set_os_mode(effectiveMode(url, navModePref))
}

/// Pin or auto the requested fetch mode on the product path.
pub fn navSetMode(mode) {
    navModePref = "" + mode
    if navSession != null {
        navApplyMode(currentUrl(navSession))
    }
    return navModePref
}

pub fn bootNav(url) {
    navSession = resumeSession(url)
    navApplyMode(currentUrl(navSession))
    kb_navigate(currentUrl(navSession))
    saveSession(navSession)
    return navSession
}

pub fn navGo(url) {
    if navSession == null {
        bootNav(url)
    }
    navSession = sessionNavigate(navSession, url)
    navApplyMode(currentUrl(navSession))
    kb_navigate(currentUrl(navSession))
    saveSession(navSession)
    return navSession["moved"]
}

pub fn navBack() {
    if navSession == null {
        return false
    }
    navSession = sessionBack(navSession)
    if navSession["moved"] == true {
        navApplyMode(currentUrl(navSession))
        kb_navigate(currentUrl(navSession))
        saveSession(navSession)
    }
    return navSession["moved"]
}

pub fn navForward() {
    if navSession == null {
        return false
    }
    navSession = sessionForward(navSession)
    if navSession["moved"] == true {
        navApplyMode(currentUrl(navSession))
        kb_navigate(currentUrl(navSession))
        saveSession(navSession)
    }
    return navSession["moved"]
}

pub fn navOpenTab(url) {
    if navSession == null {
        bootNav(url)
        return navSession
    }
    navSession = sessionOpenTab(navSession, url)
    navApplyMode(currentUrl(navSession))
    kb_navigate(currentUrl(navSession))
    saveSession(navSession)
    return navSession
}

pub fn navCloseTab(tabIndex) {
    if navSession == null {
        return navSession
    }
    navSession = sessionCloseTab(navSession, tabIndex)
    if navSession["moved"] == true {
        navApplyMode(currentUrl(navSession))
        kb_navigate(currentUrl(navSession))
        saveSession(navSession)
    }
    return navSession
}

pub fn navSwitchTab(tabIndex) {
    if navSession == null {
        return navSession
    }
    navSession = sessionSwitchTab(navSession, tabIndex)
    if navSession["moved"] == true {
        navApplyMode(currentUrl(navSession))
        kb_navigate(currentUrl(navSession))
        saveSession(navSession)
    }
    return navSession
}

pub fn navListTabs() {
    if navSession == null {
        return []
    }
    return navSession["tabs"]
}

pub fn navUrl() {
    if navSession == null {
        return ""
    }
    return currentUrl(navSession)
}
