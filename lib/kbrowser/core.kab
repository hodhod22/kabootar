@version "1.0.0"

// Kabootar Browser core wrappers. import "kbrowser/core"
// KEEP <=~7 top-level fn. Nav/tabs via Kab session; kb_navigate = load/paint only.

import "kbrowser/nav"

pub fn navigate(url) {
    return navGo(url)
}

pub fn paint() {
    return kb_paint()
}

pub fn sync() {
    return kb_sync_platform()
}

pub fn info() {
    return kb_os_info()
}

pub fn tabs() {
    return navListTabs()
}

pub fn back() {
    return navBack()
}

pub fn openTab(url) {
    return navOpenTab(url)
}
