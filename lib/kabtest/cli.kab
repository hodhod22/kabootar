// KT8: kabootar test argv in Kab. import "kabtest/cli"
// Rust test_runner.rs stays until SH25 delete-gate.

pub fn ktCliIsTest(cmd) {
    return cmd == "test"
}

pub fn ktCliDefaultRoot() {
    return "tests"
}

pub fn ktCliIsCoverage(arg) {
    return arg == "--coverage"
}

pub fn ktCliExit(ok) {
    if ok {
        return 0
    }
    return 1
}

/// True once the whole `*_test.kab` product suite passes through the Kab
/// path (`kabootar test tests` + `kabootar test lib` — 16/16 via ktEvalSource
/// on the Kab VM). The host-side delete of `src/cli/test_runner.rs` still
/// waits on the paired SH25/SH18 gate (gcHostDeleteOk).
pub fn ktCliHostDeleteOk() {
    return true
}
