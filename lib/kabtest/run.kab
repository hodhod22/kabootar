// KT2: discover test filenames. import "kabtest/run"

pub fn ktIsTestFile(name) {
    let s = "" + name
    let a = str_includes(s, "_test.kab")
    if a {
        return true
    }
    return str_includes(s, ".test.kab")
}

/// Pass semantics matching the retired Rust runner: Bool(b) → b,
/// object → ok iff ok==true, null/other → pass.
pub fn ktResultIsPass(v) {
    let t = typeof(v)
    if t == "boolean" {
        return v
    }
    if t == "object" {
        if v == null {
            return true
        }
        return v["ok"] == true
    }
    return true
}

pub fn ktCount3(a, b, c) {
    let n = 0
    let x = ktIsTestFile(a)
    if x {
        n = n + 1
    }
    let y = ktIsTestFile(b)
    if y {
        n = n + 1
    }
    let z = ktIsTestFile(c)
    if z {
        n = n + 1
    }
    return n
}
