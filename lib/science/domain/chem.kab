@version "1.0.0"

// SC6i domain — chem / molekyl-featurize-lite. import "science" first.

/// Count atoms from SMILES string or atom-symbol array (["C","C","O"]).
pub fn atomCounts(smiles) {
    let counts = { "C": 0, "N": 0, "O": 0, "H": 0, "S": 0, "P": 0, "F": 0, "Cl": 0, "Br": 0, "other": 0 }
    let i = 0
    let n = len(smiles)
    while i < n {
        let c = smiles[i]
        if c == "Cl" || (c == "C" && i + 1 < n && smiles[i + 1] == "l") {
            counts["Cl"] = counts["Cl"] + 1
            if c == "C" {
                i = i + 2
            } else {
                i = i + 1
            }
        } else {
            if c == "Br" || (c == "B" && i + 1 < n && smiles[i + 1] == "r") {
                counts["Br"] = counts["Br"] + 1
                if c == "B" {
                    i = i + 2
                } else {
                    i = i + 1
                }
            } else {
                if c == "C" {
                    counts["C"] = counts["C"] + 1
                } else {
                    if c == "N" {
                        counts["N"] = counts["N"] + 1
                    } else {
                        if c == "O" {
                            counts["O"] = counts["O"] + 1
                        } else {
                            if c == "H" {
                                counts["H"] = counts["H"] + 1
                            } else {
                                if c == "S" {
                                    counts["S"] = counts["S"] + 1
                                } else {
                                    if c == "P" {
                                        counts["P"] = counts["P"] + 1
                                    } else {
                                        if c == "F" {
                                            counts["F"] = counts["F"] + 1
                                        } else {
                                            counts["other"] = counts["other"] + 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                i = i + 1
            }
        }
    }
    return counts
}

pub fn molecularWeight(smiles) {
    let a = atomCounts(smiles)
    return a["C"] * 12.011 + a["N"] * 14.007 + a["O"] * 15.999 + a["H"] * 1.008 + a["S"] * 32.06 + a["P"] * 30.974 + a["F"] * 18.998 + a["Cl"] * 35.45 + a["Br"] * 79.904
}

/// Bag-of-atoms feature vector [C,N,O,H,S,P,F,Cl,Br].
pub fn atomFingerprint(smiles) {
    let a = atomCounts(smiles)
    return [a["C"] * 1.0, a["N"] * 1.0, a["O"] * 1.0, a["H"] * 1.0, a["S"] * 1.0, a["P"] * 1.0, a["F"] * 1.0, a["Cl"] * 1.0, a["Br"] * 1.0]
}
