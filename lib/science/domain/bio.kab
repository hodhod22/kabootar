@version "1.0.0"

// SC6i domain — bio/sekvens-lite. import "science" first.

pub fn gcContent(seq) {
    let n = len(seq)
    if n == 0 {
        return 0.0
    }
    let gc = 0.0
    let i = 0
    while i < n {
        let c = seq[i]
        if c == "G" || c == "C" || c == "g" || c == "c" {
            gc = gc + 1.0
        }
        i = i + 1
    }
    return gc / n
}

pub fn kmerCount(seq, k) {
    let counts = {}
    let i = 0
    while i + k <= len(seq) {
        let mer = ""
        let j = 0
        while j < k {
            mer = mer + seq[i + j]
            j = j + 1
        }
        let cur = counts[mer]
        if cur == null || cur == undefined {
            cur = 0
        }
        counts[mer] = cur + 1
        i = i + 1
    }
    return counts
}
