@version "1.0.0"

// SC domain — 1D PDE finite-difference helpers. import "science/domain/pde"

/// FTCS heat equation step: u_t = alpha u_xx (Dirichlet ends fixed).
pub fn heat1dStep(u, alpha, dx, dt) {
    let n = len(u)
    let out = []
    let r = alpha * dt / (dx * dx)
    let i = 0
    while i < n {
        if i == 0 || i == n - 1 {
            out = push(out, u[i])
        } else {
            out = push(out, u[i] + r * (u[i - 1] - 2.0 * u[i] + u[i + 1]))
        }
        i = i + 1
    }
    return out
}

/// Centered wave step: u_tt = c^2 u_xx. Needs previous field uPrev.
pub fn wave1dStep(u, uPrev, c, dx, dt) {
    let n = len(u)
    let out = []
    let r = (c * dt / dx) * (c * dt / dx)
    let i = 0
    while i < n {
        if i == 0 || i == n - 1 {
            out = push(out, u[i])
        } else {
            let v = 2.0 * u[i] - uPrev[i] + r * (u[i - 1] - 2.0 * u[i] + u[i + 1])
            out = push(out, v)
        }
        i = i + 1
    }
    return out
}

/// Jacobi iteration for -u'' = f on [0,1] grid with fixed ends.
pub fn poisson1dJacobi(u, f, dx, iters) {
    if iters == null || iters < 1 {
        iters = 20
    }
    let n = len(u)
    let k = 0
    while k < iters {
        let nxt = []
        let i = 0
        while i < n {
            if i == 0 || i == n - 1 {
                nxt = push(nxt, u[i])
            } else {
                let v = 0.5 * (u[i - 1] + u[i + 1] + dx * dx * f[i])
                nxt = push(nxt, v)
            }
            i = i + 1
        }
        u = nxt
        k = k + 1
    }
    return u
}

/// Max abs residual of -u'' - f (interior).
pub fn poisson1dResidual(u, f, dx) {
    let n = len(u)
    let maxe = 0.0
    let i = 1
    while i < n - 1 {
        let lap = (u[i - 1] - 2.0 * u[i] + u[i + 1]) / (dx * dx)
        let e = 0.0 - lap - f[i]
        if e < 0.0 {
            e = 0.0 - e
        }
        if e > maxe {
            maxe = e
        }
        i = i + 1
    }
    return maxe
}

/// 2D FTCS heat step on nested grid (Dirichlet boundary fixed).
pub fn heat2dStep(u, alpha, dx, dy, dt) {
    let ny = len(u)
    let nx = len(u[0])
    let rx = alpha * dt / (dx * dx)
    let ry = alpha * dt / (dy * dy)
    let out = []
    let j = 0
    while j < ny {
        let row = []
        let i = 0
        while i < nx {
            if j == 0 || j == ny - 1 || i == 0 || i == nx - 1 {
                row = push(row, u[j][i])
            } else {
                let v = u[j][i] + rx * (u[j][i - 1] - 2.0 * u[j][i] + u[j][i + 1]) + ry * (u[j - 1][i] - 2.0 * u[j][i] + u[j + 1][i])
                row = push(row, v)
            }
            i = i + 1
        }
        out = push(out, row)
        j = j + 1
    }
    return out
}

/// 2D Jacobi for -Laplace u = f (Dirichlet boundary).
pub fn poisson2dJacobi(u, f, dx, dy, iters) {
    if iters == null || iters < 1 {
        iters = 30
    }
    let ny = len(u)
    let nx = len(u[0])
    let k = 0
    while k < iters {
        let nxt = []
        let j = 0
        while j < ny {
            let row = []
            let i = 0
            while i < nx {
                if j == 0 || j == ny - 1 || i == 0 || i == nx - 1 {
                    row = push(row, u[j][i])
                } else {
                    let v = ((u[j][i - 1] + u[j][i + 1]) / (dx * dx) + (u[j - 1][i] + u[j + 1][i]) / (dy * dy) + f[j][i]) / (2.0 / (dx * dx) + 2.0 / (dy * dy))
                    row = push(row, v)
                }
                i = i + 1
            }
            nxt = push(nxt, row)
            j = j + 1
        }
        u = nxt
        k = k + 1
    }
    return u
}

/// Max abs residual of -Laplace u - f (interior, dx=dy).
pub fn poisson2dResidual(u, f, dx) {
    let ny = len(u)
    let nx = len(u[0])
    let maxe = 0.0
    let j = 1
    while j < ny - 1 {
        let i = 1
        while i < nx - 1 {
            let lap = (u[j][i - 1] + u[j][i + 1] + u[j - 1][i] + u[j + 1][i] - 4.0 * u[j][i]) / (dx * dx)
            let e = 0.0 - lap - f[j][i]
            if e < 0.0 {
                e = 0.0 - e
            }
            if e > maxe {
                maxe = e
            }
            i = i + 1
        }
        j = j + 1
    }
    return maxe
}

/// 3D FTCS heat step on nested grid u[nz][ny][nx] (Dirichlet boundary fixed).
pub fn heat3dStep(u, alpha, dx, dy, dz, dt) {
    let nz = len(u)
    let ny = len(u[0])
    let nx = len(u[0][0])
    let rx = alpha * dt / (dx * dx)
    let ry = alpha * dt / (dy * dy)
    let rz = alpha * dt / (dz * dz)
    let out = []
    let k = 0
    while k < nz {
        let plane = []
        let j = 0
        while j < ny {
            let row = []
            let i = 0
            while i < nx {
                if k == 0 || k == nz - 1 || j == 0 || j == ny - 1 || i == 0 || i == nx - 1 {
                    row = push(row, u[k][j][i])
                } else {
                    let v = u[k][j][i] + rx * (u[k][j][i - 1] - 2.0 * u[k][j][i] + u[k][j][i + 1]) + ry * (u[k][j - 1][i] - 2.0 * u[k][j][i] + u[k][j + 1][i]) + rz * (u[k - 1][j][i] - 2.0 * u[k][j][i] + u[k + 1][j][i])
                    row = push(row, v)
                }
                i = i + 1
            }
            plane = push(plane, row)
            j = j + 1
        }
        out = push(out, plane)
        k = k + 1
    }
    return out
}

/// 3D Jacobi for -Laplace u = f (Dirichlet boundary).
pub fn poisson3dJacobi(u, f, dx, dy, dz, iters) {
    if iters == null || iters < 1 {
        iters = 30
    }
    let nz = len(u)
    let ny = len(u[0])
    let nx = len(u[0][0])
    let den = 2.0 / (dx * dx) + 2.0 / (dy * dy) + 2.0 / (dz * dz)
    let t = 0
    while t < iters {
        let nxt = []
        let k = 0
        while k < nz {
            let plane = []
            let j = 0
            while j < ny {
                let row = []
                let i = 0
                while i < nx {
                    if k == 0 || k == nz - 1 || j == 0 || j == ny - 1 || i == 0 || i == nx - 1 {
                        row = push(row, u[k][j][i])
                    } else {
                        let v = ((u[k][j][i - 1] + u[k][j][i + 1]) / (dx * dx) + (u[k][j - 1][i] + u[k][j + 1][i]) / (dy * dy) + (u[k - 1][j][i] + u[k + 1][j][i]) / (dz * dz) + f[k][j][i]) / den
                        row = push(row, v)
                    }
                    i = i + 1
                }
                plane = push(plane, row)
                j = j + 1
            }
            nxt = push(nxt, plane)
            k = k + 1
        }
        u = nxt
        t = t + 1
    }
    return u
}

/// Max abs residual of -Laplace u - f (interior, dx=dy=dz).
pub fn poisson3dResidual(u, f, dx) {
    let nz = len(u)
    let ny = len(u[0])
    let nx = len(u[0][0])
    let maxe = 0.0
    let k = 1
    while k < nz - 1 {
        let j = 1
        while j < ny - 1 {
            let i = 1
            while i < nx - 1 {
                let lap = (u[k][j][i - 1] + u[k][j][i + 1] + u[k][j - 1][i] + u[k][j + 1][i] + u[k - 1][j][i] + u[k + 1][j][i] - 6.0 * u[k][j][i]) / (dx * dx)
                let e = 0.0 - lap - f[k][j][i]
                if e < 0.0 {
                    e = 0.0 - e
                }
                if e > maxe {
                    maxe = e
                }
                i = i + 1
            }
            j = j + 1
        }
        k = k + 1
    }
    return maxe
}

/// FEM lite: assemble 1D Poisson stiffness (Dirichlet ends) as dense n x n.
pub fn femAssemblePoisson1d(n, h) {
    let kmat = []
    let i = 0
    while i < n {
        let row = []
        let j = 0
        while j < n {
            row = push(row, 0.0)
            j = j + 1
        }
        kmat = push(kmat, row)
        i = i + 1
    }
    let e = 0
    while e < n - 1 {
        let a = 1.0 / h
        kmat[e][e] = kmat[e][e] + a
        kmat[e][e + 1] = kmat[e][e + 1] - a
        kmat[e + 1][e] = kmat[e + 1][e] - a
        kmat[e + 1][e + 1] = kmat[e + 1][e + 1] + a
        e = e + 1
    }
    // Strong Dirichlet on ends.
    kmat[0][0] = 1.0
    let j = 1
    while j < n {
        kmat[0][j] = 0.0
        j = j + 1
    }
    kmat[n - 1][n - 1] = 1.0
    j = 0
    while j < n - 1 {
        kmat[n - 1][j] = 0.0
        j = j + 1
    }
    return kmat
}

/// FEM lite: Jacobi solve K u = f.
pub fn femSolveJacobi(kmat, f, iters) {
    if iters == null || iters < 1 {
        iters = 40
    }
    let n = len(f)
    let u = []
    let i = 0
    while i < n {
        u = push(u, 0.0)
        i = i + 1
    }
    let t = 0
    while t < iters {
        let nxt = []
        i = 0
        while i < n {
            let s = f[i]
            let j = 0
            while j < n {
                if j != i {
                    s = s - kmat[i][j] * u[j]
                }
                j = j + 1
            }
            nxt = push(nxt, s / kmat[i][i])
            i = i + 1
        }
        u = nxt
        t = t + 1
    }
    return u
}
