@version "1.0.0"

// GPU tensor wrappers (SC4b/e). import "science" first.

pub fn from(data, shape) {
    return gpu_tensor_from(data, shape)
}

pub fn zeros(shape) {
    return gpu_zeros(shape)
}

pub fn ones(shape) {
    return gpu_ones(shape)
}

pub fn scale(t, s) {
    return gpu_scale(t, s)
}

pub fn add(a, b) {
    return gpu_add(a, b)
}

pub fn toDevice(t) {
    return gpu_to_device(t)
}

pub fn toHost(t) {
    return gpu_to_host(t)
}

pub fn matmul(a, b) {
    return gpu_matmul(a, b)
}

pub fn matmulKernel(a, b) {
    return gpu_matmul_kernel(a, b)
}

pub fn linear(w, x, b) {
    return gpu_linear(w, x, b)
}

pub fn conv2d(x, w, b, stride, pad) {
    return gpu_conv2d(x, w, b, stride, pad)
}

pub fn conv2dKernel(x, w, b, stride, pad) {
    return gpu_conv2d_kernel(x, w, b, stride, pad)
}

pub fn kernels() {
    return gpu_available_kernels()
}

pub fn info() {
    return gpu_tensor_info()
}
