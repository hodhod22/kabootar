@version "1.0.0"

// SC6g — Visualisering & tolkningsbarhet (Kab-first). import "science" first.

/// ASCII confusion heatmap from ml_confusion matrix.
pub fn confusionHeat(y, pred, nClasses) {
    let m = ml_confusion(y, pred, nClasses)
    let lines = []
    let r = 0
    while r < len(m) {
        let row = ""
        let c = 0
        while c < len(m[r]) {
            row = row + ("" + m[r][c]) + " "
            c = c + 1
        }
        lines = push(lines, row)
        r = r + 1
    }
    return { "matrix": m, "ascii": lines, "mime": "text/plain" }
}

/// Learning-curve descriptor for notebook/rich display.
pub fn learningCurve(losses) {
    let plot = ascii_plot(losses)
    return { "losses": losses, "ascii": plot, "mime": "text/plain" }
}

pub fn meanCol(x, c) {
    let s = 0.0
    let n = 0.0
    let r = 0
    while r < len(x) {
        s = s + x[r][c]
        n = n + 1.0
        r = r + 1
    }
    return s / n
}

/// Permutation importance-lite: delta in MAE when shuffling one column.
/// predictFn(X) → predictions array; uses MAE vs y.
pub fn permutationImportance(x, y, predictFn, seed) {
    let basePred = predictFn(x)
    let base = 0.0
    let i = 0
    while i < len(y) {
        let d = y[i] - basePred[i]
        if d < 0.0 {
            d = 0.0 - d
        }
        base = base + d
        i = i + 1
    }
    base = base / len(y)
    let cols = len(x[0])
    let imps = []
    let c = 0
    let state = seed
    if state == null || state == undefined {
        state = 7.0
    }
    while c < cols {
        let shuffled = []
        let r = 0
        while r < len(x) {
            let row = []
            let j = 0
            while j < cols {
                row = push(row, x[r][j])
                j = j + 1
            }
            shuffled = push(shuffled, row)
            r = r + 1
        }
        // Fisher-Yates on column c
        r = len(shuffled) - 1
        while r > 0 {
            state = (1664525.0 * state + 1013904223.0) % 4294967296.0
            if state < 0.0 {
                state = state + 4294967296.0
            }
            let j = floor((state / 4294967296.0) * (r + 1))
            if j > r {
                j = r
            }
            let tmp = shuffled[r][c]
            shuffled[r][c] = shuffled[j][c]
            shuffled[j][c] = tmp
            r = r - 1
        }
        let pred = predictFn(shuffled)
        let mae = 0.0
        i = 0
        while i < len(y) {
            let d = y[i] - pred[i]
            if d < 0.0 {
                d = 0.0 - d
            }
            mae = mae + d
            i = i + 1
        }
        mae = mae / len(y)
        imps = push(imps, mae - base)
        c = c + 1
    }
    return { "base_mae": base, "importance": imps }
}

/// Feature importance proxy: |corr(col, y)| for tabular X.
pub fn corrImportance(x, y) {
    let cols = len(x[0])
    let imps = []
    let c = 0
    while c < cols {
        let xs = []
        let r = 0
        while r < len(x) {
            xs = push(xs, x[r][c])
            r = r + 1
        }
        let v = stat_corr(xs, y)
        if v < 0.0 {
            v = 0.0 - v
        }
        imps = push(imps, v)
        c = c + 1
    }
    return imps
}

/// Linear SHAP-lite: phi_i = w_i * (x_i - baseline_i); pred ≈ base + sum(phi).
/// model = {w, b, baseline?} where w is weight vector, b intercept.
pub fn shapLinear(model, x) {
    let w = model["w"]
    let b = model["b"]
    let baseline = model["baseline"]
    if baseline == null || baseline == undefined {
        baseline = []
        let i = 0
        while i < len(w) {
            baseline = push(baseline, 0.0)
            i = i + 1
        }
    }
    let phi = []
    let sum = b
    let i = 0
    while i < len(w) {
        let p = w[i] * (x[i] - baseline[i])
        phi = push(phi, p)
        sum = sum + p
        i = i + 1
    }
    let baseVal = b
    let j = 0
    while j < len(w) {
        baseVal = baseVal + w[j] * baseline[j]
        j = j + 1
    }
    return { "phi": phi, "base": baseVal, "pred": sum }
}

/// Kernel-SHAP-lite for ≤3 features: exact coalition enumeration for linear surrogate.
/// predictFn(row) → scalar; baseline = mean features.
pub fn shapKernelLite(x, baseline, predictFn) {
    let d = len(x)
    let basePred = predictFn(baseline)
    let phi = []
    let i = 0
    while i < d {
        phi = push(phi, 0.0)
        i = i + 1
    }
    // For each feature, contribution ≈ f(x) - f(x with feature i = baseline_i)
    let full = predictFn(x)
    i = 0
    while i < d {
        let masked = []
        let j = 0
        while j < d {
            if j == i {
                masked = push(masked, baseline[j])
            } else {
                masked = push(masked, x[j])
            }
            j = j + 1
        }
        phi[i] = full - predictFn(masked)
        i = i + 1
    }
    let sumPhi = 0.0
    i = 0
    while i < d {
        sumPhi = sumPhi + phi[i]
        i = i + 1
    }
    return { "phi": phi, "base": basePred, "pred": full, "check": basePred + sumPhi }
}
