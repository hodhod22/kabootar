@version "1.0.0"

// Autograd wrappers (SC2c/SC2f). import "science" first.

pub fn tensor(data) {
    return ag_tensor(data)
}

pub fn relu(t) {
    return ag_relu(t)
}

pub fn sigmoid(t) {
    return ag_sigmoid(t)
}

pub fn dense(w, x, b) {
    return ag_dense(w, x, b)
}

/// Matmul of flat tensors with explicit dims: C[m,n] = A[m,k] @ B[k,n].
pub fn matmul(a, b, m, k, n) {
    return ag_matmul(a, b, m, k, n)
}

pub fn conv2d(x, w, b, cin, hin, win, cout, kh, kw) {
    return ag_conv2d(x, w, b, cin, hin, win, cout, kh, kw)
}

pub fn softmax(t) {
    return ag_softmax(t)
}

pub fn add(a, b) {
    return ag_add(a, b)
}

pub fn sub(a, b) {
    return ag_sub(a, b)
}

pub fn mul(a, b) {
    return ag_mul(a, b)
}

pub fn div(a, b) {
    return ag_div(a, b)
}

pub fn sum(t) {
    return ag_sum(t)
}

pub fn exp(t) {
    return ag_exp(t)
}

pub fn mse(pred, target) {
    return ag_mse(pred, target)
}

pub fn ce(pred, target) {
    return ag_ce(pred, target)
}

pub fn noGrad(on) {
    return ag_no_grad(on)
}

pub fn enableGrad(on) {
    return ag_enable_grad(on)
}

/// Backward. createGraph=true keeps grad as tape nodes for higher-order.
pub fn backward(loss, createGraph) {
    if createGraph == null || createGraph == undefined {
        return ag_backward(loss)
    }
    return ag_backward(loss, createGraph)
}

pub fn grad(t) {
    return ag_grad(t)
}

/// Gradient as autograd tensor (requires backward(loss, true)).
pub fn gradTensor(t) {
    return ag_grad_tensor(t)
}

pub fn value(t) {
    return ag_value(t)
}

pub fn clear() {
    return ag_clear()
}
