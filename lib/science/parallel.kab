@version "1.0.0"

// science/parallel — SC7d local parallelism (not multi-node; see science/dist).
// Requires `import "science"`.

/// Split array into nChunks contiguous chunks.
pub fn chunk(xs, nChunks) {
    let n = len(xs)
    if nChunks < 1 {
        nChunks = 1
    }
    let size = floor((n + nChunks - 1) / nChunks)
    if size < 1 {
        size = 1
    }
    let out = []
    let i = 0
    while i < n {
        let end = i + size
        if end > n {
            end = n
        }
        let part = []
        let j = i
        while j < end {
            part = push(part, xs[j])
            j = j + 1
        }
        out = push(out, part)
        i = end
    }
    return out
}

/// Sequential map with Kab closure (same process).
pub fn mapItems(items, f) {
    return job_map(items, f)
}

/// Parallel f64 map — `op` is a built-in string name (e.g. "square"), not a closure.
pub fn mapParallel(items, op, nWorkers) {
    return job_map_parallel(items, op, nWorkers)
}

/// Chunked Kab-closure map plan (`job_map_chunks`).
pub fn mapChunks(items, f, nChunks) {
    return job_map_chunks(items, f, nChunks)
}

/// Local reduce-sum.
pub fn reduceSum(xs) {
    let s = 0.0
    let i = 0
    while i < len(xs) {
        s = s + xs[i]
        i = i + 1
    }
    return s
}

/// Map-reduce: chunk → mapFn(chunk) → reduceFn(results).
pub fn mapReduce(xs, nChunks, mapFn, reduceFn) {
    let mrParts = chunk(xs, nChunks)
    let mrMapped = []
    let mrI = 0
    while mrI < len(mrParts) {
        mrMapped = push(mrMapped, mapFn(mrParts[mrI]))
        mrI = mrI + 1
    }
    return reduceFn(mrMapped)
}

/// Flat concat of chunk results (after mapChunks / manual chunk map).
pub fn concatChunks(parts) {
    let out = []
    let i = 0
    while i < len(parts) {
        let p = parts[i]
        let j = 0
        while j < len(p) {
            out = push(out, p[j])
            j = j + 1
        }
        i = i + 1
    }
    return out
}

/// Nd-aware: map over flat data of an ndarray, return new nd with same shape.
pub fn mapNd(a, f) {
    let data = nd_to_array(a)
    let mapped = job_map(data, f)
    return nd_from(mapped, nd_shape(a))
}

/// Parallel f64 map on ndarray flat data (`op` string: square/double/relu/…).
pub fn mapNdParallel(a, op, nWorkers) {
    let data = nd_to_array(a)
    let mapped = job_map_parallel(data, op, nWorkers)
    return nd_from(mapped, nd_shape(a))
}

/// vmap-lite: apply `f` to each row of a 2D nd (or each element of 1D), stack results.
pub fn vmap(a, f) {
    let sh = nd_shape(a)
    if len(sh) == 1 {
        return mapNd(a, f)
    }
    if len(sh) != 2 {
        throw "vmap: expect 1D or 2D ndarray"
    }
    let rows = sh[0]
    let cols = sh[1]
    let data = nd_to_array(a)
    let outRows = []
    let r = 0
    while r < rows {
        let row = []
        let c = 0
        while c < cols {
            row = push(row, data[r * cols + c])
            c = c + 1
        }
        outRows = push(outRows, f(row))
        r = r + 1
    }
    return outRows
}
