@version "1.0.0"

// science/linalg — thin Kab wrappers over mat_* natives.
// import "science" then import "science/linalg"

pub fn mul(a, b) {
    return mat_mul(a, b)
}

pub fn inv(a) {
    return mat_inv(a)
}

pub fn det(a) {
    return mat_det(a)
}

pub fn transpose(a) {
    return mat_transpose(a)
}

/// Thin (default) or full QR. mode: "thin" | "full".
pub fn qr(a, mode) {
    if mode == null || mode == undefined {
        return mat_qr(a)
    }
    return mat_qr(a, mode)
}

/// Reconstruction residual max |A - QR|.
pub fn qrErr(a) {
    return mat_qr_err(a)
}

/// Thin (default) or full SVD. mode: "thin" | "full" | "econ".
pub fn svd(a, mode) {
    if mode == null || mode == undefined {
        return mat_svd(a)
    }
    return mat_svd(a, mode)
}

/// Randomized SVD (Halko). nOver and seed optional.
pub fn randomizedSvd(a, rank, nOver, seed) {
    if seed != null && seed != undefined {
        return mat_randomized_svd(a, rank, nOver, seed)
    }
    if nOver != null && nOver != undefined {
        return mat_randomized_svd(a, rank, nOver)
    }
    return mat_randomized_svd(a, rank)
}

pub fn pinv(a) {
    return mat_pinv(a)
}

pub fn cholesky(a) {
    return mat_cholesky(a)
}

pub fn eig(a) {
    return mat_eig(a)
}

pub fn lstsq(a, b) {
    return mat_lstsq(a, b)
}

pub fn cond(a) {
    return mat_cond(a)
}

pub fn lu(a) {
    return mat_lu(a)
}

pub fn slogdet(a) {
    return mat_slogdet(a)
}

/// Matrix norm. ord: "fro" | "1" | "inf" (default fro).
pub fn normOrd(a, ord) {
    if ord == null || ord == undefined {
        return mat_norm_ord(a)
    }
    return mat_norm_ord(a, ord)
}

pub fn batchQr(batch, mode) {
    if mode == null || mode == undefined {
        return mat_batch_qr(batch)
    }
    return mat_batch_qr(batch, mode)
}

pub fn batchSvd(batch, mode) {
    if mode == null || mode == undefined {
        return mat_batch_svd(batch)
    }
    return mat_batch_svd(batch, mode)
}

pub fn batchSolve(batchA, batchB) {
    return mat_batch_solve(batchA, batchB)
}

pub fn batchEig(batch) {
    return mat_batch_eig(batch)
}

pub fn solve(a, b) {
    return nd_solve(a, b)
}

pub fn identity(n) {
    return mat_identity(n)
}
