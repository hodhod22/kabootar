@version "1.0.0"

// science/visualize — SC7b general visualization (not SHAP/explain).
// Requires `import "science"`. explain.kab stays interpretability-only.

/// ASCII sparkline / series plot.
pub fn plot(ys) {
    return ascii_plot(ys)
}

/// Line chart (canvas descriptor / ASCII fallback via natives).
pub fn line(ys, width, height) {
    return plot_line(ys, width, height)
}

/// Scatter plot.
pub fn scatter(xs, ys, width, height) {
    return plot_scatter(xs, ys, width, height)
}

/// Histogram.
pub fn hist(ys, bins, width, height) {
    return plot_hist(ys, bins, width, height)
}

/// Notebook / rich MIME wrapper.
pub fn rich(value) {
    return rich_display(value)
}

/// Format rows as a text table.
pub fn table(rows) {
    return format_table(rows)
}

fn flatSeries(a) {
    if a == null {
        return []
    }
    if a["shape"] != null && a["size"] != null {
        return nd_to_array(a)
    }
    return a
}

/// Plot ndarray (flattened) as ASCII series.
pub fn plotNd(a) {
    let ys = flatSeries(a)
    let ascii = ascii_plot(ys)
    return {
        "kind": "figure",
        "type": "line",
        "ascii": ascii,
        "n": len(ys),
        "mime": "text/plain"
    }
}

/// Line figure object (GC metadata + payload).
pub fn lineFigure(ys, width, height) {
    if width == null {
        width = 60
    }
    if height == null {
        height = 20
    }
    let payload = plot_line(ys, width, height)
    return {
        "kind": "figure",
        "type": "line",
        "width": width,
        "height": height,
        "payload": payload,
        "mime": "text/plain"
    }
}

/// Scatter figure object.
pub fn scatterFigure(xs, ys, width, height) {
    if width == null {
        width = 60
    }
    if height == null {
        height = 20
    }
    let payload = plot_scatter(xs, ys, width, height)
    return {
        "kind": "figure",
        "type": "scatter",
        "width": width,
        "height": height,
        "payload": payload,
        "mime": "text/plain"
    }
}

/// Simple ASCII heatmap from 2D nested array (rows of numbers).
pub fn heatmap(matrix) {
    let lines = []
    let r = 0
    while r < len(matrix) {
        let row = ""
        let c = 0
        while c < len(matrix[r]) {
            let v = matrix[r][c]
            let cell = "."
            if v > 0.75 {
                cell = "#"
            } else {
                if v > 0.5 {
                    cell = "*"
                } else {
                    if v > 0.25 {
                        cell = "+"
                    }
                }
            }
            row = row + cell
            c = c + 1
        }
        lines = push(lines, row)
        r = r + 1
    }
    return {
        "kind": "figure",
        "type": "heatmap",
        "ascii": lines,
        "rows": len(matrix),
        "mime": "text/plain"
    }
}

/// Heatmap from 2D ndarray (row-major).
pub fn heatmapNd(a) {
    let sh = nd_shape(a)
    if len(sh) != 2 {
        throw "heatmapNd: expect 2D ndarray"
    }
    let rows = sh[0]
    let cols = sh[1]
    let data = nd_to_array(a)
    let matrix = []
    let r = 0
    while r < rows {
        let row = []
        let c = 0
        while c < cols {
            row = push(row, data[r * cols + c])
            c = c + 1
        }
        matrix = push(matrix, row)
        r = r + 1
    }
    return heatmap(matrix)
}

/// Image-style display for 2D matrix (ASCII; alias of heatmap with type imshow).
pub fn imshow(matrix) {
    let fig = heatmap(matrix)
    fig["type"] = "imshow"
    return fig
}

/// imshow for 2D ndarray.
pub fn imshowNd(a) {
    let fig = heatmapNd(a)
    fig["type"] = "imshow"
    return fig
}
