@version "1.0.0"

// Kabootar science/ml — thin ML helpers (SC2).
// Call after `import "science"`.

pub fn relu(x) {
    return ml_relu(x)
}

pub fn sigmoid(x) {
    return ml_sigmoid(x)
}

pub fn softmax(x) {
    return ml_softmax(x)
}

pub fn mse(y, pred) {
    return ml_mse(y, pred)
}

pub fn dense(w, x, b) {
    return ml_dense(w, x, b)
}

pub fn denseRelu(w, x, b) {
    return ml_dense(w, x, b, true)
}

pub fn sgdUpdate(w, grad, lr) {
    return ml_sgd_update(w, grad, lr)
}

pub fn linregStep(params, x, y, lr) {
    return ml_linreg_step(params, x, y, lr)
}

pub fn pca(x, k) {
    return ml_pca(x, k)
}

pub fn kmeans(x, k, maxIter, seed) {
    return ml_kmeans(x, k, maxIter, seed)
}

pub fn logregFit(x, y, lr, epochs) {
    return ml_logreg_fit(x, y, lr, epochs)
}

pub fn logregPredict(model, x, threshold) {
    return ml_logreg_predict(model, x, threshold)
}

pub fn conv2d(input, weight, bias, stride, pad) {
    return ml_conv2d(input, weight, bias, stride, pad)
}

pub fn maxpool2d(input, ksize, stride) {
    return ml_maxpool2d(input, ksize, stride)
}

pub fn embedding(table, indices) {
    return ml_embedding(table, indices)
}

pub fn mha(q, k, v, nHeads) {
    return ml_mha(q, k, v, nHeads)
}

pub fn adamUpdate(w, grad, m, v, t, lr, beta1, beta2, eps) {
    return ml_adam_update(w, grad, m, v, t, lr, beta1, beta2, eps)
}

pub fn accuracy(y, pred) {
    return ml_accuracy(y, pred)
}

pub fn f1(y, pred) {
    return ml_f1(y, pred)
}

pub fn confusion(y, pred, nClasses) {
    return ml_confusion(y, pred, nClasses)
}

pub fn shuffle(items, seed) {
    return ml_shuffle(items, seed)
}

pub fn batchSlices(n, batchSize) {
    return ml_batch_slices(n, batchSize)
}

pub fn trainTestSplit(x, y, testRatio, seed) {
    return ml_train_test_split(x, y, testRatio, seed)
}

pub fn saveCheckpoint(path, weights) {
    return ml_save_checkpoint(path, weights)
}

pub fn loadCheckpoint(path) {
    return ml_load_checkpoint(path)
}

pub fn crossEntropy(pred, target) {
    return ml_cross_entropy(pred, target)
}
