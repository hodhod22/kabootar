@version "1.0.0"

// Kabootar science/nd — ndarray / tensor API (SC0 + zero-copy views).
// Call after `import "science"` so nd_* natives exist.
//
// Memory split:
//   • Buffer (`__buf` / NdShared): ownership-steered when unique — `ensureOwned`,
//     `take` (move). Views share the Rc (GC handles; cannot dangle).
//   • Graphs / models / metadata: GC (`science/lazy`, `science/tensor` meta).
// Mutate shared buffers via `ensureOwned` (COW).

pub fn zeros(shape) {
    return nd_zeros(shape)
}

pub fn ones(shape) {
    return nd_ones(shape)
}

pub fn from(data, shape) {
    return nd_from(data, shape)
}

pub fn fromVec(data) {
    return nd_from(data)
}

pub fn shape(a) {
    return nd_shape(a)
}

pub fn size(a) {
    return nd_size(a)
}

pub fn reshape(a, shape) {
    return nd_reshape(a, shape)
}

pub fn get(a, i) {
    return nd_get(a, i)
}

pub fn set(a, i, v) {
    return nd_set(a, i, v)
}

pub fn matmul(a, b) {
    return nd_matmul(a, b)
}

pub fn solve(a, b) {
    return nd_solve(a, b)
}

pub fn add(a, b) {
    return nd_add(a, b)
}

pub fn sub(a, b) {
    return nd_sub(a, b)
}

pub fn mul(a, b) {
    return nd_mul(a, b)
}

pub fn div(a, b) {
    return nd_div(a, b)
}

pub fn abs(a) {
    return nd_abs(a)
}

pub fn exp(a) {
    return nd_exp(a)
}

pub fn log(a) {
    return nd_log(a)
}

pub fn clip(a, lo, hi) {
    return nd_clip(a, lo, hi)
}

pub fn select(cond, x, y) {
    return nd_where(cond, x, y)
}

/// Integer-array gather along axis (default 0).
pub fn gather(a, indices, axis) {
    return nd_gather(a, indices, axis)
}

/// Boolean mask compress → 1D (`a[mask]` subset).
pub fn compress(a, mask) {
    return nd_compress(a, mask)
}

/// Flat indices of non-zero / true elements.
pub fn nonzero(a) {
    return nd_nonzero(a)
}

/// Gather along axis (alias of gather for NumPy take_along_axis lite).
pub fn takeAlong(a, indices, axis) {
    return nd_take_along(a, indices, axis)
}

/// Advanced indexing: one integer array per leading axis.
/// mode: "broadcast" (default) or "outer" (cartesian / multi-axis result).
pub fn fancyIndex(a, indexArrays, mode) {
    return nd_fancy_index(a, indexArrays, mode)
}

/// Outer fancy indexing (cartesian product of index arrays).
pub fn fancyOuter(a, indexArrays) {
    return nd_fancy_index(a, indexArrays, "outer")
}

/// Broadcast two shapes → result shape.
pub fn broadcastShapes(a, b) {
    return nd_broadcast_shapes(a, b)
}

/// Expand ndarray to target shape (NumPy broadcast_to).
pub fn broadcastTo(a, shape) {
    return nd_broadcast_to(a, shape)
}

/// Complex conjugate (no-op for real dtypes).
pub fn conj(a) {
    return nd_conj(a)
}

/// Zero-copy view: `slice(a, [[1,10], [0,3]])` shares parent buffer.
pub fn slice(a, ranges) {
    return nd_slice(a, ranges)
}

pub fn isView(a) {
    return nd_is_view(a)
}

pub fn bufRc(a) {
    return nd_buf_rc(a)
}

/// Materialize a unique owned copy (COW for mutation).
pub fn ensureOwned(a) {
    return nd_ensure_owned(a)
}

/// Move unique buffer to a new ndarray; source becomes `__moved`.
pub fn take(a) {
    return nd_take(a)
}

pub fn isMoved(a) {
    return nd_is_moved(a)
}

pub fn isOwner(a) {
    return nd_is_owner(a)
}

pub fn toArray(a) {
    return nd_to_array(a)
}

pub fn concat(arrays, axis) {
    return nd_concat(arrays, axis)
}

pub fn stack(arrays, axis) {
    return nd_stack(arrays, axis)
}

pub fn split(a, sections, axis) {
    return nd_split(a, sections, axis)
}

pub fn mean(a) {
    return nd_mean(a)
}

pub fn sum(a) {
    return nd_sum(a)
}

pub fn max(a) {
    return nd_max(a)
}

pub fn min(a) {
    return nd_min(a)
}

pub fn argmax(a) {
    return nd_argmax(a)
}

pub fn transpose(a) {
    return nd_transpose(a)
}

pub fn swapAxes(a, ax0, ax1) {
    return nd_swapaxes(a, ax0, ax1)
}

pub fn roll(a, shift) {
    return nd_roll(a, shift)
}

pub fn pad(a, pads) {
    return nd_pad(a, pads)
}

pub fn tensordot(a, b) {
    return nd_tensordot(a, b)
}

/// Einsum (general labels, ellipsis `...`, broadcast). Optional third operand via c.
pub fn einsum(subs, a, b, c) {
    if c != null && c != undefined {
        return nd_einsum(subs, a, b, c)
    }
    if b == null || b == undefined {
        return nd_einsum(subs, a)
    }
    return nd_einsum(subs, a, b)
}

pub fn dot(a, b) {
    return nd_dot(a, b)
}

pub fn dtype(a) {
    return nd_dtype(a)
}

pub fn astype(a, dt) {
    return nd_astype(a, dt)
}

pub fn seed(n) {
    return nd_seed(n)
}

pub fn randUniform(shape, low, high) {
    return nd_rand_uniform(shape, low, high)
}

pub fn randNormal(shape, mean, std) {
    return nd_rand_normal(shape, mean, std)
}

pub fn save(a, path) {
    return nd_save(a, path)
}

pub fn load(path) {
    return nd_load(path)
}

pub fn gemm(a, m, k, b, n) {
    return sci_gemm(a, m, k, b, n)
}

/// BLAS-style DGEMM (matrixmultiply SIMD kernels): C := alpha*A*B + beta*C.
pub fn blasDgemm(a, m, k, b, n, alpha, beta, c) {
    return sci_blas_dgemm(a, m, k, b, n, alpha, beta, c)
}

pub fn vadd(a, b) {
    return sci_vadd(a, b)
}

pub fn vmul(a, b) {
    return sci_vmul(a, b)
}

/// BLAS backend label: openblas / mkl / system_blas / matrixmultiply.
pub fn blasBackend() {
    return sci_blas_backend()
}

/// Set OpenBLAS/MKL/OMP thread count when the loaded BLAS exposes control.
pub fn blasSetNumThreads(n) {
    return sci_blas_set_num_threads(n)
}

pub fn blasNumThreads() {
    return sci_blas_num_threads()
}

/// { backend, threads, controllable }
pub fn blasInfo() {
    return sci_blas_info()
}
