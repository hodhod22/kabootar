@version "1.0.0"

// Kabootar science/nd — ndarray wrappers (SC0d/e/f).
// Call after `import "science"` so nd_* natives exist.

pub fn zeros(shape) {
    return nd_zeros(shape)
}

pub fn ones(shape) {
    return nd_ones(shape)
}

pub fn from(data, shape) {
    return nd_from(data, shape)
}

pub fn fromVec(data) {
    return nd_from(data)
}

pub fn matmul(a, b) {
    return nd_matmul(a, b)
}

pub fn solve(a, b) {
    return nd_solve(a, b)
}

pub fn add(a, b) {
    return nd_add(a, b)
}

pub fn sub(a, b) {
    return nd_sub(a, b)
}

pub fn mul(a, b) {
    return nd_mul(a, b)
}

pub fn div(a, b) {
    return nd_div(a, b)
}

pub fn abs(a) {
    return nd_abs(a)
}

pub fn exp(a) {
    return nd_exp(a)
}

pub fn log(a) {
    return nd_log(a)
}

pub fn clip(a, lo, hi) {
    return nd_clip(a, lo, hi)
}

pub fn select(cond, x, y) {
    return nd_where(cond, x, y)
}

pub fn slice(a, ranges) {
    return nd_slice(a, ranges)
}

pub fn concat(arrays, axis) {
    return nd_concat(arrays, axis)
}

pub fn stack(arrays, axis) {
    return nd_stack(arrays, axis)
}

pub fn split(a, sections, axis) {
    return nd_split(a, sections, axis)
}

pub fn mean(a) {
    return nd_mean(a)
}

pub fn dtype(a) {
    return nd_dtype(a)
}

pub fn astype(a, dt) {
    return nd_astype(a, dt)
}

pub fn seed(n) {
    return nd_seed(n)
}

pub fn randUniform(shape, low, high) {
    return nd_rand_uniform(shape, low, high)
}

pub fn randNormal(shape, mean, std) {
    return nd_rand_normal(shape, mean, std)
}

pub fn save(a, path) {
    return nd_save(a, path)
}

pub fn load(path) {
    return nd_load(path)
}

pub fn gemm(a, m, k, b, n) {
    return sci_gemm(a, m, k, b, n)
}

/// BLAS-style DGEMM: C := alpha*A*B + beta*C (row-major flat).
pub fn blasDgemm(a, m, k, b, n, alpha, beta, c) {
    return sci_blas_dgemm(a, m, k, b, n, alpha, beta, c)
}
