@version "1.0.0"

pub fn fft(x) {
    return num_fft(x)
}

pub fn ifft(x) {
    return num_ifft(x)
}

pub fn fftC(x) {
    return num_fft_c(x)
}

pub fn rfft(x) {
    return num_rfft(x)
}

pub fn irfft(x) {
    return num_irfft(x)
}

pub fn fftPad(x) {
    return num_fft_pad(x)
}

pub fn fftfreq(n, d) {
    if d == null || d == undefined {
        return num_fftfreq(n)
    }
    return num_fftfreq(n, d)
}

pub fn resample(x, nOut) {
    return num_resample(x, nOut)
}

pub fn hilbert(x) {
    return num_hilbert(x)
}

/// Spectrogram convenience over STFT.
pub fn spectrogram(signal, winSize, hop) {
    let s = num_stft(signal, winSize, hop)
    return { "kind": "spectrogram", "frames": s["frames"], "freqs": s["freqs"], "data": s["data"] }
}

pub fn fftN(matrix) {
    return num_fftn(matrix)
}

pub fn firwin(numtaps, cutoff) {
    return num_firwin(numtaps, cutoff)
}

pub fn butterBiquad(kind, cutoff, q) {
    if q == null || q == undefined {
        return num_butter_biquad(kind, cutoff)
    }
    return num_butter_biquad(kind, cutoff, q)
}

pub fn hann(n) {
    return num_window_hann(n)
}

pub fn hamming(n) {
    return num_window_hamming(n)
}

pub fn stft(signal, winSize, hop) {
    return num_stft(signal, winSize, hop)
}

pub fn fft2d(matrix) {
    return num_fft2d(matrix)
}

pub fn fir(signal, coeffs) {
    return num_fir(signal, coeffs)
}

pub fn movingAverage(signal, window) {
    return num_moving_average(signal, window)
}

pub fn iir(signal, b, a) {
    return num_iir(signal, b, a)
}

pub fn biquad(signal, b0, b1, b2, a0, a1, a2) {
    return num_biquad(signal, b0, b1, b2, a0, a1, a2)
}
