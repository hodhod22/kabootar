@version "1.0.0"

// SC6f — Förstärkningsinlärning-lite. import "science" first.

pub fn createEnv(nStates, nActions, rewards, transitions) {
    return {
        "n_states": nStates,
        "n_actions": nActions,
        "rewards": rewards,
        "transitions": transitions,
        "state": 0,
        "done": false
    }
}

pub fn reset(env) {
    env["state"] = 0
    env["done"] = false
    return env
}

/// step(env, action) → {env, reward, done, state}
pub fn step(env, action) {
    let s = env["state"]
    let key = ("" + s) + ":" + ("" + action)
    let nxt = env["transitions"][key]
    if nxt == null || nxt == undefined {
        nxt = s
    }
    let r = env["rewards"][key]
    if r == null || r == undefined {
        r = 0.0
    }
    env["state"] = nxt
    let done = false
    if nxt == env["n_states"] - 1 {
        done = true
    }
    env["done"] = done
    return { "env": env, "reward": r, "done": done, "state": nxt }
}

pub fn createReplay(capacity) {
    return { "buf": [], "capacity": capacity }
}

pub fn replayPush(replay, s, a, r, s2, done) {
    let buf = replay["buf"]
    buf = push(buf, { "s": s, "a": a, "r": r, "s2": s2, "done": done })
    if len(buf) > replay["capacity"] {
        let nb = []
        let i = 1
        while i < len(buf) {
            nb = push(nb, buf[i])
            i = i + 1
        }
        buf = nb
    }
    replay["buf"] = buf
    return replay
}

/// Tabular Q-learning update. Q is object keyed "s:a".
pub fn qLearnUpdate(q, s, a, r, s2, alpha, gamma, nActions) {
    let key = ("" + s) + ":" + ("" + a)
    let qsa = q[key]
    if qsa == null || qsa == undefined {
        qsa = 0.0
    }
    let maxNext = 0.0
    let first = true
    let a2 = 0
    while a2 < nActions {
        let k2 = ("" + s2) + ":" + ("" + a2)
        let v = q[k2]
        if v == null || v == undefined {
            v = 0.0
        }
        if first || v > maxNext {
            maxNext = v
            first = false
        }
        a2 = a2 + 1
    }
    q[key] = qsa + alpha * (r + gamma * maxNext - qsa)
    return q
}

pub fn greedyAction(q, s, nActions) {
    let best = 0
    let bestV = 0.0
    let first = true
    let a = 0
    while a < nActions {
        let v = q[("" + s) + ":" + ("" + a)]
        if v == null || v == undefined {
            v = 0.0
        }
        if first || v > bestV {
            bestV = v
            best = a
            first = false
        }
        a = a + 1
    }
    return best
}

/// Softmax over a preference vector.
pub fn softmaxPrefs(prefs) {
    let maxv = prefs[0]
    let i = 1
    while i < len(prefs) {
        if prefs[i] > maxv {
            maxv = prefs[i]
        }
        i = i + 1
    }
    let ex = []
    let sum = 0.0
    i = 0
    while i < len(prefs) {
        let e = exp(prefs[i] - maxv)
        ex = push(ex, e)
        sum = sum + e
        i = i + 1
    }
    let out = []
    i = 0
    while i < len(ex) {
        out = push(out, ex[i] / sum)
        i = i + 1
    }
    return out
}

/// Sample action from softmax prefs (deterministic argmax if rng is null).
pub fn sampleAction(prefs, rng) {
    let p = softmaxPrefs(prefs)
    if rng == null || rng == undefined {
        let best = 0
        let i = 1
        while i < len(p) {
            if p[i] > p[best] {
                best = i
            }
            i = i + 1
        }
        return best
    }
    let u = rng
    let cum = 0.0
    let i = 0
    while i < len(p) {
        cum = cum + p[i]
        if u <= cum {
            return i
        }
        i = i + 1
    }
    return len(p) - 1
}

/// REINFORCE update: prefs[a] += lr * advantage * (1 - pi[a]); others -= lr * advantage * pi[i].
/// Returns updated preference vector.
pub fn reinforceUpdate(prefs, action, advantage, lr) {
    let pi = softmaxPrefs(prefs)
    let out = []
    let i = 0
    while i < len(prefs) {
        let g = 0.0 - pi[i]
        if i == action {
            g = 1.0 - pi[i]
        }
        out = push(out, prefs[i] + lr * advantage * g)
        i = i + 1
    }
    return out
}
