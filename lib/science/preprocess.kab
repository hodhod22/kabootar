@version "1.0.0"

// SC6b — Förbearbetning & feature engineering. import "science" first.

pub fn colCount(x) {
    if len(x) == 0 {
        return 0
    }
    return len(x[0])
}

pub fn colMeans(x) {
    let rows = len(x)
    let cols = colCount(x)
    let means = []
    let c = 0
    while c < cols {
        let s = 0.0
        let n = 0.0
        let r = 0
        while r < rows {
            let v = x[r][c]
            if v != null && v != undefined {
                s = s + v
                n = n + 1.0
            }
            r = r + 1
        }
        let m = 0.0
        if n > 0.0 {
            m = s / n
        }
        means = push(means, m)
        c = c + 1
    }
    return means
}

pub fn colStds(x, means) {
    let rows = len(x)
    let cols = len(means)
    let stds = []
    let c = 0
    while c < cols {
        let s = 0.0
        let n = 0.0
        let r = 0
        while r < rows {
            let v = x[r][c]
            if v != null && v != undefined {
                let d = v - means[c]
                s = s + d * d
                n = n + 1.0
            }
            r = r + 1
        }
        let sd = 1.0
        if n > 1.0 {
            sd = sqrt(s / (n - 1.0))
        }
        if sd < 0.000000000001 {
            sd = 1.0
        }
        stds = push(stds, sd)
        c = c + 1
    }
    return stds
}

pub fn colMinMax(x) {
    let rows = len(x)
    let cols = colCount(x)
    let mins = []
    let maxs = []
    let c = 0
    while c < cols {
        let lo = x[0][c]
        let hi = x[0][c]
        let r = 1
        while r < rows {
            let v = x[r][c]
            if v < lo {
                lo = v
            }
            if v > hi {
                hi = v
            }
            r = r + 1
        }
        mins = push(mins, lo)
        maxs = push(maxs, hi)
        c = c + 1
    }
    return { "min": mins, "max": maxs }
}

/// Fit+transform standard scale. Returns {X, mean, std}.
pub fn standardScale(x) {
    let means = colMeans(x)
    let stds = colStds(x, means)
    let out = []
    let r = 0
    while r < len(x) {
        let row = []
        let c = 0
        while c < len(means) {
            row = push(row, (x[r][c] - means[c]) / stds[c])
            c = c + 1
        }
        out = push(out, row)
        r = r + 1
    }
    return { "X": out, "mean": means, "std": stds }
}

pub fn transformStandard(model, x) {
    let out = []
    let r = 0
    while r < len(x) {
        let row = []
        let c = 0
        while c < len(model["mean"]) {
            row = push(row, (x[r][c] - model["mean"][c]) / model["std"][c])
            c = c + 1
        }
        out = push(out, row)
        r = r + 1
    }
    return out
}

pub fn minmaxScale(x) {
    let mm = colMinMax(x)
    let mins = mm["min"]
    let maxs = mm["max"]
    let out = []
    let r = 0
    while r < len(x) {
        let row = []
        let c = 0
        while c < len(mins) {
            let den = maxs[c] - mins[c]
            if den < 0.000000000001 {
                den = 1.0
            }
            row = push(row, (x[r][c] - mins[c]) / den)
            c = c + 1
        }
        out = push(out, row)
        r = r + 1
    }
    return { "X": out, "min": mins, "max": maxs }
}

pub fn imputeMean(x) {
    let means = colMeans(x)
    let out = []
    let r = 0
    while r < len(x) {
        let row = []
        let c = 0
        while c < len(means) {
            let v = x[r][c]
            if v == null || v == undefined {
                v = means[c]
            }
            row = push(row, v)
            c = c + 1
        }
        out = push(out, row)
        r = r + 1
    }
    return { "X": out, "mean": means }
}

pub fn oneHot(labels, nClasses) {
    let n = len(labels)
    let k = nClasses
    if k == null || k == undefined {
        k = 0
        let i = 0
        while i < n {
            if labels[i] + 1 > k {
                k = labels[i] + 1
            }
            i = i + 1
        }
    }
    let out = []
    let i = 0
    while i < n {
        let row = []
        let c = 0
        while c < k {
            if c == labels[i] {
                row = push(row, 1.0)
            } else {
                row = push(row, 0.0)
            }
            c = c + 1
        }
        out = push(out, row)
        i = i + 1
    }
    return out
}

/// Polynomial features for 1-column or first-two-column interaction-lite.
pub fn polyFeatures(x, degree) {
    let out = []
    let r = 0
    while r < len(x) {
        let row = []
        let v = x[r][0]
        let d = 1
        while d <= degree {
            row = push(row, pow(v, d))
            d = d + 1
        }
        if len(x[r]) > 1 && degree >= 2 {
            row = push(row, x[r][0] * x[r][1])
        }
        out = push(out, row)
        r = r + 1
    }
    return out
}
