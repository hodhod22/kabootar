@version "1.0.0"

// SC6e — Tidsserieanalys (Kab-first). import "science" first.

pub fn lag(xs, k) {
    let out = []
    let i = 0
    while i < len(xs) {
        if i < k {
            out = push(out, null)
        } else {
            out = push(out, xs[i - k])
        }
        i = i + 1
    }
    return out
}

pub fn rollingMean(xs, window) {
    let out = []
    let i = 0
    while i < len(xs) {
        let s = 0.0
        let c = 0.0
        let j = 0
        while j < window {
            if i >= j {
                s = s + xs[i - j]
                c = c + 1.0
            }
            j = j + 1
        }
        out = push(out, s / c)
        i = i + 1
    }
    return out
}

pub fn meanSlice(xs, a, b) {
    let s = 0.0
    let n = 0.0
    let i = a
    while i < b {
        s = s + xs[i]
        n = n + 1.0
        i = i + 1
    }
    if n < 1.0 {
        return 0.0
    }
    return s / n
}

/// ACF at lag k (Pearson on overlapping pairs).
pub fn acf(xs, k) {
    let n = len(xs)
    if k <= 0 || k >= n {
        return 0.0
    }
    let m = meanSlice(xs, 0, n)
    let num = 0.0
    let den = 0.0
    let i = 0
    while i < n {
        let d = xs[i] - m
        den = den + d * d
        i = i + 1
    }
    i = k
    while i < n {
        num = num + (xs[i] - m) * (xs[i - k] - m)
        i = i + 1
    }
    if den < 0.000000000001 {
        return 0.0
    }
    return num / den
}

/// Naive seasonal decompose: trend = rolling mean, seasonal = mean residual per season, resid = rest.
pub fn seasonalDecompose(xs, period) {
    let trend = rollingMean(xs, period)
    let seas = []
    let p = 0
    while p < period {
        let s = 0.0
        let c = 0.0
        let i = p
        while i < len(xs) {
            s = s + (xs[i] - trend[i])
            c = c + 1.0
            i = i + period
        }
        let v = 0.0
        if c > 0.0 {
            v = s / c
        }
        seas = push(seas, v)
        p = p + 1
    }
    let seasonal = []
    let resid = []
    let i = 0
    while i < len(xs) {
        let sv = seas[i % period]
        seasonal = push(seasonal, sv)
        resid = push(resid, xs[i] - trend[i] - sv)
        i = i + 1
    }
    return { "trend": trend, "seasonal": seasonal, "resid": resid, "period": period }
}

/// AR(1) least-squares: y_t = a + b * y_{t-1}
pub fn ar1Fit(xs) {
    let n = len(xs)
    if n < 3 {
        return { "a": 0.0, "b": 0.0 }
    }
    let sx = 0.0
    let sy = 0.0
    let sxx = 0.0
    let sxy = 0.0
    let c = 0.0
    let i = 1
    while i < n {
        let x = xs[i - 1]
        let y = xs[i]
        sx = sx + x
        sy = sy + y
        sxx = sxx + x * x
        sxy = sxy + x * y
        c = c + 1.0
        i = i + 1
    }
    let den = c * sxx - sx * sx
    let b = 0.0
    let a = 0.0
    if den > 0.000000000001 || den < 0.0 - 0.000000000001 {
        b = (c * sxy - sx * sy) / den
        a = (sy - b * sx) / c
    }
    return { "a": a, "b": b }
}

pub fn ar1Forecast(model, last, steps) {
    let out = []
    let y = last
    let i = 0
    while i < steps {
        y = model["a"] + model["b"] * y
        out = push(out, y)
        i = i + 1
    }
    return out
}

pub fn forecastMae(yTrue, yHat) {
    let n = len(yTrue)
    if n == 0 || n != len(yHat) {
        return 0.0
    }
    let s = 0.0
    let i = 0
    while i < n {
        let d = yTrue[i] - yHat[i]
        if d < 0.0 {
            d = 0.0 - d
        }
        s = s + d
        i = i + 1
    }
    return s / n
}

pub fn diff1(xs) {
    let out = []
    let i = 1
    while i < len(xs) {
        out = push(out, xs[i] - xs[i - 1])
        i = i + 1
    }
    return out
}

/// ARIMA(1,1,0)-lite: difference once, fit AR(1), store last level.
pub fn arima110Fit(xs) {
    let d = diff1(xs)
    let ar = ar1Fit(d)
    return {
        "a": ar["a"],
        "b": ar["b"],
        "last": xs[len(xs) - 1],
        "last_diff": d[len(d) - 1],
        "order": [1, 1, 0]
    }
}

pub fn arima110Forecast(model, steps) {
    let out = []
    let level = model["last"]
    let diff = model["last_diff"]
    let i = 0
    while i < steps {
        diff = model["a"] + model["b"] * diff
        level = level + diff
        out = push(out, level)
        i = i + 1
    }
    return out
}

/// ARIMA(1,1,1)-lite: ARIMA(1,1,0) + residual MA(1) on differenced series.
pub fn arima111Fit(xs) {
    let base = arima110Fit(xs)
    let d = diff1(xs)
    let resid = []
    let prev = 0.0
    let i = 1
    while i < len(d) {
        let pred = base["a"] + base["b"] * d[i - 1]
        let e = d[i] - pred
        resid = push(resid, e)
        i = i + 1
    }
    // MA(1) coef ≈ corr(e_t, e_{t-1})
    let theta = 0.0
    if len(resid) > 2 {
        let sx = 0.0
        let sy = 0.0
        let sxx = 0.0
        let sxy = 0.0
        let c = 0.0
        i = 1
        while i < len(resid) {
            let x = resid[i - 1]
            let y = resid[i]
            sx = sx + x
            sy = sy + y
            sxx = sxx + x * x
            sxy = sxy + x * y
            c = c + 1.0
            i = i + 1
        }
        let den = c * sxx - sx * sx
        if den > 0.000000000001 || den < 0.0 - 0.000000000001 {
            theta = (c * sxy - sx * sy) / den
        }
    }
    base["theta"] = theta
    base["last_resid"] = 0.0
    if len(resid) > 0 {
        base["last_resid"] = resid[len(resid) - 1]
    }
    base["order"] = [1, 1, 1]
    let _ = prev
    return base
}

pub fn arima111Forecast(model, steps) {
    let out = []
    let level = model["last"]
    let diff = model["last_diff"]
    let resid = model["last_resid"]
    let i = 0
    while i < steps {
        let innov = 0.0
        diff = model["a"] + model["b"] * diff + model["theta"] * resid
        resid = innov
        level = level + diff
        out = push(out, level)
        i = i + 1
    }
    return out
}
