@version "1.0.0"

// SC5b — algorithms in pure Kab (call only thin natives where needed).
// import "science" then `import "science/kab_algo"`.

pub fn mean(xs) {
    let n = len(xs)
    if n == 0 {
        return 0.0
    }
    let s = 0.0
    let i = 0
    while i < n {
        s = s + xs[i]
        i = i + 1
    }
    return s / n
}

pub fn variance(xs) {
    let n = len(xs)
    if n < 2 {
        return 0.0
    }
    let m = mean(xs)
    let s = 0.0
    let i = 0
    while i < n {
        let d = xs[i] - m
        s = s + d * d
        i = i + 1
    }
    return s / (n - 1)
}

pub fn std(xs) {
    return sqrt(variance(xs))
}

pub fn zscore(xs) {
    let m = mean(xs)
    let s = std(xs)
    let out = []
    let i = 0
    while i < len(xs) {
        let z = 0.0
        if s > 0.000000000001 {
            z = (xs[i] - m) / s
        }
        out = push(out, z)
        i = i + 1
    }
    return out
}

pub fn reluKab(xs) {
    let out = []
    let i = 0
    while i < len(xs) {
        let v = xs[i]
        if v < 0.0 {
            v = 0.0
        }
        out = push(out, v)
        i = i + 1
    }
    return out
}

pub fn mseKab(y, pred) {
    let n = len(y)
    if n == 0 || n != len(pred) {
        return 0.0
    }
    let s = 0.0
    let i = 0
    while i < n {
        let d = y[i] - pred[i]
        s = s + d * d
        i = i + 1
    }
    return s / n
}

pub fn clipKab(xs, lo, hi) {
    let out = []
    let i = 0
    while i < len(xs) {
        let v = xs[i]
        if v < lo {
            v = lo
        }
        if v > hi {
            v = hi
        }
        out = push(out, v)
        i = i + 1
    }
    return out
}

pub fn softmaxKab(xs) {
    let maxv = xs[0]
    let i = 1
    while i < len(xs) {
        if xs[i] > maxv {
            maxv = xs[i]
        }
        i = i + 1
    }
    let ex = []
    let sum = 0.0
    i = 0
    while i < len(xs) {
        let e = exp(xs[i] - maxv)
        ex = push(ex, e)
        sum = sum + e
        i = i + 1
    }
    let out = []
    i = 0
    while i < len(ex) {
        out = push(out, ex[i] / sum)
        i = i + 1
    }
    return out
}

/// Simple 1D linreg in Kab: returns [slope, intercept].
pub fn linregKab(xs, ys) {
    let n = len(xs)
    if n == 0 || n != len(ys) {
        return [0.0, 0.0]
    }
    let mx = mean(xs)
    let my = mean(ys)
    let num = 0.0
    let den = 0.0
    let i = 0
    while i < n {
        num = num + (xs[i] - mx) * (ys[i] - my)
        den = den + (xs[i] - mx) * (xs[i] - mx)
        i = i + 1
    }
    let slope = 0.0
    if den > 0.000000000001 {
        slope = num / den
    }
    return [slope, my - slope * mx]
}

/// Dot product in Kab (small vectors).
pub fn dotKab(a, b) {
    let n = len(a)
    if n != len(b) {
        return 0.0
    }
    let s = 0.0
    let i = 0
    while i < n {
        s = s + a[i] * b[i]
        i = i + 1
    }
    return s
}

/// Moving average via Kab loop (SC5b port of boxcar).
pub fn movingAvgKab(xs, window) {
    let out = []
    let i = 0
    while i < len(xs) {
        let s = 0.0
        let c = 0
        let k = 0
        while k < window {
            if i >= k {
                s = s + xs[i - k]
                c = c + 1
            }
            k = k + 1
        }
        out = push(out, s / c)
        i = i + 1
    }
    return out
}

pub fn sigmoidKab(xs) {
    let out = []
    let i = 0
    while i < len(xs) {
        out = push(out, 1.0 / (1.0 + exp(0.0 - xs[i])))
        i = i + 1
    }
    return out
}

pub fn argmaxKab(xs) {
    if len(xs) == 0 {
        return 0
    }
    let best = 0
    let i = 1
    while i < len(xs) {
        if xs[i] > xs[best] {
            best = i
        }
        i = i + 1
    }
    return best
}

pub fn accuracyKab(y, pred) {
    let n = len(y)
    if n == 0 || n != len(pred) {
        return 0.0
    }
    let ok = 0.0
    let i = 0
    while i < n {
        if y[i] == pred[i] {
            ok = ok + 1.0
        }
        i = i + 1
    }
    return ok / n
}

pub fn covKab(xs, ys) {
    let n = len(xs)
    if n < 2 || n != len(ys) {
        return 0.0
    }
    let mx = mean(xs)
    let my = mean(ys)
    let s = 0.0
    let i = 0
    while i < n {
        s = s + (xs[i] - mx) * (ys[i] - my)
        i = i + 1
    }
    return s / (n - 1)
}

pub fn corrKab(xs, ys) {
    let sx = std(xs)
    let sy = std(ys)
    if sx < 0.000000000001 || sy < 0.000000000001 {
        return 0.0
    }
    return covKab(xs, ys) / (sx * sy)
}

pub fn trapzKab(xs, ys) {
    let n = len(xs)
    if n < 2 || n != len(ys) {
        return 0.0
    }
    let s = 0.0
    let i = 0
    while i < n - 1 {
        s = s + 0.5 * (xs[i + 1] - xs[i]) * (ys[i] + ys[i + 1])
        i = i + 1
    }
    return s
}

pub fn lerpKab(a, b, t) {
    return a + (b - a) * t
}

pub fn normalizeL2Kab(xs) {
    let nrm = sqrt(dotKab(xs, xs))
    if nrm < 0.000000000001 {
        return xs
    }
    let out = []
    let i = 0
    while i < len(xs) {
        out = push(out, xs[i] / nrm)
        i = i + 1
    }
    return out
}

fn sortCopyKab(xs) {
    let sorted = []
    let i = 0
    while i < len(xs) {
        sorted = push(sorted, xs[i])
        i = i + 1
    }
    let n = len(sorted)
    i = 1
    while i < n {
        let key = sorted[i]
        let j = i
        while j > 0 {
            if sorted[j - 1] <= key {
                break
            }
            sorted[j] = sorted[j - 1]
            j = j - 1
        }
        sorted[j] = key
        i = i + 1
    }
    return sorted
}

pub fn medianKab(xs) {
    let n = len(xs)
    if n == 0 {
        return 0.0
    }
    let sorted = sortCopyKab(xs)
    if n % 2 == 1 {
        return sorted[floor(n / 2)]
    }
    let a = sorted[floor(n / 2) - 1]
    let b = sorted[floor(n / 2)]
    return 0.5 * (a + b)
}

pub fn percentileKab(xs, p) {
    let n = len(xs)
    if n == 0 {
        return 0.0
    }
    if p < 0.0 {
        p = 0.0
    }
    if p > 100.0 {
        p = 100.0
    }
    let sorted = sortCopyKab(xs)
    let rank = (p / 100.0) * (n - 1)
    let lo = floor(rank)
    let hi = lo + 1
    if hi >= n {
        return sorted[n - 1]
    }
    let t = rank - lo
    return sorted[lo] + (sorted[hi] - sorted[lo]) * t
}

pub fn crossEntropyKab(logits, target) {
    let probs = softmaxKab(logits)
    let t = floor(target)
    if t < 0 {
        t = 0
    }
    if t >= len(probs) {
        t = len(probs) - 1
    }
    let p = probs[t]
    if p < 0.000000000001 {
        p = 0.000000000001
    }
    return 0.0 - log(p)
}

pub fn oneHotKab(index, nClasses) {
    let out = []
    let i = 0
    let idx = floor(index)
    while i < nClasses {
        if i == idx {
            out = push(out, 1.0)
        } else {
            out = push(out, 0.0)
        }
        i = i + 1
    }
    return out
}

pub fn matmulKab(a, m, k, b, n) {
    // a: m*k row-major, b: k*n -> c: m*n
    let out = []
    let i = 0
    while i < m {
        let j = 0
        while j < n {
            let s = 0.0
            let t = 0
            while t < k {
                s = s + a[i * k + t] * b[t * n + j]
                t = t + 1
            }
            out = push(out, s)
            j = j + 1
        }
        i = i + 1
    }
    return out
}

pub fn f1Kab(y, pred) {
    let n = len(y)
    if n == 0 || n != len(pred) {
        return 0.0
    }
    let tp = 0.0
    let fp = 0.0
    let fnv = 0.0
    let i = 0
    while i < n {
        if pred[i] == 1.0 && y[i] == 1.0 {
            tp = tp + 1.0
        }
        if pred[i] == 1.0 && y[i] != 1.0 {
            fp = fp + 1.0
        }
        if pred[i] != 1.0 && y[i] == 1.0 {
            fnv = fnv + 1.0
        }
        i = i + 1
    }
    let prec = 0.0
    if tp + fp > 0.0 {
        prec = tp / (tp + fp)
    }
    let rec = 0.0
    if tp + fnv > 0.0 {
        rec = tp / (tp + fnv)
    }
    if prec + rec < 0.000000000001 {
        return 0.0
    }
    return 2.0 * prec * rec / (prec + rec)
}

pub fn confusionKab(y, pred, nClasses) {
    let mat = []
    let r = 0
    while r < nClasses {
        let row = []
        let c = 0
        while c < nClasses {
            row = push(row, 0.0)
            c = c + 1
        }
        mat = push(mat, row)
        r = r + 1
    }
    let i = 0
    while i < len(y) {
        let yi = floor(y[i])
        let pi = floor(pred[i])
        if yi >= 0 && yi < nClasses && pi >= 0 && pi < nClasses {
            mat[yi][pi] = mat[yi][pi] + 1.0
        }
        i = i + 1
    }
    return mat
}

fn rowMeanKab(X) {
    let n = len(X)
    let d = len(X[0])
    let mean = []
    let j = 0
    while j < d {
        mean = push(mean, 0.0)
        j = j + 1
    }
    let i = 0
    while i < n {
        j = 0
        while j < d {
            mean[j] = mean[j] + X[i][j]
            j = j + 1
        }
        i = i + 1
    }
    j = 0
    while j < d {
        mean[j] = mean[j] / n
        j = j + 1
    }
    return mean
}

/// PCA-lite via power iteration on covariance (top component).
/// X: array of rows. Returns { mean, component, scores }.
pub fn pcaKab(X, nIter) {
    if nIter == null || nIter == undefined {
        nIter = 40
    }
    let n = len(X)
    let d = len(X[0])
    let mean = rowMeanKab(X)
    let xc = []
    let i = 0
    while i < n {
        let row = []
        let j = 0
        while j < d {
            row = push(row, X[i][j] - mean[j])
            j = j + 1
        }
        xc = push(xc, row)
        i = i + 1
    }
    // init component
    let w = []
    let j = 0
    while j < d {
        w = push(w, 1.0 / d)
        j = j + 1
    }
    let it = 0
    while it < nIter {
        let tw = []
        j = 0
        while j < d {
            tw = push(tw, 0.0)
            j = j + 1
        }
        i = 0
        while i < n {
            let proj = 0.0
            j = 0
            while j < d {
                proj = proj + xc[i][j] * w[j]
                j = j + 1
            }
            j = 0
            while j < d {
                tw[j] = tw[j] + proj * xc[i][j]
                j = j + 1
            }
            i = i + 1
        }
        w = normalizeL2Kab(tw)
        it = it + 1
    }
    let scores = []
    i = 0
    while i < n {
        let proj = 0.0
        j = 0
        while j < d {
            proj = proj + xc[i][j] * w[j]
            j = j + 1
        }
        scores = push(scores, proj)
        i = i + 1
    }
    return { "mean": mean, "component": w, "scores": scores }
}

/// Decision stump on one feature: scan thresholds midpoints.
/// X rows, y labels 0/1. Returns { feature, threshold, left, right }.
pub fn stumpKab(X, y) {
    let n = len(X)
    let d = len(X[0])
    let best = { "feature": 0, "threshold": 0.0, "left": 0.0, "right": 1.0, "err": n }
    let f = 0
    while f < d {
        let vals = []
        let i = 0
        while i < n {
            vals = push(vals, X[i][f])
            i = i + 1
        }
        let sorted = sortCopyKab(vals)
        let t = 0
        while t < n - 1 {
            let thr = 0.5 * (sorted[t] + sorted[t + 1])
            let leftVotes = [0.0, 0.0]
            let rightVotes = [0.0, 0.0]
            i = 0
            while i < n {
                let lab = floor(y[i])
                if lab < 0 {
                    lab = 0
                }
                if lab > 1 {
                    lab = 1
                }
                if X[i][f] <= thr {
                    leftVotes[lab] = leftVotes[lab] + 1.0
                } else {
                    rightVotes[lab] = rightVotes[lab] + 1.0
                }
                i = i + 1
            }
            let left = 0.0
            if leftVotes[1] > leftVotes[0] {
                left = 1.0
            }
            let right = 0.0
            if rightVotes[1] > rightVotes[0] {
                right = 1.0
            }
            let err = 0.0
            i = 0
            while i < n {
                let pred = right
                if X[i][f] <= thr {
                    pred = left
                }
                if pred != y[i] {
                    err = err + 1.0
                }
                i = i + 1
            }
            if err < best["err"] {
                best = { "feature": f, "threshold": thr, "left": left, "right": right, "err": err }
            }
            t = t + 1
        }
        f = f + 1
    }
    return best
}

pub fn stumpPredictKab(stump, X) {
    let out = []
    let i = 0
    while i < len(X) {
        let v = X[i][stump["feature"]]
        if v <= stump["threshold"] {
            out = push(out, stump["left"])
        } else {
            out = push(out, stump["right"])
        }
        i = i + 1
    }
    return out
}

/// k-means lite (forgy init: first k rows). Returns { centroids, labels }.
pub fn kmeansKab(X, k, maxIter) {
    if maxIter == null || maxIter == undefined {
        maxIter = 20
    }
    let n = len(X)
    let d = len(X[0])
    if k < 1 {
        k = 1
    }
    if k > n {
        k = n
    }
    let centroids = []
    let c = 0
    while c < k {
        let row = []
        let j = 0
        while j < d {
            row = push(row, X[c][j])
            j = j + 1
        }
        centroids = push(centroids, row)
        c = c + 1
    }
    let labels = []
    let i = 0
    while i < n {
        labels = push(labels, 0)
        i = i + 1
    }
    let it = 0
    while it < maxIter {
        i = 0
        while i < n {
            let best = 0
            let bestD = 1000000000.0
            c = 0
            while c < k {
                let dist = 0.0
                let j = 0
                while j < d {
                    let diff = X[i][j] - centroids[c][j]
                    dist = dist + diff * diff
                    j = j + 1
                }
                if dist < bestD {
                    bestD = dist
                    best = c
                }
                c = c + 1
            }
            labels[i] = best
            i = i + 1
        }
        c = 0
        while c < k {
            let sum = []
            let j = 0
            while j < d {
                sum = push(sum, 0.0)
                j = j + 1
            }
            let cnt = 0.0
            i = 0
            while i < n {
                if labels[i] == c {
                    j = 0
                    while j < d {
                        sum[j] = sum[j] + X[i][j]
                        j = j + 1
                    }
                    cnt = cnt + 1.0
                }
                i = i + 1
            }
            if cnt > 0.0 {
                j = 0
                while j < d {
                    centroids[c][j] = sum[j] / cnt
                    j = j + 1
                }
            }
            c = c + 1
        }
        it = it + 1
    }
    return { "centroids": centroids, "labels": labels, "k": k }
}

fn bootstrapIdxKab(n, seed) {
    let idx = []
    let i = 0
    while i < n {
        // Small integer mix (avoid huge LCG floats).
        let r = (i * 5 + seed * 3 + 11) % n
        if r < 0 {
            r = 0 - r
        }
        idx = push(idx, r % n)
        i = i + 1
    }
    // Shuffle-lite second pass for diversity
    i = 0
    while i < n {
        let j = (i * 7 + seed) % n
        let tmp = idx[i]
        idx[i] = idx[j]
        idx[j] = tmp
        i = i + 1
    }
    return idx
}

fn subsetXYKab(X, y, idx) {
    let Xs = []
    let ys = []
    let i = 0
    while i < len(idx) {
        Xs = push(Xs, X[idx[i]])
        ys = push(ys, y[idx[i]])
        i = i + 1
    }
    return { "X": Xs, "y": ys }
}

/// Bagged decision stumps (forest-lite).
pub fn baggingStumpsKab(X, y, nTrees, seed) {
    if nTrees == null || nTrees < 1 {
        nTrees = 5
    }
    if seed == null || seed == undefined {
        seed = 42
    }
    let trees = []
    let t = 0
    while t < nTrees {
        let idx = bootstrapIdxKab(len(X), seed + t * 17)
        let sub = subsetXYKab(X, y, idx)
        let stump = stumpKab(sub["X"], sub["y"])
        trees = push(trees, stump)
        t = t + 1
    }
    return { "kind": "BaggingStumps", "trees": trees, "nTrees": nTrees }
}

/// Majority-vote predict for baggingStumps / forest.
pub fn forestPredictKab(forest, X) {
    let trees = forest["trees"]
    let out = []
    let i = 0
    while i < len(X) {
        let votes0 = 0.0
        let votes1 = 0.0
        let t = 0
        while t < len(trees) {
            let pred = stumpPredictKab(trees[t], [X[i]])
            if pred[0] == 1.0 {
                votes1 = votes1 + 1.0
            } else {
                votes0 = votes0 + 1.0
            }
            t = t + 1
        }
        if votes1 > votes0 {
            out = push(out, 1.0)
        } else {
            out = push(out, 0.0)
        }
        i = i + 1
    }
    return out
}

/// Shallow recursive tree via repeated stump splits (maxDepth).
pub fn treeKab(X, y, maxDepth) {
    if maxDepth == null || maxDepth < 1 {
        maxDepth = 2
    }
    return treeNodeKab(X, y, 0, maxDepth)
}

fn majorityLabelKab(y) {
    let c0 = 0.0
    let c1 = 0.0
    let i = 0
    while i < len(y) {
        if y[i] == 1.0 {
            c1 = c1 + 1.0
        } else {
            c0 = c0 + 1.0
        }
        i = i + 1
    }
    if c1 > c0 {
        return 1.0
    }
    return 0.0
}

fn treeNodeKab(X, y, depth, maxDepth) {
    if len(X) == 0 {
        return { "leaf": true, "label": 0.0 }
    }
    if depth >= maxDepth {
        return { "leaf": true, "label": majorityLabelKab(y) }
    }
    let stump = stumpKab(X, y)
    if stump["err"] >= len(y) {
        return { "leaf": true, "label": majorityLabelKab(y) }
    }
    // Perfect stump: stop with stump children (do not collapse to majority leaf).
    if stump["err"] == 0.0 {
        return {
            "leaf": false,
            "feature": stump["feature"],
            "threshold": stump["threshold"],
            "left": { "leaf": true, "label": stump["left"] },
            "right": { "leaf": true, "label": stump["right"] }
        }
    }
    let leftX = []
    let leftY = []
    let rightX = []
    let rightY = []
    let i = 0
    while i < len(X) {
        if X[i][stump["feature"]] <= stump["threshold"] {
            leftX = push(leftX, X[i])
            leftY = push(leftY, y[i])
        } else {
            rightX = push(rightX, X[i])
            rightY = push(rightY, y[i])
        }
        i = i + 1
    }
    if len(leftX) == 0 || len(rightX) == 0 {
        return { "leaf": true, "label": majorityLabelKab(y) }
    }
    return {
        "leaf": false,
        "feature": stump["feature"],
        "threshold": stump["threshold"],
        "left": treeNodeKab(leftX, leftY, depth + 1, maxDepth),
        "right": treeNodeKab(rightX, rightY, depth + 1, maxDepth)
    }
}

pub fn treePredictKab(tree, X) {
    let out = []
    let i = 0
    while i < len(X) {
        out = push(out, treePredictOneKab(tree, X[i]))
        i = i + 1
    }
    return out
}

fn treePredictOneKab(node, row) {
    if node["leaf"] == true {
        return node["label"]
    }
    if row[node["feature"]] <= node["threshold"] {
        return treePredictOneKab(node["left"], row)
    }
    return treePredictOneKab(node["right"], row)
}

/// AdaBoost-lite over decision stumps (binary 0/1 labels).
pub fn boostStumpsKab(X, y, nRounds) {
    if nRounds == null || nRounds < 1 {
        nRounds = 5
    }
    let n = len(X)
    let w = []
    let i = 0
    while i < n {
        w = push(w, 1.0 / n)
        i = i + 1
    }
    let rounds = []
    let r = 0
    while r < nRounds {
        // weighted resample via cumulative weights
        let idx = []
        let t = 0
        while t < n {
            let u = (t + 0.5) / n
            let c = 0.0
            let j = 0
            let pick = n - 1
            while j < n {
                c = c + w[j]
                if u <= c {
                    pick = j
                    break
                }
                j = j + 1
            }
            idx = push(idx, pick)
            t = t + 1
        }
        let sub = subsetXYKab(X, y, idx)
        let stump = stumpKab(sub["X"], sub["y"])
        let pred = stumpPredictKab(stump, X)
        let err = 0.0
        i = 0
        while i < n {
            if pred[i] != y[i] {
                err = err + w[i]
            }
            i = i + 1
        }
        if err < 0.000000000001 {
            err = 0.000000000001
        }
        if err > 0.999999999 {
            err = 0.999999999
        }
        let alpha = 0.5 * log((1.0 - err) / err)
        let wsum = 0.0
        i = 0
        while i < n {
            if pred[i] != y[i] {
                w[i] = w[i] * exp(alpha)
            } else {
                w[i] = w[i] * exp(0.0 - alpha)
            }
            wsum = wsum + w[i]
            i = i + 1
        }
        i = 0
        while i < n {
            w[i] = w[i] / wsum
            i = i + 1
        }
        rounds = push(rounds, { "stump": stump, "alpha": alpha })
        r = r + 1
    }
    return { "kind": "BoostStumps", "rounds": rounds, "nRounds": nRounds }
}

pub fn boostPredictKab(model, X) {
    let out = []
    let i = 0
    while i < len(X) {
        let score = 0.0
        let r = 0
        while r < len(model["rounds"]) {
            let round = model["rounds"][r]
            let pred = stumpPredictKab(round["stump"], [X[i]])
            let s = -1.0
            if pred[0] == 1.0 {
                s = 1.0
            }
            score = score + round["alpha"] * s
            r = r + 1
        }
        if score >= 0.0 {
            out = push(out, 1.0)
        } else {
            out = push(out, 0.0)
        }
        i = i + 1
    }
    return out
}
