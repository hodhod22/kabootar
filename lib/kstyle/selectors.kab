@version "1.0.0"

// KSS selector matching in Kabootar (mirrors kstyle.rs / DomNode::matches_selector).
// import "kstyle/selectors"
// KEEP <=~7 top-level fn.
// Supports: #id / .class / tag / tag#id / tag.class / descendant (space) / child (>) / sibling (+)

fn splitSelector(sel) {
    let parts = []
    let current = ""
    let i = 0
    let n = len(sel)
    while i < n {
        let c = char_at(sel, i)
        if c == " " {
            if len(trim(current)) > 0 {
                parts = push(parts, trim(current))
                current = ""
            }
        } else if c == ">" || c == "+" {
            if len(trim(current)) > 0 {
                parts = push(parts, trim(current))
                current = ""
            }
            parts = push(parts, "" + c)
        } else {
            current = current + c
        }
        i = i + 1
    }
    if len(trim(current)) > 0 {
        parts = push(parts, trim(current))
    }
    return parts
}

pub fn matchesTag(sel, tag) {
    return sel == tag
}

pub fn matchesClass(sel, classAttr) {
    if len(sel) == 0 {
        return false
    }
    if char_at(sel, 0) != "." {
        return false
    }
    let want = str_slice(sel, 1, len(sel))
    let parts = split(classAttr, " ")
    for p of parts {
        if trim(p) == want {
            return true
        }
    }
    return false
}

pub fn matchesId(sel, idAttr) {
    if len(sel) == 0 {
        return false
    }
    if char_at(sel, 0) != "#" {
        return false
    }
    let want = str_slice(sel, 1, len(sel))
    return want == idAttr
}

/// Simple #id / .class / tag / tag#id / tag.class (no attr / :not).
pub fn matchesSimple(sel, tag, classAttr, idAttr) {
    let s = trim("" + sel)
    if len(s) == 0 {
        return false
    }
    if char_at(s, 0) == "#" {
        return matchesId(s, idAttr)
    }
    if char_at(s, 0) == "." {
        return matchesClass(s, classAttr)
    }
    let hash = str_index_of(s, "#")
    if hash > 0 {
        let t = str_slice(s, 0, hash)
        let id = str_slice(s, hash + 1, len(s))
        return t == tag && id == idAttr
    }
    let dot = str_index_of(s, ".")
    if dot > 0 {
        let t = str_slice(s, 0, dot)
        let cls = "." + str_slice(s, dot + 1, len(s))
        return t == tag && matchesClass(cls, classAttr)
    }
    return matchesTag(s, tag)
}

/// Legacy OR of bare tag / .class / #id (descendant walk still uses this for simple atoms).
pub fn matches(sel, tag, classAttr, idAttr) {
    return matchesSimple(sel, tag, classAttr, idAttr)
}

fn stripQuotes(v) {
    let s = trim("" + v)
    if len(s) >= 2 {
        let a = char_at(s, 0)
        let b = char_at(s, len(s) - 1)
        if (a == "\"" && b == "\"") || (a == "'" && b == "'") {
            return str_slice(s, 1, len(s) - 1)
        }
    }
    return s
}

/// Full node match: :not(...), [attr]/[attr=value], pseudo-classes, then simple.
pub fn matchesNode(sel, node) {
    if node == null || node == undefined {
        return false
    }
    let s = trim("" + sel)
    if len(s) == 0 {
        return false
    }
    let tag = "" + node.tag
    let classAttr = kdom_get_attr(node, "class")
    if classAttr == null || classAttr == undefined {
        classAttr = ""
    }
    let idAttr = kdom_get_attr(node, "id")
    if idAttr == null || idAttr == undefined {
        idAttr = ""
    }

    let notAt = str_index_of(s, ":not(")
    if notAt >= 0 {
        let base = trim(str_slice(s, 0, notAt))
        let rest = str_slice(s, notAt + 5, len(s))
        let end = str_index_of(rest, ")")
        if end < 0 {
            return false
        }
        let inner = trim(str_slice(rest, 0, end))
        if matchesNode(inner, node) {
            return false
        }
        if len(base) == 0 {
            return true
        }
        return matchesNode(base, node)
    }

    let hoverAt = str_index_of(s, ":hover")
    if hoverAt >= 0 && hoverAt + 6 == len(s) {
        let base = trim(str_slice(s, 0, hoverAt))
        if len(base) == 0 {
            base = tag
        }
        if !matchesSimple(base, tag, classAttr, idAttr) {
            return false
        }
        return kdom_is_hovered(node)
    }

    let activeAt = str_index_of(s, ":active")
    if activeAt >= 0 && activeAt + 7 == len(s) {
        let base = trim(str_slice(s, 0, activeAt))
        if len(base) == 0 {
            base = tag
        }
        if !matchesSimple(base, tag, classAttr, idAttr) {
            return false
        }
        return kdom_is_active(node)
    }

    let focusAt = str_index_of(s, ":focus")
    if focusAt >= 0 && focusAt + 6 == len(s) {
        let base = trim(str_slice(s, 0, focusAt))
        if len(base) == 0 {
            base = tag
        }
        if !matchesSimple(base, tag, classAttr, idAttr) {
            return false
        }
        return kdom_is_focused(node)
    }

    let bracket = str_index_of(s, "[")
    if bracket >= 0 {
        let prefix = trim(str_slice(s, 0, bracket))
        let rest = str_slice(s, bracket, len(s))
        if len(rest) < 2 || char_at(rest, len(rest) - 1) != "]" {
            return false
        }
        let inner = str_slice(rest, 1, len(rest) - 1)
        let eq = str_index_of(inner, "=")
        let attrOk = false
        if eq >= 0 {
            let name = trim(str_slice(inner, 0, eq))
            let want = stripQuotes(str_slice(inner, eq + 1, len(inner)))
            let got = kdom_get_attr(node, name)
            attrOk = got != null && got != undefined && ("" + got) == want
        } else {
            let name = trim(inner)
            let got = kdom_get_attr(node, name)
            attrOk = got != null && got != undefined
        }
        if !attrOk {
            return false
        }
        if len(prefix) == 0 {
            return true
        }
        return matchesSimple(prefix, tag, classAttr, idAttr)
    }

    return matchesSimple(s, tag, classAttr, idAttr)
}

/// Match compound selector (descendant space, child >, sibling +)
pub fn matchesCompound(sel, node) {
    if node == null || node == undefined {
        return false
    }
    let parts = splitSelector(sel)
    if len(parts) == 0 {
        return false
    }
    if len(parts) == 1 {
        return matchesNode(parts[0], node)
    }
    
    let lastIdx = len(parts) - 1
    if !matchesNode(parts[lastIdx], node) {
        return false
    }
    
    let parent = kdom_parent(node)
    let partIdx = lastIdx - 1
    
    while partIdx >= 0 && parent != null {
        let part = parts[partIdx]
        if part == ">" {
            partIdx = partIdx - 1
            if partIdx < 0 {
                break
            }
            if !matchesNode(parts[partIdx], parent) {
                return false
            }
            parent = kdom_parent(parent)
        } else if part == "+" {
            partIdx = partIdx - 1
            if partIdx < 0 {
                break
            }
            let sibling = kdom_prev_sibling(parent)
            if sibling == null || !matchesNode(parts[partIdx], sibling) {
                return false
            }
            break
        } else {
            if matchesNode(part, parent) {
                return true
            }
            parent = kdom_parent(parent)
        }
        partIdx = partIdx - 1
    }
    
    return false
}
