@version "1.0.0"

// GP7 entry — full editor shell composition.
// kabootar run examples/game_editor.kab  (or import "game/game_editor")

pub import "game/scene"
pub import "game/editor"
pub import "game/save"
pub import "game/ui"
pub import "game/anim"
pub import "game/particles"
pub import "game/physics3"
pub import "game/postfx"
pub import "game/light"
pub import "game/terrain"
pub import "game/procgen"
pub import "game/audio"
pub import "game/i18n"
pub import "game/stats"

pub fn bootEditor(rootName) {
    let root = createNode(rootName)
    let ed = createEditor(root)
    let panel = createPanel("tools", 0, 0, 420, 40)
    panel = addWidget(panel, createButton("play", "Play", 0, 0, 64, 28))
    panel = addWidget(panel, createButton("pause", "Pause", 0, 0, 64, 28))
    panel = addWidget(panel, createButton("save", "Save", 0, 0, 64, 28))
    panel = layoutRow(panel, 8)
    ed["toolbarUi"] = panel
    let lights = createLightList()
    lights = addLight(lights, enableSoftShadow(createDirectional({ "x": -0.4, "y": -1.0, "z": -0.2 }, [1.0, 1.0, 0.95], 1.0), 1024, 1.5))
    ed["lights"] = lights
    let fx = createPipeline()
    fx = addPass(fx, tonemapPass(1.0))
    fx = addPass(fx, bloomPass(0.8, 0.4, 1.2))
    fx = addPass(fx, vignettePass(0.35, 0.5))
    ed["postfx"] = fx
    return refresh(ed)
}
