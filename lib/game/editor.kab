@version "1.0.0"

// GP7 — Scene editor (MVP + I/O + undo/redo + kOS UX descriptors).
// import "game/scene" + "game/editor"

import "game/scene"
import "game/save"

pub fn createEditor(root) {
    return {
        "root": root,
        "selected": null,
        "selection": [],
        "hierarchy": [],
        "inspector": null,
        "sceneView": { "camX": 0, "camY": 0, "camZ": 10, "zoom": 1.0, "mode": "scene" },
        "gameView": { "playing": false, "paused": false, "time": 0.0 },
        "undo": [],
        "redo": [],
        "clipboard": null,
        "drag": null,
        "layout": {
            "hierarchyW": 240,
            "inspectorW": 280,
            "sceneH": 0.6,
            "focused": "scene"
        },
        "shortcuts": {
            "Ctrl+S": "save",
            "Ctrl+Z": "undo",
            "Ctrl+Y": "redo",
            "Delete": "delete",
            "Ctrl+D": "duplicate",
            "F": "focus"
        },
        "scenePath": null
    }
}

pub fn buildHierarchy(root) {
    let rows = []
    let stack = [{ "node": root, "depth": 0 }]
    while len(stack) > 0 {
        let top = stack[len(stack) - 1]
        let rest = []
        let si = 0
        while si < len(stack) - 1 {
            rest = push(rest, stack[si])
            si = si + 1
        }
        stack = rest
        let node = top["node"]
        let depth = top["depth"]
        rows = push(rows, {
            "name": node["name"],
            "depth": depth,
            "x": node["x"],
            "y": node["y"],
            "z": node["z"],
            "layer": node["layer"],
            "childCount": len(node["children"]),
            "node": node
        })
        let i = len(node["children"]) - 1
        while i >= 0 {
            stack = push(stack, { "node": node["children"][i], "depth": depth + 1 })
            i = i - 1
        }
    }
    return rows
}

pub fn buildInspector(node) {
    if node == null || node == undefined {
        return { "empty": true }
    }
    return {
        "empty": false,
        "name": node["name"],
        "x": node["x"],
        "y": node["y"],
        "z": node["z"],
        "layer": node["layer"],
        "world": worldPos(node),
        "fields": ["name", "x", "y", "z", "layer"]
    }
}

pub fn refresh(editor) {
    editor["hierarchy"] = buildHierarchy(editor["root"])
    if editor["selected"] != null {
        editor["inspector"] = buildInspector(editor["selected"])
    }
    return editor
}

pub fn selectNode(editor, node) {
    editor["selected"] = node
    editor["selection"] = [node]
    editor["inspector"] = buildInspector(node)
    return editor
}

pub fn selectAdd(editor, node) {
    editor["selection"] = push(editor["selection"], node)
    editor["selected"] = node
    editor["inspector"] = buildInspector(node)
    return editor
}

pub fn clearSelection(editor) {
    editor["selected"] = null
    editor["selection"] = []
    editor["inspector"] = { "empty": true }
    return editor
}

pub fn multiSelectNames(editor) {
    let names = []
    let i = 0
    while i < len(editor["selection"]) {
        names = push(names, editor["selection"][i]["name"])
        i = i + 1
    }
    return names
}

pub fn pushUndo(editor, snap) {
    editor["undo"] = push(editor["undo"], snap)
    editor["redo"] = []
    return editor
}

pub fn snapshotRoot(editor) {
    return serializeScene(editor["root"], { "kind": "undo" })
}

pub fn undo(editor) {
    if len(editor["undo"]) == 0 {
        return editor
    }
    let rest = []
    let i = 0
    while i < len(editor["undo"]) - 1 {
        rest = push(rest, editor["undo"][i])
        i = i + 1
    }
    let snap = editor["undo"][len(editor["undo"]) - 1]
    editor["undo"] = rest
    editor["redo"] = push(editor["redo"], snapshotRoot(editor))
    if snap["format"] == "kscene" {
        editor["root"] = deserializeScene(snap)
        editor["selected"] = null
        editor["selection"] = []
        editor = refresh(editor)
    } else {
        if snap["node"] != null {
            snap["node"] = setLocal(snap["node"], snap["x"], snap["y"], snap["z"])
            editor["selected"] = snap["node"]
            editor["inspector"] = buildInspector(snap["node"])
        }
    }
    return editor
}

pub fn redo(editor) {
    if len(editor["redo"]) == 0 {
        return editor
    }
    let rest = []
    let i = 0
    while i < len(editor["redo"]) - 1 {
        rest = push(rest, editor["redo"][i])
        i = i + 1
    }
    let snap = editor["redo"][len(editor["redo"]) - 1]
    editor["redo"] = rest
    editor["undo"] = push(editor["undo"], snapshotRoot(editor))
    if snap["format"] == "kscene" {
        editor["root"] = deserializeScene(snap)
        editor["selected"] = null
        editor["selection"] = []
        editor = refresh(editor)
    }
    return editor
}

pub fn inspectSetLocal(editor, x, y, z) {
    if editor["selected"] == null {
        return editor
    }
    editor = pushUndo(editor, {
        "node": editor["selected"],
        "x": editor["selected"]["x"],
        "y": editor["selected"]["y"],
        "z": editor["selected"]["z"]
    })
    editor["selected"] = setLocal(editor["selected"], x, y, z)
    editor["inspector"] = buildInspector(editor["selected"])
    return editor
}

pub fn sceneOrbit(editor, dx, dy) {
    editor["sceneView"]["camX"] = editor["sceneView"]["camX"] + dx
    editor["sceneView"]["camY"] = editor["sceneView"]["camY"] + dy
    return editor
}

pub fn sceneZoom(editor, delta) {
    let z = editor["sceneView"]["zoom"] + delta
    if z < 0.1 {
        z = 0.1
    }
    editor["sceneView"]["zoom"] = z
    return editor
}

pub fn buildSceneView(editor) {
    let rows = editor["hierarchy"]
    if rows == null || len(rows) == 0 {
        editor = refresh(editor)
        rows = editor["hierarchy"]
    }
    let selNames = multiSelectNames(editor)
    let gizmos = []
    let i = 0
    while i < len(rows) {
        let r = rows[i]
        let selected = false
        let si = 0
        while si < len(selNames) {
            if selNames[si] == r["name"] {
                selected = true
            }
            si = si + 1
        }
        gizmos = push(gizmos, {
            "name": r["name"],
            "x": r["x"],
            "y": r["y"],
            "z": r["z"],
            "selected": selected
        })
        i = i + 1
    }
    return {
        "mode": "scene",
        "camera": editor["sceneView"],
        "gizmos": gizmos
    }
}

pub fn play(editor) {
    editor["gameView"]["playing"] = true
    editor["gameView"]["paused"] = false
    return editor
}

pub fn pause(editor) {
    editor["gameView"]["paused"] = true
    return editor
}

pub fn stop(editor) {
    editor["gameView"]["playing"] = false
    editor["gameView"]["paused"] = false
    editor["gameView"]["time"] = 0.0
    return editor
}

pub fn stepGame(editor, dt) {
    if editor["gameView"]["playing"] && editor["gameView"]["paused"] == false {
        editor["gameView"]["time"] = editor["gameView"]["time"] + dt
    }
    return editor
}

pub fn buildGameView(editor) {
    return {
        "mode": "game",
        "playing": editor["gameView"]["playing"],
        "paused": editor["gameView"]["paused"],
        "time": editor["gameView"]["time"],
        "root": editor["root"]
    }
}

pub fn dragStart(editor, payload) {
    editor["drag"] = payload
    return editor
}

pub fn dragDropOnNode(editor, targetNode) {
    if editor["drag"] == null {
        return editor
    }
    let payload = editor["drag"]
    editor["drag"] = null
    editor = pushUndo(editor, snapshotRoot(editor))
    if payload["kind"] == "reparent" && payload["node"] != null {
        targetNode = addChild(targetNode, payload["node"])
        editor = refresh(editor)
    }
    if payload["kind"] == "asset" && payload["name"] != null {
        let n = createNode(payload["name"])
        if payload["x"] != null {
            n = setLocal(n, payload["x"], payload["y"], payload["z"])
        }
        editor["root"] = addChild(editor["root"], n)
        editor = refresh(editor)
        editor = selectNode(editor, n)
    }
    return editor
}

pub fn liveSet(editor, prop, value) {
    if editor["selected"] == null {
        return editor
    }
    editor["selected"][prop] = value
    editor["inspector"] = buildInspector(editor["selected"])
    return editor
}

pub fn saveScene(editor, path) {
    if path == null || path == undefined {
        path = editor["scenePath"]
    }
    if path == null || path == undefined {
        path = "/scenes/untitled.kscene"
    }
    editor["scenePath"] = path
    let res = writeScene(path, editor["root"], { "editor": true })
    return { "editor": editor, "result": res }
}

pub fn loadScene(editor, path) {
    let res = readScene(path)
    if res["ok"] {
        editor = pushUndo(editor, snapshotRoot(editor))
        editor["root"] = res["root"]
        editor["scenePath"] = path
        editor["selected"] = null
        editor["selection"] = []
        editor = refresh(editor)
    }
    return { "editor": editor, "result": res }
}

pub fn handleShortcut(editor, chord) {
    let action = editor["shortcuts"][chord]
    if action == null || action == undefined {
        return { "editor": editor, "action": null }
    }
    if action == "undo" {
        editor = undo(editor)
    }
    if action == "redo" {
        editor = redo(editor)
    }
    if action == "save" {
        let r = saveScene(editor, editor["scenePath"])
        editor = r["editor"]
    }
    if action == "focus" {
        editor["layout"]["focused"] = "scene"
    }
    return { "editor": editor, "action": action }
}

/// Create a prefab descriptor from a node subtree (JSON-serializable).
pub fn createPrefab(name, node) {
    return {
        "kind": "prefab",
        "name": name,
        "scene": serializeScene(node, { "kind": "prefab", "name": name })
    }
}

/// Instantiate prefab under editor root (push undo + select).
pub fn instantiatePrefab(editor, prefab, x, y, z) {
    if prefab == null || prefab["scene"] == null {
        return editor
    }
    editor = pushUndo(editor, snapshotRoot(editor))
    let n = deserializeScene(prefab["scene"])
    if x != null {
        n = setLocal(n, x, y, z)
    }
    editor["root"] = addChild(editor["root"], n)
    editor = refresh(editor)
    editor = selectNode(editor, n)
    return editor
}

/// Hot-reload descriptor: pairs liveSet with optional asset poll stamp.
pub fn syncHotReload(editor, pollStamp) {
    editor["hotReload"] = {
        "stamp": pollStamp,
        "selected": editor["selected"] != null,
        "path": editor["scenePath"]
    }
    return editor
}

pub fn setLayout(editor, hierarchyW, inspectorW, sceneH) {
    editor["layout"]["hierarchyW"] = hierarchyW
    editor["layout"]["inspectorW"] = inspectorW
    editor["layout"]["sceneH"] = sceneH
    return editor
}

pub fn kosEditorLayout(editor) {
    editor = refresh(editor)
    return {
        "kind": "kos-editor",
        "panels": [
            { "id": "hierarchy", "w": editor["layout"]["hierarchyW"], "dock": "left" },
            { "id": "scene", "h": editor["layout"]["sceneH"], "dock": "center" },
            { "id": "game", "dock": "center-bottom" },
            { "id": "inspector", "w": editor["layout"]["inspectorW"], "dock": "right" },
            { "id": "toolbar", "dock": "top" }
        ],
        "shortcuts": editor["shortcuts"],
        "focused": editor["layout"]["focused"],
        "multiSelect": multiSelectNames(editor)
    }
}

/// Delete-gate checklist: create → edit → play → save (no external toolchain).
pub fn deleteGateStatus(editor) {
    let hasRoot = editor["root"] != null
    let edited = len(editor["undo"]) > 0 || editor["selected"] != null
    let played = editor["gameView"]["playing"] || editor["gameView"]["time"] > 0.0
    let saved = editor["scenePath"] != null
    return {
        "create": hasRoot,
        "edit": edited,
        "play": played,
        "save": saved,
        "ready": hasRoot && edited && played && saved
    }
}

pub fn editorLayout(editor) {
    editor = refresh(editor)
    return {
        "hierarchy": editor["hierarchy"],
        "inspector": editor["inspector"],
        "sceneView": buildSceneView(editor),
        "gameView": buildGameView(editor),
        "toolbar": ["play", "pause", "stop", "undo", "redo", "save"],
        "kos": kosEditorLayout(editor),
        "deleteGate": deleteGateStatus(editor)
    }
}
