@version "1.0.0"

// GP6f — Post-processing / VFX pass chain (descriptors + CPU stubs).
// import "game/postfx"

pub fn createPipeline() {
    return { "passes": [], "enabled": true }
}

pub fn addPass(pipeline, stage) {
    pipeline["passes"] = push(pipeline["passes"], stage)
    return pipeline
}

pub fn tonemapPass(exposure) {
    if exposure == null || exposure == undefined {
        exposure = 1.0
    }
    return { "kind": "tonemap", "exposure": exposure }
}

pub fn bloomPass(threshold, strength, radius) {
    if threshold == null || threshold == undefined {
        threshold = 0.8
    }
    if strength == null || strength == undefined {
        strength = 0.5
    }
    if radius == null || radius == undefined {
        radius = 1.0
    }
    return { "kind": "bloom", "threshold": threshold, "strength": strength, "radius": radius }
}

pub fn vignettePass(intensity, softness) {
    if intensity == null || intensity == undefined {
        intensity = 0.35
    }
    if softness == null || softness == undefined {
        softness = 0.5
    }
    return { "kind": "vignette", "intensity": intensity, "softness": softness }
}

pub fn fxaaPass() {
    return { "kind": "fxaa", "quality": "medium" }
}

pub fn materialVfxHook(name, params) {
    if params == null || params == undefined {
        params = {}
    }
    return { "kind": "material", "name": name, "params": params }
}

/// CPU stub: Reinhard tonemap on RGB array [[r,g,b], ...]
pub fn applyTonemap(colors, exposure) {
    let out = []
    let i = 0
    while i < len(colors) {
        let c = colors[i]
        let r = c[0] * exposure
        let g = c[1] * exposure
        let b = c[2] * exposure
        out = push(out, [
            r / (1.0 + r),
            g / (1.0 + g),
            b / (1.0 + b)
        ])
        i = i + 1
    }
    return out
}

pub fn applyBloomThreshold(colors, threshold) {
    let out = []
    let i = 0
    while i < len(colors) {
        let c = colors[i]
        let lum = 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]
        if lum >= threshold {
            out = push(out, c)
        } else {
            out = push(out, [0.0, 0.0, 0.0])
        }
        i = i + 1
    }
    return out
}

/// CPU stub vignette on flat RGB grid (row-major width*height).
pub fn applyVignette(colors, width, height, intensity) {
    if intensity == null || intensity == undefined {
        intensity = 0.35
    }
    let out = []
    let cx = (width - 1) * 0.5
    let cy = (height - 1) * 0.5
    let maxd = sqrt(cx * cx + cy * cy)
    if maxd < 0.0001 {
        maxd = 1.0
    }
    let i = 0
    while i < len(colors) {
        let x = i % width
        let y = floor(i / width)
        let dx = x - cx
        let dy = y - cy
        let t = sqrt(dx * dx + dy * dy) / maxd
        let dark = 1.0 - intensity * t * t
        if dark < 0.0 {
            dark = 0.0
        }
        let c = colors[i]
        out = push(out, [c[0] * dark, c[1] * dark, c[2] * dark])
        i = i + 1
    }
    return out
}

pub fn describePipeline(pipeline) {
    let names = []
    let i = 0
    while i < len(pipeline["passes"]) {
        names = push(names, pipeline["passes"][i]["kind"])
        i = i + 1
    }
    return { "enabled": pipeline["enabled"], "passes": names, "count": len(names) }
}
