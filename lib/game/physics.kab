@version "1.0.0"

// Kabootar game/physics - Legacy 2D AABB/circle (GP3a) + 3D ray/character (GP3b) helpers.
// These are low-level utility functions for simple physics operations.
// For full physics engine with ECS integration, use import "game/core/physics3"
//
// Bodies 2D: { x, y, w, h } or { x, y, r }.
// import "game/physics"

pub fn aabbOverlap(a, b) {
    return a["x"] < b["x"] + b["w"]
        && a["x"] + a["w"] > b["x"]
        && a["y"] < b["y"] + b["h"]
        && a["y"] + a["h"] > b["y"]
}

pub fn circleOverlap(a, b) {
    let dx = a["x"] - b["x"]
    let dy = a["y"] - b["y"]
    let rr = a["r"] + b["r"]
    return dx * dx + dy * dy <= rr * rr
}

// Push `moving` out of `solid` along the shallowest axis. Returns updated body.
pub fn resolveAabb(moving, solid) {
    let ax0 = moving["x"]
    let ay0 = moving["y"]
    let ax1 = ax0 + moving["w"]
    let ay1 = ay0 + moving["h"]
    let bx0 = solid["x"]
    let by0 = solid["y"]
    let bx1 = bx0 + solid["w"]
    let by1 = by0 + solid["h"]
    let overlapLeft = ax1 - bx0
    let overlapRight = bx1 - ax0
    let overlapX = overlapLeft
    if overlapRight < overlapX {
        overlapX = overlapRight
    }
    let overlapTop = ay1 - by0
    let overlapBottom = by1 - ay0
    let overlapY = overlapTop
    if overlapBottom < overlapY {
        overlapY = overlapBottom
    }
    let out = {
        x: moving["x"],
        y: moving["y"],
        w: moving["w"],
        h: moving["h"]
    }
    if overlapX < overlapY {
        let midA = (ax0 + ax1) / 2.0
        let midB = (bx0 + bx1) / 2.0
        if midA < midB {
            out["x"] = bx0 - moving["w"]
        } else {
            out["x"] = bx1
        }
    } else {
        let midA = (ay0 + ay1) / 2.0
        let midB = (by0 + by1) / 2.0
        if midA < midB {
            out["y"] = by0 - moving["h"]
        } else {
            out["y"] = by1
        }
    }
    return out
}

// --- GP3b: 3D ray / AABB + simple character step ---

// box: { minx, miny, minz, maxx, maxy, maxz }
// ray: origin {x,y,z}, dir {x,y,z} (need not be unit)
// returns { hit, t, x, y, z } ; hit=false -> t=null
pub fn rayAabb(origin, dir, box) {
    let ox = origin["x"]
    let oy = origin["y"]
    let oz = origin["z"]
    let dx = dir["x"]
    let dy = dir["y"]
    let dz = dir["z"]
    let tmin = 0.0
    let tmax = 1000000000.0

    // X slab
    if dx == 0.0 {
        if ox < box["minx"] || ox > box["maxx"] {
            return { hit: false, t: null, x: 0.0, y: 0.0, z: 0.0 }
        }
    } else {
        let tx1 = (box["minx"] - ox) / dx
        let tx2 = (box["maxx"] - ox) / dx
        let txn = tx1
        let txf = tx2
        if tx1 > tx2 {
            txn = tx2
            txf = tx1
        }
        if txn > tmin {
            tmin = txn
        }
        if txf < tmax {
            tmax = txf
        }
        if tmin > tmax {
            return { hit: false, t: null, x: 0.0, y: 0.0, z: 0.0 }
        }
    }

    // Y slab
    if dy == 0.0 {
        if oy < box["miny"] || oy > box["maxy"] {
            return { hit: false, t: null, x: 0.0, y: 0.0, z: 0.0 }
        }
    } else {
        let ty1 = (box["miny"] - oy) / dy
        let ty2 = (box["maxy"] - oy) / dy
        let tyn = ty1
        let tyf = ty2
        if ty1 > ty2 {
            tyn = ty2
            tyf = ty1
        }
        if tyn > tmin {
            tmin = tyn
        }
        if tyf < tmax {
            tmax = tyf
        }
        if tmin > tmax {
            return { hit: false, t: null, x: 0.0, y: 0.0, z: 0.0 }
        }
    }

    // Z slab
    if dz == 0.0 {
        if oz < box["minz"] || oz > box["maxz"] {
            return { hit: false, t: null, x: 0.0, y: 0.0, z: 0.0 }
        }
    } else {
        let tz1 = (box["minz"] - oz) / dz
        let tz2 = (box["maxz"] - oz) / dz
        let tzn = tz1
        let tzf = tz2
        if tz1 > tz2 {
            tzn = tz2
            tzf = tz1
        }
        if tzn > tmin {
            tmin = tzn
        }
        if tzf < tmax {
            tmax = tzf
        }
        if tmin > tmax {
            return { hit: false, t: null, x: 0.0, y: 0.0, z: 0.0 }
        }
    }

    if tmin < 0.0 {
        if tmax < 0.0 {
            return { hit: false, t: null, x: 0.0, y: 0.0, z: 0.0 }
        }
        tmin = 0.0
    }
    return {
        hit: true,
        t: tmin,
        x: ox + dx * tmin,
        y: oy + dy * tmin,
        z: oz + dz * tmin
    }
}

// Simple kinematic step: apply wish xz, gravity, ground via downward ray.
// controller: { x, y, z, radius, height, vy }
// groundBoxes: array of AABB boxes
// wishX/wishZ are velocities (units/sec), not normalized dirs.
pub fn characterStep(controller, wishX, wishZ, dt, gravity, groundBoxes) {
    let x = controller["x"] + wishX * dt
    let z = controller["z"] + wishZ * dt
    let vy = controller["vy"] + gravity * dt
    let y = controller["y"] + vy * dt
    let feet = { x: x, y: y, z: z }
    let down = { x: 0.0, y: -1.0, z: 0.0 }
    let i = 0
    let grounded = false
    while i < len(groundBoxes) {
        let hit = rayAabb(feet, down, groundBoxes[i])
        if hit["hit"] && hit["t"] != null && hit["t"] >= 0.0 && hit["t"] <= controller["height"] {
            y = hit["y"]
            vy = 0.0
            grounded = true
        }
        i = i + 1
    }
    return {
        x: x,
        y: y,
        z: z,
        radius: controller["radius"],
        height: controller["height"],
        vy: vy,
        grounded: grounded
    }
}

/// Motor-level character controller (Bazi / games wrap with input + ECS).
pub fn createPhysicsCharacter(x, y, z, radius, height) {
    if x == null || x == undefined { x = 0.0 }
    if y == null || y == undefined { y = 0.0 }
    if z == null || z == undefined { z = 0.0 }
    if radius == null || radius == undefined { radius = 0.4 }
    if height == null || height == undefined { height = 1.8 }
    return {
        "kind": "PhysicsCharacter",
        "x": x,
        "y": y,
        "z": z,
        "radius": radius,
        "height": height,
        "vy": 0.0,
        "grounded": false,
        "jumpSpeed": 6.0
    }
}

/// Drive CC from normalized wish dirs * speed (do not teleport Transform by hand).
/// jumpPressed + grounded applies jumpSpeed to vy before the step.
pub fn characterDrive(controller, wishX, wishZ, speed, dt, gravity, groundBoxes, jumpPressed) {
    if wishX == null || wishX == undefined { wishX = 0.0 }
    if wishZ == null || wishZ == undefined { wishZ = 0.0 }
    if speed == null || speed == undefined { speed = 5.0 }
    if dt == null || dt == undefined { dt = 0.016 }
    if gravity == null || gravity == undefined { gravity = -20.0 }
    if groundBoxes == null || groundBoxes == undefined { groundBoxes = [] }
    if jumpPressed == true && controller["grounded"] == true {
        let js = controller["jumpSpeed"]
        if js == null || js == undefined { js = 6.0 }
        controller["vy"] = js
        controller["grounded"] = false
    }
    let stepped = characterStep(controller, wishX * speed, wishZ * speed, dt, gravity, groundBoxes)
    stepped["kind"] = controller["kind"]
    stepped["jumpSpeed"] = controller["jumpSpeed"]
    return stepped
}

/// Copy character position into a transform-like object { x, y, z, ... }.
pub fn syncTransformFromCharacter(transform, controller) {
    if transform == null || transform == undefined {
        return { "x": controller["x"], "y": controller["y"], "z": controller["z"] }
    }
    transform["x"] = controller["x"]
    transform["y"] = controller["y"]
    transform["z"] = controller["z"]
    return transform
}

/// Copy transform position into a physics character controller.
pub fn syncCharacterFromTransform(controller, transform) {
    controller["x"] = transform["x"]
    controller["y"] = transform["y"]
    controller["z"] = transform["z"]
    return controller
}
