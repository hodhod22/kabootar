@version "1.0.0"

// Spelbyggare / sandlåda — GP + editor + STEM i samma loop.
// import "game/sandbox"
// Play: fjäder/drag + målzon. Edit: GP7 placera bodies → .kscene.
// Learn: parametrar (k,m,g) + hot-reload efter clear.

import "game/scene"
import "game/editor"
import "game/save"
import "game/physics"
import "game/hot"
import "game/ui"
import "science/mechanics"

/// Create a force-puzzle world (Play).
pub fn createPuzzle(params) {
    if params == null || params == undefined {
        params = defaultParams()
    }
    return {
        "kind": "force_puzzle",
        "params": params,
        "mode": "play",
        "cleared": false,
        "dragging": false,
        "anchor": { "x": 40.0, "y": 80.0 },
        "body": {
            "name": "ball",
            "x": 40.0,
            "y": 80.0,
            "vx": 0.0,
            "vy": 0.0,
            "w": 16.0,
            "h": 16.0,
            "m": params["m"],
            "r": 8.0
        },
        "goal": { "name": "goal", "x": 180.0, "y": 70.0, "w": 36.0, "h": 36.0 },
        "walls": [
            { "x": 0.0, "y": 140.0, "w": 240.0, "h": 20.0 }
        ],
        "ticks": 0,
        "lesson": null,
        "paramsPath": null
    }
}

pub fn setParams(world, params) {
    world["params"] = params
    world["body"]["m"] = params["m"]
    return world
}

/// Apply live Learn edits (k / m / g / drag) without restarting.
pub fn applyLiveParams(world, patch) {
    let p = world["params"]
    if patch["k"] != null { p["k"] = patch["k"] }
    if patch["m"] != null { p["m"] = patch["m"] }
    if patch["g"] != null { p["g"] = patch["g"] }
    if patch["drag"] != null { p["drag"] = patch["drag"] }
    if patch["rest"] != null { p["rest"] = patch["rest"] }
    world["params"] = p
    world["body"]["m"] = p["m"]
    return world
}

pub fn startDrag(world, x, y) {
    world["dragging"] = true
    world["anchor"] = { "x": x, "y": y }
    return world
}

pub fn moveDrag(world, x, y) {
    if world["dragging"] {
        world["anchor"] = { "x": x, "y": y }
    }
    return world
}

pub fn endDrag(world) {
    world["dragging"] = false
    return world
}

fn accumulateForces(world) {
    let p = world["params"]
    let b = world["body"]
    let fx = 0.0
    let fy = 0.0
    if world["dragging"] {
        let s = springForce(p["k"], b["x"], b["y"], world["anchor"]["x"], world["anchor"]["y"])
        fx = fx + s["fx"]
        fy = fy + s["fy"]
    }
    let g = gravityForce(p["m"], p["g"])
    fx = fx + g["fx"]
    fy = fy + g["fy"]
    let d = dragForce(p["drag"], b["vx"], b["vy"])
    fx = fx + d["fx"]
    fy = fy + d["fy"]
    return { "fx": fx, "fy": fy }
}

/// Fixed-step Play tick.
pub fn stepPuzzle(world, dt) {
    if world["cleared"] {
        return world
    }
    if dt == null || dt <= 0.0 {
        dt = 1.0 / 60.0
    }
    let f = accumulateForces(world)
    world["body"] = integrateBody(world["body"], f["fx"], f["fy"], dt)
    let b = world["body"]
    let i = 0
    while i < len(world["walls"]) {
        let wall = world["walls"][i]
        let box = { "x": b["x"] - b["w"] / 2.0, "y": b["y"] - b["h"] / 2.0, "w": b["w"], "h": b["h"] }
        if aabbOverlap(box, wall) {
            let fixed = resolveAabb(box, wall)
            b["x"] = fixed["x"] + b["w"] / 2.0
            b["y"] = fixed["y"] + b["h"] / 2.0
            if b["vy"] > 0.0 {
                b["vy"] = -b["vy"] * 0.35
            }
        }
        i = i + 1
    }
    world["body"] = b
    world["ticks"] = world["ticks"] + 1
    if inGoal(world) {
        world = clearLevel(world)
    }
    return world
}

pub fn inGoal(world) {
    let b = world["body"]
    let box = { "x": b["x"] - b["w"] / 2.0, "y": b["y"] - b["h"] / 2.0, "w": b["w"], "h": b["h"] }
    return aabbOverlap(box, world["goal"])
}

/// Mark cleared + attach Learn lesson (code + params).
pub fn clearLevel(world) {
    world["cleared"] = true
    world["dragging"] = false
    world["mode"] = "learn"
    world["lesson"] = buildLesson(world)
    return world
}

pub fn buildLesson(world) {
    let p = world["params"]
    let expl = explainForces(p, world["body"], world["anchor"])
    return {
        "title": "Hur banan räknades",
        "params": p,
        "forces": expl,
        "code": "let F = springForce(k, x, y, ax, ay)\nlet G = gravityForce(m, g)\nbody = integrateBody(body, Fx, Fy, dt)",
        "hint": "Ändra k / m / g via applyLiveParams eller params-fil + hot-reload, kör om."
    }
}

pub fn isCleared(world) {
    return world["cleared"] == true
}

/// Edit: map puzzle → GP7 editor scene graph.
pub fn puzzleToEditor(world) {
    let root = createNode("sandbox")
    let ball = createNode(world["body"]["name"])
    ball = setLocal(ball, world["body"]["x"], world["body"]["y"], 0)
    ball = setLayer(ball, 1)
    let goal = createNode(world["goal"]["name"])
    goal = setLocal(goal, world["goal"]["x"], world["goal"]["y"], 0)
    goal = setLayer(goal, 2)
    root = addChild(root, ball)
    root = addChild(root, goal)
    let ed = createEditor(root)
    ed["sandbox"] = {
        "params": world["params"],
        "kind": "force_puzzle",
        "walls": world["walls"],
        "levelId": world["levelId"]
    }
    return refresh(ed)
}

/// Place / move a named body in the editor (Edit).
pub fn editorPlaceBody(editor, name, x, y) {
    editor = pushUndo(editor, snapshotRoot(editor))
    let root = editor["root"]
    let kids = root["children"]
    let i = 0
    let found = false
    let newKids = []
    while i < len(kids) {
        let child = kids[i]
        if child["name"] == name {
            child["x"] = x
            child["y"] = y
            child["z"] = 0
            found = true
        }
        newKids = push(newKids, child)
        i = i + 1
    }
    if found == false {
        let n = createNode(name)
        n["x"] = x
        n["y"] = y
        n["z"] = 0
        newKids = push(newKids, n)
    }
    root["children"] = newKids
    editor["root"] = root
    editor = refresh(editor)
    let rows = editor["hierarchy"]
    let si = 0
    while si < len(rows) {
        if rows[si]["name"] == name {
            editor = selectNode(editor, rows[si]["node"])
        }
        si = si + 1
    }
    return editor
}

/// Learn stamp on editor (hot-reload descriptor).
pub fn stampLearnReload(editor, path) {
    editor = syncHotReload(editor, path)
    editor["hotReload"]["stamp"] = path
    editor["hotReload"]["learnPath"] = path
    return editor
}

/// Editor scene → puzzle world (keeps params).
pub fn editorToPuzzle(editor, params) {
    if params == null || params == undefined {
        if editor["sandbox"] != null {
            params = editor["sandbox"]["params"]
        }
    }
    if params == null || params == undefined {
        params = defaultParams()
    }
    let world = createPuzzle(params)
    let sb = editor["sandbox"]
    if sb != null && sb != undefined {
        if sb["walls"] != null {
            world["walls"] = sb["walls"]
        }
        if sb["levelId"] != null {
            world["levelId"] = sb["levelId"]
        }
    }
    editor = refresh(editor)
    let rows = editor["hierarchy"]
    let i = 0
    while i < len(rows) {
        let r = rows[i]
        if r["name"] == "ball" {
            world["body"]["x"] = r["x"]
            world["body"]["y"] = r["y"]
        }
        if r["name"] == "goal" {
            world["goal"]["x"] = r["x"]
            world["goal"]["y"] = r["y"]
        }
        i = i + 1
    }
    return world
}

/// Save puzzle as .kscene via GP7 save (keeps sandbox walls/params in meta).
pub fn savePuzzleScene(editor, path) {
    if path == null || path == undefined {
        path = editor["scenePath"]
    }
    if path == null || path == undefined {
        path = "/scenes/untitled.kscene"
    }
    editor["scenePath"] = path
    let meta = { "editor": true }
    if editor["sandbox"] != null {
        meta["sandbox"] = editor["sandbox"]
    }
    let res = writeScene(path, editor["root"], meta)
    return { "editor": editor, "result": res }
}

pub fn loadPuzzleScene(path, params) {
    let text = os_read(path)
    let doc = json_parse(text)
    let ed = createEditor(createNode("sandbox"))
    if doc["format"] == "kscene" {
        ed["root"] = deserializeScene(doc)
        ed["scenePath"] = path
        if doc["meta"] != null && doc["meta"]["sandbox"] != null {
            ed["sandbox"] = doc["meta"]["sandbox"]
        }
        ed = refresh(ed)
        let world = editorToPuzzle(ed, params)
        return { "ok": true, "world": world, "editor": ed }
    }
    return { "ok": false, "world": null, "editor": ed }
}

/// Learn: write params JSON (hot-reload via `enableParamsHotReload` on host paths).
pub fn writeParamsFile(path, params) {
    let text = json_stringify(params)
    os_write(path, text)
    return { "ok": true, "path": path, "params": params }
}

pub fn readParamsFile(path) {
    let text = os_read(path)
    return json_parse(text)
}

/// Watch a host filesystem params file for mtime changes (`game/hot`).
pub fn enableParamsHotReload(path) {
    watch(path)
    return { "ok": true, "path": path }
}

/// Poll hot-reload; if params path changed, apply into world + editor stamp.
pub fn pollParamsReload(world, editor) {
    let changed = poll()
    let path = world["paramsPath"]
    let hit = false
    let i = 0
    while i < len(changed) {
        if path != null && changed[i] == path {
            hit = true
        }
        i = i + 1
    }
    if hit {
        let p = readParamsFile(path)
        world = setParams(world, p)
        if editor != null {
            editor = syncHotReload(editor, path)
            if editor["sandbox"] != null {
                editor["sandbox"]["params"] = p
            }
        }
    }
    return { "world": world, "editor": editor, "reloaded": hit, "changed": changed }
}

pub fn attachParamsWatch(world, path) {
    world["paramsPath"] = path
    writeParamsFile(path, world["params"])
    return world
}

/// Auto-play helper for tests: drag toward goal and step until clear or maxTicks.
pub fn autoSolveTowardGoal(world, maxTicks) {
    if maxTicks == null {
        maxTicks = 240
    }
    let gx = world["goal"]["x"]
    let gy = world["goal"]["y"]
    world = startDrag(world, gx, gy)
    let t = 0
    while t < maxTicks && world["cleared"] == false {
        world = moveDrag(world, gx, gy)
        world = stepPuzzle(world, 1.0 / 60.0)
        t = t + 1
    }
    world = endDrag(world)
    return world
}

// ---------------------------------------------------------------------------
// Levels (multi-bane)
// ---------------------------------------------------------------------------

pub fn serializeLevel(world, id) {
    if id == null || id == undefined {
        id = "level"
    }
    return {
        "id": id,
        "params": world["params"],
        "body": { "x": world["body"]["x"], "y": world["body"]["y"], "w": world["body"]["w"], "h": world["body"]["h"] },
        "goal": world["goal"],
        "walls": world["walls"],
        "anchor": world["anchor"]
    }
}

pub fn loadLevelSpec(spec, params) {
    if params == null || params == undefined {
        params = spec["params"]
    }
    if params == null || params == undefined {
        params = defaultParams()
    }
    let world = createPuzzle(params)
    if spec["body"] != null {
        world["body"]["x"] = spec["body"]["x"]
        world["body"]["y"] = spec["body"]["y"]
        if spec["body"]["w"] != null { world["body"]["w"] = spec["body"]["w"] }
        if spec["body"]["h"] != null { world["body"]["h"] = spec["body"]["h"] }
    }
    if spec["goal"] != null {
        world["goal"] = spec["goal"]
        if world["goal"]["name"] == null { world["goal"]["name"] = "goal" }
    }
    if spec["walls"] != null {
        world["walls"] = spec["walls"]
    }
    if spec["anchor"] != null {
        world["anchor"] = spec["anchor"]
    }
    world["cleared"] = false
    world["dragging"] = false
    world["mode"] = "play"
    world["lesson"] = null
    world["ticks"] = 0
    world["levelId"] = spec["id"]
    return world
}

pub fn createLevelPack(levels) {
    return { "format": "ksandbox", "version": 1, "levels": levels }
}

pub fn defaultLevelPack() {
    let a = serializeLevel(createPuzzle(defaultParams()), "intro")
    let hard = createPuzzle({ "k": 55.0, "m": 1.2, "g": 14.0, "drag": 0.08, "rest": 0.0 })
    hard["body"]["x"] = 30.0
    hard["body"]["y"] = 40.0
    hard["goal"]["x"] = 190.0
    hard["goal"]["y"] = 100.0
    hard["walls"] = [
        { "x": 0.0, "y": 140.0, "w": 240.0, "h": 20.0 },
        { "x": 100.0, "y": 60.0, "w": 20.0, "h": 60.0 }
    ]
    let b = serializeLevel(hard, "spring_gap")
    return createLevelPack([a, b])
}

pub fn saveLevelPack(path, pack) {
    os_write(path, json_stringify(pack))
    return { "ok": true, "path": path, "count": len(pack["levels"]) }
}

pub fn loadLevelPack(path) {
    let pack = json_parse(os_read(path))
    if pack["format"] != "ksandbox" {
        return { "ok": false, "pack": null }
    }
    return { "ok": true, "pack": pack }
}

pub fn levelFromPack(pack, index) {
    if index < 0 || index >= len(pack["levels"]) {
        return null
    }
    return loadLevelSpec(pack["levels"][index], null)
}

// ---------------------------------------------------------------------------
// Session: Play ↔ Edit ↔ Learn (+ canvas)
// ---------------------------------------------------------------------------

pub fn createSession(width, height, pack) {
    if width == null { width = 240 }
    if height == null { height = 160 }
    if pack == null || pack == undefined {
        pack = defaultLevelPack()
    }
    let world = levelFromPack(pack, 0)
    let surf = game_surface_create(width, height)
    return {
        "kind": "sandbox_session",
        "width": width,
        "height": height,
        "surf": surf,
        "ctx": surf["ctx"],
        "world": world,
        "editor": null,
        "mode": "play",
        "pack": pack,
        "levelIndex": 0,
        "frames": 0,
        "pointerWasDown": false,
        "toolbar": buildModeToolbar(),
        "learnUi": null,
        "scenePath": "/scenes/sandbox_current.kscene",
        "paramsPath": "/sandbox/params.json"
    }
}

pub fn buildModeToolbar() {
    let panel = createPanel("modes", 4, 4, 220, 28)
    panel = addWidget(panel, createButton("play", "Play", 0, 0, 52, 24))
    panel = addWidget(panel, createButton("edit", "Edit", 0, 0, 52, 24))
    panel = addWidget(panel, createButton("learn", "Learn", 0, 0, 56, 24))
    panel = addWidget(panel, createButton("next", "Next", 0, 0, 52, 24))
    return layoutRow(panel, 6)
}

/// Learn UI descriptors (labels + “sliders” as value buttons).
pub fn buildLearnUi(world) {
    let p = world["params"]
    let lesson = world["lesson"]
    if lesson == null {
        lesson = buildLesson(world)
    }
    let panel = createPanel("learn", 8, 8, 224, 140)
    panel = addWidget(panel, createLabel("title", lesson["title"], 8, 8))
    panel = addWidget(panel, createLabel("code", "F=-k(p-a); a=F/m", 8, 28))
    panel = addWidget(panel, createLabel("k", "k (stiffness)", 8, 50))
    panel = addWidget(panel, createLabel("m", "m (mass)", 8, 70))
    panel = addWidget(panel, createLabel("g", "g (gravity)", 8, 90))
    panel = addWidget(panel, createButton("k_up", "k+", 140, 48, 36, 22))
    panel = addWidget(panel, createButton("k_dn", "k-", 180, 48, 36, 22))
    panel = addWidget(panel, createButton("g_up", "g+", 140, 88, 36, 22))
    panel = addWidget(panel, createButton("g_dn", "g-", 180, 88, 36, 22))
    panel = addWidget(panel, createButton("retry", "Retry", 8, 112, 64, 22))
    return {
        "panel": panel,
        "lesson": lesson,
        "hint": lesson["hint"],
        "formula": lesson["code"],
        "k": p["k"],
        "m": p["m"],
        "g": p["g"]
    }
}

pub fn setLearnParam(session, key, delta) {
    let p = session["world"]["params"]
    if key == "k" {
        session["world"] = applyLiveParams(session["world"], { "k": p["k"] + delta })
    }
    if key == "m" {
        session["world"] = applyLiveParams(session["world"], { "m": p["m"] + delta })
    }
    if key == "g" {
        session["world"] = applyLiveParams(session["world"], { "g": p["g"] + delta })
    }
    if key == "drag" {
        session["world"] = applyLiveParams(session["world"], { "drag": p["drag"] + delta })
    }
    session["learnUi"] = buildLearnUi(session["world"])
    writeParamsFile(session["paramsPath"], session["world"]["params"])
    if session["editor"] != null {
        session["editor"] = stampLearnReload(session["editor"], session["paramsPath"])
    }
    return session
}

pub fn enterPlay(session) {
    if session["mode"] == "edit" && session["editor"] != null {
        session["world"] = editorToPuzzle(session["editor"], session["world"]["params"])
    }
    session["world"]["cleared"] = false
    session["world"]["dragging"] = false
    session["world"]["body"]["vx"] = 0.0
    session["world"]["body"]["vy"] = 0.0
    session["world"]["mode"] = "play"
    session["world"]["lesson"] = null
    session["mode"] = "play"
    session["learnUi"] = null
    return session
}

pub fn enterEdit(session) {
    session["editor"] = puzzleToEditor(session["world"])
    session["mode"] = "edit"
    session["world"]["mode"] = "edit"
    return session
}

pub fn enterLearnMode(session) {
    if session["world"]["lesson"] == null {
        session["world"]["lesson"] = buildLesson(session["world"])
    }
    session["mode"] = "learn"
    session["world"]["mode"] = "learn"
    session["world"] = attachParamsWatch(session["world"], session["paramsPath"])
    session["learnUi"] = buildLearnUi(session["world"])
    if session["editor"] != null {
        session["editor"] = stampLearnReload(session["editor"], session["paramsPath"])
    }
    return session
}

pub fn applyEditorAndPlay(session) {
    if session["editor"] == null {
        session["editor"] = puzzleToEditor(session["world"])
    }
    let saved = savePuzzleScene(session["editor"], session["scenePath"])
    session["editor"] = saved["editor"]
    session["world"] = editorToPuzzle(session["editor"], session["world"]["params"])
    return enterPlay(session)
}

pub fn nextLevel(session) {
    let i = session["levelIndex"] + 1
    if i >= len(session["pack"]["levels"]) {
        i = 0
    }
    session["levelIndex"] = i
    session["world"] = levelFromPack(session["pack"], i)
    session["editor"] = null
    session["learnUi"] = null
    session["mode"] = "play"
    return session
}

pub fn drawPuzzle(ctx, world, width, height) {
    ctx.fillStyle = "#0a1520"
    ctx.fillRect(0, 0, width, height)
    let wi = 0
    while wi < len(world["walls"]) {
        let wall = world["walls"][wi]
        ctx.fillStyle = "#4a5568"
        ctx.fillRect(wall["x"], wall["y"], wall["w"], wall["h"])
        wi = wi + 1
    }
    let g = world["goal"]
    ctx.fillStyle = "#2f6fed"
    ctx.fillRect(g["x"], g["y"], g["w"], g["h"])
    let b = world["body"]
    ctx.fillStyle = "#40c080"
    ctx.fillRect(b["x"] - b["w"] / 2.0, b["y"] - b["h"] / 2.0, b["w"], b["h"])
    if world["dragging"] {
        ctx.fillStyle = "#f0c040"
        ctx.fillRect(world["anchor"]["x"] - 3.0, world["anchor"]["y"] - 3.0, 6.0, 6.0)
        // spring cord approximation (segment dots)
        let ax = world["anchor"]["x"]
        let ay = world["anchor"]["y"]
        let bx = b["x"]
        let by = b["y"]
        let s = 0
        while s < 8 {
            let t = s / 8.0
            let px = bx + (ax - bx) * t
            let py = by + (ay - by) * t
            ctx.fillRect(px - 1.0, py - 1.0, 2.0, 2.0)
            s = s + 1
        }
    }
    return true
}

pub fn drawLearnOverlay(ctx, learnUi, width, height) {
    ctx.fillStyle = "rgba(10,20,30,0.82)"
    ctx.fillRect(0, 0, width, height)
    ctx.fillStyle = "#e8eef7"
    let lesson = learnUi["lesson"]
    // Minimal text via fillRect bars (canvas text may vary); labels live in learnUi panel.
    ctx.fillStyle = "#1b2838"
    ctx.fillRect(12, 20, width - 24, 100)
    ctx.fillStyle = "#40c080"
    ctx.fillRect(20, 36, 8, 8)
    return learnUi
}

pub fn drawToolbar(ctx, toolbar) {
    let kids = toolbar["children"]
    let i = 0
    while i < len(kids) {
        let w = kids[i]
        if w["kind"] == "button" {
            ctx.fillStyle = "#243044"
            if w["pressed"] {
                ctx.fillStyle = "#3d5a80"
            }
            ctx.fillRect(w["x"], w["y"], w["w"], w["h"])
        }
        i = i + 1
    }
    return toolbar
}

fn hitBall(world, x, y) {
    let b = world["body"]
    let dx = x - b["x"]
    let dy = y - b["y"]
    return dx * dx + dy * dy <= (b["r"] * 3.0) * (b["r"] * 3.0)
}

/// Pointer / toolbar handling for one frame.
pub fn handleSessionPointer(session, pointer) {
    let x = pointer["x"]
    let y = pointer["y"]
    let down = pointer["down"]
    let was = session["pointerWasDown"]
    if session["mode"] == "play" {
        if down && was == false {
            let hit = hitTest(session["toolbar"], x, y)
            if hit != null {
                session["toolbar"] = pressAt(session["toolbar"], x, y)
                if hit["id"] == "edit" { session = enterEdit(session) }
                if hit["id"] == "learn" { session = enterLearnMode(session) }
                if hit["id"] == "next" { session = nextLevel(session) }
            } else {
                if hitBall(session["world"], x, y) {
                    session["world"] = startDrag(session["world"], x, y)
                } else {
                    // Pull from empty space toward cursor (sandbox feel).
                    session["world"] = startDrag(session["world"], x, y)
                }
            }
        }
        if down && session["world"]["dragging"] {
            session["world"] = moveDrag(session["world"], x, y)
        }
        if down == false && was {
            session["world"] = endDrag(session["world"])
            // clear button pressed flags
            let kids = session["toolbar"]["children"]
            let i = 0
            while i < len(kids) {
                kids[i]["pressed"] = false
                i = i + 1
            }
            session["toolbar"]["children"] = kids
        }
    }
    if session["mode"] == "edit" {
        if down && was == false {
            let hit = hitTest(session["toolbar"], x, y)
            if hit != null {
                session["toolbar"] = pressAt(session["toolbar"], x, y)
                if hit["id"] == "play" {
                    session = applyEditorAndPlay(session)
                }
                if hit["id"] == "learn" { session = enterLearnMode(session) }
                if hit["id"] == "next" { session = nextLevel(session) }
            } else {
                if session["editor"] == null {
                    session["editor"] = puzzleToEditor(session["world"])
                }
                // Place ball under cursor (simple edit tool).
                session["editor"] = editorPlaceBody(session["editor"], "ball", x, y)
                session["world"] = editorToPuzzle(session["editor"], session["world"]["params"])
            }
        }
    }
    if session["mode"] == "learn" {
        if down && was == false {
            let hit = hitTest(session["toolbar"], x, y)
            if hit != null {
                session["toolbar"] = pressAt(session["toolbar"], x, y)
                if hit["id"] == "play" { session = enterPlay(session) }
                if hit["id"] == "edit" { session = enterEdit(session) }
                if hit["id"] == "next" { session = nextLevel(session) }
            } else {
                if session["learnUi"] == null {
                    session["learnUi"] = buildLearnUi(session["world"])
                }
                let lh = hitTest(session["learnUi"]["panel"], x, y)
                if lh != null {
                    if lh["id"] == "k_up" { session = setLearnParam(session, "k", 5.0) }
                    if lh["id"] == "k_dn" { session = setLearnParam(session, "k", -5.0) }
                    if lh["id"] == "g_up" { session = setLearnParam(session, "g", 1.0) }
                    if lh["id"] == "g_dn" { session = setLearnParam(session, "g", -1.0) }
                    if lh["id"] == "retry" { session = enterPlay(session) }
                }
            }
        }
    }
    session["pointerWasDown"] = down
    return session
}

/// One session frame: input → step → draw → present.
pub fn stepSession(session, dt) {
    let pollState = input_poll()
    session = handleSessionPointer(session, pollState["pointer"])
    if session["mode"] == "play" {
        session["world"] = stepPuzzle(session["world"], dt)
        if isCleared(session["world"]) {
            session = enterLearnMode(session)
        }
    }
    let ctx = session["ctx"]
    drawPuzzle(ctx, session["world"], session["width"], session["height"])
    if session["mode"] == "learn" && session["learnUi"] != null {
        drawLearnOverlay(ctx, session["learnUi"], session["width"], session["height"])
        drawToolbar(ctx, session["learnUi"]["panel"])
    }
    drawToolbar(ctx, session["toolbar"])
    session["surf"].present()
    session["frames"] = session["frames"] + 1
    return session
}

/// Headless smoke: N frames with optional pointer script.
pub fn runSessionFrames(session, n, script) {
    let i = 0
    while i < n {
        if script != null && i < len(script) {
            let ev = script[i]
            if ev["type"] == "down" {
                input_pointer_down(ev["x"], ev["y"])
            }
            if ev["type"] == "move" {
                input_pointer_move(ev["x"], ev["y"])
            }
            if ev["type"] == "up" {
                input_pointer_up(ev["x"], ev["y"])
            }
        }
        session = stepSession(session, 1.0 / 60.0)
        i = i + 1
    }
    return session
}

