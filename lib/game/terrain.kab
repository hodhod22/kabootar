@version "1.0.0"

// game/terrain — heightmap + LOD mesh stub (GP6d).
// import "game/terrain"

import "game/scene"

/// Create a width×depth heightmap. heights flat array (row-major z*width+x) or zeros.
pub fn createHeightmap(width, depth, cellSize, heights) {
    if width == null || width < 2 {
        width = 2
    }
    if depth == null || depth < 2 {
        depth = 2
    }
    if cellSize == null || cellSize == undefined {
        cellSize = 1.0
    }
    let n = width * depth
    let h = []
    let i = 0
    if heights != null && heights != undefined && len(heights) >= n {
        while i < n {
            h = push(h, heights[i])
            i = i + 1
        }
    } else {
        while i < n {
            h = push(h, 0.0)
            i = i + 1
        }
    }
    return {
        "kind": "heightmap",
        "width": width,
        "depth": depth,
        "cellSize": cellSize,
        "heights": h
    }
}

pub fn setHeight(hm, ix, iz, h) {
    let w = hm["width"]
    let d = hm["depth"]
    if ix < 0 {
        ix = 0
    }
    if iz < 0 {
        iz = 0
    }
    if ix >= w {
        ix = w - 1
    }
    if iz >= d {
        iz = d - 1
    }
    let heights = hm["heights"]
    heights[iz * w + ix] = h
    hm["heights"] = heights
    return hm
}

fn heightAt(hm, ix, iz) {
    let w = hm["width"]
    let d = hm["depth"]
    if ix < 0 {
        ix = 0
    }
    if iz < 0 {
        iz = 0
    }
    if ix >= w {
        ix = w - 1
    }
    if iz >= d {
        iz = d - 1
    }
    return hm["heights"][iz * w + ix]
}

/// Bilinear sample at world xz (origin at grid corner 0,0).
pub fn sampleHeight(hm, x, z) {
    let cs = hm["cellSize"]
    let fx = x / cs
    let fz = z / cs
    let ix = floor(fx)
    let iz = floor(fz)
    let tx = fx - ix
    let tz = fz - iz
    let h00 = heightAt(hm, ix, iz)
    let h10 = heightAt(hm, ix + 1, iz)
    let h01 = heightAt(hm, ix, iz + 1)
    let h11 = heightAt(hm, ix + 1, iz + 1)
    let hx0 = h00 * (1.0 - tx) + h10 * tx
    let hx1 = h01 * (1.0 - tx) + h11 * tx
    return hx0 * (1.0 - tz) + hx1 * tz
}

pub fn heightmapBounds(hm) {
    let w = hm["width"]
    let d = hm["depth"]
    let cs = hm["cellSize"]
    let heights = hm["heights"]
    let mn = heights[0]
    let mx = heights[0]
    let i = 1
    while i < len(heights) {
        if heights[i] < mn {
            mn = heights[i]
        }
        if heights[i] > mx {
            mx = heights[i]
        }
        i = i + 1
    }
    return {
        "minx": 0.0,
        "maxx": (w - 1) * cs,
        "miny": mn,
        "maxy": mx,
        "minz": 0.0,
        "maxz": (d - 1) * cs
    }
}

/// Build mesh descriptor. lod=0 full grid; lod=1 stride 2; etc.
pub fn buildTerrainMesh(hm, lod) {
    if lod == null || lod == undefined || lod < 0 {
        lod = 0
    }
    let stride = 1
    let i = 0
    while i < lod {
        stride = stride * 2
        i = i + 1
    }
    let w = hm["width"]
    let d = hm["depth"]
    let cs = hm["cellSize"]
    let positions = []
    let indices = []
    let z = 0
    while z < d {
        let x = 0
        while x < w {
            let y = heightAt(hm, x, z)
            positions = push(positions, { "x": x * cs, "y": y, "z": z * cs })
            x = x + stride
        }
        z = z + stride
    }
    let cols = floor((w - 1) / stride) + 1
    let rows = floor((d - 1) / stride) + 1
    let rz = 0
    while rz < rows - 1 {
        let rx = 0
        while rx < cols - 1 {
            let i0 = rz * cols + rx
            let i1 = i0 + 1
            let i2 = i0 + cols
            let i3 = i2 + 1
            indices = push(indices, i0)
            indices = push(indices, i2)
            indices = push(indices, i1)
            indices = push(indices, i1)
            indices = push(indices, i2)
            indices = push(indices, i3)
            rx = rx + 1
        }
        rz = rz + 1
    }
    return {
        "kind": "terrain_mesh",
        "lod": lod,
        "stride": stride,
        "positions": positions,
        "indices": indices
    }
}

/// Ensure splatmaps exist on heightmap (RGBA-like channels 0..1).
pub fn ensureSplatmaps(hm, channels) {
    if channels == null || channels == undefined {
        channels = ["rock", "grass", "dirt", "snow"]
    }
    let n = hm["width"] * hm["depth"]
    let maps = hm["splat"]
    if maps == null || maps == undefined {
        maps = {}
    }
    let ci = 0
    while ci < len(channels) {
        let ch = channels[ci]
        if maps[ch] == null || maps[ch] == undefined {
            let arr = []
            let i = 0
            while i < n {
                let v = 0.0
                if ci == 0 {
                    v = 1.0
                }
                arr = push(arr, v)
                i = i + 1
            }
            maps[ch] = arr
        }
        ci = ci + 1
    }
    hm["splat"] = maps
    hm["splatChannels"] = channels
    return hm
}

fn splatIndex(hm, x, z) {
    let cs = hm["cellSize"]
    let ix = floor(x / cs)
    let iz = floor(z / cs)
    let w = hm["width"]
    let d = hm["depth"]
    if ix < 0 { ix = 0 }
    if iz < 0 { iz = 0 }
    if ix >= w { ix = w - 1 }
    if iz >= d { iz = d - 1 }
    return iz * w + ix
}

/// Paint splat weight at world xz (normalizes channel sum ≈ 1 at texel).
pub fn paintSplat(hm, x, z, channel, weight) {
    if weight == null || weight == undefined {
        weight = 0.5
    }
    if weight < 0.0 {
        weight = 0.0
    }
    if weight > 1.0 {
        weight = 1.0
    }
    hm = ensureSplatmaps(hm, hm["splatChannels"])
    let maps = hm["splat"]
    if maps[channel] == null || maps[channel] == undefined {
        return {
            "ok": false,
            "mode": "missing_channel",
            "hm": hm,
            "channel": channel
        }
    }
    let idx = splatIndex(hm, x, z)
    let maps = hm["splat"]
    let chans = hm["splatChannels"]
    // Set target channel to weight; distribute remainder across others.
    let rem = 1.0 - weight
    let otherCount = len(chans) - 1
    if otherCount < 1 {
        otherCount = 1
    }
    let i = 0
    while i < len(chans) {
        let a = maps[chans[i]]
        if chans[i] == channel {
            a[idx] = weight
        } else {
            a[idx] = rem / otherCount
        }
        maps[chans[i]] = a
        i = i + 1
    }
    hm["splat"] = maps
    return { "ok": true, "mode": "painted", "hm": hm, "index": idx, "channel": channel }
}

/// Sample splat weights at world xz (nearest texel).
pub fn sampleSplat(hm, x, z) {
    hm = ensureSplatmaps(hm, hm["splatChannels"])
    let idx = splatIndex(hm, x, z)
    let out = {}
    let chans = hm["splatChannels"]
    let i = 0
    while i < len(chans) {
        out[chans[i]] = hm["splat"][chans[i]][idx]
        i = i + 1
    }
    return out
}

/// Streaming window: which chunks around camera are "resident".
pub fn createStreamingBounds(chunkSize, radius) {
    if chunkSize == null {
        chunkSize = 8
    }
    if radius == null {
        radius = 1
    }
    return {
        "kind": "terrain_stream",
        "chunkSize": chunkSize,
        "radius": radius,
        "resident": []
    }
}

/// Update resident chunk list for camera xz (stub — no async load).
pub fn updateStreaming(stream, hm, camX, camZ, lod) {
    let cs = stream["chunkSize"]
    let cx = floor(camX / (cs * hm["cellSize"]))
    let cz = floor(camZ / (cs * hm["cellSize"]))
    let r = stream["radius"]
    let resident = []
    let z = cz - r
    while z <= cz + r {
        let x = cx - r
        while x <= cx + r {
            resident = push(resident, terrainChunk(hm, x, z, cs, lod))
            x = x + 1
        }
        z = z + 1
    }
    stream["resident"] = resident
    stream["camChunk"] = { "cx": cx, "cz": cz }
    return stream
}

/// Chunk descriptor for streaming/LOD.
pub fn terrainChunk(hm, cx, cz, chunkSize, lod) {
    if chunkSize == null {
        chunkSize = 8
    }
    return {
        "kind": "terrain_chunk",
        "cx": cx,
        "cz": cz,
        "chunkSize": chunkSize,
        "lod": lod,
        "mode": "resident_stub",
        "mesh": buildTerrainMesh(hm, lod)
    }
}

/// Attach terrain node + mesh descriptor under scene root.
pub fn attachTerrainToScene(root, hm, lod) {
    let mesh = buildTerrainMesh(hm, lod)
    let n = createNode("terrain")
    n = setLocal(n, 0.0, 0.0, 0.0)
    n = setLayer(n, 0)
    n["terrain"] = {
        "heightmap": hm,
        "mesh": mesh,
        "lod": lod,
        "splat": hm["splat"]
    }
    root = addChild(root, n)
    return root
}
