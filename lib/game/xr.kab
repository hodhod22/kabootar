@version "1.0.0"

// GP6n — VR/AR session + OpenXR/WebXR-style runtime swapchain.
// import "game/xr"

pub fn xrInfo() {
    let info = xr_host_info()
    if info == null || info == undefined {
        return { "available": false, "backend": "stub" }
    }
    return info
}

pub fn createXrSession(mode) {
    if mode == null || mode == undefined {
        mode = "vr"
    }
    let info = xrInfo()
    return {
        "kind": "xr_session",
        "mode": mode,
        "active": false,
        "available": info["available"],
        "backend": info["backend"],
        "controllers": [],
        "eyes": stereoCameras(null, 0.064),
        "swapchains": []
    }
}

pub fn xrBegin(session) {
    if session["available"] != true {
        return session
    }
    session["active"] = true
    session["controllers"] = trackedControllers(session)
    return session
}

pub fn xrEnd(session) {
    session["active"] = false
    return session
}

/// Tracked controller stubs (left/right).
pub fn trackedControllers(session) {
    return [
        { "id": "left", "x": -0.3, "y": 1.2, "z": -0.5, "buttons": [] },
        { "id": "right", "x": 0.3, "y": 1.2, "z": -0.5, "buttons": [] }
    ]
}

/// Stereo eye cameras from head pose + IPD.
pub fn stereoCameras(head, ipd) {
    if head == null || head == undefined {
        head = { "x": 0.0, "y": 1.6, "z": 0.0, "yaw": 0.0 }
    }
    if ipd == null || ipd == undefined {
        ipd = 0.064
    }
    let hx = head["x"]
    let hy = head["y"]
    let hz = head["z"]
    let half = ipd * 0.5
    return {
        "left": { "x": hx - half, "y": hy, "z": hz, "eye": "left" },
        "right": { "x": hx + half, "y": hy, "z": hz, "eye": "right" },
        "ipd": ipd
    }
}

pub fn xrPresentDescriptor(session, width, height) {
    if width == null || width == undefined {
        width = 1280
    }
    if height == null || height == undefined {
        height = 720
    }
    return {
        "kind": "xr_present",
        "mode": session["mode"],
        "active": session["active"],
        "width": width,
        "height": height,
        "eyes": session["eyes"],
        "controllers": session["controllers"],
        "backend": session["backend"]
    }
}

/// Host present (OpenXR/WebXR subset via `xr_host_present`).
pub fn xrPresent(session, width, height) {
    let desc = xrPresentDescriptor(session, width, height)
    let host = xr_host_present(desc)
    session["lastPresent"] = host
    return { "session": session, "present": host }
}

pub fn describeSwapchains(present) {
    if present["swapchains"] == null || present["swapchains"] == undefined {
        return { "count": 0, "pixelBytes": 0 }
    }
    let chains = present["swapchains"]
    let px = 0
    if present["pixelBytes"] != null {
        px = present["pixelBytes"]
    }
    return { "count": len(chains), "pixelBytes": px, "backend": present["backend"] }
}

/// Create stereo runtime swapchains (OpenXR-style image pool).
pub fn createStereoSwapchains(session, width, height) {
    if width == null || width == undefined {
        width = 1280
    }
    if height == null || height == undefined {
        height = 720
    }
    let left = xr_create_swapchain({ "eye": "left", "width": width, "height": height, "imageCount": 3 })
    let right = xr_create_swapchain({ "eye": "right", "width": width, "height": height, "imageCount": 3 })
    session["swapchains"] = [left, right]
    return session
}

/// One runtime frame: wait → acquire → (optional GPU present) → release → endFrame.
pub fn xrRuntimeFrame(session, width, height) {
    if session["swapchains"] == null || len(session["swapchains"]) < 2 {
        session = createStereoSwapchains(session, width, height)
    }
    let frame = xr_wait_frame()
    let left = session["swapchains"][0]
    let right = session["swapchains"][1]
    let imgL = xr_acquire_swapchain_image(left)
    let imgR = xr_acquire_swapchain_image(right)
    let present = null
    if session["active"] == true {
        present = xr_host_present(xrPresentDescriptor(session, width, height))
    }
    xr_release_swapchain_image(imgL)
    xr_release_swapchain_image(imgR)
    let ended = xr_end_frame([
        { "eye": "left", "imageIndex": imgL["imageIndex"] },
        { "eye": "right", "imageIndex": imgR["imageIndex"] }
    ])
    session["lastFrame"] = {
        "frame": frame,
        "left": imgL,
        "right": imgR,
        "present": present,
        "ended": ended
    }
    return { "session": session, "frame": frame, "ended": ended, "present": present }
}

pub fn describeXr(session) {
    return {
        "mode": session["mode"],
        "active": session["active"],
        "available": session["available"],
        "backend": session["backend"],
        "controllerCount": len(session["controllers"]),
        "ipd": session["eyes"]["ipd"],
        "swapchainCount": len(session["swapchains"])
    }
}
