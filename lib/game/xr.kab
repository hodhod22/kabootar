@version "1.0.0"

// GP6n — VR/AR session + OpenXR/WebXR-style runtime swapchain.
// import "game/xr"

pub fn xrInfo() {
    let info = xr_host_info()
    if info == null || info == undefined {
        return { "available": false, "backend": "stub" }
    }
    return info
}

pub fn createXrSession(mode) {
    if mode == null || mode == undefined {
        mode = "vr"
    }
    let info = xrInfo()
    return {
        "kind": "xr_session",
        "mode": mode,
        "active": false,
        "available": info["available"],
        "backend": info["backend"],
        "controllers": [],
        "eyes": stereoCameras(null, 0.064),
        "swapchains": [],
        "headsetBound": false
    }
}

pub fn xrBegin(session) {
    if session["available"] != true {
        return session
    }
    session["active"] = true
    session["controllers"] = trackedControllers(session)
    return session
}

/// Probe OpenXR loader / WebXR and bind when present (or stub).
pub fn xrBindHeadset(session, forceStub) {
    let bind = xr_bind_headset(forceStub == true)
    session["ffi"] = bind
    if bind["ok"] == true {
        session["available"] = true
        session["backend"] = bind["backend"]
        session["headsetBound"] = true
        session["vendor"] = bind["vendor"]
        session["hmdConnected"] = bind["hmdConnected"] == true
    } else {
        session["headsetBound"] = false
        session["hmdConnected"] = false
    }
    return session
}

pub fn xrFfiProbe() {
    return xr_ffi_probe()
}

pub fn xrEnd(session) {
    session["active"] = false
    return session
}

/// Tracked controller stubs (left/right).
pub fn trackedControllers(session) {
    return [
        { "id": "left", "x": -0.3, "y": 1.2, "z": -0.5, "buttons": [] },
        { "id": "right", "x": 0.3, "y": 1.2, "z": -0.5, "buttons": [] }
    ]
}

/// Stereo eye cameras from head pose + IPD.
pub fn stereoCameras(head, ipd) {
    if head == null || head == undefined {
        head = { "x": 0.0, "y": 1.6, "z": 0.0, "yaw": 0.0 }
    }
    if ipd == null || ipd == undefined {
        ipd = 0.064
    }
    let hx = head["x"]
    let hy = head["y"]
    let hz = head["z"]
    let half = ipd * 0.5
    return {
        "left": { "x": hx - half, "y": hy, "z": hz, "eye": "left" },
        "right": { "x": hx + half, "y": hy, "z": hz, "eye": "right" },
        "ipd": ipd
    }
}

pub fn xrPresentDescriptor(session, width, height) {
    if width == null || width == undefined {
        width = 1280
    }
    if height == null || height == undefined {
        height = 720
    }
    return {
        "kind": "xr_present",
        "mode": session["mode"],
        "active": session["active"],
        "width": width,
        "height": height,
        "eyes": session["eyes"],
        "controllers": session["controllers"],
        "backend": session["backend"]
    }
}

/// Host present (OpenXR/WebXR subset via `xr_host_present`).
pub fn xrPresent(session, width, height) {
    let desc = xrPresentDescriptor(session, width, height)
    let host = xr_host_present(desc)
    session["lastPresent"] = host
    return { "session": session, "present": host }
}

pub fn describeSwapchains(present) {
    if present["swapchains"] == null || present["swapchains"] == undefined {
        return { "count": 0, "pixelBytes": 0 }
    }
    let chains = present["swapchains"]
    let px = 0
    if present["pixelBytes"] != null {
        px = present["pixelBytes"]
    }
    return { "count": len(chains), "pixelBytes": px, "backend": present["backend"] }
}

/// Create stereo runtime swapchains (OpenXR-style image pool).
pub fn createStereoSwapchains(session, width, height) {
    if width == null || width == undefined {
        width = 1280
    }
    if height == null || height == undefined {
        height = 720
    }
    let left = xr_create_swapchain({ "eye": "left", "width": width, "height": height, "imageCount": 3 })
    let right = xr_create_swapchain({ "eye": "right", "width": width, "height": height, "imageCount": 3 })
    session["swapchains"] = [left, right]
    return session
}

/// OpenXR projection view (pose + fov + subImage).
pub fn createProjectionView(eye, image, pose, fov) {
    if pose == null || pose == undefined {
        let x = 0.0
        if eye == "right" {
            x = 0.032
        } else {
            x = 0.0 - 0.032
        }
        pose = { "x": x, "y": 1.6, "z": 0.0, "qx": 0.0, "qy": 0.0, "qz": 0.0, "qw": 1.0 }
    }
    if fov == null || fov == undefined {
        fov = { "angleLeft": 0.0 - 0.785, "angleRight": 0.785, "angleUp": 0.785, "angleDown": 0.0 - 0.785 }
    }
    let w = 640
    let h = 720
    if image != null && image != undefined {
        if image["width"] != null { w = image["width"] }
        if image["height"] != null { h = image["height"] }
    }
    return {
        "eye": eye,
        "width": w,
        "height": h,
        "pose": pose,
        "fov": fov,
        "subImage": {
            "swapchainId": image["swapchainId"],
            "imageIndex": image["imageIndex"],
            "x": 0,
            "y": 0,
            "width": w,
            "height": h
        }
    }
}

/// Projection composition layer (stereo views).
pub fn createProjectionLayer(views, space) {
    if space == null || space == undefined {
        space = "stage"
    }
    return {
        "type": "projection",
        "kind": "projection",
        "layerFlags": 0,
        "space": space,
        "views": views
    }
}

/// Compose HMD layers (native stereo projection).
pub fn composeHmdLayers(layers) {
    return xr_compose_hmd(layers)
}

/// Submit composed frame to vendor/stub HMD driver.
pub fn xrPresentToHmd(session, composition) {
    let drv = xr_hmd_driver_present(composition)
    session["lastHmdPresent"] = drv
    return { "session": session, "hmd": drv }
}

/// OpenXR-style compositor IPC channel.
pub fn xrCompositorOpen(session) {
    let ipc = xr_compositor_open()
    session["compositor"] = ipc
    return session
}

pub fn xrCompositorSubmit(composition) {
    return xr_compositor_submit(composition)
}

pub fn xrCompositorPoll() {
    return xr_compositor_poll()
}

/// WebXR requestSession / OpenXR session create (stub or real on wasm).
pub fn xrRequestSession(session, mode) {
    if mode == null || mode == undefined {
        mode = "immersive-vr"
    }
    let req = xr_request_session(mode)
    session["xrSession"] = req
    if req["ok"] == true {
        session["available"] = true
        session["active"] = req["active"] == true
        session["backend"] = req["backend"]
        if req["live"] != null && req["live"] != undefined {
            session["live"] = req["live"]
        }
    }
    return session
}

pub fn xrCreateLiveSession(session, mode) {
    if mode == null || mode == undefined {
        mode = "immersive-vr"
    }
    let live = xr_create_live_session(mode)
    session["live"] = live
    if live["ok"] == true {
        session["available"] = true
        session["active"] = true
    }
    return session
}

pub fn xrDestroyLiveSession(session) {
    let gone = xr_destroy_live_session()
    session["live"] = gone
    return { "session": session, "live": gone }
}

pub fn xrLiveSessionStatus() {
    return xr_live_session_status()
}

pub fn xrGrantWebxrSession(session) {
    let g = xr_grant_webxr_session()
    session["webxrGranted"] = g["webxrGranted"] == true
    if session["live"] == null || session["live"] == undefined {
        session["live"] = g
    } else {
        session["live"]["webxrGranted"] = true
        session["live"]["backend"] = g["backend"]
    }
    return session
}

/// Browser-style requestSession Promise (pending until xrPollSessionPromise).
pub fn xrRequestSessionAsync(session, mode) {
    if mode == null || mode == undefined {
        mode = "immersive-vr"
    }
    let promise = xr_request_session_promise(mode)
    session["sessionPromise"] = promise
    session["available"] = true
    return session
}

pub fn xrPollSessionPromise(session) {
    let resolved = xr_poll_session_promise()
    session["sessionPromise"] = resolved
    if resolved["resolved"] == true {
        session["active"] = true
        session["webxrGranted"] = true
        session["live"] = resolved["live"]
        session["raf"] = {
            "ok": true,
            "bound": true,
            "backend": resolved["rafBackend"],
            "webxrGranted": true
        }
    }
    return { "session": session, "promise": resolved }
}

pub fn xrSessionPromiseStatus() {
    return xr_session_promise_status()
}

/// Request → poll Promise → bind XRSession.rAF in one step.
pub fn xrResolveSessionRaf(session, mode) {
    session = xrRequestSessionAsync(session, mode)
    let polled = xrPollSessionPromise(session)
    return polled
}

/// Async await on browser-style XRSession Promise (then bind rAF).
pub async fn xrAwaitSessionRaf(session, mode) {
    if mode == null || mode == undefined {
        mode = "immersive-vr"
    }
    session = xrRequestSessionAsync(session, mode)
    // Yield like a browser Promise microtask before resolution.
    await promise_resolve(true)
    let polled = xrPollSessionPromise(session)
    polled["awaited"] = true
    return polled
}

/// Spawn vendor OpenXR compositor process (drains IPC like a separate compositor).
pub fn xrStartCompositorProcess(session) {
    if session["compositor"] == null || session["compositor"] == undefined {
        session = xrCompositorOpen(session)
    }
    let proc = xr_compositor_process_spawn()
    session["compositorProcess"] = proc
    return session
}

pub fn xrCompositorProcessTick() {
    return xr_compositor_process_tick()
}

pub fn xrStopCompositorProcess(session) {
    let stopped = xr_compositor_process_stop()
    if session != null && session != undefined {
        session["compositorProcess"] = stopped
    }
    return stopped
}

pub fn xrCompositorProcessStatus() {
    return xr_compositor_process_status()
}

/// One runtime frame: wait → acquire → compose → release → endFrame → HMD present → compositor.
pub fn xrRuntimeFrame(session, width, height) {
    if session["swapchains"] == null || len(session["swapchains"]) < 2 {
        session = createStereoSwapchains(session, width, height)
    }
    let eyeW = floor(width / 2)
    if eyeW < 64 {
        eyeW = 640
    }
    let frame = xr_wait_frame()
    let left = session["swapchains"][0]
    let right = session["swapchains"][1]
    let imgL = xr_acquire_swapchain_image(left)
    let imgR = xr_acquire_swapchain_image(right)
    imgL["width"] = eyeW
    imgL["height"] = height
    imgR["width"] = eyeW
    imgR["height"] = height
    let viewL = createProjectionView("left", imgL, null, null)
    let viewR = createProjectionView("right", imgR, null, null)
    let layer = createProjectionLayer([viewL, viewR], "stage")
    let composition = composeHmdLayers([layer])
    composition["frameIndex"] = frame["frameIndex"]
    let present = null
    if session["active"] == true {
        present = xr_host_present(xrPresentDescriptor(session, width, height))
    }
    xr_release_swapchain_image(imgL)
    xr_release_swapchain_image(imgR)
    let ended = xr_end_frame([layer])
    let hmd = null
    if session["headsetBound"] == true || session["active"] == true {
        let hp = xrPresentToHmd(session, composition)
        session = hp["session"]
        hmd = hp["hmd"]
    }
    let procSt = xr_compositor_process_status()
    let ack = null
    let procTick = null
    if procSt["running"] == true {
        procTick = xr_compositor_process_tick()
        ack = procTick["ack"]
    } else {
        ack = xrCompositorPoll()
    }
    session["lastFrame"] = {
        "frame": frame,
        "left": imgL,
        "right": imgR,
        "composition": composition,
        "present": present,
        "ended": ended,
        "hmd": hmd,
        "compositorAck": ack,
        "compositorTick": procTick
    }
    return {
        "session": session,
        "frame": frame,
        "ended": ended,
        "present": present,
        "composition": composition,
        "hmd": hmd,
        "compositorAck": ack,
        "compositorTick": procTick
    }
}

/// Start full WebXR-style immersive loop (requestSession + compositor process + begin).
pub fn xrStartImmersiveLoop(session, width, height, mode) {
    if mode == null || mode == undefined {
        mode = "immersive-vr"
    }
    if width == null || width == undefined {
        width = 1280
    }
    if height == null || height == undefined {
        height = 720
    }
    session = xrRequestSession(session, mode)
    session = xrStartCompositorProcess(session)
    session = xrBegin(session)
    if session["swapchains"] == null || len(session["swapchains"]) < 2 {
        session = createStereoSwapchains(session, width, height)
    }
    session["immersive"] = {
        "running": true,
        "mode": mode,
        "width": width,
        "height": height,
        "frameCount": 0,
        "lastFrameIndex": 0
    }
    return session
}

/// One immersive-loop frame (XRFrame analogue).
pub fn xrImmersiveFrame(session) {
    let imm = session["immersive"]
    if imm == null || imm == undefined || imm["running"] != true {
        return { "ok": false, "error": "immersive loop not running", "session": session }
    }
    let out = xrRuntimeFrame(session, imm["width"], imm["height"])
    session = out["session"]
    imm = session["immersive"]
    imm["frameCount"] = imm["frameCount"] + 1
    if out["frame"] != null && out["frame"]["frameIndex"] != null {
        imm["lastFrameIndex"] = out["frame"]["frameIndex"]
    }
    session["immersive"] = imm
    out["session"] = session
    out["ok"] = true
    out["immersive"] = imm
    return out
}

/// Run N immersive frames (full WebXR immersive loop batch).
pub fn xrRunImmersiveFrames(session, count, width, height, mode) {
    if count == null || count == undefined || count < 1 {
        count = 1
    }
    session = xrStartImmersiveLoop(session, width, height, mode)
    let frames = []
    let i = 0
    while i < count {
        let step = xrImmersiveFrame(session)
        session = step["session"]
        frames = push(frames, {
            "frameIndex": step["frame"]["frameIndex"],
            "acked": step["compositorAck"]["acked"] == true,
            "presented": step["hmd"]["presented"] == true,
            "drained": step["compositorTick"] != null && step["compositorTick"]["drained"] == true
        })
        i = i + 1
    }
    return {
        "ok": true,
        "session": session,
        "frames": frames,
        "frameCount": session["immersive"]["frameCount"],
        "compositor": xrCompositorProcessStatus()
    }
}

pub fn xrStopImmersiveLoop(session) {
    let stopped = xrStopCompositorProcess(session)
    if session["immersive"] != null && session["immersive"] != undefined {
        session["immersive"]["running"] = false
    }
    if session["active"] == true {
        session = xrEnd(session)
    }
    return { "session": session, "compositor": stopped }
}

/// Bind WebXR-style XRSession.requestAnimationFrame (stub or wasm navigator.xr).
pub fn xrBindAnimationFrame(session) {
    let bind = xr_raf_bind()
    session["raf"] = bind
    return session
}

pub fn xrRequestAnimationFrame(callback) {
    return xr_request_animation_frame(callback)
}

pub fn xrCancelAnimationFrame(id) {
    return xr_cancel_animation_frame(id)
}

pub fn xrPumpAnimationFrames() {
    return xr_raf_tick()
}

pub fn xrAnimationFrameStatus() {
    return xr_raf_status()
}

pub fn xrLoaderEndFrameStatus() {
    return xr_loader_end_frame_status()
}

/// Run immersive frames driven by XR rAF (WebXR immersive loop analogue).
pub fn xrRunImmersiveRaf(session, count, width, height, mode) {
    if count == null || count == undefined || count < 1 {
        count = 1
    }
    session = xrStartImmersiveLoop(session, width, height, mode)
    session = xrBindAnimationFrame(session)
    let frames = []
    let i = 0
    while i < count {
        session["_rafMeta"] = null
        xrRequestAnimationFrame((time, xrFrame) => {
            session["_rafMeta"] = {
                "time": time,
                "backend": xrFrame["backend"],
                "tick": xrFrame["tick"]
            }
            return true
        })
        let pumped = xrPumpAnimationFrames()
        if pumped["ran"] < 1 {
            return { "ok": false, "error": "xr rAF did not run", "session": session, "frames": frames }
        }
        let step = xrImmersiveFrame(session)
        session = step["session"]
        let meta = session["_rafMeta"]
        frames = push(frames, {
            "frameIndex": step["frame"]["frameIndex"],
            "acked": step["compositorAck"]["acked"] == true,
            "presented": step["hmd"]["presented"] == true,
            "loaderPath": step["ended"]["loaderEndFrame"]["path"],
            "ffiInvoked": step["ended"]["loaderEndFrame"]["ffiInvoked"] == true,
            "ffiMode": step["ended"]["loaderEndFrame"]["ffiMode"],
            "rafTime": meta["time"],
            "rafBackend": meta["backend"]
        })
        i = i + 1
    }
    return {
        "ok": true,
        "session": session,
        "frames": frames,
        "frameCount": session["immersive"]["frameCount"],
        "raf": xrAnimationFrameStatus(),
        "loader": xrLoaderEndFrameStatus(),
        "live": xrLiveSessionStatus(),
        "compositor": xrCompositorProcessStatus()
    }
}

pub fn describeXr(session) {
    let immersiveRunning = false
    if session["immersive"] != null && session["immersive"] != undefined {
        immersiveRunning = session["immersive"]["running"] == true
    }
    let rafBound = false
    if session["raf"] != null && session["raf"] != undefined {
        rafBound = session["raf"]["bound"] == true
    }
    return {
        "mode": session["mode"],
        "active": session["active"],
        "available": session["available"],
        "backend": session["backend"],
        "controllerCount": len(session["controllers"]),
        "ipd": session["eyes"]["ipd"],
        "swapchainCount": len(session["swapchains"]),
        "headsetBound": session["headsetBound"] == true,
        "hmdConnected": session["hmdConnected"] == true,
        "vendor": session["vendor"],
        "immersiveRunning": immersiveRunning,
        "compositorProcess": session["compositorProcess"] != null && session["compositorProcess"] != undefined,
        "rafBound": rafBound
    }
}
