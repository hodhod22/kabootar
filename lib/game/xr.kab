@version "1.0.0"

// GP6n — VR/AR session + OpenXR/WebXR-style runtime swapchain.
// import "game/xr"

pub fn xrInfo() {
    let info = xr_host_info()
    if info == null || info == undefined {
        return { "available": false, "backend": "stub" }
    }
    return info
}

pub fn createXrSession(mode) {
    if mode == null || mode == undefined {
        mode = "vr"
    }
    let info = xrInfo()
    return {
        "kind": "xr_session",
        "mode": mode,
        "active": false,
        "available": info["available"],
        "backend": info["backend"],
        "controllers": [],
        "eyes": stereoCameras(null, 0.064),
        "swapchains": [],
        "headsetBound": false
    }
}

pub fn xrBegin(session) {
    if session["available"] != true {
        return session
    }
    session["active"] = true
    session["controllers"] = trackedControllers(session)
    return session
}

/// Probe OpenXR loader / WebXR and bind when present (or stub).
pub fn xrBindHeadset(session, forceStub) {
    let bind = xr_bind_headset(forceStub == true)
    session["ffi"] = bind
    if bind["ok"] == true {
        session["available"] = true
        session["backend"] = bind["backend"]
        session["headsetBound"] = true
        session["vendor"] = bind["vendor"]
        session["hmdConnected"] = bind["hmdConnected"] == true
    } else {
        session["headsetBound"] = false
        session["hmdConnected"] = false
    }
    return session
}

pub fn xrFfiProbe() {
    return xr_ffi_probe()
}

pub fn xrEnd(session) {
    session["active"] = false
    return session
}

/// Tracked controller stubs (left/right).
pub fn trackedControllers(session) {
    return [
        { "id": "left", "x": -0.3, "y": 1.2, "z": -0.5, "buttons": [] },
        { "id": "right", "x": 0.3, "y": 1.2, "z": -0.5, "buttons": [] }
    ]
}

/// Stereo eye cameras from head pose + IPD.
pub fn stereoCameras(head, ipd) {
    if head == null || head == undefined {
        head = { "x": 0.0, "y": 1.6, "z": 0.0, "yaw": 0.0 }
    }
    if ipd == null || ipd == undefined {
        ipd = 0.064
    }
    let hx = head["x"]
    let hy = head["y"]
    let hz = head["z"]
    let half = ipd * 0.5
    return {
        "left": { "x": hx - half, "y": hy, "z": hz, "eye": "left" },
        "right": { "x": hx + half, "y": hy, "z": hz, "eye": "right" },
        "ipd": ipd
    }
}

pub fn xrPresentDescriptor(session, width, height) {
    if width == null || width == undefined {
        width = 1280
    }
    if height == null || height == undefined {
        height = 720
    }
    return {
        "kind": "xr_present",
        "mode": session["mode"],
        "active": session["active"],
        "width": width,
        "height": height,
        "eyes": session["eyes"],
        "controllers": session["controllers"],
        "backend": session["backend"]
    }
}

/// Host present (OpenXR/WebXR subset via `xr_host_present`).
pub fn xrPresent(session, width, height) {
    let desc = xrPresentDescriptor(session, width, height)
    let host = xr_host_present(desc)
    session["lastPresent"] = host
    return { "session": session, "present": host }
}

pub fn describeSwapchains(present) {
    if present["swapchains"] == null || present["swapchains"] == undefined {
        return { "count": 0, "pixelBytes": 0 }
    }
    let chains = present["swapchains"]
    let px = 0
    if present["pixelBytes"] != null {
        px = present["pixelBytes"]
    }
    return { "count": len(chains), "pixelBytes": px, "backend": present["backend"] }
}

/// Create stereo runtime swapchains (OpenXR-style image pool).
pub fn createStereoSwapchains(session, width, height) {
    if width == null || width == undefined {
        width = 1280
    }
    if height == null || height == undefined {
        height = 720
    }
    let left = xr_create_swapchain({ "eye": "left", "width": width, "height": height, "imageCount": 3 })
    let right = xr_create_swapchain({ "eye": "right", "width": width, "height": height, "imageCount": 3 })
    session["swapchains"] = [left, right]
    return session
}

/// OpenXR projection view (pose + fov + subImage).
pub fn createProjectionView(eye, image, pose, fov) {
    if pose == null || pose == undefined {
        let x = 0.0
        if eye == "right" {
            x = 0.032
        } else {
            x = 0.0 - 0.032
        }
        pose = { "x": x, "y": 1.6, "z": 0.0, "qx": 0.0, "qy": 0.0, "qz": 0.0, "qw": 1.0 }
    }
    if fov == null || fov == undefined {
        fov = { "angleLeft": 0.0 - 0.785, "angleRight": 0.785, "angleUp": 0.785, "angleDown": 0.0 - 0.785 }
    }
    let w = 640
    let h = 720
    if image != null && image != undefined {
        if image["width"] != null { w = image["width"] }
        if image["height"] != null { h = image["height"] }
    }
    return {
        "eye": eye,
        "width": w,
        "height": h,
        "pose": pose,
        "fov": fov,
        "subImage": {
            "swapchainId": image["swapchainId"],
            "imageIndex": image["imageIndex"],
            "x": 0,
            "y": 0,
            "width": w,
            "height": h
        }
    }
}

/// Projection composition layer (stereo views).
pub fn createProjectionLayer(views, space) {
    if space == null || space == undefined {
        space = "stage"
    }
    return {
        "type": "projection",
        "kind": "projection",
        "layerFlags": 0,
        "space": space,
        "views": views
    }
}

/// Compose HMD layers (native stereo projection).
pub fn composeHmdLayers(layers) {
    return xr_compose_hmd(layers)
}

/// Submit composed frame to vendor/stub HMD driver.
pub fn xrPresentToHmd(session, composition) {
    let drv = xr_hmd_driver_present(composition)
    session["lastHmdPresent"] = drv
    return { "session": session, "hmd": drv }
}

/// One runtime frame: wait → acquire → compose → release → endFrame → HMD driver present.
pub fn xrRuntimeFrame(session, width, height) {
    if session["swapchains"] == null || len(session["swapchains"]) < 2 {
        session = createStereoSwapchains(session, width, height)
    }
    let eyeW = floor(width / 2)
    if eyeW < 64 {
        eyeW = 640
    }
    let frame = xr_wait_frame()
    let left = session["swapchains"][0]
    let right = session["swapchains"][1]
    let imgL = xr_acquire_swapchain_image(left)
    let imgR = xr_acquire_swapchain_image(right)
    imgL["width"] = eyeW
    imgL["height"] = height
    imgR["width"] = eyeW
    imgR["height"] = height
    let viewL = createProjectionView("left", imgL, null, null)
    let viewR = createProjectionView("right", imgR, null, null)
    let layer = createProjectionLayer([viewL, viewR], "stage")
    let composition = composeHmdLayers([layer])
    composition["frameIndex"] = frame["frameIndex"]
    let present = null
    if session["active"] == true {
        present = xr_host_present(xrPresentDescriptor(session, width, height))
    }
    xr_release_swapchain_image(imgL)
    xr_release_swapchain_image(imgR)
    let ended = xr_end_frame([layer])
    let hmd = null
    if session["headsetBound"] == true || session["active"] == true {
        let hp = xrPresentToHmd(session, composition)
        session = hp["session"]
        hmd = hp["hmd"]
    }
    session["lastFrame"] = {
        "frame": frame,
        "left": imgL,
        "right": imgR,
        "composition": composition,
        "present": present,
        "ended": ended,
        "hmd": hmd
    }
    return {
        "session": session,
        "frame": frame,
        "ended": ended,
        "present": present,
        "composition": composition,
        "hmd": hmd
    }
}

pub fn describeXr(session) {
    return {
        "mode": session["mode"],
        "active": session["active"],
        "available": session["available"],
        "backend": session["backend"],
        "controllerCount": len(session["controllers"]),
        "ipd": session["eyes"]["ipd"],
        "swapchainCount": len(session["swapchains"]),
        "headsetBound": session["headsetBound"] == true,
        "hmdConnected": session["hmdConnected"] == true,
        "vendor": session["vendor"]
    }
}
