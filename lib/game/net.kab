@version "1.0.0"

// Kabootar game/net — multiplayer tick/snapshot hooks (GP3d subset).
// HTTP-first; RTC optional later. import "game/net"

pub fn createSession(mode) {
    if mode == undefined || mode == null {
        mode = "local"
    }
    return { mode: mode, tick: 0, inbox: [], outbox: [], peer: null, url: null }
}

pub fn encodeSnapshot(world, tick) {
    return json_stringify({ tick: tick, world: world })
}

pub fn applySnapshot(world, snapText) {
    let snap = json_parse(snapText)
    if snap["world"] != undefined && snap["world"] != null {
        return snap["world"]
    }
    return world
}

pub fn queueOutgoing(session, snapText) {
    session["outbox"] = push(session["outbox"], snapText)
    return session
}

pub fn drainOutgoing(session) {
    let out = session["outbox"]
    session["outbox"] = []
    return out
}

pub fn receiveRemote(session, snapText) {
    session["inbox"] = push(session["inbox"], snapText)
    return session
}

pub fn drainInbox(session) {
    let inn = session["inbox"]
    session["inbox"] = []
    return inn
}

// Advance local tick and encode ECS/world snapshot into outbox.
pub fn sendTick(session, world) {
    session["tick"] = session["tick"] + 1
    let snap = encodeSnapshot(world, session["tick"])
    session = queueOutgoing(session, snap)
    return session
}

// Apply all inbox snapshots (last wins). Returns { session, world }.
pub fn pollRemote(session, world) {
    let msgs = drainInbox(session)
    let i = 0
    while i < len(msgs) {
        world = applySnapshot(world, msgs[i])
        i = i + 1
    }
    return { session: session, world: world }
}

/// In-memory lobby / matchmaking hook (GP6m).
pub fn createLobby(name, maxPlayers) {
    if maxPlayers == null || maxPlayers == undefined {
        maxPlayers = 4
    }
    return {
        "kind": "lobby",
        "name": name,
        "maxPlayers": maxPlayers,
        "players": [],
        "status": "open"
    }
}

pub fn joinLobby(lobby, playerId) {
    if lobby["status"] != "open" {
        return lobby
    }
    if len(lobby["players"]) >= lobby["maxPlayers"] {
        return lobby
    }
    let i = 0
    while i < len(lobby["players"]) {
        if lobby["players"][i] == playerId {
            return lobby
        }
        i = i + 1
    }
    lobby["players"] = push(lobby["players"], playerId)
    return lobby
}

pub fn leaveLobby(lobby, playerId) {
    let next = []
    let i = 0
    while i < len(lobby["players"]) {
        if lobby["players"][i] != playerId {
            next = push(next, lobby["players"][i])
        }
        i = i + 1
    }
    lobby["players"] = next
    return lobby
}

pub fn lobbyReady(lobby) {
    return lobby["status"] == "open" && len(lobby["players"]) >= 2
}

pub fn closeLobby(lobby) {
    lobby["status"] = "closed"
    return lobby
}

/// Matchmake into first open lobby with space, or create one.
pub fn matchmake(lobbies, playerId, name, maxPlayers) {
    if lobbies == null || lobbies == undefined {
        lobbies = []
    }
    let i = 0
    while i < len(lobbies) {
        let L = lobbies[i]
        if L["status"] == "open" && len(L["players"]) < L["maxPlayers"] {
            L = joinLobby(L, playerId)
            lobbies[i] = L
            return { "lobbies": lobbies, "lobby": L, "created": false }
        }
        i = i + 1
    }
    let L = createLobby(name, maxPlayers)
    L = joinLobby(L, playerId)
    lobbies = push(lobbies, L)
    return { "lobbies": lobbies, "lobby": L, "created": true }
}

/// Interest management (AOI radius).
pub fn createInterest(radius) {
    if radius == null || radius == undefined {
        radius = 10.0
    }
    return {
        "kind": "interest",
        "radius": radius,
        "x": 0.0,
        "y": 0.0,
        "z": 0.0
    }
}

pub fn setInterestCenter(interest, x, y, z) {
    interest["x"] = x
    interest["y"] = y
    if z == null || z == undefined {
        z = 0.0
    }
    interest["z"] = z
    return interest
}

/// Filter entities with .x/.y/.z (or .x/.y) by interest radius (XZ plane + Y optional).
pub fn filterByInterest(interest, entities) {
    let out = []
    let r2 = interest["radius"] * interest["radius"]
    let i = 0
    while i < len(entities) {
        let e = entities[i]
        let ex = e["x"]
        let ey = e["y"]
        let ez = e["z"]
        if ez == null || ez == undefined {
            ez = 0.0
        }
        if ey == null || ey == undefined {
            ey = 0.0
        }
        let dx = ex - interest["x"]
        let dy = ey - interest["y"]
        let dz = ez - interest["z"]
        if dx * dx + dy * dy + dz * dz <= r2 {
            out = push(out, e)
        }
        i = i + 1
    }
    return out
}

/// Prediction-lite: integrate velocity + accel.
pub fn predictMove(state, input, dt) {
    if dt == null || dt <= 0.0 {
        dt = 1.0 / 60.0
    }
    let ax = 0.0
    let ay = 0.0
    if input != null && input != undefined {
        if input["ax"] != null { ax = input["ax"] }
        if input["ay"] != null { ay = input["ay"] }
    }
    let vx = state["vx"] + ax * dt
    let vy = state["vy"] + ay * dt
    let x = state["x"] + vx * dt
    let y = state["y"] + vy * dt
    return { "x": x, "y": y, "vx": vx, "vy": vy }
}

/// Soft-snap reconcile if error exceeds eps.
pub fn reconcile(predicted, authoritative, eps) {
    if eps == null || eps == undefined {
        eps = 0.5
    }
    let dx = predicted["x"] - authoritative["x"]
    let dy = predicted["y"] - authoritative["y"]
    let err = sqrt(dx * dx + dy * dy)
    if err > eps {
        return {
            "x": authoritative["x"],
            "y": authoritative["y"],
            "vx": authoritative["vx"],
            "vy": authoritative["vy"],
            "snapped": true,
            "error": err
        }
    }
    return {
        "x": predicted["x"],
        "y": predicted["y"],
        "vx": predicted["vx"],
        "vy": predicted["vy"],
        "snapped": false,
        "error": err
    }
}

/// In-memory message relay (local transport).
pub fn createRelay() {
    return { "kind": "net_relay", "queue": [] }
}

pub fn createTransport(mode, endpoint) {
    if mode == null || mode == undefined {
        mode = "local"
    }
  return {
        "kind": "net_transport",
        "mode": mode,
        "endpoint": endpoint,
        "connected": false,
        "outbox": [],
        "inbox": []
    }
}

pub fn transportConnect(transport) {
    transport["connected"] = true
    return transport
}

pub fn transportDisconnect(transport) {
    transport["connected"] = false
    return transport
}

pub fn transportPush(transport, payload) {
    if transport["connected"] != true {
        return transport
    }
    transport["outbox"] = push(transport["outbox"], payload)
    return transport
}

pub fn transportDrain(transport) {
    let out = transport["outbox"]
    transport["outbox"] = []
    return out
}

pub fn relayEnqueue(relay, payload) {
    relay["queue"] = push(relay["queue"], payload)
    return relay
}

pub fn relayPoll(relay) {
    let q = relay["queue"]
    relay["queue"] = []
    return q
}

/// Push transport outbox into relay; pull relay into transport inbox.
pub fn exchangeRelay(transport, relay) {
    let out = transportDrain(transport)
    let i = 0
    while i < len(out) {
        relay = relayEnqueue(relay, out[i])
        i = i + 1
    }
    let msgs = relayPoll(relay)
    i = 0
    while i < len(msgs) {
        transport["inbox"] = push(transport["inbox"], msgs[i])
        i = i + 1
    }
    return { "transport": transport, "relay": relay }
}

pub fn transportReceive(transport) {
    let inn = transport["inbox"]
    transport["inbox"] = []
    return inn
}

/// Push transport outbox into relay (one-way).
pub fn relayForward(transport, relay) {
    let out = transportDrain(transport)
    let i = 0
    while i < len(out) {
        relay = relayEnqueue(relay, out[i])
        i = i + 1
    }
    return { "transport": transport, "relay": relay }
}

/// Pull relay queue into transport inbox.
pub fn relayDeliver(transport, relay) {
    let msgs = relayPoll(relay)
    let i = 0
    while i < len(msgs) {
        transport["inbox"] = push(transport["inbox"], msgs[i])
        i = i + 1
    }
    return { "transport": transport, "relay": relay }
}

/// Drain session outbox through transport (+ optional relay hop).
pub fn flushSessionTransport(session, transport, relay) {
    let out = drainOutgoing(session)
    let i = 0
    while i < len(out) {
        transport = transportPush(transport, out[i])
        i = i + 1
    }
    if relay != null && relay != undefined {
        let fwd = relayForward(transport, relay)
        transport = fwd["transport"]
        relay = fwd["relay"]
    }
    return { "session": session, "transport": transport, "relay": relay }
}

/// Pull transport inbox into session (optional relay deliver first).
pub fn pullSessionTransport(session, transport, relay) {
    if relay != null && relay != undefined {
        let del = relayDeliver(transport, relay)
        transport = del["transport"]
        relay = del["relay"]
    }
    let msgs = transportReceive(transport)
    let i = 0
    while i < len(msgs) {
        session = receiveRemote(session, msgs[i])
        i = i + 1
    }
    return { "session": session, "transport": transport, "relay": relay }
}

/// Full sync: flush outbox, relay exchange, pull inbox, apply snapshots.
pub fn syncTransport(session, world, transport, relay) {
    let flushed = flushSessionTransport(session, transport, relay)
    session = flushed["session"]
    transport = flushed["transport"]
    relay = flushed["relay"]
    let pulled = pullSessionTransport(session, transport, relay)
    session = pulled["session"]
    transport = pulled["transport"]
    relay = pulled["relay"]
    let polled = pollRemote(session, world)
    return {
        "session": polled["session"],
        "world": polled["world"],
        "transport": transport,
        "relay": relay
    }
}

/// In-process HTTP hub for snapshot transport (uses http_route + hub natives).
pub fn createHttpHub() {
    net_http_hub_reset()
    return {
        "kind": "net_http_hub",
        "pushPath": "/kab/net/push",
        "pollPath": "/kab/net/pull",
        "registered": false
    }
}

pub fn netHttpPushHandler() {
    net_http_hub_push(req_body)
    return http_response(200, "ok")
}

pub fn netHttpPullHandler() {
    let msgs = net_http_hub_poll(1)
    if len(msgs) == 0 {
        return http_response(204, "")
    }
    return http_response(200, msgs[0])
}

pub fn registerHttpHub(hub) {
    http_route("POST", hub["pushPath"], netHttpPushHandler)
    http_route("GET", hub["pollPath"], netHttpPullHandler)
    hub["registered"] = true
    return hub
}

pub fn createHttpTransport(hub) {
    let t = createTransport("http", hub["pushPath"])
    t["pollPath"] = hub["pollPath"]
    t["hub"] = hub
    return transportConnect(t)
}

pub fn flushSessionHttp(session, transport) {
    let out = drainOutgoing(session)
    let i = 0
    while i < len(out) {
        let path = transport["endpoint"]
        if path != null && path != undefined {
            http_request("POST", path, out[i])
        }
        i = i + 1
    }
    return { "session": session, "transport": transport }
}

pub fn pullSessionHttp(session, transport) {
    let path = transport["pollPath"]
    if path != null && path != undefined {
        let res = http_request("GET", path, "")
        if http_status(res) == 200 {
            let body = http_body(res)
            if body != null && body != "" {
                session = receiveRemote(session, body)
            }
        }
    }
    return { "session": session, "transport": transport }
}

pub async fn transportHttpPushAsync(transport, payload) {
    let path = transport["endpoint"]
    if path == null || path == undefined {
        return transport
    }
    await http_request_async("POST", path, payload)
    return transport
}

pub async fn transportHttpPollAsync(transport) {
    let path = transport["pollPath"]
    if path == null || path == undefined {
        return transport
    }
    let res = await http_request_async("GET", path, "")
    if http_status(res) == 200 {
        let body = http_body(res)
        if body != null && body != "" {
            transport["inbox"] = push(transport["inbox"], body)
        }
    }
    return transport
}
