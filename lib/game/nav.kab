@version "1.0.0"

// Kabootar game/nav — grid A* navigation (GP3c subset).
// blocked: array length w*h, 0 walkable / 1 blocked.
// import "game/nav"

pub fn createGrid(w, h, blocked) {
    if blocked == undefined || blocked == null {
        blocked = []
        let i = 0
        while i < w * h {
            blocked = push(blocked, 0)
            i = i + 1
        }
    }
    return { w: w, h: h, blocked: blocked }
}

pub fn setBlocked(grid, x, y, v) {
    if x < 0 || y < 0 || x >= grid["w"] || y >= grid["h"] {
        return grid
    }
    grid["blocked"][y * grid["w"] + x] = v
    return grid
}

pub fn isBlocked(grid, x, y) {
    if x < 0 || y < 0 || x >= grid["w"] || y >= grid["h"] {
        return true
    }
    return grid["blocked"][y * grid["w"] + x] != 0
}

fn keyOf(x, y) {
    return "" + x + "," + y
}

fn heuristic(ax, ay, bx, by) {
    let dx = ax - bx
    let dy = ay - by
    if dx < 0 { dx = 0 - dx }
    if dy < 0 { dy = 0 - dy }
    return dx + dy
}

fn reconstruct(came, gx, gy) {
    let path = [{ x: gx, y: gy }]
    let ck = keyOf(gx, gy)
    let steps = 0
    while came[ck] != undefined && came[ck] != null && steps < 4096 {
        let p = came[ck]
        let next = [{ x: p["x"], y: p["y"] }]
        let i = 0
        while i < len(path) {
            next = push(next, path[i])
            i = i + 1
        }
        path = next
        ck = keyOf(p["x"], p["y"])
        steps = steps + 1
    }
    return path
}

// 4-neighbour A*. Returns [{x,y},…] including start/goal, or null.
pub fn astar(grid, sx, sy, gx, gy) {
    if isBlocked(grid, sx, sy) || isBlocked(grid, gx, gy) {
        return null
    }
    let open = [{ x: sx, y: sy }]
    let came = {}
    let gScore = {}
    let fScore = {}
    gScore[keyOf(sx, sy)] = 0
    fScore[keyOf(sx, sy)] = heuristic(sx, sy, gx, gy)
    let guard = 0
    let maxN = grid["w"] * grid["h"] * 8 + 8
    while len(open) > 0 && guard < maxN {
        guard = guard + 1
        let bi = 0
        let best = fScore[keyOf(open[0]["x"], open[0]["y"])]
        let i = 1
        while i < len(open) {
            let f = fScore[keyOf(open[i]["x"], open[i]["y"])]
            if f < best {
                best = f
                bi = i
            }
            i = i + 1
        }
        let cur = open[bi]
        let nextOpen = []
        i = 0
        while i < len(open) {
            if i != bi {
                nextOpen = push(nextOpen, open[i])
            }
            i = i + 1
        }
        open = nextOpen
        if cur["x"] == gx && cur["y"] == gy {
            return reconstruct(came, gx, gy)
        }
        let dirs = [[1, 0], [-1, 0], [0, 1], [0, -1]]
        let d = 0
        while d < 4 {
            let nx = cur["x"] + dirs[d][0]
            let ny = cur["y"] + dirs[d][1]
            if isBlocked(grid, nx, ny) == false {
                let nk = keyOf(nx, ny)
                let tentative = gScore[keyOf(cur["x"], cur["y"])] + 1
                let prevG = gScore[nk]
                if prevG == undefined || tentative < prevG {
                    came[nk] = { x: cur["x"], y: cur["y"] }
                    gScore[nk] = tentative
                    fScore[nk] = tentative + heuristic(nx, ny, gx, gy)
                    let found = false
                    let oi = 0
                    while oi < len(open) {
                        if open[oi]["x"] == nx && open[oi]["y"] == ny {
                            found = true
                        }
                        oi = oi + 1
                    }
                    if found == false {
                        open = push(open, { x: nx, y: ny })
                    }
                }
            }
            d = d + 1
        }
    }
    return null
}

pub fn pathCost(path) {
    if path == null {
        return -1
    }
    if len(path) <= 1 {
        return 0
    }
    return len(path) - 1
}
