@version "1.0.0"

// Kabootar game/core/scene — scene graph with Parent walk (GP1a).
// Mutators return the node (Kab CoW — reassign at call site).
// Parent chain via Object.setParent / Object.getParent (not prototype).
// Canonical: import "game/core/scene" (also via shim import "game/scene")

pub fn createNode(name) {
    return { name: name, x: 0, y: 0, z: 0, layer: 0, children: [] }
}

pub fn addChild(parent, child) {
    child = Object.setParent(child, parent)
    parent["children"] = push(parent["children"], child)
    return parent
}

pub fn setLocal(node, x, y, z) {
    node["x"] = x
    node["y"] = y
    node["z"] = z
    return node
}

pub fn setLayer(node, layer) {
    node["layer"] = layer
    return node
}

// Walk Object.getParent and sum local xyz.
pub fn worldPos(node) {
    let x = node["x"]
    let y = node["y"]
    let z = node["z"]
    let cur = Object.getParent(node)
    let guard = 0
    while cur != null && guard < 256 {
        x = x + cur["x"]
        y = y + cur["y"]
        z = z + cur["z"]
        cur = Object.getParent(cur)
        guard = guard + 1
    }
    return { x: x, y: y, z: z }
}
