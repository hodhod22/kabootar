@version "1.0.0"

// Kabootar game/core/ecs — thin AoS component store (GP1e subset).
// Canonical path: import "game/core/ecs" (also via shim import "game/ecs")

pub fn createWorld() {
    return { nextId: 1, entities: [], comps: {} }
}

pub fn spawn(world) {
    let id = world["nextId"]
    world["nextId"] = id + 1
    world["entities"] = push(world["entities"], id)
    return id
}

pub fn add(world, id, name, data) {
    let bag = world["comps"][name]
    if bag == undefined || bag == null {
        bag = {}
    }
    bag["" + id] = data
    world["comps"][name] = bag
    return world
}

pub fn get(world, id, name) {
    let bag = world["comps"][name]
    if bag == undefined || bag == null {
        return null
    }
    let v = bag["" + id]
    if v == undefined {
        return null
    }
    return v
}

pub fn has(world, id, name) {
    return get(world, id, name) != null
}

// Returns array of { id, data } for component name.
pub fn query(world, name) {
    let out = []
    let bag = world["comps"][name]
    if bag == undefined || bag == null {
        return out
    }
    let ids = world["entities"]
    let i = 0
    while i < len(ids) {
        let id = ids[i]
        let data = bag["" + id]
        if data != undefined && data != null {
            out = push(out, { id: id, data: data })
        }
        i = i + 1
    }
    return out
}
