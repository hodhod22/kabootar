@version "1.0.0"

// Kabootar game/core/render — thin WebGL mesh helpers (GP1b + GP0d subset).
// floats: Array or Float32Array of vertex components (vec2/vec3/…).
// Canonical: import "game/core/render" (also via shim import "game/render")

pub fn createMesh(gl, floats) {
    let vbo = gl.createBuffer("array", floats)
    gl.bindBuffer(vbo)
    let n = floats.length
    let comps = 2
    if n % 5 == 0 {
        comps = 5
    } else if n % 3 == 0 {
        comps = 3
    } else if n % 4 == 0 {
        comps = 4
    }
    let count = n / comps
    return { gl: gl, vbo: vbo, count: count }
}

pub fn createIndexedMesh(gl, floats, indices) {
    let mesh = createMesh(gl, floats)
    let ibo = gl.createIndexBuffer(indices)
    gl.bindBuffer(ibo)
    mesh["ibo"] = ibo
    mesh["indexCount"] = indices.length
    return mesh
}

pub fn setColor(gl, r, g, b, a) {
    return gl.uniform4f(0, r, g, b, a)
}

pub fn drawMesh(mesh) {
    let gl = mesh["gl"]
    gl.bindBuffer(mesh["vbo"])
    return gl.drawArrays(mesh["count"])
}

pub fn drawIndexedMesh(mesh) {
    let gl = mesh["gl"]
    gl.bindBuffer(mesh["vbo"])
    gl.bindBuffer(mesh["ibo"])
    return gl.drawElements(mesh["indexCount"], 0)
}

pub fn drawMeshInstanced(mesh, instances) {
    let gl = mesh["gl"]
    gl.bindBuffer(mesh["vbo"])
    return gl.drawArraysInstanced(mesh["count"], instances)
}

pub fn drawIndexedMeshInstanced(mesh, instances) {
    let gl = mesh["gl"]
    gl.bindBuffer(mesh["vbo"])
    gl.bindBuffer(mesh["ibo"])
    return gl.drawElementsInstanced(mesh["indexCount"], 0, instances)
}
