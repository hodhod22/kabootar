@version "1.0.0"

// GP6g — Lights & shadow descriptors. import "game/light"
// GPU shadow maps later via wgpu; Kab owns product API.

pub fn createAmbient(color, intensity) {
    if intensity == null || intensity == undefined {
        intensity = 0.2
    }
    return { "kind": "ambient", "color": color, "intensity": intensity }
}

pub fn createDirectional(dir, color, intensity) {
    if intensity == null || intensity == undefined {
        intensity = 1.0
    }
    return {
        "kind": "directional",
        "dir": dir,
        "color": color,
        "intensity": intensity,
        "castShadow": false
    }
}

pub fn createPoint(pos, color, intensity, maxRange) {
    if intensity == null || intensity == undefined {
        intensity = 1.0
    }
    if maxRange == null || maxRange == undefined {
        maxRange = 10.0
    }
    return {
        "kind": "point",
        "pos": pos,
        "color": color,
        "intensity": intensity,
        "range": maxRange,
        "castShadow": false
    }
}

pub fn createSpot(pos, dir, color, intensity, angle, maxRange) {
    if intensity == null || intensity == undefined {
        intensity = 1.0
    }
    if angle == null || angle == undefined {
        angle = 0.5
    }
    if maxRange == null || maxRange == undefined {
        maxRange = 20.0
    }
    return {
        "kind": "spot",
        "pos": pos,
        "dir": dir,
        "color": color,
        "intensity": intensity,
        "angle": angle,
        "range": maxRange,
        "castShadow": false
    }
}

pub fn enableShadow(light, mapSize) {
    if mapSize == null || mapSize == undefined {
        mapSize = 1024
    }
    light["castShadow"] = true
    light["shadow"] = shadowMapDesc(mapSize, 0.005, false)
    return light
}

/// Shadow map descriptor (GPU map deferred; product API in Kab).
pub fn shadowMapDesc(mapSize, bias, soft) {
    if mapSize == null || mapSize == undefined {
        mapSize = 1024
    }
    if bias == null || bias == undefined {
        bias = 0.005
    }
    if soft == null || soft == undefined {
        soft = false
    }
    return {
        "kind": "shadow-map",
        "mapSize": mapSize,
        "bias": bias,
        "soft": soft,
        "radius": 0.0
    }
}

pub fn enableSoftShadow(light, mapSize, radius) {
    if mapSize == null || mapSize == undefined {
        mapSize = 1024
    }
    if radius == null || radius == undefined {
        radius = 1.5
    }
    light["castShadow"] = true
    let sh = shadowMapDesc(mapSize, 0.004, true)
    sh["radius"] = radius
    light["shadow"] = sh
    return light
}

pub fn describeShadow(light) {
    if light["castShadow"] != true {
        return null
    }
    return light["shadow"]
}

/// GPU shadow map render (wgpu depth pass when available; descriptor enriched).
pub fn renderGpuShadow(shadow, mesh) {
    if shadow == null || shadow == undefined {
        return { "ok": false, "reason": "no_shadow" }
    }
    if mesh == null || mesh == undefined {
        return { "ok": false, "reason": "no_mesh" }
    }
    let mapSize = shadow["mapSize"]
    if mapSize == null || mapSize == undefined {
        mapSize = 512
    }
    let out = game_gpu_shadow_render({
        "mapSize": mapSize,
        "bias": shadow["bias"],
        "soft": shadow["soft"],
        "radius": shadow["radius"],
        "positions": mesh["positions"],
        "indices": mesh["indices"]
    })
    shadow["gpu"] = out
    return { "ok": out["rendered"] == true, "shadow": shadow, "gpu": out }
}

pub fn createLightList() {
    return { "lights": [], "ambient": createAmbient([1.0, 1.0, 1.0], 0.15) }
}

pub fn addLight(list, light) {
    list["lights"] = push(list["lights"], light)
    return list
}

pub fn setAmbient(list, ambient) {
    list["ambient"] = ambient
    return list
}

/// Lambert-style contribution descriptor (CPU stub for one directional).
pub fn directionalContribution(light, normal) {
    let dx = 0.0 - light["dir"]["x"]
    let dy = 0.0 - light["dir"]["y"]
    let dz = 0.0 - light["dir"]["z"]
    let length = sqrt(dx * dx + dy * dy + dz * dz)
    if length < 0.000001 {
        return { "r": 0.0, "g": 0.0, "b": 0.0, "ndotl": 0.0 }
    }
    dx = dx / length
    dy = dy / length
    dz = dz / length
    let ndotl = normal["x"] * dx + normal["y"] * dy + normal["z"] * dz
    if ndotl < 0.0 {
        ndotl = 0.0
    }
    let intensity = light["intensity"] * ndotl
    return {
        "r": light["color"][0] * intensity,
        "g": light["color"][1] * intensity,
        "b": light["color"][2] * intensity,
        "ndotl": ndotl
    }
}

/// Shadow-map UV for directional light (XZ projection stub).
pub fn shadowUvDirectional(light, point) {
    let u = (point["x"] + 5.0) / 10.0
    let v = (point["z"] + 5.0) / 10.0
  return { "u": u, "v": v }
}

/// CPU shadow visibility sample (0 = fully shadowed, 1 = lit).
pub fn sampleShadowCpu(shadow, u, v) {
    if u < 0.0 || u > 1.0 || v < 0.0 || v > 1.0 {
        return 1.0
    }
    let du = u - 0.5
    let dv = v - 0.5
    let dist = sqrt(du * du + dv * dv)
    let factor = 1.0
    if dist > 0.35 {
        factor = 0.25
    }
    if shadow["soft"] == true {
        let r = shadow["radius"]
        if r == null || r == undefined {
            r = 1.5
        }
        let t = dist / (0.35 + r * 0.08)
        if t > 1.0 {
            t = 1.0
        }
        factor = factor + (1.0 - factor) * t
    }
    return factor
}

pub fn shadowFactorDirectional(light, point) {
    if light["castShadow"] != true {
        return 1.0
    }
    let shadow = light["shadow"]
    if shadow == null || shadow == undefined {
        return 1.0
    }
    let uv = shadowUvDirectional(light, point)
    let factor = sampleShadowCpu(shadow, uv["u"], uv["v"])
    if shadow["gpu"] != null && shadow["gpu"] != undefined && shadow["gpu"]["rendered"] == true {
        let gpu = game_gpu_shadow_sample({
            "shadow": shadow,
            "point": point,
            "lightDir": light["dir"],
            "u": uv["u"],
            "v": uv["v"]
        })
        if gpu["factor"] != null && gpu["factor"] != undefined {
            factor = gpu["factor"]
        }
    }
    return factor
}

pub fn applyShadow(contrib, factor) {
    return {
        "r": contrib["r"] * factor,
        "g": contrib["g"] * factor,
        "b": contrib["b"] * factor,
        "ndotl": contrib["ndotl"],
        "shadow": factor
    }
}

/// Directional Lambert + shadow sampling.
pub fn directionalLit(light, normal, point) {
    let contrib = directionalContribution(light, normal)
    let factor = shadowFactorDirectional(light, point)
    return applyShadow(contrib, factor)
}

/// Ambient + directional lights with shadow factors.
pub fn litSurface(lights, normal, point) {
    let amb = lights["ambient"]
    let r = amb["color"][0] * amb["intensity"]
    let g = amb["color"][1] * amb["intensity"]
    let b = amb["color"][2] * amb["intensity"]
    let i = 0
    while i < len(lights["lights"]) {
        let L = lights["lights"][i]
        if L["kind"] == "directional" {
            let c = directionalLit(L, normal, point)
            r = r + c["r"]
            g = g + c["g"]
            b = b + c["b"]
        }
        i = i + 1
    }
    return { "r": r, "g": g, "b": b }
}

pub fn iblLite(ambient, strength) {
    if strength == null || strength == undefined {
        strength = 1.0
    }
    return {
        "kind": "ibl-lite",
        "color": ambient["color"],
        "intensity": ambient["intensity"] * strength
    }
}

pub fn describeLights(list) {
    let kinds = []
    let i = 0
    while i < len(list["lights"]) {
        kinds = push(kinds, list["lights"][i]["kind"])
        i = i + 1
    }
    return {
        "ambient": list["ambient"]["kind"],
        "count": len(kinds),
        "kinds": kinds
    }
}
