@version "1.0.0"

// GP6g — Lights & shadow descriptors. import "game/light"
// GPU shadow maps later via wgpu; Kab owns product API.

pub fn createAmbient(color, intensity) {
    if intensity == null || intensity == undefined {
        intensity = 0.2
    }
    return { "kind": "ambient", "color": color, "intensity": intensity }
}

pub fn createDirectional(dir, color, intensity) {
    if intensity == null || intensity == undefined {
        intensity = 1.0
    }
    return {
        "kind": "directional",
        "dir": dir,
        "color": color,
        "intensity": intensity,
        "castShadow": false
    }
}

pub fn createPoint(pos, color, intensity, maxRange) {
    if intensity == null || intensity == undefined {
        intensity = 1.0
    }
    if maxRange == null || maxRange == undefined {
        maxRange = 10.0
    }
    return {
        "kind": "point",
        "pos": pos,
        "color": color,
        "intensity": intensity,
        "range": maxRange,
        "castShadow": false
    }
}

pub fn createSpot(pos, dir, color, intensity, angle, maxRange) {
    if intensity == null || intensity == undefined {
        intensity = 1.0
    }
    if angle == null || angle == undefined {
        angle = 0.5
    }
    if maxRange == null || maxRange == undefined {
        maxRange = 20.0
    }
    return {
        "kind": "spot",
        "pos": pos,
        "dir": dir,
        "color": color,
        "intensity": intensity,
        "angle": angle,
        "range": maxRange,
        "castShadow": false
    }
}

pub fn enableShadow(light, mapSize) {
    if mapSize == null || mapSize == undefined {
        mapSize = 1024
    }
    light["castShadow"] = true
    light["shadow"] = shadowMapDesc(mapSize, 0.005, false)
    return light
}

/// Shadow map descriptor (GPU map deferred; product API in Kab).
pub fn shadowMapDesc(mapSize, bias, soft) {
    if mapSize == null || mapSize == undefined {
        mapSize = 1024
    }
    if bias == null || bias == undefined {
        bias = 0.005
    }
    if soft == null || soft == undefined {
        soft = false
    }
    return {
        "kind": "shadow-map",
        "mapSize": mapSize,
        "bias": bias,
        "soft": soft,
        "radius": 0.0
    }
}

pub fn enableSoftShadow(light, mapSize, radius) {
    if mapSize == null || mapSize == undefined {
        mapSize = 1024
    }
    if radius == null || radius == undefined {
        radius = 1.5
    }
    light["castShadow"] = true
    let sh = shadowMapDesc(mapSize, 0.004, true)
    sh["radius"] = radius
    light["shadow"] = sh
    return light
}

pub fn describeShadow(light) {
    if light["castShadow"] != true {
        return null
    }
    return light["shadow"]
}

/// GPU shadow map render (wgpu depth pass when available; descriptor enriched).
pub fn renderGpuShadow(shadow, mesh) {
    if shadow == null || shadow == undefined {
        return { "ok": false, "reason": "no_shadow" }
    }
    if mesh == null || mesh == undefined {
        return { "ok": false, "reason": "no_mesh" }
    }
    let mapSize = shadow["mapSize"]
    if mapSize == null || mapSize == undefined {
        mapSize = 512
    }
    let out = game_gpu_shadow_render({
        "mapSize": mapSize,
        "bias": shadow["bias"],
        "soft": shadow["soft"],
        "radius": shadow["radius"],
        "positions": mesh["positions"],
        "indices": mesh["indices"]
    })
    shadow["gpu"] = out
    return { "ok": out["rendered"] == true, "shadow": shadow, "gpu": out }
}

pub fn createLightList() {
    return { "lights": [], "ambient": createAmbient([1.0, 1.0, 1.0], 0.15) }
}

pub fn addLight(list, light) {
    list["lights"] = push(list["lights"], light)
    return list
}

pub fn setAmbient(list, ambient) {
    list["ambient"] = ambient
    return list
}

/// Lambert-style contribution descriptor (CPU stub for one directional).
pub fn directionalContribution(light, normal) {
    let dx = 0.0 - light["dir"]["x"]
    let dy = 0.0 - light["dir"]["y"]
    let dz = 0.0 - light["dir"]["z"]
    let length = sqrt(dx * dx + dy * dy + dz * dz)
    if length < 0.000001 {
        return { "r": 0.0, "g": 0.0, "b": 0.0, "ndotl": 0.0 }
    }
    dx = dx / length
    dy = dy / length
    dz = dz / length
    let ndotl = normal["x"] * dx + normal["y"] * dy + normal["z"] * dz
    if ndotl < 0.0 {
        ndotl = 0.0
    }
    let intensity = light["intensity"] * ndotl
    return {
        "r": light["color"][0] * intensity,
        "g": light["color"][1] * intensity,
        "b": light["color"][2] * intensity,
        "ndotl": ndotl
    }
}

/// Shadow-map UV for directional light (XZ projection stub).
pub fn shadowUvDirectional(light, point) {
    let u = (point["x"] + 5.0) / 10.0
    let v = (point["z"] + 5.0) / 10.0
  return { "u": u, "v": v }
}

/// CPU shadow visibility sample (0 = fully shadowed, 1 = lit).
pub fn sampleShadowCpu(shadow, u, v) {
    if u < 0.0 || u > 1.0 || v < 0.0 || v > 1.0 {
        return 1.0
    }
    let du = u - 0.5
    let dv = v - 0.5
    let dist = sqrt(du * du + dv * dv)
    let factor = 1.0
    if dist > 0.35 {
        factor = 0.25
    }
    if shadow["soft"] == true {
        let r = shadow["radius"]
        if r == null || r == undefined {
            r = 1.5
        }
        let t = dist / (0.35 + r * 0.08)
        if t > 1.0 {
            t = 1.0
        }
        factor = factor + (1.0 - factor) * t
    }
    return factor
}

pub fn shadowFactorDirectional(light, point) {
    if light["castShadow"] != true {
        return 1.0
    }
    let shadow = light["shadow"]
    if shadow == null || shadow == undefined {
        return 1.0
    }
    let uv = shadowUvDirectional(light, point)
    let factor = sampleShadowCpu(shadow, uv["u"], uv["v"])
    if shadow["gpu"] != null && shadow["gpu"] != undefined && shadow["gpu"]["rendered"] == true {
        let gpu = game_gpu_shadow_sample({
            "shadow": shadow,
            "point": point,
            "lightDir": light["dir"],
            "u": uv["u"],
            "v": uv["v"]
        })
        if gpu["factor"] != null && gpu["factor"] != undefined {
            factor = gpu["factor"]
        }
    }
    return factor
}

pub fn applyShadow(contrib, factor) {
    return {
        "r": contrib["r"] * factor,
        "g": contrib["g"] * factor,
        "b": contrib["b"] * factor,
        "ndotl": contrib["ndotl"],
        "shadow": factor
    }
}

/// Directional Lambert + shadow sampling.
pub fn directionalLit(light, normal, point) {
    let contrib = directionalContribution(light, normal)
    let factor = shadowFactorDirectional(light, point)
    return applyShadow(contrib, factor)
}

/// Ambient + directional lights with shadow factors.
pub fn litSurface(lights, normal, point) {
    let amb = lights["ambient"]
    let r = amb["color"][0] * amb["intensity"]
    let g = amb["color"][1] * amb["intensity"]
    let b = amb["color"][2] * amb["intensity"]
    let i = 0
    while i < len(lights["lights"]) {
        let L = lights["lights"][i]
        if L["kind"] == "directional" {
            let c = directionalLit(L, normal, point)
            r = r + c["r"]
            g = g + c["g"]
            b = b + c["b"]
        }
        i = i + 1
    }
    return { "r": r, "g": g, "b": b }
}

pub fn iblLite(ambient, strength) {
    if strength == null || strength == undefined {
        strength = 1.0
    }
    return {
        "kind": "ibl-lite",
        "color": ambient["color"],
        "intensity": ambient["intensity"] * strength
    }
}

pub fn describeLights(list) {
    let kinds = []
    let i = 0
    while i < len(list["lights"]) {
        kinds = push(kinds, list["lights"][i]["kind"])
        i = i + 1
    }
    return {
        "ambient": list["ambient"]["kind"],
        "count": len(kinds),
        "kinds": kinds
    }
}

/// PBR Lighting calculation - Cook-Torrance BRDF.
pub fn pbrLighting(viewDir, normal, lightDir, lightColor, lightIntensity, albedo, metallic, roughness, f0) {
    let NdotL = normal["x"] * lightDir["x"] + normal["y"] * lightDir["y"] + normal["z"] * lightDir["z"]
    if NdotL < 0.0 { NdotL = 0.0 }
    
    let NdotV = normal["x"] * viewDir["x"] + normal["y"] * viewDir["y"] + normal["z"] * viewDir["z"]
    if NdotV < 0.0 { NdotV = 0.0 }
    
    let H = {
        "x": viewDir["x"] + lightDir["x"],
        "y": viewDir["y"] + lightDir["y"],
        "z": viewDir["z"] + lightDir["z"]
    }
    let Hlen = sqrt(H["x"] * H["x"] + H["y"] * H["y"] + H["z"] * H["z"])
    if Hlen > 0.0001 {
        H["x"] = H["x"] / Hlen
        H["y"] = H["y"] / Hlen
        H["z"] = H["z"] / Hlen
    }
    
    let NdotH = normal["x"] * H["x"] + normal["y"] * H["y"] + normal["z"] * H["z"]
    if NdotH < 0.0 { NdotH = 0.0 }
    
    let VdotH = viewDir["x"] * H["x"] + viewDir["y"] * H["y"] + viewDir["z"] * H["z"]
    if VdotH < 0.0 { VdotH = 0.0 }
    
    let roughness2 = roughness * roughness
    
    let D = distributionGGX(NdotH, roughness2)
    let G = geometrySmith(NdotV, NdotL, roughness2)
    let F = fresnelSchlick(VdotH, f0)
    
    let kS = F
    let kD = { "r": 1.0 - F["r"], "g": 1.0 - F["g"], "b": 1.0 - F["b"] }
    
    kD["r"] = kD["r"] * (1.0 - metallic)
    kD["g"] = kD["g"] * (1.0 - metallic)
    kD["b"] = kD["b"] * (1.0 - metallic)
    
    let specular = {
        "r": D * G * F["r"] / (4.0 * NdotV * NdotL + 0.0001),
        "g": D * G * F["g"] / (4.0 * NdotV * NdotL + 0.0001),
        "b": D * G * F["b"] / (4.0 * NdotV * NdotL + 0.0001)
    }
    
    let diffuse = {
        "r": kD["r"] * albedo["r"] / 3.14159,
        "g": kD["g"] * albedo["g"] / 3.14159,
        "b": kD["b"] * albedo["b"] / 3.14159
    }
    
    let Lo = {
        "r": (diffuse["r"] + specular["r"]) * lightColor["r"] * lightIntensity * NdotL,
        "g": (diffuse["g"] + specular["g"]) * lightColor["g"] * lightIntensity * NdotL,
        "b": (diffuse["b"] + specular["b"]) * lightColor["b"] * lightIntensity * NdotL
    }
    
    return Lo
}

fn distributionGGX(NdotH, roughness2) {
    let a = roughness2 * roughness2
    let a2 = a * a
    let NdotH2 = NdotH * NdotH
    let denom = NdotH2 * (a2 - 1.0) + 1.0
    denom = 3.14159 * denom * denom
    return a2 / denom
}

fn geometrySmith(NdotV, NdotL, roughness2) {
    let ggx2 = geometrySchlickGGX(NdotV, roughness2)
    let ggx1 = geometrySchlickGGX(NdotL, roughness2)
    return ggx1 * ggx2
}

fn geometrySchlickGGX(NdotV, roughness2) {
    let r = (roughness2 + 1.0)
    let k = (r * r) / 8.0
    let denom = NdotV * (1.0 - k) + k
    return NdotV / denom
}

fn fresnelSchlick(cosTheta, f0) {
    return {
        "r": f0["r"] + (1.0 - f0["r"]) * pow(1.0 - cosTheta, 5.0),
        "g": f0["g"] + (1.0 - f0["g"]) * pow(1.0 - cosTheta, 5.0),
        "b": f0["b"] + (1.0 - f0["b"]) * pow(1.0 - cosTheta, 5.0)
    }
}

/// Calculate F0 (reflectance at normal incidence) from metallic and albedo.
pub fn calculateF0(albedo, metallic) {
    return {
        "r": lerp(0.04, albedo["r"], metallic),
        "g": lerp(0.04, albedo["g"], metallic),
        "b": lerp(0.04, albedo["b"], metallic)
    }
}

/// Full PBR lighting with multiple lights and IBL.
pub fn pbrSurface(viewDir, normal, albedo, metallic, roughness, ao, lights, iblColor, iblIntensity) {
    let f0 = calculateF0(albedo, metallic)
    
    let Lo = { "r": 0.0, "g": 0.0, "b": 0.0 }
    
    let i = 0
    while i < len(lights["lights"]) {
        let light = lights["lights"][i]
        let lightDir = { "x": 0.0, "y": 0.0, "z": 0.0 }
        let lightIntensity = light["intensity"]
        let lightColor = light["color"]
        
        if light["kind"] == "directional" {
            lightDir["x"] = -light["dir"]["x"]
            lightDir["y"] = -light["dir"]["y"]
            lightDir["z"] = -light["dir"]["z"]
            let len = sqrt(lightDir["x"] * lightDir["x"] + lightDir["y"] * lightDir["y"] + lightDir["z"] * lightDir["z"])
            if len > 0.0001 {
                lightDir["x"] = lightDir["x"] / len
                lightDir["y"] = lightDir["y"] / len
                lightDir["z"] = lightDir["z"] / len
            }
        } else if light["kind"] == "point" {
            lightDir["x"] = light["pos"]["x"]
            lightDir["y"] = light["pos"]["y"]
            lightDir["z"] = light["pos"]["z"]
            let len = sqrt(lightDir["x"] * lightDir["x"] + lightDir["y"] * lightDir["y"] + lightDir["z"] * lightDir["z"])
            if len > 0.0001 {
                lightDir["x"] = lightDir["x"] / len
                lightDir["y"] = lightDir["y"] / len
                lightDir["z"] = lightDir["z"] / len
            }
            let distance = len
            let attenuation = 1.0 / (1.0 + 0.09 * distance + 0.032 * distance * distance)
            lightIntensity = lightIntensity * attenuation
        } else if light["kind"] == "spot" {
            lightDir["x"] = light["pos"]["x"]
            lightDir["y"] = light["pos"]["y"]
            lightDir["z"] = light["pos"]["z"]
            let len = sqrt(lightDir["x"] * lightDir["x"] + lightDir["y"] * lightDir["y"] + lightDir["z"] * lightDir["z"])
            if len > 0.0001 {
                lightDir["x"] = lightDir["x"] / len
                lightDir["y"] = lightDir["y"] / len
                lightDir["z"] = lightDir["z"] / len
            }
            let distance = len
            let attenuation = 1.0 / (1.0 + 0.09 * distance + 0.032 * distance * distance)
            
            let theta = lightDir["x"] * light["dir"]["x"] + lightDir["y"] * light["dir"]["y"] + lightDir["z"] * light["dir"]["z"]
            let epsilon = cos(light["angle"])
            let spotIntensity = 0.0
            if theta > epsilon {
                spotIntensity = pow(theta - epsilon, 0.5) / (cos(0.0) - epsilon)
            }
            lightIntensity = lightIntensity * attenuation * spotIntensity
        }
        
        let contribution = pbrLighting(viewDir, normal, lightDir, lightColor, lightIntensity, albedo, metallic, roughness, f0)
        Lo["r"] = Lo["r"] + contribution["r"]
        Lo["g"] = Lo["g"] + contribution["g"]
        Lo["b"] = Lo["b"] + contribution["b"]
        
        i = i + 1
    }
    
    let ambient = lights["ambient"]
    let kS = fresnelSchlick(max(normal["y"], 0.0), f0)
    let kD = { "r": 1.0 - kS["r"], "g": 1.0 - kS["g"], "b": 1.0 - kS["b"] }
    kD["r"] = kD["r"] * (1.0 - metallic)
    kD["g"] = kD["g"] * (1.0 - metallic)
    kD["b"] = kD["b"] * (1.0 - metallic)
    
    let irradiance = {
        "r": iblColor["r"] * iblIntensity,
        "g": iblColor["g"] * iblIntensity,
        "b": iblColor["b"] * iblIntensity
    }
    
    let diffuseIBL = {
        "r": irradiance["r"] * kD["r"] * albedo["r"],
        "g": irradiance["g"] * kD["g"] * albedo["g"],
        "b": irradiance["b"] * kD["b"] * albedo["b"]
    }
    
    let ambientColor = {
        "r": ambient["color"][0] * ambient["intensity"] * ao,
        "g": ambient["color"][1] * ambient["intensity"] * ao,
        "b": ambient["color"][2] * ambient["intensity"] * ao
    }
    
    let color = {
        "r": Lo["r"] + diffuseIBL["r"] + ambientColor["r"],
        "g": Lo["g"] + diffuseIBL["g"] + ambientColor["g"],
        "b": Lo["b"] + diffuseIBL["b"] + ambientColor["b"]
    }
    
    color["r"] = color["r"] + albedo["r"] * 0.01
    color["g"] = color["g"] + albedo["g"] * 0.01
    color["b"] = color["b"] + albedo["b"] * 0.01
    
    return color
}

/// Environment probe for reflections.
pub fn createEnvironmentProbe(position, resolution, importance) {
    if resolution == null || resolution == undefined { resolution = 128 }
    if importance == null || importance == undefined { importance = 1.0 }
    return {
        "kind": "EnvironmentProbe",
        "position": position,
        "resolution": resolution,
        "importance": importance,
        "cubemap": null,
        "baked": false
    }
}

/// Reflection probe blending.
pub fn blendReflectionProbes(probes, worldPos, normal) {
    if len(probes) == 0 {
        return null
    }
    
    let totalWeight = 0.0
    let blendedColor = { "r": 0.0, "g": 0.0, "b": 0.0 }
    
    let i = 0
    while i < len(probes) {
        let probe = probes[i]
        let dx = worldPos["x"] - probe["position"]["x"]
        let dy = worldPos["y"] - probe["position"]["y"]
        let dz = worldPos["z"] - probe["position"]["z"]
        let dist = sqrt(dx * dx + dy * dy + dz * dz)
        
        let weight = probe["importance"] / (dist + 0.001)
        totalWeight = totalWeight + weight
        
        if probe["cubemap"] != null {
            blendedColor["r"] = blendedColor["r"] + probe["cubemap"]["r"] * weight
            blendedColor["g"] = blendedColor["g"] + probe["cubemap"]["g"] * weight
            blendedColor["b"] = blendedColor["b"] + probe["cubemap"]["b"] * weight
        }
        
        i = i + 1
    }
    
    if totalWeight > 0.0001 {
        blendedColor["r"] = blendedColor["r"] / totalWeight
        blendedColor["g"] = blendedColor["g"] / totalWeight
        blendedColor["b"] = blendedColor["b"] / totalWeight
    }
    
    return blendedColor
}
