@version "1.0.0"

// Kv8 interpreter in Kabootar. import "kv8/eval"
// Fas 2: evRunBlock for nested blocks/calls. Pub entries keep their program loop
// (import of a taller mutual-rec fn graph hung on Windows during module init).
// Binary/member/call: module stacks (fn locals not re-entrant in .kbc).

import "kv8/parser"
import "kv8/defs"
import "kv8/host"

let evBxOp = ""
let evLhs = 0
let evRhsVal = 0
let evBinOpStack = []
let evBinRStack = []
let evBinLStack = []
let evMemObjStack = []
let evMemFieldStack = []
let evCallFnStack = []
let evCallArgsStack = []
let evAiStack = []
let evAi = 0
let evPopNew = []
let evPopI = 0

fn evPopStack(stack) {
    evPopNew = []
    evPopI = 0
    while evPopI < len(stack) - 1 {
        evPopNew = push(evPopNew, stack[evPopI])
        evPopI = evPopI + 1
    }
    return evPopNew
}

fn evExpr(node, env) {
    if node.kind == K_LITERAL {
        if node.lit == LIT_NUMBER {
            return parse_int(node.value)
        }
        return node.value
    }
    if node.kind == K_IDENT {
        let bindSym = node["sym"]
        if !object_has_own(env, bindSym) {
            throw "ReferenceError: " + bindSym
        }
        return env[bindSym]
    }
    if node.kind == K_BINARY {
        evBinOpStack = push(evBinOpStack, node.op)
        evBinRStack = push(evBinRStack, node.right)
        evBinLStack = push(evBinLStack, evExpr(node.left, env))
        evRhsVal = evExpr(evBinRStack[len(evBinRStack) - 1], env)
        evLhs = evBinLStack[len(evBinLStack) - 1]
        evBxOp = evBinOpStack[len(evBinOpStack) - 1]
        evBinLStack = evPopStack(evBinLStack)
        evBinOpStack = evPopStack(evBinOpStack)
        evBinRStack = evPopStack(evBinRStack)
        if evBxOp == "+" { return evLhs + evRhsVal }
        if evBxOp == "-" { return evLhs - evRhsVal }
        if evBxOp == "*" { return evLhs * evRhsVal }
        if evBxOp == "/" { return evLhs / evRhsVal }
        if evBxOp == "==" { return evLhs == evRhsVal }
        if evBxOp == "===" { return evLhs == evRhsVal }
        if evBxOp == "!=" { return evLhs != evRhsVal }
        if evBxOp == "!==" { return evLhs != evRhsVal }
        if evBxOp == "<" { return evLhs < evRhsVal }
        if evBxOp == ">" { return evLhs > evRhsVal }
        if evBxOp == "<=" { return evLhs <= evRhsVal }
        if evBxOp == ">=" { return evLhs >= evRhsVal }
        if evBxOp == "&&" {
            if !evLhs { return evLhs }
            return evRhsVal
        }
        if evBxOp == "||" {
            if evLhs { return evLhs }
            return evRhsVal
        }
        if evBxOp == "??" {
            if evLhs == null || evLhs == undefined {
                return evRhsVal
            }
            return evLhs
        }
        throw "Unsupported op " + evBxOp
    }
    if node.kind == K_MEMBER {
        evMemFieldStack = push(evMemFieldStack, "" + node.field)
        evMemObjStack = push(evMemObjStack, node.object)
        let obj = evExpr(evMemObjStack[len(evMemObjStack) - 1], env)
        let memField = evMemFieldStack[len(evMemFieldStack) - 1]
        evMemObjStack = evPopStack(evMemObjStack)
        evMemFieldStack = evPopStack(evMemFieldStack)
        if obj == null || obj == undefined {
            throw "TypeError: cannot read property " + memField
        }
        if object_has_own(obj, memField) {
            return obj[memField]
        }
        return undefined
    }
    if node.kind == K_CALL {
        evCallFnStack = push(evCallFnStack, node.callee)
        evCallArgsStack = push(evCallArgsStack, node.args)
        let callee = evExpr(evCallFnStack[len(evCallFnStack) - 1], env)
        let callArgNodes = evCallArgsStack[len(evCallArgsStack) - 1]
        evCallFnStack = evPopStack(evCallFnStack)
        evCallArgsStack = evPopStack(evCallArgsStack)
        let fnTag = callee["tag"]
        if fnTag == "k8host" {
            let hostName = callee["name"]
            let hostArgs = []
            evAiStack = push(evAiStack, 0)
            while evAiStack[len(evAiStack) - 1] < len(callArgNodes) {
                evAi = evAiStack[len(evAiStack) - 1]
                hostArgs = push(hostArgs, evExpr(callArgNodes[evAi], env))
                evAi = evAiStack[len(evAiStack) - 1] + 1
                evAiStack = evPopStack(evAiStack)
                evAiStack = push(evAiStack, evAi)
            }
            evAiStack = evPopStack(evAiStack)
            return hostCall(hostName, hostArgs)
        }
        let fnArgs = []
        evAiStack = push(evAiStack, 0)
        while evAiStack[len(evAiStack) - 1] < len(callArgNodes) {
            evAi = evAiStack[len(evAiStack) - 1]
            fnArgs = push(fnArgs, evExpr(callArgNodes[evAi], env))
            evAi = evAiStack[len(evAiStack) - 1] + 1
            evAiStack = evPopStack(evAiStack)
            evAiStack = push(evAiStack, evAi)
        }
        evAiStack = evPopStack(evAiStack)
        return evCall(callee, fnArgs)
    }
    throw "eval expr " + node.kind
}

fn evRunBlock(stmts, env) {
    let last = undefined
    let si = 0
    while si < len(stmts) {
        let st = stmts[si]
        if st.kind == K_WHILE {
            let condNode = st.cond
            let bodyStmts = st.body.body
            while true {
                if !evExpr(condNode, env) {
                    break
                }
                let bi = 0
                while bi < len(bodyStmts) {
                    last = evStmt(bodyStmts[bi], env)
                    bi = bi + 1
                }
            }
            last = undefined
        } else {
            last = evStmt(st, env)
        }
        si = si + 1
    }
    return last
}

fn evCall(fnVal, args) {
    if fnVal == null || fnVal == undefined {
        throw "TypeError: not a function"
    }
    let fnTag = fnVal["tag"]
    if fnTag == "k8host" {
        let hostName = fnVal["name"]
        return hostCall(hostName, args)
    }
    if fnTag != "k8fn" {
        throw "TypeError: not a k8 function"
    }
    let fnBody = fnVal["body"]
    let fnParams = fnVal["params"]
    let fnClosure = fnVal["closure"]
    let fnArrow = fnVal["arrow"]
    let scope = {}
    let keys = object_keys(fnClosure)
    let ci = 0
    while ci < len(keys) {
        scope[keys[ci]] = fnClosure[keys[ci]]
        ci = ci + 1
    }
    let pi = 0
    while pi < len(fnParams) {
        scope[fnParams[pi]] = args[pi]
        pi = pi + 1
    }
    if fnArrow {
        return evExpr(fnBody[0], scope)
    }
    return evRunBlock(fnBody, scope)
}

fn evStmt(stmt, env) {
    let stmtKind = stmt.kind
    if stmtKind == K_FN {
        let scope = {}
        let keys = object_keys(env)
        let fi = 0
        while fi < len(keys) {
            scope[keys[fi]] = env[keys[fi]]
            fi = fi + 1
        }
        let bindSym = stmt["sym"]
        env["" + bindSym] = { "tag": "k8fn", "params": stmt.params, "body": stmt.body.body, "closure": scope, "arrow": false }
        return undefined
    }
    if stmtKind == K_RETURN {
        return evExpr(stmt["rhs"], env)
    }
    if stmtKind == K_IF {
        let condNode = stmt.cond
        if evExpr(condNode, env) {
            return evRunBlock(stmt.then.body, env)
        }
        if stmt.elseBranch != null {
            if len(stmt.elseBranch) > 0 {
                return evRunBlock(stmt.elseBranch, env)
            }
        }
        return undefined
    }
    if stmtKind == K_LET || stmtKind == K_VAR {
        let bindSym = stmt["sym"]
        env["" + bindSym] = evExpr(stmt.init, env)
        return undefined
    }
    if stmtKind == K_ASSIGN {
        let bindSym = stmt["sym"]
        env["" + bindSym] = evExpr(stmt["rhs"], env)
        return undefined
    }
    if stmtKind == K_EXPR {
        return evExpr(stmt.expr, env)
    }
    if stmtKind == K_BLOCK {
        return evRunBlock(stmt.body, env)
    }
    throw "eval stmt " + stmtKind
}

pub fn evalProgram(ast, extraEnv) {
    let env = {}
    if extraEnv != null {
        let keys = object_keys(extraEnv)
        let ei = 0
        while ei < len(keys) {
            env[keys[ei]] = extraEnv[keys[ei]]
            ei = ei + 1
        }
    }
    let stmts = ast.body
    let last = undefined
    let si = 0
    while si < len(stmts) {
        let st = stmts[si]
        if st.kind == K_WHILE {
            let condNode = st.cond
            let bodyStmts = st.body.body
            while true {
                if !evExpr(condNode, env) {
                    break
                }
                let bi = 0
                while bi < len(bodyStmts) {
                    last = evStmt(bodyStmts[bi], env)
                    bi = bi + 1
                }
            }
            last = undefined
        } else {
            last = evStmt(st, env)
        }
        si = si + 1
    }
    return last
}

pub fn evalSourceWith(source, extraEnv) {
    let ast = parseSource(source)
    let env = {}
    if extraEnv != null {
        let keys = object_keys(extraEnv)
        let ei = 0
        while ei < len(keys) {
            env[keys[ei]] = extraEnv[keys[ei]]
            ei = ei + 1
        }
    }
    let stmts = ast.body
    let last = undefined
    let si = 0
    while si < len(stmts) {
        let st = stmts[si]
        if st.kind == K_WHILE {
            let condNode = st.cond
            let bodyStmts = st.body.body
            while true {
                if !evExpr(condNode, env) {
                    break
                }
                let bi = 0
                while bi < len(bodyStmts) {
                    last = evStmt(bodyStmts[bi], env)
                    bi = bi + 1
                }
            }
            last = undefined
        } else {
            last = evStmt(st, env)
        }
        si = si + 1
    }
    return last
}

pub fn evalSource(source) {
    let ast = parseSource(source)
    let env = {}
    let stmts = ast.body
    let last = undefined
    let si = 0
    while si < len(stmts) {
        let st = stmts[si]
        if st.kind == K_WHILE {
            let condNode = st.cond
            let bodyStmts = st.body.body
            while true {
                if !evExpr(condNode, env) {
                    break
                }
                let bi = 0
                while bi < len(bodyStmts) {
                    last = evStmt(bodyStmts[bi], env)
                    bi = bi + 1
                }
            }
            last = undefined
        } else {
            last = evStmt(st, env)
        }
        si = si + 1
    }
    return last
}
