@version "1.0.0"

// Kv8 interpreter in Kabootar. import "kv8/eval"
// Fas 2: evRunBlock for nested blocks/calls. Pub entries keep their program loop
// (import of a taller mutual-rec fn graph hung on Windows during module init).
// Binary/member/call: module stacks (fn locals not re-entrant in .kbc).

import "kv8/parser"
import "kv8/defs"
import "kv8/host"

let evBxOp = ""
let evLhs = 0
let evRhsVal = 0
let evBinOpStack = []
let evBinRStack = []
let evBinLStack = []
let evMemObjStack = []
let evMemFieldStack = []
let evCallFnStack = []
let evCallArgsStack = []
let evAiStack = []
let evAi = 0
let evLoopSig = 0
let evThisOut = null
// K1g: Promise.then microtask queue
let evMicroQ = []
let evMicroLast = undefined
// H4: product path is Kab-only (evalSourceWith).
let useKabEval = true
// H6a: element listeners (parallel arrays — avoid deep-copy of k8fn in objects)
let evListenKeys = []
let evListenCbs = []
let evTimerQ = []
let evRafQ = []
let evTimerId = 1
// Shared eval env for arrow callbacks (must be the only env object).
let evActiveEnv = null

// Stack pop uses native `pop` (O(1) slice) — old evPopStack rebuilt arrays in Kabootar (C2 hot path).

fn makeK8Promise(value) {
    return { "__k8promise": true, "value": value, "then": { "tag": "k8then" } }
}

/// Bindings always go through module `evActiveEnv` — never pass that object as a
/// fn arg (Kabootar CoW writeback of a stale snapshot clobbers live mutations).
fn bindHas(sym) {
    return object_has_own(evActiveEnv, "" + sym)
}

fn bindGet(sym) {
    return evActiveEnv["" + sym]
}

fn bindSet(sym, val) {
    evActiveEnv["" + sym] = val
    return val
}

/// H6a: seed Object/Array/Math/console/document/timers for Kab-only eval path.
fn seedBuiltinEnv() {
    evListenKeys = []
    evListenCbs = []
    evTimerQ = []
    evRafQ = []
    evTimerId = 1
    evMicroQ = []
    evMicroLast = undefined
    bindSet("Promise", { "resolve": { "tag": "k8resolve" } })
    bindSet("Object", {
        "keys": { "tag": "k8host", "name": "objectKeys" },
        "assign": { "tag": "k8host", "name": "objectAssign" },
        "is": { "tag": "k8host", "name": "objectIs" }
    })
    bindSet("Array", {
        "isArray": { "tag": "k8host", "name": "arrayIsArray" }
    })
    bindSet("Math", {
        "floor": { "tag": "k8host", "name": "mathFloor" },
        "ceil": { "tag": "k8host", "name": "mathCeil" },
        "abs": { "tag": "k8host", "name": "mathAbs" },
        "PI": 3.141592653589793,
        "E": 2.718281828459045
    })
    bindSet("console", {
        "log": { "tag": "k8host", "name": "consoleLog" }
    })
    bindSet("Symbol", {
        "tag": "k8host",
        "name": "symbolNew",
        "for": { "tag": "k8host", "name": "symbolFor" }
    })
    bindSet("setTimeout", { "tag": "k8timer", "kind": "timeout" })
    bindSet("setInterval", { "tag": "k8timer", "kind": "interval" })
    bindSet("requestAnimationFrame", { "tag": "k8timer", "kind": "raf" })
    let docBody = hostCall("el", ["body"])
    bindSet("document", {
        "__k8document": true,
        "body": docBody,
        "createElement": { "tag": "k8host", "name": "el" },
        "createTextNode": { "tag": "k8host", "name": "text" }
    })
    // H6a: globalThis mirrors seeded builtins (no circular self-field).
    bindSet("globalThis", {
        "Object": bindGet("Object"),
        "Array": bindGet("Array"),
        "Math": bindGet("Math"),
        "console": bindGet("console"),
        "Symbol": bindGet("Symbol"),
        "Promise": bindGet("Promise"),
        "document": bindGet("document"),
        "setTimeout": bindGet("setTimeout"),
        "setInterval": bindGet("setInterval"),
        "requestAnimationFrame": bindGet("requestAnimationFrame")
    })
}

fn listenKey(nid, typ) {
    // Use type-only key for now: Dom CoW can change id views across calls.
    return "" + typ
}

/// Write updated DOM node back into env (ident or document.body member).
fn writebackDomTarget(target, updated, env) {
    if target.kind == K_IDENT {
        bindSet(target["sym"], updated)
        return null
    }
    if target.kind == K_MEMBER {
        let baseNode = target["object"]
        let field = "" + target["field"]
        if baseNode.kind == K_IDENT {
            let base = bindGet(baseNode["sym"])
            base[field] = updated
            bindSet(baseNode["sym"], base)
        }
    }
    return null
}

fn drainHostTasks() {
    let tq = evTimerQ
    evTimerQ = []
    let ti = 0
    while ti < len(tq) {
        let job = tq[ti]
        let cb = job["cb"]
        if cb != null && cb != undefined {
            evCall(cb, [])
        }
        ti = ti + 1
    }
    let rq = evRafQ
    evRafQ = []
    let ri = 0
    while ri < len(rq) {
        let job = rq[ri]
        let cb = job["cb"]
        if cb != null && cb != undefined {
            evCall(cb, [0])
        }
        ri = ri + 1
    }
}

fn applyAssignOp(op, cur, val) {
    if op == "+=" {
        return cur + val
    }
    if op == "-=" {
        return cur - val
    }
    if op == "*=" {
        return cur * val
    }
    if op == "/=" {
        return cur / val
    }
    return val
}

fn drainMicrotasks() {
    while len(evMicroQ) > 0 {
        let job = evMicroQ[0]
        let rest = []
        let ri = 1
        while ri < len(evMicroQ) {
            rest = push(rest, evMicroQ[ri])
            ri = ri + 1
        }
        evMicroQ = rest
        let cb = job["cb"]
        let val = job["value"]
        let callRet = undefined
        if cb != null && cb != undefined {
            callRet = evCall(cb, [val])
        }
        evMicroLast = callRet
    }
}

fn evExpr(node, env) {
    if node.kind == K_LITERAL {
        if node.lit == LIT_NUMBER {
            return parse_int(node.value)
        }
        return node.value
    }
    if node.kind == K_IDENT {
        let bindSym = node["sym"]
        if !bindHas(bindSym) {
            throw "ReferenceError: " + bindSym
        }
        return bindGet(bindSym)
    }
    if node.kind == K_BINARY {
        evBinOpStack = push(evBinOpStack, node.op)
        evBinRStack = push(evBinRStack, node.right)
        evLhs = evExpr(node.left, env)
        evBxOp = evBinOpStack[len(evBinOpStack) - 1]
        if evBxOp == "&&" {
            if !evLhs {
                evBinOpStack = pop(evBinOpStack)
                evBinRStack = pop(evBinRStack)
                return evLhs
            }
            evRhsVal = evExpr(evBinRStack[len(evBinRStack) - 1], env)
            evBinOpStack = pop(evBinOpStack)
            evBinRStack = pop(evBinRStack)
            return evRhsVal
        }
        if evBxOp == "||" {
            if evLhs {
                evBinOpStack = pop(evBinOpStack)
                evBinRStack = pop(evBinRStack)
                return evLhs
            }
            evRhsVal = evExpr(evBinRStack[len(evBinRStack) - 1], env)
            evBinOpStack = pop(evBinOpStack)
            evBinRStack = pop(evBinRStack)
            return evRhsVal
        }
        if evBxOp == "??" {
            if evLhs != null && evLhs != undefined {
                evBinOpStack = pop(evBinOpStack)
                evBinRStack = pop(evBinRStack)
                return evLhs
            }
            evRhsVal = evExpr(evBinRStack[len(evBinRStack) - 1], env)
            evBinOpStack = pop(evBinOpStack)
            evBinRStack = pop(evBinRStack)
            return evRhsVal
        }
        evBinLStack = push(evBinLStack, evLhs)
        evRhsVal = evExpr(evBinRStack[len(evBinRStack) - 1], env)
        evLhs = evBinLStack[len(evBinLStack) - 1]
        evBxOp = evBinOpStack[len(evBinOpStack) - 1]
        evBinLStack = pop(evBinLStack)
        evBinOpStack = pop(evBinOpStack)
        evBinRStack = pop(evBinRStack)
        if evBxOp == "+" { return evLhs + evRhsVal }
        if evBxOp == "-" { return evLhs - evRhsVal }
        if evBxOp == "*" { return evLhs * evRhsVal }
        if evBxOp == "/" { return evLhs / evRhsVal }
        if evBxOp == "==" { return evLhs == evRhsVal }
        if evBxOp == "===" { return evLhs == evRhsVal }
        if evBxOp == "!=" { return evLhs != evRhsVal }
        if evBxOp == "!==" { return evLhs != evRhsVal }
        if evBxOp == "<" { return evLhs < evRhsVal }
        if evBxOp == ">" { return evLhs > evRhsVal }
        if evBxOp == "<=" { return evLhs <= evRhsVal }
        if evBxOp == ">=" { return evLhs >= evRhsVal }
        throw "Unsupported op " + evBxOp
    }
    if node.kind == K_MEMBER {
        evMemFieldStack = push(evMemFieldStack, "" + node.field)
        evMemObjStack = push(evMemObjStack, node.object)
        let obj = evExpr(evMemObjStack[len(evMemObjStack) - 1], env)
        let memField = evMemFieldStack[len(evMemFieldStack) - 1]
        evMemObjStack = pop(evMemObjStack)
        evMemFieldStack = pop(evMemFieldStack)
        let optional = false
        if object_has_own(node, "optional") {
            optional = node.optional
        }
        if obj == null || obj == undefined {
            if optional {
                return undefined
            }
            throw "TypeError: cannot read property " + memField
        }
        if object_has_own(obj, memField) {
            return obj[memField]
        }
        if object_has_own(obj, "__k8class") {
            let clsMethods = obj["__k8class"]["methods"]
            if object_has_own(clsMethods, memField) {
                return clsMethods[memField]
            }
        }
        // H6a: el.style → style bag for el.style.color = ...
        if memField == "style" {
            if !object_has_own(obj, "__k8document") {
                return { "__k8style": true, "node": obj }
            }
        }
        return undefined
    }
    if node.kind == K_TEMPLATE {
        let out = ""
        let parts = node.parts
        let pi = 0
        while pi < len(parts) {
            let part = parts[pi]
            if part["tag"] == "lit" {
                out = out + part["value"]
            } else {
                out = out + ("" + evExpr(part["expr"], env))
            }
            pi = pi + 1
        }
        return out
    }
    if node.kind == K_INDEX {
        evMemObjStack = push(evMemObjStack, node.object)
        evMemFieldStack = push(evMemFieldStack, node.index)
        let obj = evExpr(evMemObjStack[len(evMemObjStack) - 1], env)
        let idx = evExpr(evMemFieldStack[len(evMemFieldStack) - 1], env)
        evMemObjStack = pop(evMemObjStack)
        evMemFieldStack = pop(evMemFieldStack)
        return obj[idx]
    }
    if node.kind == K_OBJECT {
        let obj = {}
        let fields = node.fields
        let fi = 0
        while fi < len(fields) {
            let field = fields[fi]
            obj["" + field["key"]] = evExpr(field["value"], env)
            fi = fi + 1
        }
        return obj
    }
    if node.kind == K_ARRAY {
        let out = []
        let els = node.elements
        let ai = 0
        while ai < len(els) {
            out = push(out, evExpr(els[ai], env))
            ai = ai + 1
        }
        return out
    }
    if node.kind == K_UNARY {
        let arg = evExpr(node.arg, env)
        if node.op == "!" {
            return !arg
        }
        if node.op == "typeof" {
            return typeof(arg)
        }
        if node.op == "-" {
            return 0 - arg
        }
        if node.op == "+" {
            return arg + 0
        }
        throw "Unsupported unary " + node.op
    }
    if node.kind == K_TERNARY {
        evMemObjStack = push(evMemObjStack, node.thenBranch)
        evMemFieldStack = push(evMemFieldStack, node.elseBranch)
        let ok = evExpr(node.cond, env)
        let thenN = evMemObjStack[len(evMemObjStack) - 1]
        let elseN = evMemFieldStack[len(evMemFieldStack) - 1]
        evMemObjStack = pop(evMemObjStack)
        evMemFieldStack = pop(evMemFieldStack)
        if ok {
            return evExpr(thenN, env)
        }
        return evExpr(elseN, env)
    }
    if node.kind == K_AWAIT {
        let av = evExpr(node.arg, env)
        if av != null && av != undefined && typeof(av) == "object" {
            if object_has_own(av, "__k8promise") {
                if av["__k8promise"] == true {
                    return av["value"]
                }
            }
            if object_has_own(av, "then") {
                let thenFn = av["then"]
                if thenFn != null && thenFn != undefined {
                    let thenTag = thenFn["tag"]
                    if thenTag == "k8fn" || thenTag == "k8resolve" {
                        return evCall(thenFn, [av])
                    }
                }
            }
        }
        return av
    }
    if node.kind == K_NEW {
        let cls = evExpr(node.callee, env)
        if cls == null || cls == undefined || !object_has_own(cls, "__k8class") {
            throw "TypeError: not a constructor"
        }
        let instance = { "__k8class": cls }
        let callArgNodes = node.args
        let fnArgs = []
        evAiStack = push(evAiStack, 0)
        while evAiStack[len(evAiStack) - 1] < len(callArgNodes) {
            evAi = evAiStack[len(evAiStack) - 1]
            fnArgs = push(fnArgs, evExpr(callArgNodes[evAi], env))
            evAi = evAiStack[len(evAiStack) - 1] + 1
            evAiStack = pop(evAiStack)
            evAiStack = push(evAiStack, evAi)
        }
        evAiStack = pop(evAiStack)
        let methods = cls["methods"]
        if object_has_own(methods, "constructor") {
            evThisOut = instance
            let ctorRet = evCallThis(methods["constructor"], fnArgs, instance)
            if ctorRet != null && ctorRet != undefined && typeof(ctorRet) == "object" {
                return ctorRet
            }
            if evThisOut != null && evThisOut != undefined {
                return evThisOut
            }
        }
        return instance
    }
    if node.kind == K_CALL {
        evCallFnStack = push(evCallFnStack, node.callee)
        evCallArgsStack = push(evCallArgsStack, node.args)
        let calleeNode = evCallFnStack[len(evCallFnStack) - 1]
        let callArgNodes = evCallArgsStack[len(evCallArgsStack) - 1]
        evCallFnStack = pop(evCallFnStack)
        evCallArgsStack = pop(evCallArgsStack)
        let thisRecv = null
        let callee = null
        if calleeNode.kind == K_MEMBER {
            thisRecv = evExpr(calleeNode["object"], env)
            let memField = "" + calleeNode["field"]
            if thisRecv == null || thisRecv == undefined {
                throw "TypeError: cannot read property " + memField
            }
            // H6a: DOM methods first (KabootarDom may confuse object_has_own)
            if memField == "appendChild" {
                let child = undefined
                if len(callArgNodes) > 0 {
                    child = evExpr(callArgNodes[0], env)
                }
                if thisRecv != null && object_has_own(thisRecv, "__k8document") {
                    let updatedBody = hostCall("attach", [thisRecv["body"], child, true])
                    thisRecv["body"] = updatedBody
                    writebackDomTarget(calleeNode["object"], thisRecv, env)
                    return child
                }
                let updatedParent = hostCall("attach", [thisRecv, child, true])
                writebackDomTarget(calleeNode["object"], updatedParent, env)
                return child
            }
            if memField == "querySelector" {
                let sel = ""
                if len(callArgNodes) > 0 {
                    sel = "" + evExpr(callArgNodes[0], env)
                }
                let root = thisRecv
                if thisRecv != null && object_has_own(thisRecv, "__k8document") {
                    root = thisRecv["body"]
                }
                return hostCall("docQuery", [root, sel])
            }
            if memField == "getElementById" {
                let idv = ""
                if len(callArgNodes) > 0 {
                    idv = "" + evExpr(callArgNodes[0], env)
                }
                let root = thisRecv
                if thisRecv != null && object_has_own(thisRecv, "__k8document") {
                    root = thisRecv["body"]
                }
                return hostCall("docGetById", [root, idv])
            }
            if memField == "addEventListener" {
                let typ = "" + evExpr(callArgNodes[0], env)
                let cb = evExpr(callArgNodes[1], env)
                let nid = hostCall("id", [thisRecv])
                let key = listenKey(nid, typ)
                evListenKeys = push(evListenKeys, key)
                evListenCbs = push(evListenCbs, cb)
                return undefined
            }
            if memField == "removeEventListener" {
                let typ = "" + evExpr(callArgNodes[0], env)
                let nid = hostCall("id", [thisRecv])
                let key = listenKey(nid, typ)
                let nk = []
                let nc = []
                let ri = 0
                while ri < len(evListenKeys) {
                    if evListenKeys[ri] != key {
                        nk = push(nk, evListenKeys[ri])
                        nc = push(nc, evListenCbs[ri])
                    }
                    ri = ri + 1
                }
                evListenKeys = nk
                evListenCbs = nc
                return undefined
            }
            if memField == "dispatchEvent" {
                let evObj = evExpr(callArgNodes[0], env)
                let typ = "click"
                if evObj != null && evObj != undefined && object_has_own(evObj, "type") {
                    typ = "" + evObj["type"]
                }
                let nid = hostCall("id", [thisRecv])
                let key = listenKey(nid, typ)
                let li = 0
                while li < len(evListenKeys) {
                    if evListenKeys[li] == key {
                        evCall(evListenCbs[li], [evObj])
                    }
                    li = li + 1
                }
                return true
            }
            if memField == "setAttribute" {
                let k = "" + evExpr(callArgNodes[0], env)
                let v = "" + evExpr(callArgNodes[1], env)
                let updated = hostCall("attr", [thisRecv, k, v])
                writebackDomTarget(calleeNode["object"], updated, env)
                return updated
            }
            if object_has_own(thisRecv, memField) {
                callee = thisRecv[memField]
            } else {
                if object_has_own(thisRecv, "__k8class") {
                    let clsMethods = thisRecv["__k8class"]["methods"]
                    if object_has_own(clsMethods, memField) {
                        callee = clsMethods[memField]
                    }
                }
            }
        } else {
            callee = evExpr(calleeNode, env)
        }
        if callee == null || callee == undefined {
            throw "TypeError: not a function"
        }
        let fnTag = callee["tag"]
        if fnTag == "k8host" {
            let hostName = callee["name"]
            let hostArgs = []
            evAiStack = push(evAiStack, 0)
            while evAiStack[len(evAiStack) - 1] < len(callArgNodes) {
                evAi = evAiStack[len(evAiStack) - 1]
                hostArgs = push(hostArgs, evExpr(callArgNodes[evAi], env))
                evAi = evAiStack[len(evAiStack) - 1] + 1
                evAiStack = pop(evAiStack)
                evAiStack = push(evAiStack, evAi)
            }
            evAiStack = pop(evAiStack)
            return hostCall(hostName, hostArgs)
        }
        let fnArgs = []
        evAiStack = push(evAiStack, 0)
        while evAiStack[len(evAiStack) - 1] < len(callArgNodes) {
            evAi = evAiStack[len(evAiStack) - 1]
            fnArgs = push(fnArgs, evExpr(callArgNodes[evAi], env))
            evAi = evAiStack[len(evAiStack) - 1] + 1
            evAiStack = pop(evAiStack)
            evAiStack = push(evAiStack, evAi)
        }
        evAiStack = pop(evAiStack)
        let calleeTag = null
        if callee != null && callee != undefined {
            calleeTag = callee["tag"]
        }
        // H6a: setTimeout / rAF / setInterval
        if calleeTag == "k8timer" {
            let kind = "" + callee["kind"]
            let tid = evTimerId
            evTimerId = evTimerId + 1
            if kind == "raf" {
                evRafQ = push(evRafQ, { "cb": fnArgs[0], "id": tid })
                return tid
            }
            evTimerQ = push(evTimerQ, { "cb": fnArgs[0], "delay": fnArgs[1], "id": tid })
            return tid
        }
        if calleeTag == "k8resolve" {
            return evCall(callee, fnArgs)
        }
        // K1g: promise.then(cb) queues microtask; drain before return so value is set
        // (Kv8 object assign deep-copies — cannot mutate a returned promise later).
        if calleeTag == "k8then" {
            evMicroQ = push(evMicroQ, { "cb": fnArgs[0], "value": thisRecv["value"] })
            drainMicrotasks()
            return makeK8Promise(evMicroLast)
        }
        if thisRecv != null {
            return evCallThis(callee, fnArgs, thisRecv)
        }
        return evCall(callee, fnArgs)
    }
    // H6: arrow => k8fn; closure "shared" uses evActiveEnv (survives deep-copy)
    if node.kind == K_ARROW {
        let bodyNode = node.body
        if bodyNode.kind == K_BLOCK {
            return {
                "tag": "k8fn",
                "params": node.params,
                "body": bodyNode.body,
                "closure": "shared",
                "arrow": false
            }
        }
        return {
            "tag": "k8fn",
            "params": node.params,
            "body": [bodyNode],
            "closure": "shared",
            "arrow": true
        }
    }
    // H6a: ++ / --
    if node.kind == K_UPDATE {
        let arg = node.arg
        if arg.kind != K_IDENT {
            throw "Update target must be ident"
        }
        let bindSym = "" + arg["sym"]
        if !bindHas(bindSym) {
            throw "ReferenceError: " + bindSym
        }
        let cur = bindGet(bindSym)
        let next = cur
        if node.op == "++" {
            next = cur + 1
        } else {
            next = cur - 1
        }
        bindSet(bindSym, next)
        if node.prefix {
            return next
        }
        return cur
    }
    throw "eval expr " + node.kind
}

fn evRunBlock(stmts, env) {
    let last = undefined
    let si = 0
    while si < len(stmts) {
        let st = stmts[si]
        if st.kind == K_WHILE {
            let condNode = st.cond
            let bodyStmts = st.body.body
            while true {
                if !evExpr(condNode, env) {
                    break
                }
                let bi = 0
                while bi < len(bodyStmts) {
                    last = evStmt(bodyStmts[bi], env)
                    if evLoopSig != 0 {
                        break
                    }
                    bi = bi + 1
                }
                if evLoopSig == 1 {
                    evLoopSig = 0
                    break
                }
                if evLoopSig == 2 {
                    evLoopSig = 0
                }
            }
            last = undefined
        } else {
            last = evStmt(st, env)
            if evLoopSig != 0 {
                return last
            }
        }
        si = si + 1
    }
    return last
}

fn evCall(fnVal, args) {
    if fnVal == null || fnVal == undefined {
        throw "TypeError: not a function"
    }
    let fnTag = fnVal["tag"]
    if fnTag == "k8host" {
        let hostName = fnVal["name"]
        return hostCall(hostName, args)
    }
    if fnTag == "k8resolve" {
        return makeK8Promise(args[0])
    }
    if fnTag != "k8fn" {
        throw "TypeError: not a k8 function"
    }
    let fnBody = fnVal["body"]
    let fnParams = fnVal["params"]
    let fnClosure = fnVal["closure"]
    let fnArrow = fnVal["arrow"]
    let saved = null
    let restore = false
    if fnClosure != "shared" {
        saved = evActiveEnv
        evActiveEnv = fnClosure
        restore = true
    }
    let pi = 0
    while pi < len(fnParams) {
        bindSet(fnParams[pi], args[pi])
        pi = pi + 1
    }
    let callRet = undefined
    if fnArrow {
        callRet = evExpr(fnBody[0], null)
    } else {
        callRet = evRunBlock(fnBody, null)
    }
    if restore {
        evActiveEnv = saved
    }
    if object_has_own(fnVal, "async") {
        if fnVal["async"] == true {
            return makeK8Promise(callRet)
        }
    }
    return callRet
}

fn evCallThis(fnVal, args, thisVal) {
    if fnVal == null || fnVal == undefined {
        throw "TypeError: not a function"
    }
    let fnTag = fnVal["tag"]
    if fnTag == "k8resolve" {
        return makeK8Promise(args[0])
    }
    if fnTag != "k8fn" {
        throw "TypeError: not a k8 function"
    }
    let fnBody = fnVal["body"]
    let fnParams = fnVal["params"]
    let fnClosure = fnVal["closure"]
    let fnArrow = fnVal["arrow"]
    let saved = null
    let restore = false
    if fnClosure != "shared" {
        saved = evActiveEnv
        evActiveEnv = fnClosure
        restore = true
    }
    bindSet("this", thisVal)
    let pi = 0
    while pi < len(fnParams) {
        bindSet(fnParams[pi], args[pi])
        pi = pi + 1
    }
    let callRet = undefined
    if fnArrow {
        callRet = evExpr(fnBody[0], null)
    } else {
        callRet = evRunBlock(fnBody, null)
    }
    evThisOut = bindGet("this")
    if restore {
        evActiveEnv = saved
    }
    if object_has_own(fnVal, "async") {
        if fnVal["async"] == true {
            return makeK8Promise(callRet)
        }
    }
    return callRet
}

fn evStmt(stmt, env) {
    let stmtKind = stmt.kind
    if stmtKind == K_CLASS {
        let scope = {}
        let keys = object_keys(evActiveEnv)
        let fi = 0
        while fi < len(keys) {
            scope[keys[fi]] = bindGet(keys[fi])
            fi = fi + 1
        }
        let methods = {}
        // K1e: merge parent class methods when extends is set
        let classExt = stmt["extends"]
        if classExt != null && classExt != undefined {
            let parentName = "" + classExt
            if bindHas(parentName) {
                let parent = bindGet(parentName)
                if parent != null && parent != undefined && object_has_own(parent, "__k8class") {
                    let parentMethods = parent["methods"]
                    let pKeys = object_keys(parentMethods)
                    let pi = 0
                    while pi < len(pKeys) {
                        methods[pKeys[pi]] = parentMethods[pKeys[pi]]
                        pi = pi + 1
                    }
                }
            }
        }
        let methList = stmt["methods"]
        let mi = 0
        while mi < len(methList) {
            let m = methList[mi]
            let mName = "" + m["sym"]
            methods[mName] = { "tag": "k8fn", "params": m.params, "body": m.body.body, "closure": scope, "arrow": false }
            mi = mi + 1
        }
        let classSym = "" + stmt["sym"]
        bindSet(classSym, { "__k8class": true, "name": classSym, "methods": methods, "extends": classExt })
        return undefined
    }
    if stmtKind == K_FN {
        let bindSym = stmt["sym"]
        let isAsync = false
        if object_has_own(stmt, "async") {
            if stmt["async"] == true {
                isAsync = true
            }
        }
        bindSet(bindSym, { "tag": "k8fn", "params": stmt.params, "body": stmt.body.body, "closure": "shared", "arrow": false, "async": isAsync })
        return undefined
    }
    if stmtKind == K_RETURN {
        return evExpr(stmt["rhs"], env)
    }
    if stmtKind == K_IF {
        let condNode = stmt.cond
        if evExpr(condNode, env) {
            return evRunBlock(stmt.then.body, env)
        }
        if stmt.elseBranch != null {
            if len(stmt.elseBranch) > 0 {
                return evRunBlock(stmt.elseBranch, env)
            }
        }
        return undefined
    }
    if stmtKind == K_SWITCH {
        let disc = evExpr(stmt.disc, env)
        let cases = stmt.cases
        let matchAt = -1
        let defaultAt = -1
        let ci = 0
        while ci < len(cases) {
            let c = cases[ci]
            if c.test == null {
                defaultAt = ci
            } else {
                if matchAt < 0 {
                    if evExpr(c.test, env) == disc {
                        matchAt = ci
                    }
                }
            }
            ci = ci + 1
        }
        let start = matchAt
        if start < 0 {
            start = defaultAt
        }
        let last = undefined
        if start >= 0 {
            ci = start
            while ci < len(cases) {
                let bodyStmts = cases[ci].body
                let bi = 0
                while bi < len(bodyStmts) {
                    last = evStmt(bodyStmts[bi], env)
                    if evLoopSig != 0 {
                        break
                    }
                    bi = bi + 1
                }
                if evLoopSig == 1 {
                    evLoopSig = 0
                    break
                }
                if evLoopSig == 2 {
                    evLoopSig = 0
                }
                ci = ci + 1
            }
        }
        return last
    }
    if stmtKind == K_FOR {
        if stmt.init != null {
            evStmt(stmt.init, env)
        }
        let bodyStmts = stmt.body.body
        while true {
            if !evExpr(stmt.cond, env) {
                break
            }
            let bi = 0
            while bi < len(bodyStmts) {
                evStmt(bodyStmts[bi], env)
                if evLoopSig != 0 {
                    break
                }
                bi = bi + 1
            }
            if evLoopSig == 1 {
                evLoopSig = 0
                break
            }
            if evLoopSig == 2 {
                evLoopSig = 0
            }
            if stmt.update != null {
                evStmt(stmt.update, env)
            }
        }
        return undefined
    }
    if stmtKind == K_FOR_IN {
        let iterable = evExpr(stmt.iterable, env)
        let keys = object_keys(iterable)
        let bodyStmts = stmt.body.body
        let bindSym = "" + stmt["sym"]
        let ki = 0
        while ki < len(keys) {
            bindSet(bindSym, keys[ki])
            let bi = 0
            while bi < len(bodyStmts) {
                evStmt(bodyStmts[bi], env)
                if evLoopSig != 0 {
                    break
                }
                bi = bi + 1
            }
            if evLoopSig == 1 {
                evLoopSig = 0
                break
            }
            if evLoopSig == 2 {
                evLoopSig = 0
            }
            ki = ki + 1
        }
        return undefined
    }
    if stmtKind == K_FOR_OF {
        let iterable = evExpr(stmt.iterable, env)
        let bodyStmts = stmt.body.body
        let bindSym = "" + stmt["sym"]
        let n = len(iterable)
        let ki = 0
        while ki < n {
            bindSet(bindSym, iterable[ki])
            let bi = 0
            while bi < len(bodyStmts) {
                evStmt(bodyStmts[bi], env)
                if evLoopSig != 0 {
                    break
                }
                bi = bi + 1
            }
            if evLoopSig == 1 {
                evLoopSig = 0
                break
            }
            if evLoopSig == 2 {
                evLoopSig = 0
            }
            ki = ki + 1
        }
        return undefined
    }
    if stmtKind == K_TRY {
        let result = undefined
        let pending = null
        try {
            result = evRunBlock(stmt.body.body, env)
        } catch (err) {
            pending = err
            if stmt.catchBody != null {
                if stmt.catchParam != null && stmt.catchParam != "" {
                    bindSet(stmt.catchParam, err)
                }
                try {
                    result = evRunBlock(stmt.catchBody.body, env)
                    pending = null
                } catch (err2) {
                    pending = err2
                }
            }
        }
        if stmt.finallyBody != null {
            evRunBlock(stmt.finallyBody.body, env)
        }
        if pending != null {
            throw pending
        }
        return result
    }
    if stmtKind == K_THROW {
        throw evExpr(stmt["rhs"], env)
    }
    if stmtKind == K_BREAK {
        evLoopSig = 1
        return undefined
    }
    if stmtKind == K_CONTINUE {
        evLoopSig = 2
        return undefined
    }
    if stmtKind == K_LET || stmtKind == K_VAR {
        let bindSym = stmt["sym"]
        let initVal = evExpr(stmt.init, env)
        bindSet(bindSym, initVal)
        return undefined
    }
    if stmtKind == K_ASSIGN {
        if object_has_own(stmt, "object") {
            let obj = evExpr(stmt["object"], env)
            let field = "" + stmt["field"]
            let val = evExpr(stmt["rhs"], env)
            if object_has_own(stmt, "op") {
                let cur = undefined
                if object_has_own(obj, field) {
                    cur = obj[field]
                }
                val = applyAssignOp(stmt["op"], cur, val)
            }
            // H6a: style bag → inline style prop (el.style.color = ...)
            if obj != null && object_has_own(obj, "__k8style") {
                let node = obj["node"]
                let prev = hostCall("getAttr", [node, "style"])
                let css = ""
                if prev != null && prev != undefined {
                    css = "" + prev
                    if css != "" {
                        css = css + ";"
                    }
                }
                css = css + field + ":" + val
                hostCall("attr", [node, "style", css])
                return val
            }
            // H6a: DOM textContent / id write
            if field == "textContent" {
                let updated = hostCall("setText", [obj, val])
                writebackDomTarget(stmt["object"], updated, env)
                return val
            }
            if field == "id" {
                let updated = hostCall("attr", [obj, "id", "" + val])
                writebackDomTarget(stmt["object"], updated, env)
                return val
            }
            obj[field] = val
            let target = stmt["object"]
            if target.kind == K_IDENT {
                bindSet(target["sym"], obj)
            }
            return val
        }
        let bindSym = stmt["sym"]
        let val = evExpr(stmt["rhs"], env)
        if object_has_own(stmt, "op") {
            let cur = undefined
            if bindHas(bindSym) {
                cur = bindGet(bindSym)
            }
            val = applyAssignOp(stmt["op"], cur, val)
        }
        bindSet(bindSym, val)
        return val
    }
    if stmtKind == K_EXPR {
        return evExpr(stmt.expr, env)
    }
    if stmtKind == K_BLOCK {
        return evRunBlock(stmt.body, env)
    }
    throw "eval stmt " + stmtKind
}

pub fn evalProgram(ast, extraEnv) {
    evActiveEnv = {}
    seedBuiltinEnv()
    if extraEnv != null {
        let keys = object_keys(extraEnv)
        let ei = 0
        while ei < len(keys) {
            bindSet(keys[ei], extraEnv[keys[ei]])
            ei = ei + 1
        }
    }
    let stmts = ast.body
    let last = undefined
    let si = 0
    while si < len(stmts) {
        let st = stmts[si]
        if st.kind == K_WHILE {
            let condNode = st.cond
            let bodyStmts = st.body.body
            while true {
                if !evExpr(condNode, null) {
                    break
                }
                let bi = 0
                while bi < len(bodyStmts) {
                    last = evStmt(bodyStmts[bi], null)
                    if evLoopSig != 0 {
                        break
                    }
                    bi = bi + 1
                }
                if evLoopSig == 1 {
                    evLoopSig = 0
                    break
                }
                if evLoopSig == 2 {
                    evLoopSig = 0
                }
            }
            last = undefined
        } else {
            last = evStmt(st, null)
            if evLoopSig != 0 {
                return last
            }
        }
        si = si + 1
    }
    return last
}

pub fn evalSourceWith(source, extraEnv) {
    let ast = parseSource(source)
    evActiveEnv = {}
    seedBuiltinEnv()
    if extraEnv != null {
        let keys = object_keys(extraEnv)
        let ei = 0
        while ei < len(keys) {
            bindSet(keys[ei], extraEnv[keys[ei]])
            ei = ei + 1
        }
    }
    let stmts = ast.body
    let last = undefined
    let si = 0
    while si < len(stmts) {
        let st = stmts[si]
        if st.kind == K_WHILE {
            let condNode = st.cond
            let bodyStmts = st.body.body
            while true {
                if !evExpr(condNode, null) {
                    break
                }
                let bi = 0
                while bi < len(bodyStmts) {
                    last = evStmt(bodyStmts[bi], null)
                    if evLoopSig != 0 {
                        break
                    }
                    bi = bi + 1
                }
                if evLoopSig == 1 {
                    evLoopSig = 0
                    break
                }
                if evLoopSig == 2 {
                    evLoopSig = 0
                }
            }
            last = undefined
        } else {
            last = evStmt(st, null)
            if evLoopSig != 0 {
                drainMicrotasks()
                drainHostTasks()
                return last
            }
        }
        // Drain after each top-level stmt so then-cbs / timers run before later checks
        drainMicrotasks()
        drainHostTasks()
        si = si + 1
    }
    drainMicrotasks()
    drainHostTasks()
    return last
}

/// H6a: Kab path is the only evalSource implementation.
pub fn preferKabEval() {
    useKabEval = true
    return true
}

pub fn evalSource(source) {
    return evalSourceWith(source, null)
}

/// K1c/K1e: pure Kabootar eval path via evalSourceWith.
pub fn evalSourceKab(source) {
    return evalSourceWith(source, null)
}
