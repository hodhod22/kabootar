@version "1.0.0"

// Minimal Kv8 React-like fiber. import "kv8/react"
// Same-type mark (rxPatched) when host tag unchanged; useEffect deps on deps[0].
// Note: live Dom reuse via setText needs a node registry (Dom values must not sit in .kab lets).

import "kv8/host"
import "kdom/events"

let rxW = 240
let rxH = 120
let rxHasClick = false
let rxLastType = null

fn mountChildren(parent, children) {
    if children == null || children == undefined {
        return parent
    }
    let t = typeof(children)
    if t == "string" || t == "number" {
        let tnode = hostCall("text", ["" + children])
        return hostCall("attach", [parent, tnode, true])
    }
    if object_has_own(children, "tag") && children["tag"] == "fiber" {
        return hostCall("attach", [parent, mount(children), true])
    }
    try {
        let n = len(children)
        let i = 0
        while i < n {
            let child = children[i]
            let ct = typeof(child)
            if ct == "string" || ct == "number" {
                parent = hostCall("attach", [parent, hostCall("text", ["" + child]), true])
            } else {
                parent = hostCall("attach", [parent, mount(child), true])
            }
            i = i + 1
        }
        return parent
    } catch (e) {
        return hostCall("attach", [parent, mount(children), true])
    }
}

fn mount(element) {
    if element == null || element == undefined {
        return hostCall("text", [""])
    }
    if typeof(element) == "string" || typeof(element) == "number" {
        return hostCall("text", ["" + element])
    }
    let typ = element["type"]
    let props = element["props"]
    if typeof(typ) != "string" && typeof(typ) != "number" {
        if props == null || props == undefined {
            props = {}
            element["props"] = props
        }
        if object_has_own(element, "$hooks") {
            props["$hooks"] = element["$hooks"]
        }
        let out = typ(props)
        if object_has_own(props, "$hooks") {
            element["$hooks"] = props["$hooks"]
        }
        return mount(out)
    }
    let node = hostCall("el", ["" + typ])
    if props != null && props != undefined {
        let keys = object_keys(props)
        let i = 0
        while i < len(keys) {
            let k = keys[i]
            if k == "children" || k == "$hooks" {
                i = i + 1
                continue
            }
            let v = props[k]
            if char_at(k, 0) == "o" && char_at(k, 1) == "n" && len(k) > 2 {
                let ev = ""
                let ci = 2
                while ci < len(k) {
                    ev = ev + char_at(k, ci)
                    ci = ci + 1
                }
                if typeof(v) != "string" && typeof(v) != "number" && v != null {
                    rxHasClick = true
                    on(node, ev, "rxClick")
                } else {
                    on(node, ev, "" + v)
                }
            } else {
                hostCall("attr", [node, k, v])
            }
            i = i + 1
        }
        if object_has_own(props, "children") {
            node = mountChildren(node, props["children"])
        }
    }
    rxLastType = "" + typ
    return node
}

pub fn createElement(typ, props) {
    if props == null || props == undefined {
        props = {}
    }
    return { "tag": "fiber", "type": typ, "props": props }
}

pub fn useState(hooks, initial) {
    if !object_has_own(hooks, "i") {
        hooks["i"] = 0
    }
    let idx = hooks["i"]
    hooks["i"] = idx + 1
    let key = "h" + idx
    if !object_has_own(hooks, key) {
        hooks[key] = initial
    }
    return [hooks[key], idx]
}

// useEffect(hooks, setup, deps?): skip when deps[0] unchanged; re-run setup (cleanup return ignored — Dom/fn slots unsafe in .kab).
pub fn useEffect(hooks, setup, deps) {
    if !object_has_own(hooks, "ei") {
        hooks["ei"] = 0
    }
    let idx = hooks["ei"]
    hooks["ei"] = idx + 1
    let depKey = "d" + idx
    if deps != null && deps != undefined {
        let depStr = "" + deps[0]
        if object_has_own(hooks, depKey) && hooks[depKey] == depStr {
            return idx + 1
        }
        hooks[depKey] = depStr
    }
    if setup != null && typeof(setup) != "string" && typeof(setup) != "number" {
        setup()
    }
    return idx + 1
}

pub fn setState(fiber, hookIndex, next) {
    let hooks = fiber["$hooks"]
    hooks["h" + hookIndex] = next
    hooks["i"] = 0
    hooks["ei"] = 0
    fiber["$hooks"] = hooks
    rxHasClick = false
    let prevType = rxLastType
    let node = mount(fiber)
    let patched = false
    if prevType != null && ("" + prevType) == ("" + rxLastType) {
        patched = true
    }
    return {
        "frame": hostCall("paint", [node, rxW, rxH, ""]),
        "hasClick": rxHasClick,
        "patched": patched
    }
}

pub fn render(element, width, height) {
    rxW = 240
    rxH = 120
    if width != null && width != undefined {
        rxW = width
    }
    if height != null && height != undefined {
        rxH = height
    }
    if !object_has_own(element, "$hooks") {
        element["$hooks"] = { "i": 0, "ei": 0 }
    }
    let hooks = element["$hooks"]
    hooks["i"] = 0
    hooks["ei"] = 0
    element["$hooks"] = hooks
    rxHasClick = false
    rxLastType = null
    let node = mount(element)
    return {
        "frame": hostCall("paint", [node, rxW, rxH, ""]),
        "hasClick": rxHasClick,
        "patched": false
    }
}
