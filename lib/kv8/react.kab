@version "1.0.0"

// Minimal Kv8 React-like fiber. import "kv8/react"
// Live Dom patch in setState via hooks["nid"] + setTextById (ids only, no Dom in lets).

import "kv8/host"
import "kdom/events"

let rxW = 240
let rxH = 120
let rxHasClick = false

fn mountChildren(parent, children) {
    if children == null || children == undefined {
        return parent
    }
    let t = typeof(children)
    if t == "string" || t == "number" {
        return hostCall("attach", [parent, hostCall("text", ["" + children]), true])
    }
    if object_has_own(children, "tag") && children["tag"] == "fiber" {
        return hostCall("attach", [parent, mount(children), true])
    }
    try {
        let n = len(children)
        let i = 0
        while i < n {
            let child = children[i]
            let ct = typeof(child)
            if ct == "string" || ct == "number" {
                parent = hostCall("attach", [parent, hostCall("text", ["" + child]), true])
            } else {
                parent = hostCall("attach", [parent, mount(child), true])
            }
            i = i + 1
        }
        return parent
    } catch (e) {
        return hostCall("attach", [parent, mount(children), true])
    }
}

fn mount(element) {
    if element == null || element == undefined {
        return hostCall("text", [""])
    }
    if typeof(element) == "string" || typeof(element) == "number" {
        return hostCall("text", ["" + element])
    }
    let typ = element["type"]
    let props = element["props"]
    if typeof(typ) != "string" && typeof(typ) != "number" {
        if props == null || props == undefined {
            props = {}
            element["props"] = props
        }
        if object_has_own(element, "$hooks") {
            props["$hooks"] = element["$hooks"]
        }
        let out = typ(props)
        if object_has_own(props, "$hooks") {
            element["$hooks"] = props["$hooks"]
        }
        return mount(out)
    }
    let node = hostCall("el", ["" + typ])
    if props != null && props != undefined {
        let keys = object_keys(props)
        let i = 0
        while i < len(keys) {
            let k = keys[i]
            if k == "children" || k == "$hooks" {
                i = i + 1
                continue
            }
            let v = props[k]
            if char_at(k, 0) == "o" && char_at(k, 1) == "n" && len(k) > 2 {
                let ev = ""
                let ci = 2
                while ci < len(k) {
                    let ch = char_at(k, ci)
                    if ci == 2 {
                        ev = ev + to_lower(ch)
                    } else {
                        ev = ev + ch
                    }
                    ci = ci + 1
                }
                if typeof(v) != "string" && typeof(v) != "number" && v != null {
                    rxHasClick = true
                    node = on(node, ev, "rxClick")
                } else {
                    node = on(node, ev, "" + v)
                }
            } else {
                node = hostCall("attr", [node, k, v])
            }
            i = i + 1
        }
        if object_has_own(props, "children") {
            node = mountChildren(node, props["children"])
        }
    }
    return node
}

pub fn createElement(typ, props) {
    if props == null || props == undefined {
        props = {}
    }
    return { "tag": "fiber", "type": typ, "props": props }
}

pub fn useState(hooks, initial) {
    if !object_has_own(hooks, "i") {
        hooks["i"] = 0
    }
    let idx = hooks["i"]
    hooks["i"] = idx + 1
    let key = "h" + idx
    if !object_has_own(hooks, key) {
        hooks[key] = initial
    }
    return [hooks[key], idx]
}

pub fn useEffect(hooks, setup, deps, cleanup) {
    if !object_has_own(hooks, "ei") {
        hooks["ei"] = 0
    }
    let idx = hooks["ei"]
    hooks["ei"] = idx + 1
    let depKey = "d" + idx
    let cleanKey = "c" + idx
    let xKey = "x" + idx
    if deps != null && deps != undefined {
        let depStr = "" + deps[0]
        if object_has_own(hooks, depKey) && hooks[depKey] == depStr {
            return idx + 1
        }
        hooks[depKey] = depStr
    }
    if object_has_own(hooks, cleanKey) {
        if cleanup != null && cleanup != undefined && typeof(cleanup) != "string" && typeof(cleanup) != "number" {
            cleanup()
        }
        if object_has_own(hooks, xKey) {
            hooks[xKey] = hooks[xKey] + 1
        } else {
            hooks[xKey] = 1
        }
        hooks[cleanKey] = hooks[cleanKey] + 1
    } else {
        hooks[cleanKey] = 1
        hooks[xKey] = 0
    }
    if setup != null && typeof(setup) != "string" && typeof(setup) != "number" {
        setup()
    }
    return idx + 1
}

pub fn setState(fiber, hookIndex, next) {
    let hooks = fiber["$hooks"]
    hooks["h" + hookIndex] = next
    hooks["i"] = 0
    hooks["ei"] = 0
    fiber["$hooks"] = hooks
    rxHasClick = false
    let prevId = 0
    if object_has_own(hooks, "nid") {
        prevId = hooks["nid"]
    }
    let props = fiber["props"]
    if props == null || props == undefined {
        props = {}
        fiber["props"] = props
    }
    props["$hooks"] = hooks
    let typ = fiber["type"]
    let out = typ(props)
    if object_has_own(props, "$hooks") {
        fiber["$hooks"] = props["$hooks"]
        hooks = fiber["$hooks"]
    }
    let liveHit = false
    if prevId != null && prevId != 0 {
        liveHit = hostCall("getById", [prevId]) != null
    }
    if liveHit && out != null && object_has_own(out, "props") {
        let outType = "" + out["type"]
        if object_has_own(hooks, "ntag") && hooks["ntag"] != outType {
            liveHit = false
        } else {
            hooks["ntag"] = outType
        }
    }
    if liveHit && out != null && object_has_own(out, "props") {
        let op = out["props"]
        let ch = null
        if op != null && object_has_own(op, "children") {
            ch = op["children"]
        }
        if typeof(ch) == "string" || typeof(ch) == "number" {
            if op != null && object_has_own(op, "data-n") {
                hostCall("setAttrById", [prevId, "data-n", "" + op["data-n"]])
            }
            let node = hostCall("setTextById", [prevId, "" + ch])
            if op != null && object_has_own(op, "onClick") {
                rxHasClick = true
                hostCall("onById", [prevId, "click", "rxClick"])
            }
            hooks["nid"] = prevId
            fiber["$hooks"] = hooks
            return {
                "frame": hostCall("paint", [node, rxW, rxH, ""]),
                "hasClick": rxHasClick,
                "patched": true,
                "nodeId": prevId,
                "liveHit": true,
                "prevId": prevId
            }
        }
        if ch != null && ch != undefined && object_has_own(ch, "0") {
            if op != null && object_has_own(op, "data-n") {
                hostCall("setAttrById", [prevId, "data-n", "" + op["data-n"]])
            }
            if op != null && object_has_own(op, "onClick") {
                rxHasClick = true
                hostCall("onById", [prevId, "click", "rxClick"])
            }
            let nch = len(ch)
            let onlyText = true
            let hasFiber = false
            let si = 0
            while si < nch {
                let piece = ch[si]
                let pt = typeof(piece)
                if pt == "string" || pt == "number" {
                    si = si + 1
                    continue
                }
                onlyText = false
                if object_has_own(piece, "tag") && piece["tag"] == "fiber" {
                    hasFiber = true
                }
                si = si + 1
            }
            if onlyText {
                let node = hostCall("clearChildrenById", [prevId])
                let ci = 0
                while ci < nch {
                    let piece = ch[ci]
                    let pt = typeof(piece)
                    if pt == "string" || pt == "number" {
                        node = hostCall("appendTextById", [prevId, "" + piece])
                    }
                    ci = ci + 1
                }
                hooks["nid"] = prevId
                fiber["$hooks"] = hooks
                return {
                    "frame": hostCall("paint", [node, rxW, rxH, ""]),
                    "hasClick": rxHasClick,
                    "patched": true,
                    "nodeId": prevId,
                    "liveHit": true,
                    "prevId": prevId
                }
            }
            if hasFiber && nch == 1 {
                let piece = ch[0]
                let cprops = piece["props"]
                let ctext = null
                if cprops != null && object_has_own(cprops, "children") {
                    ctext = cprops["children"]
                }
                let cnid = 0
                if object_has_own(hooks, "cnid0") {
                    cnid = hooks["cnid0"]
                }
                let childLive = false
                if cnid != null && cnid != 0 {
                    childLive = hostCall("getById", [cnid]) != null
                }
                if childLive && (typeof(ctext) == "string" || typeof(ctext) == "number") {
                    let node = hostCall("setTextById", [cnid, "" + ctext])
                    if cprops != null && object_has_own(cprops, "onClick") {
                        rxHasClick = true
                        node = hostCall("onById", [cnid, "click", "rxClick"])
                    }
                    hooks["nid"] = prevId
                    hooks["cnid0"] = cnid
                    fiber["$hooks"] = hooks
                    return {
                        "frame": hostCall("paint", [node, rxW, rxH, ""]),
                        "hasClick": rxHasClick,
                        "patched": true,
                        "nodeId": prevId,
                        "childId": cnid,
                        "liveHit": true,
                        "prevId": prevId
                    }
                }
                hostCall("clearChildrenById", [prevId])
                let childNode = mount(piece)
                let node = hostCall("appendById", [prevId, childNode])
                cnid = hostCall("id", [childNode])
                hooks["nid"] = prevId
                hooks["cnid0"] = cnid
                fiber["$hooks"] = hooks
                if cprops != null && object_has_own(cprops, "onClick") {
                    rxHasClick = true
                }
                return {
                    "frame": hostCall("paint", [node, rxW, rxH, ""]),
                    "hasClick": rxHasClick,
                    "patched": true,
                    "nodeId": prevId,
                    "childId": cnid,
                    "liveHit": true,
                    "prevId": prevId
                }
            }
        }
    }
    let node = mount(fiber)
    let nid = hostCall("id", [node])
    hooks = fiber["$hooks"]
    hooks["nid"] = nid
    fiber["$hooks"] = hooks
    return {
        "frame": hostCall("paint", [node, rxW, rxH, ""]),
        "hasClick": rxHasClick,
        "patched": false,
        "nodeId": nid,
        "liveHit": liveHit,
        "prevId": prevId
    }
}

pub fn render(element, width, height) {
    rxW = 240
    rxH = 120
    if width != null && width != undefined {
        rxW = width
    }
    if height != null && height != undefined {
        rxH = height
    }
    if !object_has_own(element, "$hooks") {
        element["$hooks"] = { "i": 0, "ei": 0 }
    }
    let hooks = element["$hooks"]
    hooks["i"] = 0
    hooks["ei"] = 0
    element["$hooks"] = hooks
    rxHasClick = false
    let node = mount(element)
    let nid = hostCall("id", [node])
    hooks = element["$hooks"]
    hooks["nid"] = nid
    let cid = hostCall("childId", [nid, 0])
    if cid != null && cid != 0 {
        hooks["cnid0"] = cid
    }
    element["$hooks"] = hooks
    return {
        "frame": hostCall("paint", [node, rxW, rxH, ""]),
        "hasClick": rxHasClick,
        "patched": false,
        "nodeId": nid,
        "childId": cid
    }
}
