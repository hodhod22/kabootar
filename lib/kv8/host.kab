@version "1.0.0"

// Host bridge: Kv8 eval k8host calls -> lib/kdom + lib/kstyle. import "kv8/host"

import "kdom/document"
import "kdom/events"
import "kstyle/parse"

let hostSymFor = {}
let hostSymId = 1

fn objectAssign(args) {
    let target = args[0]
    let ai = 1
    while ai < len(args) {
        let src = args[ai]
        if src != null && src != undefined {
            let keys = object_keys(src)
            let ki = 0
            while ki < len(keys) {
                target[keys[ki]] = src[keys[ki]]
                ki = ki + 1
            }
        }
        ai = ai + 1
    }
    return target
}

fn objectIs(a, b) {
    if a != null && b != null && typeof(a) == "object" && typeof(b) == "object" {
        if object_has_own(a, "__k8symbol") && object_has_own(b, "__k8symbol") {
            return a["id"] == b["id"]
        }
    }
    if a == b {
        return true
    }
    return false
}

fn symbolNew(args) {
    let desc = ""
    if len(args) > 0 {
        if args[0] != null && args[0] != undefined {
            desc = "" + args[0]
        }
    }
    let id = hostSymId
    hostSymId = hostSymId + 1
    return { "__k8symbol": true, "id": id, "desc": desc }
}

fn symbolFor(args) {
    let key = "" + args[0]
    if object_has_own(hostSymFor, key) {
        return hostSymFor[key]
    }
    let sym = symbolNew([key])
    hostSymFor[key] = sym
    return sym
}

pub fn hostCall(hostName, hostArgs) {
    if hostName == "el" {
        return el(hostArgs[0])
    }
    if hostName == "text" {
        return text(hostArgs[0])
    }
    if hostName == "id" {
        return kdom_id(hostArgs[0])
    }
    if hostName == "setText" {
        return kdom_set_text(hostArgs[0], hostArgs[1])
    }
    if hostName == "setTextById" {
        return kdom_set_text_by_id(hostArgs[0], hostArgs[1])
    }
    if hostName == "setAttrById" {
        return kdom_set_attr_by_id(hostArgs[0], hostArgs[1], hostArgs[2])
    }
    if hostName == "clearChildrenById" {
        return kdom_clear_children_by_id(hostArgs[0])
    }
    if hostName == "appendTextById" {
        return kdom_append_text_by_id(hostArgs[0], hostArgs[1])
    }
    if hostName == "appendById" {
        return kdom_append_by_id(hostArgs[0], hostArgs[1])
    }
    if hostName == "getById" {
        return kdom_get_by_id(hostArgs[0])
    }
    if hostName == "onById" {
        return kdom_on_by_id(hostArgs[0], hostArgs[1], hostArgs[2])
    }
    if hostName == "dispatchById" {
        return kdom_dispatch_by_id(hostArgs[0], hostArgs[1])
    }
    if hostName == "childId" {
        return kdom_child_id(hostArgs[0], hostArgs[1])
    }
    if hostName == "getAttr" {
        return kdom_get_attr(hostArgs[0], hostArgs[1])
    }
    if hostName == "clearChildren" {
        return kdom_clear_children(hostArgs[0])
    }
    if hostName == "attach" {
        return attach(hostArgs[0], hostArgs[1], hostArgs[2])
    }
    if hostName == "attr" {
        return attr(hostArgs[0], hostArgs[1], hostArgs[2])
    }
    if hostName == "paint" {
        let css = ""
        if len(hostArgs) > 3 {
            css = hostArgs[3]
        }
        return paint(hostArgs[0], hostArgs[1], hostArgs[2], css)
    }
    if hostName == "applyCss" {
        parseAndApply(hostArgs[0])
        return null
    }
    if hostName == "on" {
        return on(hostArgs[0], hostArgs[1], hostArgs[2])
    }
    if hostName == "dispatch" {
        return dispatch(hostArgs[0], hostArgs[1])
    }
    if hostName == "objectKeys" {
        return object_keys(hostArgs[0])
    }
    if hostName == "objectAssign" {
        return objectAssign(hostArgs)
    }
    if hostName == "objectIs" {
        return objectIs(hostArgs[0], hostArgs[1])
    }
    if hostName == "symbolNew" {
        return symbolNew(hostArgs)
    }
    if hostName == "symbolFor" {
        return symbolFor(hostArgs)
    }
    if hostName == "arrayIsArray" {
        return is_array(hostArgs[0])
    }
    if hostName == "mathFloor" {
        return floor(hostArgs[0])
    }
    if hostName == "mathCeil" {
        return ceil(hostArgs[0])
    }
    if hostName == "mathAbs" {
        return abs(hostArgs[0])
    }
    if hostName == "consoleLog" {
        println("" + hostArgs[0])
        return null
    }
    // H6b: prefer Kab query policy (queryKab → native fallback)
    if hostName == "docQuery" {
        return query(hostArgs[0], hostArgs[1])
    }
    if hostName == "docGetById" {
        let root = hostArgs[0]
        let id = "" + hostArgs[1]
        return query(root, "#" + id)
    }
    throw "hostCall: unknown " + hostName
}
