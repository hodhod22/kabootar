@version "1.0.0"

// Host bridge: Kv8 eval k8host calls -> lib/kdom + lib/kstyle. import "kv8/host"

import "kdom/document"
import "kdom/events"
import "kstyle/parse"

pub fn hostCall(hostName, hostArgs) {
    if hostName == "el" {
        return el(hostArgs[0])
    }
    if hostName == "text" {
        return text(hostArgs[0])
    }
    if hostName == "setText" {
        return kdom_set_text(hostArgs[0], hostArgs[1])
    }
    if hostName == "clearChildren" {
        return kdom_clear_children(hostArgs[0])
    }
    if hostName == "attach" {
        return attach(hostArgs[0], hostArgs[1], hostArgs[2])
    }
    if hostName == "attr" {
        return attr(hostArgs[0], hostArgs[1], hostArgs[2])
    }
    if hostName == "paint" {
        let css = ""
        if len(hostArgs) > 3 {
            css = hostArgs[3]
        }
        return paint(hostArgs[0], hostArgs[1], hostArgs[2], css)
    }
    if hostName == "applyCss" {
        parseAndApply(hostArgs[0])
        return null
    }
    if hostName == "on" {
        return on(hostArgs[0], hostArgs[1], hostArgs[2])
    }
    if hostName == "dispatch" {
        return dispatch(hostArgs[0], hostArgs[1])
    }
    throw "hostCall: unknown " + hostName
}
