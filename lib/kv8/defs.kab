@version "1.0.0"

// Kv8 JS-subset token constants (mirrors src/runtime/kv8/lexer.rs).
// import "kv8/defs"

pub let TOKEN_EOF = "EOF"
pub let TOKEN_IDENT = "Ident"
pub let TOKEN_NUMBER = "Number"
pub let TOKEN_STRING = "String"
pub let TOKEN_TEMPLATE = "Template"

pub let QUOTE = "\""
pub let SQUOTE = "'"
pub let BACKTICK = "`"

// JS keywords -> token type (keyword name as type, value null)
pub let KEYWORDS = {
    "let": "let",
    "var": "var",
    "const": "const",
    "return": "return",
    "if": "if",
    "else": "else",
    "for": "for",
    "while": "while",
    "do": "do",
    "break": "break",
    "continue": "continue",
    "switch": "switch",
    "case": "case",
    "default": "default",
    "try": "try",
    "catch": "catch",
    "finally": "finally",
    "in": "in",
    "of": "of",
    "import": "import",
    "export": "export",
    "from": "from",
    "instanceof": "instanceof",
    "function": "function",
    "class": "class",
    "extends": "extends",
    "static": "static",
    "super": "super",
    "new": "new",
    "async": "async",
    "await": "await",
    "typeof": "typeof",
    "void": "void",
    "throw": "throw",
    "delete": "delete",
    "this": "this",
    "true": "true",
    "false": "false",
    "null": "null",
    "undefined": "undefined"
}

