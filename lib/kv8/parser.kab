@version "1.0.0"

// Kv8 JS-subset parser in Kabootar (token[] -> AST). import "kv8/parser"
// KEEP <=~7 top-level fn.

import "kv8/defs"
import "kv8/lexer"

let k8pToks = []
let k8pPos = 0
let k8pLeft = null
let k8pRight = null
let k8pNode = null
let k8pSave = null
let k8pAndLeft = null
let k8pLogLeft = null
let k8pAddLeft = null
let k8pCmpLeft = null
let k8pCmpOp = ""
let k8pOp = ""
let k8pAddOp = ""
let k8pBody = []
let k8pBlockBody = []
let k8pBodyStack = []
let k8pCondStack = []
let k8pPopTmp = []
let k8pPopI = 0
let k8pArrowBody = null
let k8pParams = []
let k8pName = ""
let k8pTok = null
let k8pElse = null
let k8pCond = null
let k8pForInit = null
let k8pForCond = null
let k8pForUpdate = null
let k8pCatchParam = ""
let k8pCatchBody = null
let k8pFinallyBody = null
let k8pTryBody = null
let k8pForInSym = ""
let k8pObjFields = []
let k8pObjStack = []
let k8pArrElems = []
let k8pArrStack = []
let k8pSnapI = 0
let k8pAsName = ""
let k8pForKind = ""
fn k8pSnapList(items) {
    let out = []
    k8pSnapI = 0
    while k8pSnapI < len(items) {
        out = push(out, items[k8pSnapI])
        k8pSnapI = k8pSnapI + 1
    }
    return out
}

fn k8pPopStack(stack) {
    k8pPopTmp = []
    k8pPopI = 0
    while k8pPopI < len(stack) - 1 {
        k8pPopTmp = push(k8pPopTmp, stack[k8pPopI])
        k8pPopI = k8pPopI + 1
    }
    return k8pPopTmp
}

fn k8pTokAt(mode) {
    if k8pPos >= len(k8pToks) {
        return { "type": TOKEN_EOF, "value": null, "line": 1, "column": 1 }
    }
    if mode == "peek" {
        return k8pToks[k8pPos]
    }
    k8pTok = k8pToks[k8pPos]
    if k8pTok.type != TOKEN_EOF {
        k8pPos = k8pPos + 1
    }
    return k8pTok
}

fn parsePostfix() {
    k8pNode = null
    k8pTok = k8pTokAt("peek")
    if k8pTok.type == TOKEN_EOF {
        throw "parsePostfix EOF"
    }
    if k8pTok.type == "!" || k8pTok.type == "typeof" {
        k8pOp = k8pTokAt("bump").type
        k8pSave = parsePostfix()
        return { "kind": K_UNARY, "op": k8pOp, "arg": k8pSave }
    }
    if k8pTok.type == "await" {
        k8pTokAt("bump")
        k8pSave = parsePostfix()
        return { "kind": K_AWAIT, "arg": k8pSave }
    }
    if k8pTok.type == "new" {
        k8pTokAt("bump")
        k8pSave = parsePostfix()
        if k8pSave.kind == K_MEMBER {
            let memObj = k8pSave["object"]
            if memObj.kind == K_CALL {
                return { "kind": K_MEMBER, "object": { "kind": K_NEW, "callee": memObj["callee"], "args": memObj["args"] }, "field": k8pSave["field"], "optional": k8pSave["optional"] }
            }
            return { "kind": K_MEMBER, "object": { "kind": K_NEW, "callee": memObj, "args": [] }, "field": k8pSave["field"], "optional": k8pSave["optional"] }
        }
        if k8pSave.kind == K_CALL {
            return { "kind": K_NEW, "callee": k8pSave["callee"], "args": k8pSave["args"] }
        }
        return { "kind": K_NEW, "callee": k8pSave, "args": [] }
    }

    if k8pTok.type == TOKEN_NUMBER {
        k8pTok = k8pTokAt("bump")
        k8pNode = { "kind": K_LITERAL, "lit": LIT_NUMBER, "value": k8pTok.value }
    }
    if k8pNode == null {
        k8pTok = k8pTokAt("peek")
        if k8pTok.type == TOKEN_STRING {
            k8pTok = k8pTokAt("bump")
            k8pNode = { "kind": K_LITERAL, "lit": LIT_STRING, "value": k8pTok.value }
        }
    }
    if k8pNode == null {
        k8pTok = k8pTokAt("peek")
        if k8pTok.type == TOKEN_TEMPLATE {
            k8pTok = k8pTokAt("bump")
            let raw = "" + k8pTok.value
            if !str_includes(raw, "${") {
                k8pNode = { "kind": K_LITERAL, "lit": LIT_STRING, "value": raw }
            } else {
                let parts = []
                let lit = ""
                let ti = 0
                while ti < len(raw) {
                    if char_at(raw, ti) == "$" && ti + 1 < len(raw) && char_at(raw, ti + 1) == "{" {
                        parts = push(parts, { "tag": "lit", "value": lit })
                        lit = ""
                        ti = ti + 2
                        let depth = 1
                        let exprSrc = ""
                        while ti < len(raw) && depth > 0 {
                            let ch = char_at(raw, ti)
                            if ch == "{" {
                                depth = depth + 1
                                exprSrc = exprSrc + ch
                            } else {
                                if ch == "}" {
                                    depth = depth - 1
                                    if depth > 0 {
                                        exprSrc = exprSrc + ch
                                    }
                                } else {
                                    exprSrc = exprSrc + ch
                                }
                            }
                            ti = ti + 1
                        }
                        // Parse ${expr} via nested tokenize (no backticks inside → no re-entry).
                        let savedToks = k8pToks
                        let savedPos = k8pPos
                        k8pToks = tokenize(exprSrc)
                        k8pPos = 0
                        let exprNode = parseCompare()
                        k8pToks = savedToks
                        k8pPos = savedPos
                        parts = push(parts, { "tag": "expr", "expr": exprNode })
                    } else {
                        lit = lit + char_at(raw, ti)
                        ti = ti + 1
                    }
                }
                parts = push(parts, { "tag": "lit", "value": lit })
                k8pNode = { "kind": K_TEMPLATE, "parts": parts }
            }
        }
    }
    if k8pNode == null {
        k8pTok = k8pTokAt("peek")
        if k8pTok.type == "true" || k8pTok.type == "false" {
            k8pTok = k8pTokAt("bump")
            k8pNode = { "kind": K_LITERAL, "lit": LIT_BOOL, "value": k8pTok.type == "true" }
        }
    }
    if k8pNode == null {
        k8pTok = k8pTokAt("peek")
        if k8pTok.type == "null" {
            k8pTok = k8pTokAt("bump")
            k8pNode = { "kind": K_LITERAL, "lit": LIT_NULL, "value": null }
        }
    }
    if k8pNode == null {
        k8pTok = k8pTokAt("peek")
        if k8pTok.type == "undefined" {
            k8pTok = k8pTokAt("bump")
            k8pNode = { "kind": K_LITERAL, "lit": LIT_UNDEF, "value": undefined }
        }
    }
    if k8pNode == null {
        k8pTok = k8pTokAt("peek")
        if k8pTok.type == "this" {
            k8pTokAt("bump")
            k8pNode = { "kind": K_IDENT, "sym": "this" }
        }
    }
    if k8pNode == null {
        k8pTok = k8pTokAt("peek")
        if k8pTok.type == TOKEN_IDENT {
            let identSym = ("" + k8pTok.value)
            k8pTokAt("bump")
            k8pNode = { "kind": K_IDENT, "sym": identSym }
        }
    }
    if k8pNode == null {
        k8pTok = k8pTokAt("peek")
        if k8pTok.type == "(" {
            let saved = k8pPos
            k8pTokAt("bump")
            if k8pTokAt("peek").type == TOKEN_IDENT {
                k8pParams = []
                while true {
                    k8pTok = k8pTokAt("peek")
                    if k8pTok.type != TOKEN_IDENT {
                        throw "Expected parameter name"
                    }
                    k8pTok = k8pTokAt("bump")
                    k8pParams = push(k8pParams, k8pTok.value)
                    if k8pTokAt("peek").type == "," {
                        k8pTokAt("bump")
                    } else {
                        break
                    }
                }
                if k8pTokAt("peek").type != ")" {
                    throw "Expected )"
                }
                k8pTokAt("bump")
                if k8pTokAt("peek").type == "=>" {
                    k8pTokAt("bump")
                    k8pArrowBody = parseCompare()
                    k8pNode = { "kind": K_ARROW, "params": k8pParams, "body": k8pArrowBody }
                } else {
                    k8pPos = saved
                    k8pTokAt("bump")
                    k8pNode = parseCompare()
                    if k8pTokAt("peek").type != ")" {
                        throw "Expected )"
                    }
                    k8pTokAt("bump")
                }
            } else {
                if k8pTokAt("peek").type == ")" {
                    k8pTokAt("bump")
                    if k8pTokAt("peek").type == "=>" {
                        k8pTokAt("bump")
                        k8pArrowBody = parseCompare()
                        k8pNode = { "kind": K_ARROW, "params": [], "body": k8pArrowBody }
                    } else {
                        k8pPos = saved
                        k8pTokAt("bump")
                        k8pNode = parseCompare()
                        if k8pTokAt("peek").type != ")" {
                            throw "Expected )"
                        }
                        k8pTokAt("bump")
                    }
                } else {
                    k8pPos = saved
                    k8pTokAt("bump")
                    k8pNode = parseCompare()
                    if k8pTokAt("peek").type != ")" {
                        throw "Expected )"
                    }
                    k8pTokAt("bump")
                }
            }
        }
    }

    if k8pNode == null {
        k8pTok = k8pTokAt("peek")
        if k8pTok.type == "{" {
            k8pTokAt("bump")
            k8pObjStack = push(k8pObjStack, k8pObjFields)
            k8pObjFields = []
            while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
                k8pTok = k8pTokAt("peek")
                let key = ""
                if k8pTok.type == TOKEN_IDENT {
                    key = "" + k8pTok.value
                    k8pTokAt("bump")
                } else {
                    if k8pTok.type == TOKEN_STRING || k8pTok.type == TOKEN_TEMPLATE {
                        key = "" + k8pTok.value
                        k8pTokAt("bump")
                    } else {
                        throw "Expected object key"
                    }
                }
                if k8pTokAt("peek").type != ":" {
                    throw "Expected :"
                }
                k8pTokAt("bump")
                let val = parseCompare()
                k8pObjFields = push(k8pObjFields, { "key": key, "value": val })
                if k8pTokAt("peek").type == "," {
                    k8pTokAt("bump")
                }
            }
            if k8pTokAt("peek").type != "}" {
                throw "Expected }"
            }
            k8pTokAt("bump")
            k8pNode = { "kind": K_OBJECT, "fields": k8pSnapList(k8pObjFields) }
            k8pObjFields = k8pObjStack[len(k8pObjStack) - 1]
            k8pObjStack = k8pPopStack(k8pObjStack)
        }
    }
    if k8pNode == null {
        k8pTok = k8pTokAt("peek")
        if k8pTok.type == "[" {
            k8pTokAt("bump")
            k8pArrStack = push(k8pArrStack, k8pArrElems)
            k8pArrElems = []
            while k8pTokAt("peek").type != "]" && k8pTokAt("peek").type != TOKEN_EOF {
                k8pArrElems = push(k8pArrElems, parseCompare())
                if k8pTokAt("peek").type == "," {
                    k8pTokAt("bump")
                }
            }
            if k8pTokAt("peek").type != "]" {
                throw "Expected ]"
            }
            k8pTokAt("bump")
            k8pNode = { "kind": K_ARRAY, "elements": k8pSnapList(k8pArrElems) }
            k8pArrElems = k8pArrStack[len(k8pArrStack) - 1]
            k8pArrStack = k8pPopStack(k8pArrStack)
        }
    }
    if k8pNode == null {
        throw "Expected expression"
    }

    while true {
        k8pTok = k8pTokAt("peek")
        if k8pTok.type == "(" {
            k8pTokAt("bump")
            let callee = k8pNode
            k8pParams = []
            if k8pTokAt("peek").type != ")" {
                while true {
                    k8pParams = push(k8pParams, parseCompare())
                    if k8pTokAt("peek").type == "," {
                        k8pTokAt("bump")
                    } else {
                        break
                    }
                }
            }
            if k8pTokAt("peek").type != ")" {
                throw "Expected )"
            }
            k8pTokAt("bump")
            k8pNode = { "kind": K_CALL, "callee": callee, "args": k8pParams }
        } else {
            if k8pTok.type == "[" {
                k8pTokAt("bump")
                k8pSave = k8pNode
                k8pRight = parseCompare()
                if k8pTokAt("peek").type != "]" {
                    throw "Expected ]"
                }
                k8pTokAt("bump")
                k8pNode = { "kind": K_INDEX, "object": k8pSave, "index": k8pRight }
            } else {
            if k8pTok.type == "." {
                k8pTokAt("bump")
                k8pTok = k8pTokAt("peek")
                if k8pTok.type != TOKEN_IDENT {
                    throw "Expected member name"
                }
                k8pTok = k8pTokAt("bump")
                k8pSave = k8pNode
                k8pNode = { "kind": K_MEMBER, "object": k8pSave, "field": k8pTok.value, "optional": false }
            } else {
                if k8pTok.type == "?." {
                    k8pTokAt("bump")
                    k8pTok = k8pTokAt("peek")
                    if k8pTok.type != TOKEN_IDENT {
                        throw "Expected member name after ?."
                    }
                    k8pTok = k8pTokAt("bump")
                    k8pSave = k8pNode
                    k8pNode = { "kind": K_MEMBER, "object": k8pSave, "field": k8pTok.value, "optional": true }
                } else {
                    break
                }
            }
            }
        }
    }
    return k8pNode
}

// Precedence layers: mul -> add -> cmp -> and -> or/??.
// Dedicated left slots (k8pAddLeft/AndLeft/LogLeft) - never reuse k8pSave across &&.
fn parseAddExpr() {
    k8pLeft = parsePostfix()
    while k8pTokAt("peek").type == "*" || k8pTokAt("peek").type == "/" {
        k8pOp = k8pTokAt("bump").type
        k8pSave = k8pLeft
        k8pRight = parsePostfix()
        k8pLeft = { "kind": K_BINARY, "op": k8pOp, "left": k8pSave, "right": k8pRight }
    }
    while k8pTokAt("peek").type == "+" || k8pTokAt("peek").type == "-" {
        k8pAddOp = k8pTokAt("bump").type
        k8pAddLeft = k8pLeft
        k8pRight = parsePostfix()
        while k8pTokAt("peek").type == "*" || k8pTokAt("peek").type == "/" {
            k8pOp = k8pTokAt("bump").type
            k8pSave = k8pRight
            k8pRight = { "kind": K_BINARY, "op": k8pOp, "left": k8pSave, "right": parsePostfix() }
        }
        k8pLeft = { "kind": K_BINARY, "op": k8pAddOp, "left": k8pAddLeft, "right": k8pRight }
    }
    return k8pLeft
}

fn parseCompare() {
    k8pLeft = parseAddExpr()
    while true {
        k8pTok = k8pTokAt("peek")
        if k8pTok.type == "==" || k8pTok.type == "===" || k8pTok.type == "!=" || k8pTok.type == "!==" || k8pTok.type == "<" || k8pTok.type == ">" || k8pTok.type == "<=" || k8pTok.type == ">=" {
            k8pCmpOp = k8pTokAt("bump").type
            k8pCmpLeft = k8pLeft
            k8pRight = parseAddExpr()
            k8pLeft = { "kind": K_BINARY, "op": k8pCmpOp, "left": k8pCmpLeft, "right": k8pRight }
        } else {
            break
        }
    }
    while k8pTokAt("peek").type == "&&" {
        k8pTokAt("bump")
        k8pAndLeft = k8pLeft
        k8pRight = parseAddExpr()
        while true {
            k8pTok = k8pTokAt("peek")
            if k8pTok.type == "==" || k8pTok.type == "===" || k8pTok.type == "!=" || k8pTok.type == "!==" || k8pTok.type == "<" || k8pTok.type == ">" || k8pTok.type == "<=" || k8pTok.type == ">=" {
                k8pCmpOp = k8pTokAt("bump").type
                k8pCmpLeft = k8pRight
                k8pRight = { "kind": K_BINARY, "op": k8pCmpOp, "left": k8pCmpLeft, "right": parseAddExpr() }
            } else {
                break
            }
        }
        k8pLeft = { "kind": K_BINARY, "op": "&&", "left": k8pAndLeft, "right": k8pRight }
    }
    while k8pTokAt("peek").type == "||" || k8pTokAt("peek").type == "??" {
        k8pOp = k8pTokAt("bump").type
        k8pLogLeft = k8pLeft
        k8pRight = parseAddExpr()
        while true {
            k8pTok = k8pTokAt("peek")
            if k8pTok.type == "==" || k8pTok.type == "===" || k8pTok.type == "!=" || k8pTok.type == "!==" || k8pTok.type == "<" || k8pTok.type == ">" || k8pTok.type == "<=" || k8pTok.type == ">=" {
                k8pCmpOp = k8pTokAt("bump").type
                k8pCmpLeft = k8pRight
                k8pRight = { "kind": K_BINARY, "op": k8pCmpOp, "left": k8pCmpLeft, "right": parseAddExpr() }
            } else {
                break
            }
        }
        while k8pTokAt("peek").type == "&&" {
            k8pTokAt("bump")
            k8pAndLeft = k8pRight
            k8pRight = parseAddExpr()
            k8pRight = { "kind": K_BINARY, "op": "&&", "left": k8pAndLeft, "right": k8pRight }
        }
        k8pLeft = { "kind": K_BINARY, "op": k8pOp, "left": k8pLogLeft, "right": k8pRight }
    }
    return k8pLeft
}

fn parseExpr() {
    k8pLeft = parseCompare()
    if k8pTokAt("peek").type == "?" {
        k8pTokAt("bump")
        k8pSave = k8pLeft
        k8pRight = parseExpr()
        if k8pTokAt("peek").type != ":" {
            throw "Expected :"
        }
        k8pTokAt("bump")
        k8pAndLeft = parseExpr()
        return { "kind": K_TERNARY, "cond": k8pSave, "thenBranch": k8pRight, "elseBranch": k8pAndLeft }
    }
    return k8pLeft
}

fn parseStmt() {
    k8pTok = k8pTokAt("peek")
    if k8pTok.type == TOKEN_EOF {
        return null
    }
    if k8pTok.type == "let" || k8pTok.type == "const" {
        k8pTokAt("bump")
        k8pTok = k8pTokAt("peek")
        if k8pTok.type != TOKEN_IDENT {
            throw "Expected binding name"
        }
        let bindSym = ("" + k8pTok.value)
        k8pTokAt("bump")
        if k8pTokAt("peek").type != "=" {
            throw "Expected ="
        }
        k8pTokAt("bump")
        k8pLeft = parseExpr()
        return { "kind": K_LET, "sym": bindSym, "init": k8pLeft }
    }
    if k8pTok.type == "var" {
        k8pTokAt("bump")
        k8pTok = k8pTokAt("peek")
        if k8pTok.type != TOKEN_IDENT {
            throw "Expected var name"
        }
        let bindSym = ("" + k8pTok.value)
        k8pTokAt("bump")
        k8pLeft = null
        if k8pTokAt("peek").type == "=" {
            k8pTokAt("bump")
            k8pLeft = parseExpr()
        }
        if k8pLeft == null {
            k8pLeft = { "kind": K_LITERAL, "lit": LIT_UNDEF, "value": undefined }
        }
        return { "kind": K_VAR, "sym": bindSym, "init": k8pLeft }
    }
    if k8pTok.type == "return" {
        k8pTokAt("bump")
        k8pLeft = null
        if k8pTokAt("peek").type != ";" && k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
            k8pLeft = parseExpr()
        }
        if k8pLeft == null {
            k8pLeft = { "kind": K_LITERAL, "lit": LIT_UNDEF, "value": undefined }
        }
        return { "kind": K_RETURN, "rhs": k8pLeft }
    }
    if k8pTok.type == "function" {
        k8pTokAt("bump")
        k8pTok = k8pTokAt("peek")
        if k8pTok.type != TOKEN_IDENT {
            throw "Expected function name"
        }
        k8pName = ("" + k8pTok.value)
        k8pTokAt("bump")
        if k8pTokAt("peek").type != "(" {
            throw "Expected ("
        }
        k8pTokAt("bump")
        k8pParams = []
        if k8pTokAt("peek").type != ")" {
            while true {
                k8pTok = k8pTokAt("peek")
                if k8pTok.type != TOKEN_IDENT {
                    throw "Expected parameter"
                }
                k8pParams = push(k8pParams, k8pTok.value)
                k8pTokAt("bump")
                if k8pTokAt("peek").type == "," {
                    k8pTokAt("bump")
                } else {
                    break
                }
            }
        }
        if k8pTokAt("peek").type != ")" {
            throw "Expected )"
        }
        k8pTokAt("bump")
        if k8pTokAt("peek").type != "{" {
            throw "Expected {"
        }
        k8pTokAt("bump")
        k8pBodyStack = push(k8pBodyStack, k8pBlockBody)
        k8pBlockBody = []
        while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
            k8pLeft = parseStmt()
            if k8pLeft != null {
                k8pBlockBody = push(k8pBlockBody, k8pLeft)
            }
            if k8pTokAt("peek").type == ";" {
                k8pTokAt("bump")
            }
        }
        if k8pTokAt("peek").type != "}" {
            throw "Expected }"
        }
        k8pTokAt("bump")
        let fnBody = k8pSnapList(k8pBlockBody)
        k8pBlockBody = k8pBodyStack[len(k8pBodyStack) - 1]
        k8pBodyStack = k8pPopStack(k8pBodyStack)
        return { "kind": K_FN, "sym": k8pName, "params": k8pSnapList(k8pParams), "body": { "kind": K_BLOCK, "body": fnBody } }
    }
    if k8pTok.type == "async" {
        k8pTokAt("bump")
        if k8pTokAt("peek").type != "function" {
            throw "Expected function after async"
        }
        k8pTokAt("bump")
        k8pTok = k8pTokAt("peek")
        if k8pTok.type != TOKEN_IDENT {
            throw "Expected function name"
        }
        k8pName = ("" + k8pTok.value)
        k8pTokAt("bump")
        if k8pTokAt("peek").type != "(" {
            throw "Expected ("
        }
        k8pTokAt("bump")
        k8pParams = []
        if k8pTokAt("peek").type != ")" {
            while true {
                k8pTok = k8pTokAt("peek")
                if k8pTok.type != TOKEN_IDENT {
                    throw "Expected parameter"
                }
                k8pParams = push(k8pParams, k8pTok.value)
                k8pTokAt("bump")
                if k8pTokAt("peek").type == "," {
                    k8pTokAt("bump")
                } else {
                    break
                }
            }
        }
        if k8pTokAt("peek").type != ")" {
            throw "Expected )"
        }
        k8pTokAt("bump")
        if k8pTokAt("peek").type != "{" {
            throw "Expected {"
        }
        k8pTokAt("bump")
        k8pBodyStack = push(k8pBodyStack, k8pBlockBody)
        k8pBlockBody = []
        while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
            k8pLeft = parseStmt()
            if k8pLeft != null {
                k8pBlockBody = push(k8pBlockBody, k8pLeft)
            }
            if k8pTokAt("peek").type == ";" {
                k8pTokAt("bump")
            }
        }
        if k8pTokAt("peek").type != "}" {
            throw "Expected }"
        }
        k8pTokAt("bump")
        let asyncBody = k8pSnapList(k8pBlockBody)
        k8pBlockBody = k8pBodyStack[len(k8pBodyStack) - 1]
        k8pBodyStack = k8pPopStack(k8pBodyStack)
        return { "kind": K_FN, "sym": k8pName, "params": k8pSnapList(k8pParams), "body": { "kind": K_BLOCK, "body": asyncBody }, "async": true }
    }
    if k8pTok.type == "class" {
        k8pTokAt("bump")
        k8pTok = k8pTokAt("peek")
        if k8pTok.type != TOKEN_IDENT {
            throw "Expected class name"
        }
        k8pName = ("" + k8pTok.value)
        k8pTokAt("bump")
        let classExt = null
        if k8pTokAt("peek").type == "extends" {
            k8pTokAt("bump")
            k8pTok = k8pTokAt("peek")
            if k8pTok.type != TOKEN_IDENT {
                throw "Expected superclass name"
            }
            classExt = ("" + k8pTok.value)
            k8pTokAt("bump")
        }
        if k8pTokAt("peek").type != "{" {
            throw "Expected {"
        }
        k8pTokAt("bump")
        k8pBodyStack = push(k8pBodyStack, k8pBlockBody)
        k8pBlockBody = []
        while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
            if k8pTokAt("peek").type == "static" {
                k8pTokAt("bump")
            }
            if k8pTokAt("peek").type == "async" {
                k8pTokAt("bump")
            }
            k8pTok = k8pTokAt("peek")
            if k8pTok.type != TOKEN_IDENT {
                throw "Expected method name"
            }
            let methName = ("" + k8pTok.value)
            k8pTokAt("bump")
            if k8pTokAt("peek").type != "(" {
                throw "Expected ("
            }
            k8pTokAt("bump")
            k8pParams = []
            if k8pTokAt("peek").type != ")" {
                while true {
                    k8pTok = k8pTokAt("peek")
                    if k8pTok.type != TOKEN_IDENT {
                        throw "Expected parameter"
                    }
                    k8pParams = push(k8pParams, k8pTok.value)
                    k8pTokAt("bump")
                    if k8pTokAt("peek").type == "," {
                        k8pTokAt("bump")
                    } else {
                        break
                    }
                }
            }
            if k8pTokAt("peek").type != ")" {
                throw "Expected )"
            }
            k8pTokAt("bump")
            if k8pTokAt("peek").type != "{" {
                throw "Expected {"
            }
            k8pTokAt("bump")
            let methStmts = []
            while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
                k8pSave = parseStmt()
                if k8pSave != null {
                    methStmts = push(methStmts, k8pSave)
                }
                if k8pTokAt("peek").type == ";" {
                    k8pTokAt("bump")
                }
            }
            if k8pTokAt("peek").type != "}" {
                throw "Expected }"
            }
            k8pTokAt("bump")
            k8pBlockBody = push(k8pBlockBody, { "kind": K_FN, "sym": methName, "params": k8pSnapList(k8pParams), "body": { "kind": K_BLOCK, "body": k8pSnapList(methStmts) } })
        }
        if k8pTokAt("peek").type != "}" {
            throw "Expected }"
        }
        k8pTokAt("bump")
        let classMethods = k8pSnapList(k8pBlockBody)
        k8pBlockBody = k8pBodyStack[len(k8pBodyStack) - 1]
        k8pBodyStack = k8pPopStack(k8pBodyStack)
        return { "kind": K_CLASS, "sym": k8pName, "extends": classExt, "methods": classMethods }
    }
    if k8pTok.type == "if" {
        k8pTokAt("bump")
        if k8pTokAt("peek").type != "(" {
            throw "Expected ("
        }
        k8pTokAt("bump")
        k8pCondStack = push(k8pCondStack, parseExpr())
        if k8pTokAt("peek").type != ")" {
            throw "Expected )"
        }
        k8pTokAt("bump")
        k8pBodyStack = push(k8pBodyStack, k8pBlockBody)
        k8pBlockBody = []
        if k8pTokAt("peek").type == "{" {
            k8pTokAt("bump")
            while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
                k8pSave = parseStmt()
                if k8pSave != null {
                    k8pBlockBody = push(k8pBlockBody, k8pSave)
                }
                if k8pTokAt("peek").type == ";" {
                    k8pTokAt("bump")
                }
            }
            k8pTokAt("bump")
        } else {
            k8pSave = parseStmt()
            if k8pSave != null {
                k8pBlockBody = push(k8pBlockBody, k8pSave)
            }
        }
        let thenBody = k8pSnapList(k8pBlockBody)
        k8pBlockBody = k8pBodyStack[len(k8pBodyStack) - 1]
        k8pBodyStack = k8pPopStack(k8pBodyStack)
        k8pElse = []
        if k8pTokAt("peek").type == "else" {
            k8pTokAt("bump")
            if k8pTokAt("peek").type == "{" {
                k8pTokAt("bump")
                while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
                    k8pSave = parseStmt()
                    if k8pSave != null {
                        k8pElse = push(k8pElse, k8pSave)
                    }
                    if k8pTokAt("peek").type == ";" {
                        k8pTokAt("bump")
                    }
                }
                k8pTokAt("bump")
            } else {
                k8pSave = parseStmt()
                if k8pSave != null {
                    k8pElse = push(k8pElse, k8pSave)
                }
            }
        }
        k8pCond = k8pCondStack[len(k8pCondStack) - 1]
        k8pCondStack = k8pPopStack(k8pCondStack)
        return { "kind": K_IF, "cond": k8pCond, "then": { "kind": K_BLOCK, "body": thenBody }, "elseBranch": k8pSnapList(k8pElse) }
    }
    if k8pTok.type == "switch" {
        k8pTokAt("bump")
        if k8pTokAt("peek").type != "(" {
            throw "Expected ("
        }
        k8pTokAt("bump")
        k8pCondStack = push(k8pCondStack, parseExpr())
        if k8pTokAt("peek").type != ")" {
            throw "Expected )"
        }
        k8pTokAt("bump")
        if k8pTokAt("peek").type != "{" {
            throw "Expected {"
        }
        k8pTokAt("bump")
        let cases = []
        while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
            k8pTok = k8pTokAt("peek")
            let caseTest = null
            if k8pTok.type == "case" {
                k8pTokAt("bump")
                caseTest = parseExpr()
                if k8pTokAt("peek").type != ":" {
                    throw "Expected :"
                }
                k8pTokAt("bump")
            } else {
                if k8pTok.type == "default" {
                    k8pTokAt("bump")
                    if k8pTokAt("peek").type != ":" {
                        throw "Expected :"
                    }
                    k8pTokAt("bump")
                    caseTest = null
                } else {
                    throw "Expected case or default"
                }
            }
            k8pBodyStack = push(k8pBodyStack, k8pBlockBody)
            k8pBlockBody = []
            while k8pTokAt("peek").type != "case" && k8pTokAt("peek").type != "default" && k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
                k8pSave = parseStmt()
                if k8pSave != null {
                    k8pBlockBody = push(k8pBlockBody, k8pSave)
                }
                if k8pTokAt("peek").type == ";" {
                    k8pTokAt("bump")
                }
            }
            let caseBody = k8pSnapList(k8pBlockBody)
            k8pBlockBody = k8pBodyStack[len(k8pBodyStack) - 1]
            k8pBodyStack = k8pPopStack(k8pBodyStack)
            cases = push(cases, { "test": caseTest, "body": caseBody })
        }
        if k8pTokAt("peek").type != "}" {
            throw "Expected }"
        }
        k8pTokAt("bump")
        k8pCond = k8pCondStack[len(k8pCondStack) - 1]
        k8pCondStack = k8pPopStack(k8pCondStack)
        return { "kind": K_SWITCH, "disc": k8pCond, "cases": cases }
    }
    if k8pTok.type == "while" {
        k8pTokAt("bump")
        if k8pTokAt("peek").type != "(" {
            throw "Expected ("
        }
        k8pTokAt("bump")
        k8pCondStack = push(k8pCondStack, parseExpr())
        if k8pTokAt("peek").type != ")" {
            throw "Expected )"
        }
        k8pTokAt("bump")
        k8pBodyStack = push(k8pBodyStack, k8pBlockBody)
        k8pBlockBody = []
        if k8pTokAt("peek").type == "{" {
            k8pTokAt("bump")
            while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
                k8pSave = parseStmt()
                if k8pSave != null {
                    k8pBlockBody = push(k8pBlockBody, k8pSave)
                }
                if k8pTokAt("peek").type == ";" {
                    k8pTokAt("bump")
                }
            }
            k8pTokAt("bump")
        } else {
            k8pSave = parseStmt()
            if k8pSave != null {
                k8pBlockBody = push(k8pBlockBody, k8pSave)
            }
        }
        let whileBody = k8pSnapList(k8pBlockBody)
        k8pBlockBody = k8pBodyStack[len(k8pBodyStack) - 1]
        k8pBodyStack = k8pPopStack(k8pBodyStack)
        k8pCond = k8pCondStack[len(k8pCondStack) - 1]
        k8pCondStack = k8pPopStack(k8pCondStack)
        return { "kind": K_WHILE, "cond": k8pCond, "body": { "kind": K_BLOCK, "body": whileBody } }
    }
    if k8pTok.type == "for" {
        k8pTokAt("bump")
        if k8pTokAt("peek").type != "(" {
            throw "Expected ("
        }
        k8pTokAt("bump")
        let forInPos = k8pPos
        k8pForInSym = ""
        k8pTok = k8pTokAt("peek")
        if k8pTok.type == "let" || k8pTok.type == "var" || k8pTok.type == "const" {
            k8pTokAt("bump")
            k8pTok = k8pTokAt("peek")
            if k8pTok.type == TOKEN_IDENT {
                k8pForInSym = ("" + k8pTok.value)
                k8pTokAt("bump")
                if k8pTokAt("peek").type == "in" || k8pTokAt("peek").type == "of" {
                    k8pForKind = k8pTokAt("bump").type
                    k8pForCond = parseExpr()
                    if k8pTokAt("peek").type != ")" {
                        throw "Expected )"
                    }
                    k8pTokAt("bump")
                    k8pBodyStack = push(k8pBodyStack, k8pBlockBody)
                    k8pBlockBody = []
                    if k8pTokAt("peek").type == "{" {
                        k8pTokAt("bump")
                        while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
                            k8pSave = parseStmt()
                            if k8pSave != null {
                                k8pBlockBody = push(k8pBlockBody, k8pSave)
                            }
                            if k8pTokAt("peek").type == ";" {
                                k8pTokAt("bump")
                            }
                        }
                        k8pTokAt("bump")
                    } else {
                        k8pSave = parseStmt()
                        if k8pSave != null {
                            k8pBlockBody = push(k8pBlockBody, k8pSave)
                        }
                    }
                    let forInBody = k8pSnapList(k8pBlockBody)
                    k8pBlockBody = k8pBodyStack[len(k8pBodyStack) - 1]
                    k8pBodyStack = k8pPopStack(k8pBodyStack)
                    if k8pForKind == "of" {
                        return { "kind": K_FOR_OF, "sym": k8pForInSym, "iterable": k8pForCond, "body": { "kind": K_BLOCK, "body": forInBody } }
                    }
                    return { "kind": K_FOR_IN, "sym": k8pForInSym, "iterable": k8pForCond, "body": { "kind": K_BLOCK, "body": forInBody } }
                }
            }
            k8pPos = forInPos
        } else {
            if k8pTok.type == TOKEN_IDENT {
                k8pForInSym = ("" + k8pTok.value)
                k8pTokAt("bump")
                if k8pTokAt("peek").type == "in" || k8pTokAt("peek").type == "of" {
                    k8pForKind = k8pTokAt("bump").type
                    k8pForCond = parseExpr()
                    if k8pTokAt("peek").type != ")" {
                        throw "Expected )"
                    }
                    k8pTokAt("bump")
                    k8pBodyStack = push(k8pBodyStack, k8pBlockBody)
                    k8pBlockBody = []
                    if k8pTokAt("peek").type == "{" {
                        k8pTokAt("bump")
                        while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
                            k8pSave = parseStmt()
                            if k8pSave != null {
                                k8pBlockBody = push(k8pBlockBody, k8pSave)
                            }
                            if k8pTokAt("peek").type == ";" {
                                k8pTokAt("bump")
                            }
                        }
                        k8pTokAt("bump")
                    } else {
                        k8pSave = parseStmt()
                        if k8pSave != null {
                            k8pBlockBody = push(k8pBlockBody, k8pSave)
                        }
                    }
                    let forInBody2 = k8pSnapList(k8pBlockBody)
                    k8pBlockBody = k8pBodyStack[len(k8pBodyStack) - 1]
                    k8pBodyStack = k8pPopStack(k8pBodyStack)
                    if k8pForKind == "of" {
                        return { "kind": K_FOR_OF, "sym": k8pForInSym, "iterable": k8pForCond, "body": { "kind": K_BLOCK, "body": forInBody2 } }
                    }
                    return { "kind": K_FOR_IN, "sym": k8pForInSym, "iterable": k8pForCond, "body": { "kind": K_BLOCK, "body": forInBody2 } }
                }
                k8pPos = forInPos
            }
        }
        k8pForInit = null
        if k8pTokAt("peek").type != ";" {
            k8pForInit = parseStmt()
        }
        if k8pTokAt("peek").type != ";" {
            throw "Expected ;"
        }
        k8pTokAt("bump")
        if k8pTokAt("peek").type == ";" {
            k8pForCond = { "kind": K_LITERAL, "lit": LIT_BOOL, "value": true }
        } else {
            k8pForCond = parseExpr()
        }
        if k8pTokAt("peek").type != ";" {
            throw "Expected ;"
        }
        k8pTokAt("bump")
        k8pForUpdate = null
        if k8pTokAt("peek").type != ")" {
            k8pForUpdate = parseStmt()
        }
        if k8pTokAt("peek").type != ")" {
            throw "Expected )"
        }
        k8pTokAt("bump")
        k8pBodyStack = push(k8pBodyStack, k8pBlockBody)
        k8pBlockBody = []
        if k8pTokAt("peek").type == "{" {
            k8pTokAt("bump")
            while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
                k8pSave = parseStmt()
                if k8pSave != null {
                    k8pBlockBody = push(k8pBlockBody, k8pSave)
                }
                if k8pTokAt("peek").type == ";" {
                    k8pTokAt("bump")
                }
            }
            k8pTokAt("bump")
        } else {
            k8pSave = parseStmt()
            if k8pSave != null {
                k8pBlockBody = push(k8pBlockBody, k8pSave)
            }
        }
        let forBody = k8pSnapList(k8pBlockBody)
        k8pBlockBody = k8pBodyStack[len(k8pBodyStack) - 1]
        k8pBodyStack = k8pPopStack(k8pBodyStack)
        return { "kind": K_FOR, "init": k8pForInit, "cond": k8pForCond, "update": k8pForUpdate, "body": { "kind": K_BLOCK, "body": forBody } }
    }
    if k8pTok.type == "try" {
        k8pTokAt("bump")
        if k8pTokAt("peek").type != "{" {
            throw "Expected {"
        }
        k8pTokAt("bump")
        k8pBodyStack = push(k8pBodyStack, k8pBlockBody)
        k8pBlockBody = []
        while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
            k8pSave = parseStmt()
            if k8pSave != null {
                k8pBlockBody = push(k8pBlockBody, k8pSave)
            }
            if k8pTokAt("peek").type == ";" {
                k8pTokAt("bump")
            }
        }
        if k8pTokAt("peek").type != "}" {
            throw "Expected }"
        }
        k8pTokAt("bump")
        k8pTryBody = k8pSnapList(k8pBlockBody)
        k8pBlockBody = k8pBodyStack[len(k8pBodyStack) - 1]
        k8pBodyStack = k8pPopStack(k8pBodyStack)
        k8pCatchParam = ""
        k8pCatchBody = null
        k8pFinallyBody = null
        if k8pTokAt("peek").type == "catch" {
            k8pTokAt("bump")
            if k8pTokAt("peek").type == "(" {
                k8pTokAt("bump")
                k8pTok = k8pTokAt("peek")
                if k8pTok.type != TOKEN_IDENT {
                    throw "Expected catch binding"
                }
                k8pCatchParam = ("" + k8pTok.value)
                k8pTokAt("bump")
                if k8pTokAt("peek").type != ")" {
                    throw "Expected )"
                }
                k8pTokAt("bump")
            }
            if k8pTokAt("peek").type != "{" {
                throw "Expected {"
            }
            k8pTokAt("bump")
            k8pElse = []
            while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
                k8pSave = parseStmt()
                if k8pSave != null {
                    k8pElse = push(k8pElse, k8pSave)
                }
                if k8pTokAt("peek").type == ";" {
                    k8pTokAt("bump")
                }
            }
            if k8pTokAt("peek").type != "}" {
                throw "Expected }"
            }
            k8pTokAt("bump")
            k8pCatchBody = { "kind": K_BLOCK, "body": k8pSnapList(k8pElse) }
        }
        if k8pTokAt("peek").type == "finally" {
            k8pTokAt("bump")
            if k8pTokAt("peek").type != "{" {
                throw "Expected {"
            }
            k8pTokAt("bump")
            k8pBodyStack = push(k8pBodyStack, k8pBlockBody)
            k8pBlockBody = []
            while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
                k8pSave = parseStmt()
                if k8pSave != null {
                    k8pBlockBody = push(k8pBlockBody, k8pSave)
                }
                if k8pTokAt("peek").type == ";" {
                    k8pTokAt("bump")
                }
            }
            if k8pTokAt("peek").type != "}" {
                throw "Expected }"
            }
            k8pTokAt("bump")
            k8pFinallyBody = { "kind": K_BLOCK, "body": k8pSnapList(k8pBlockBody) }
            k8pBlockBody = k8pBodyStack[len(k8pBodyStack) - 1]
            k8pBodyStack = k8pPopStack(k8pBodyStack)
        }
        return { "kind": K_TRY, "body": { "kind": K_BLOCK, "body": k8pTryBody }, "catchParam": k8pCatchParam, "catchBody": k8pCatchBody, "finallyBody": k8pFinallyBody }
    }
    if k8pTok.type == "throw" {
        k8pTokAt("bump")
        k8pLeft = parseExpr()
        return { "kind": K_THROW, "rhs": k8pLeft }
    }
    if k8pTok.type == "break" {
        k8pTokAt("bump")
        return { "kind": K_BREAK }
    }
    if k8pTok.type == "continue" {
        k8pTokAt("bump")
        return { "kind": K_CONTINUE }
    }
    if k8pTok.type == "{" {
        k8pTokAt("bump")
        k8pBodyStack = push(k8pBodyStack, k8pBlockBody)
        k8pBlockBody = []
        while k8pTokAt("peek").type != "}" && k8pTokAt("peek").type != TOKEN_EOF {
            k8pSave = parseStmt()
            if k8pSave != null {
                k8pBlockBody = push(k8pBlockBody, k8pSave)
            }
            if k8pTokAt("peek").type == ";" {
                k8pTokAt("bump")
            }
        }
        if k8pTokAt("peek").type != "}" {
            throw "Expected }"
        }
        k8pTokAt("bump")
        let bareBody = k8pSnapList(k8pBlockBody)
        k8pBlockBody = k8pBodyStack[len(k8pBodyStack) - 1]
        k8pBodyStack = k8pPopStack(k8pBodyStack)
        return { "kind": K_BLOCK, "body": bareBody }
    }
    k8pTok = k8pTokAt("peek")
    if k8pTok.type == TOKEN_IDENT {
        let assignSym = ("" + k8pTok.value)
        k8pTokAt("bump")
        if k8pTokAt("peek").type == "=" {
            k8pTokAt("bump")
            k8pLeft = parseExpr()
            return { "kind": K_ASSIGN, "sym": assignSym, "rhs": k8pLeft }
        }
        k8pPos = k8pPos - 1
    }
    k8pLeft = parseExpr()
    if k8pTokAt("peek").type == "=" {
        k8pTokAt("bump")
        k8pSave = k8pLeft
        k8pRight = parseExpr()
        if k8pSave.kind == K_IDENT {
            return { "kind": K_ASSIGN, "sym": k8pSave["sym"], "rhs": k8pRight }
        }
        if k8pSave.kind == K_MEMBER {
            return { "kind": K_ASSIGN, "object": k8pSave["object"], "field": k8pSave["field"], "rhs": k8pRight }
        }
        throw "Invalid assignment target"
    }
    return { "kind": K_EXPR, "expr": k8pLeft }
}

pub fn parseSource(source) {
    k8pToks = tokenize(source)
    k8pPos = 0
    k8pBody = []
    while k8pTokAt("peek").type != TOKEN_EOF {
        k8pLeft = parseStmt()
        if k8pLeft != null {
            k8pBody = push(k8pBody, k8pLeft)
        }
        if k8pTokAt("peek").type == ";" {
            k8pTokAt("bump")
        }
    }
    return { "kind": K_PROGRAM, "body": k8pSnapList(k8pBody) }
}
