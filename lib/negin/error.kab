@version "1.0.0"

// Negin Error — error values, logging, and boundary helpers (valid Kabootar).
// Canonical path: import "negin/error"

let errorLog = []

pub fn createError(message, code) {
    let c = code
    if c == null {
        c = "UNKNOWN_ERROR"
    }
    return {
        "kind": "Error",
        "message": message,
        "code": c,
        "stack": null
    }
}

pub fn createNetworkError(message) {
    return createError(message, "NETWORK_ERROR")
}

pub fn createValidationError(message, field) {
    return {
        "kind": "ValidationError",
        "message": message,
        "field": field,
        "code": "VALIDATION_ERROR"
    }
}

pub fn createAuthError(message) {
    return createError(message, "AUTH_ERROR")
}

pub fn createNotFoundError(message) {
    return createError(message, "NOT_FOUND_ERROR")
}

pub fn isError(value) {
    if value == null {
        return false
    }
    return value["kind"] == "Error"
}

pub fn isValidationError(value) {
    if value == null {
        return false
    }
    return value["kind"] == "ValidationError"
}

pub fn getErrorCode(error) {
    if error != null && error["code"] != null {
        return error["code"]
    }
    return "UNKNOWN_ERROR"
}

pub fn getErrorMessage(error) {
    if error != null && error["message"] != null {
        return error["message"]
    }
    return "An unknown error occurred"
}

pub fn logError(error, errorInfo) {
    errorLog = push(errorLog, {
        "error": error,
        "errorInfo": errorInfo
    })
    return true
}

pub fn getErrorLog() {
    return errorLog
}

pub fn clearErrorLog() {
    errorLog = []
}

pub fn reportError(error, context) {
    errorLog = push(errorLog, {
        "error": error,
        "context": context
    })
    return true
}

/// Catch helper: run `fn`, return its value or a tagged error object.
pub fn tryRecover(work, fallback) {
    let v = work()
    if isError(v) {
        logError(v, null)
        if fallback != null {
            return fallback(v)
        }
        return v
    }
    return v
}
