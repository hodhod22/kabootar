pub fn createLoggerPlugin(level) {
    return createPlugin("logger", {
        "version": "1.0.0",
        "description": "Logger plugin for Negin",
        "onLoad": fn() {
            console.log("Logger plugin loaded with level:", level)
        },
        "hooks": {
            "error": fn(data) {
                console.error("Error:", data)
                return data
            },
            "warn": fn(data) {
                console.warn("Warning:", data)
                return data
            }
        },
        "api": {
            "log": fn(message, level) {
                console.log("[" + level + "]", message)
            },
            "error": fn(message) {
                console.error("[ERROR]", message)
            },
            "warn": fn(message) {
                console.warn("[WARN]", message)
            },
            "info": fn(message) {
                console.info("[INFO]", message)
            }
        }
    })
}

pub fn createI18nPlugin(defaultLocale, translations) {
    return createPlugin("i18n", {
        "version": "1.0.0",
        "description": "Internationalization plugin for Negin",
        "onLoad": fn() {
            console.log("I18n plugin loaded with locale:", defaultLocale)
        },
        "api": {
            "locale": defaultLocale,
            "translations": translations,
            "t": fn(key, params) {
                let locale = defaultLocale
                let translation = translations[locale]
                if translation != null && translation[key] != null) {
                    return translation[key]
                }
                return key
            },
            "setLocale": fn(locale) {
                defaultLocale = locale
            },
            "addTranslations": fn(locale, newTranslations) {
                if translations[locale] == null) {
                    translations[locale] = {}
                }
                for key in newTranslations) {
                    translations[locale][key] = newTranslations[key]
                }
            }
        }
    })
}

pub fn createStoragePlugin(prefix) {
    return createPlugin("storage", {
        "version": "1.0.0",
        "description": "Storage plugin for Negin",
        "onLoad": fn() {
            console.log("Storage plugin loaded with prefix:", prefix)
        },
        "api": {
            "get": fn(key) {
                return null
            },
            "set": fn(key, value) {
                console.log("Storing:", prefix + key, value)
            },
            "remove": fn(key) {
                console.log("Removing:", prefix + key)
            },
            "clear": fn() {
                console.log("Clearing storage with prefix:", prefix)
            }
        }
    })
}

