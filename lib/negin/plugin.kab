}

pub fn createAuthPlugin(config) {
    return createPlugin("auth", {
        "version": "1.0.0",
        "description": "Authentication plugin for Negin",
        "onLoad": fn() {
            console.log("Auth plugin loaded")
        },
        "api": {
            "login": fn(credentials) {
                console.log("Logging in with:", credentials)
                return { "success": true, "user": null }
            },
            "logout": fn() {
                console.log("Logging out")
            },
            "register": fn(userData) {
                console.log("Registering:", userData)
                return { "success": true }
            },
            "getUser": fn() {
                return null
            },
            "isAuthenticated": fn() {
                return false
            }
        }
    })
}

pub fn getPluginStats() {
    let stats = {
        "total": len(plugins),
        "enabled": 0,
        "disabled": 0,
        "hooks": {}
    }
    
    let i = 0
    while i < len(plugins)) {
        if plugins[i]["enabled"]) {
            stats["enabled"] = stats["enabled"] + 1
        } else {
            stats["disabled"] = stats["disabled"] + 1
        }
        i = i + 1
    }
    
    for hookName in pluginHooks) {
        stats["hooks"][hookName] = len(pluginHooks[hookName])
    }
    
    return stats
}

pub fn resetPlugins() {
    plugins = []
    pluginHooks = {}
}

fn typeof(value) {
    if value == null) {
        return "null"
    }
    if typeof(value) == "boolean") {
        return "boolean"
    }
    if typeof(value) == "number") {
        return "number"
    }
    if typeof(value) == "string") {
        return "string"
    }
    if typeof(value) == "function") {
        return "function"
    }
    if typeof(value) == "array") {
        return "array"
    }
    if typeof(value) == "object") {
        return "object"
    }
    return "unknown"
}
