@version "1.0.0"

// Negin Plugin - Plugin system for Negin
// Features: plugin registration, lifecycle hooks, plugin API
// Canonical path: import "negin/plugin"

let plugins = []
let pluginHooks = {}

pub fn createPlugin(name, config) {
    return {
        "kind": "Plugin",
        "name": name,
        "version": config["version"] != null ? config["version"] : "1.0.0",
        "description": config["description"],
        "onLoad": config["onLoad"],
        "onUnload": config["onUnload"],
        "hooks": config["hooks"] != null ? config["hooks"] : {},
        "api": config["api"] != null ? config["api"] : {},
        "enabled": true
    }
}

pub fn registerPlugin(plugin) {
    plugins = push(plugins, plugin)
    
    if plugin["onLoad"] != null) {
        plugin["onLoad"]()
    }
    
    registerPluginHooks(plugin)
    
    return plugin
}

pub fn unregisterPlugin(name) {
    let newPlugins = []
    let i = 0
    while i < len(plugins)) {
        if plugins[i]["name"] != name) {
            newPlugins = push(newPlugins, plugins[i])
        } else {
            if plugins[i]["onUnload"] != null) {
                plugins[i]["onUnload"]()
            }
            unregisterPluginHooks(plugins[i])
        }
        i = i + 1
    }
    plugins = newPlugins
}

fn registerPluginHooks(plugin) {
    let hooks = plugin["hooks"]
    
    for hookName in hooks) {
        if pluginHooks[hookName] == null) {
            pluginHooks[hookName] = []
        }
        pluginHooks[hookName] = push(pluginHooks[hookName], {
            "plugin": plugin["name"],
            "handler": hooks[hookName]
        })
    }
}

fn unregisterPluginHooks(plugin) {
    let hooks = plugin["hooks"]
    
    for hookName in hooks) {
        if pluginHooks[hookName] != null) {
            let newHandlers = []
            let i = 0
            while i < len(pluginHooks[hookName])) {
                if pluginHooks[hookName][i]["plugin"] != plugin["name"]) {
                    newHandlers = push(newHandlers, pluginHooks[hookName][i])
                }
                i = i + 1
            }
            pluginHooks[hookName] = newHandlers
        }
    }
}

pub fn getPlugin(name) {
    let i = 0
    while i < len(plugins)) {
        if plugins[i]["name"] == name) {
            return plugins[i]
        }
        i = i + 1
    }
    return null
}

pub fn getPlugins() {
    return plugins
}

pub fn enablePlugin(name) {
    let plugin = getPlugin(name)
    if plugin != null) {
        plugin["enabled"] = true
        if plugin["onLoad"] != null) {
            plugin["onLoad"]()
        }
    }
}

pub fn disablePlugin(name) {
    let plugin = getPlugin(name)
    if plugin != null) {
        plugin["enabled"] = false
        if plugin["onUnload"] != null) {
            plugin["onUnload"]()
        }
    }
}

pub fn isPluginEnabled(name) {
    let plugin = getPlugin(name)
    if plugin != null) {
        return plugin["enabled"]
    }
    return false
}

pub fn usePlugin(name) {
    let plugin = getPlugin(name)
    return plugin != null ? plugin["api"] : null
}

pub fn applyHook(hookName, data) {
    let handlers = pluginHooks[hookName]
    
    if handlers == null) {
        return data
    }
    
    let result = data
    
    let i = 0
    while i < len(handlers)) {
        let handler = handlers[i]
        if isPluginEnabled(handler["plugin"])) {
            result = handler["handler"](result)
        }
        i = i + 1
    }
    
    return result
}

pub fn createHook(hookName) {
    return {
        "kind": "Hook",
        "name": hookName,
        "handlers": []
    }
}

pub fn addHook(hookName, handler) {
    if pluginHooks[hookName] == null) {
        pluginHooks[hookName] = []
    }
    pluginHooks[hookName] = push(pluginHooks[hookName], {
        "plugin": "custom",
        "handler": handler
    })
}

pub fn removeHook(hookName, handler) {
    if pluginHooks[hookName] != null) {
        let newHandlers = []
        let i = 0
        while i < len(pluginHooks[hookName])) {
            if pluginHooks[hookName][i]["handler"] !== handler) {
                newHandlers = push(newHandlers, pluginHooks[hookName][i])
            }
            i = i + 1
        }
        pluginHooks[hookName] = newHandlers
    }
}

pub fn createPluginAPI(pluginName, api) {
    return {
        "kind": "PluginAPI",
        "plugin": pluginName,
        "api": api
    }
}

pub fn extendPluginAPI(pluginName, extension) {
    let plugin = getPlugin(pluginName)
    if plugin != null) {
        for key in extension) {
            plugin["api"][key] = extension[key]
        }
    }
}

pub fn createPluginManager() {
    return {
        "kind": "PluginManager",
        "plugins": [],
        "hooks": {},
        "register": registerPlugin,
        "unregister": unregisterPlugin,
        "get": getPlugin,
        "getAll": getPlugins,
        "enable": enablePlugin,
        "disable": disablePlugin,
        "isEnabled": isPluginEnabled,
        "use": usePlugin,
        "applyHook": applyHook,
        "addHook": addHook,
        "removeHook": removeHook
    }
}

pub fn createDevToolsPlugin() {
    return createPlugin("devtools", {
        "version": "1.0.0",
        "description": "Developer tools for Negin",
        "onLoad": fn() {
            console.log("DevTools plugin loaded")
        },
        "onUnload": fn() {
            console.log("DevTools plugin unloaded")
        },
        "hooks": {
            "render": fn(data) {
                console.log("Render hook called")
                return data
            }
        },
        "api": {
            "inspect": fn(component) {
                console.log("Inspecting component:", component)
            },
            "profile": fn(component) {
                console.log("Profiling component:", component)
            }
        }
    })
}

