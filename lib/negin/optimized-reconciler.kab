@version "1.0.0"

// Negin Optimized Reconciler - Smart diffing with heuristics
// Features: Auto-batching, smart diffing, concurrent rendering, zero-JS server components
// Canonical path: import "negin/optimized-reconciler"
// Target: Better than React with performance optimizations

import "negin/core"
import "negin/reactive-core"

// Auto-batching system
let batchDepth = 0
let batchedUpdates = []
let isScheduled = false

pub fn startBatch() {
    batchDepth = batchDepth + 1
}

pub fn endBatch() {
    batchDepth = batchDepth - 1
    
    if batchDepth == 0 && len(batchedUpdates) > 0) {
        flushBatchedUpdates()
    }
}

pub fn batchUpdate(updateFn) {
    startBatch()
    
    try {
        updateFn()
    } finally {
        endBatch()
    }
}

fn flushBatchedUpdates() {
    let updates = batchedUpdates
    batchedUpdates = []
    isScheduled = false
    
    let i = 0
    while i < len(updates)) {
        updates[i]()
        i = i + 1
    }
}

pub fn scheduleUpdate(updateFn) {
    batchedUpdates = push(batchedUpdates, updateFn)
    
    if batchDepth == 0 && !isScheduled) {
        isScheduled = true
        scheduleWork(flushBatchedUpdates)
    }
}

// Smart diffing with heuristics
pub fn diff(oldVNode, newVNode) {
    if oldVNode == null && newVNode == null) {
        return { "type": "NO_CHANGE" }
    }
    
    if oldVNode == null) {
        return { "type": "INSERT", "node": newVNode }
    }
    
    if newVNode == null) {
        return { "type": "REMOVE", "node": oldVNode }
    }
    
    if oldVNode["type"] != newVNode["type"]) {
        return { "type": "REPLACE", "old": oldVNode, "new": newVNode }
    }
    
    if oldVNode["type"] == "TEXT") {
        if oldVNode["children"][0] != newVNode["children"][0]) {
            return { "type": "TEXT_UPDATE", "old": oldVNode, "new": newVNode }
        }
        return { "type": "NO_CHANGE" }
    }
    
    // Smart props diffing
    let propsDiff = diffProps(oldVNode["props"], newVNode["props"])
    
    // Smart children diffing with key heuristics
    let childrenDiff = diffChildren(oldVNode["children"], newVNode["children"])
    
    if propsDiff["type"] == "NO_CHANGE" && childrenDiff["type"] == "NO_CHANGE") {
        return { "type": "NO_CHANGE" }
    }
    
    return {
        "type": "UPDATE",
        "propsDiff": propsDiff,
        "childrenDiff": childrenDiff
    }
}

fn diffProps(oldProps, newProps) {
    if oldProps == null && newProps == null) {
        return { "type": "NO_CHANGE" }
    }
    
    if oldProps == null) {
        return { "type": "PROPS_REPLACE", "props": newProps }
    }
    
    if newProps == null) {
        return { "type": "PROPS_REPLACE", "props": {} }
    }
    
    let changes = {}
    let removed = []
    
    for key in oldProps) {
        if newProps[key] == null) {
            removed = push(removed, key)
        } else if oldProps[key] !== newProps[key]) {
            changes[key] = newProps[key]
        }
    }
    
    for key in newProps) {
        if oldProps[key] == null) {
            changes[key] = newProps[key]
        }
    }
    
    if len(changes) == 0 && len(removed) == 0) {
        return { "type": "NO_CHANGE" }
    }
    
    return {
        "type": "PROPS_UPDATE",
        "changes": changes,
        "removed": removed
    }
}

fn diffChildren(oldChildren, newChildren) {
    if oldChildren == null && newChildren == null) {
        return { "type": "NO_CHANGE" }
    }
    
    if oldChildren == null) {
        return { "type": "CHILDREN_REPLACE", "children": newChildren }
    }
    
    if newChildren == null) {
        return { "type": "CHILDREN_REPLACE", "children": [] }
    }
    
    if len(oldChildren) == 0 && len(newChildren) == 0) {
        return { "type": "NO_CHANGE" }
    }
    
    // Try key-based diffing first (most efficient)
    let keyedDiff = diffChildrenByKey(oldChildren, newChildren)
    if keyedDiff != null) {
        return keyedDiff
    }
    
    // Fall back to index-based diffing
    return diffChildrenByIndex(oldChildren, newChildren)
}

fn diffChildrenByKey(oldChildren, newChildren) {
    let oldKeys = {}
    let newKeys = {}
    
    let i = 0
    while i < len(oldChildren)) {
        let child = oldChildren[i]
        let key = child["key"] != null ? child["key"] : i
        oldKeys[key] = { "index": i, "child": child }
        i = i + 1
    }
    
    let j = 0
    while j < len(newChildren)) {
        let child = newChildren[j]
        let key = child["key"] != null ? child["key"] : j
        newKeys[key] = { "index": j, "child": child }
        j = j + 1
    }
    
    let moves = []
    let updates = []
    let removes = []
    let inserts = []
    
    for key in oldKeys) {
        if newKeys[key] == null) {
            removes = push(removes, oldKeys[key])
        } else if oldKeys[key]["index"] != newKeys[key]["index"]) {
            moves = push(moves, {
                "key": key,
                "from": oldKeys[key]["index"],
                "to": newKeys[key]["index"]
            })
        }
    }
    
    for key in newKeys) {
        if oldKeys[key] == null) {
            inserts = push(inserts, newKeys[key])
        }
    }
    
    if len(moves) == 0 && len(updates) == 0 && len(removes) == 0 && len(inserts) == 0) {
        return null
    }
    
    return {
        "type": "CHILDREN_KEYED_DIFF",
        "moves": moves,
        "removes": removes,
        "inserts": inserts
    }
}

fn diffChildrenByIndex(oldChildren, newChildren) {
    let maxLength = max(len(oldChildren), len(newChildren))
    let changes = []
    
    let i = 0
    while i < maxLength) {
        let oldChild = i < len(oldChildren) ? oldChildren[i] : null
        let newChild = i < len(newChildren) ? newChildren[i] : null
        
        let childDiff = diff(oldChild, newChild)
        
        if childDiff["type"] != "NO_CHANGE") {
            changes = push(changes, {
                "index": i,
                "diff": childDiff
            })
        }
        
        i = i + 1
    }
    
    if len(changes) == 0) {
        return { "type": "NO_CHANGE" }
    }
    
    return {
        "type": "CHILDREN_INDEX_DIFF",
        "changes": changes
    }
}

fn max(a, b) {
    if a > b) {
        return a
    }
    return b
}

// Concurrent rendering with time slicing
let timeSlice = 5
let workInProgress = null
let pendingWork = []

pub fn setTimeSlice(ms) {
    timeSlice = ms
}

pub fn scheduleConcurrentWork(work) {
    pendingWork = push(pendingWork, work)
    
    if workInProgress == null) {
        processWorkQueue()
    }
}

fn processWorkQueue() {
    let startTime = currentTime()
    
    while len(pendingWork) > 0 && (currentTime() - startTime) < timeSlice) {
        let work = pendingWork[0]
        pendingWork = slice(pendingWork, 1, len(pendingWork))
        
        workInProgress = work
        work()
        workInProgress = null
    }
    
    if len(pendingWork) > 0) {
        scheduleWork(processWorkQueue)
    }
}

// Server components for zero-JS
let serverComponentRegistry = {}

pub fn defineServerComponent(name, component) {
    serverComponentRegistry[name] = {
        "kind": "ServerComponent",
        "component": component,
        "isServer": true
    }
}

pub fn isServerComponent(name) {
    let comp = serverComponentRegistry[name]
    return comp != null && comp["isServer"] == true
}

pub fn renderServerComponent(name, props) {
    let comp = serverComponentRegistry[name]
    
    if comp == null) {
        return null
    }
    
    return comp["component"](props)
}

pub fn ServerComponent(props) {
    let name = props["name"]
    
    if isServerComponent(name)) {
        return createElement("div", { "data-server-component": name }, 
            "Server component: " + name
        )
    }
    
    return createElement("div", {}, "Component not found")
}

// Zero-JS hydration
let hydrationData = {}

pub fn setHydrationData(key, data) {
    hydrationData[key] = data
}

pub fn getHydrationData(key) {
    return hydrationData[key]
}

pub fn hydrate(element, container) {
    let hydrationKey = container["id"]
    let data = getHydrationData(hydrationKey)
    
    if data != null) {
        return hydrateWith(element, container, data)
    }
    
    return render(element, container)
}

fn hydrateWith(element, container, data) {
    let root = createRoot(container)
    root["render"](element)
    return root
}

// Automatic error recovery
let errorBoundaries = []
let globalErrorHandler = null

pub fn registerErrorBoundary(boundary) {
    errorBoundaries = push(errorBoundaries, boundary)
}

pub fn unregisterErrorBoundary(boundary) {
    let newBoundaries = []
    let i = 0
    while i < len(errorBoundaries)) {
        if errorBoundaries[i] !== boundary) {
            newBoundaries = push(newBoundaries, errorBoundaries[i])
        }
        i = i + 1
    }
    errorBoundaries = newBoundaries
}

pub fn setGlobalErrorHandler(handler) {
    globalErrorHandler = handler
}

pub fn handleError(error, errorInfo) {
    if globalErrorHandler != null) {
        globalErrorHandler(error, errorInfo)
    }
    
    let i = 0
    while i < len(errorBoundaries)) {
        let boundary = errorBoundaries[i]
        if boundary["handleError"] != null) {
            boundary["handleError"](error, errorInfo)
            return
        }
        i = i + 1
    }
}

// Performance monitoring
let performanceMetrics = {
    "renderTimes": [],
    "updateCounts": 0,
    "componentRenders": {}
}

pub fn recordRenderTime(componentName, time) {
    if performanceMetrics["componentRenders"][componentName] == null) {
        performanceMetrics["componentRenders"][componentName] = {
            "count": 0,
            "totalTime": 0,
            "averageTime": 0
        }
    }
    
    let metrics = performanceMetrics["componentRenders"][componentName]
    metrics["count"] = metrics["count"] + 1
    metrics["totalTime"] = metrics["totalTime"] + time
    metrics["averageTime"] = metrics["totalTime"] / metrics["count"]
    
    performanceMetrics["renderTimes"] = push(performanceMetrics["renderTimes"], {
        "component": componentName,
        "time": time,
        "timestamp": currentTime()
    })
}

pub fn getPerformanceMetrics() {
    return performanceMetrics
}

pub fn clearPerformanceMetrics() {
    performanceMetrics = {
        "renderTimes": [],
        "updateCounts": 0,
        "componentRenders": {}
    }
}

// Tree-shaking hints
let exportedComponents = {}

pub fn exportComponent(name, component) {
    exportedComponents[name] = component
}

pub fn getExportedComponents() {
    return exportedComponents
}

pub fn markComponentAsTreeShakable(name) {
    if exportedComponents[name] != null) {
        exportedComponents[name]["treeShakable"] = true
    }
}

// Bundle optimization hints
pub fn markComponentAsLazy(name) {
    if exportedComponents[name] != null) {
        exportedComponents[name]["lazy"] = true
    }
}

pub fn markComponentAsCritical(name) {
    if exportedComponents[name] != null) {
        exportedComponents[name]["critical"] = true
    }
}

// Helper functions
fn currentTime() {
    return systemTime()
}

fn scheduleWork(callback) {
    callback()
}

fn slice(arr, start, end) {
    let result = []
    let i = start
    while i < end && i < len(arr)) {
        result = push(result, arr[i])
        i = i + 1
    }
    return result
}

fn typeof(value) {
    if value == null) {
        return "null"
    }
    if typeof(value) == "boolean") {
        return "boolean"
    }
    if typeof(value) == "number") {
        return "number"
    }
    if typeof(value) == "string") {
        return "string"
    }
    if typeof(value) == "function") {
        return "function"
    }
    if typeof(value) == "array") {
        return "array"
    }
    if typeof(value) == "object") {
        return "object"
    }
    return "unknown"
}
