// Full Kabootar integration
pub fn useKabootar() {
    let database = useKabootarDatabase({})
    let fileSystem = useKabootarFileSystem()
    let http = useKabootarHTTP()
    let system = useKabootarSystem()
    let crypto = useKabootarCrypto()
    let logger = useKabootarLogger()
    let process = useKabootarProcess()
    let cache = useKabootarCache()
    
    return {
        "database": database,
        "fileSystem": fileSystem,
        "http": http,
        "system": system,
        "crypto": crypto,
        "logger": logger,
        "process": process,
        "cache": cache
    }
}

fn typeof(value) {
    if value == null) {
        return "null"
    }
    if typeof(value) == "boolean") {
        return "boolean"
    }
    if typeof(value) == "number") {
        return "number"
    }
    if typeof(value) == "string") {
        return "string"
    }
    if typeof(value) == "function") {
        return "function"
    }
    if typeof(value) == "array") {
        return "array"
    }
    if typeof(value) == "object") {
        return "object"
    }
    return "unknown"
}
