    let del = fn(key) {
        return kabootarCacheDelete(key)
    }
    
    let clear = fn() {
        return kabootarCacheClear()
    }
    
    return {
        "get": get,
        "set": set,
        "del": del,
        "clear": clear
    }
}

pub fn kabootarCacheGet(key) {
    // Use Kabootar's built-in cache
    return { "success": true, "value": null }
