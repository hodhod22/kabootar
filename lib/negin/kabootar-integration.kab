// Logging integration
pub fn useKabootarLogger() {
    let log = fn(level, message) {
        return kabootarLog(level, message)
    }
    
    let info = fn(message) {
        return kabootarLog("info", message)
    }
    
    let warn = fn(message) {
        return kabootarLog("warn", message)
    }
    
    let error = fn(message) {
        return kabootarLog("error", message)
    }
    
    let debug = fn(message) {
        return kabootarLog("debug", message)
    }
    
    return {
        "log": log,
        "info": info,
        "warn": warn,
        "error": error,
        "debug": debug
    }
}

pub fn kabootarLog(level, message) {
    // Use Kabootar's built-in logging
    console.log("[" + level + "] " + message)
    return { "success": true }
}

