@version "1.0.0"

// Negin Signals — O(1) subscriber tracking via seen[eid] (Fas 6).
// Canonical path: import "negin/signals"

let currentEffect = null
let nextSid = 1
let nextEid = 1

pub fn createSignal(initialValue) {
    let box = {
        "kind": "Signal",
        "sid": nextSid,
        "seen": { "ok": true },
        "subscribers": [],
        "value": initialValue
    }
    nextSid = nextSid + 1
    return box
}

pub fn signalGet(box) {
    if currentEffect != null {
        trackDependency(box, currentEffect)
    }
    return box["value"]
}

pub fn signalSet(box, newValue) {
    if box["value"] != newValue {
        box["value"] = newValue
        notifySubscribers(box)
    }
}

pub fn createEffect(effectFn) {
    let eid = nextEid
    nextEid = nextEid + 1
    let fx = { "kind": "Effect", "eid": eid, "fn": effectFn }
    currentEffect = fx
    effectFn()
    currentEffect = null
    return fx
}

fn trackDependency(signal, effect) {
    let eid = effect["eid"]
    let seen = signal["seen"]
    let sk = "e" + eid
    if seen[sk] == true {
        return
    }
    seen[sk] = true
    signal["subscribers"] = push(signal["subscribers"], effect)
}

fn notifySubscribers(signal) {
    let subscribers = signal["subscribers"]
    let i = 0
    while i < len(subscribers) {
        let subscriber = subscribers[i]
        let f = subscriber["fn"]
        if f != null {
            f()
        }
        i = i + 1
    }
}
