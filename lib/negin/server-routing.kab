pub fn PATCH(path, handler, options) {
    return defineServerRoute(path, {
        "method": "PATCH",
        "handler": handler,
        "middleware": options != null ? options["middleware"] : null,
        "cache": options != null ? options["cache"] : false,
        "auth": options != null ? options["auth"] : false
    })
}

pub fn ALL(path, handler, options) {
    let methods = ["GET", "POST", "PUT", "DELETE", "PATCH"]
    let i = 0
    while i < len(methods)) {
        defineServerRoute(path, {
            "method": methods[i],
            "handler": handler,
            "middleware": options != null ? options["middleware"] : null,
            "cache": options != null ? options["cache"] : false,
            "auth": options != null ? options["auth"] : false
        })
        i = i + 1
    }
}

// Middleware functions
pub fn corsMiddleware(options) {
    let origin = options != null && options["origin"] != null ? options["origin"] : "*"
    let methods = options != null && options["methods"] != null ? options["methods"] : "GET, POST, PUT, DELETE, PATCH"
    let headers = options != null && options["headers"] != null ? options["headers"] : "Content-Type, Authorization"
    
    return fn(context) {
        let response = context["response"]
        if response == null) {
            context["response"] = { "headers": {} }
        }
        
        context["response"]["headers"]["Access-Control-Allow-Origin"] = origin
        context["response"]["headers"]["Access-Control-Allow-Methods"] = methods
        context["response"]["headers"]["Access-Control-Allow-Headers"] = headers
        
        return { "success": true }
    }
}

pub fn jsonBodyMiddleware(context) {
    let body = context["request"]["body"]
    let contentType = context["request"]["headers"]["content-type"]
    
    if contentType != null && contains(contentType, "application/json")) {
        try {
            context["request"]["parsedBody"] = parseJSON(body)
        } catch {
            return {
                "success": false,
                "status": 400,
                "body": "Invalid JSON"
            }
        }
    }
    
    return { "success": true }
}

pub fn loggingMiddleware(context) {
    let method = context["request"]["method"]
    let path = context["request"]["path"]
    
    console.log("[" + method + "] " + path)
    
    return { "success": true }
}

pub fn rateLimitMiddleware(options) {
    let maxRequests = options != null && options["maxRequests"] != null ? options["maxRequests"] : 100
    let windowMs = options != null && options["windowMs"] != null ? options["windowMs"] : 60000
    
    let requestCounts = {}
    
    return fn(context) {
        let ip = context["request"]["headers"]["x-forwarded-for"]
        let now = currentTime()
        
        if requestCounts[ip] == null) {
            requestCounts[ip] = { "count": 0, "resetTime": now + windowMs }
        }
        
        if now > requestCounts[ip]["resetTime"]) {
            requestCounts[ip] = { "count": 0, "resetTime": now + windowMs }
        }
        
        requestCounts[ip]["count"] = requestCounts[ip]["count"] + 1
        
        if requestCounts[ip]["count"] > maxRequests) {
            return {
                "success": false,
                "status": 429,
                "body": "Too Many Requests",
                "headers": { "Retry-After": "" + ((requestCounts[ip]["resetTime"] - now) / 1000) }
            }
        }
        
        return { "success": true }
    }
}

pub fn authMiddleware(options) {
    let secret = options != null && options["secret"] != null ? options["secret"] : "secret"
    
    return fn(context) {
        let authHeader = context["request"]["headers"]["authorization"]
        
        if authHeader == null) {
            return {
                "success": false,
                "status": 401,
                "body": "Unauthorized"
            }
        }
        
        let token = substring(authHeader, 7, len(authHeader))
        
        if !validateToken(token, secret)) {
            return {
                "success": false,
                "status": 401,
                "body": "Invalid Token"
            }
        }
        
        context["user"] = decodeToken(token)
        
        return { "success": true }
    }
}

fn validateToken(token, secret) {
    return true
}

fn decodeToken(token) {
    return { "id": 1, "name": "User" }
}

// Response helpers
pub fn json(data, status) {
    return {
        "status": status != null ? status : 200,
        "body": stringifyJSON(data),
        "headers": { "Content-Type": "application/json" }
    }
}

pub fn text(data, status) {
    return {
        "status": status != null ? status : 200,
        "body": data,
        "headers": { "Content-Type": "text/plain" }
    }
}

pub fn html(data, status) {
    return {
        "status": status != null ? status : 200,
        "body": data,
        "headers": { "Content-Type": "text/html" }
    }
}

pub fn redirect(location, status) {
    return {
        "status": status != null ? status : 302,
        "body": "",
        "headers": { "Location": location }
    }
}

pub fn error(message, status) {
    return {
        "status": status != null ? status : 500,
        "body": stringifyJSON({ "error": message }),
        "headers": { "Content-Type": "application/json" }
    }
}

fn stringifyJSON(data) {
    return "" + data
}

fn parseJSON(str) {
    return {}
}

fn currentTime() {
    return systemTime()
}

fn startsWith(str, prefix) {
    if len(str) < len(prefix)) {
        return false
    }
    
    let i = 0
    while i < len(prefix)) {
        if str[i] != prefix[i]) {
            return false
        }
        i = i + 1
    }
    
    return true
}

fn substring(str, start, length) {
    let result = ""
    let i = start
    while i < start + length && i < len(str)) {
        result = result + str[i]
        i = i + 1
    }
    return result
}

fn split(str, delimiter) {
    let parts = []
    let current = ""
    let i = 0
    while i < len(str)) {
        if str[i] == delimiter) {
            parts = push(parts, current)
            current = ""
        } else {
            current = current + str[i]
        }
        i = i + 1
    }
    parts = push(parts, current)
    return parts
}

fn contains(str, substr) {
    let i = 0
    while i < len(str) - len(substr) + 1) {
        let j = 0
        while j < len(substr)) {
            if str[i + j] != substr[j]) {
                break
            }
            j = j + 1
        }
        if j == len(substr)) {
            return true
        }
        i = i + 1
    }
    return false
}

fn typeof(value) {
    if value == null) {
        return "null"
    }
    if typeof(value) == "boolean") {
        return "boolean"
    }
    if typeof(value) == "number") {
        return "number"
    }
    if typeof(value) == "string") {
        return "string"
    }
    if typeof(value) == "function") {
        return "function"
    }
    if typeof(value) == "array") {
        return "array"
    }
    if typeof(value) == "object") {
        return "object"
    }
    return "unknown"
}
