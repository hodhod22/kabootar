@version "1.0.0"

// Negin Server Routing - Server-side routing for Negin
// Features: Route handlers, middleware, request/response handling
// Canonical path: import "negin/server-routing"

import "negin/core"
import "negin/routing"
import "negin/kabootar-integration"

let serverRoutes = {}
let globalMiddleware = []

pub fn defineServerRoute(path, config) {
    let method = config["method"] != null ? config["method"] : "GET"
    let handler = config["handler"]
    let middleware = config["middleware"]
    let cache = config["cache"]
    let auth = config["auth"]
    
    let route = {
        "kind": "ServerRoute",
        "path": path,
        "method": method,
        "handler": handler,
        "middleware": middleware != null ? middleware : [],
        "cache": cache,
        "auth": auth,
        "params": extractParams(path)
    }
    
    let routeKey = method + ":" + path
    serverRoutes[routeKey] = route
    
    return route
}

pub fn addGlobalMiddleware(middleware) {
    globalMiddleware = push(globalMiddleware, middleware)
}

pub fn handleServerRequest(request) {
    let method = request["method"]
    let path = request["path"]
    let headers = request["headers"]
    let body = request["body"]
    let query = request["query"]
    
    let routeKey = method + ":" + path
    let route = serverRoutes[routeKey]
    
    if route == null) {
        // Try to match with dynamic routes
        route = matchServerRoute(method, path)
    }
    
    if route == null) {
        return {
            "status": 404,
            "body": "Not Found",
            "headers": {}
        }
    }
    
    let context = {
        "request": request,
        "response": null,
        "params": extractParamsFromPath(path, route["path"]),
        "query": query,
        "headers": headers,
        "body": body
    }
    
    // Execute global middleware
    let middlewareResult = executeMiddleware(globalMiddleware, context)
    if middlewareResult["success"] == false) {
        return middlewareResult
    }
    
    // Execute route middleware
    let routeMiddlewareResult = executeMiddleware(route["middleware"], context)
    if routeMiddlewareResult["success"] == false) {
        return routeMiddlewareResult
    }
    
    // Check auth if required
    if route["auth"] == true) {
        let authResult = checkAuth(request)
        if authResult["success"] == false) {
            return {
                "status": 401,
                "body": "Unauthorized",
                "headers": {}
            }
        }
    }
    
    // Check cache if enabled
    if route["cache"] == true) {
        let cached = getFromCache(method, path)
        if cached != null) {
            return {
                "status": 200,
                "body": cached,
                "headers": { "X-Cache": "HIT" }
            }
        }
    }
    
    // Execute handler
    let result = route["handler"](context)
    
    // Cache result if enabled
    if route["cache"] == true && result["status"] == 200) {
        setCache(method, path, result["body"])
    }
    
    return result
}

fn matchServerRoute(method, path) {
    for routeKey in serverRoutes) {
        let route = serverRoutes[routeKey]
        if route["method"] == method) {
            let match = matchPath(route["path"], path)
            if match != null) {
                return route
            }
        }
    }
    return null
}

fn extractParamsFromPath(requestPath, routePath) {
    let match = matchPath(routePath, requestPath)
    if match != null) {
        return match["params"]
    }
    return {}
}

fn extractParams(path) {
    let params = []
    let segments = split(path, "/")
    
    let i = 0
    while i < len(segments)) {
        if startsWith(segments[i], ":")) {
            params = push(params, substring(segments[i], 1, len(segments[i])))
        }
        i = i + 1
    }
    
    return params
}

fn executeMiddleware(middleware, context) {
    let i = 0
    while i < len(middleware)) {
        let result = middleware[i](context)
        if result != null && result["success"] == false) {
            return result
        }
        i = i + 1
    }
    return { "success": true }
}

fn checkAuth(request) {
    let authHeader = request["headers"]["authorization"]
    
    if authHeader == null) {
        return { "success": false }
    }
    
    // Validate auth token
    return { "success": true }
}

fn getFromCache(method, path) {
    let cacheKey = method + ":" + path
    // Return cached value if exists
    return null
}

fn setCache(method, path, value) {
    let cacheKey = method + ":" + path
    // Cache the value
}

pub fn createServerRouter(config) {
    let port = config["port"] != null ? config["port"] : 3000
    let host = config["host"] != null ? config["host"] : "localhost"
    
    return {
        "kind": "ServerRouter",
        "host": host,
        "port": port,
        "routes": serverRoutes,
        "middleware": globalMiddleware,
        "handle": handleServerRequest,
        "addRoute": defineServerRoute,
        "addMiddleware": addGlobalMiddleware
    }
}

pub fn GET(path, handler, options) {
    return defineServerRoute(path, {
        "method": "GET",
        "handler": handler,
        "middleware": options != null ? options["middleware"] : null,
        "cache": options != null ? options["cache"] : false,
        "auth": options != null ? options["auth"] : false
    })
}

pub fn POST(path, handler, options) {
    return defineServerRoute(path, {
        "method": "POST",
        "handler": handler,
        "middleware": options != null ? options["middleware"] : null,
        "cache": options != null ? options["cache"] : false,
        "auth": options != null ? options["auth"] : false
    })
}

pub fn PUT(path, handler, options) {
    return defineServerRoute(path, {
        "method": "PUT",
