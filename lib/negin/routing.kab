@version "1.0.0"

// Negin Routing - TanStack Start-like routing system optimized for Kabootar
// Features: File-based routing, loaders, actions, SSR, preloading, code splitting
// Canonical path: import "negin/routing"

import "negin/core"
import "negin/hooks"
import "negin/ssr-optimized"
import "negin/query-database"

// File-based routing structure
let fileRoutes = {}
let routeTree = {}
let routeLoaders = {}
let routeActions = {}
let routeMeta = {}
let preloadedData = {}

// TanStack Start-like route configuration
pub fn createFileRoute(path, config) {
    let component = config["component"]
    let loader = config["loader"]
    let action = config["action"]
    let meta = config["meta"]
    let preload = config["preload"] != null ? config["preload"] : true
    let ssr = config["ssr"] != null ? config["ssr"] : true
    let staleTime = config["staleTime"]
    let gcTime = config["gcTime"]
    
    let route = {
        "kind": "FileRoute",
        "path": path,
        "component": component,
        "loader": loader,
        "action": action,
        "meta": meta != null ? meta : {},
        "preload": preload,
        "ssr": ssr,
        "staleTime": staleTime,
        "gcTime": gcTime,
        "params": extractParams(path),
        "id": pathToId(path)
    }
    
    fileRoutes[path] = route
    routeLoaders[path] = loader
    routeActions[path] = action
    routeMeta[path] = meta
    
    return route
}

pub fn createRouteTree(routes) {
    let tree = { "kind": "RouteTree", "children": {} }
    
    for path in routes) {
        let route = routes[path]
        let segments = splitPath(path)
        let currentNode = tree
        
        let i = 0
        while i < len(segments)) {
            let segment = segments[i]
            
            if currentNode["children"][segment] == null) {
                currentNode["children"][segment] = {
                    "kind": "RouteNode",
                    "segment": segment,
                    "children": {},
                    "route": i == len(segments) - 1 ? route : null
                }
            }
            
            currentNode = currentNode["children"][segment]
            i = i + 1
        }
    }
    
    routeTree = tree
    return tree
}

fn pathToId(path) {
    return replaceAll(path, "/", "_")
}

fn replaceAll(str, search, replacement) {
    let result = str
    while contains(result, search)) {
        let index = indexOf(result, search)
        result = substring(result, 0, index) + replacement + substring(result, index + len(search), len(result))
    }
    return result
}

fn extractParams(path) {
    let params = []
    let segments = split(path, "/")
    
    let i = 0
    while i < len(segments)) {
        if startsWith(segments[i], ":")) {
            params = push(params, substring(segments[i], 1, len(segments[i])))
        }
        i = i + 1
    }
    
    return params
}

// TanStack Start-like loader execution
pub fn executeLoader(path, params, context) {
    let loader = routeLoaders[path]
    
    if loader == null) {
        return { "success": true, "data": null }
    }
    
    return loader(params, context)
}

// TanStack Start-like action execution
pub fn executeAction(path, params, context) {
    let action = routeActions[path]
    
    if action == null) {
        return { "success": false, "error": "No action defined" }
    }
    
    return action(params, context)
}

// Preload route data
pub fn preloadRoute(path, params) {
    let route = fileRoutes[path]
    
    if route == null || route["preload"] == false) {
        return null
    }
    
    let loader = routeLoaders[path]
    if loader != null) {
        let data = executeLoader(path, params, {})
        preloadedData[path] = data
        return data
    }
    
    return null
}

// Get preloaded data
pub fn getPreloadedData(path) {
    return preloadedData[path]
}

// Clear preloaded data
pub fn clearPreloadedData(path) {
    if path != null) {
        preloadedData[path] = null
    } else {
        preloadedData = {}
    }
}

// Match route with TanStack Start-like matching
pub fn matchRoute(path) {
    for routePath in fileRoutes) {
        let match = matchPath(routePath, path)
        if match != null) {
            return {
                "route": fileRoutes[routePath],
                "params": match["params"],
                "id": fileRoutes[routePath]["id"]
            }
        }
    }
    
    return null
}

fn matchPath(routePath, currentPath) {
    if routePath == currentPath) {
        return { "params": {} }
    }
    
    if routePath == "*") {
        return { "params": {} }
    }
    
    let routeSegments = splitPath(routePath)
    let currentSegments = splitPath(currentPath)
    
    if len(routeSegments) != len(currentSegments)) {
        return null
    }
    
    let params = {}
    let i = 0
    while i < len(routeSegments)) {
        let routeSegment = routeSegments[i]
        let currentSegment = currentSegments[i]
        
        if startsWith(routeSegment, ":")) {
            let paramName = substring(routeSegment, 1, len(routeSegment))
            params[paramName] = currentSegment
        } else if routeSegment != currentSegment) {
            return null
        }
        
        i = i + 1
    }
    
    return { "params": params }
}

// TanStack Start-like Router component
pub fn Router(props) {
    let routes = props["routes"]
    let fallback = props["fallback"]
    
    let (currentPath, setCurrentPath] = useState(getCurrentPath())
    let (loaderData, setLoaderData] = useState(null)
    let (isLoading, setIsLoading] = useState(false)
    
    let matched = matchRoute(currentPath)
    
    useEffect(fn() {
        if matched != null) {
            let route = matched["route"]
            
            if route["loader"] != null) {
                setIsLoading(true)
                let data = executeLoader(matched["id"], matched["params"], {})
                setLoaderData(data)
                setIsLoading(false)
            }
        }
    }, [currentPath])
    
    if matched == null) {
        return fallback != null ? fallback : createElement("div", {}, "404 Not Found")
    }
    
    let route = matched["route"]
    let params = matched["params"]
    
    if isLoading) {
        return createElement("div", {}, "Loading...")
    }
    
    if route["component"] != null) {
        return createElement(route["component"], { 
            "params": params,
            "loaderData": loaderData
        })
    }
    
    return createElement("div", {}, "No component")
}

// TanStack Start-like hooks
pub fn useLoaderData() {
    let (data, setData] = useState(null)
    
    useEffect(fn() {
        let matched = matchRoute(getCurrentPath())
        if matched != null) {
            let route = matched["route"]
            if route["loader"] != null) {
                let result = executeLoader(matched["id"], matched["params"], {})
                setData(result)
            }
        }
    }, [])
    
    return data
}

pub fn useRouteMatches() {
    let (matches, setMatches] = useState([])
    
    useEffect(fn() {
        let currentPath = getCurrentPath()
        let matched = matchRoute(currentPath)
        if matched != null) {
            setMatches([matched])
        }
    }, [])
    
    return matches
}

pub fn useNavigate() {
    let (currentPath, setCurrentPath] = useState(getCurrentPath())
    
    let navigate = fn(path, options) {
        let matched = matchRoute(path)
        if matched != null) {
            setCurrentPath(path)
            
            if options != null && options["preload"] == true) {
                preloadRoute(path, matched["params"])
            }
        }
    }
    
    return navigate
}

pub fn useParams() {
    let (params, setParams] = useState({})
    
    useEffect(fn() {
        let matched = matchRoute(getCurrentPath())
        if matched != null) {
            setParams(matched["params"])
        }
    }, [])
    
    return params
}

pub fn useSearch() {
    let (search, setSearch] = useState({})
    return [search, setSearch]
}

pub fn useLinkProps(to, options) {
    let navigate = useNavigate()
    
    return {
        "href": to,
        "onClick": fn(event) {
            event["preventDefault"]()
            navigate(to, options)
        }
    }
}

// TanStack Start-like Link component
pub fn Link(props) {
    let to = props["to"]
    let children = props["children"]
    let preload = props["preload"] != null ? props["preload"] : false
    let options = { "preload": preload }
    
    let linkProps = useLinkProps(to, options)
    
    let handleMouseEnter = fn() {
        if preload) {
            let matched = matchRoute(to)
            if matched != null) {
                preloadRoute(to, matched["params"])
            }
        }
    }
    
    return createElement("a", {
        "href": to,
        "onClick": linkProps["onClick"],
        "onMouseEnter": handleMouseEnter
    }, children)
}

// TanStack Start-like Navigate component
pub fn Navigate(props) {
    let to = props["to"]
    let navigate = useNavigate()
    
    useEffect(fn() {
        navigate(to)
    }, [to])
    
    return null
}

// SSR rendering with TanStack Start-like approach
pub fn renderRouteSSR(path, context) {
    let matched = matchRoute(path)
    
    if matched == null) {
        return { "html": "404 Not Found", "data": null }
    }
    
    let route = matched["route"]
    let params = matched["params"]
    
    let loaderData = null
    if route["loader"] != null) {
        loaderData = executeLoader(matched["id"], params, context)
    }
    
    let html = null
    if route["component"] != null) {
        let element = createElement(route["component"], {
            "params": params,
            "loaderData": loaderData
        })
        html = renderToStringOptimized(element)
    }
    
    return {
        "html": html,
        "data": loaderData,
        "route": route,
        "params": params
    }
}

// TanStack Start-like createRouter
pub fn createRouter(config) {
    let routes = config["routes"] != null ? config["routes"] : fileRoutes
    
    return {
        "kind": "TanStackRouter",
        "routes": routes,
        "match": fn(path) {
            return matchRoute(path)
        },
        "navigate": fn(path, options) {
            return navigate(path, options)
        },
        "preload": fn(path, params) {
            return preloadRoute(path, params)
        }
    }
}

// TanStack Start-like createRouteConfig
pub fn createRouteConfig(path, config) {
    return createFileRoute(path, config)
}

// TanStack Start-like createRootRoute
pub fn createRootRoute(config) {
    return createFileRoute("/", config)
}

// TanStack Start-like createRoute
pub fn createRoute(path, config) {
    return createFileRoute(path, config)
}

// TanStack Start-like lazy route loading
pub fn lazyRoute(importFn) {
    let (component, setComponent] = useState(null)
    let (loading, setLoading] = useState(true)
    
    useEffect(fn() {
        importFn().then(fn(module) {
            setComponent(module["default"])
            setLoading(false)
        })
    }, [])
    
    return {
        "component": component,
        "loading": loading
    }
}

// TanStack Start-like route meta
pub fn useRouteMeta() {
    let (meta, setMeta] = useState({})
    
    useEffect(fn() {
        let matched = matchRoute(getCurrentPath())
        if matched != null) {
            setMeta(matched["route"]["meta"])
        }
    }, [])
    
    return meta
}

// TanStack Start-like redirect
pub fn redirect(to) {
    return {
        "kind": "Redirect",
        "to": to
    }
}

// TanStack Start-like notFound
pub fn notFound() {
    return {
        "kind": "NotFound"
    }
}

// TanStack Start-like defer
pub fn defer(promise) {
    return {
        "kind": "Deferred",
        "promise": promise
    }
}

// Helper functions
fn contains(str, substr) {
    let i = 0
    while i < len(str) - len(substr) + 1) {
        let j = 0
        while j < len(substr)) {
            if str[i + j] != substr[j]) {
                break
            }
            j = j + 1
        }
        if j == len(substr)) {
            return true
        }
        i = i + 1
    }
    return false
}

fn indexOf(str, substr) {
    let i = 0
    while i < len(str) - len(substr) + 1) {
        let j = 0
        while j < len(substr)) {
            if str[i + j] != substr[j]) {
                break
            }
            j = j + 1
        }
        if j == len(substr)) {
            return i
        }
        i = i + 1
    }
    return -1
}

fn splitPath(path) {
    let segments = []
    let parts = split(path, "/")
    
    let i = 0
    while i < len(parts)) {
        if parts[i] != "") {
            segments = push(segments, parts[i])
        }
        i = i + 1
    }
    
    return segments
}

fn startsWith(str, prefix) {
    if len(str) < len(prefix)) {
        return false
    }
    
    let i = 0
    while i < len(prefix)) {
        if str[i] != prefix[i]) {
            return false
        }
        i = i + 1
    }
    
    return true
}

fn substring(str, start, length) {
    let result = ""
    let i = start
    while i < start + length && i < len(str)) {
        result = result + str[i]
        i = i + 1
    }
    return result
}

fn split(str, delimiter) {
    let parts = []
    let current = ""
    let i = 0
    while i < len(str)) {
        if str[i] == delimiter) {
            parts = push(parts, current)
            current = ""
        } else {
            current = current + str[i]
        }
        i = i + 1
    }
    parts = push(parts, current)
    return parts
}

fn getCurrentPath() {
    return "/"
}

fn renderToStringOptimized(element) {
    return "<div>Rendered</div>"
}

fn typeof(value) {
    if value == null) {
        return "null"
    }
    if typeof(value) == "boolean") {
        return "boolean"
    }
    if typeof(value) == "number") {
        return "number"
    }
    if typeof(value) == "string") {
        return "string"
    }
    if typeof(value) == "function") {
        return "function"
    }
    if typeof(value) == "array") {
        return "array"
    }
    if typeof(value) == "object") {
        return "object"
    }
    return "unknown"
}
