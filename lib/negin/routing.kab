@version "1.0.0"

// Negin Routing - Advanced routing system optimized for Kabootar
// Features: Server-side routing, API routes, database integration, route selection
// Canonical path: import "negin/routing"

import "negin/core"
import "negin/hooks"

// Route types
let ROUTE_TYPES = {
    "CLIENT": "client",
    "SERVER": "server",
    "API": "api",
    "DATABASE": "database",
    "HYBRID": "hybrid"
}

let routes = {}
let routeGroups = {}
let activeRouteType = ROUTE_TYPES["HYBRID"]

pub fn defineRoute(path, config) {
    let routeType = config["type"] != null ? config["type"] : ROUTE_TYPES["CLIENT"]
    let component = config["component"]
    let handler = config["handler"]
    let database = config["database"]
    let middleware = config["middleware"]
    let cache = config["cache"]
    let ssr = config["ssr"] != null ? config["ssr"] : true
    
    let route = {
        "kind": "Route",
        "path": path,
        "type": routeType,
        "component": component,
        "handler": handler,
        "database": database,
        "middleware": middleware != null ? middleware : [],
        "cache": cache,
        "ssr": ssr,
        "params": extractParams(path),
        "meta": config["meta"] != null ? config["meta"] : {}
    }
    
    routes[path] = route
    
    return route
}

pub fn defineRouteGroup(name, config) {
    let prefix = config["prefix"]
    let routesConfig = config["routes"]
    let middleware = config["middleware"]
    let type = config["type"] != null ? config["type"] : ROUTE_TYPES["CLIENT"]
    
    let group = {
        "kind": "RouteGroup",
        "name": name,
        "prefix": prefix,
        "type": type,
        "middleware": middleware != null ? middleware : [],
        "routes": []
    }
    
    let i = 0
    while i < len(routesConfig)) {
        let routeConfig = routesConfig[i]
        let fullPath = prefix + routeConfig["path"]
        
        let route = defineRoute(fullPath, {
            ...routeConfig,
            "type": type,
            "middleware": [...middleware, ...(routeConfig["middleware"] != null ? routeConfig["middleware"] : [])]
        })
        
        group["routes"] = push(group["routes"], route)
        i = i + 1
    }
    
    routeGroups[name] = group
    
    return group
}

fn extractParams(path) {
    let params = []
    let segments = split(path, "/")
    
    let i = 0
    while i < len(segments)) {
        if startsWith(segments[i], ":")) {
            params = push(params, substring(segments[i], 1, len(segments[i])))
        }
        i = i + 1
    }
    
    return params
}

pub fn setRouteType(routeType) {
    activeRouteType = routeType
}

pub fn getRouteType() {
    return activeRouteType
}

pub fn getRoute(path) {
    return routes[path]
}

pub fn getAllRoutes() {
    return routes
}

pub fn getRoutesByType(routeType) {
    let filtered = {}
    
    for path in routes) {
        if routes[path]["type"] == routeType) {
            filtered[path] = routes[path]
        }
    }
    
    return filtered
}

pub fn matchRoute(path, routeType) {
    let targetRoutes = routeType != null ? getRoutesByType(routeType) : routes
    
    for routePath in targetRoutes) {
        let match = matchPath(routePath, path)
        if match != null) {
            return {
                "route": targetRoutes[routePath],
                "params": match["params"]
            }
        }
    }
    
    return null
}

fn matchPath(routePath, currentPath) {
    if routePath == currentPath) {
        return { "params": {} }
    }
    
    if routePath == "*") {
        return { "params": {} }
    }
    
    let routeSegments = splitPath(routePath)
    let currentSegments = splitPath(currentPath)
    
    if len(routeSegments) != len(currentSegments)) {
        return null
    }
    
    let params = {}
    let i = 0
    while i < len(routeSegments)) {
        let routeSegment = routeSegments[i]
        let currentSegment = currentSegments[i]
        
        if startsWith(routeSegment, ":")) {
            let paramName = substring(routeSegment, 1, len(routeSegment))
            params[paramName] = currentSegment
        } else if routeSegment != currentSegment) {
            return null
        }
        
        i = i + 1
    }
    
    return { "params": params }
}

pub fn createRouter(config) {
    let defaultRouteType = config["defaultType"] != null ? config["defaultType"] : ROUTE_TYPES["HYBRID"]
    let fallback = config["fallback"]
    
    return {
        "kind": "Router",
        "defaultType": defaultRouteType,
        "fallback": fallback,
        "currentPath": "/",
        "match": fn(path, routeType) {
            return matchRoute(path, routeType != null ? routeType : defaultRouteType)
        },
        "navigate": fn(path, options) {
            return navigate(path, options)
        }
    }
}

pub fn navigate(path, options) {
    let routeType = options != null && options["type"] != null ? options["type"] : activeRouteType
    let replace = options != null && options["replace"] == true
    let state = options != null ? options["state"] : null
    
    let matched = matchRoute(path, routeType)
    
    if matched == null) {
        return { "success": false, "error": "Route not found" }
    }
    
    let route = matched["route"]
    let params = matched["params"]
    
    if route["type"] == ROUTE_TYPES["SERVER"] || route["type"] == ROUTE_TYPES["API"]) {
        return executeServerRoute(route, params, state)
    }
    
    if route["type"] == ROUTE_TYPES["DATABASE"]) {
        return executeDatabaseRoute(route, params, state)
    }
    
    return {
        "success": true,
        "route": route,
        "params": params,
        "type": route["type"]
    }
}

pub fn executeServerRoute(route, params, state) {
    if route["handler"] == null) {
        return { "success": false, "error": "No handler defined" }
    }
    
    let middlewareResult = executeMiddleware(route["middleware"], params, state)
    if middlewareResult["success"] == false) {
        return middlewareResult
    }
    
    return route["handler"](params, state)
}

pub fn executeDatabaseRoute(route, params, state) {
    if route["database"] == null) {
        return { "success": false, "error": "No database defined" }
    }
    
    let middlewareResult = executeMiddleware(route["middleware"], params, state)
    if middlewareResult["success"] == false) {
        return middlewareResult
    }
    
    return executeDatabaseQuery(route["database"], params)
}

fn executeMiddleware(middleware, params, state) {
    let i = 0
    while i < len(middleware)) {
        let result = middleware[i](params, state)
        if result != null && result["success"] == false) {
            return result
        }
        i = i + 1
    }
    return { "success": true }
}

pub fn executeDatabaseQuery(databaseConfig, params) {
    let table = databaseConfig["table"]
    let operation = databaseConfig["operation"]
    let query = databaseConfig["query"]
    
    return {
        "success": true,
        "table": table,
        "operation": operation,
        "query": query,
        "params": params
    }
}

pub fn createAPIRoute(path, handler, options) {
    let method = options != null && options["method"] != null ? options["method"] : "GET"
    let middleware = options != null ? options["middleware"] : null
    
    return defineRoute(path, {
        "type": ROUTE_TYPES["API"],
        "handler": handler,
        "middleware": middleware != null ? middleware : [],
        "meta": { "method": method }
    })
}

pub fn createServerRoute(path, handler, options) {
    let ssr = options != null && options["ssr"] == true
    
    return defineRoute(path, {
        "type": ROUTE_TYPES["SERVER"],
        "handler": handler,
        "ssr": ssr
    })
}

pub fn createDatabaseRoute(path, databaseConfig, options) {
    return defineRoute(path, {
        "type": ROUTE_TYPES["DATABASE"],
        "database": databaseConfig
    })
}

pub fn createClientRoute(path, component, options) {
    let ssr = options != null && options["ssr"] == true
    
    return defineRoute(path, {
        "type": ROUTE_TYPES["CLIENT"],
        "component": component,
        "ssr": ssr
    })
}

pub fn createHybridRoute(path, config) {
    return defineRoute(path, {
        "type": ROUTE_TYPES["HYBRID"],
        ...config
    })
}

pub fn Router(props) {
    let routes = props["routes"]
    let fallback = props["fallback"]
    let routeType = props["routeType"] != null ? props["routeType"] : activeRouteType
    
    let (currentPath, setCurrentPath] = useState(getCurrentPath())
    
    let matched = matchRoute(currentPath, routeType)
    
    if matched == null) {
        return fallback != null ? fallback : createElement("div", {}, "404 Not Found")
    }
    
    let route = matched["route"]
    let params = matched["params"]
    
    if route["type"] == ROUTE_TYPES["CLIENT"] || route["type"] == ROUTE_TYPES["HYBRID"]) {
        if route["component"] != null) {
            return createElement(route["component"], { "params": params })
        }
    }
    
    return createElement("div", {}, "Route type: " + route["type"])
}

pub fn useRoute(path) {
    let matched = matchRoute(path, activeRouteType)
    return matched
}

pub fn useParams() {
    let (params, setParams] = useState({})
    
    useEffect(fn() {
        let matched = matchRoute(getCurrentPath(), activeRouteType)
        if matched != null) {
            setParams(matched["params"])
        }
    }, [])
    
    return params
}

pub fn useRouteType() {
    return activeRouteType
}

pub fn useNavigate() {
    return navigate
}

pub fn getCurrentPath() {
    return "/"
}

pub function splitPath(path) {
    let segments = []
    let parts = split(path, "/")
    
    let i = 0
    while i < len(parts)) {
        if parts[i] != "") {
            segments = push(segments, parts[i])
        }
        i = i + 1
    }
    
    return segments
}

fn startsWith(str, prefix) {
    if len(str) < len(prefix)) {
        return false
    }
    
    let i = 0
    while i < len(prefix)) {
        if str[i] != prefix[i]) {
            return false
        }
        i = i + 1
    }
    
    return true
}

fn substring(str, start, length) {
    let result = ""
    let i = start
    while i < start + length && i < len(str)) {
        result = result + str[i]
        i = i + 1
    }
    return result
}

fn split(str, delimiter) {
    let parts = []
    let current = ""
    let i = 0
    while i < len(str)) {
        if str[i] == delimiter) {
            parts = push(parts, current)
            current = ""
        } else {
            current = current + str[i]
        }
        i = i + 1
    }
    parts = push(parts, current)
    return parts
}

fn typeof(value) {
    if value == null) {
        return "null"
    }
    if typeof(value) == "boolean") {
        return "boolean"
    }
    if typeof(value) == "number") {
        return "number"
    }
    if typeof(value) == "string") {
        return "string"
    }
    if typeof(value) == "function") {
        return "function"
    }
    if typeof(value) == "array") {
        return "array"
    }
    if typeof(value) == "object") {
        return "object"
    }
    return "unknown"
}
