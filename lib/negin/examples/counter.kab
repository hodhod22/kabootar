@version "1.0.0"

// Negin Counter Example with Signals
// Demonstrates signal-based reactivity (better than useState)

import "negin/core"
import "negin/reactive-core"

pub fn Counter() {
    let count = signal(0)
    
    return createElement("div", { "className": "counter" },
        createElement("h2", {}, "Counter with Signals"),
        createElement("div", { "className": "counter-display" },
            createElement("button", { 
                "onClick": fn() { count["set"](count["get"]() - 1) },
                "className": "counter-button"
            }, "-"),
            createElement("span", { "className": "counter-value" }, count["get"]()),
            createElement("button", { 
                "onClick": fn() { count["set"](count["get"]() + 1) },
                "className": "counter-button"
            }, "+")
        ),
        createElement("p", {}, "Count: " + count["get"]())
    )
}

// Render the counter
let container = { 
    "kind": "Container", 
    "children": [] 
}

render(createElement(Counter, {}), container)
