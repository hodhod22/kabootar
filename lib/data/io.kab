@version "1.0.0"

// data/io — CSV / JSON / Parquet → DataFrame (pandas-like read_*).
// Uses df_* natives directly (no import of data/frame — avoids cycles with import "data").

import "science"

fn toRowsLocal(df) {
    let names = df["names"]
    let cols = df["columns"]
    let n = df["nrows"]
    let rows = []
    let i = 0
    while i < n {
        let row = {}
        let j = 0
        while j < len(names) {
            let name = names[j]
            row[name] = cols[name][i]
            j = j + 1
        }
        rows = push(rows, row)
        i = i + 1
    }
    return rows
}

fn fromRowsLocal(rows) {
    if rows == null || rows == undefined || len(rows) == 0 {
        return df_from({ "_": [] })
    }
    let keys = object_keys(rows[0])
    let cols = {}
    let k = 0
    while k < len(keys) {
        cols[keys[k]] = []
        k = k + 1
    }
    let i = 0
    while i < len(rows) {
        let row = rows[i]
        k = 0
        while k < len(keys) {
            let key = keys[k]
            let series = cols[key]
            if series == null || series == undefined {
                series = []
            }
            series = push(series, row[key])
            cols[key] = series
            k = k + 1
        }
        i = i + 1
    }
    return df_from(cols)
}

/// Parse CSV text → DataFrame. First row = header unless opts.header == false.
pub fn readCsvText(text, opts) {
    let rows = csv_parse(text)
    return rowsToFrame(rows, opts)
}

/// Load CSV path → DataFrame (VFS/host via os_read).
pub fn readCsv(path, opts) {
    let text = os_read(path)
    return readCsvText(text, opts)
}

fn rowsToFrame(rows, opts) {
    let useHeader = true
    // Avoid opts["header"] when opts is undefined (Invalid index access).
    if opts != null && opts != undefined {
        if opts["header"] == false {
            useHeader = false
        }
    }
    if rows == null || len(rows) == 0 {
        return fromRowsLocal([])
    }
    if useHeader {
        let names = []
        let header = rows[0]
        let j = 0
        while j < len(header) {
            names = push(names, "" + header[j])
            j = j + 1
        }
        let body = []
        let i = 1
        while i < len(rows) {
            body = push(body, rows[i])
            i = i + 1
        }
        return df_from(body, names)
    }
    return df_from(rows)
}

/// JSON text → DataFrame (row objects, row arrays, or column object).
pub fn readJsonText(text) {
    let v = json_parse(text)
    return valueToFrame(v)
}

pub fn readJson(path) {
    let text = os_read(path)
    return readJsonText(text)
}

fn valueToFrame(v) {
    if v == null || v == undefined {
        return fromRowsLocal([])
    }
    if is_array(v) {
        if len(v) == 0 {
            return fromRowsLocal([])
        }
        if is_array(v[0]) {
            return df_from(v)
        }
        return fromRowsLocal(v)
    }
    return df_from(v)
}

pub fn readParquet(path) {
    let rows = parquet_load(path)
    return fromRowsLocal(rows)
}

pub fn writeParquet(path, df) {
    let rows = toRowsLocal(df)
    return parquet_save(path, rows)
}

pub fn writeJson(path, df) {
    let rows = toRowsLocal(df)
    return os_write(path, json_stringify(rows))
}

pub fn writeCsv(path, df) {
    let names = df["names"]
    let cols = df["columns"]
    let n = df["nrows"]
    let text = ""
    let j = 0
    while j < len(names) {
        if j > 0 {
            text = text + ","
        }
        text = text + names[j]
        j = j + 1
    }
    text = text + "\n"
    let i = 0
    while i < n {
        j = 0
        while j < len(names) {
            if j > 0 {
                text = text + ","
            }
            text = text + cols[names[j]][i]
            j = j + 1
        }
        text = text + "\n"
        i = i + 1
    }
    return os_write(path, text)
}

pub fn describe(df) {
    return table_describe(frameRowsAsArrays(df))
}

fn frameRowsAsArrays(df) {
    let names = df["names"]
    let cols = df["columns"]
    let n = df["nrows"]
    let out = []
    let i = 0
    while i < n {
        let row = []
        let j = 0
        while j < len(names) {
            row = push(row, cols[names[j]][i])
            j = j + 1
        }
        out = push(out, row)
        i = i + 1
    }
    return out
}
