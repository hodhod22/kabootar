@version "1.0.0"

// data/frame — pandas-style DataFrame surface over science df_* (SC3f).
// Requires natives from `import "science"` (pulled by `import "data"`).

import "science"

/// Build DataFrame from column object `{col: [...]}` or row arrays + names.
pub fn from(colsOrRows, names) {
    return df_from(colsOrRows, names)
}

pub fn select(df, names) {
    return df_select(df, names)
}

pub fn filter(df, col, op, value) {
    return df_filter(df, col, op, value)
}

/// Group-by aggregate. how: "mean"|"sum"|"count" (df_groupby natives).
pub fn groupby(df, key, agg, how) {
    if how == null {
        how = "mean"
    }
    return df_groupby(df, key, agg, how)
}

pub fn join(left, right, onCol, how) {
    if how == null || how == undefined {
        how = "inner"
    }
    return df_join(left, right, onCol, how)
}

pub fn nrows(df) {
    return df_nrows(df)
}

pub fn head(df, n) {
    return df_head(df, n)
}

pub fn columns(df) {
    return df["names"]
}

fn inferCellType(v) {
    if v == null {
        return "null"
    }
    let t = typeof(v)
    if t == "number" || t == "float" {
        return "float"
    }
    if t == "boolean" || t == "bool" {
        return "bool"
    }
    if t == "string" {
        return "string"
    }
    return "object"
}

/// Infer column dtypes from first non-null cells. Returns `{ col: dtype }`.
pub fn dtypes(df) {
    let names = df["names"]
    let cols = df["columns"]
    let n = df["nrows"]
    let out = {}
    let j = 0
    while j < len(names) {
        let name = names[j]
        let series = cols[name]
        let t = "null"
        let i = 0
        while i < n {
            if series[i] != null {
                t = inferCellType(series[i])
                i = n
            }
            i = i + 1
        }
        out[name] = t
        j = j + 1
    }
    return out
}

/// Attach typed column metadata (`df.schema`) without changing values.
pub fn withSchema(df, schema) {
    if schema == null || schema == undefined {
        schema = dtypes(df)
    }
    df["schema"] = schema
    return df
}

/// Cast a column to float|string|bool (best-effort). Returns new DataFrame.
pub fn cast(df, col, dtype) {
    let names = df["names"]
    let cols = df["columns"]
    let n = df["nrows"]
    let series = cols[col]
    let next = []
    let i = 0
    while i < n {
        let v = series[i]
        if dtype == "float" {
            if v == null {
                next = push(next, null)
            } else {
                next = push(next, 0.0 + v)
            }
        } else {
            if dtype == "string" {
                if v == null {
                    next = push(next, null)
                } else {
                    next = push(next, "" + v)
                }
            } else {
                if dtype == "bool" {
                    next = push(next, v == true || v == 1 || v == 1.0)
                } else {
                    next = push(next, v)
                }
            }
        }
        i = i + 1
    }
    cols[col] = next
    df["columns"] = cols
    let schema = df["schema"]
    if schema == null || schema == undefined {
        schema = dtypes(df)
    }
    schema[col] = dtype
    df["schema"] = schema
    return df
}

/// Convert DataFrame → array of row objects.
pub fn toRows(df) {
    let names = df["names"]
    let cols = df["columns"]
    let n = df["nrows"]
    let rows = []
    let i = 0
    while i < n {
        let row = {}
        let j = 0
        while j < len(names) {
            let name = names[j]
            row[name] = cols[name][i]
            j = j + 1
        }
        rows = push(rows, row)
        i = i + 1
    }
    return rows
}

/// Build DataFrame from array of row objects (shared keys from first row).
pub fn fromRows(rows) {
    if rows == null || len(rows) == 0 {
        return df_from({ "_": [] })
    }
    let keys = object_keys(rows[0])
    let cols = {}
    let k = 0
    while k < len(keys) {
        cols[keys[k]] = []
        k = k + 1
    }
    let i = 0
    while i < len(rows) {
        let row = rows[i]
        k = 0
        while k < len(keys) {
            let key = keys[k]
            let series = cols[key]
            series = push(series, row[key])
            cols[key] = series
            k = k + 1
        }
        i = i + 1
    }
    return df_from(cols)
}

fn cellKey(v) {
    if v == null {
        return "null"
    }
    return "" + v
}

fn aggValues(vals, how) {
    if how == null {
        how = "mean"
    }
    let n = len(vals)
    if n == 0 {
        return 0.0
    }
    if how == "count" {
        return n
    }
    let s = 0.0
    let mn = vals[0]
    let mx = vals[0]
    let i = 0
    while i < n {
        let v = vals[i]
        s = s + v
        if v < mn {
            mn = v
        }
        if v > mx {
            mx = v
        }
        i = i + 1
    }
    if how == "sum" {
        return s
    }
    if how == "min" {
        return mn
    }
    if how == "max" {
        return mx
    }
    return s / n
}

/// Pivot table: index × columns → aggregated values.
/// how: mean|sum|count|min|max (default mean).
pub fn pivot(df, indexCol, columnsCol, valuesCol, how) {
    if how == null {
        how = "mean"
    }
    let rows = toRows(df)
    let indexSeen = {}
    let colSeen = {}
    let buckets = {}
    let i = 0
    while i < len(rows) {
        let row = rows[i]
        let ik = cellKey(row[indexCol])
        let ck = cellKey(row[columnsCol])
        indexSeen[ik] = true
        colSeen[ck] = true
        let bk = ik + "\t" + ck
        let bucket = buckets[bk]
        if bucket == null || bucket == undefined {
            bucket = []
        }
        bucket = push(bucket, row[valuesCol])
        buckets[bk] = bucket
        i = i + 1
    }
    let indexKeys = object_keys(indexSeen)
    let colKeys = object_keys(colSeen)
    let outCols = {}
    outCols[indexCol] = []
    let c = 0
    while c < len(colKeys) {
        outCols[colKeys[c]] = []
        c = c + 1
    }
    let r = 0
    while r < len(indexKeys) {
        let ik = indexKeys[r]
        let idxSeries = outCols[indexCol]
        if idxSeries == null || idxSeries == undefined {
            idxSeries = []
        }
        idxSeries = push(idxSeries, ik)
        outCols[indexCol] = idxSeries
        c = 0
        while c < len(colKeys) {
            let ck = colKeys[c]
            let bucket = buckets[ik + "\t" + ck]
            let series = outCols[ck]
            if series == null || series == undefined {
                series = []
            }
            if bucket == null || bucket == undefined {
                series = push(series, null)
            } else {
                series = push(series, aggValues(bucket, how))
            }
            outCols[ck] = series
            c = c + 1
        }
        r = r + 1
    }
    return df_from(outCols)
}

/// Multi-agg convenience: returns object of DataFrames keyed by how.
pub fn aggregate(df, key, aggCol, hows) {
    if hows == null {
        hows = ["mean", "sum", "count"]
    }
    let out = {}
    let i = 0
    while i < len(hows) {
        let h = hows[i]
        if h == "min" || h == "max" {
            let rows = toRows(df)
            let seen = {}
            let buckets = {}
            let j = 0
            while j < len(rows) {
                let row = rows[j]
                let k = cellKey(row[key])
                seen[k] = true
                let b = buckets[k]
                if b == null || b == undefined {
                    b = []
                }
                b = push(b, row[aggCol])
                buckets[k] = b
                j = j + 1
            }
            let keys = object_keys(seen)
            let keyCol = []
            let valCol = []
            j = 0
            while j < len(keys) {
                let k = keys[j]
                keyCol = push(keyCol, k)
                valCol = push(valCol, aggValues(buckets[k], h))
                j = j + 1
            }
            let cols = {}
            cols[key] = keyCol
            cols[aggCol + "_" + h] = valCol
            out[h] = df_from(cols)
        } else {
            out[h] = df_groupby(df, key, aggCol, h)
        }
        i = i + 1
    }
    return out
}
