@version "1.0.0"

// auth — sessions / password hashing on top of crypto.
// import "auth"

import "crypto"

/// Hash password with argon2 (salt required).
pub fn hashPassword(password, salt) {
    return crypto_argon2(password, salt)
}

/// Compare password to stored hash (re-hash with same salt).
pub fn verifyPassword(password, salt, hash) {
    let h = crypto_argon2(password, salt)
    return h == hash
}

fn tokenFrom(seed) {
    let dig = crypto_sha3_256("" + seed)
    return json_stringify(dig)
}

/// Create a session object for userId.
pub fn createSession(userId, opts) {
    let ttl = 3600
    if opts != null && opts != undefined {
        if opts["ttl"] != null && opts["ttl"] != undefined {
            ttl = opts["ttl"]
        }
    }
    let token = tokenFrom(userId + ":" + ttl + ":kab")
    return {
        "kind": "auth_session",
        "userId": userId,
        "token": token,
        "ttl": ttl,
        "revoked": false
    }
}

pub fn verifySession(session, token) {
    if session == null || session == undefined {
        return false
    }
    if session["revoked"] == true {
        return false
    }
    return session["token"] == token
}

pub fn revokeSession(session) {
    session["revoked"] = true
    return session
}

/// Issue a bearer-like credential map (JWT-shaped stub without crypto JWT).
pub fn issueToken(claims) {
    if claims == null || claims == undefined {
        claims = {}
    }
    let payload = json_stringify(claims)
    let sig = crypto_sha3_256(payload)
    return {
        "kind": "auth_token",
        "mode": "kab-mac",
        "payload": payload,
        "sig": sig
    }
}

pub fn verifyToken(tokenObj) {
    if tokenObj == null || tokenObj == undefined {
        return false
    }
    let expect = crypto_sha3_256(tokenObj["payload"])
    return expect == tokenObj["sig"]
}

pub fn parseClaims(tokenObj) {
    if !verifyToken(tokenObj) {
        return null
    }
    return json_parse(tokenObj["payload"])
}

fn b64url(s) {
    let b = btoa("" + s)
    // JWT base64url: +/ → -_ ; strip =
    let out = ""
    let i = 0
    while i < len(b) {
        let ch = string_slice(b, i, i + 1)
        if ch == "+" {
            out = out + "-"
        } else {
            if ch == "/" {
                out = out + "_"
            } else {
                if ch != "=" {
                    out = out + ch
                }
            }
        }
        i = i + 1
    }
    return out
}

fn digToLatin1(dig) {
    // crypto_sha3_256 returns byte array — pack first 24 bytes into Latin-1 for btoa
    let s = ""
    let n = len(dig)
    if n > 24 {
        n = 24
    }
    let i = 0
    while i < n {
        s = s + from_char_code(dig[i])
        i = i + 1
    }
    return s
}

/// Issue compact JWT-shaped token (HS256-style MAC via SHA3, not full RFC JWT crypto).
pub fn issueJwt(claims, secret) {
    if claims == null || claims == undefined {
        claims = {}
    }
    if secret == null || secret == undefined {
        secret = "kab-dev-secret"
    }
    let header = { "alg": "HS256", "typ": "JWT", "kab": true }
    let h = b64url(json_stringify(header))
    let p = b64url(json_stringify(claims))
    let signing = h + "." + p
    let dig = crypto_sha3_256(signing + "." + secret)
    let sig = b64url(digToLatin1(dig))
    let token = signing + "." + sig
    return {
        "kind": "jwt",
        "mode": "kab-jwt",
        "token": token,
        "header": header,
        "claims": claims
    }
}

/// Verify JWT issued by issueJwt. Returns claims object or null.
pub fn verifyJwt(token, secret) {
    if secret == null || secret == undefined {
        secret = "kab-dev-secret"
    }
    if token == null || token == undefined {
        return null
    }
    let raw = token
    if typeof(token) == "object" {
        raw = token["token"]
    }
    if raw == null || typeof(raw) != "string" {
        return null
    }
    let parts = string_split(raw, ".")
    if len(parts) != 3 {
        return null
    }
    let signing = parts[0] + "." + parts[1]
    let dig = crypto_sha3_256(signing + "." + secret)
    let expect = b64url(digToLatin1(dig))
    if expect != parts[2] {
        return null
    }
    // Decode payload: reverse base64url → atob → json (best-effort via stored claims path)
    // Payload was btoa(json); recover by reconstructing from known issue path is hard without pad.
    // Re-parse: pad and atob.
    let payloadB64 = parts[1]
    payloadB64 = string_replace_all(payloadB64, "-", "+")
    payloadB64 = string_replace_all(payloadB64, "_", "/")
    while len(payloadB64) % 4 != 0 {
        payloadB64 = payloadB64 + "="
    }
    let json = atob(payloadB64)
    return json_parse(json)
}
