@version "1.0.0"

// H2/H6b delete-gate: tag/.class/#id + descendant/comma + > + ~ + [attr] + :not
// import "kdom/query"

import "kstyle/selectors"

fn hasChar(s, ch) {
    let i = 0
    while i < len(s) {
        if char_at(s, i) == ch {
            return true
        }
        i = i + 1
    }
    return false
}

/// Atom: no combinators (space > + ~ ,). Attr / :not allowed.
fn isAtomSelector(sel) {
    if sel == null || sel == undefined {
        return false
    }
    let s = trim("" + sel)
    if len(s) == 0 {
        return false
    }
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == " " || c == ">" || c == "+" || c == "~" || c == "," {
            return false
        }
        i = i + 1
    }
    return true
}

fn splitComma(sel) {
    let parts = []
    let cur = ""
    let i = 0
    let s = "" + sel
    while i < len(s) {
        let c = char_at(s, i)
        if c == "," {
            parts = push(parts, trim(cur))
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    parts = push(parts, trim(cur))
    return parts
}

fn splitSpaces(sel) {
    let parts = []
    let cur = ""
    let i = 0
    let s = "" + sel
    while i < len(s) {
        let c = char_at(s, i)
        if c == " " {
            if len(cur) > 0 {
                parts = push(parts, cur)
                cur = ""
            }
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    if len(cur) > 0 {
        parts = push(parts, cur)
    }
    return parts
}

fn splitByChar(sel, ch) {
    let parts = []
    let cur = ""
    let i = 0
    let s = "" + sel
    while i < len(s) {
        let c = char_at(s, i)
        if c == ch {
            let t = trim(cur)
            if len(t) > 0 {
                parts = push(parts, t)
            }
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    let t = trim(cur)
    if len(t) > 0 {
        parts = push(parts, t)
    }
    return parts
}

fn walkQuery(node, sel) {
    if node == null || node == undefined {
        return null
    }
    if matchesNode(sel, node) {
        return node
    }
    let kids = kdom_children(node)
    let i = 0
    while i < len(kids) {
        let hit = walkQuery(kids[i], sel)
        if hit != null && hit != undefined {
            return hit
        }
        i = i + 1
    }
    return null
}

fn walkQueryAll(node, sel, out) {
    if node == null || node == undefined {
        return out
    }
    if matchesNode(sel, node) {
        out = push(out, node)
    }
    let kids = kdom_children(node)
    let i = 0
    while i < len(kids) {
        out = walkQueryAll(kids[i], sel, out)
        i = i + 1
    }
    return out
}

fn queryDescendant(root, bits) {
    if len(bits) == 0 {
        return null
    }
    if len(bits) == 1 {
        if !isAtomSelector(bits[0]) {
            return null
        }
        return walkQuery(root, bits[0])
    }
    let first = bits[0]
    if !isAtomSelector(first) {
        return null
    }
    let hitList = walkQueryAll(root, first, [])
    let rest = []
    let ri = 1
    while ri < len(bits) {
        rest = push(rest, bits[ri])
        ri = ri + 1
    }
    let mi = 0
    while mi < len(hitList) {
        let hit = queryDescendant(hitList[mi], rest)
        if hit != null && hit != undefined {
            return hit
        }
        mi = mi + 1
    }
    return null
}

fn queryAllDescendant(root, bits) {
    if len(bits) == 0 {
        return []
    }
    if len(bits) == 1 {
        if !isAtomSelector(bits[0]) {
            return null
        }
        return walkQueryAll(root, bits[0], [])
    }
    let first = bits[0]
    if !isAtomSelector(first) {
        return null
    }
    let hitList = walkQueryAll(root, first, [])
    let rest = []
    let ri = 1
    while ri < len(bits) {
        rest = push(rest, bits[ri])
        ri = ri + 1
    }
    let out = []
    let mi = 0
    while mi < len(hitList) {
        let sub = queryAllDescendant(hitList[mi], rest)
        if sub != null && sub != undefined {
            let si = 0
            while si < len(sub) {
                out = push(out, sub[si])
                si = si + 1
            }
        }
        mi = mi + 1
    }
    return out
}

fn queryChildFrom(node, bits) {
    if len(bits) == 0 {
        return null
    }
    if len(bits) == 1 {
        if matchesNode(bits[0], node) {
            return node
        }
        return null
    }
    if !matchesNode(bits[0], node) {
        return null
    }
    let rest = []
    let ri = 1
    while ri < len(bits) {
        rest = push(rest, bits[ri])
        ri = ri + 1
    }
    let kids = kdom_children(node)
    let i = 0
    while i < len(kids) {
        let hit = queryChildFrom(kids[i], rest)
        if hit != null && hit != undefined {
            return hit
        }
        i = i + 1
    }
    return null
}

fn queryChild(root, bits) {
    if len(bits) == 0 {
        return null
    }
    if len(bits) == 1 {
        return walkQuery(root, bits[0])
    }
    if matchesNode(bits[0], root) {
        let rest = []
        let ri = 1
        while ri < len(bits) {
            rest = push(rest, bits[ri])
            ri = ri + 1
        }
        let kids = kdom_children(root)
        let i = 0
        while i < len(kids) {
            let hit = queryChildFrom(kids[i], rest)
            if hit != null && hit != undefined {
                return hit
            }
            i = i + 1
        }
    }
    let kids = kdom_children(root)
    let i = 0
    while i < len(kids) {
        let hit = queryChild(kids[i], bits)
        if hit != null && hit != undefined {
            return hit
        }
        i = i + 1
    }
    return null
}

fn queryAdjacent(root, left, right) {
    let kids = kdom_children(root)
    let i = 1
    while i < len(kids) {
        if matchesNode(left, kids[i - 1]) && matchesNode(right, kids[i]) {
            return kids[i]
        }
        i = i + 1
    }
    let j = 0
    while j < len(kids) {
        let hit = queryAdjacent(kids[j], left, right)
        if hit != null && hit != undefined {
            return hit
        }
        j = j + 1
    }
    return null
}

fn querySibling(root, left, right) {
    let kids = kdom_children(root)
    let seen = false
    let i = 0
    while i < len(kids) {
        if matchesNode(left, kids[i]) {
            seen = true
        } else if seen && matchesNode(right, kids[i]) {
            return kids[i]
        }
        i = i + 1
    }
    let j = 0
    while j < len(kids) {
        let hit = querySibling(kids[j], left, right)
        if hit != null && hit != undefined {
            return hit
        }
        j = j + 1
    }
    return null
}

fn queryOne(root, s) {
    if hasChar(s, "+") && !hasChar(s, ">") {
        let parts = splitByChar(s, "+")
        if len(parts) == 2 {
            return queryAdjacent(root, parts[0], parts[1])
        }
    }
    if hasChar(s, "~") && !hasChar(s, ">") && !hasChar(s, "+") {
        let parts = splitByChar(s, "~")
        if len(parts) == 2 {
            return querySibling(root, parts[0], parts[1])
        }
    }
    if hasChar(s, ">") {
        return queryChild(root, splitByChar(s, ">"))
    }
    if hasChar(s, " ") {
        return queryDescendant(root, splitSpaces(s))
    }
    if !isAtomSelector(s) {
        return null
    }
    return walkQuery(root, s)
}

/// Public: combinators + attr + :not; null only when unhandled.
pub fn queryKab(root, sel) {
    if sel == null || sel == undefined {
        return null
    }
    let s = trim("" + sel)
    if len(s) == 0 {
        return null
    }
    if hasChar(s, ",") {
        let parts = splitComma(s)
        let pi = 0
        while pi < len(parts) {
            let p = parts[pi]
            if len(p) > 0 {
                let hit = queryKab(root, p)
                if hit != null && hit != undefined {
                    return hit
                }
            }
            pi = pi + 1
        }
        return null
    }
    return queryOne(root, s)
}

fn queryAllAdjacent(root, left, right, out) {
    let kids = kdom_children(root)
    let i = 1
    while i < len(kids) {
        if matchesNode(left, kids[i - 1]) && matchesNode(right, kids[i]) {
            out = push(out, kids[i])
        }
        i = i + 1
    }
    let j = 0
    while j < len(kids) {
        out = queryAllAdjacent(kids[j], left, right, out)
        j = j + 1
    }
    return out
}

fn queryAllChildFrom(node, bits, out) {
    if len(bits) == 0 {
        return out
    }
    if len(bits) == 1 {
        if matchesNode(bits[0], node) {
            out = push(out, node)
        }
        return out
    }
    if !matchesNode(bits[0], node) {
        return out
    }
    let rest = []
    let ri = 1
    while ri < len(bits) {
        rest = push(rest, bits[ri])
        ri = ri + 1
    }
    let kids = kdom_children(node)
    let i = 0
    while i < len(kids) {
        out = queryAllChildFrom(kids[i], rest, out)
        i = i + 1
    }
    return out
}

fn queryAllChild(root, bits, out) {
    if len(bits) == 0 {
        return out
    }
    if len(bits) == 1 {
        return walkQueryAll(root, bits[0], out)
    }
    if matchesNode(bits[0], root) {
        let rest = []
        let ri = 1
        while ri < len(bits) {
            rest = push(rest, bits[ri])
            ri = ri + 1
        }
        let kids = kdom_children(root)
        let i = 0
        while i < len(kids) {
            out = queryAllChildFrom(kids[i], rest, out)
            i = i + 1
        }
    }
    let kids = kdom_children(root)
    let j = 0
    while j < len(kids) {
        out = queryAllChild(kids[j], bits, out)
        j = j + 1
    }
    return out
}

fn queryAllOne(root, s) {
    if hasChar(s, "+") && !hasChar(s, ">") {
        let parts = splitByChar(s, "+")
        if len(parts) == 2 {
            return queryAllAdjacent(root, parts[0], parts[1], [])
        }
    }
    if hasChar(s, ">") {
        return queryAllChild(root, splitByChar(s, ">"), [])
    }
    if hasChar(s, " ") {
        return queryAllDescendant(root, splitSpaces(s))
    }
    if !isAtomSelector(s) {
        return null
    }
    return walkQueryAll(root, s, [])
}

pub fn queryAllKab(root, sel) {
    if sel == null || sel == undefined {
        return null
    }
    let s = trim("" + sel)
    if len(s) == 0 {
        return null
    }
    if hasChar(s, ",") {
        let parts = splitComma(s)
        let out = []
        let pi = 0
        while pi < len(parts) {
            let p = parts[pi]
            if len(p) > 0 {
                let sub = queryAllKab(root, p)
                if sub != null && sub != undefined {
                    let si = 0
                    while si < len(sub) {
                        out = push(out, sub[si])
                        si = si + 1
                    }
                }
            }
            pi = pi + 1
        }
        return out
    }
    return queryAllOne(root, s)
}
