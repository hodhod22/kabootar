// kabtest port of tests/v220_language.rs — bytecode v2.2 constructs: objects,
// index write, for-of, for-classic on the Kab VM. (for-of/for-classic are
// fn-scope only in self-host emit — wrapped in fns.)

import "kabtest/core"
import "self_host/compile"

// bytecode_object_literal_and_member
let u = { name: "Ada", age: 36 }
ktAssertEq(u.name, "Ada", "object member")

// bytecode_array_index_write
let xs = [10, 20, 30]
xs[1] = 99
ktAssertEq(xs[1], 99, "index write")

// bytecode_for_of_over_array
fn forOfSum() {
    let sum = 0
    for x of [1, 2, 3] {
        sum = sum + x
    }
    return sum
}
ktAssertEq(forOfSum(), 6, "for-of sum")

// bytecode_for_classic_loop
fn forClassicSum() {
    let total = 0
    for let i = 0; i < 4; i = i + 1 {
        total = total + i
    }
    return total
}
ktAssertEq(forClassicSum(), 6, "for-classic sum")

// bytecode_can_compile_v22_subset — compileIr must succeed on the same constructs
compileIr("fn f() { let u = { x: 1 }\nreturn u.x }")
compileIr("fn g() { for x of [1] { x } }")
compileIr("fn h() { let xs = [...a, 1] }")
ktAssertTrue(true, "can_compile v2.2 subset")

return true
