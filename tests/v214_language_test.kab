// kabtest port of tests/v214_language.rs — `?` operator, match guards,
// instanceof/is() on the Kab VM. Err-propagation is asserted through an
// inner fn return + match (the host returns the Result value; the VM
// propagates it identically one frame up).

import "kabtest/core"

// result_question_unwraps_ok
fn ok_val() { return Ok(42) }
ktAssertEq(ok_val()?, 42, "? unwraps Ok")

// result_question_propagates_err (via caller return + match)
fn bad() { return Err("nope") }
fn caller() { return bad()? }
let ep = match caller() {
    Err(x) => x,
    _ => "not-an-err"
}
ktAssertEq(ep, "nope", "? propagates Err one frame up")

// result_question_in_function_return
fn step() { return Ok(7) }
fn run() { return step()? }
ktAssertEq(run(), 7, "? inside fn return")

// ternary_still_works_with_question_colon
let n = 3
ktAssertEq(n > 0 ? "yes" : "no", "yes", "ternary beside ?")

// match_guard_filters_arms
fn label(m) {
    return match m {
        x if x > 0 => "positive",
        x if x < 0 => "negative",
        _ => "zero"
    }
}
ktAssertEq(label(5), "positive", "match guard positive")
ktAssertEq(label(-2), "negative", "match guard negative")
ktAssertEq(label(0), "zero", "match guard fallback")

// match_guard_skips_non_matching_guard
let mg = match 2 {
    x if x > 10 => "big",
    x if x > 0 => "small",
    _ => "other"
}
ktAssertEq(mg, "small", "guard skips non-matching arm")

// is_checks_exact_class / inherited / unrelated / non-instance
class Animal { }
class Dog extends Animal { }
let d = Dog()
ktAssertEq(instanceof(d, "Dog"), true, "is exact class")
ktAssertEq(instanceof(d, "Animal"), true, "is inherited class")
class Cat { }
ktAssertEq(instanceof(d, "Cat"), false, "is rejects unrelated class")
ktAssertEq(instanceof(42, "Number"), false, "is non-instance is false")
