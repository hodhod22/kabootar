import "kab/aot_apply_reloc"
import "kab/aot_bind"
import "kab/aot_emit_image"
import "kab/aot_emit_reloc_table"

let table = aotEmitRelocTableRodata("x64")
let image = aotEmitImageWithRelocTableRodata("x64")
let addr = aotApplyRelocTableAddressRodata(table, 8192, "x64")
let hex = aotApplyRelocTableWordHexRodata(table, 8192, "x64")
let patched = aotApplyRelocTableToImageRodataHex(image, table, 8192, "x64")
if addr != 8192 {
    return false
}
if hex != "" {
    return false
}
if patched != "" {
    return false
}
return aotRelocSymbolBindOk(addr, 4096) == false
