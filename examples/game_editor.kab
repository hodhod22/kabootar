// GP7 smoke — scene editor shell with scene/game view + DnD + live edit.
import "game/scene"
import "game/game_editor"

let ed = bootEditor("world")
let hero = createNode("hero")
hero = setLocal(hero, 1, 2, 0)
ed["root"] = addChild(ed["root"], hero)
ed = refresh(ed)
ed = selectNode(ed, hero)
ed = sceneOrbit(ed, 1, 0)
ed = sceneZoom(ed, 0.2)
ed = play(ed)
ed = stepGame(ed, 0.016)
ed = liveSet(ed, "layer", 2)
ed = dragStart(ed, { "kind": "asset", "name": "crate", "x": 3, "y": 0, "z": 0 })
ed = dragDropOnNode(ed, ed["root"])
let layout = editorLayout(ed)
println(layout["toolbar"])
println(len(layout["hierarchy"]))
println(layout["gameView"]["playing"])
println(layout["sceneView"]["mode"])
