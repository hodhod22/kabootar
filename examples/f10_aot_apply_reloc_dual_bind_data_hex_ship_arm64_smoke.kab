import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"
import "kab/aot/aot_image_name"
import "kab/aot/aot_ship"
import "kab/aot/aot_verify_full"

let table = aotEmitRelocTableData("arm64")
let image = aotEmitImageWithRelocTableData("arm64")
let patched = aotApplyRelocTableToImageDataHex(image, table, 4096, "arm64")
let hex = aotApplyRelocTableWordHexData(table, 4096, "arm64")
let prefix = "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|data:rw|"
let suffix = "|code:arm64:ret|sym:data:0:g0:arm64|relocs:reloc:data:0:0:g0:arm64"
if patched != prefix + hex + suffix {
    return false
}
let name = aotImageName("arm64")
if aotVerifyFullOk(name, patched) == false {
    return false
}
return aotShipOk(name, patched, "arm64")
