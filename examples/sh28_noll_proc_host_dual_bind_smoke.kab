import "kab/noll_proc"
import "kab/noll_drop"
import "kab/noll_keep"
import "kab/noll_user"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollKeepSrc() != true {
    return false
}
if nollDropSrc() != false {
    return false
}
if nollProcessIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
