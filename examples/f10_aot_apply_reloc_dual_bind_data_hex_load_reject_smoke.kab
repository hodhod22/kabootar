import "kab/aot_apply_reloc"
import "kab/aot_emit_image"
import "kab/aot_emit_reloc_table"
import "kab/aot_load_image"

let table = aotEmitRelocTableData("x64")
let image = aotEmitImageWithRelocTableData("x64")
let patched = aotApplyRelocTableToImageDataHex(image, table, 4096, "arm64")
let addr = aotApplyRelocTableAddressData(table, 4096, "arm64")
let hex = aotApplyRelocTableWordHexData(table, 4096, "arm64")
let loaded = aotLoadImageWithRelocDataHexOk(patched, "x64")
if patched != "" {
    return false
}
if addr != -1 {
    return false
}
if hex != "" {
    return false
}
return loaded == false
