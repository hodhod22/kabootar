import "kab/jit/jit_loop_xor"
import "kab/jit/jit_mm_loop_xor"
import "kab/jit/jit_call_loop_xor"

let kind = "rwx"
let n = 12
let mask = 10
let tpl = jitEmitI64LoopXorN(n, mask)
let base = os_mm_mmap(jitMmLoopXorPid(), jitMmLoopXorVirt(), jitMmLoopXorLen(), jitMmLoopXorProt())
return jitCallLoopXorOk(base, kind, n, mask, tpl)
