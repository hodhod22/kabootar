import "kab/sci/sci_ndmul"
import "kab/sci/sci_ndsub"
import "kab/sci/sci_host"

if sciHostDeleteOk() != false {
    return false
}
let d = sciNdSub([44, 2], [2, 40])
if d[0] != 42 {
    return false
}
let r = sciNdMul([21, 2], [2, 21])
if r[0] != 42 {
    return false
}
return sciHostDeleteOk() == false
