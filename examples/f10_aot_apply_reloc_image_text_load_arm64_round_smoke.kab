import "kab/aot_apply_reloc"
import "kab/aot_emit_image"
import "kab/aot_emit_reloc_table"
import "kab/aot_load_image"

let table = aotEmitRelocTable("arm64")
let image = aotEmitImageWithTables("arm64")
let patched = aotApplyRelocTableToImageText(image, table, 4096, "arm64")
return aotLoadImageWithRelocTextOk(patched, "arm64")
