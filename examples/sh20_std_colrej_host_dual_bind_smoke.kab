import "kab/std/std_colrej"
import "kab/std/std_colproj"
import "kab/std/std_colfill"
import "kab/std/std_colpush"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let a = stdColFill(1, 42)
a = stdColPush(a, 21)
let b = stdColFill(1, 1)
b = stdColPush(b, 0)
let p = stdColProj(a, b)
if p[0] != 42 {
    return false
}
let r = stdColRej(a, b)
if r[1] != 21 {
    return false
}
return stdHostDeleteOk() == false
