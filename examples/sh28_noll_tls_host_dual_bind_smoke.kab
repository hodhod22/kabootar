import "kab/noll/noll_tls"
import "kab/noll/noll_dns"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollDnsIsKab() != false {
    return false
}
if nollTlsIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
