import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"
import "kab/aot/aot_load_image"

let table = aotEmitRelocTableRodataData("x64")
let image = aotEmitImageWithRelocTableRodataData("x64")
let patched = aotApplyRelocTableToImageRodataDataHex(image, table, 4096, "arm64")
let addr = aotApplyRelocTableAddressRodataData(table, 4096, "arm64")
let hex = aotApplyRelocTableWordHexRodataData(table, 4096, "arm64")
let loaded = aotLoadImageWithRelocRodataDataHexOk(patched, "x64")
if patched != "" {
    return false
}
if addr != -1 {
    return false
}
if hex != "" {
    return false
}
return loaded == false
