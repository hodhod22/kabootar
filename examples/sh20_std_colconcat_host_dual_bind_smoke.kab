import "kab/std_colconcat"
import "kab/std_colempty"
import "kab/std_collast"
import "kab/std_col"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let p = stdColPair("n", 42)
let e = []
let c = stdColConcat(p, e)
if stdColEmpty(e) != true {
    return false
}
if stdColLast(c) != 42 {
    return false
}
return stdHostDeleteOk() == false
