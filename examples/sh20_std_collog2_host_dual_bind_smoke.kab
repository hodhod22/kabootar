import "kab/std_collog2"
import "kab/std_collog"
import "kab/std_colfill"
import "kab/std_colpush"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let h = stdColFill(1, 1.0)
h = stdColPush(h, 0)
let k = stdColLog(h)
if k[0] != 0 {
    return false
}
let g = stdColFill(1, 8.0)
g = stdColPush(g, 0)
let w = stdColLog2(g)
if w[0] != 3 {
    return false
}
return stdHostDeleteOk() == false
