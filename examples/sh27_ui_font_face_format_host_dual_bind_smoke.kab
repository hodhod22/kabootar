import "kab/ui_font_face_format"
import "kab/ui_font_face_uri"
import "kab/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsFontFaceUri("font-face-uri") == false {
    return false
}
if uiIsFontFaceFormat("font-face-format") == false {
    return false
}
return uiHostDeleteOk() == false
