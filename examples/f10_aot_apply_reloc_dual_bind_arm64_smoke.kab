import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_emit_code"
import "kab/aot/aot_emit_reloc_table"

let code = aotEmitCode("arm64")
let table = aotEmitRelocTable("arm64")
let addr32 = aotApplyRelocTableAddressAt32(table, 4096, "arm64")
let addr40 = aotApplyRelocTableAddressAt40(table, 4096, "arm64")
let hex = aotApplyRelocTableToTextAt40(code, table, 4096, "arm64")
if addr32 != 4128 {
    return false
}
if addr40 != 4136 {
    return false
}
return hex == "code:arm64:d65f03c00000000000000000000000000000000000000000000000000000000020100000000000002810000000000000"
