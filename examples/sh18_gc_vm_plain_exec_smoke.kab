class Cell {
    n: number
    fn init() {
        this.n = 7
    }
}

// Plain object (make_object shell — host stamps __kab_oid, no vmI) holding a
// live inst. The Kab-VM inst heap keys insts by " "+vmI but also published
// oid-keyed objects under " "+oid — host oids and session vmI values collide,
// so a churn inst with vmI == holder's oid overwrote the holder slot and
// holder.cell read as undefined. Heap keys are now namespaced: " "+vmI for
// insts, "h"+__kab_oid for host-oid objects.
let holder = {}
holder.cell = Cell()

// Cyclic plain objects must also survive and terminate the mark.
let cycA = {}
let cycB = {}
cycA.b = cycB
cycB.a = cycA
cycB.cell = Cell()

// ~1500 shell charges > 65536-byte nursery cap — forces at least one collect.
fn churn() {
    let i = 0
    while i < 1500 {
        let x = Cell()
        i = i + 1
    }
}

churn()
return holder.cell.n + cycB.cell.n
