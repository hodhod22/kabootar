import "kab/std_colcrs"
import "kab/std_colout"
import "kab/std_colfill"
import "kab/std_colpush"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let oa = stdColFill(1, 2)
let ob = stdColFill(1, 21)
let m = stdColOuter(oa, ob)
let row = m[0]
if row[0] != 42 {
    return false
}
let a = stdColFill(1, 2)
a = stdColPush(a, 0)
let b = stdColFill(1, 0)
b = stdColPush(b, 21)
if stdColCross(a, b) != 42 {
    return false
}
return stdHostDeleteOk() == false
