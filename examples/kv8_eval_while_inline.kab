// While+assign smoke (script context, not @version module). cargo run --bin kabootar -- examples/kv8_eval_while_inline.kab

import "kv8/parser"
import "kv8/defs"

fn evExpr(node, env) {
    if node.kind == K_LITERAL {
        return parse_int(node.value)
    }
    if node.kind == K_IDENT {
        let bindSym = node["sym"]
        return env[bindSym]
    }
    if node.kind == K_BINARY {
        let bxL = node.left
        let bxR = node.right
        let bxOp = node.op
        let lhs = evExpr(bxL, env)
        let rhsVal = evExpr(bxR, env)
        if bxOp == "<" { return lhs < rhsVal }
        if bxOp == "+" { return lhs + rhsVal }
        throw "op"
    }
    throw "expr"
}

fn evStmt(stmt, env) {
    if stmt.kind == K_ASSIGN {
        let bindSym = stmt["sym"]
        let rhsNode = stmt["rhs"]
        env["" + bindSym] = evExpr(rhsNode, env)
        return undefined
    }
    throw "stmt"
}

let ast = parseSource("let n = 0; while (n < 3) { n = n + 1; } n")
let env = {}
let pi = 0
while pi < len(ast.body) {
    let st = ast.body[pi]
    if st.kind == K_WHILE {
        let condNode = st.cond
        let bodyStmts = st.body.body
        while true {
            if !evExpr(condNode, env) { break }
            let bi = 0
            while bi < len(bodyStmts) {
                evStmt(bodyStmts[bi], env)
                bi = bi + 1
            }
        }
    } else if st.kind == K_LET {
        let bindSym = st["sym"]
        env["" + bindSym] = evExpr(st.init, env)
    } else if st.kind == K_EXPR {
        println(json_stringify(evExpr(st.expr, env)))
    }
    pi = pi + 1
}

return 0
