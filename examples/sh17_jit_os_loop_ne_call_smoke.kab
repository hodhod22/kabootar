import "kab/jit/jit_loop_ne"
import "kab/jit/jit_mm_loop_ne"
import "kab/jit/jit_call_loop_ne"

let kind = "rwx"
let n = 12
let k = 10
let tpl = jitEmitI64LoopNeN(n, k)
let base = os_mm_mmap(jitMmLoopNePid(), jitMmLoopNeVirt(), jitMmLoopNeLen(), jitMmLoopNeProt())
return jitCallLoopNeOk(base, kind, n, k, tpl)
