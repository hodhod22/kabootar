import "kab/aot/aot_cd"
import "kab/aot/aot_fp"
import "kab/aot/aot_load_image"
import "kab/aot/aot_loaded_image"
import "kab/aot/aot_pgo"

if aotPgoOk(8) == false {
    return false
}
if aotFpOk("abc") == false {
    return false
}
if aotColdOk(100) == false {
    return false
}
let image = aotPgoWarmImageWithFpCold(8, "abc", 100, "x64")
if aotLoadedImageOk(image) == false {
    return false
}
return aotLoadImageWithPgoWarmFpColdOk(image, "arm64") == false
