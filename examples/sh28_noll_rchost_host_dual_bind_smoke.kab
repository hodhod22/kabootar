import "kab/noll_rchost"
import "kab/noll"
import "kab/noll_syskab"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollRustcStillHost() != true {
    return false
}
if nollSyscallIsKab() != false {
    return false
}
if nollRustcNotHost() != false {
    return false
}
return nollHostDeleteOk() == false
