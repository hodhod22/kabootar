import "kab/noll_rm"
import "kab/noll_add"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollAddIsKab() != false {
    return false
}
if nollRmIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
