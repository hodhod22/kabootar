import "kab/aot_apply_reloc"
import "kab/aot_emit_image"
import "kab/aot_emit_reloc_table"
import "kab/aot_loaded_image"

let table = aotEmitRelocTable("x64")
let image = aotEmitImageWithTables("x64")
let patched = aotApplyRelocTableToImageTextAt40(image, table, 4096, "arm64")
let hex32 = aotApplyRelocTableWordHexAt32(table, 4096, "arm64")
let loaded = aotLoadedImageOk(patched)
if patched != "" {
    return false
}
if hex32 != "" {
    return false
}
return loaded == false
