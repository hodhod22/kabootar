import "kab/sci/sci_nddiv"
import "kab/sci/sci_ndmul"
import "kab/sci/sci_host"

if sciHostDeleteOk() != false {
    return false
}
let m = sciNdMul([21, 2], [2, 21])
if m[0] != 42 {
    return false
}
let r = sciNdDiv([84, 42], [2, 1])
if r[0] != 42 {
    return false
}
return sciHostDeleteOk() == false
