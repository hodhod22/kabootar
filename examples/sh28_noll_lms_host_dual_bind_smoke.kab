import "kab/noll/noll_lms"
import "kab/noll/noll_xmss"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollXmssIsKab() != false {
    return false
}
if nollLmsIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
