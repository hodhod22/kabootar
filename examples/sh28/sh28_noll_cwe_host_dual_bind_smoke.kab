import "kab/noll/noll_cwe"
import "kab/noll/noll_cve"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollCveIsKab() != false {
    return false
}
if nollCweIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
