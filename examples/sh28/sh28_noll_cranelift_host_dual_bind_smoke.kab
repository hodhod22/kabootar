import "kab/noll/noll_cranelift"
import "kab/noll/noll_gates"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollAllGatesClosedOk() != true {
    return false
}
if nollCraneliftGone() != false {
    return false
}
return nollHostDeleteOk() == false
