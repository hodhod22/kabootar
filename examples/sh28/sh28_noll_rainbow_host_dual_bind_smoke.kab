import "kab/noll/noll_rainbow"
import "kab/noll/noll_sike"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollSikeIsKab() != false {
    return false
}
if nollRainbowIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
