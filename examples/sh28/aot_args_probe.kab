// AOT-8 probe: os_args() argv bridge — the exec driver plants a real argv
// block at map_len-16 (the image's reserved slot at index limit), the seq
// validates + walks it into a tag-5 array of str cells. Mirror side the
// probe pre-fills a fabricated block so seq logic is content-verified.
import "self_host/compile"
import "kab/aot/aot_fn_x64"
import "kab/aot/aot_fn_exec"
import "kab/aot/aot_native"
import "kab/aot/aot_fn_lower"

// mirror-side fabricated blk: hp cell at qword H holds [argc][p0..][0]
// where pN are tagged ptrs to real str cells built by a tiny seq fn.
// Simpler: run the lowered ops under aotFnRunG with gl/hp prebuilt.
// NOTE: `hp[i] = v` inside a fn is copy-on-write — writes never reach
// the caller's array. Fabrication helpers return the modified array;
// the ptr convention (qword_index * 8 + 1) is computed at the call site.
fn mkCstr(hp, at, s) {
    // raw NUL-terminated bytes (no cell hdr) — argv/envp entries are
    // plain C strings, not tv1 str cells.
    let L = len(s)
    let i = 0
    while i <= L {
        let sh = 1
        let k = 0
        while k < i % 8 {
            sh = sh * 256
            k = k + 1
        }
        let b = 0
        if i < L {
            b = char_code_at(s, i) % 256
        }
        hp[at + i / 8] = hp[at + i / 8] + b * sh
        i = i + 1
    }
    return hp
}
fn mkStr(hp, at, s) {
    // str cell: hdr = 4<<16|len, packed LE cp&255 bytes from qword at+1
    let L = len(s)
    hp[at] = 262144 + L
    let i = 0
    while i < L {
        let sh = 1
        let k = 0
        while k < i % 8 {
            sh = sh * 256
            k = k + 1
        }
        hp[at + 1 + i / 8] = hp[at + 1 + i / 8] + (char_code_at(s, i) % 256) * sh
        i = i + 1
    }
    return hp
}

fn probe() {
    let heapQ = 8192
    let bc = compileIr("let a = os_args() if len(a) < 1 { return 7 } let p = env_get(\"PATH\") if p == undefined { return 8 } if len(p) < 1 { return 9 } return len(a) * 1000 + len(a[0]) * 10 + char_code_at(p, 0)")
    let lo = aotFnLowerModuleTv1(bc, heapQ)
    if lo["ok"] == false {
        println("REJECT " + lo["reason"])
        return -1
    }
    // nglobals already includes the +2 reserved slots → argvblk index
    // = nglobals + heapQ (the first qword past the heap bound).
    let ng = lo["nglobals"]
    let ab = ng + heapQ
    let r = aotX64EmitFns(lo["fns"], aotNativeHostAbi())
    let d = []
    while len(d) < ab + 2 {
        d = push(d, 0)
    }
    // native: real process argv — kabootar's own args (>= 1 nonempty arg)
    let nr = os_native_exec(r["code"], 0, d, (ab + 2) * 8)
    println("native " + nr)
    if nr < 1000 {
        println("native argv too small")
        return -2
    }
    // mirror: fabricate blk [2, p("hi"), p("yo"), 0] — len(a)*100+len(a[0])
    // expected = 2*100 + 2 = 202
    let gl = []
    let i = 0
    while i < ab + 2 {
        gl = push(gl, 0)
        i = i + 1
    }
    let hp = []
    i = 0
    while i < 80 {
        hp = push(hp, 0)
        i = i + 1
    }
    // fabricated cells live high — mirror halloc bumps from index 0.
    // blk at qword 48: [2][p0][p1][0][e0][0] (argv + envp sections);
    // raw cstrs at 56 / 60 / 64 ("PATH=zz" feeds env_get("PATH") → "zz").
    hp = mkCstr(hp, 56, "hi")
    hp = mkCstr(hp, 60, "yo")
    hp = mkCstr(hp, 64, "PATH=zz")
    hp[48] = 2
    hp[49] = 56 * 8 + 1
    hp[50] = 60 * 8 + 1
    hp[51] = 0
    hp[52] = 64 * 8 + 1
    hp[53] = 0
    gl[ab] = 48 * 8 + 1 // blk cell ptr (qword index 48, tagged)
    println("ab " + ab + " gl " + len(gl) + " hp " + len(hp))
    let mr = 0
    try {
        mr = aotFnRunG(lo["fns"], 0, 0, 0, 0, 0, gl, hp, [])["v"]
    } catch (e) {
        println("mirror threw " + e)
        return -9
    }
    println("mirror " + mr)
    // Content-verified: a = ["hi","yo"] → len 2 + len(a[0]) 2, env hit
    // "zz" → char_code_at('z') = 122 → 2*1000+2*10+122 = 2142, mirror
    // ret is smi-tagged (×2) → 4284.
    if mr != 4284 {
        println("mirror argv/env wrong")
        return -3
    }
    return 1
}

let rc = probe()
println("rc " + rc)
if rc == 1 {
    return 42
}
return 1
