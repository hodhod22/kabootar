import "kab/noll/noll_nvd"
import "kab/noll/noll_ghsa"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollGhsaIsKab() != false {
    return false
}
if nollNvdIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
