import "kab/noll/noll_ntru"
import "kab/noll/noll_falcon"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollFalconIsKab() != false {
    return false
}
if nollNtruIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
