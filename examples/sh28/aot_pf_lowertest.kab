import "self_host/compile"
import "kab/aot/aot_fn_lower"

println("compile")
let bc = compileIr("return parse_float(\"0.5\") == 0.5")
println("lower")
let lo = aotFnLowerModuleTv1(bc, 512)
println("ok=" + lo["ok"])
if lo["ok"] == false {
    println("reason " + lo["reason"])
    return 1
}
println("fns " + len(lo["fns"]))
let ops = lo["fns"][0]["ops"]
println("ops " + len(ops))
let i = 0
while i < len(ops) {
    println(i + " " + ops[i])
    i = i + 1
}
return 0
