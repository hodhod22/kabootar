import "kab/noll/noll_argon"
import "kab/noll/noll_hotp"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollHotpIsKab() != false {
    return false
}
if nollArgonIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
