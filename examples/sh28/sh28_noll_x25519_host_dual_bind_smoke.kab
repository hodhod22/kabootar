import "kab/noll/noll_x25519"
import "kab/noll/noll_poly"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollPolyIsKab() != false {
    return false
}
if nollX25519IsKab() != false {
    return false
}
return nollHostDeleteOk() == false
