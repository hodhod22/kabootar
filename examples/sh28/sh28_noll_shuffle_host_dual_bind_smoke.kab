import "kab/noll/noll_shuffle"
import "kab/noll/noll_cortex"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollCortexIsKab() != false {
    return false
}
if nollShuffleIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
