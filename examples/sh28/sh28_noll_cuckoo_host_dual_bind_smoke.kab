import "kab/noll/noll_cuckoo"
import "kab/noll/noll_anyrun"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollAnyrunIsKab() != false {
    return false
}
if nollCuckooIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
