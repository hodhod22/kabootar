import "kab/noll/noll_mock"
import "kab/noll/noll_snap"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollSnapIsKab() != false {
    return false
}
if nollMockIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
