import "kab/noll/noll_net"
import "kab/noll/noll_rand"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollRandIsKab() != false {
    return false
}
if nollNetIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
