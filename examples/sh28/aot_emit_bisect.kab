// Bisect: emit the same program as a single compileIr module (no link).
import "self_host/compile"
import "kab/aot/aot_fn_x64"
import "kab/aot/aot_fn_exec"
import "kab/aot/aot_native"
import "kab/aot/aot_fn_lower"

let src = env_get("KAB_AOT_SRC")
if typeof(src) != "string" || src == "" {
    src = "fn depMul(a, b) { return a * b } fn depSum(n) { let s = 0 let i = 1 while i <= n { s = s + i i = i + 1 } return s } return depSum(10) + depMul(3, 4)"
}
let bc = compileIr(src)
println("compiled fns=" + len(bc["functions"]))
let lo = aotFnLowerModuleTv1(bc, 4096)
if lo["ok"] != true {
    println("REJ " + lo["reason"])
    return 1
}
println("lowered fns=" + len(lo["fns"]))
let r = aotX64EmitFns(lo["fns"], aotNativeHostAbi())
println("emitted " + len(r["code"]) + " bytes")
let ngv = lo["nglobals"]
println("ng=" + ngv)
let d = []
while len(d) < ngv + 2 + 256 {
    d = push(d, 0)
}
println("data klar")
let fns = lo["fns"]
println("fns bundna " + len(fns))
let mir = aotFnMirrorH(fns, 0, ngv, 64)
println("mirror=" + mir + " (vill ha 134 = 67 taggad)")
println("native startar")
let rax = os_native_exec(r["code"], 0, d)
println("rax=" + rax + " (vill ha 134 = 67 taggad)")
return 0
