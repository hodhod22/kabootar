// SH28: REAL machine-code exec — the persisted image's code:x64 bytes are
// actual x86-64 run by the host CPU (os_native_exec), and the child-process
// leg runs `kabootar exec-image` via run_command (real OS process, KABOOTAR_EXE).
// This is distinct from the simulated guest-MM templates (aot_exec/aot_proc).

import "kab/aot/aot_native"
import "kab/aot/aot_fn_exec"

// In-process native exec: lt (87) — 3 < 9 → rax 1 on the real CPU.
if aotNativeExecOk("_aot_native_exec.kabi", 87, 3, 9) == false {
    return 1
}
// ge (90): 9 >= 3 → 1 — reload+resolve+decode+native-exec roundtrip.
if aotNativeExecOk("_aot_native_exec.kabi", 90, 9, 3) == false {
    return 2
}
// eq (85): 7 == 7 → 1.
if aotNativeExecOk("_aot_native_exec.kabi", 85, 7, 7) == false {
    return 3
}
// test (91): 5 & 6 = 4 != 0 → 1.
if aotNativeExecOk("_aot_native_exec.kabi", 91, 5, 6) == false {
    return 4
}
// Countdown: mov eax,5 ; sub/jne backward loop on the real CPU → rax 0.
if aotNativeLoopExecOk("_aot_native_loop.kabi", 5) == false {
    return 5
}
// Call chain: mov eax,6 ; call _dbl (add eax,eax; ret) → rax 12 — a real
// rel32 call between functions in one image, on the host CPU.
if aotNativeCallExecOk("_aot_native_call.kabi", 6) == false {
    return 10
}
// Host-arg chain: the HOST passes 21 across the ABI (rcx win64 / rdi
// sysv) into _start → call _dbl → rax 42 — first runtime-supplied input.
if aotNativeArgExecOk("_aot_native_arg.kabi", 21) == false {
    return 11
}
// Fused mul: imul eax,ecx on the real CPU → rax = 6*7 = 42.
if aotNativeMulExecOk("_aot_native_mul.kabi", 6, 7) == false {
    return 13
}
// Fused quo: xor edx,edx; div ecx → rax = 43/7 = 6 (truncating).
if aotNativeQuoExecOk("_aot_native_quo.kabi", 43, 7) == false {
    return 14
}
// Fused rem: mov eax,edx after div → rax = 43%7 = 1.
if aotNativeRemExecOk("_aot_native_rem.kabi", 43, 7) == false {
    return 15
}
// Stack frame: push rbp; mov [rbp-4],n; reload+add; leave → rax = 2n via
// real rbp-relative stack memory.
if aotNativeLocalsExecOk("_aot_native_locals.kabi", 11) == false {
    return 16
}
// Signed div: cdq; idiv ecx on the real CPU → rax = -43/7 = -6
// (truncating toward zero, same as Kab int div).
if aotNativeIQuoExecOk("_aot_native_iq.kabi", -43, 7) == false {
    return 18
}
// Signed rem: mov eax,edx after idiv → rax = -43%7 = -1 (sign follows
// the dividend, same as Kab %).
if aotNativeIRemExecOk("_aot_native_ir.kabi", -43, 7) == false {
    return 19
}
// Forward jump: jmp rel8 +5 skips a mov eax,0 on the real CPU → rax = 15.
if aotNativeJmpExecOk("_aot_native_jmp.kabi", 10, 5) == false {
    return 20
}
// if/else: signed jge over early ret — 3<5 → rax = 100.
if aotNativeIfElseExecOk("_aot_native_if.kabi", 3, 5) == false {
    return 21
}
// if/else other arm: 9>=5 → rax = 200.
if aotNativeIfElseExecOk("_aot_native_if.kabi", 9, 5) == false {
    return 22
}
// Image data section: two u32s mapped RW, read via ABI arg2 →
// rax = 20+22 = 42.
if aotNativeDataExecOk("_aot_native_data.kabi", 20, 22) == false {
    return 23
}
// Whole-function AOT (aot_fn_x64): sum(n) = 0+1+..+n-1 — real locals on
// rbp slots, backward jmp + forward jz over an op array, rax = Kab mirror.
let sumFns = [{ "name": "sum", "locals": 3, "arity": 1, "ops": [
    ["const", 0], ["store", 1], ["const", 0], ["store", 2],
    ["load", 2], ["load", 0], ["lt"], ["jz", 17],
    ["load", 1], ["load", 2], ["add"], ["store", 1],
    ["load", 2], ["const", 1], ["add"], ["store", 2],
    ["jmp", 4], ["load", 1], ["ret"]
] }]
// sum(9) = 36.
if aotFnExecOk("_aot_fn_sum.kabi", sumFns, 9) == false {
    return 25
}
// Call chain: main(n) = dbl(n)+1 → 2*21+1 = 43 — call rel32 across fns.
let callFns = [
    { "name": "main", "locals": 1, "arity": 1, "ops": [
        ["load", 0], ["call", 1], ["const", 1], ["add"], ["ret"]
    ] },
    { "name": "dbl", "locals": 1, "arity": 1, "ops": [
        ["load", 0], ["const", 2], ["mul"], ["ret"]
    ] }
]
if aotFnExecOk("_aot_fn_call.kabi", callFns, 21) == false {
    return 26
}
// Two-arg call: main(n) = add2(n,n) → 42 — private rcx/rdx convention.
let call2Fns = [
    { "name": "main", "locals": 1, "arity": 1, "ops": [
        ["load", 0], ["load", 0], ["call2", 1], ["ret"]
    ] },
    { "name": "add2", "locals": 2, "arity": 2, "ops": [
        ["load", 0], ["load", 1], ["add"], ["ret"]
    ] }
]
if aotFnExecOk("_aot_fn_call2.kabi", call2Fns, 21) == false {
    return 27
}
// Recursion: fib(n) self-call — deep call/ret chain inside one image.
// fib(10) = 55.
let fibFns = [{ "name": "fib", "locals": 1, "arity": 1, "ops": [
    ["load", 0], ["const", 2], ["lt"], ["jz", 6],
    ["load", 0], ["ret"],
    ["load", 0], ["const", 1], ["sub"], ["call", 0],
    ["load", 0], ["const", 2], ["sub"], ["call", 0],
    ["add"], ["ret"]
] }]
if aotFnExecOk("_aot_fn_fib.kabi", fibFns, 10) == false {
    return 28
}
// Negative const: f(n) = n + (-6) — sext imm32 into rax; f(48) = 42.
let negFns = [{ "name": "neg", "locals": 1, "arity": 1, "ops": [
    ["load", 0], ["const", -6], ["add"], ["ret"]
] }]
if aotFnExecOk("_aot_fn_neg.kabi", negFns, 48) == false {
    return 29
}
// Out-of-domain (n=0) → emit refuses → no exec.
if aotNativeExecOk("_aot_native_exec.kabi", 87, 0, 9) {
    return 6
}
// Bad magic → emit refuses.
if aotNativeExecOk("_aot_native_exec.kabi", 0, 3, 9) {
    return 8
}
// Countdown out-of-domain (n=0 would spin 2^32 iterations) → refuses.
if aotNativeLoopExecOk("_aot_native_loop.kabi", 0) {
    return 9
}
// quo out-of-domain (k=0 would be a REAL #DE fault on the host CPU) →
// emit must refuse before any bytes exist.
if aotNativeQuoExecOk("_aot_native_quo.kabi", 43, 0) {
    return 17
}
// Real child-process exec — when KABOOTAR_EXE is set the leg MUST pass;
// unset → env-gated skip (like KAB_TLS_PEERS).
let exe = env_get("KABOOTAR_EXE")
if typeof(exe) == "string" && len(exe) > 0 {
    if aotNativeProcExecOk("_aot_native_proc.kabi", 87, 3, 9) == false {
        return 7
    }
    // Child-process arg leg: 33 crosses argv AND the ABI → rax 66.
    if aotNativeArgProcExecOk(33) == false {
        return 12
    }
    // Child-process data leg: image-carried data_hex mapped RW in the
    // child, read via ABI arg2 → rax = 30+12 = 42.
    if aotNativeDataProcExecOk(30, 12) == false {
        return 24
    }
}
return 42
