import "kab/noll/noll_clock"
import "kab/noll/noll_fake"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollFakeIsKab() != false {
    return false
}
if nollClockIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
