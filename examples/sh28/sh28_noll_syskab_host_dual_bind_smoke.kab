import "kab/noll/noll_syskab"
import "kab/noll/noll_syscall"
import "kab/noll/noll_stubproc"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollHostSyscallGone() != false {
    return false
}
if nollStubIsProcess() != false {
    return false
}
if nollSyscallIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
