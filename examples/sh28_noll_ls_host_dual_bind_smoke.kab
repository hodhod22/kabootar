import "kab/noll/noll_ls"
import "kab/noll/noll_mod"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollModIsKab() != false {
    return false
}
if nollLsIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
