import "kab/noll/noll_stubproc"
import "kab/noll/noll_stub"
import "kab/noll/noll_mmexec"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollStubFrozen() != false {
    return false
}
if nollMmapExecProcess() != false {
    return false
}
if nollStubIsProcess() != false {
    return false
}
return nollHostDeleteOk() == false
