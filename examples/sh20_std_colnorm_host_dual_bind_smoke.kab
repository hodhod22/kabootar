import "kab/std/std_colnorm"
import "kab/std/std_coldet"
import "kab/std/std_colfill"
import "kab/std/std_colpush"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let r0 = stdColFill(1, 6)
r0 = stdColPush(r0, 0)
let r1 = stdColFill(1, 0)
r1 = stdColPush(r1, 7)
let m = stdColFill(1, r0)
m = stdColPush(m, r1)
if stdColDet(m) != 42 {
    return false
}
let v = stdColFill(1, 0)
v = stdColPush(v, 42)
if stdColNorm(v) != 42 {
    return false
}
return stdHostDeleteOk() == false
