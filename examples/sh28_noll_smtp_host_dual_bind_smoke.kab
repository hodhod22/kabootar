import "kab/noll/noll_smtp"
import "kab/noll/noll_mqtt"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollMqttIsKab() != false {
    return false
}
if nollSmtpIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
