// SC — ndarray + linreg SGD mini-demo (vs Python NumPy/sklearn sketch).
import "science"
import "science/nd"
import "science/ml"

let X = [[1.0], [2.0], [3.0], [4.0]]
let Y = [3.0, 5.0, 7.0, 9.0]
let params = [0.0, 0.0]
let epoch = 0
while epoch < 250 {
    let i = 0
    while i < 4 {
        params = linregStep(params, X[i], Y[i], 0.05)
        i = i + 1
    }
    epoch = epoch + 1
}
let A = from([[2.0, 0.0], [0.0, 2.0]])
let b = from([4.0, 6.0])
let x = solve(A, b)
params[0] > 1.5 && params[0] < 2.5 && nd_get(x, 0) == 2.0 && nd_get(x, 1) == 3.0
