import "kab/ui/ui_annotation_xml"
import "kab/ui/ui_annotation"
import "kab/ui/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsAnnotation("annotation") == false {
    return false
}
if uiIsAnnotationXml("annotation-xml") == false {
    return false
}
return uiHostDeleteOk() == false
