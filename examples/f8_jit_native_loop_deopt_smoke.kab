import "kab/jit_native_loop_deopt"
import "kab/jit_loop_n"
import "kab/jit_mm_loop_n"
import "kab/jit_call_loop_n"

let nPhi = 1
let nInv = 1
let nDup = 1
let nGuard = 1
let n = 16
if jitNativeLoopDeoptOk(nPhi, nInv, nDup, nGuard, n) == false {
    return false
}
let kind = "rwx"
let tpl = jitEmitI64LoopN(n)
let base = os_mm_mmap(jitMmLoopNPid(), jitMmLoopNVirt(), jitMmLoopNLen(), jitMmLoopNProt())
return jitCallLoopNOk(base, kind, n, tpl)
