import "kab/noll_kerberos"
import "kab/noll_radius"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollRadiusIsKab() != false {
    return false
}
if nollKerberosIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
