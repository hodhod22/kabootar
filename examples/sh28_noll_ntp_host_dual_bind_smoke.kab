import "kab/noll_ntp"
import "kab/noll_ldap"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollLdapIsKab() != false {
    return false
}
if nollNtpIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
