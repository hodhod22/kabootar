import "kab/wave_capstone"
import "kab/gc_capstone"
import "kab/load_aot_capstone"

if waveCapstoneGatesClosed() == false {
    return false
}
if gcCapstoneGatesClosed() == false {
    return false
}
if loadAotCapstoneGatesClosed() == false {
    return false
}
if waveCapstoneNativeName() != "kabootar-x64.kbn" {
