os_syscall("mount", "/host", "C:/after-2026-06-03/new-kabootar-reserv/nova-interpreter")
let outp = "/host/examples/sh33/_micro_out.txt"
let M = { "const": 8, "load": 1, "store": 1, "add": 6, "sub": 6, "mul": 7, "div": 15, "mod": 18, "neg": 5, "not": 11, "eq": 12, "ne": 12, "lt": 12, "le": 12, "gt": 12, "ge": 12, "jmp": 5, "jz": 10, "jnz": 10, "call": 7, "call0": 6, "call2": 8, "call3": 10, "call4": 12, "pop": 1, "dup": 5, "swap": 4, "tag": 5, "untag": 5, "is_smi": 10, "ret": 5 }
let A = [0,8,6,1,12,10,5,7]
let ops = [["load", 3], ["const", 42], ["add"], ["eq"], ["jz", 9], ["ret"]]
let acc = ""
let N = 3000

// baseline: empty loop
let t0 = date_now_ms()
let i = 0
let s = 0
while i < N { i = i + 1 }
acc = acc + "empty: " + (date_now_ms() - t0) + "ms\n"

// record lookup
t0 = date_now_ms()
i = 0
while i < N {
    let x = M["load"]
    s = s + x
    i = i + 1
}
acc = acc + "recget: " + (date_now_ms() - t0) + "ms\n"

// array index
t0 = date_now_ms()
i = 0
while i < N {
    let x = A[3]
    s = s + x
    i = i + 1
}
acc = acc + "arridx: " + (date_now_ms() - t0) + "ms\n"

// string compare
t0 = date_now_ms()
i = 0
while i < N {
    if "load" == "store" { s = s + 1 }
    i = i + 1
}
acc = acc + "strcmp: " + (date_now_ms() - t0) + "ms\n"

// array elem read (op[0])
t0 = date_now_ms()
i = 0
while i < N {
    let x = ops[1][0]
    i = i + 1
}
acc = acc + "opread: " + (date_now_ms() - t0) + "ms\n"

// push fused
t0 = date_now_ms()
i = 0
let b = []
while i < N {
    b = push(b, 7)
    i = i + 1
}
acc = acc + "push: " + (date_now_ms() - t0) + "ms\n"

// fn call trivial
fn f0(x) { return x + 1 }
t0 = date_now_ms()
i = 0
while i < N {
    s = f0(s)
    i = i + 1
}
acc = acc + "call: " + (date_now_ms() - t0) + "ms\n"

// int compare chain (10)
t0 = date_now_ms()
i = 0
while i < N {
    let k = 3
    if k == 1 { s = s + 1 } else if k == 2 { s = s + 2 } else if k == 3 { s = s + 3 } else if k == 4 { s = s + 4 } else if k == 5 { s = s + 5 } else if k == 6 { s = s + 6 } else if k == 7 { s = s + 7 } else if k == 8 { s = s + 8 } else if k == 9 { s = s + 9 } else if k == 10 { s = s + 10 }
    i = i + 1
}
acc = acc + "intchain10: " + (date_now_ms() - t0) + "ms\n"

os_write(outp, acc + "s=" + s + "\n")
return 0
