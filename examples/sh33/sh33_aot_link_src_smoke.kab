// SH33: multi-module linking — aotLinkModules merges compileIr module
// records into one image: each module main becomes a "$main::<name>"
// fn called in dependency order, imported pub names alias the exporter's
// global slot (live-binding semantics), and fn-valued slots carry the
// mangled "mod::sym" name so load_global+call fusion resolves the right
// fn across modules. Native rax must equal the mirror in every case;
// expects are TAGGED (v<<1).
import "self_host/compile"
import "kab/aot/aot_fn_x64"
import "kab/aot/aot_fn_exec"
import "kab/aot/aot_native"
import "kab/aot/aot_fn_lower"
import "kab/aot/aot_link"

fn linkOk(mods, expect) {
    let bc = aotLinkModules(mods)
    let lo = aotFnLowerModuleTv1(bc, 512)
    if lo["ok"] == false {
        println("REJECT " + lo["reason"])
        return -1
    }
    let r = aotX64EmitFns(lo["fns"], aotNativeHostAbi())
    if len(r["code"]) == 0 {
        println("EMIT empty code")
        return -2
    }
    let d = []
    while len(d) < lo["nglobals"] + 2 + 2048 {
        d = push(d, 0)
    }
    let nr = os_native_exec(r["code"], 0, d)
    let mr = aotFnMirrorH(lo["fns"], 0, lo["nglobals"], 2048)
    if mr != nr {
        println("PARITY " + nr + " vs " + mr)
        return -3
    }
    if nr != expect {
        println("GOT " + nr + " want " + expect)
        return -4
    }
    return 1
}

fn mkMod(name, src) {
    return { "name": name, "bc": compileIr(src) }
}

let acc = 0
// pub fn call across the boundary: dep.dadd + dep.helper (private,
// called inside dep). 22 + 6 = 28 → tagged 56.
acc = acc + linkOk([
    mkMod("dep", "pub fn dadd(a, b) { return a + b }\nfn helper(x) { return x * 2 }\npub fn dmul2(x) { return helper(x) }"),
    mkMod("app", "import \"dep\"\nreturn dadd(22, 0) + dmul2(3)")
], 56)
// pub let data global: exporter main stores K=21 into the aliased
// slot, importer reads it. 21 + 1 = 22 → tagged 44.
acc = acc + linkOk([
    mkMod("dep", "pub let K = 21"),
    mkMod("app", "import \"dep\"\nreturn K + 1")
], 44)
// Imported fn used as a VALUE (closure cell via want-scan wrapper,
// then callv): dadd cell → h → h(2,3) = 5 → tagged 10.
acc = acc + linkOk([
    mkMod("dep", "pub fn dadd(a, b) { return a + b }"),
    mkMod("app", "import \"dep\"\nlet h = dadd\nreturn h(2, 3)")
], 10)
// Transitive: mid imports dep, app imports mid. app sees mid's
// exports only; mid's call chains through to dep.
// midq(3) = quad(3) - 1 = 12 - 1 = 11 → tagged 22.
acc = acc + linkOk([
    mkMod("dep", "pub fn quad(x) { return x * 4 }"),
    mkMod("mid", "import \"dep\"\npub fn midq(x) { return quad(x) - 1 }"),
    mkMod("app", "import \"mid\"\nreturn midq(3)")
], 22)
// fn-name collision across modules: dep exports f (+100), mid's OWN
// private f (+200) must resolve to mid::f internally while app's f(1)
// fuses to dep::f. f(1)=101, midq(0)=mid.f(0)=200 → 301 → tagged 602.
acc = acc + linkOk([
    mkMod("dep", "pub fn f(x) { return x + 100 }"),
    mkMod("mid", "fn f(x) { return x + 200 }\npub fn midq(x) { return f(x) }"),
    mkMod("app", "import \"dep\"\nimport \"mid\"\nreturn f(1) + midq(0)")
], 602)
println("acc " + acc)
if acc == 5 {
    return 42
}
return acc
