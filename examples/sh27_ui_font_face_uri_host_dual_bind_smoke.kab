import "kab/ui/ui_font_face_uri"
import "kab/ui/ui_font_face_src"
import "kab/ui/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsFontFaceSrc("font-face-src") == false {
    return false
}
if uiIsFontFaceUri("font-face-uri") == false {
    return false
}
return uiHostDeleteOk() == false
