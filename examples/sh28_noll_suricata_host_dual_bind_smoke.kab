import "kab/noll/noll_suricata"
import "kab/noll/noll_osquery"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollOsqueryIsKab() != false {
    return false
}
if nollSuricataIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
