import "kab/std_colatan2"
import "kab/std_colatan"
import "kab/std_colfill"
import "kab/std_colpush"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let h = stdColFill(1, 0.0)
h = stdColPush(h, 0)
let k = stdColAtan(h)
if k[0] != 0 {
    return false
}
let y = stdColFill(1, 0.0)
y = stdColPush(y, 0)
let x = stdColFill(1, 1.0)
x = stdColPush(x, 0)
let w = stdColAtan2(y, x)
if w[0] != 0 {
    return false
}
return stdHostDeleteOk() == false
