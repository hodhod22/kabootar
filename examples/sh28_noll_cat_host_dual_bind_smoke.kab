import "kab/noll_cat"
import "kab/noll_ls"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollLsIsKab() != false {
    return false
}
if nollCatIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
