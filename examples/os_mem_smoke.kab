// kOS owned mem + display_buf smoke
// cargo run --bin kabootar -- examples/os_mem_smoke.kab

@version "1.0.0"
@manual

import "os/mem"
import "os/display_buf"

let raw = alloc(8, "smoke")
write(raw, 0, [10, 20, 30])
let got = read(raw, 0, 3)
let moved = owned_move(raw)
free(moved)

let fb = create(2, 2, "fb")
fill(fb, 1, 2, 3, 255)
let px = read(fb["buf"], 0, 4)
release(fb)

println("os mem: raw=" + json_stringify(got) + " px=" + json_stringify(px))
return got[0] + got[1] + got[2] + px[0] + px[1] + px[2]
