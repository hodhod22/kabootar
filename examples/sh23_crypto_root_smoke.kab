import "kab/crypto/crypto_root"

let pem = "-----BEGIN CERTIFICATE-----\nAQ==\n-----END CERTIFICATE-----"
if cryptoRootPem(pem) != true {
    return false
}
let one = cryptoRootPemBytes(pem)
if one == false {
    return false
}
if one["n"] != 1 {
    return false
}
if one["0"] != 1 {
    return false
}
let man = cryptoRootPemBytes("-----BEGIN CERTIFICATE-----\nTWFu\n-----END CERTIFICATE-----")
if man == false {
    return false
}
if man["n"] != 3 {
    return false
}
if man["0"] != 77 {
    return false
}
if man["1"] != 97 {
    return false
}
if man["2"] != 110 {
    return false
}
if cryptoRootPem("BEGIN CERT") != false {
    return false
}
if cryptoRootPem("-----BEGIN CERTIFICATE-----AQ==") != false {
    return false
}
if cryptoRootPem("-----BEGIN CERTIFICATE-----\n----\n-----END CERTIFICATE-----") != false {
    return false
}
if cryptoRootPem("-----BEGIN CERTIFICATE-----\nAAA\n-----END CERTIFICATE-----") != false {
    return false
}
if cryptoRootPem("-----BEGIN CERTIFICATE-----\nA=BC\n-----END CERTIFICATE-----") != false {
    return false
}
if cryptoRootPem("-----BEGIN CERTIFICATE-----\nA===\n-----END CERTIFICATE-----") != false {
    return false
}
return cryptoRootPem("-----END CERTIFICATE-----\nAQ==\n-----BEGIN CERTIFICATE-----") == false
