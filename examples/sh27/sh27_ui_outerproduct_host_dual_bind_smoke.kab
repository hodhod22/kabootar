import "kab/ui/ui_outerproduct"
import "kab/ui/ui_scalarproduct"
import "kab/ui/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsScalarproduct("scalarproduct") != true {
    return false
}
if uiIsOuterproduct("outerproduct") != true {
    return false
}
return uiHostDeleteOk() == false
