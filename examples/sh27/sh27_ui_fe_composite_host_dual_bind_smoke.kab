import "kab/ui/ui_fe_composite"
import "kab/ui/ui_fe_component_transfer"
import "kab/ui/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsFeComponentTransfer("feComponentTransfer") == false {
    return false
}
if uiIsFeComposite("feComposite") == false {
    return false
}
return uiHostDeleteOk() == false
