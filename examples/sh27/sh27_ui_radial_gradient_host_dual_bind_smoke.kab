import "kab/ui/ui_radial_gradient"
import "kab/ui/ui_linear_gradient"
import "kab/ui/ui_host"

if uiHostDeleteOk() != true {
    return false
}
if uiIsLinearGradient("linearGradient") == false {
    return false
}
if uiIsRadialGradient("radialGradient") == false {
    return false
}
return uiHostDeleteOk() == true
