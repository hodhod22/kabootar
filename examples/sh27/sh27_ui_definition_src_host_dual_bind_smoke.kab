import "kab/ui/ui_definition_src"
import "kab/ui/ui_color_profile"
import "kab/ui/ui_host"

if uiHostDeleteOk() != true {
    return false
}
if uiIsColorProfile("color-profile") != true {
    return false
}
if uiIsDefinitionSrc("definition-src") != true {
    return false
}
return uiHostDeleteOk() == true
