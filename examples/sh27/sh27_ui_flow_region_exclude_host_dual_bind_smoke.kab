import "kab/ui/ui_flow_region_exclude"
import "kab/ui/ui_flow_tref"
import "kab/ui/ui_host"

if uiHostDeleteOk() != true {
    return false
}
if uiIsFlowTref("flowTref") != true {
    return false
}
if uiIsFlowRegionExclude("flowRegionExclude") != true {
    return false
}
return uiHostDeleteOk() == true
