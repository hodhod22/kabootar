import "kab/ui/ui_mprescripts"
import "kab/ui/ui_mmultiscripts"
import "kab/ui/ui_host"

if uiHostDeleteOk() != true {
    return false
}
if uiIsMmultiscripts("mmultiscripts") == false {
    return false
}
if uiIsMprescripts("mprescripts") == false {
    return false
}
return uiHostDeleteOk() == true
