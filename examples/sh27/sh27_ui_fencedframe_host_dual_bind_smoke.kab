import "kab/ui/ui_fencedframe"
import "kab/ui/ui_selectedcontent"
import "kab/ui/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsSelectedcontent("selectedcontent") == false {
    return false
}
if uiIsFencedframe("fencedframe") == false {
    return false
}
return uiHostDeleteOk() == false
