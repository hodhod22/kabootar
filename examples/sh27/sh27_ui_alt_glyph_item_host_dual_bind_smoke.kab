import "kab/ui/ui_alt_glyph_item"
import "kab/ui/ui_alt_glyph_def"
import "kab/ui/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsAltGlyphDef("altGlyphDef") == false {
    return false
}
if uiIsAltGlyphItem("altGlyphItem") == false {
    return false
}
return uiHostDeleteOk() == false
