import "kab/ui/ui_mmultiscripts"
import "kab/ui/ui_munderover"
import "kab/ui/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsMunderover("munderover") == false {
    return false
}
if uiIsMmultiscripts("mmultiscripts") == false {
    return false
}
return uiHostDeleteOk() == false
