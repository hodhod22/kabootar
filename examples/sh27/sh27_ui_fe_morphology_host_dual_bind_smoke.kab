import "kab/ui/ui_fe_morphology"
import "kab/ui/ui_fe_merge_node"
import "kab/ui/ui_host"

if uiHostDeleteOk() != true {
    return false
}
if uiIsFeMergeNode("feMergeNode") == false {
    return false
}
if uiIsFeMorphology("feMorphology") == false {
    return false
}
return uiHostDeleteOk() == true
