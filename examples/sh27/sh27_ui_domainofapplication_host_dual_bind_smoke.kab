import "kab/ui/ui_domainofapplication"
import "kab/ui/ui_false"
import "kab/ui/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsFalse("false") != true {
    return false
}
if uiIsDomainofapplication("domainofapplication") != true {
    return false
}
return uiHostDeleteOk() == false
