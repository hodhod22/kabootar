import "kab/jit_loop_shr"
import "kab/jit_mm_loop_shr"
import "kab/jit_call_loop_shr"

let kind = "rwx"
let n = 12
let sh = 1
let tpl = jitEmitI64LoopShrN(n, sh)
let base = os_mm_mmap(jitMmLoopShrPid(), jitMmLoopShrVirt(), jitMmLoopShrLen(), jitMmLoopShrProt())
return jitCallLoopShrOk(base, kind, n, sh, tpl)
