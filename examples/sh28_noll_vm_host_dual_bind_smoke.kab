import "kab/noll/noll_vm"
import "kab/noll/noll_jit"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollJitIsKab() != false {
    return false
}
if nollVmIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
