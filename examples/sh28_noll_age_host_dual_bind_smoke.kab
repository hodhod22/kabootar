import "kab/noll/noll_age"
import "kab/noll/noll_noise"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollNoiseIsKab() != false {
    return false
}
if nollAgeIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
