import "kab/aot_apply_reloc"
import "kab/aot_emit_image"
import "kab/aot_emit_reloc_table"
import "kab/aot_loaded_image"

let table = aotEmitRelocTableRodataData("arm64")
let image = aotEmitImageWithRelocTableRodataData("arm64")
let patched = aotApplyRelocTableToImageRodataDataHex(image, table, 4096, "arm64")
let hex = aotApplyRelocTableWordHexRodataData(table, 4096, "arm64")
let prefix = "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|"
let mid = "|data:rw|"
let suffix = "|code:arm64:ret|syms:sym:rodata:0:kstr:arm64;sym:data:0:g0:arm64|relocs:reloc:rodata:0:0:kstr:arm64;reloc:data:0:0:g0:arm64"
if patched != prefix + hex + mid + hex + suffix {
    return false
}
return aotLoadedImageOk(patched)
