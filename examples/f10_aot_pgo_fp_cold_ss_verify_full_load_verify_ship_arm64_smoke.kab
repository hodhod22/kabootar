import "kab/aot/aot_verify_image"

if aotPgoOk(8) == false {
    return false
}
if aotFpOk("abc") == false {
    return false
}
if aotColdOk(100) == false {
    return false
}
if aotSteadyOk(16) == false {
    return false
}
if aotImageOk(1) == false {
    return false
}
if aotSealOk("kabootar-native/1", "rx", 0, 4096) == false {
    return false
}
if aotEntryOk(4096) == false {
    return false
}
if aotPageOk(4096) == false {
    return false
}
if aotAlignOk(16) == false {
    return false
}
if aotSectionOk("text") == false {
    return false
}
if aotSectionOk("rodata") == false {
    return false
}
if aotSectionOk("data") == false {
    return false
}
if aotTextProtectOk("rx") == false {
    return false
}
if aotRodataProtectOk("r") == false {
    return false
}
if aotDataProtectOk("rw") == false {
    return false
}
if aotTargetOk("arm64") == false {
    return false
}
if aotAbiOk("arm64", "aapcs64") == false {
    return false
}
if aotLoadCodeOk("code:arm64:ret", "arm64") == false {
    return false
}
if aotVerifyCodeOk("kabootar-arm64.kbn", "code:arm64:ret") == false {
    return false
}
if aotLoadManifestOk("kabootar-native/1|arm64|text:rx|rodata:r|data:rw", "arm64") == false {
    return false
}
if aotVerifyImageOk("kabootar-arm64.kbn", "kabootar-native/1|arm64|text:rx|rodata:r|data:rw") == false {
    return false
}
let image = aotPgoWarmImageWithFpColdSs(8, "abc", 100, 16, "arm64")
let name = aotImageName("arm64")
if aotVerifyFullOk(name, image) == false {
    return false
}
if aotLoadedImageOk(image) == false {
    return false
}
if aotLoadImageWithPgoWarmFpColdSsOk(image, "arm64") == false {
    return false
}
if aotVerifyFullOk(name, image) == false {
    return false
}
return aotShipOk(name, image, "arm64")
