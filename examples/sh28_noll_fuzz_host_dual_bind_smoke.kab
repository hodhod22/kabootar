import "kab/noll/noll_fuzz"
import "kab/noll/noll_cov"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollCovIsKab() != false {
    return false
}
if nollFuzzIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
