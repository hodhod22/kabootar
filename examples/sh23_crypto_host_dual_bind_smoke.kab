import "kab/crypto"
import "kab/crypto/crypto_tls"
import "kab/crypto/crypto_root"
import "kab/crypto/crypto_host"

if cryptoHostDeleteOk() != false {
    return false
}
if cryptoIsHttps("https://example.com") == false {
    return false
}
if cryptoPinOk("sha256:abc") == false {
    return false
}
if cryptoTrustOk(1) == false {
    return false
}
if cryptoTls12Ok("1.2") == false {
    return false
}
if cryptoRootPem("-----BEGIN CERTIFICATE-----\nAQ==\n-----END CERTIFICATE-----") == false {
    return false
}
return cryptoHostDeleteOk() == false
