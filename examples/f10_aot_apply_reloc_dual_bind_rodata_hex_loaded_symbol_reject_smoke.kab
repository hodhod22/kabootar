import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_bind"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"
import "kab/aot/aot_loaded_image"

let table = aotEmitRelocTableRodata("x64")
let image = aotEmitImageWithRelocTableRodata("x64")
let patched = aotApplyRelocTableToImageRodataHex(image, table, 4096, "x64")
if aotLoadedImageOk(patched) == false {
    return false
}
let addr = aotApplyRelocTableAddressRodata(table, 4096, "x64")
return aotRelocSymbolBindOk(addr, 4128) == false
