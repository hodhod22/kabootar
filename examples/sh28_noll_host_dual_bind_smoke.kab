import "kab/noll"
import "kab/noll/noll_aot"
import "kab/noll/noll_keep"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAllHostGatesClosed() == false {
    return false
}
if nollSrcGoal() != 0 {
    return false
}
if nollRustcStillHost() == false {
    return false
}
if nollBootstrapFromKab() == false {
    return false
}
if nollKeepSrc() == false {
    return false
}
if nollAotReady() {
    return false
}
return nollHostDeleteOk() == false
