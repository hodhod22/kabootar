import "kab/noll/noll_dhcp"
import "kab/noll/noll_snmp"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollSnmpIsKab() != false {
    return false
}
if nollDhcpIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
