import "kab/sql/sql_group"
import "kab/sql/sql_join"
import "kab/sql/sql_host"

if sqlHostDeleteOk() != false {
    return false
}
if sqlIsJoin("SELECT a FROM t JOIN u") == false {
    return false
}
if sqlIsGroup("SELECT a FROM t GROUP BY a") == false {
    return false
}
return sqlHostDeleteOk() == false
