// H6e: bootstrap policy in Kab — self_host lexer/compile + Kab evalSource
// cargo run --bin kabootar -- examples/h6e_boot_policy_smoke.kab

import "kab/boot"
import "kv8/eval"

preferSelfHostCompile()
let pipeOk = bootPipelineOk()
let lexOk = len(bootTokenize("let a = 1")) > 2
let kbcOk = isBytecode(bootCompile("return 42"))

preferKabEval()
let evalOk = evalSource("1 + 2") == 3
let classOk = evalSource("class Box { constructor(n) { this.n = n } } new Box(7).n") == 7

println("h6e pipe=" + pipeOk + " lex=" + lexOk + " kbc=" + kbcOk + " eval=" + evalOk + " class=" + classOk)
return pipeOk && lexOk && kbcOk && evalOk && classOk && selfHostPreferred()
