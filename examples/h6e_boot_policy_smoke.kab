// H6e: bootstrap policy in Kab — self_host lexer/compile + Kab evalSource
// cargo run --bin kabootar -- examples/h6e_boot_policy_smoke.kab

import "kab/boot"
import "kv8/eval"

preferSelfHostCompile()
let pipeOk = bootPipelineOk()
let lexOk = len(bootTokenize("let a = 1")) > 2
let kbcOk = isBytecode(bootCompile("return 42"))

preferKabEval()
let evalOk = evalSource("1 + 2") == 3
let classOk = evalSource("class Box { constructor(n) { this.n = n } } new Box(7).n") == 7
let polOk = bootPolicy("skip") == "attempt-all" && bootPolicy("maxBytes") == 65536 && bootPolicy("prefer") == "self-host-only" && bootPolicy("appRustFallback") == false && bootPolicy("kbcHeader") == "kabootar-bytecode/1" && bootPolicy("rustFallbackPrefix") == "self_host/"
let attemptOk = bootPolicy("shouldSelfHost", 100) && !bootPolicy("shouldSelfHost", 70000) && !bootPolicy("shouldSelfHost", 0)

println("h6e pipe=" + pipeOk + " lex=" + lexOk + " kbc=" + kbcOk + " eval=" + evalOk + " class=" + classOk + " pol=" + polOk)
return pipeOk && lexOk && kbcOk && evalOk && classOk && selfHostPreferred() && polOk && attemptOk
