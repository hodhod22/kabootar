import "kab/noll_oidc"
import "kab/noll_oauth"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollOauthIsKab() != false {
    return false
}
if nollOidcIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
