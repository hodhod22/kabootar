import "kab/std_colchunk"
import "kab/std_colwin"
import "kab/std_colslice"
import "kab/std_colrange"
import "kab/std_coleq"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let r = stdColRange(40, 44)
let w = stdColWindow(r, 2)
if len(w) != 3 {
    return false
}
let c = stdColChunk(r, 2)
if len(c) != 2 {
    return false
}
if stdColEq(c[0], stdColSlice(r, 0, 2)) == false {
    return false
}
return stdHostDeleteOk() == false
