import "kab/jit/jit_native_loop_simd"
import "kab/jit/jit_loop_n"
import "kab/jit/jit_mm_loop_n"
import "kab/jit/jit_call_loop_n"

let nPhi = 1
let nInv = 1
let nDup = 1
let nGuard = 1
let kind = "i64"
let marked = true
let same = true
let nLive = 2
let nBytes = 16
let n = 16
if jitNativeLoopSimdOk(nPhi, nInv, nDup, nGuard, kind, marked, same, nLive, nBytes, n) == false {
    return false
}
let rwx = "rwx"
let tpl = jitEmitI64LoopN(n)
let base = os_mm_mmap(jitMmLoopNPid(), jitMmLoopNVirt(), jitMmLoopNLen(), jitMmLoopNProt())
return jitCallLoopNOk(base, rwx, n, tpl)
