import "kab/noll/noll_ws"
import "kab/noll/noll_http"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollHttpIsKab() != false {
    return false
}
if nollWsIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
