// G11 kOS / VFS smoke — kabootar:// navigation + paint via the kbrowser Kab surface.
// navigate() → navGo → navApplyMode auto-picks "kabootar" mode for kabootar://.
import "kbrowser/core"
import "kbrowser/nav"

fn layerCount(frame) {
    return len(frame["layers"])
}

os_mkdir("/apps")
os_write("/apps/g11.kml", "<html><body><h1>kOS G11</h1></body></html>")
navigate("kabootar://vfs/apps/g11.kml")
let html = kb_render()
let frame = paint()
println("kos ok url=" + navUrl() + " layers=" + layerCount(frame))
return html
