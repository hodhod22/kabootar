import "kab/ui/ui_color_profile"
import "kab/ui/ui_animate_color"
import "kab/ui/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsAnimateColor("animateColor") != true {
    return false
}
if uiIsColorProfile("color-profile") != true {
    return false
}
return uiHostDeleteOk() == false
