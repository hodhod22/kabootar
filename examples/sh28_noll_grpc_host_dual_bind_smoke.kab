import "kab/noll_grpc"
import "kab/noll_sctp"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollSctpIsKab() != false {
    return false
}
if nollGrpcIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
