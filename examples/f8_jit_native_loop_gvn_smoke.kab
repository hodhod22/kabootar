import "kab/jit/jit_native_loop_gvn"
import "kab/jit/jit_loop_n"
import "kab/jit/jit_mm_loop_n"
import "kab/jit/jit_call_loop_n"

let nPhi = 1
let nInv = 1
let nDup = 1
let n = 16
if jitNativeLoopGvnOk(nPhi, nInv, nDup, n) == false {
    return false
}
let kind = "rwx"
let tpl = jitEmitI64LoopN(n)
let base = os_mm_mmap(jitMmLoopNPid(), jitMmLoopNVirt(), jitMmLoopNLen(), jitMmLoopNProt())
return jitCallLoopNOk(base, kind, n, tpl)
