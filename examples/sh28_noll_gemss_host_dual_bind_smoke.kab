import "kab/noll_gemss"
import "kab/noll_rainbow"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollRainbowIsKab() != false {
    return false
}
if nollGemssIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
