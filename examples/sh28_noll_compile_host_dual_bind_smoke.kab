import "kab/noll/noll_compile"
import "kab/noll/noll_gc"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollGcIsKab() != false {
    return false
}
if nollCompileIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
