import "kab/aot_apply_reloc"
import "kab/aot_emit_image"
import "kab/aot_emit_reloc_table"
import "kab/aot_image_name"
import "kab/aot_load_image"
import "kab/aot_loaded_image"
import "kab/aot_ship"
import "kab/aot_verify_full"

let table = aotEmitRelocTableData("arm64")
let image = aotEmitImageWithRelocTableData("arm64")
let patched = aotApplyRelocTableToImageData(image, table, 4096, "arm64")
let name = aotImageName("arm64")
if aotLoadImageWithRelocWordDataOk(patched, "arm64") == false {
    return false
}
if aotLoadedImageOk(patched) == false {
    return false
}
if aotVerifyFullOk(name, patched) == false {
    return false
}
return aotShipOk(name, patched, "arm64")
