import "kab/std_colfill"
import "kab/std_colrepeat"
import "kab/std_collen"
import "kab/std_collast"
import "kab/std_col"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let p = stdColPair("n", 42)
let r = stdColRepeat(p, 2)
let f = stdColFill(2, 42)
if stdColLen(r) != 4 {
    return false
}
if stdColLast(f) != 42 {
    return false
}
return stdHostDeleteOk() == false
