import "kab/std_colmv"
import "kab/std_coldot"
import "kab/std_colident"
import "kab/std_colfill"
import "kab/std_coleq"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let v = stdColFill(2, 1)
if stdColDot(v, v) != 2 {
    return false
}
if stdColEq(stdColMatVec(stdColIdent(2), v), v) == false {
    return false
}
return stdHostDeleteOk() == false
