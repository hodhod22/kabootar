import "kab/sql_dist"
import "kab/sql_having"
import "kab/sql_host"

if sqlHostDeleteOk() != false {
    return false
}
if sqlIsHaving("SELECT a FROM t HAVING n = 1") == false {
    return false
}
if sqlIsDistinct("SELECT DISTINCT a FROM t") == false {
    return false
}
return sqlHostDeleteOk() == false
