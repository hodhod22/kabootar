import "kab/noll_clean"
import "kab/noll_watch"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollWatchIsKab() != false {
    return false
}
if nollCleanIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
