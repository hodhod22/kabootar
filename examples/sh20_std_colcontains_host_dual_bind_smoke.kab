import "kab/std/std_colcontains"
import "kab/std/std_colrev"
import "kab/std/std_colfirst"
import "kab/std/std_col"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let p = stdColPair("n", 42)
let r = stdColRev(p)
if stdColContains(p, 42) != true {
    return false
}
if stdColFirst(r) != 42 {
    return false
}
return stdHostDeleteOk() == false
