import "kab/ui_definition_src"
import "kab/ui_color_profile"
import "kab/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsColorProfile("color-profile") != true {
    return false
}
if uiIsDefinitionSrc("definition-src") != true {
    return false
}
return uiHostDeleteOk() == false
