import "kab/aot_apply_reloc"
import "kab/aot_bind"
import "kab/aot_emit_image"
import "kab/aot_emit_reloc_table"
import "kab/aot_image_name"
import "kab/aot_loaded_image"
import "kab/aot_ship"

let table = aotEmitRelocTableRodata("arm64")
let image = aotEmitImageWithRelocTableRodata("arm64")
let patched = aotApplyRelocTableToImageRodataHex(image, table, 4096, "arm64")
if aotLoadedImageOk(patched) == false {
    return false
}
let addr = aotApplyRelocTableAddressRodata(table, 4096, "arm64")
if aotRelocSymbolBindOk(addr, 4096) == false {
    return false
}
let name = aotImageName("arm64")
return aotShipOk(name, patched, "arm64")
