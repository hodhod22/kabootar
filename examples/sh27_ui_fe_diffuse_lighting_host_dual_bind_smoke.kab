import "kab/ui_fe_diffuse_lighting"
import "kab/ui_fe_convolve_matrix"
import "kab/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsFeConvolveMatrix("feConvolveMatrix") == false {
    return false
}
if uiIsFeDiffuseLighting("feDiffuseLighting") == false {
    return false
}
return uiHostDeleteOk() == false
