import "kab/aot_apply_reloc"
import "kab/aot_emit_image"
import "kab/aot_emit_reloc_table"
import "kab/aot_loaded_image"

let table = aotEmitRelocTableRodataData("x64")
let image = aotEmitImageWithRelocTableRodataData("x64")
let patched = aotApplyRelocTableToImageRodataDataHex(image, table, 4096, "arm64")
let hex = aotApplyRelocTableWordHexRodataData(table, 4096, "arm64")
let loaded = aotLoadedImageOk(patched)
if patched != "" {
    return false
}
if hex != "" {
    return false
}
return loaded == false
