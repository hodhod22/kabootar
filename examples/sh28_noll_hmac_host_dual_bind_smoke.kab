import "kab/noll/noll_hmac"
import "kab/noll/noll_hkdf"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollHkdfIsKab() != false {
    return false
}
if nollHmacIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
