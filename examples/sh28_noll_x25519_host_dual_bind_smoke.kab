import "kab/noll_x25519"
import "kab/noll_poly"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollPolyIsKab() != false {
    return false
}
if nollX25519IsKab() != false {
    return false
}
return nollHostDeleteOk() == false
