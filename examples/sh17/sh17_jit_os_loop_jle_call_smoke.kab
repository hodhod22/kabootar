import "kab/jit/jit_loop_jle"
import "kab/jit/jit_mm_loop_jle"
import "kab/jit/jit_call_loop_jle"

let kind = "rwx"
let n = 12
let k = 12
let tpl = jitEmitI64LoopJleN(n, k)
