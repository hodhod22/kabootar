// SH17: compile trigger through the REAL ops loop — a hot monomorphic call
// site whose callee body is the fusible arith chain compiles after
// jitThreshold(8) hits with pct>=90: vJitClassifyS → vJitMaybeCompileS →
// vJitOpsOfRec extracts the fn's own ops into the jitOps descriptor → the
// fused lowering (jitFromOpsAnyExecOk + mirror) runs instead of a frame.

// fus computes ((a + b - c) * d / e) % f — exactly the fused L-chain shape.
fn fus(a, b, c, d, e, f) {
    return ((a + b - c) * d / e) % f
}

// Drive the site hot: the `call` op at this ip sees fus 12 times.
let acc = 0
let i = 0
while i < 12 {
    acc = fus(16, 3, 2, 4, 2, 5)
    i = i + 1
}
// ((16+3-2)*4/2)%5 = (17*4/2)%5 = 34%5 = 4 — same value either path.
if acc != 4 {
    return 1
}

// A second site (different ip) is cold — still computes via frames.
let cold = fus(16, 3, 2, 4, 2, 5)
if cold != 4 {
    return 3
}

// Non-fusible fn stays interpreted even when hot.
fn dbl(x) {
    return x * 2
}
let j = 0
let dsum = 0
while j < 12 {
    dsum = dbl(21)
    j = j + 1
}
if dsum != 42 {
    return 4
}

// Cmp predicate chain: `return a < b` is the 4-op shape → jitOps
// [const,const,lt,jump_if_true,ret], jitArity 2.
fn lessthan(a, b) {
    return a < b
}
let li = 0
let lacc = 0
while li < 12 {
    if lessthan(3, 9) {
        lacc = lacc + 1
    }
    li = li + 1
}
if lacc != 12 {
    return 5
}

// Negated cmp chain: `return not (a < b)` adds the `not` op → the
// jump_if_false descriptor folds the negation into the predicate.
fn notless(a, b) {
    return not (a < b)
}
let ni = 0
let nacc = 0
while ni < 12 {
    if notless(9, 3) {
        nacc = nacc + 1
    }
    ni = ni + 1
}
if nacc != 12 {
    return 6
}

// Two-arg arith chain: `return a * b` is the 4-op shape → jitOps
// [const,const,fmul,ret] — the f64 guest template (kind 3). Iteration 10
// feeds an out-of-domain arg (k > 64) THROUGH the compiled site: exec
// rejects and deopts to fb, so the value still lands right.
fn pairmul(a, b) {
    return a * b
}
let pi = 0
let pacc = 0
while pi < 12 {
    // One call-site ip: iteration 10 swaps the args in place, so the OOD
    // call flows through the compiled jit callee → exec rejects → deopt
    // via fb — the frame path still yields the right value.
    let pa = 6
    let pb = 7
    if pi == 10 {
        pa = 2
        pb = 100
    }
    pacc = pairmul(pa, pb)
    if pacc != pa * pb {
        return 7
    }
    pi = pi + 1
}
// `mod` has no f64 template — `return a % b` stays on the frame path
// even when hot (extraction returns null, jitChecked marks the rec).
fn pairmod(a, b) {
    return a % b
}
let mi = 0
let macc = 0
while mi < 12 {
    macc = pairmod(46, 4)
    mi = mi + 1
}
if macc != 2 {
    return 9
}

return 42
