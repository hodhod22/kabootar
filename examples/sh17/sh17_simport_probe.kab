// SH17 probe (manual, not a CI gate): S-resident import binding. With
// KAB_VM_SIMPORT=1 the imported module's fns run on this VM session — their
// loop back-edges arm OSR headers and feed the JIT counters. Without the
// flag the same import binds via the host bridge and steps stay ~0.

import "self_host/vm_run_exec_core"
import "kab/vm"

vJitSessionReset()

let src = "import \"examples/sh17/sh17_simport_dep\"\nreturn depSum(50) + depMul(2, 3)"
let out = evalSourceKabVm(src)
println("out=" + out + " (expect 1231)")

let st = vJitSessionStats()
println("JIT steps=" + st["steps"])
println("JIT headers=" + st["headers"])
println("JIT backEdges=" + st["backEdges"])
println("JIT armed=" + st["armed"])
println("JIT osrExecs=" + st["osrExecs"])
println("JIT osrMisses=" + st["osrMisses"])
println("JIT countLoops=" + st["countLoops"])
println("JIT compiled=" + st["compiled"])
println("JIT execs=" + st["execs"])

return 0
