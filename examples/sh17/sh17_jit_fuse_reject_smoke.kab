import "kab/jit/jit_from_ops_fuse"

let ops = ["const", "add", "sub", "mul", "div", "mod", "ret"]
if jitFuseOpsOk(["const", "add", "ret"]) {
    return false
}
if jitFromOpsFuseOk(["const", "add", "ret"], 16, 3, 0, 0, 0, 0) {
    return false
}
if jitFromOpsFuseOk(["const", "add", "call", "mul", "div", "mod", "ret"], 16, 3, 2, 4, 2, 5) {
    return false
}
if jitFromOpsFuseOk(ops, 0, 3, 0, 0, 0, 0) {
    return false
}
if jitFromOpsFuseOk(ops, 4, 0, 10, 0, 0, 0) {
    return false
}
return true