import "kab/jit/jit_loop_jl"
import "kab/jit/jit_mm_loop_jl"
import "kab/jit/jit_call_loop_jl"

let kind = "rwx"
let n = 10
let k = 12
let tpl = jitEmitI64LoopJlN(n, k)
let base = os_mm_mmap(jitMmLoopJlPid(), jitMmLoopJlVirt(), jitMmLoopJlLen(), jitMmLoopJlProt())
return jitCallLoopJlOk(base, kind, n, k, tpl)
