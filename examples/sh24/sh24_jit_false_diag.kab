fn retFalse() {
    return false
}
fn retTrue() {
    return true
}
fn retZero() {
    return 0
}
fn retFalse2() {
    let x = false
    return x
}

let r = 0
while r < 12 {
    let a = retFalse()
    let b = retTrue()
    let c = retZero()
    let d = retFalse2()
    println("r=" + r + " a=" + a + " b=" + b + " c=" + c + " d=" + d)
    r = r + 1
}
return true
