import "kab/noll_kev"
import "kab/noll_nvd"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollNvdIsKab() != false {
    return false
}
if nollKevIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
