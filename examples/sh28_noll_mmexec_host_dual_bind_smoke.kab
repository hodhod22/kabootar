import "kab/noll_mmexec"
import "kab/noll_mmap"
import "kab/noll_imgproc"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollMmapStub() != false {
    return false
}
if nollImageIsProcess() != false {
    return false
}
if nollMmapExecProcess() != false {
    return false
}
return nollHostDeleteOk() == false
