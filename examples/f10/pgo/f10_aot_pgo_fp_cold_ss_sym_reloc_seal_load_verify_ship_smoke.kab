import "kab/aot/aot_cd"
import "kab/aot/aot_fp"
import "kab/aot/aot_image_name"
import "kab/aot/aot_img"
import "kab/aot/aot_load_image"
import "kab/aot/aot_loaded_image"
import "kab/aot/aot_pgo"
import "kab/aot/aot_reloc"
import "kab/aot/aot_seal"
import "kab/aot/aot_ship"
import "kab/aot/aot_ss"
import "kab/aot/aot_sym"
import "kab/aot/aot_verify_full"

if aotPgoOk(8) == false {
    return false
}
if aotFpOk("abc") == false {
    return false
}
if aotColdOk(100) == false {
    return false
}
if aotSteadyOk(16) == false {
    return false
}
if aotSymbolRecordOk("main", 32, "x64") == false {
    return false
}
if aotRelocRecordOk(4096, 32, "main", "x64") == false {
    return false
}
if aotImageOk(1) == false {
    return false
}
if aotSealOk("kabootar-native/1", "rx", 0, 4096) == false {
    return false
}
let image = aotPgoWarmImageWithFpColdSsSymReloc(8, "abc", 100, 16, "x64")
if aotLoadedImageOk(image) == false {
    return false
}
if aotLoadImageWithPgoWarmFpColdSsSymRelocOk(image, "x64") == false {
    return false
}
let name = aotImageName("x64")
if aotVerifyFullOk(name, image) == false {
    return false
}
return aotShipOk(name, image, "x64")
