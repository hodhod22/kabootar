import "kab/aot/aot_lazy_boot_dag_named"
import "kab/jit/jit_loop_n"
import "kab/jit/jit_mm_loop_n"
import "kab/jit/jit_call_loop_n"

let ms = 100
let remKind = "jit"
let nHits = 8
let nPhi = 1
let nInv = 1
let nDup = 1
let nGuard = 1
let kind = "i64"
let marked = true
let same = true
let nLive = 3
let nBytes = 16
let n = 16
let na = 16
let nb = 16
let nBoot = 2
let nRest = 6
let nMods = 8
let bootName = "app"
if aotLazyBootDagNamedOk(ms, remKind, nHits, nPhi, nInv, nDup, nGuard, kind, marked, same, nLive, nBytes, n, na, nb, nBoot, nRest, nMods, bootName) == false {
    return false
}
let rwx = "rwx"
let tpl = jitEmitI64LoopN(n)
let base = os_mm_mmap(jitMmLoopNPid(), jitMmLoopNVirt(), jitMmLoopNLen(), jitMmLoopNProt())
return jitCallLoopNOk(base, rwx, n, tpl)
