import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_bind"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"

let table = aotEmitRelocTableRodataData("x64")
let image = aotEmitImageWithRelocTableRodataData("x64")
let addr = aotApplyRelocTableAddressRodataData(table, -1, "x64")
let hex = aotApplyRelocTableWordHexRodataData(table, -1, "x64")
let patched = aotApplyRelocTableToImageRodataDataHex(image, table, -1, "x64")
if addr != -1 {
    return false
}
if hex != "" {
    return false
}
if patched != "" {
    return false
}
return aotRelocSymbolBindOk(addr, 4096) == false
