import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"

let table = aotEmitRelocTableRodata("arm64")
let image = aotEmitImageWithRelocTableRodata("arm64")
let patched = aotApplyRelocTableToImageRodataHex(image, table, 4096, "arm64")
let addr = aotApplyRelocTableAddressRodata(table, 4096, "arm64")
let hex = aotApplyRelocTableWordHexRodata(table, 4096, "arm64")
if addr != 4096 {
    return false
}
if hex != "0010000000000000" {
    return false
}
let prefix = "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|"
let suffix = "|data:rw|code:arm64:ret|sym:rodata:0:kstr:arm64|relocs:reloc:rodata:0:0:kstr:arm64"
return patched == prefix + hex + suffix
