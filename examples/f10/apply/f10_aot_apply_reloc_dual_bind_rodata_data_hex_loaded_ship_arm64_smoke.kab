import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_bind"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"
import "kab/aot/aot_image_name"
import "kab/aot/aot_loaded_image"
import "kab/aot/aot_ship"

let table = aotEmitRelocTableRodataData("arm64")
let image = aotEmitImageWithRelocTableRodataData("arm64")
let patched = aotApplyRelocTableToImageRodataDataHex(image, table, 4096, "arm64")
if aotLoadedImageOk(patched) == false {
    return false
}
let addr = aotApplyRelocTableAddressRodataData(table, 4096, "arm64")
if aotRelocSymbolBindOk(addr, 4096) == false {
    return false
}
let name = aotImageName("arm64")
return aotShipOk(name, patched, "arm64")
