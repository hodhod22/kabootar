import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"

let table = aotEmitRelocTableRodata("x64")
let image = aotEmitImageWithRelocTableRodata("x64")
return aotApplyRelocTableToImageRodataHex(image, table, 4096, "x64") == "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|0010000000000000|data:rw|code:x64:ret|sym:rodata:0:kstr:x64|relocs:reloc:rodata:0:0:kstr:x64"
