import "kab/std_colindex"
import "kab/std_colcontains"
import "kab/std_col"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let p = stdColPair("n", 42)
if stdColContains(p, 42) != true {
    return false
}
if stdColIndex(p, 42) != 1 {
    return false
}
return stdHostDeleteOk() == false
