import "kab/jit/jit_loop_jge"
import "kab/jit/jit_mm_loop_jge"
import "kab/jit/jit_call_loop_jge"

let kind = "rwx"
let n = 12
let k = 12
let tpl = jitEmitI64LoopJgeN(n, k)
