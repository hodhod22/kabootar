import "kab/http/http_fetch"
import "kab/crypto/crypto_http_fetch_bind13"

async fn load() {
    let hdr = {}
    hdr["Proxy-Authorization"] = "Basic x"
    let via = await httpFetch("GET", "https://127.0.0.1:28198/v?q=1", "", hdr, 0)
    if via == false {
        return false
    }
    if http_status(via) != 200 {
        return false
    }
    if http_body(via) != "OK" {
        return false
    }
    return true
}

await load()
