import "kab/os"
import "kab/os/os_fs"
import "kab/os/os_proc"
import "kab/os/os_host"

if kabOsHostDeleteOk() != false {
    return false
}
if kabOsIsVfs("/apps/note.txt") == false {
    return false
}
if kabOsCapRead() == false {
    return false
}
if kabOsCapWrite() == false {
    return false
}
if kabOsIsFile("app.kab") == false {
    return false
}
if kabOsArgvOk(1) == false {
    return false
}
return kabOsHostDeleteOk() == false
