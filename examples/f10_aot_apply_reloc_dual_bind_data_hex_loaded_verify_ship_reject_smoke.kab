import "kab/aot_apply_reloc"
import "kab/aot_bind"
import "kab/aot_emit_image"
import "kab/aot_emit_reloc_table"
import "kab/aot_loaded_image"
import "kab/aot_verify_full"

let table = aotEmitRelocTableData("x64")
let image = aotEmitImageWithRelocTableData("x64")
let patched = aotApplyRelocTableToImageDataHex(image, table, 4096, "x64")
if aotLoadedImageOk(patched) == false {
    return false
}
let addr = aotApplyRelocTableAddressData(table, 4096, "x64")
if aotRelocSymbolBindOk(addr, 4096) == false {
    return false
}
return aotVerifyFullOk("kabootar-arm64.kbn", patched) == false
