import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"

let table = aotEmitRelocTableData("x64")
let image = aotEmitImageWithRelocTableData("x64")
return aotApplyRelocTableToImageDataHex(image, table, 4096, "x64") == "kabootar-native/1|x64|abi:win64|entry:0|page:4096|text:rx|rodata:r|data:rw|0010000000000000|code:x64:ret|sym:data:0:g0:x64|relocs:reloc:data:0:0:g0:x64"
