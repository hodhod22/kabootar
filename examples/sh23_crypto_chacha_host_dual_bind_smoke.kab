import "kab/crypto/crypto_chacha"
import "kab/crypto/crypto_aes"
import "kab/crypto/crypto_host"

if cryptoHostDeleteOk() != false {
    return false
}
if cryptoAes256Ok("aes-256") == false {
    return false
}
if cryptoChaChaOk("chacha20") == false {
    return false
}
return cryptoHostDeleteOk() == false
