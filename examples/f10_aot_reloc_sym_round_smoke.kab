import "kab/aot/aot_reloc"
import "kab/aot/aot_sym"
import "kab/aot/aot_bind"

if aotRelocRecordOk(4096, 32, "main", "x64") == false {
    return false
}
if aotSymbolRecordOk("main", 32, "x64") == false {
    return false
}
if aotRelocTableEntryAddress(4096, 32, "main", "x64") != 4128 {
    return false
}
if aotRelocTableEntryAddress(4096, 32, "main", "x64") != aotSymbolTableEntryAddress(4096, "main", 32, "x64") {
    return false
}
if aotRelocSectionEntryAddress(4096, "text", 32, "main", "x64") != 4128 {
    return false
}
if aotRelocSectionEntryAddress(4096, "text", 32, "main", "x64") != aotSymbolSectionEntryAddress(4096, "text", "main", 32, "x64") {
    return false
}
if aotRelocTablePatchedAddress(4096, 32, 8, "main", "x64") != 4136 {
    return false
}
if aotSymbolTableEntryAddress(4096, "main", 32, "wasm") != -1 {
    return false
}
if aotRelocSymbolBindOk(4128, 4128) == false {
    return false
}
return aotRelocAddress(4096, 32) == aotSymbolAddress(4096, "main", 32)
