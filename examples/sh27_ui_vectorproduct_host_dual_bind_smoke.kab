import "kab/ui_vectorproduct"
import "kab/ui_cartesianproduct"
import "kab/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsCartesianproduct("cartesianproduct") != true {
    return false
}
if uiIsVectorproduct("vectorproduct") != true {
    return false
}
return uiHostDeleteOk() == false
