// K3 subset: VFS mount/write/read (+ sched stub available via os/sched)
// cargo run --bin kabootar -- examples/os_k3_vfs_smoke.kab

import "os/vfs"
import "os/mount"
import "os/sched"

mkdir("/k3")
write("/k3/hello.txt", "k3-ok")
let body = read("/k3/hello.txt")
let m = mounts()
enqueue("k3-tick")
let t = tick()
println("os k3 vfs: body=" + body + " mounts=" + len(m) + " tick=" + t)
return body == "k3-ok" && exists("/k3/hello.txt")
