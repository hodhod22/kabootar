import "kab/std_coldist"
import "kab/std_colrej"
import "kab/std_colfill"
import "kab/std_colpush"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let a = stdColFill(1, 42)
a = stdColPush(a, 21)
let b = stdColFill(1, 1)
b = stdColPush(b, 0)
let r = stdColRej(a, b)
if r[1] != 21 {
    return false
}
let p = stdColFill(1, 42)
p = stdColPush(p, 0)
let z = stdColFill(1, 0)
z = stdColPush(z, 0)
if stdColDist(p, z) != 42 {
    return false
}
return stdHostDeleteOk() == false
