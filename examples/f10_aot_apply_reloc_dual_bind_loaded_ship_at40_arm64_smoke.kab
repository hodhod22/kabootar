import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_bind"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"
import "kab/aot/aot_image_name"
import "kab/aot/aot_loaded_image"
import "kab/aot/aot_ship"

let table = aotEmitRelocTable("arm64")
let image = aotEmitImageWithTables("arm64")
let patched = aotApplyRelocTableToImageTextAt40(image, table, 4096, "arm64")
let loaded = aotLoadedImageOk(patched)
if loaded == false {
    return false
}
let addr32 = aotApplyRelocTableAddressAt32(table, 4096, "arm64")
let addr40 = aotApplyRelocTableAddressAt40(table, 4096, "arm64")
let bind32 = aotRelocSymbolBindOk(addr32, 4128)
let bind40 = aotRelocSymbolBindOk(addr40, 4136)
if bind32 == false {
    return false
}
if bind40 == false {
    return false
}
let name = aotImageName("arm64")
return aotShipOk(name, patched, "arm64")
