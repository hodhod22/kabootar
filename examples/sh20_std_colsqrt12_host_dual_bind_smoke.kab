import "kab/std_colsqrt12"
import "kab/std_colsqrt2"
import "kab/std_colfill"
import "kab/std_colpush"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let a = stdColFill(1, 7)
a = stdColPush(a, 0)
let q = stdColSqrt2(a)
if q[0] != sqrt2() {
    return false
}
let h = stdColSqrt12(a)
if h[0] != sqrt1_2() {
    return false
}
return stdHostDeleteOk() == false
