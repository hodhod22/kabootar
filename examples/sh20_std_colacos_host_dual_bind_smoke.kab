import "kab/std_colacos"
import "kab/std_colasin"
import "kab/std_colfill"
import "kab/std_colpush"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let h = stdColFill(1, 0.0)
h = stdColPush(h, 0)
let k = stdColAsin(h)
if k[0] != 0 {
    return false
}
let g = stdColFill(1, 1.0)
g = stdColPush(g, 0)
let w = stdColAcos(g)
if w[0] != 0 {
    return false
}
return stdHostDeleteOk() == false
