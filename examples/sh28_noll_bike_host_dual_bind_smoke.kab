import "kab/noll_bike"
import "kab/noll_mceliece"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollMcelieceIsKab() != false {
    return false
}
if nollBikeIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
