// G7 mobile smoke — viewport / DPR / safe area / touch via kbrowser/mobile_chrome (no device CI).
import "kbrowser/mobile_chrome"

let vp = applyPhoneViewport()
let sa = applySafeArea()
kb_paint()
kb_touch_at(12, 24, "start")
let ev = kb_poll_events()
println("orient=" + vp["orientation"] + " dpr=" + vp["dpr"] + " safeTop=" + sa["top"] + " events=" + len(ev))
return ev
