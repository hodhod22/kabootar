import "kab/std/std_colln10"
import "kab/std/std_colln2"
import "kab/std/std_colfill"
import "kab/std/std_colpush"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let a = stdColFill(1, 7)
a = stdColPush(a, 0)
let n = stdColLn2(a)
if n[0] != ln2() {
    return false
}
let t = stdColLn10(a)
if t[0] != ln10() {
    return false
}
return stdHostDeleteOk() == false
