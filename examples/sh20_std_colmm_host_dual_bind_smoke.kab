import "kab/std/std_colmm"
import "kab/std/std_colmv"
import "kab/std/std_colident"
import "kab/std/std_colfill"
import "kab/std/std_coleq"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let v = stdColFill(2, 1)
let i2 = stdColIdent(2)
if stdColEq(stdColMatVec(i2, v), v) == false {
    return false
}
if stdColEq(stdColMatMul(i2, i2), i2) == false {
    return false
}
return stdHostDeleteOk() == false
