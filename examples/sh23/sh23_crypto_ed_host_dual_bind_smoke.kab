import "kab/crypto/crypto_ed"
import "kab/crypto/crypto_gcm"
import "kab/crypto/crypto_host"

if cryptoHostDeleteOk() != false {
    return false
}
if cryptoGcmOk("aes-256-gcm") == false {
    return false
}
if cryptoEd25519Ok("ed25519") == false {
    return false
}
return cryptoHostDeleteOk() == false
