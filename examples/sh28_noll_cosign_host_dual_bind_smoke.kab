import "kab/noll/noll_cosign"
import "kab/noll/noll_signify"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollSignifyIsKab() != false {
    return false
}
if nollCosignIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
