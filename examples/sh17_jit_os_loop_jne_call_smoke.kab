import "kab/jit/jit_loop_jne"
import "kab/jit/jit_mm_loop_jne"
import "kab/jit/jit_call_loop_jne"

let kind = "rwx"
let n = 12
let k = 10
let tpl = jitEmitI64LoopJneN(n, k)
let base = os_mm_mmap(jitMmLoopJnePid(), jitMmLoopJneVirt(), jitMmLoopJneLen(), jitMmLoopJneProt())
return jitCallLoopJneOk(base, kind, n, k, tpl)
