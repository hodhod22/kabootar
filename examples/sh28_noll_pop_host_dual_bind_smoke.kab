import "kab/noll_pop"
import "kab/noll_imap"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollImapIsKab() != false {
    return false
}
if nollPopIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
