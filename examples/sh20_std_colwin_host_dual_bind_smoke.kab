import "kab/std/std_colwin"
import "kab/std/std_colslice"
import "kab/std/std_colrange"
import "kab/std/std_colfill"
import "kab/std/std_colpush"
import "kab/std/std_coleq"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let r = stdColRange(40, 44)
let e = stdColFill(1, 41)
e = stdColPush(e, 42)
if stdColEq(stdColSlice(r, 1, 3), e) == false {
    return false
}
let w = stdColWindow(r, 2)
if len(w) != 3 {
    return false
}
if stdColEq(w[0], stdColSlice(r, 0, 2)) == false {
    return false
}
return stdHostDeleteOk() == false
