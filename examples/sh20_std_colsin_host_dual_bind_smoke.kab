import "kab/std/std_colsin"
import "kab/std/std_colexp"
import "kab/std/std_colfill"
import "kab/std/std_colpush"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let h = stdColFill(1, 0.0)
h = stdColPush(h, 0)
let k = stdColExp(h)
if k[0] != 1 {
    return false
}
let g = stdColFill(1, 0.0)
g = stdColPush(g, 0)
let w = stdColSin(g)
if w[0] != 0 {
    return false
}
return stdHostDeleteOk() == false
