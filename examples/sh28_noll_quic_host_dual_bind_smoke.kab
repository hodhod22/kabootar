import "kab/noll/noll_quic"
import "kab/noll/noll_udp"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollUdpIsKab() != false {
    return false
}
if nollQuicIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
