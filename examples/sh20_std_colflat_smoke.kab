import "kab/std/std_colflat"
import "kab/std/std_colzip"
import "kab/std/std_coltake"
import "kab/std/std_coldrop"
import "kab/std/std_collast"
import "kab/std/std_col"

let p = stdColPair("n", 42)
let z = stdColZip(stdColTake(p, 1), stdColDrop(p, 1))
let f = stdColFlat(z)
return stdColLast(f) == 42
