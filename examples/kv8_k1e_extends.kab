// K1e: class extends method merge via evalSource (Kab path)
// cargo run --bin kabootar -- examples/kv8_k1e_extends.kab

import "kv8/eval"

let viaKab = evalSourceKab("class A { a() { return 1 } } class B extends A { } let x = new B(); x.a()")
let viaSrc = evalSource("class A { a() { return 1 } } class B extends A { } let x = new B(); x.a()")
let awaitOk = evalSourceKab("async function f() { return await 7 } await f()")
return viaKab == 1 && viaSrc == 1 && awaitOk == 7
