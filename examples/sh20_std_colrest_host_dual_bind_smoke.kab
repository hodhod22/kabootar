import "kab/std_colrest"
import "kab/std_collast"
import "kab/std_colfirst"
import "kab/std_col"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let p = stdColPair("n", 42)
let r = stdColRest(p)
if stdColFirst(p) != "n" {
    return false
}
if stdColLast(r) != 42 {
    return false
}
return stdHostDeleteOk() == false
