import "kab/noll/noll_spdx"
import "kab/noll/noll_slsa"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollSlsaIsKab() != false {
    return false
}
if nollSpdxIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
