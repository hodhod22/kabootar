// H6b delete-gate: child/adjacent/attr/:not in Kab queryKab
// cargo run --bin kabootar -- examples/h6b_query_policy.kab

import "kdom/document"
import "kdom/query"
import "kstyle/parse"
import "kv8/eval"

preferKabEval()

let root = el("div")
root = attr(root, "id", "root")
let child = el("span")
child = attr(child, "class", "card")
child = attr(child, "id", "main")
child = attr(child, "data-role", "hero")
root = attach(root, child, true)
let nested = el("p")
nested = attr(nested, "class", "note")
root = attach(root, nested, true)
let sibling = el("span")
sibling = attr(sibling, "class", "next")
root = attach(root, sibling, true)

let desc = queryKab(root, "div span")
let comma = queryKab(root, "p, span")
let allDesc = queryAllKab(root, "div .card")
let childSel = queryKab(root, "div > span.card")
let adj = queryKab(root, "p + span")
let attrSel = queryKab(root, "[data-role=hero]")
let notSel = queryKab(root, "span:not(.next)")
let cssOk = true
parseAndApply("#main { color: red; }")

let viaKv8 = evalSource("let el = document.createElement(\"div\"); el.id = \"app\"; document.body.appendChild(el); document.getElementById(\"app\") != null")

let ownsOk = queryKabOwns("div > span") == true && queryKabOwns("span:hover") == false
let miss = query(root, "div > .missing")
let missOk = miss == null

let ok = desc != null && comma != null && allDesc != null && len(allDesc) >= 1 && childSel != null && adj != null && attrSel != null && notSel != null && viaKv8 == true && cssOk && ownsOk && missOk
println("h6b desc=" + (desc != null) + " child=" + (childSel != null) + " adj=" + (adj != null) + " attr=" + (attrSel != null) + " not=" + (notSel != null) + " owns=" + ownsOk + " kv8=" + viaKv8)
return ok
