import "kab/aot/aot_image_name"
import "kab/aot/aot_load_image"
import "kab/aot/aot_loaded_image"
import "kab/aot/aot_pgo"
import "kab/aot/aot_ship"
import "kab/aot/aot_verify_full"

let image = aotPgoWarmImageWithFpCold(8, "abc", 100, "x64")
let name = aotImageName("x64")
if aotLoadImageWithPgoWarmFpColdOk(image, "x64") == false {
    return false
}
if aotLoadedImageOk(image) == false {
    return false
}
if aotVerifyFullOk(name, image) == false {
    return false
}
return aotShipOk(name, image, "x64")
