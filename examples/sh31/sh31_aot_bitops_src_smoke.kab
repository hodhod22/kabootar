// SH31: tagged bitwise ops — aot-tv1 lowers bit_and/bit_or/bit_xor/
// shl/shr/ushr/bit_not behind an is_smi pair-guard to the t* machine
// ops (detag → 32-bit op → sign-extend → retag), matching the host
// VM's JS-i32 semantics (src/ops.rs) including the `ushr` i32 wrap.
// Float operands trap honestly (no f→i32 op exists). Native rax must
// equal the mirror in every case; expects are TAGGED (v<<1).
import "self_host/compile"
import "kab/aot/aot_fn_x64"
import "kab/aot/aot_fn_exec"
import "kab/aot/aot_native"
import "kab/aot/aot_fn_lower"

fn srcOk(s, expect) {
    let bc = compileIr(s)
    let lo = aotFnLowerModuleTv1(bc, 512)
    if lo["ok"] == false {
        println("REJECT " + lo["reason"])
        return -1
    }
    let r = aotX64EmitFns(lo["fns"], aotNativeHostAbi())
    if len(r["code"]) == 0 {
        return -2
    }
    let d = []
    while len(d) < lo["nglobals"] + 2 + 2048 {
        d = push(d, 0)
    }
    let nr = os_native_exec(r["code"], 0, d)
    let mr = aotFnMirrorH(lo["fns"], 0, lo["nglobals"], 2048)
    if mr != nr {
        println("PARITY " + nr + " vs " + mr)
        return -3
    }
    if nr != expect {
        println("GOT " + nr + " want " + expect)
        return -4
    }
    return 1
}

let acc = 0
// bit_and: 0xF0F0 & 0x0FF0 = 0x00F0.
acc = acc + srcOk("return 61680 & 4080", 480)
// bit_or / bit_xor.
acc = acc + srcOk("return 12 | 10", 28)
acc = acc + srcOk("return 12 ^ 10", 12)
// bit_not.
acc = acc + srcOk("return ~5", -12)
// shl / shr (arithmetic) / ushr.
acc = acc + srcOk("return 3 << 4", 96)
acc = acc + srcOk("return -32 >> 2", -16)
// ushr on negative: u32 0xFFFFFFF0 >> 2 = 0x3FFFFFFC (positive).
acc = acc + srcOk("return -16 >>> 2", 2147483640)
// ushr quirk parity with the host VM: (-1) >>> 0 wraps to i32 -1
// (host `as i32` — JS would give 4294967295; mirror must match host).
acc = acc + srcOk("return -1 >>> 0", -2)
// Shift count masked &0x1f: 33 → 1.
acc = acc + srcOk("return 1 << 33", 4)
// Negative count → to_uint32 & 31 = 31; 4<<31 wraps i32 → 0.
acc = acc + srcOk("return 4 << -1", 0)
// i32 truncation: to_int32(2^31) = -2147483648.
acc = acc + srcOk("return 2147483648 & -1", -4294967296)
// Mixed expression.
acc = acc + srcOk("return (5 & 3) | (8 ^ 2)", 22)
// bit_not through a fn call boundary.
acc = acc + srcOk("fn inv(x) { return ~x } return inv(inv(7))", 14)
println("acc " + acc)
if acc == 13 {
    return 42
}
return acc
