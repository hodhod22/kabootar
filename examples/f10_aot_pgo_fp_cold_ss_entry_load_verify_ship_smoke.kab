import "kab/aot_cd"
import "kab/aot_entry"
import "kab/aot_fp"
import "kab/aot_image_name"
import "kab/aot_img"
import "kab/aot_load_image"
import "kab/aot_loaded_image"
import "kab/aot_pgo"
import "kab/aot_seal"
import "kab/aot_ship"
import "kab/aot_ss"
import "kab/aot_verify_full"

if aotPgoOk(8) == false {
    return false
}
if aotFpOk("abc") == false {
    return false
}
if aotColdOk(100) == false {
    return false
}
if aotSteadyOk(16) == false {
    return false
}
if aotImageOk(1) == false {
    return false
}
if aotSealOk("kabootar-native/1", "rx", 0, 4096) == false {
    return false
}
if aotEntryOk(4096) == false {
    return false
}
let image = aotPgoWarmImageWithFpColdSs(8, "abc", 100, 16, "x64")
if aotLoadedImageOk(image) == false {
    return false
}
if aotLoadImageWithPgoWarmFpColdSsOk(image, "x64") == false {
    return false
}
let name = aotImageName("x64")
if aotVerifyFullOk(name, image) == false {
    return false
}
return aotShipOk(name, image, "x64")
