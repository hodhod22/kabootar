import "kab/noll/noll_nors"
import "kab/noll/noll_hopt"
import "kab/noll/noll_keep"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollHostOptional() != false {
    return false
}
if nollKeepSrc() != true {
    return false
}
if nollNoNewRs() != true {
    return false
}
return nollHostDeleteOk() == false
