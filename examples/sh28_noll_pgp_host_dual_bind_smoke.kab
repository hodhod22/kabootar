import "kab/noll_pgp"
import "kab/noll_age"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollAgeIsKab() != false {
    return false
}
if nollPgpIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
