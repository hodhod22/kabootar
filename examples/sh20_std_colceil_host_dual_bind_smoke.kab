import "kab/std_colceil"
import "kab/std_colfloor"
import "kab/std_colfill"
import "kab/std_colpush"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let f = stdColFill(1, 42.9)
f = stdColPush(f, 0)
let g = stdColFloor(f)
if g[0] != 42 {
    return false
}
let h = stdColFill(1, 41.1)
h = stdColPush(h, 0)
let k = stdColCeil(h)
if k[0] != 42 {
    return false
}
return stdHostDeleteOk() == false
