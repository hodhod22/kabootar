import "kab/noll/noll_vex"
import "kab/noll/noll_sbom"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollSbomIsKab() != false {
    return false
}
if nollVexIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
