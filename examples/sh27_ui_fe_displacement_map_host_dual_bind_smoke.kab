import "kab/ui_fe_displacement_map"
import "kab/ui_fe_diffuse_lighting"
import "kab/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsFeDiffuseLighting("feDiffuseLighting") == false {
    return false
}
if uiIsFeDisplacementMap("feDisplacementMap") == false {
    return false
}
return uiHostDeleteOk() == false
