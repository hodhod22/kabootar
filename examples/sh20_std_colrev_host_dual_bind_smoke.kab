import "kab/std_colrev"
import "kab/std_colconcat"
import "kab/std_colfirst"
import "kab/std_collast"
import "kab/std_col"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let p = stdColPair("n", 42)
let r = stdColRev(p)
if stdColLast(p) != 42 {
    return false
}
if stdColFirst(r) != 42 {
    return false
}
return stdHostDeleteOk() == false
