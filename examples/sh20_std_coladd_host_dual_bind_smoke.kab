import "kab/std/std_coladd"
import "kab/std/std_colscale"
import "kab/std/std_colfill"
import "kab/std/std_colpush"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let v = stdColFill(1, 21)
v = stdColPush(v, 0)
let q = stdColScale(v, 2)
if q[0] != 42 {
    return false
}
let s = stdColAdd(v, v)
if s[0] != 42 {
    return false
}
return stdHostDeleteOk() == false
