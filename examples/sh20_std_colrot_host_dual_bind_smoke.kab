import "kab/std_colrot"
import "kab/std_colchunk"
import "kab/std_colrange"
import "kab/std_colfill"
import "kab/std_colpush"
import "kab/std_coleq"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let r4 = stdColRange(40, 44)
if len(stdColChunk(r4, 2)) != 2 {
    return false
}
let r = stdColRange(40, 43)
let e = stdColFill(1, 41)
e = stdColPush(e, 42)
e = stdColPush(e, 40)
if stdColEq(stdColRotate(r, 1), e) == false {
    return false
}
return stdHostDeleteOk() == false
