import "kab/noll/noll_fndsa"
import "kab/noll/noll_mldsa"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollMldsaIsKab() != false {
    return false
}
if nollFndsaIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
