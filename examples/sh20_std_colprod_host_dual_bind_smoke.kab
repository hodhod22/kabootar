import "kab/std_colprod"
import "kab/std_colmin"
import "kab/std_colrange"
import "kab/std_colfill"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let r = stdColRange(40, 43)
let f = stdColFill(1, 42)
if stdColMin(r) != 40 {
    return false
}
if stdColProduct(f) != 42 {
    return false
}
return stdHostDeleteOk() == false
