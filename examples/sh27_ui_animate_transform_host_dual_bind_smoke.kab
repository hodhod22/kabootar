import "kab/ui/ui_animate_transform"
import "kab/ui/ui_animate_motion"
import "kab/ui/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsAnimateMotion("animateMotion") == false {
    return false
}
if uiIsAnimateTransform("animateTransform") == false {
    return false
}
return uiHostDeleteOk() == false
