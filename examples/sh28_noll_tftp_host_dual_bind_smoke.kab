import "kab/noll_tftp"
import "kab/noll_dhcp"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollDhcpIsKab() != false {
    return false
}
if nollTftpIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
