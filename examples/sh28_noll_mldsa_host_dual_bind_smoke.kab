import "kab/noll_mldsa"
import "kab/noll_mlkem"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollMlkemIsKab() != false {
    return false
}
if nollMldsaIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
