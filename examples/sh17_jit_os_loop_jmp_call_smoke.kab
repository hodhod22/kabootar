import "kab/jit_loop_jmp"
import "kab/jit_mm_loop_jmp"
import "kab/jit_call_loop_jmp"

let kind = "rwx"
let n = 12
let k = 12
let tpl = jitEmitI64LoopJmpN(n, k)
let base = os_mm_mmap(jitMmLoopJmpPid(), jitMmLoopJmpVirt(), jitMmLoopJmpLen(), jitMmLoopJmpProt())
return jitCallLoopJmpOk(base, kind, n, k, tpl)
