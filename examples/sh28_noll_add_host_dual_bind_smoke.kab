import "kab/noll/noll_add"
import "kab/noll/noll_clean"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollCleanIsKab() != false {
    return false
}
if nollAddIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
