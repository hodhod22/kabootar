import "kab/std/std_colsqrt"
import "kab/std/std_colpow"
import "kab/std/std_colfill"
import "kab/std/std_colpush"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let x = stdColFill(1, 42)
x = stdColPush(x, 0)
let e = stdColFill(1, 1)
e = stdColPush(e, 1)
let p = stdColPow(x, e)
if p[0] != 42 {
    return false
}
let sq = stdColFill(1, 1764)
sq = stdColPush(sq, 0)
let s = stdColSqrt(sq)
if s[0] != 42 {
    return false
}
return stdHostDeleteOk() == false
