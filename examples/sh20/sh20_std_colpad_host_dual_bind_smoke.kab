import "kab/std/std_colpad"
import "kab/std/std_colrot"
import "kab/std/std_colrange"
import "kab/std/std_colfill"
import "kab/std/std_colpush"
import "kab/std/std_coleq"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let r = stdColRange(40, 43)
let er = stdColFill(1, 41)
er = stdColPush(er, 42)
er = stdColPush(er, 40)
if stdColEq(stdColRotate(r, 1), er) == false {
    return false
}
let p = stdColFill(1, 40)
let e = stdColFill(1, 40)
e = stdColPush(e, 42)
if stdColEq(stdColPad(p, 2, 42), e) == false {
    return false
}
return stdHostDeleteOk() == false
