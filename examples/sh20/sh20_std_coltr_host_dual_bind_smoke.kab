import "kab/std/std_coltr"
import "kab/std/std_colilv"
import "kab/std/std_colzip"
import "kab/std/std_colrange"
import "kab/std/std_colfill"
import "kab/std/std_colpush"
import "kab/std/std_coleq"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let x = stdColFill(1, 40)
let y = stdColFill(1, 42)
let ep = stdColFill(1, 40)
ep = stdColPush(ep, 42)
if stdColEq(stdColInterleave(x, y), ep) == false {
    return false
}
let a = stdColRange(40, 42)
let b = stdColRange(42, 44)
let t = stdColTranspose(stdColZip(a, b))
if stdColEq(t[0], a) == false {
    return false
}
if stdColEq(t[1], b) == false {
    return false
}
return stdHostDeleteOk() == false
