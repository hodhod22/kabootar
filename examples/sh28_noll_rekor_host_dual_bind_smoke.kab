import "kab/noll/noll_rekor"
import "kab/noll/noll_notary"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollNotaryIsKab() != false {
    return false
}
if nollRekorIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
