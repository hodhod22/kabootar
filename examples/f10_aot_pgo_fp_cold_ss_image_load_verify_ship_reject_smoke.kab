import "kab/aot/aot_cd"
import "kab/aot/aot_fp"
import "kab/aot/aot_load_image"
import "kab/aot/aot_loaded_image"
import "kab/aot/aot_pgo"
import "kab/aot/aot_ss"

if aotPgoOk(8) == false {
    return false
}
if aotFpOk("abc") == false {
    return false
}
if aotColdOk(100) == false {
    return false
}
if aotSteadyOk(16) == false {
    return false
}
let image = aotPgoWarmImageWithFpColdSs(8, "abc", 100, 16, "x64")
if aotLoadedImageOk(image) == false {
    return false
}
return aotLoadImageWithPgoWarmFpColdSsOk(image, "arm64") == false
