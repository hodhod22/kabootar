// H4/H6a: Thin Kab Kv8 — evalSource / evalSourceKab agree; no Rust fallback
// cargo run --bin kabootar -- examples/kv8_h4_prefer_kab.kab

import "kv8/eval"

preferKabEval()
let a = evalSource("1 + 2")
let b = evalSourceKab("1 + 2")
let classA = evalSource("class Box { constructor(n) { this.n = n } } new Box(3).n")
let classB = evalSourceKab("class Box { constructor(n) { this.n = n } } new Box(3).n")
let assignOk = evalSource("Object.assign({a:1},{b:2}).b") == 2
let symOk = evalSource("Object.is(Symbol.for(\"x\"), Symbol.for(\"x\"))")
let gtOk = evalSource("globalThis.Object.keys({z:1})[0]") == "z"
return a == 3 && b == 3 && a == b && classA == 3 && classB == 3 && classA == classB && assignOk && symOk && gtOk
