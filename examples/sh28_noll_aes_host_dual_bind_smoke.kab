import "kab/noll_aes"
import "kab/noll_sha"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollShaIsKab() != false {
    return false
}
if nollAesIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
