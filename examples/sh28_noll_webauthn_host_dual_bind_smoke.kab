import "kab/noll/noll_webauthn"
import "kab/noll/noll_jwks"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollJwksIsKab() != false {
    return false
}
if nollWebauthnIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
