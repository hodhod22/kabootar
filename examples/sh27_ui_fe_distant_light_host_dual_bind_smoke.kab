import "kab/ui_fe_distant_light"
import "kab/ui_fe_turbulence"
import "kab/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsFeTurbulence("feTurbulence") == false {
    return false
}
if uiIsFeDistantLight("feDistantLight") == false {
    return false
}
return uiHostDeleteOk() == false
