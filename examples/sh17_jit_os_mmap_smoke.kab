import "kab/jit_mm"
import "kab/jit_mmap"
import "kab/jit_exec"

pub fn main() {
    let pid = jitMmPid()
    let virt = jitMmVirt()
    let len = jitMmLen()
    let prot = jitMmProt()
    let rwx = prot
    let name = "os_mm_mmap"
    let ok = jitOsMmapOk(393216) && jitMmapOk(6) && jitExecOk(0) && pid == 0 && virt == 0 && len == 4096 && rwx == 7 && name == "os_mm_mmap"
    return ok
}
