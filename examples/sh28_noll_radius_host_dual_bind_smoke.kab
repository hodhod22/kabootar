import "kab/noll/noll_radius"
import "kab/noll/noll_tftp"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollTftpIsKab() != false {
    return false
}
if nollRadiusIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
