import "kab/std/std_colatanh"
import "kab/std/std_colacosh"
import "kab/std/std_colfill"
import "kab/std/std_colpush"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let h = stdColFill(1, 1)
h = stdColPush(h, 0)
let k = stdColAcosh(h)
if k[0] != 0 {
    return false
}
let g = stdColFill(1, 0)
g = stdColPush(g, 0)
let w = stdColAtanh(g)
if w[0] != 0 {
    return false
}
return stdHostDeleteOk() == false
