import "kab/noll_hybrid"
import "kab/noll_fndsa"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollFndsaIsKab() != false {
    return false
}
if nollHybridIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
