import "kab/std/std_colmode"
import "kab/std/std_colmed"
import "kab/std/std_colfill"
import "kab/std/std_colpush"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let p = stdColFill(2, 1)
p = stdColPush(p, 42)
if stdColMedian(p) != 1 {
    return false
}
if stdColMode(p) != 1 {
    return false
}
return stdHostDeleteOk() == false
