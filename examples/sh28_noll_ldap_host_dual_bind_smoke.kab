import "kab/noll/noll_ldap"
import "kab/noll/noll_ssh"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollSshIsKab() != false {
    return false
}
if nollLdapIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
