import "kab/std/std_colrepeat"
import "kab/std/std_colclone"
import "kab/std/std_coleq"
import "kab/std/std_collen"
import "kab/std/std_collast"
import "kab/std/std_col"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let p = stdColPair("n", 42)
let r = stdColRepeat(p, 2)
if stdColEq(stdColClone(p), p) != true {
    return false
}
if stdColLen(r) != 4 {
    return false
}
if stdColLast(r) != 42 {
    return false
}
return stdHostDeleteOk() == false
