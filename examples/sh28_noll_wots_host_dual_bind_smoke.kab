import "kab/noll_wots"
import "kab/noll_lms"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollLmsIsKab() != false {
    return false
}
if nollWotsIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
