import "kab/std/std_colident"
import "kab/std/std_coldiag"
import "kab/std/std_colzip"
import "kab/std/std_colrange"
import "kab/std/std_colfill"
import "kab/std/std_colpush"
import "kab/std/std_coleq"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let a = stdColRange(40, 42)
let b = stdColRange(42, 44)
let ez = stdColFill(1, 40)
ez = stdColPush(ez, 43)
if stdColEq(stdColDiag(stdColZip(a, b)), ez) == false {
    return false
}
let e = stdColFill(2, 1)
if stdColEq(stdColDiag(stdColIdent(2)), e) == false {
    return false
}
return stdHostDeleteOk() == false
