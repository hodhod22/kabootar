import "kab/noll/noll_minisign"
import "kab/noll/noll_pgp"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollPgpIsKab() != false {
    return false
}
if nollMinisignIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
