import "kab/noll_fix"
import "kab/noll_mock"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollMockIsKab() != false {
    return false
}
if nollFixIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
