import "kab/crypto/crypto_tls13_client"
import "kab/crypto/crypto_tls13_client_post"

let s = tls13ClientConnect("127.0.0.1", 28296)
if s == false {
    return false
}
let body = tls13ClientPost(s, "/v?q=1", "a=1")
if body == false {
    return false
}
let i = 0
while i < body["n"] {
    if (body["" + i] & 255) == 79 {
        if i + 1 < body["n"] {
            if (body["" + (i + 1)] & 255) == 75 {
                return true
            }
        }
    }
    i = i + 1
}
return false
