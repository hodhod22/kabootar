import "kab/noll_kyber"
import "kab/noll_ed25519"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollEd25519IsKab() != false {
    return false
}
if nollKyberIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
