import "kab/noll/noll_virustotal"
import "kab/noll/noll_clamav"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollClamavIsKab() != false {
    return false
}
if nollVirustotalIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
