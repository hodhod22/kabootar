import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_bind"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"
import "kab/aot/aot_loaded_image"
import "kab/aot/aot_verify_full"

let table = aotEmitRelocTable("x64")
let image = aotEmitImageWithTables("x64")
let patched = aotApplyRelocTableToImageTextAt40(image, table, 4096, "x64")
let loaded = aotLoadedImageOk(patched)
if loaded == false {
    return false
}
let addr32 = aotApplyRelocTableAddressAt32(table, 4096, "x64")
let bind32 = aotRelocSymbolBindOk(addr32, 4128)
if bind32 == false {
    return false
}
let verified = aotVerifyFullOk("kabootar-arm64.kbn", patched)
return verified == false
