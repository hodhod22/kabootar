import "kab/noll_hqc"
import "kab/noll_bike"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollBikeIsKab() != false {
    return false
}
if nollHqcIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
