import "kab/noll_lex"
import "kab/noll_parse"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollParseIsKab() != false {
    return false
}
if nollLexIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
