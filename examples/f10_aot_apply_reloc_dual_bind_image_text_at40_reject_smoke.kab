import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"

let table = aotEmitRelocTable("x64")
let image = aotEmitImageWithTables("x64")
let patched = aotApplyRelocTableToImageTextAt40(image, table, 4096, "arm64")
let hex32 = aotApplyRelocTableWordHexAt32(table, 4096, "arm64")
let hex40 = aotApplyRelocTableWordHexAt40(table, 4096, "arm64")
if patched != "" {
    return false
}
if hex32 != "" {
    return false
}
return hex40 == ""
