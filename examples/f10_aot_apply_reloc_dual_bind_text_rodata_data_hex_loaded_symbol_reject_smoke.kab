import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_bind"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"
import "kab/aot/aot_loaded_image"

let table = aotEmitRelocTableTextRodataData("x64")
let image = aotEmitImageWithRelocTableTextRodataData("x64")
let patched = aotApplyRelocTableToImageTextRodataDataHex(image, table, 4096, "x64")
if aotLoadedImageOk(patched) == false {
    return false
}
let addr = aotApplyRelocTableAddressTextRodataData(table, 4096, "x64")
return aotRelocSymbolBindOk(addr, 4128) == false
