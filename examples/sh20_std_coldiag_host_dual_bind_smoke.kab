import "kab/std_coldiag"
import "kab/std_coltr"
import "kab/std_colzip"
import "kab/std_colrange"
import "kab/std_colfill"
import "kab/std_colpush"
import "kab/std_coleq"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let a = stdColRange(40, 42)
let b = stdColRange(42, 44)
let z = stdColZip(a, b)
let t = stdColTranspose(z)
if stdColEq(t[0], a) == false {
    return false
}
let e = stdColFill(1, 40)
e = stdColPush(e, 43)
if stdColEq(stdColDiag(z), e) == false {
    return false
}
return stdHostDeleteOk() == false
