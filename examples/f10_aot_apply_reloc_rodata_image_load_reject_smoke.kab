import "kab/aot_apply_reloc"
import "kab/aot_emit_image"
import "kab/aot_emit_reloc_table"
import "kab/aot_load_image"

let table = aotEmitRelocTableRodata("x64")
let image = aotEmitImageWithRelocTableRodata("x64")
let patched = aotApplyRelocTableToImageRodata(image, table, 4096, "x64")
return aotLoadImageWithRelocWordRodataOk(patched, "arm64") == false
