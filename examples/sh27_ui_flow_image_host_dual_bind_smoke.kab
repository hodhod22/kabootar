import "kab/ui_flow_image"
import "kab/ui_flow_region_exclude"
import "kab/ui_host"

if uiHostDeleteOk() != false {
    return false
}
if uiIsFlowRegionExclude("flowRegionExclude") != true {
    return false
}
if uiIsFlowImage("flowImage") != true {
    return false
}
return uiHostDeleteOk() == false
