import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"
import "kab/aot/aot_loaded_image"

let table = aotEmitRelocTableTextRodataData("x64")
let image = aotEmitImageWithRelocTableTextRodataData("x64")
let patched = aotApplyRelocTableToImageTextRodataDataHex(image, table, 4096, "arm64")
let hex = aotApplyRelocTableWordHexTextRodataData(table, 4096, "arm64")
let loaded = aotLoadedImageOk(patched)
if patched != "" {
    return false
}
if hex != "" {
    return false
}
return loaded == false
