import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_emit_code"
import "kab/aot/aot_emit_reloc_table"

let code = aotEmitCode("arm64")
let table = aotEmitRelocTable("arm64")
return aotApplyRelocTableToTextAt40(code, table, 4096, "arm64") == "code:arm64:d65f03c00000000000000000000000000000000000000000000000000000000020100000000000002810000000000000"
