import "kab/std/std_colcol"
import "kab/std/std_colrow"
import "kab/std/std_colident"
import "kab/std/std_colfill"
import "kab/std/std_colpush"
import "kab/std/std_coleq"
import "kab/std/std_host"

if stdHostDeleteOk() != false {
    return false
}
let er = stdColFill(1, 1)
er = stdColPush(er, 0)
if stdColEq(stdColRow(stdColIdent(2), 0), er) == false {
    return false
}
let ec = stdColFill(2, 1)
if stdColEq(stdColCol(stdColIdent(2), 0), ec) == false {
    return false
}
return stdHostDeleteOk() == false
