import "kab/aot/aot_apply_reloc"
import "kab/aot/aot_bind"
import "kab/aot/aot_emit_image"
import "kab/aot/aot_emit_reloc_table"

let table = aotEmitRelocTableData("x64")
let image = aotEmitImageWithRelocTableData("x64")
let addr = aotApplyRelocTableAddressData(table, 8192, "x64")
let hex = aotApplyRelocTableWordHexData(table, 8192, "x64")
let patched = aotApplyRelocTableToImageDataHex(image, table, 8192, "x64")
if addr != 8192 {
    return false
}
if hex != "" {
    return false
}
if patched != "" {
    return false
}
return aotRelocSymbolBindOk(addr, 4096) == false
