import "kab/noll_imgproc"
import "kab/noll_image"
import "kab/noll_aotproc"
import "kab/noll_proc"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollBootstrapImage() != "kabootar.kbc" {
    return false
}
if nollAotProcess() != false {
    return false
}
if nollImageIsProcess() != false {
    return false
}
return nollHostDeleteOk() == false
