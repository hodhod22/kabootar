import "kab/aot_apply_reloc"
import "kab/aot_emit_image"
import "kab/aot_emit_reloc_table"
import "kab/aot_image_name"
import "kab/aot_verify_full"

let table = aotEmitRelocTableTextRodataData("arm64")
let image = aotEmitImageWithRelocTableTextRodataData("arm64")
let patched = aotApplyRelocTableToImageTextRodataDataHex(image, table, 4096, "arm64")
let hex = aotApplyRelocTableWordHexTextRodataData(table, 4096, "arm64")
let prefix = "kabootar-native/1|arm64|abi:aapcs64|entry:0|page:4096|text:rx|rodata:r|"
let mid = "|data:rw|"
let suffix = "|code:arm64:d65f03c00000000000000000000000000000000000000000000000000000000020100000000000002810000000000000|syms:sym:text:0:_start:arm64;sym:text:32:main:arm64;sym:rodata:0:kstr:arm64;sym:data:0:g0:arm64|relocs:reloc:text:32:0:main:arm64;reloc:text:32:8:main:arm64;reloc:rodata:0:0:kstr:arm64;reloc:data:0:0:g0:arm64"
if patched != prefix + hex + mid + hex + suffix {
    return false
}
let name = aotImageName("arm64")
return aotVerifyFullOk(name, patched)
