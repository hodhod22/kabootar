import "kab/noll_pbkdf"
import "kab/noll_bcrypt"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollBcryptIsKab() != false {
    return false
}
if nollPbkdfIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
