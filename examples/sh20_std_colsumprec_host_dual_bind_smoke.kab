import "kab/std_colsumprec"
import "kab/std_colf16round"
import "kab/std_colfill"
import "kab/std_colpush"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let h = stdColFill(1, 4)
h = stdColPush(h, 0)
let k = stdColF16round(h)
if k[0] != 4 {
    return false
}
let g = stdColFill(1, 3)
g = stdColPush(g, 0)
let w = stdColSumPrecise(g)
if w != 3 {
    return false
}
return stdHostDeleteOk() == false
