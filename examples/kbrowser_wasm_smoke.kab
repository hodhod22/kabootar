// G11 WASM-class smoke — same surface via kbrowser/core (runs on any host; wasm CI optional).
import "kbrowser/core"

platform_use("hybrid")
let syncInfo = sync()
kb_viewport(960, 540)
paint()
println("wasm-class mode=" + syncInfo["mode"] + " schemes=" + len(syncInfo["schemes"]))
return syncInfo["mode"]
