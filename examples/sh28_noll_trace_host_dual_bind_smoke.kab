import "kab/noll/noll_trace"
import "kab/noll/noll_prof"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollProfIsKab() != false {
    return false
}
if nollTraceIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
