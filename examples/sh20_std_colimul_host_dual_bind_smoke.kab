import "kab/std_colimul"
import "kab/std_colcbrt"
import "kab/std_colfill"
import "kab/std_colpush"
import "kab/std_host"

if stdHostDeleteOk() != false {
    return false
}
let h = stdColFill(1, 8)
h = stdColPush(h, 0)
let k = stdColCbrt(h)
if k[0] != 2 {
    return false
}
let a = stdColFill(1, 6)
a = stdColPush(a, 0)
let b = stdColFill(1, 7)
b = stdColPush(b, 0)
let w = stdColImul(a, b)
if w[0] != 42 {
    return false
}
return stdHostDeleteOk() == false
