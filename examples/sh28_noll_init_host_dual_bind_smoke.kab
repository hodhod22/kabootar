import "kab/noll/noll_init"
import "kab/noll/noll_new"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollNewIsKab() != false {
    return false
}
if nollInitIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
