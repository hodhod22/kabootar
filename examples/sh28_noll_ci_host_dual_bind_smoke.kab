import "kab/noll/noll_ci"
import "kab/noll/noll_toml"
import "kab/noll/noll_srcprod"
import "kab/noll/noll_syscall"
import "kab/noll/noll_stub"
import "kab/noll/noll_mmap"
import "kab/noll/noll_rustc"
import "kab/noll/noll_cargo"
import "kab/noll/noll_image"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollBootstrapImage() != "kabootar.kbc" {
    return false
}
if nollCargoNotRuntime() != false {
    return false
}
if nollRustcNotProcess() != false {
    return false
}
if nollMmapStub() != false {
    return false
}
if nollStubFrozen() != false {
    return false
}
if nollHostSyscallGone() != false {
    return false
}
if nollProductSrcGone() != false {
    return false
}
if nollCargoTomlGone() != false {
    return false
}
if nollRustcCiGone() != false {
    return false
}
return nollHostDeleteOk() == false
