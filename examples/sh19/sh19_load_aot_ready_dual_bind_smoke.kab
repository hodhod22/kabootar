import "kab/load"
import "kab/load/load_kbc"
import "kab/load/load_main"
import "kab/load/load_aot_ready"
import "kab/noll/noll_aot"

if loadMainDeleteOk() != false {
    return false
}
if loadIsKab("app.kab") == false {
    return false
}
if loadIsKbc("cache/app.kbc") == false {
    return false
}
if loadAotReadyOk(8192) == false {
    return false
}
if nollAotReady() {
    return false
}
return loadMainDeleteOk() == false
