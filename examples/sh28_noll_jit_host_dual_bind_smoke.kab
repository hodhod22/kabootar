import "kab/noll_jit"
import "kab/noll_cranelift"
import "kab/noll_aot"
import "kab/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollCraneliftGone() != false {
    return false
}
if nollJitIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
