import "kab/noll/noll_attack"
import "kab/noll/noll_mitre"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollMitreIsKab() != false {
    return false
}
if nollAttackIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
