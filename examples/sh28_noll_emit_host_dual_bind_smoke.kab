import "kab/noll/noll_emit"
import "kab/noll/noll_type"
import "kab/noll/noll_aot"
import "kab/noll/noll_host"

if nollHostDeleteOk() != false {
    return false
}
if nollAotReady() {
    return false
}
if nollTypeIsKab() != false {
    return false
}
if nollEmitIsKab() != false {
    return false
}
return nollHostDeleteOk() == false
