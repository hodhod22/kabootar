// Kv8 react smoke - live id patch + useEffect deps + onClick
// cargo run --bin kabootar -- examples/kv8_react_smoke.kab

import "kv8/react"

fn handleClick(e) {
    return null
}

fn onMount() {
    return null
}

fn Counter(props) {
    let h = props["$hooks"]
    let pair = useState(h, 0)
    let fx = useEffect(h, onMount, [pair[0]])
    h["fx"] = fx
    props["$hooks"] = h
    return createElement("button", {
        "id": "c",
        "children": "" + pair[0],
        "onClick": handleClick
    })
}

let tree = createElement(Counter, {})
let out0 = render(tree, 240, 120)
let frame0 = out0["frame"]
let html0 = "" + frame0["html"]
let id0 = out0["nodeId"]
let fx0 = tree["$hooks"]["fx"]
let c0 = tree["$hooks"]["c0"]
let out1 = setState(tree, 0, 1)
let frame1 = out1["frame"]
let html1 = "" + frame1["html"]
let id1 = out1["nodeId"]
let fx1 = tree["$hooks"]["fx"]
let c1 = tree["$hooks"]["c0"]
let patched = out1["patched"]
println("kv8 react: hasClick=" + json_stringify(out0["hasClick"]) + " has0=" + json_stringify(str_includes(html0, ">0<")) + " has1=" + json_stringify(str_includes(html1, ">1<")) + " patched=" + json_stringify(patched) + " sameId=" + json_stringify(id0 == id1) + " id0=" + id0 + " id1=" + id1 + " liveHit=" + json_stringify(out1["liveHit"]) + " prevId=" + out1["prevId"] + " c1=" + c1)
return out0["hasClick"] && frame0 != null && frame1 != null && str_includes(html0, ">0<") && str_includes(html1, ">1<") && fx0 >= 1 && fx1 >= 1 && patched == true && id0 == id1 && c1 >= 2
